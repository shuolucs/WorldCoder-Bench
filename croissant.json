{
  "@context": {
    "@vocab": "https://schema.org/",
    "cr": "https://mlcommons.org/croissant/1.0/",
    "dct": "http://purl.org/dc/terms/"
  },
  "@type": "Dataset",
  "@id": "https://anonymous.4open.science/r/WorldCoder-Bench/",
  "name": "WorldCoder-Bench source snapshot",
  "description": "Task specifications and source-snapshot behavioral contracts for executable browser-native 3D world synthesis. This release excludes model-generated HTML and trajectories and is not a claim of a complete official benchmark split.",
  "version": "0.1.0-review",
  "dateModified": "2026-07-28",
  "license": "LicenseRef-WorldCoder-Bench-Research-Provisional",
  "isAccessibleForFree": true,
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "Task manifest",
      "contentUrl": "manifests/tasks.jsonl",
      "encodingFormat": "application/jsonl"
    },
    {
      "@type": "DataDownload",
      "name": "Asset manifest",
      "contentUrl": "manifests/assets.jsonl",
      "encodingFormat": "application/jsonl"
    },
    {
      "@type": "DataDownload",
      "name": "Unresolved asset manifest",
      "contentUrl": "manifests/unresolved_assets.json",
      "encodingFormat": "application/json"
    },
    {
      "@type": "DataDownload",
      "name": "Task definitions and contract snapshots",
      "contentUrl": "tasks/",
      "encodingFormat": "application/json"
    },
    {
      "@type": "DataDownload",
      "name": "Shared task assets",
      "contentUrl": "assets/shared/",
      "encodingFormat": "application/octet-stream"
    },
    {
      "@type": "DataDownload",
      "name": "GLB checksums",
      "contentUrl": "assets_checksum.txt",
      "encodingFormat": "text/plain"
    }
  ],
  "measurementTechnique": "Execution-based state verification with action-driven behavioral-contract checks",
  "variableMeasured": [
    "task prompt",
    "task domain",
    "task difficulty",
    "declared task assets",
    "behavioral-contract affordances",
    "behavioral-contract states",
    "behavioral-contract transitions"
  ],
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "task_count",
      "value": 2004
    },
    {
      "@type": "PropertyValue",
      "name": "shared_glb_count",
      "value": 85
    },
    {
      "@type": "PropertyValue",
      "name": "shared_asset_count",
      "value": 91
    },
    {
      "@type": "PropertyValue",
      "name": "shared_non_glb_count",
      "value": 6
    },
    {
      "@type": "PropertyValue",
      "name": "unresolved_asset_declaration_count",
      "value": 3
    },
    {
      "@type": "PropertyValue",
      "name": "model_outputs_included",
      "value": false
    }
  ]
}
