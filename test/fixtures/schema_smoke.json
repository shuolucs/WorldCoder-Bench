{
  "state_before": {
    "ready": true,
    "count": 0
  },
  "state_after": {
    "ready": true,
    "count": 1
  },
  "contract": {
    "task_id": "P_schema_smoke",
    "affordances": [
      {
        "id": "A_ready",
        "name": "ReadyState",
        "type": "runtime_state",
        "check": {
          "expr": "state.ready === true",
          "tier": "L0"
        }
      }
    ],
    "states": [
      {
        "id": "S_ready",
        "name": "Ready",
        "conditions": [
          "state.ready === true",
          "state.count === 1"
        ]
      }
    ],
    "transitions": [
      {
        "id": "T_increment",
        "action": {
          "type": "script",
          "code": "state.count += 1"
        },
        "verifier": {
          "checks": [
            {
              "expr": "after.count === before.count + 1",
              "tier": "L1"
            }
          ]
        }
      }
    ]
  }
}
