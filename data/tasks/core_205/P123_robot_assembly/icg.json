{
  "task_id": "P123_robot_assembly",
  "affordances": [
    {
      "id": "A1",
      "name": "RobotModel",
      "type": "3d_object",
      "semantic": "robot.glb model",
      "locator_hints": [
        "robot",
        "model",
        "gltf"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "DisassembleBtn",
      "type": "dom_element",
      "semantic": "Disassemble button",
      "locator_hints": [
        "disassembleBtn"
      ],
      "check": "!!document.getElementById('disassembleBtn')"
    },
    {
      "id": "A3",
      "name": "AssembleBtn",
      "type": "dom_element",
      "semantic": "Assemble button",
      "locator_hints": [
        "assembleBtn"
      ],
      "check": "!!document.getElementById('assembleBtn')"
    },
    {
      "id": "A4",
      "name": "PartInfoPanel",
      "type": "dom_element",
      "semantic": "Part info panel",
      "locator_hints": [
        "partInfoPanel"
      ],
      "check": "!!document.getElementById('partInfoPanel')"
    },
    {
      "id": "A5",
      "name": "HUD_AssemblyStatus",
      "type": "dom_element",
      "semantic": "Assembly status display",
      "locator_hints": [
        "assemblyStatus"
      ],
      "check": "!!document.getElementById('assemblyStatus')"
    },
    {
      "id": "A6",
      "name": "HUD_SelectedPart",
      "type": "dom_element",
      "semantic": "Selected part display",
      "locator_hints": [
        "selectedPartName"
      ],
      "check": "!!document.getElementById('selectedPartName')"
    },
    {
      "id": "A7",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera orbit controls",
      "locator_hints": [
        "orbit",
        "controls"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "Model loading",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "assembled",
      "description": "Model loaded, assembled state",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.assemblyState === 'assembled' && window.__3D_STATE__.partCount === 5"
    },
    {
      "id": "S2",
      "name": "disassembling",
      "description": "Disassembly animation in progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.animationProgress > 0 && window.__3D_STATE__.animationProgress < 1 && window.__3D_STATE__.assemblyState !== 'assembled'"
    },
    {
      "id": "S3",
      "name": "disassembled",
      "description": "Exploded view complete",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assemblyState === 'disassembled' && (window.__3D_STATE__.animationProgress === 1 || window.__3D_STATE__.animationProgress >= 0.99)"
    },
    {
      "id": "S4",
      "name": "part_selected",
      "description": "A part is selected",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedPart !== null && window.__3D_STATE__.selectedPart !== undefined"
    },
    {
      "id": "S5",
      "name": "reassembled",
      "description": "Reassembly complete",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assemblyState === 'assembled' && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.partCount === 5"
    },
    {
      "id": "S_stable_60s",
      "name": "stable_60s",
      "description": "60-second stability run — simulation running without errors",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Model loaded",
        "5 parts ready",
        "Initial state: assembled"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.head !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torso !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftArm !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightArm !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.legs)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.partCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assemblyState === 'assembled'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPart === null",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.partCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "document.getElementById('disassembleBtn').click()",
        "wait_ms": 2000
      },
      "postconditions": [
        "Disassembly animation complete",
        "Exploded view active"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 2000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.animationProgress !== before.animationProgress || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number' && !isNaN(window.__3D_STATE__.animationProgress)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number' && !isNaN(window.__3D_STATE__.partCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.legs)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.assemblyState === 'disassembled'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationProgress === 1 || window.__3D_STATE__.animationProgress >= 0.99",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width * 0.5; const cy = rect.top + rect.height * 0.3; canvas.dispatchEvent(new MouseEvent('click', {bubbles:true, clientX:cx, clientY:cy})); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "A part is selected"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.animationProgress !== before.animationProgress || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number' && !isNaN(window.__3D_STATE__.animationProgress)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number' && !isNaN(window.__3D_STATE__.partCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.legs)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedPart !== null && window.__3D_STATE__.selectedPart !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedPart === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "eval",
        "code": "document.getElementById('assembleBtn').click()",
        "wait_ms": 2000
      },
      "postconditions": [
        "Assembly animation complete",
        "Back to assembled state"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 2000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.animationProgress !== before.animationProgress || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number' && !isNaN(window.__3D_STATE__.animationProgress)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number' && !isNaN(window.__3D_STATE__.partCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.legs)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.assemblyState === 'assembled'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.partCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.partCount)",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S5",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "State stable",
        "Part count correct"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.head !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torso !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftArm !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightArm !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.legs)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.partCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assemblyState === 'assembled'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.partCount)",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S_stable_60s",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Simulation runs stably for 60 seconds without errors or NaN values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.partCount === 'number'",
            "tier": "L0"
          }
        ]
      }
    }
  ]
