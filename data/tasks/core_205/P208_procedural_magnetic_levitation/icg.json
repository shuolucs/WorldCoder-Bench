        "CylinderGeometry",
        "metallic blue material"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing height, velocity, field strength, gravity and magnet status",
      "locator_hints": [
        "position:absolute",
        "monospace font"
      ],
      "check": "!!document.querySelector('[style*=\"position:absolute\"][style*=\"monospace\"]') || !!document.querySelector('div[style*=\"position: absolute\"]')"
    },
    {
      "id": "A4",
      "name": "IncreaseFieldButton",
      "type": "dom_element",
      "semantic": "Button to increase magnetic field strength k by 10",
      "locator_hints": [
        "textContent includes 'Increase Field Strength'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Increase Field Strength'))"
    },
    {
      "id": "A5",
      "name": "DecreaseFieldButton",
      "type": "dom_element",
