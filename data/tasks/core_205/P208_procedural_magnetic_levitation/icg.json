    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_InitialEquilibrium",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.magnetEnabled === true",
        "window.__3D_STATE__.fieldStrength === 60"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.gravityEnabled === true && window.__3D_STATE__.magnetEnabled === true && window.__3D_STATE__.fieldStrength === 60"
    },
    {
      "id": "S1",
      "name": "PushedUpward",
      "conditions": [
        "window.__3D_STATE__.velocity > 0.5",
        "window.__3D_STATE__.storkY > 2.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.velocity > 0.5 && window.__3D_STATE__.storkY > 2.5"
    },
    {
      "id": "S2",
      "name": "PushedDownward",
      "conditions": [
        "window.__3D_STATE__.velocity < -0.5",
        "window.__3D_STATE__.storkY < 2.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.velocity < -0.5 && window.__3D_STATE__.storkY < 2.5"
    },
    {
      "id": "S3",
      "name": "ResetToEquilibrium",
      "conditions": [
        "Math.abs(window.__3D_STATE__.storkY - 2.5) < 0.1",
        "Math.abs(window.__3D_STATE__.velocity) < 0.1"
      ],
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.storkY - 2.5) < 0.1 && Math.abs(window.__3D_STATE__.velocity) < 0.1"
    },
    {
      "id": "S4",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false",
        "window.__3D_STATE__.magnetEnabled === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gravityEnabled === false && window.__3D_STATE__.magnetEnabled === true"
    },
    {
      "id": "S5",
      "name": "MagnetDisabled",
      "conditions": [
        "window.__3D_STATE__.magnetEnabled === false",
        "window.__3D_STATE__.gravityEnabled === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.magnetEnabled === false && window.__3D_STATE__.gravityEnabled === true"
    },
    {
      "id": "S6",
      "name": "FieldStrengthIncreased",
      "conditions": [
        "window.__3D_STATE__.fieldStrength === 70"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.fieldStrength === 70"
    },
    {
      "id": "S7",
      "name": "FieldStrengthDecreased",
      "conditions": [
        "window.__3D_STATE__.fieldStrength === 50"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.fieldStrength === 50"
