  "affordances": [
    {
      "id": "A1",
      "name": "StorkModel",
      "type": "3d_object",
      "semantic": "The loaded stork GLB model that levitates above the magnetic base",
      "locator_hints": [
        "GLTF loaded model",
        "window.__3D_STATE__.modelLoaded"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "MagneticBase",
      "type": "3d_object",
      "semantic": "Cylindrical magnetic base platform at y=0",
