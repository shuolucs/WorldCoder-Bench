{
  "task_id": "P1025_procedural_gas_law_pv_nrt_interactive_de",
  "affordances": [
    {
      "id": "A1",
      "name": "GasCylinder",
      "type": "3d_object",
      "semantic": "Transparent cylindrical container holding gas particles",
      "locator_hints": [
        "cylinder mesh at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cylinderRadius)"
    },
    {
      "id": "A2",
      "name": "Piston",
      "type": "3d_object",
      "semantic": "Movable disc at top of cylinder controlling volume",
      "locator_hints": [
        "disc mesh at y=pistonHeight"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.pistonHeight === 'number')"
    },
    {
      "id": "A3",
      "name": "Particles",
      "type": "3d_object",
      "semantic": "Bouncing spheres representing gas molecules",
      "locator_hints": [
        "small sphere meshes inside cylinder"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.particleCount > 0)"
    },
    {
      "id": "A4",
      "name": "TemperatureSlider",
      "type": "dom_element",
      "semantic": "Slider controlling temperature from 100-1000 K",
      "locator_hints": [
        "#slider-temperature"
      ],
      "check": "!!document.getElementById('slider-temperature')"
    },
    {
      "id": "A5",
      "name": "PistonSlider",
      "type": "dom_element",
      "semantic": "Slider controlling piston height from 1.0-10.0",
      "locator_hints": [
        "#slider-piston"
      ],
      "check": "!!document.getElementById('slider-piston')"
    },
    {
      "id": "A6",
      "name": "AddParticlesBtn",
      "type": "dom_element",
      "semantic": "Button to add 5 particles",
      "locator_hints": [
        "#btn-add-particles"
      ],
      "check": "!!document.getElementById('btn-add-particles')"
    },
    {
      "id": "A7",
      "name": "RemoveParticlesBtn",
      "type": "dom_element",
      "semantic": "Button to remove 5 particles",
      "locator_hints": [
        "#btn-remove-particles"
      ],
      "check": "!!document.getElementById('btn-remove-particles')"
    },
    {
      "id": "A8",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Overlay panel showing P, V, T, n, energy, particle info",
      "locator_hints": [
        "#hud-panel"
      ],
      "check": "!!document.getElementById('hud-panel')"
    },
    {
      "id": "A9",
      "name": "HUDPressure",
      "type": "dom_element",
      "semantic": "Pressure readout in kPa",
      "locator_hints": [
        "#hud-pressure"
      ],
      "check": "!!document.getElementById('hud-pressure')"
    },
    {
      "id": "A10",
      "name": "HUDVolume",
      "type": "dom_element",
      "semantic": "Volume readout in liters",
      "locator_hints": [
        "#hud-volume"
      ],
      "check": "!!document.getElementById('hud-volume')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.particleCount === 20",
        "window.__3D_STATE__.pistonHeight === 6",
        "window.__3D_STATE__.moles === 1",
        "window.__3D_STATE__.isAnimating === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 300 && window.__3D_STATE__.particleCount === 20 && window.__3D_STATE__.pistonHeight === 6 && Math.abs(window.__3D_STATE__.moles - 1) < 0.01"
    },
    {
      "id": "S1",
      "name": "AfterTemperatureIncrease",
      "conditions": [
        "window.__3D_STATE__.temperature === 350"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 350"
    },
    {
      "id": "S2",
      "name": "AfterPistonCompressed",
      "conditions": [
        "window.__3D_STATE__.pistonHeight === 3"
      ],
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.pistonHeight - 3) < 0.15"
    },
    {
      "id": "S3",
      "name": "AfterParticlesAdded",
      "conditions": [
        "window.__3D_STATE__.particleCount === 25"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.particleCount === 25"
    },
    {
      "id": "S4",
      "name": "AfterParticlesRemoved",
      "conditions": [
        "window.__3D_STATE__.particleCount === 20"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.particleCount === 20 && window.__3D_STATE__.historyStackSize >= 3"
    },
    {
      "id": "S5",
      "name": "AfterSliderTempChange",
      "conditions": [
        "window.__3D_STATE__.temperature === 600"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 600"
    },
    {
      "id": "S6",
      "name": "AfterUndoTempChange",
      "conditions": [
        "window.__3D_STATE__.temperature === 350"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 350 && window.__3D_STATE__.redoStackSize >= 1"
    },
    {
      "id": "S7",
      "name": "AfterRedoTempChange",
      "conditions": [
        "window.__3D_STATE__.temperature === 600"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 600 && window.__3D_STATE__.historyStackSize >= 1"
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.pistonHeight === 6",
        "window.__3D_STATE__.particleCount === 20"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 300 && window.__3D_STATE__.pistonHeight === 6 && window.__3D_STATE__.particleCount === 20"
    },
    {
      "id": "S9",
      "name": "AfterChainedTempUp",
      "conditions": [
        "window.__3D_STATE__.temperature === 400"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 400"
    },
    {
      "id": "S10",
      "name": "AfterParticleClick",
      "conditions": [
        "window.__3D_STATE__.selectedParticleSpeed !== null"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedParticleSpeed !== null"
    },
    {
      "id": "S11",
      "name": "AfterMultiStepChain",
      "conditions": [
        "window.__3D_STATE__.temperature === 400",
        "window.__3D_STATE__.pistonHeight === 4"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature === 400 && Math.abs(window.__3D_STATE__.pistonHeight - 4) < 0.15"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number' && typeof window.__3D_STATE__.pressure === 'number' && typeof window.__3D_STATE__.volume === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimating === true && window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 300 && window.__3D_STATE__.particleCount === 20 && window.__3D_STATE__.pistonHeight === 6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.moles - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.R - 8.314) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * s.temperature) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume > 0 && Math.abs(window.__3D_STATE__.volume - Math.PI * window.__3D_STATE__.cylinderRadius * window.__3D_STATE__.cylinderRadius * window.__3D_STATE__.pistonHeight) / window.__3D_STATE__.volume < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particlePositions) && window.__3D_STATE__.particlePositions.length === window.__3D_STATE__.particleCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => Math.sqrt(p.x*p.x + p.z*p.z) <= window.__3D_STATE__.cylinderRadius + 0.15 && p.y >= -0.1 && p.y <= window.__3D_STATE__.pistonHeight + 0.1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy > 0 && !isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleSpeed > 0 && !isNaN(window.__3D_STATE__.avgParticleSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 350",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * 350) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleSpeed > 0",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-temperature') !== null && document.getElementById('hud-temperature').textContent.includes('350')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-piston').value = 3; document.getElementById('slider-piston').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.pistonHeight - 3) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const V = Math.PI * s.cylinderRadius * s.cylinderRadius * 3; const expected = (s.moles * s.R * s.temperature) / V; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pistonMeshY - 3) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => p.y <= window.__3D_STATE__.pistonHeight + 0.15)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-volume') !== null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-particles"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 25",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.moles - 1.25) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particlePositions) && window.__3D_STATE__.particlePositions.length === 25",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (1.25 * s.R * s.temperature) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-particle-count') !== null && document.getElementById('hud-particle-count').textContent.includes('25')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-remove-particles"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.moles - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (1.0 * s.R * s.temperature) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-temperature').value = 600; document.getElementById('slider-temperature').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 600",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * 600) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-temperature').textContent.includes('600')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('slider-temperature').value === '600'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleSpeed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature !== 600",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * s.temperature) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.historyStackSize === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 600",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0 || window.__3D_STATE__.redoStackSize < 1",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * 600) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-temperature').textContent.includes('600')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pistonHeight === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.moles - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const V = Math.PI * 4 * 6; const expected = (1.0 * 8.314 * 300) / V; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-temperature').textContent.includes('300')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp', bubbles: true})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp', bubbles: true})), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 400",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const expected = (s.moles * s.R * 400) / s.volume; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-temperature').textContent.includes('400')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy > 0 && !isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-piston').value = 4; document.getElementById('slider-piston').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 400",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pistonHeight - 4) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "(() => { const s = window.__3D_STATE__; const V = Math.PI * s.cylinderRadius * s.cylinderRadius * 4; const expected = (s.moles * s.R * 400) / V; return Math.abs(s.pressure - expected) / expected < 0.005; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => p.y <= 4.15 && p.y >= -0.1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pressure) && window.__3D_STATE__.pressure > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
