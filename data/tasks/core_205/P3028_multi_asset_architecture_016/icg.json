{
  "task_id": "P3028",
  "affordances": [
    {
      "id": "A1",
      "name": "Add Chair Button",
      "type": "dom_element",
      "semantic": "Button that spawns a new damask chair around the table perimeter",
      "locator_hints": [
        "button",
        "text contains 'Chair'",
        "toolbar"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Chair'))"
    },
    {
      "id": "A2",
      "name": "Add Avocado Button",
      "type": "dom_element",
      "semantic": "Button that spawns a new avocado centerpiece on the table",
      "locator_hints": [
        "button",
        "text contains 'Avocado'",
        "toolbar"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Avocado'))"
    },
    {
      "id": "A3",
      "name": "Gold Budget Display",
      "type": "dom_element",
      "semantic": "HUD bar showing remaining gold-leaf units",
      "locator_hints": [
        "top bar",
        "displays number",
        "gold",
        "budget"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.goldBudget === 'number')"
    },
    {
      "id": "A4",
      "name": "Damask Chair Object",
      "type": "3d_object",
      "semantic": "Placed baroque chair with purple-gold damask material",
      "locator_hints": [
        "ChairDamaskPurplegold.glb",
        "selectable mesh",
        "around table"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalChairs > 0)"
    },
    {
      "id": "A5",
      "name": "Avocado Centerpiece",
      "type": "3d_object",
      "semantic": "Scaled avocado decoration on table surface",
      "locator_hints": [
        "Avocado.glb",
        "scale 30",
        "on table"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalAvocados > 0)"
    },
    {
      "id": "A6",
      "name": "Rotation Slider",
      "type": "dom_element",
      "semantic": "Slider controlling Y-axis rotation of selected object",
      "locator_hints": [
        "input range",
        "0-360",
        "rotation",
        "side panel"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=range]')).some(s => s.max === '360')"
    },
    {
      "id": "A7",
      "name": "Scale Slider",
      "type": "dom_element",
      "semantic": "Slider controlling uniform scale of selected object",
      "locator_hints": [
        "input range",
        "0.8-1.5",
        "scale",
        "side panel"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=range]')).some(s => s.min === '0.8' || s.max === '1.5')"
    },
    {
      "id": "A8",
      "name": "Gold Allocation Slider",
      "type": "dom_element",
      "semantic": "Slider redistributing bonus gold units to selected object",
      "locator_hints": [
        "input range",
        "0-10",
        "gold",
        "allocation",
        "side panel"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=range]')).some(s => s.max === '10')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Empty Scene",
      "description": "Scene loaded with table, floor, lighting, and full gold budget of 100 units",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.goldBudget === 100 && window.__3D_STATE__.totalChairs === 0)"
    },
    {
      "id": "S1",
      "name": "First Chair Placed",
      "description": "One damask chair placed around table, budget reduced by 15 units",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalChairs === 1 && window.__3D_STATE__.goldBudget === 85)"
    },
    {
      "id": "S2",
      "name": "Multiple Objects Placed",
      "description": "At least two chairs and one avocado placed, budget partially consumed",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalChairs >= 2 && window.__3D_STATE__.totalAvocados >= 1)"
    },
    {
      "id": "S3",
      "name": "Object Selected",
      "description": "User has selected an object, side panel visible with adjustment sliders",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.isObjectSelected === true && window.__3D_STATE__.selectedObjectId !== '')"
    },
    {
      "id": "S4",
      "name": "Gold Allocated to Object",
      "description": "Bonus gold units allocated to selected object, increasing its emissive tint",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.selectedObjectGoldAllocation > 0 && window.__3D_STATE__.totalGoldAllocated > 0)"
    },
    {
      "id": "S5",
      "name": "Budget Depleted",
      "description": "Gold budget exhausted or insufficient for new placements",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.goldBudget < 15 && window.__3D_STATE__.canAffordChair === false)"
    },
    {
      "id": "S6",
      "name": "Stable Composition",
      "description": "Scene stable with multiple objects placed and gold allocated",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalChairs >= 3 && Number.isFinite(window.__3D_STATE__.goldBudget))"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "One chair is placed in the scene",
        "Gold budget reduced to 85 units",
        "Total chair count is 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalChairs === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalChairs === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.goldBudget === 85",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); buttons[0].click(); setTimeout(() => buttons[1].click(), 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Second chair and one avocado placed",
        "Total chairs is 2, total avocados is 1",
        "Gold budget reduced by 38 units total"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalChairs >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAvocados >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.goldBudget === 62",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true}); canvas.dispatchEvent(evt);",
        "wait_ms": 800
      },
      "postconditions": [
        "An object is selected",
        "Side panel becomes visible",
        "Selected object ID is not empty"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isObjectSelected === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedObjectId === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedObjectId !== ''",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const goldSlider = Array.from(document.querySelectorAll('input[type=range]')).find(s => s.max === '10'); if(goldSlider) { goldSlider.value = 5; goldSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bonus gold allocated to selected object",
        "Total gold allocated increased",
        "Gold budget decreased by allocation amount"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedObjectGoldAllocation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedObjectGoldAllocation > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalGoldAllocated >= window.__3D_STATE__.selectedObjectGoldAllocation",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const addChair = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Chair')); while(window.__3D_STATE__.goldBudget >= 15) { addChair.click(); await new Promise(r => setTimeout(r, 300)); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Gold budget depleted below chair cost threshold",
        "Cannot afford to place another chair",
        "Multiple chairs placed in scene"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.goldBudget < 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canAffordChair === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalChairs >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rotSlider = Array.from(document.querySelectorAll('input[type=range]')).find(s => s.max === '360'); if(rotSlider) { rotSlider.value = 180; rotSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Selected object rotation adjusted",
        "Scene composition stable with multiple objects",
        "All state fields properly tracked"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedObjectRotation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedObjectRotation >= 0 && window.__3D_STATE__.selectedObjectRotation <= 360",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.goldBudget)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid and finite",
        "No runtime errors or crashes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.goldBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.goldBudget >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalChairs) && Number.isFinite(window.__3D_STATE__.totalAvocados)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
