{
  "task_id": "P176_miniature_gyroscope_precession_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "Gyroscope",
      "type": "3d_object",
      "semantic": "The gyroscope assembly (rotor, axle, gimbal ring) that spins and precesses",
      "locator_hints": [
        "gyroscope group at center of platform"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Axle !== undefined)"
    },
    {
      "id": "A2",
      "name": "Platform",
      "type": "3d_object",
      "semantic": "Brown circular base platform",
      "locator_hints": [
        "cylinder at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "SpinSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling rotor spin speed",
      "locator_hints": [
        "#spinSlider"
      ],
      "check": "!!document.getElementById('spinSlider')"
    },
    {
      "id": "A4",
      "name": "TiltButton",
      "type": "dom_element",
      "semantic": "Button to increase tilt by 5 degrees",
      "locator_hints": [
        "#tiltBtn"
      ],
      "check": "!!document.getElementById('tiltBtn')"
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters",
      "locator_hints": [
        "#resetBtn"
      ],
      "check": "!!document.getElementById('resetBtn')"
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing physics values",
      "locator_hints": [
        "#hud"
      ],
      "check": "!!document.getElementById('hud')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 10",
        "window.__3D_STATE__.baseTiltDeg === 20",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.isUnstable === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 10 && window.__3D_STATE__.baseTiltDeg === 20 && window.__3D_STATE__.paused === false && window.__3D_STATE__.isUnstable === false"
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.precessionAngleDeg > 0",
        "window.__3D_STATE__.rotorAngle > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elapsedTime > 0 && window.__3D_STATE__.precessionAngleDeg > 0 && window.__3D_STATE__.rotorAngle > 0"
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.paused === true"
    },
    {
      "id": "S3",
      "name": "SlowSpin",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 2",
        "window.__3D_STATE__.precessionRate > 3"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 2 && window.__3D_STATE__.precessionRate > 3"
    },
    {
      "id": "S4",
      "name": "TiltIncreased",
      "conditions": [
        "window.__3D_STATE__.baseTiltDeg === 25"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.baseTiltDeg === 25"
    },
    {
      "id": "S5",
      "name": "DoubleTiltIncrease",
      "conditions": [
        "window.__3D_STATE__.baseTiltDeg === 30"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.baseTiltDeg === 30"
    },
    {
      "id": "S6",
      "name": "Unstable",
      "conditions": [
        "window.__3D_STATE__.isUnstable === true",
        "window.__3D_STATE__.spinSpeed < 0.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isUnstable === true && window.__3D_STATE__.spinSpeed < 0.5"
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 10",
        "window.__3D_STATE__.baseTiltDeg === 20",
        "window.__3D_STATE__.precessionAngleDeg === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 10 && window.__3D_STATE__.baseTiltDeg === 20 && window.__3D_STATE__.precessionAngleDeg === 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Axle !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Spin !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Precession !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Nutation !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.OrbitControls)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Spin === 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
