{
  "task_id": "P370_miniature_phone_case_designer_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "PhoneCase",
      "type": "3d_object",
      "semantic": "The phone case mesh that wraps around the phone model",
      "locator_hints": [
        "case mesh",
        "larger box around phone"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "PhoneModel",
      "type": "3d_object",
      "semantic": "The phone body mesh on the workbench",
      "locator_hints": [
        "dark phone box",
        "#1a1a1a colored box"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "ColorSwatchRed",
      "type": "dom_element",
      "semantic": "Red color swatch button",
      "locator_hints": [
        "div with background #ff4444"
      ],
      "check": "document.querySelectorAll('div[style*=\"background\"][style*=\"ff4444\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "ColorSwatchBlue",
      "type": "dom_element",
      "semantic": "Blue color swatch button",
      "locator_hints": [
        "div with background #4444ff"
      ],
      "check": "document.querySelectorAll('div[style*=\"background\"][style*=\"4444ff\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "MaterialMatte",
      "type": "dom_element",
      "semantic": "Matte material button",
      "locator_hints": [
        "button labeled Matte"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Matte'))"
    },
    {
      "id": "A6",
      "name": "MaterialGlossy",
      "type": "dom_element",
      "semantic": "Glossy material button",
      "locator_hints": [
        "button labeled Glossy"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Glossy'))"
    },
    {
      "id": "A7",
      "name": "MaterialMetallic",
      "type": "dom_element",
      "semantic": "Metallic material button",
      "locator_hints": [
        "button labeled Metallic"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Metallic'))"
    },
    {
      "id": "A8",
      "name": "PatternDropdown",
      "type": "dom_element",
      "semantic": "Pattern selection dropdown",
      "locator_hints": [
        "select element for pattern"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A9",
      "name": "ExplodeButton",
      "type": "dom_element",
      "semantic": "Button to toggle explode view",
      "locator_hints": [
        "button labeled Explode View"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Explode'))"
    },
    {
      "id": "A10",
      "name": "PhoneGroup",
      "type": "3d_object",
      "semantic": "Group containing phone and case",
      "locator_hints": [
        "parent group of phone and case"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#ff4444'",
        "window.__3D_STATE__.caseMaterial === 'matte'",
        "window.__3D_STATE__.pattern === 'none'",
        "window.__3D_STATE__.autoRotating === false",
        "window.__3D_STATE__.exploded === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.caseColor === '#ff4444' && window.__3D_STATE__.caseMaterial === 'matte' && window.__3D_STATE__.pattern === 'none' && window.__3D_STATE__.autoRotating === false && window.__3D_STATE__.exploded === false"
    },
    {
      "id": "S1",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#4444ff'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.caseColor === '#4444ff'"
    },
    {
      "id": "S2",
      "name": "MaterialGlossy",
      "conditions": [
        "window.__3D_STATE__.caseMaterial === 'glossy'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.caseMaterial === 'glossy'"
    },
    {
      "id": "S3",
      "name": "MaterialMetallic",
      "conditions": [
        "window.__3D_STATE__.caseMaterial === 'metallic'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.caseMaterial === 'metallic'"
    },
    {
      "id": "S4",
      "name": "PatternApplied",
      "conditions": [
        "window.__3D_STATE__.pattern === 'stripes'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pattern === 'stripes'"
    },
    {
      "id": "S5",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.autoRotating === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.autoRotating === true"
    },
    {
      "id": "S6",
      "name": "Exploded",
      "conditions": [
        "window.__3D_STATE__.exploded === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.exploded === true"
    },
    {
      "id": "S7",
      "name": "Flipped",
      "conditions": [
        "window.__3D_STATE__.flipCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.flipCount >= 1"
    },
    {
      "id": "S8",
      "name": "Reassembled",
      "conditions": [
        "window.__3D_STATE__.exploded === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.exploded === false"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "[data-color='#4444ff'], div[style*='background'][style*='4444ff']",
        "description": "Click the blue color swatch"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phoneGroupRotationY !== before.phoneGroupRotationY || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.phoneGroupRotationY === 'number' && !isNaN(window.__3D_STATE__.phoneGroupRotationY)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.casePositionZ === 'number' && !isNaN(window.__3D_STATE__.casePositionZ)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Stripes)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Dots)",
            "tier": "L2"
          }
        ]
      }
    },
    {
