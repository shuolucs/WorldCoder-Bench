        "Height:",
        "Max:",
        "bottom-center"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ballPosition && typeof window.__3D_STATE__.ballPosition.y === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.ballPosition.y === 6",
        "window.__3D_STATE__.bounceCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.isSimulationRunning === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballPosition && window.__3D_STATE__.ballPosition.y === 6 && window.__3D_STATE__.bounceCount === 0 && window.__3D_STATE__.score === 0"
    },
    {
      "id": "S1",
      "name": "BallFalling",
      "conditions": [
        "window.__3D_STATE__.ballPosition.y < 6",
        "window.__3D_STATE__.ballVelocity.y < 0",
        "window.__3D_STATE__.isOnTrampoline === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballPosition && window.__3D_STATE__.ballPosition.y < 6 && window.__3D_STATE__.ballVelocity && window.__3D_STATE__.ballVelocity.y < 0 && window.__3D_STATE__.isOnTrampoline === false"
    },
    {
      "id": "S2",
      "name": "BallContactDeforming",
      "conditions": [
        "window.__3D_STATE__.isOnTrampoline === true",
        "window.__3D_STATE__.meshDeformation > 0.01"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isOnTrampoline === true && window.__3D_STATE__.meshDeformation > 0.01"
    },
    {
      "id": "S3",
      "name": "FirstBounceAscending",
      "conditions": [
        "window.__3D_STATE__.bounceCount >= 1",
        "window.__3D_STATE__.ballVelocity.y > 0",
        "window.__3D_STATE__.isOnTrampoline === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bounceCount >= 1 && window.__3D_STATE__.ballVelocity && window.__3D_STATE__.ballVelocity.y > 0 && window.__3D_STATE__.isOnTrampoline === false"
    },
    {
      "id": "S4",
      "name": "MultipleBounces",
      "conditions": [
        "window.__3D_STATE__.bounceCount >= 3",
        "window.__3D_STATE__.score > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bounceCount >= 3 && window.__3D_STATE__.score > 0"
    },
    {
      "id": "S5",
      "name": "BallMovedLaterally",
      "conditions": [
        "window.__3D_STATE__.lateralDistance > 0.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lateralDistance > 0.5"
    },
    {
      "id": "S6",
      "name": "BallFallenOff",
      "conditions": [
        "window.__3D_STATE__.isFallen === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isFallen === true"
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.ballPosition.y === 6",
        "window.__3D_STATE__.bounceCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.isFallen === false"
      ],
