{
  "task_id": "P193_advanced_trampoline_with_deformable_mesh",
  "affordances": [
    {
      "id": "A1",
      "name": "Ball",
      "type": "3d_object",
      "semantic": "The red sphere that bounces on the trampoline",
      "locator_hints": [
        "SphereGeometry",
        "radius 0.4",
        "color 0xff4444"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ballPosition)"
    },
    {
      "id": "A2",
      "name": "TrampolineMesh",
      "type": "3d_object",
      "semantic": "The deformable blue mesh surface of the trampoline",
      "locator_hints": [
        "PlaneGeometry(5.4, 5.4, 20, 20)",
        "color 0x2288ff"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Deformation !== undefined)"
    },
    {
      "id": "A3",
      "name": "TrampolineFrame",
      "type": "3d_object",
      "semantic": "The rectangular frame supporting the trampoline mesh",
      "locator_hints": [
        "BoxGeometry bars",
        "color 0x444488"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Frame !== undefined)"
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation",
      "locator_hints": [
        "#resetBtn",
        "top-center"
      ],
      "check": "!!document.getElementById('resetBtn')"
    },
    {
      "id": "A5",
      "name": "ScoreHUD",
      "type": "dom_element",
      "semantic": "Score display in top-left corner",
