        "Bounces:",
        "Combo:",
        "top-right"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.bounceCount === 'number')"
    },
    {
      "id": "A7",
      "name": "HeightHUD",
      "type": "dom_element",
      "semantic": "Height display at bottom-center",
