{
  "task_id": "P1820_skeleton_rigging_joint_hierarchy_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "SkeletonHierarchy",
      "type": "3d_object",
      "semantic": "Humanoid skeleton bone hierarchy with root, spine, chest, head, shoulders, elbows, hands, hips, knees, feet",
      "locator_hints": [
        "THREE.Bone objects",
        "SkeletonHelper",
        "bone hierarchy"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalBones >= 13)"
    },
    {
      "id": "A2",
      "name": "GridFloor",
      "type": "3d_object",
      "semantic": "20x20 grid floor at y=0 with color 0x333355",
      "locator_hints": [
        "THREE.GridHelper",
        "floor plane"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sceneChildCount > 0)"
    },
    {
      "id": "A3",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera orbit controls for scene manipulation",
      "locator_hints": [
        "OrbitControls",
        "camera interaction"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "JointVisualizers",
      "type": "3d_object",
      "semantic": "Visual spheres or markers at each bone joint position",
      "locator_hints": [
        "joint spheres",
        "bone markers",
        "hierarchy visualization"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.visibleJoints >= 10)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loads with dark background, grid floor, lights, and camera positioned",
      "condition": "!window.__3D_STATE__ || !window.__3D_STATE__.totalBones"
    },
    {
      "id": "S1",
      "name": "skeleton_created",
      "description": "Skeleton bone hierarchy is constructed with all joints in hierarchy",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalBones >= 13 && window.__3D_STATE__.rootBoneExists === true)"
    },
    {
      "id": "S2",
      "name": "skeleton_visible",
      "description": "Skeleton helper and joint visualizers are added to scene and visible",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.skeletonHelperExists > 0 && window.__3D_STATE__.visibleJoints >= 10)"
    },
    {
      "id": "S3",
      "name": "hierarchy_validated",
      "description": "Bone hierarchy structure validated with correct parent-child relationships",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.maxHierarchyDepth >= 4 && window.__3D_STATE__.leftArmBones >= 3 && window.__3D_STATE__.rightArmBones >= 3)"
    },
    {
      "id": "S4",
      "name": "positions_verified",
      "description": "All bone world positions are computed and within expected ranges",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.rootBoneY > 2 && window.__3D_STATE__.headBoneY > 6)"
    },
    {
      "id": "S5",
      "name": "interactive_ready",
      "description": "OrbitControls active and scene is fully interactive",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.orbitControlsActive === true && window.__3D_STATE__.cameraDistance > 5)"
    },
    {
      "id": "S6",
      "name": "stability_verified",
      "description": "Scene runs stably for extended period with consistent bone count and positions",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.renderCount > 100 && window.__3D_STATE__.totalBones >= 13)"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Skeleton bone hierarchy created",
        "Root bone exists at hip position",
        "All major bones instantiated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalBones === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBones >= 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBones <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rootBoneExists !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rootBoneExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "SkeletonHelper added to scene",
        "Joint visualizers rendered",
        "Skeleton visible in viewport"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.skeletonHelperExists === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.skeletonHelperExists > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.visibleJoints === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.visibleJoints >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneChildCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneChildCount > 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.skeletonHelperExists)",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.visibleJoints)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.visibleJoints - 13) < 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Bone parent-child relationships validated",
        "Hierarchy depth correct",
        "All branches present"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.maxHierarchyDepth === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxHierarchyDepth >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxHierarchyDepth <= 6",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftArmBones === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.leftArmBones >= 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rightArmBones === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rightArmBones >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.leftArmBones)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leftArmBones - 3) < 2",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.maxHierarchyDepth)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "All bone world positions computed",
        "Root bone at expected height",
        "Bone positions within valid ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.rootBoneY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rootBoneY > 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rootBoneY - 4) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.headBoneY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.headBoneY > 6",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.headBoneY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "if(window.__orbitControls__){window.__orbitControls__.update();}",
        "wait_ms": 1000
      },
      "postconditions": [
        "OrbitControls initialized and active",
        "Camera can be manipulated",
        "Scene fully interactive"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.orbitControlsActive !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitControlsActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraDistance - 10) < 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitControlsActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene stable for 60 seconds",
        "Bone count unchanged",
        "No position drift or errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalBones === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBones >= 13",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalBones)",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.rootBoneY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.rootBoneY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.renderCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderCount > 100",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
