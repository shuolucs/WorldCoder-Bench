      "description": "User has tested pan control with left/right arrows, yaw value changed from initial",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cameraYaw !== 0"
    },
    {
      "id": "S2",
      "name": "tilt_explored",
      "description": "User has tested tilt control with up/down arrows, tilt value changed from initial",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cameraTilt !== 0 && window.__3D_STATE__.cameraYaw !== 0"
    },
    {
      "id": "S3",
      "name": "zoom_explored",
      "description": "User has tested zoom control with mouse wheel, focal length changed from initial",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.focalLength > 0 && window.__3D_STATE__.cameraTilt !== 0 && window.__3D_STATE__.cameraYaw !== 0"
    },
    {
      "id": "S4",
      "name": "full_control_tested",
      "description": "All three control mechanisms have been exercised, parameters show variation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cameraYaw !== 0 && window.__3D_STATE__.cameraTilt !== 0 && window.__3D_STATE__.focalLength > 0"
    },
    {
