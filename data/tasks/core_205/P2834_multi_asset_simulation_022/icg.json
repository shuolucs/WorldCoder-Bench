{
  "task_id": "P2834",
  "affordances": [
    {
      "id": "A1",
      "name": "Coffee Mug",
      "type": "3d_object",
      "semantic": "Energy reservoir holding coffee energy units",
      "locator_hints": [
        "coffeeMug.glb model",
        "left side of scene",
        "scaled 2x"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.mugEnergy !== undefined)"
    },
    {
      "id": "A2",
      "name": "Soldier",
      "type": "3d_object",
      "semantic": "Character receiving energy distributed across three stats",
      "locator_hints": [
        "soldier.glb model",
        "right side of scene",
        "clickable for redistribute mode"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.soldierStamina !== undefined)"
    },
    {
      "id": "A3",
      "name": "POUR Button",
      "type": "dom_element",
      "semantic": "Transfers 10 energy from mug to selected soldier stat",
      "locator_hints": [
        "button element",
        "HUD overlay",
        "text contains 'POUR'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A4",
      "name": "DRAIN Button",
      "type": "dom_element",
      "semantic": "Returns 10 energy from selected stat back to mug",
      "locator_hints": [
        "button element",
        "HUD overlay",
        "text contains 'DRAIN'"
      ],
      "check": "document.querySelectorAll('button').length > 1"
    },
    {
      "id": "A5",
      "name": "Stat Radio Buttons",
      "type": "dom_element",
      "semantic": "Three radio buttons to select stamina, speed, or alertness",
      "locator_hints": [
        "radio input elements",
        "labels for stamina/speed/alertness"
      ],
      "check": "document.querySelectorAll('input[type=\"radio\"]').length >= 3"
    },
    {
      "id": "A6",
      "name": "BOOST ALL Button",
      "type": "dom_element",
      "semantic": "Distributes all mug energy evenly across three soldier stats",
      "locator_hints": [
        "button element",
        "text contains 'BOOST ALL'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A7",
      "name": "Redistribute Sliders",
      "type": "dom_element",
      "semantic": "Two linked range sliders that split source stat energy to other two stats",
      "locator_hints": [
        "range input elements",
        "appears when soldier clicked",
        "sum constrained to source value"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length >= 2"
    },
    {
      "id": "A8",
      "name": "Energy HUD Display",
      "type": "dom_element",
      "semantic": "Shows mug energy and all three soldier stat values",
      "locator_hints": [
        "overlay div",
        "displays numeric values",
        "updates in real-time"
      ],
      "check": "!!document.querySelector('div')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial State",
      "description": "Mug contains 100 energy, all soldier stats at 0, stamina selected by default",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mugEnergy === 100 && window.__3D_STATE__.soldierStamina === 0 && window.__3D_STATE__.soldierSpeed === 0 && window.__3D_STATE__.soldierAlertness === 0"
    },
    {
      "id": "S1",
      "name": "Energy Transferred",
      "description": "Energy has been poured from mug to soldier stats, conservation maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mugEnergy < 100 && window.__3D_STATE__.totalEnergyConserved === 100 && (window.__3D_STATE__.soldierStamina > 0 || window.__3D_STATE__.soldierSpeed > 0 || window.__3D_STATE__.soldierAlertness > 0)"
    },
    {
      "id": "S2",
      "name": "Multiple Stats Active",
      "description": "At least two different soldier stats have non-zero energy values",
      "condition": "window.__3D_STATE__ && ((window.__3D_STATE__.soldierStamina > 0 && window.__3D_STATE__.soldierSpeed > 0) || (window.__3D_STATE__.soldierStamina > 0 && window.__3D_STATE__.soldierAlertness > 0) || (window.__3D_STATE__.soldierSpeed > 0 && window.__3D_STATE__.soldierAlertness > 0))"
    },
    {
      "id": "S3",
      "name": "Redistribute Mode Active",
      "description": "User clicked soldier, redistribute sliders visible and functional",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redistributeMode === true"
    },
    {
      "id": "S4",
      "name": "Energy Redistributed",
      "description": "Energy moved between soldier stats via redistribute mechanism, mug unchanged",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redistributeTarget1Amount !== undefined && window.__3D_STATE__.redistributeTarget1Amount >= 0 && window.__3D_STATE__.totalEnergyConserved === 100"
    },
    {
      "id": "S5",
      "name": "Boost All Applied",
      "description": "All mug energy distributed evenly across three soldier stats",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mugEnergy <= 10 && Math.abs(window.__3D_STATE__.soldierStamina - window.__3D_STATE__.soldierSpeed) < 5 && Math.abs(window.__3D_STATE__.soldierSpeed - window.__3D_STATE__.soldierAlertness) < 5"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "System maintains energy conservation after multiple interactions",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.interactionCount > 0 && Math.abs(window.__3D_STATE__.totalEnergyConserved - 100) < 0.5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button:has-text(\"POUR\"), button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Mug energy reduced by 10",
        "Selected soldier stat increased by 10",
        "Total energy remains 100"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mugEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mugEnergy === 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyConserved === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const radios = document.querySelectorAll('input[type=\"radio\"]'); if(radios[1]) radios[1].click(); setTimeout(() => document.querySelector('button:has-text(\"POUR\"), button').click(), 200);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Second stat radio selected",
        "Energy poured into different stat",
        "At least two stats now have non-zero values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.soldierSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.soldierSpeed > 0 || window.__3D_STATE__.soldierAlertness > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergyConserved - 100) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button:has-text(\"DRAIN\"), [class*=\"drain\"], button:nth-of-type(2)').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "10 energy returned from selected stat to mug",
        "Mug energy increased by 10",
        "Conservation maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mugEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mugEnergy >= 10",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.mugEnergy) && window.__3D_STATE__.totalEnergyConserved === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('click', {clientX: canvas.width * 0.7, clientY: canvas.height * 0.5, bubbles: true}); canvas.dispatchEvent(evt);",
        "wait_ms": 1200
      },
      "postconditions": [
        "Soldier clicked to activate redistribute mode",
        "Redistribute sliders become visible",
        "Source stat identified for redistribution"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redistributeMode === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redistributeMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redistributeSourceStat !== undefined && window.__3D_STATE__.redistributeSourceStat.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[0]) { sliders[0].value = sliders[0].max * 0.6; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Redistribute slider adjusted",
        "Energy split between two target stats",
        "Mug energy unchanged, total conserved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redistributeTarget1Amount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redistributeTarget1Amount >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.redistributeTarget1Amount + window.__3D_STATE__.redistributeTarget2Amount) - (window.__3D_STATE__.soldierStamina + window.__3D_STATE__.soldierSpeed + window.__3D_STATE__.soldierAlertness)) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button:has-text(\"BOOST\"), [class*=\"boost\"]').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "All mug energy distributed evenly to three stats",
        "Each stat receives equal portion",
        "Mug energy becomes 0 or near 0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mugEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mugEnergy >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.soldierStamina - window.__3D_STATE__.soldierSpeed) < 5 && Math.abs(window.__3D_STATE__.soldierSpeed - window.__3D_STATE__.soldierAlertness) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const radios = document.querySelectorAll('input[type=\"radio\"]'); if(radios[2]) radios[2].click(); setTimeout(() => { const drain = document.querySelector('button:has-text(\"DRAIN\"), [class*=\"drain\"]'); if(drain) drain.click(); }, 300);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Additional interaction performed",
        "Energy conservation verified across all operations",
        "System remains stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.interactionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyConserved) && Math.abs(window.__3D_STATE__.totalEnergyConserved - 100) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Energy conservation maintained throughout",
        "No unexpected state changes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalEnergyConserved === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyConserved >= 99",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergyConserved - 100) < 0.5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
