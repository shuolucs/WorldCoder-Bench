{
  "task_id": "P2814",
  "affordances": [
    {
      "id": "A1",
      "name": "ChessBoard",
      "type": "3d_object",
      "semantic": "Interactive chess board from ABeautifulGame.glb with draggable pieces",
      "locator_hints": [
        "chess board mesh",
        "board platform",
        "checkered surface"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "ChessPieces",
      "type": "3d_object",
      "semantic": "Individual chess pieces that can be selected and moved",
      "locator_hints": [
        "chess piece meshes",
        "draggable game pieces",
        "pawn knight bishop rook queen king"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Avatar",
      "type": "3d_object",
      "semantic": "ReadyPlayer.me humanoid avatar that reacts to moves",
      "locator_hints": [
        "humanoid model",
        "avatar mesh",
        "character standing beside board"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.avatarAnimationState)"
    },
    {
      "id": "A4",
      "name": "MoveHUD",
      "type": "dom_element",
      "semantic": "HUD overlay displaying current expected move",
      "locator_hints": [
        "move instruction text",
        "top overlay",
        "expected move display"
      ],
      "check": "document.querySelectorAll('[class*=\"move\"], [class*=\"hud\"], [class*=\"instruction\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "DragInteraction",
      "type": "interaction",
      "semantic": "Click-drag-click interaction for moving chess pieces",
      "locator_hints": [
        "raycasting click",
        "piece selection",
        "square targeting"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "description": "Scene loaded with chess board and avatar, waiting for first move",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.currentMoveIndex === 0 && !window.__3D_STATE__.isDragging)"
    },
    {
      "id": "S1",
      "name": "PieceSelected",
      "description": "User has clicked a chess piece which is now highlighted",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.isDragging === true && window.__3D_STATE__.selectedPieceId)"
    },
    {
      "id": "S2",
      "name": "MoveValidated",
      "description": "User completed a move and system is validating correctness",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.isDragging === false && window.__3D_STATE__.currentMoveIndex >= 0 && !window.__3D_STATE__.sequenceCompleted)"
    },
    {
      "id": "S3",
      "name": "CorrectMove",
      "description": "Move was correct, avatar nodding and particles playing",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.correctMovesCount > 0 && (window.__3D_STATE__.avatarAnimationState === 'nodding' || window.__3D_STATE__.particleEffectActive === true))"
    },
    {
      "id": "S4",
      "name": "IncorrectMove",
      "description": "Move was incorrect, avatar shaking head",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.incorrectMovesCount > 0 && window.__3D_STATE__.avatarAnimationState === 'shaking')"
    },
    {
      "id": "S5",
      "name": "SequenceComplete",
      "description": "All 6 moves completed correctly, board evaluation displayed",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.sequenceCompleted === true && window.__3D_STATE__.currentMoveIndex === 6)"
    },
    {
      "id": "S6",
      "name": "Stable",
      "description": "System stable after sequence completion",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.sequenceCompleted === true && window.__3D_STATE__.correctMovesCount === 6)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.4; const y = rect.top + rect.height * 0.6; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "A chess piece is selected and highlighted with emissive glow"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isDragging === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isDragging === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedPieceId === 'string' && window.__3D_STATE__.selectedPieceId.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.5; const y = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 600
      },
      "postconditions": [
        "Piece animates to target square and move is validated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDragging === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentMoveIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentMoveIndex >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1200
      },
      "postconditions": [
        "Avatar plays nodding animation and green particles appear"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.correctMovesCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.correctMovesCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.avatarAnimationState === 'nodding' || window.__3D_STATE__.avatarAnimationState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleEffectActive === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.45; const y = rect.top + rect.height * 0.55; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "Next piece selected for subsequent move in sequence"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDragging === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMoveIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMoveIndex < 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i = 0; i < 5; i++) { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * (0.4 + i * 0.02); const y = rect.top + rect.height * (0.5 + i * 0.02); canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }",
        "wait_ms": 4000
      },
      "postconditions": [
        "All 6 moves completed, sequence finished, board evaluation calculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sequenceCompleted === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sequenceCompleted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMoveIndex === 6",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.boardEvaluationScore === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boardEvaluationScore)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Avatar celebrating, all animations complete, system stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.correctMovesCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.incorrectMovesCount >= 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds after completion"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sequenceCompleted === true",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.correctMovesCount)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.correctMovesCount === 6",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
