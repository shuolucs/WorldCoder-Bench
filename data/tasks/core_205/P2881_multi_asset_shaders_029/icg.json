{
  "task_id": "P2881",
  "affordances": [
    {
      "id": "A1",
      "name": "Chess Piece Meshes",
      "type": "3d_object",
      "semantic": "Individual chess pieces from ABeautifulGame.glb that can be selected and enchanted",
      "locator_hints": [
        "meshes from ABeautifulGame.glb",
        "raycasting targets",
        "chess piece geometry"
      ],
      "check": "!!(window.scene && window.scene.children.filter(c => c.userData.isChessPiece).length > 0)"
    },
    {
      "id": "A2",
      "name": "Venetian Mask",
      "type": "3d_object",
      "semantic": "Floating mask from venice_mask.glb that displays the active enchantment shader",
      "locator_hints": [
        "venice_mask.glb model",
        "floating above chess board",
        "shader material target"
      ],
      "check": "!!(window.scene && window.scene.children.some(c => c.userData.isMask))"
    },
    {
      "id": "A3",
      "name": "Enchantment Selection Panel",
      "type": "dom_element",
      "semantic": "HTML overlay panel displaying 5 enchantment options for user selection",
      "locator_hints": [
        "overlay UI",
        "enchantment buttons",
        "shader selection interface"
      ],
      "check": "document.querySelectorAll('[data-enchantment]').length > 0"
    },
    {
      "id": "A4",
      "name": "PointLight",
      "type": "3d_object",
      "semantic": "Dynamic point light near mask that changes color based on active enchantment",
      "locator_hints": [
        "light source near mask",
        "color-changing light",
        "positioned above chess board"
      ],
      "check": "!!(window.scene && window.scene.children.some(c => c.type === 'PointLight'))"
    },
    {
      "id": "A5",
      "name": "Raycaster Interaction",
      "type": "interaction",
      "semantic": "Mouse click raycasting system for selecting chess pieces",
      "locator_hints": [
        "click event handler",
        "raycaster for piece selection",
        "mouse interaction"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with mask floating above chess board, no pieces selected, overlay hidden",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.selectedPieceIndex === undefined && window.__3D_STATE__.enchantedPieceCount === 0)"
    },
    {
      "id": "S1",
      "name": "Piece Selected",
      "description": "User has clicked and selected a chess piece, overlay panel becomes visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedPieceIndex >= 0 && window.__3D_STATE__.isOverlayVisible === true && window.__3D_STATE__.enchantedPieceCount === 0"
    },
    {
      "id": "S2",
      "name": "First Enchantment Applied",
      "description": "User selected an enchantment from overlay, shader applied to piece and mask, light color changed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.enchantedPieceCount === 1 && window.__3D_STATE__.activeEnchantmentId >= 0"
    },
    {
      "id": "S3",
      "name": "Multiple Pieces Enchanted",
      "description": "User has enchanted 3 or more different chess pieces with various shaders",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.enchantedPieceCount >= 3 && window.__3D_STATE__.enchantedPieceCount < 5"
    },
    {
      "id": "S4",
      "name": "Shader Animation Active",
      "description": "Shader uniforms are animating based on elapsed time, visual effects pulsing/changing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.animationTimeElapsed > 0 && window.__3D_STATE__.enchantedPieceCount >= 3 && window.__3D_STATE__.enchantedPieceCount < 5"
    },
    {
      "id": "S5",
      "name": "Advanced Enchantment State",
      "description": "At least 5 pieces enchanted, mask cycling through complex shader combinations",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.enchantedPieceCount >= 5"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "All interactions complete, shaders animating smoothly, system stable for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pieces = window.scene.children.filter(c => c.userData.isChessPiece); if(pieces.length > 0) { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2, bubbles: true}); window.dispatchEvent(evt); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "A chess piece is selected via raycasting",
        "selectedPieceIndex is set to a valid index >= 0",
        "Enchantment overlay panel becomes visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedPieceIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedPieceIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isOverlayVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = document.querySelectorAll('[data-enchantment]'); if(buttons.length > 0) { buttons[0].click(); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "First enchantment applied to selected piece",
        "Mask shader updated to match enchantment",
        "PointLight color changed",
        "enchantedPieceCount incremented to 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeEnchantmentId === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeEnchantmentId >= 0 && window.__3D_STATE__.activeEnchantmentId <= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.enchantedPieceCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maskShaderType === window.__3D_STATE__.activeEnchantmentId",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<3; i++) { setTimeout(() => { const pieces = window.scene.children.filter(c => c.userData.isChessPiece); if(pieces[i]) { const evt = new MouseEvent('click', {clientX: 300+i*50, clientY: 300, bubbles: true}); window.dispatchEvent(evt); setTimeout(() => { const btns = document.querySelectorAll('[data-enchantment]'); if(btns[i%5]) btns[i%5].click(); }, 500); } }, i*2000); }",
        "wait_ms": 8000
      },
      "postconditions": [
        "Three or more pieces have been enchanted",
        "enchantedPieceCount >= 3",
        "Multiple different shader types applied"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.enchantedPieceCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.enchantedPieceCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.enchantedPieceCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Shader animation time has progressed",
        "Uniform values are updating based on time",
        "Visual effects are animating smoothly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationTimeElapsed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationTimeElapsed > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.animationTimeElapsed)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dissolveProgress >= 0 && window.__3D_STATE__.dissolveProgress <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<3; i++) { setTimeout(() => { const pieces = window.scene.children.filter(c => c.userData.isChessPiece && !c.userData.enchanted); if(pieces[0]) { const evt = new MouseEvent('click', {clientX: 400+i*30, clientY: 350, bubbles: true}); window.dispatchEvent(evt); setTimeout(() => { const btns = document.querySelectorAll('[data-enchantment]'); if(btns[(i+2)%5]) btns[(i+2)%5].click(); }, 600); } }, i*2500); }",
        "wait_ms": 9000
      },
      "postconditions": [
        "At least 5 pieces have been enchanted",
        "All shader uniform values are within valid ranges",
        "PointLight hue has changed multiple times"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.enchantedPieceCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.enchantedPieceCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glowIntensity >= 0 && window.__3D_STATE__.glowIntensity <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointLightColorHue >= 0 && window.__3D_STATE__.pointLightColorHue <= 360",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "All shader parameters remain stable and valid",
        "Animation continues smoothly",
        "No errors or invalid states"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.refractionStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refractionStrength >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.chromaticOffset >= 0 && window.__3D_STATE__.chromaticOffset <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voidPulseRadius >= 0 && window.__3D_STATE__.voidPulseRadius <= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All state values remain valid",
        "Shaders continue animating without errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationTimeElapsed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.enchantedPieceCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.animationTimeElapsed) && window.__3D_STATE__.animationTimeElapsed > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
