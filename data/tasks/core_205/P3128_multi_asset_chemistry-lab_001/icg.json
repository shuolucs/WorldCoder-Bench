{
  "task_id": "P3128",
  "affordances": [
    {
      "id": "A1",
      "name": "Power On Button",
      "type": "dom_element",
      "semantic": "HTML button to power on the dispersion apparatus",
      "locator_hints": [
        "button",
        "text contains 'Power On'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Power On'))"
    },
    {
      "id": "A2",
      "name": "Calibrate Button",
      "type": "dom_element",
      "semantic": "HTML button to start calibration sequence",
      "locator_hints": [
        "button",
        "text contains 'Calibrate'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Calibrate'))"
    },
    {
      "id": "A3",
      "name": "Coffee Sample Mat",
      "type": "3d_object",
      "semantic": "Draggable coffee sample material loaded from coffeemat.glb",
      "locator_hints": [
        "coffeemat.glb",
        "draggable object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Dispersion Apparatus",
      "type": "3d_object",
      "semantic": "Main testing instrument loaded from DispersionTest.glb",
      "locator_hints": [
        "DispersionTest.glb",
        "apparatus on bench"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Wavelength Slider",
      "type": "dom_element",
      "semantic": "HTML range input to adjust wavelength parameter",
      "locator_hints": [
        "input type=range",
        "wavelength control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 0"
    },
    {
      "id": "A6",
      "name": "Intensity Slider",
      "type": "dom_element",
      "semantic": "HTML range input to adjust intensity parameter",
      "locator_hints": [
        "input type=range",
        "intensity control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 1"
    },
    {
      "id": "A7",
      "name": "Run Test Button",
      "type": "dom_element",
      "semantic": "HTML button to execute the dispersion test",
      "locator_hints": [
        "button",
        "text contains 'Run Test'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Run Test'))"
    },
    {
      "id": "A8",
      "name": "Record Data Button",
      "type": "dom_element",
      "semantic": "HTML button to save test results",
      "locator_hints": [
        "button",
        "text contains 'Record'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Record'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial State",
      "description": "Lab scene loaded, apparatus off, coffeemat on side, awaiting power on",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.apparatusPowered === false"
    },
    {
      "id": "S1",
      "name": "Apparatus Powered",
      "description": "Dispersion apparatus is powered on with green emissive glow",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.apparatusPowered === true && window.__3D_STATE__.isCalibrated !== true"
    },
    {
      "id": "S2",
      "name": "Calibration Complete",
      "description": "Apparatus has been calibrated and is ready for sample placement",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isCalibrated === true && window.__3D_STATE__.coffeematPlaced !== true"
    },
    {
      "id": "S3",
      "name": "Sample Positioned",
      "description": "Coffee mat is placed on the apparatus target zone",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.coffeematPlaced === true && (typeof window.__3D_STATE__.wavelengthSetting !== 'number' || typeof window.__3D_STATE__.intensitySetting !== 'number')"
    },
    {
      "id": "S4",
      "name": "Parameters Set",
      "description": "Wavelength and intensity parameters have been adjusted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.coffeematPlaced === true && typeof window.__3D_STATE__.wavelengthSetting === 'number' && typeof window.__3D_STATE__.intensitySetting === 'number' && (window.__3D_STATE__.testProgress || 0) < 100"
    },
    {
      "id": "S5",
      "name": "Test Complete",
      "description": "Dispersion test has finished and results are available",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.testProgress >= 100 && window.__3D_STATE__.dataRecorded !== true"
    },
    {
      "id": "S6",
      "name": "Data Recorded",
      "description": "Test results have been recorded and system is stable",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dataRecorded === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click()",
        "wait_ms": 1000
      },
      "postconditions": [
        "Apparatus is powered on"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.apparatusPowered === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.apparatusPowered === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Calibrate')).click()",
        "wait_ms": 2500
      },
      "postconditions": [
        "Calibration progress reaches 100 and isCalibrated is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.calibrationProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.calibrationProgress >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isCalibrated === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('mousedown', {clientX: canvas.width * 0.3, clientY: canvas.height * 0.5, bubbles: true}); canvas.dispatchEvent(evt); setTimeout(() => { const evt2 = new MouseEvent('mousemove', {clientX: canvas.width * 0.5, clientY: canvas.height * 0.5, bubbles: true}); canvas.dispatchEvent(evt2); setTimeout(() => { const evt3 = new MouseEvent('mouseup', {bubbles: true}); canvas.dispatchEvent(evt3); }, 500); }, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Coffee mat is placed on apparatus target zone"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.coffeematPlaced === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coffeematPlaced === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); if(sliders[0]) { sliders[0].value = 550; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); } if(sliders[1]) { sliders[1].value = 75; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wavelength and intensity parameters are set"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wavelengthSetting === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthSetting >= 400 && window.__3D_STATE__.wavelengthSetting <= 700",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensitySetting === 'number' && window.__3D_STATE__.intensitySetting >= 0 && window.__3D_STATE__.intensitySetting <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Run Test')).click()",
        "wait_ms": 3000
      },
      "postconditions": [
        "Dispersion test completes and dispersion value is calculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.testProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.testProgress >= 100",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dispersionValue === 'number' && isFinite(window.__3D_STATE__.dispersionValue)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Record')).click()",
        "wait_ms": 1000
      },
      "postconditions": [
        "Test data is recorded"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dataRecorded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dataRecorded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stabilityTimer === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stabilityTimer >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.dataRecorded === true && window.__3D_STATE__.stabilityTimer >= 60",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
