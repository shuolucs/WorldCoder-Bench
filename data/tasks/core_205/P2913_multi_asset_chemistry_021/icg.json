{
  "task_id": "P2913",
  "affordances": [
    {
      "id": "A1",
      "name": "Temperature Slider",
      "type": "dom_element",
      "semantic": "Controls heating temperature of reaction vessel from 0 to 500 degrees Celsius",
      "locator_hints": [
        "input[type='range']",
        "temperature control",
        "slider with °C label"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Stirring Speed Slider",
      "type": "dom_element",
      "semantic": "Controls mechanical stirring speed from 0 to 100 RPM",
      "locator_hints": [
        "input[type='range']",
        "stirring or RPM control",
        "second slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Filter Tightness Slider",
      "type": "dom_element",
      "semantic": "Adjusts compression of molecular sieve filter from 1 to 10",
      "locator_hints": [
        "input[type='range']",
        "filter or tightness control",
        "third slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Reagent Concentration Dropdown",
      "type": "dom_element",
      "semantic": "Selects molarity of reagent solution affecting particle density",
      "locator_hints": [
        "select element",
        "dropdown with M units",
        "concentration selector"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A5",
      "name": "Start Extraction Button",
      "type": "dom_element",
      "semantic": "Initiates 5-second particle transfer animation from vessel to filter",
      "locator_hints": [
        "button element",
        "start or extraction text",
        "action button"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A6",
      "name": "Coffee Mug Vessel",
      "type": "3d_object",
      "semantic": "Central reaction vessel containing reagent particles with temperature-based emissive color",
      "locator_hints": [
        "coffeeMug.glb model",
        "object at origin",
        "vessel with particles"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "Gears Mechanism",
      "type": "3d_object",
      "semantic": "Mechanical stirring and heating drive that rotates based on stirring speed",
      "locator_hints": [
        "gears.glb model",
        "rotating mechanism",
        "object below-left of origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A8",
      "name": "Corset Filter",
      "type": "3d_object",
      "semantic": "Molecular sieve filter that scales on X-axis based on tightness setting",
      "locator_hints": [
        "Corset.glb model",
        "filter object",
        "scalable sieve to the right"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Idle",
      "description": "Apparatus loaded with default settings: temperature 0, stirring off, filter at neutral tightness, lowest reagent concentration",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.temperature === 0 && window.__3D_STATE__.stirringSpeed === 0)"
    },
    {
      "id": "S1",
      "name": "Heating Active",
      "description": "Temperature increased to mid-range causing vessel emissive color change and thermal activity",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature >= 200 && window.__3D_STATE__.temperature <= 300"
    },
    {
      "id": "S2",
      "name": "Stirring Engaged",
      "description": "Gears rotating at moderate speed indicating mechanical stirring is active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.stirringSpeed >= 50 && window.__3D_STATE__.gearRotation > 0"
    },
    {
      "id": "S3",
      "name": "Filter Compressed",
      "description": "Molecular sieve filter tightened to maximum compression for fine filtration",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.filterTightness === 10 && window.__3D_STATE__.filterScale >= 0.65 && window.__3D_STATE__.filterScale <= 0.75"
    },
    {
      "id": "S4",
      "name": "High Concentration Loaded",
      "description": "Reagent concentration set to maximum with increased particle count in vessel",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reagentConcentration === 2.0 && window.__3D_STATE__.particleCount > 100"
    },
    {
      "id": "S5",
      "name": "Extraction Running",
      "description": "Active particle transfer animation from vessel to filter with extraction progress tracking",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionActive === true && window.__3D_STATE__.extractionProgress > 0 && window.__3D_STATE__.extractionProgress < 1"
    },
    {
      "id": "S6",
      "name": "Extraction Complete",
      "description": "Extraction animation finished with particles transferred and system stabilized",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionActive === false && window.__3D_STATE__.extractionProgress >= 1.0 && window.__3D_STATE__.transferredParticles > 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 250; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Temperature state updated to 250°C",
        "Vessel emissive color changed to orange range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 200 && window.__3D_STATE__.temperature <= 300",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[1].value = 60; sliders[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Stirring speed set to 60 RPM",
        "Gears model rotating continuously"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stirringSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stirringSpeed >= 50 && window.__3D_STATE__.stirringSpeed <= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gearRotation > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[2].value = 10; sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Filter tightness set to maximum (10)",
        "Corset model compressed to minimum X-scale"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.filterTightness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.filterTightness === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterScale >= 0.65 && window.__3D_STATE__.filterScale <= 0.75",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const dropdown = document.querySelector('select'); dropdown.value = '2.0'; dropdown.dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Reagent concentration set to 2.0M",
        "Particle count increased to maximum density"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reagentConcentration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reagentConcentration === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Extraction animation initiated",
        "Particles beginning transfer from vessel to filter"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.extractionActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.extractionActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.extractionProgress > 0 && window.__3D_STATE__.extractionProgress < 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Extraction animation completed",
        "Particles successfully transferred to filter",
        "Extraction state deactivated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.extractionProgress >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transferredParticles > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All state values maintain consistency",
        "No unexpected state changes occur"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.stirringSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.filterTightness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.extractionActive === false",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.gearRotation)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
