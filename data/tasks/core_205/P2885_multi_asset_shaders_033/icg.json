{
  "task_id": "P2885",
  "affordances": [
    {
      "id": "A1",
      "name": "Duck Model",
      "type": "3d_object",
      "semantic": "Central occluding subject for godray shader",
      "locator_hints": [
        "Duck.glb",
        "center of scene",
        "primary mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded)"
    },
    {
      "id": "A2",
      "name": "Light 1 Exposure Slider",
      "type": "dom_element",
      "semantic": "Controls exposure for first godray light source",
      "locator_hints": [
        "input[type='range']",
        "light1",
        "exposure"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A3",
      "name": "Light 2 Exposure Slider",
      "type": "dom_element",
      "semantic": "Controls exposure for second godray light source",
      "locator_hints": [
        "input[type='range']",
        "light2",
        "exposure"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "Light 3 Exposure Slider",
      "type": "dom_element",
      "semantic": "Controls exposure for third godray light source",
      "locator_hints": [
        "input[type='range']",
        "light3",
        "exposure"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A5",
      "name": "Density Slider",
      "type": "dom_element",
      "semantic": "Controls global ray sampling density",
      "locator_hints": [
        "input[type='range']",
        "density"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A6",
      "name": "Weight Slider",
      "type": "dom_element",
      "semantic": "Controls godray weight factor",
      "locator_hints": [
        "input[type='range']",
        "weight"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A7",
      "name": "Decay Slider",
      "type": "dom_element",
      "semantic": "Controls ray decay rate",
      "locator_hints": [
        "input[type='range']",
        "decay"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, assets not yet loaded",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.assetsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "Both GLB models loaded, default shader parameters active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded === true"
    },
    {
      "id": "S2",
      "name": "Energy Balanced",
      "description": "All three light exposures sum to conservation constant 3.0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyConserved === true && Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01"
    },
    {
      "id": "S3",
      "name": "Shader Parameters Modified",
      "description": "User has adjusted density, weight, or decay values",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.rayDensity > 0 || window.__3D_STATE__.rayWeight > 0 || window.__3D_STATE__.rayDecay >= 0)"
    },
    {
      "id": "S4",
      "name": "Exposure Redistributed",
      "description": "One light exposure changed, others auto-adjusted to conserve energy",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyConserved === true && Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01"
    },
    {
      "id": "S5",
      "name": "Color Tints Applied",
      "description": "RGB color channels modified for individual light sources",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.light1ColorR >= 0 || window.__3D_STATE__.light2ColorG >= 0 || window.__3D_STATE__.light3ColorB >= 0)"
    },
    {
      "id": "S6",
      "name": "Stable Runtime",
      "description": "Scene running with all systems operational for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both Duck.glb and godrays_demo.glb are loaded",
        "assetsLoaded state field is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assetsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assetsLoaded !== false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "Sum of light1Exposure, light2Exposure, light3Exposure equals 3.0",
        "energyConserved is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.light1Exposure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.light2Exposure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.light3Exposure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light1Exposure >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.light2Exposure >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Shader parameters density, weight, or decay have been modified",
        "Values are within valid ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rayDensity >= 0.1 && window.__3D_STATE__.rayDensity <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayWeight >= 0.01 && window.__3D_STATE__.rayWeight <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayDecay >= 0.9 && window.__3D_STATE__.rayDecay <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayDensity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.rayWeight > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.rayDecay >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.id && s.id.includes('exposure')); if(slider) { slider.value = parseFloat(slider.max) * 0.8; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "One light exposure changed",
        "Other two lights auto-adjusted to maintain sum of 3.0",
        "energyConserved remains true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light1Exposure >= 0.1 && window.__3D_STATE__.light1Exposure <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light1Exposure >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const colorSliders = Array.from(document.querySelectorAll('input[type=\"range\"]')).filter(s => s.id && (s.id.includes('color') || s.id.includes('Color'))); if(colorSliders.length > 0) { colorSliders[0].value = parseFloat(colorSliders[0].max) * 0.7; colorSliders[0].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color tint values modified for at least one light source",
        "RGB channels within 0-1 range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.light1ColorR >= 0 && window.__3D_STATE__.light1ColorR <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light2ColorG >= 0 && window.__3D_STATE__.light2ColorG <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light3ColorB >= 0 && window.__3D_STATE__.light3ColorB <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.light1ColorR >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.light2ColorG >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.light3ColorB >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "System returns to balanced energy state",
        "All shader parameters stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.duckRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.duckRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckRotationY !== null",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene has run stably for 60 seconds",
        "All state fields remain valid",
        "Energy conservation maintained throughout"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assetsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.light1Exposure + window.__3D_STATE__.light2Exposure + window.__3D_STATE__.light3Exposure) - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.rayDensity) && isFinite(window.__3D_STATE__.rayWeight) && isFinite(window.__3D_STATE__.rayDecay)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.assetsLoaded !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyConserved !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayDensity > 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
