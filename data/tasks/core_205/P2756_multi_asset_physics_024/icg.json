{
  "task_id": "P2756",
  "affordances": [
    {
      "id": "A1",
      "name": "Stork 1 Heat Slider",
      "type": "dom_element",
      "semantic": "Slider controlling heat intensity for stork 1 lantern",
      "locator_hints": [
        "input[type='range']",
        "slider with label containing 'Stork 1' and 'Heat'"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Stork 2 Heat Slider",
      "type": "dom_element",
      "semantic": "Slider controlling heat intensity for stork 2 lantern",
      "locator_hints": [
        "input[type='range']",
        "slider with label containing 'Stork 2' and 'Heat'"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Wind X Slider",
      "type": "dom_element",
      "semantic": "Slider controlling global wind force X component",
      "locator_hints": [
        "input[type='range']",
        "slider with label containing 'Wind X'"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Wind Z Slider",
      "type": "dom_element",
      "semantic": "Slider controlling global wind force Z component",
      "locator_hints": [
        "input[type='range']",
        "slider with label containing 'Wind Z'"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A5",
      "name": "Stork 1 Mass Slider",
      "type": "dom_element",
      "semantic": "Slider controlling mass of stork 1",
      "locator_hints": [
        "input[type='range']",
        "slider with label containing 'Stork 1' and 'Mass'"
      ],
      "check": "!!Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.parentElement && s.parentElement.textContent.includes('Mass'))"
    },
    {
      "id": "A6",
      "name": "Release/Attach Button",
      "type": "dom_element",
      "semantic": "Button to toggle lantern attachment to storks",
      "locator_hints": [
        "button",
        "text containing 'Release' or 'Attach'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A7",
      "name": "Duck Model",
      "type": "3d_object",
      "semantic": "Draggable duck checkpoint on water surface",
      "locator_hints": [
        "Duck.glb model",
        "object on water plane at y=0"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.duckPositionX === 'number' && typeof window.__3D_STATE__.duckPositionZ === 'number')"
    },
    {
      "id": "A8",
      "name": "Stork 1 Model",
      "type": "3d_object",
      "semantic": "First stork carrying lantern",
      "locator_hints": [
        "stork.glb model",
        "positioned at x=-5"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.stork1Height === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Configuration",
      "description": "Scene loaded with storks at starting positions, lanterns attached, no heat or wind applied",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.stork1Heat === 0 && window.__3D_STATE__.windX === 0 && window.__3D_STATE__.windZ === 0 && window.__3D_STATE__.lanternsAttached === true)"
    },
    {
      "id": "S1",
      "name": "Heat Applied to Stork 1",
      "description": "Stork 1 lantern heat increased, generating buoyancy force causing upward motion",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.stork1Heat >= 10"
    },
    {
      "id": "S2",
      "name": "Wind Force Active",
      "description": "Global wind forces applied affecting all stork-lantern pairs horizontally",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.windX !== 0 || window.__3D_STATE__.windZ !== 0)"
    },
    {
      "id": "S3",
      "name": "Mass Adjusted",
      "description": "Stork 1 mass modified affecting its physics response to forces",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.stork1Mass !== 2"
    },
    {
      "id": "S4",
      "name": "Duck Repositioned",
      "description": "Duck checkpoint moved to new position on water surface",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.duckPositionX !== 0 || window.__3D_STATE__.duckPositionZ !== 2)"
    },
    {
      "id": "S5",
      "name": "Lanterns Released",
      "description": "Lanterns detached from storks, physics now independent",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lanternsAttached === false"
    },
    {
      "id": "S6",
      "name": "Stable Flight Configuration",
      "description": "System reaches equilibrium with balanced forces and stable trajectories",
      "condition": "window.__3D_STATE__ && isFinite(window.__3D_STATE__.stork1Height) && window.__3D_STATE__.stork1Height >= 0 && window.__3D_STATE__.stork1Height < 20"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 15; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Stork 1 heat intensity set to 15",
        "Stork 1 begins ascending due to buoyancy force"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stork1Heat === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stork1Heat >= 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stork1Heat - 15) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[2].value = 5; sliders[2].dispatchEvent(new Event('input', {bubbles: true})); sliders[3].value = -3; sliders[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Wind X set to 5 and Wind Z set to -3",
        "Storks experience horizontal drift from wind forces"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.windX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windX > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windX - 5) < 2 && Math.abs(window.__3D_STATE__.windZ - (-3)) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); const massSlider = Array.from(sliders).find(s => s.parentElement.textContent.includes('Mass')); if(massSlider) { massSlider.value = 3.5; massSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Stork 1 mass adjusted to 3.5kg",
        "Physics response changes due to mass modification"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stork1Mass === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stork1Mass >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stork1Mass - 3.5) < 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('mousedown', {clientX: canvas.width/2, clientY: canvas.height/2, bubbles: true}); canvas.dispatchEvent(evt); const move = new MouseEvent('mousemove', {clientX: canvas.width/2 + 50, clientY: canvas.height/2 + 30, bubbles: true}); canvas.dispatchEvent(move); const up = new MouseEvent('mouseup', {bubbles: true}); canvas.dispatchEvent(up);",
        "wait_ms": 1000
      },
      "postconditions": [
        "Duck position changed on water surface",
        "Duck checkpoint relocated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.duckPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duckPositionX !== 0 || window.__3D_STATE__.duckPositionZ !== 2",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.duckPositionX) && isFinite(window.__3D_STATE__.duckPositionZ)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const button = document.querySelector('button'); if(button) { button.click(); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Lanterns detached from storks",
        "lanternsAttached state becomes false"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lanternsAttached === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lanternsAttached === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lanternsAttached === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "System stabilizes with current force configuration",
        "Stork 1 height reaches stable value"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stork1Height === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stork1Height >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.stork1Height) && window.__3D_STATE__.stork1Height < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All state values remain valid and finite"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stork1Heat === 'number' && typeof window.__3D_STATE__.windX === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stork1Height >= 0 && window.__3D_STATE__.stork1Mass >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.stork1Height) && Number.isInteger(Math.floor(window.__3D_STATE__.stork1Heat))",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
