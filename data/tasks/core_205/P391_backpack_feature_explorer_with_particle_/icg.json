{
  "task_id": "P391_backpack_feature_explorer_with_particle_",
  "affordances": [
    {
      "id": "A1",
      "name": "ProductModel",
      "type": "3d_object",
      "semantic": "The loaded GLB shoe model centered at origin acting as featured product",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "HotspotMaterial",
      "type": "3d_object",
      "semantic": "Red pulsing hotspot sphere at (0.5, 1.2, 0.3)",
      "locator_hints": [
        "sphere with color #ff6b6b"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "HotspotComfort",
      "type": "3d_object",
      "semantic": "Teal pulsing hotspot sphere at (-0.4, 0.6, 0.5)",
      "locator_hints": [
        "sphere with color #4ecdc4"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "HotspotSole",
      "type": "3d_object",
      "semantic": "Yellow pulsing hotspot sphere at (0.1, 0.2, 0.8)",
      "locator_hints": [
        "sphere with color #ffe66d"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "200-particle Points system for burst effects",
      "locator_hints": [
        "Points object in scene"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "AutoRotateButton",
      "type": "dom_element",
      "semantic": "Toggle button for auto-rotation in top-right",
      "locator_hints": [
        "button containing 'Auto-Rotate'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A7",
      "name": "VariantMidnight",
      "type": "dom_element",
      "semantic": "Midnight material variant button",
      "locator_hints": [
        "button containing 'Midnight'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A8",
      "name": "VariantBeach",
      "type": "dom_element",
      "semantic": "Beach material variant button",
      "locator_hints": [
        "button containing 'Beach'"
      ],
      "check": "!!document.querySelector('button:nth-child(2)')"
    },
    {
      "id": "A9",
      "name": "VariantMesh",
      "type": "dom_element",
      "semantic": "Mesh material variant button",
      "locator_hints": [
        "button containing 'Mesh'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A10",
      "name": "Platform",
      "type": "3d_object",
      "semantic": "Circular dark metallic platform beneath product",
      "locator_hints": [
        "CylinderGeometry mesh at y~-0.025"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A11",
      "name": "TooltipPanel",
      "type": "dom_element",
      "semantic": "Feature description tooltip shown on hotspot click",
      "locator_hints": [
        "div with hotspot label text"
      ],
      "check": "!!document.querySelector('div')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false",
        "window.__3D_STATE__.autoRotate === true"
      ],
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.activeHotspot === null",
        "window.__3D_STATE__.currentVariant === 'Midnight'",
        "window.__3D_STATE__.exploded === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.activeHotspot === null && window.__3D_STATE__.currentVariant === 'Midnight' && window.__3D_STATE__.exploded === false"
    },
    {
      "id": "S2",
      "name": "Hotspot_Material_Active",
      "conditions": [
        "window.__3D_STATE__.activeHotspot === 'Material'",
        "window.__3D_STATE__.hotspotClickCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeHotspot === 'Material' && window.__3D_STATE__.hotspotClickCount >= 1"
    },
    {
      "id": "S3",
      "name": "AutoRotate_Disabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.autoRotate === false"
    },
    {
      "id": "S4",
      "name": "Variant_Beach_Selected",
      "conditions": [
        "window.__3D_STATE__.currentVariant === 'Beach'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentVariant === 'Beach'"
    },
    {
      "id": "S5",
      "name": "Exploded_View",
      "conditions": [
        "window.__3D_STATE__.exploded === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.exploded === true"
    },
    {
      "id": "S6",
      "name": "Hotspot_Sole_Active",
      "conditions": [
        "window.__3D_STATE__.activeHotspot === 'Sole'",
        "window.__3D_STATE__.hotspotClickCount >= 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeHotspot === 'Sole' && window.__3D_STATE__.hotspotClickCount >= 2"
    },
    {
      "id": "S7",
      "name": "Reassembled_And_Mesh_Variant",
      "conditions": [
        "window.__3D_STATE__.exploded === false",
        "window.__3D_STATE__.currentVariant === 'Mesh'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.exploded === false && window.__3D_STATE__.currentVariant === 'Mesh'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Lights !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particlesActive === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.hotspotClickCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.autoRotate === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Lights)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          }
