{
  "task_id": "P3188",
  "affordances": [
    {
      "id": "A1",
      "name": "Lantern",
      "type": "3d_object",
      "semantic": "Draggable lantern hanging from elastic rope",
      "locator_hints": [
        "Lantern.glb model",
        "hanging object",
        "swinging pendulum"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "SoftBodyPlatform",
      "type": "3d_object",
      "semantic": "Deformable jelly-like platform made of spring-connected spheres",
      "locator_hints": [
        "grid of spheres",
        "soft body platform",
        "deformable surface"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.platformStiffness === 'number')"
    },
    {
      "id": "A3",
      "name": "BoomBox",
      "type": "3d_object",
      "semantic": "BoomBox model resting on platform that bounces on deformation",
      "locator_hints": [
        "BoomBox.glb model",
        "object on platform",
        "bouncing speaker"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.boomBoxHeight === 'number')"
    },
    {
      "id": "A4",
      "name": "DragInteraction",
      "type": "interaction",
      "semantic": "Click and drag interaction to pull lantern",
      "locator_hints": [
        "mouse drag",
        "pointer interaction",
        "lantern pull"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "description": "Scene loaded with lantern at rest, platform stable, BoomBox sitting on platform",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.isDragging === false && window.__3D_STATE__.collisionCount === 0)"
    },
    {
      "id": "S1",
      "name": "LanternDragged",
      "description": "User is dragging the lantern away from rest position, rope stretching",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDragging === true && window.__3D_STATE__.ropeStretched === true"
    },
    {
      "id": "S2",
      "name": "LanternSwinging",
      "description": "Lantern released and swinging toward platform with velocity",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDragging === false && window.__3D_STATE__.lanternVelocity > 0 && window.__3D_STATE__.collisionCount === 0"
    },
    {
      "id": "S3",
      "name": "CollisionOccurred",
      "description": "Lantern collided with platform, ripple deformation propagating through soft body",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.collisionCount >= 1 && window.__3D_STATE__.rippleIntensity > 0"
    },
    {
      "id": "S4",
      "name": "BoomBoxBouncing",
      "description": "BoomBox launched upward due to platform deformation beneath it",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.boomBoxBouncing === true && window.__3D_STATE__.boomBoxHeight > 0"
    },
    {
      "id": "S5",
      "name": "PlatformOscillating",
      "description": "Platform rippling and settling after collision, color changing with deformation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.rippleIntensity >= 0 && window.__3D_STATE__.boomBoxBouncing === false && window.__3D_STATE__.rippleIntensity >= 0.1"
    },
    {
      "id": "S6",
      "name": "Stabilized",
      "description": "All objects settled, platform returned to rest state, ready for next interaction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.boomBoxBouncing === false && Math.abs(window.__3D_STATE__.rippleIntensity) < 0.1 && window.__3D_STATE__.lanternVelocity < 1.0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('mousedown', {clientX: canvas.width/2, clientY: canvas.height/2, bubbles: true}); canvas.dispatchEvent(evt); setTimeout(() => { const move = new MouseEvent('mousemove', {clientX: canvas.width/2 + 100, clientY: canvas.height/2, bubbles: true}); canvas.dispatchEvent(move); }, 200);",
        "wait_ms": 500
      },
      "postconditions": [
        "Lantern is displaced from rest position",
        "isDragging state is true",
        "Rope is stretched beyond rest length"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isDragging === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isDragging === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lanternSwingAmplitude > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ropeStretched === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('mouseup', {bubbles: true}); canvas.dispatchEvent(evt);",
        "wait_ms": 800
      },
      "postconditions": [
        "Lantern released and swinging with velocity",
        "isDragging is false",
        "Lantern velocity is non-zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDragging === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lanternVelocity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lanternVelocity > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lanternVelocity)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1200
      },
      "postconditions": [
        "Lantern has collided with platform",
        "Collision count incremented",
        "Ripple deformation initiated on platform"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.collisionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.collisionCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.collisionCount)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.rippleIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 400
      },
      "postconditions": [
        "BoomBox launched upward from platform",
        "BoomBox height increased above rest position",
        "BoomBoxBouncing flag is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.boomBoxHeight === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boomBoxHeight > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.boomBoxBouncing === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boomBoxHeight)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "Platform oscillating with ripple waves",
        "Platform color changing based on deformation",
        "Ripple intensity decreasing over time"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.platformColorHue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.platformColorHue >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.platformColorHue <= 360",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rippleIntensity >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "postconditions": [
        "Platform returned to stable rest state",
        "BoomBox settled back on platform",
        "Ripple intensity near zero",
        "All velocities damped"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.boomBoxBouncing === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rippleIntensity) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lanternVelocity < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.platformStiffness === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "No unexpected state changes",
        "All physics settled"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.collisionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.collisionCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rippleIntensity) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boomBoxHeight)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
