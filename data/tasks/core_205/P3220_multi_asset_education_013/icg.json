{
  "task_id": "P3220",
  "affordances": [
    {
      "id": "A1",
      "name": "Dungeon Environment",
      "type": "3d_object",
      "semantic": "Main dungeon scene loaded from dungeon_warkarma.glb",
      "locator_hints": [
        "dungeon_warkarma.glb",
        "scene background",
        "environment mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Sunglasses Lens Clones",
      "type": "3d_object",
      "semantic": "Five cloned instances of SunglassesKhronos.glb positioned at beam stations",
      "locator_hints": [
        "SunglassesKhronos.glb",
        "draggable lenses",
        "optical elements"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Energy Sliders",
      "type": "dom_element",
      "semantic": "HTML range inputs controlling beam energy allocation (0-40 per beam)",
      "locator_hints": [
        "input[type='range']",
        "energy controls",
        "beam sliders"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Beam Emitter Lights",
      "type": "3d_object",
      "semantic": "Five colored point lights at fixed stations (red, blue, green, yellow, white)",
      "locator_hints": [
        "PointLight",
        "colored lights",
        "beam sources"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Lens Drag Interaction",
      "type": "interaction",
      "semantic": "Raycasting-based drag system for repositioning lenses on ground plane",
      "locator_hints": [
        "mousedown",
        "mousemove",
        "mouseup",
        "raycaster"
      ],
      "check": "true"
    },
    {
      "id": "A6",
      "name": "Lens Rotation Interaction",
      "type": "interaction",
      "semantic": "Right-click to rotate selected lens by 30-degree increments",
      "locator_hints": [
        "contextmenu",
        "right-click",
        "rotation increment"
      ],
      "check": "true"
    },
    {
      "id": "A7",
      "name": "Target Receptors",
      "type": "3d_object",
      "semantic": "Glowing spheres representing beam target positions for alignment",
      "locator_hints": [
        "receptor spheres",
        "target markers",
        "glowing objects"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with dungeon, 5 lens clones at default positions, all beams at zero energy",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.beamEnergyRed === 0 && window.__3D_STATE__.beamEnergyBlue === 0 && window.__3D_STATE__.beamEnergyGreen === 0 && window.__3D_STATE__.beamEnergyYellow === 0 && window.__3D_STATE__.beamEnergyWhite === 0)"
    },
    {
      "id": "S1",
      "name": "Energy Allocated",
      "description": "User has distributed energy across beams using sliders, respecting 100-unit budget",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalEnergyBudget === 100 && (window.__3D_STATE__.beamEnergyRed + window.__3D_STATE__.beamEnergyBlue + window.__3D_STATE__.beamEnergyGreen + window.__3D_STATE__.beamEnergyYellow + window.__3D_STATE__.beamEnergyWhite === 100) && window.__3D_STATE__.lensesCorrectlyAligned === 0"
    },
    {
      "id": "S2",
      "name": "Lens Manipulation Active",
      "description": "User is dragging or rotating lenses to align with beam paths",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.isDragging === true || (window.__3D_STATE__.selectedLensIndex >= 0 && window.__3D_STATE__.totalRotationApplied > 0)) && window.__3D_STATE__.lensesCorrectlyAligned < 5"
    },
    {
      "id": "S3",
      "name": "Partial Alignment",
      "description": "Some lenses correctly aligned with receptors, partial puzzle progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lensesCorrectlyAligned > 0 && window.__3D_STATE__.lensesCorrectlyAligned < 5 && window.__3D_STATE__.activatedReceptors > 0 && window.__3D_STATE__.activatedReceptors < 5"
    },
    {
      "id": "S4",
      "name": "Full Alignment",
      "description": "All 5 lenses aligned, all receptors activated, puzzle solved",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lensesCorrectlyAligned === 5 && window.__3D_STATE__.activatedReceptors === 5 && window.__3D_STATE__.puzzleCompleted === true"
    },
    {
      "id": "S5",
      "name": "Stability Verification",
      "description": "System maintains solved state for extended period without user input",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.puzzleCompleted === true && window.__3D_STATE__.lensesCorrectlyAligned === 5 && window.__3D_STATE__.activatedReceptors === 5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach((s,i)=>{const vals=[15,20,25,30,10];s.value=vals[i];s.dispatchEvent(new Event('input',{bubbles:true}))});",
        "wait_ms": 1500
      },
      "postconditions": [
        "Energy sliders set to values summing to 100",
        "Beam energies reflected in state tracking"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamEnergyRed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamEnergyRed + window.__3D_STATE__.beamEnergyBlue + window.__3D_STATE__.beamEnergyGreen + window.__3D_STATE__.beamEnergyYellow + window.__3D_STATE__.beamEnergyWhite === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const c=document.querySelector('canvas');const r=c.getBoundingClientRect();const x=r.left+r.width*0.3;const y=r.top+r.height*0.5;c.dispatchEvent(new MouseEvent('mousedown',{clientX:x,clientY:y,bubbles:true,button:0}));setTimeout(()=>{c.dispatchEvent(new MouseEvent('mousemove',{clientX:x+50,clientY:y+30,bubbles:true}))},200);setTimeout(()=>{c.dispatchEvent(new MouseEvent('mouseup',{clientX:x+50,clientY:y+30,bubbles:true,button:0}))},400);",
        "wait_ms": 1000
      },
      "postconditions": [
        "Lens selected and dragged to new position",
        "Dragging state tracked and updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedLensIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedLensIndex >= -1 && window.__3D_STATE__.selectedLensIndex < 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isDragging === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const c=document.querySelector('canvas');const r=c.getBoundingClientRect();const x=r.left+r.width*0.4;const y=r.top+r.height*0.6;c.dispatchEvent(new MouseEvent('mousedown',{clientX:x,clientY:y,bubbles:true,button:0}));setTimeout(()=>{c.dispatchEvent(new MouseEvent('contextmenu',{clientX:x,clientY:y,bubbles:true,button:2}))},300);setTimeout(()=>{c.dispatchEvent(new MouseEvent('contextmenu',{clientX:x,clientY:y,bubbles:true,button:2}))},600);setTimeout(()=>{c.dispatchEvent(new MouseEvent('mouseup',{clientX:x,clientY:y,bubbles:true,button:0}))},900);",
        "wait_ms": 1200
      },
      "postconditions": [
        "Lens rotated by 60 degrees total (two 30-degree increments)",
        "Rotation accumulator updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalRotationApplied === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalRotationApplied >= 60",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalRotationApplied)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const c=document.querySelector('canvas');const r=c.getBoundingClientRect();for(let i=0;i<3;i++){const x=r.left+r.width*(0.2+i*0.15);const y=r.top+r.height*(0.4+i*0.1);c.dispatchEvent(new MouseEvent('mousedown',{clientX:x,clientY:y,bubbles:true,button:0}));setTimeout(()=>{c.dispatchEvent(new MouseEvent('mousemove',{clientX:x+80,clientY:y+40,bubbles:true}))},100+i*400);setTimeout(()=>{c.dispatchEvent(new MouseEvent('mouseup',{clientX:x+80,clientY:y+40,bubbles:true,button:0}))},200+i*400);}",
        "wait_ms": 2000
      },
      "postconditions": [
        "Multiple lenses repositioned toward alignment",
        "Some receptors now activated by aligned beams"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lensesCorrectlyAligned === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lensesCorrectlyAligned > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activatedReceptors > 0 && window.__3D_STATE__.activatedReceptors < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const c=document.querySelector('canvas');const r=c.getBoundingClientRect();for(let i=0;i<5;i++){const x=r.left+r.width*(0.15+i*0.17);const y=r.top+r.height*(0.35+i*0.12);c.dispatchEvent(new MouseEvent('mousedown',{clientX:x,clientY:y,bubbles:true,button:0}));setTimeout(()=>{c.dispatchEvent(new MouseEvent('mousemove',{clientX:x+100,clientY:y+50,bubbles:true}))},100+i*500);setTimeout(()=>{for(let j=0;j<3;j++){setTimeout(()=>{c.dispatchEvent(new MouseEvent('contextmenu',{clientX:x+100,clientY:y+50,bubbles:true,button:2}))},250+i*500+j*150)}},200+i*500);setTimeout(()=>{c.dispatchEvent(new MouseEvent('mouseup',{clientX:x+100,clientY:y+50,bubbles:true,button:0}))},700+i*500);}",
        "wait_ms": 4000
      },
      "postconditions": [
        "All 5 lenses correctly aligned with their beam paths",
        "All 5 receptors activated",
        "Puzzle completion flag set"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lensesCorrectlyAligned === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activatedReceptors === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.puzzleCompleted === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable with all lenses aligned",
        "All receptors continue receiving energy",
        "No state degradation over 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.puzzleCompleted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lensesCorrectlyAligned === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activatedReceptors === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 100",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
