          },
          {
            "expr": "window.__3D_STATE__.sunglassesGlowEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glowPhase !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentAnimationIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playbackSpeed - 2.5) < 0.2",
            "tier": "L2"
          }
        ]
