{
  "task_id": "P2933",
  "affordances": [
    {
      "id": "A1",
      "name": "Michelle Character Model",
      "type": "3d_object",
      "semantic": "Main animated character loaded from Michelle.glb with skeletal rig",
      "locator_hints": [
        "GLTF model",
        "scene.children",
        "SkinnedMesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Sunglasses Accessory",
      "type": "3d_object",
      "semantic": "Sunglasses model from SunglassesKhronos.glb attached to head bone",
      "locator_hints": [
        "GLTF model",
        "parented to bone",
        "emissive material"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sunglassesGlowEnabled !== undefined)"
    },
    {
      "id": "A3",
      "name": "Animation Clip Dropdown",
      "type": "dom_element",
      "semantic": "Dropdown selector for available animation clips",
      "locator_hints": [
        "select element",
        "animation-select",
        "UI panel"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A4",
      "name": "Play/Pause Button",
      "type": "dom_element",
      "semantic": "Toggle button to control animation playback",
      "locator_hints": [
        "button",
        "play-pause",
        "UI panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/pause|play/i))"
    },
    {
      "id": "A5",
      "name": "Speed Slider",
      "type": "dom_element",
      "semantic": "Slider control for animation playback speed (0.25x to 3.0x)",
      "locator_hints": [
        "input[type=range]",
        "speed-slider",
        "UI panel"
      ],
      "check": "!!document.querySelector('input[type=range]')"
    },
    {
      "id": "A6",
      "name": "Crossfade Button",
      "type": "dom_element",
      "semantic": "Button to trigger smooth animation blending",
      "locator_hints": [
        "button",
        "crossfade",
        "UI panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/crossfade/i))"
    },
    {
      "id": "A7",
      "name": "Stage Lighting System",
      "type": "3d_object",
      "semantic": "Three colored SpotLights (magenta, cyan, gold) and AmbientLight",
      "locator_hints": [
        "SpotLight",
        "AmbientLight",
        "scene.children"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A8",
      "name": "Sunglasses Glow Effect",
      "type": "interaction",
      "semantic": "RGB cycling emissive glow on sunglasses material",
      "locator_hints": [
        "emissive color",
        "sine wave animation",
        "material.emissive"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene initializes, models load, animation system ready with first clip selected",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "animation_playing",
      "description": "Animation mixer actively playing selected clip at default speed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && Math.abs(window.__3D_STATE__.playbackSpeed - 1.0) < 0.15 && window.__3D_STATE__.isCrossfading === false"
    },
    {
      "id": "S2",
      "name": "speed_modified",
      "description": "Playback speed changed via slider, animation continues at new rate",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.playbackSpeed > 1.0"
    },
    {
      "id": "S3",
      "name": "crossfade_transition",
      "description": "Smooth blend between two animation clips in progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isCrossfading === true"
    },
    {
      "id": "S4",
      "name": "glow_effect_active",
      "description": "Sunglasses emissive glow cycling through RGB spectrum",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sunglassesGlowEnabled === true && window.__3D_STATE__.isCrossfading === false"
    },
    {
      "id": "S5",
      "name": "paused_state",
      "description": "Animation playback paused, all systems idle",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === false"
    },
    {
      "id": "S6",
      "name": "stability_run",
      "description": "Extended 60-second continuous operation with all features active",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T0_S0_S1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Animation mixer is playing",
        "First animation clip is active",
        "Playback speed is at default 1.0x"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentAnimationIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentAnimationIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playbackSpeed - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAnimationClips > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T1_S1_S2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 2.5; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Playback speed increased to 2.5x",
        "Animation continues playing at new speed",
        "Speed value is within valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playbackSpeed - 2.5) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed >= 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.playbackSpeed)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2_S2_S3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const select = document.querySelector('select'); if(select && select.options.length > 1) { select.selectedIndex = 1; select.dispatchEvent(new Event('change', {bubbles: true})); } const cfBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/crossfade/i)); if(cfBtn) cfBtn.click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Crossfade transition initiated",
        "Animation index changed",
        "Crossfade flag is active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isCrossfading === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentAnimationIndex !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.currentAnimationIndex)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentAnimationIndex < window.__3D_STATE__.totalAnimationClips",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3_S3_S4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Crossfade completed",
        "Sunglasses glow effect activated",
        "Glow phase cycling through sine wave"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isCrossfading === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunglassesGlowEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glowPhase === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.glowPhase >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.glowPhase <= 6.29",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glowPhase)",
            "tier": "L0"
          }
        ]
      }
    },
