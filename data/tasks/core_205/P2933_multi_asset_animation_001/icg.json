      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 1.0; slider.dispatchEvent(new Event('input', {bubbles: true})); } const playBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/pause|play/i)); if(playBtn) playBtn.click();",
        "wait_ms": 1200
      },
      "postconditions": [
        "Animation resumed at normal speed",
        "Speed reset to 1.0x",
        "System ready for stability test"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playbackSpeed - 1.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunglassesGlowEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isCrossfading === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAnimationClips > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.currentAnimationIndex)",
            "tier": "L1"
          }
        ]
      }
    },
    {
