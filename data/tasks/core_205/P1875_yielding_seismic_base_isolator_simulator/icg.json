{
  "task_id": "P1875_yielding_seismic_base_isolator_simulator",
  "affordances": [
    {
      "id": "A1",
      "name": "Building",
      "type": "3d_object",
      "semantic": "5-story building with independently moving floors on base isolators",
      "locator_hints": [
        "5 floor meshes",
        "columns between floors",
        "isolator pads below ground floor"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.floorDisplacements && window.__3D_STATE__.floorDisplacements.length === 5)"
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Terrain ground plane that oscillates during earthquake",
      "locator_hints": [
        "80x80 plane",
        "grid texture",
        "fault line"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.groundDisplacement === 'number')"
    },
    {
      "id": "A3",
      "name": "FoundationSlab",
      "type": "3d_object",
      "semantic": "Foundation slab rigidly connected to ground motion",
      "locator_hints": [
        "box below isolators",
        "color #666666"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "IsolatorPads",
      "type": "3d_object",
      "semantic": "4 base isolator cylinders between foundation and ground floor",
      "locator_hints": [
        "short wide cylinders",
        "color changes on yield"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.isolatorYielded === 'boolean')"
    },
    {
      "id": "A5",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing simulation parameters",
      "locator_hints": [
        "#hud-panel"
      ],
      "check": "!!document.getElementById('hud-panel')"
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#btn-reset"
      ],
      "check": "!!document.getElementById('btn-reset')"
    },
    {
      "id": "A7",
      "name": "ToggleQuakeButton",
      "type": "dom_element",
      "semantic": "Button to toggle earthquake on/off",
      "locator_hints": [
        "#btn-toggle-quake"
      ],
      "check": "!!document.getElementById('btn-toggle-quake')"
    },
    {
      "id": "A8",
      "name": "DisplacementTrail",
      "type": "3d_object",
      "semantic": "Line showing last 200 frames of roof displacement vs time",
      "locator_hints": [
        "LineGeometry",
        "trail",
        "roof displacement history"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.roofDisplacement === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.mode === 'ISOLATED'",
        "window.__3D_STATE__.earthquakeActive === false",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.resetCount === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mode === 'ISOLATED' && window.__3D_STATE__.earthquakeActive === false && window.__3D_STATE__.simTime === 0 && window.__3D_STATE__.resetCount === 0"
    },
    {
      "id": "S1",
      "name": "Earthquake_Active_Isolated",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true",
        "window.__3D_STATE__.mode === 'ISOLATED'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === true && window.__3D_STATE__.mode === 'ISOLATED'"
    },
    {
      "id": "S2",
      "name": "Earthquake_Active_Fixed",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true",
        "window.__3D_STATE__.mode === 'FIXED'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === true && window.__3D_STATE__.mode === 'FIXED'"
    },
    {
      "id": "S3",
      "name": "Earthquake_Active_Yielding",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true",
        "window.__3D_STATE__.mode === 'YIELDING'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === true && window.__3D_STATE__.mode === 'YIELDING'"
    },
    {
      "id": "S4",
      "name": "Amplitude_Modified",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true",
        "window.__3D_STATE__.amplitude !== 2.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === true && window.__3D_STATE__.amplitude !== 2.0"
    },
    {
      "id": "S5",
      "name": "Frequency_Modified",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true",
        "window.__3D_STATE__.frequency !== 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === true && window.__3D_STATE__.frequency !== 1.0"
    },
    {
      "id": "S6",
      "name": "Yielding_Occurred",
      "conditions": [
        "window.__3D_STATE__.mode === 'YIELDING'",
        "window.__3D_STATE__.isolatorYielded === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mode === 'YIELDING' && window.__3D_STATE__.isolatorYielded === true"
    },
    {
      "id": "S7",
      "name": "Post_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.simTime === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.resetCount >= 1 && window.__3D_STATE__.simTime === 0"
    },
    {
      "id": "S8",
      "name": "Earthquake_Stopped_After_Run",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === false",
        "window.__3D_STATE__.simTime > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.earthquakeActive === false && window.__3D_STATE__.simTime > 0"
    },
    {
      "id": "S9",
      "name": "High_Amplitude_Yielding",
      "conditions": [
        "window.__3D_STATE__.mode === 'YIELDING'",
        "window.__3D_STATE__.amplitude >= 4.0",
        "window.__3D_STATE__.earthquakeActive === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.mode === 'YIELDING' && window.__3D_STATE__.amplitude >= 4.0 && window.__3D_STATE__.earthquakeActive === true"
    },
    {
      "id": "S10",
      "name": "Post_Second_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 2",
        "window.__3D_STATE__.simTime === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.resetCount >= 2 && window.__3D_STATE__.simTime === 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.earthquakeActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'ISOLATED'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.floorDisplacements === 'object' && Array.isArray(window.__3D_STATE__.floorDisplacements) && window.__3D_STATE__.floorDisplacements.length === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.groundDisplacement === 'number' && !isNaN(window.__3D_STATE__.groundDisplacement)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.groundDisplacement) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalKineticEnergy === 'number' && !isNaN(window.__3D_STATE__.totalKineticEnergy) && window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalPotentialEnergy === 'number' && !isNaN(window.__3D_STATE__.totalPotentialEnergy) && window.__3D_STATE__.totalPotentialEnergy >= 0",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roofDisplacement) < Math.abs(window.__3D_STATE__.groundDisplacement) * 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.floorDisplacements.every(d => !isNaN(d) && Math.abs(d) < 20)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'FIXED'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isolatorStiffness >= 9999",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-mode') !== null && document.getElementById('hud-mode').textContent.includes('FIXED')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isolatorDamping === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'FIXED'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDriftRatio > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.interStoryDrifts === 'object' && Array.isArray(window.__3D_STATE__.interStoryDrifts) && window.__3D_STATE__.interStoryDrifts.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interStoryDrifts.every(d => !isNaN(d))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.floorVelocities.every(v => !isNaN(v) && Math.abs(v) < 100)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'YIELDING'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-mode') !== null && document.getElementById('hud-mode').textContent.includes('YIELDING')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isolatorYielded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isolatorStiffness <= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.amplitude === 2.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-amplitude') !== null && document.getElementById('hud-amplitude').textContent.includes('2.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energyInput === 'number' && !isNaN(window.__3D_STATE__.energyInput)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'YIELDING'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frequency === 1.25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-frequency') !== null && document.getElementById('hud-frequency').textContent.includes('1.25')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitude === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energyBalanceRatio === 'number' && !isNaN(window.__3D_STATE__.energyBalanceRatio)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));window.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowUp'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.amplitude >= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitude <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'YIELDING'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeActive === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-amplitude') !== null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isolatorYielded === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-yield-status') !== null && document.getElementById('hud-yield-status').textContent.includes('YIELDED')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyDissipated > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyBalanceRatio > 0.8 && window.__3D_STATE__.energyBalanceRatio < 1.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.isolatorDeformation) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDriftRatio > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.earthquakeActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-quake-status') !== null && document.getElementById('hud-quake-status').textContent.includes('STOPPED')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyDissipated > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.floorDisplacements.every(d => d === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.floorVelocities.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyDissipated === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyInput === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S7",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundDisplacement === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofDisplacement === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isolatorYielded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDriftRatio === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
