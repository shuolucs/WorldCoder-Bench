{
  "task_id": "P3200",
  "affordances": [
    {
      "id": "A1",
      "name": "Avocado Model",
      "type": "3d_object",
      "semantic": "Avocado.glb 3D model on pedestal",
      "locator_hints": [
        "avocado mesh",
        "fruit model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.avocadoScale !== undefined)"
    },
    {
      "id": "A2",
      "name": "Rolex Model",
      "type": "3d_object",
      "semantic": "rolex.glb 3D watch model at center",
      "locator_hints": [
        "rolex mesh",
        "watch model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.rolexRotationY !== undefined)"
    },
    {
      "id": "A3",
      "name": "Avocado Scale Slider",
      "type": "dom_element",
      "semantic": "Slider controlling Avocado scale (0.5-2.0)",
      "locator_hints": [
        "input[type='range']",
        "avocado scale control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Rolex Rotation Slider",
      "type": "dom_element",
      "semantic": "Slider controlling Rolex Y rotation (0-360)",
      "locator_hints": [
        "input[type='range']",
        "rolex rotation control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Key Light Intensity Slider",
      "type": "dom_element",
      "semantic": "Slider for key spotlight intensity (0-100)",
      "locator_hints": [
        "input[type='range']",
        "key light control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A6",
      "name": "Material Toggle Buttons",
      "type": "dom_element",
      "semantic": "Buttons to toggle gold-chrome material override",
      "locator_hints": [
        "button",
        "material toggle"
      ],
      "check": "document.querySelectorAll('button').length > 0"
    },
    {
      "id": "A7",
      "name": "Drag Interaction",
      "type": "interaction",
      "semantic": "Click-drag to translate selected object on XZ plane",
      "locator_hints": [
        "mouse drag",
        "object translation"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with both models at default positions, default materials, lights at initial distribution",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.avocadoScale === 1.0 && window.__3D_STATE__.rolexRotationY === 0 && !window.__3D_STATE__.avocadoMaterialOverride && !window.__3D_STATE__.rolexMaterialOverride)"
    },
    {
      "id": "S1",
      "name": "Avocado Scaled",
      "description": "Avocado scale modified via slider to non-default value",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoScale !== undefined && window.__3D_STATE__.avocadoScale !== 1.0"
    },
    {
      "id": "S2",
      "name": "Rolex Rotated",
      "description": "Rolex Y rotation changed from initial 0 radians",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.rolexRotationY !== undefined && window.__3D_STATE__.rolexRotationY !== 0"
    },
    {
      "id": "S3",
      "name": "Material Override Applied",
      "description": "At least one product has gold-chrome material override active",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.avocadoMaterialOverride === true || window.__3D_STATE__.rolexMaterialOverride === true)"
    },
    {
      "id": "S4",
      "name": "Light Energy Redistributed",
      "description": "Light intensities changed while maintaining total energy conservation at 150",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalLightEnergy !== undefined && Math.abs(window.__3D_STATE__.totalLightEnergy - 150) < 5"
    },
    {
      "id": "S5",
      "name": "Avocado Repositioned",
      "description": "Avocado moved from initial position via drag interaction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoPositionX !== undefined && window.__3D_STATE__.avocadoPositionZ !== undefined && (window.__3D_STATE__.avocadoPositionX !== 0 || window.__3D_STATE__.avocadoPositionZ !== 0)"
    },
    {
      "id": "S6",
      "name": "Full Configuration",
      "description": "Multiple parameters modified: scales, rotations, materials, lights, and positions",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoScale !== 1.0 && window.__3D_STATE__.rolexRotationY !== 0 && (window.__3D_STATE__.avocadoMaterialOverride === true || window.__3D_STATE__.rolexMaterialOverride === true) && window.__3D_STATE__.rolexScale !== undefined"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true})); document.querySelector('input[type=\"range\"]').value = 1.5; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Avocado scale changed to 1.5x"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avocadoScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avocadoScale > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avocadoScale - 1.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); for(let s of sliders) { if(s.max == '360' || s.max == '6.28') { s.value = 180; s.dispatchEvent(new Event('input', {bubbles: true})); break; } }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Rolex rotated 180 degrees"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.rolexRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rolexRotationY > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rolexRotationY - Math.PI) < 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = document.querySelectorAll('button'); for(let b of buttons) { if(b.textContent.match(/material|gold|chrome/i)) { b.click(); break; } }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Gold-chrome material applied to one product"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avocadoMaterialOverride === 'boolean' || typeof window.__3D_STATE__.rolexMaterialOverride === 'boolean'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoMaterialOverride === true || window.__3D_STATE__.rolexMaterialOverride === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); for(let s of sliders) { if(s.max == '100') { s.value = 80; s.dispatchEvent(new Event('input', {bubbles: true})); break; } }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Light intensities redistributed while conserving total energy at 150"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.keyLightIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyLightIntensity >= 0 && window.__3D_STATE__.fillLightIntensity >= 0 && window.__3D_STATE__.rimLightIntensity >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalLightEnergy - 150) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.6; const y = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('mousedown', {clientX: x, clientY: y, bubbles: true})); setTimeout(() => { canvas.dispatchEvent(new MouseEvent('mousemove', {clientX: x + 50, clientY: y, bubbles: true})); setTimeout(() => { canvas.dispatchEvent(new MouseEvent('mouseup', {clientX: x + 50, clientY: y, bubbles: true})); }, 100); }, 100);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Avocado position changed via drag interaction"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avocadoPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avocadoPositionX !== undefined && window.__3D_STATE__.avocadoPositionZ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.avocadoPositionX) && isFinite(window.__3D_STATE__.avocadoPositionZ)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders.length > 1) { sliders[1].value = 0.8; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Multiple configuration parameters modified across products and lighting"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.rolexScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rolexScale > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rolexScale - 0.8) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable with all configurations maintained for 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalLightEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalLightEnergy >= 145",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalLightEnergy - 150) < 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
