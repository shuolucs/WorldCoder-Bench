{
  "task_id": "P2903",
  "affordances": [
    {
      "id": "A1",
      "name": "AntiqueCamera Model",
      "type": "3d_object",
      "semantic": "Left-side loaded GLB asset representing spectroscopy source",
      "locator_hints": [
        "AntiqueCamera.glb",
        "left side of scene",
        "warm point light nearby"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "IridescenceAbalone Model",
      "type": "3d_object",
      "semantic": "Right-side loaded GLB asset representing spectroscopy target",
      "locator_hints": [
        "IridescenceAbalone.glb",
        "right side of scene",
        "can rotate 0 or 45 degrees"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && typeof window.__3D_STATE__.abaloneRotation === 'number')"
    },
    {
      "id": "A3",
      "name": "Spectroscopy Beam",
      "type": "3d_object",
      "semantic": "Cyan cylinder connecting camera to abalone, color changes with wavelength",
      "locator_hints": [
        "thin cylinder",
        "between models",
        "cyan color",
        "opacity varies"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.beamOpacity > 0)"
    },
    {
      "id": "A4",
      "name": "Wavelength Slider",
      "type": "dom_element",
      "semantic": "Slider control for wavelength 380-780nm, changes beam color",
      "locator_hints": [
        "wavelength",
        "380nm to 780nm",
        "spectrum mapping"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A5",
      "name": "Focal Distance Slider",
      "type": "dom_element",
      "semantic": "Slider control for focal distance affecting beam width",
      "locator_hints": [
        "focal distance",
        "scales beam width"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A6",
      "name": "Exposure Dial",
      "type": "dom_element",
      "semantic": "Selector for exposure level Low/Medium/High adjusting beam opacity",
      "locator_hints": [
        "exposure",
        "Low/Medium/High",
        "beam opacity"
      ],
      "check": "!!(document.querySelector('select') || document.querySelector('[data-exposure]'))"
    },
    {
      "id": "A7",
      "name": "Polarization Toggle",
      "type": "interaction",
      "semantic": "Control to switch polarization mode between S and P",
      "locator_hints": [
        "polarization",
        "S or P mode"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene initializing, models loading, default parameters set",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "default_configuration",
      "description": "Both models loaded, beam visible with mid-range wavelength, medium exposure",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.wavelengthNm >= 500 && window.__3D_STATE__.wavelengthNm <= 650 && window.__3D_STATE__.exposureLevel === 1"
    },
    {
      "id": "S2",
      "name": "violet_spectrum",
      "description": "Wavelength adjusted to violet range (380-450nm), beam color shifted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.wavelengthNm >= 380 && window.__3D_STATE__.wavelengthNm <= 450"
    },
    {
      "id": "S3",
      "name": "focal_adjusted",
      "description": "Focal distance modified, beam width changed accordingly",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.focalDistance === 'number' && window.__3D_STATE__.focalDistance >= 0.5 && window.__3D_STATE__.focalDistance <= 2.0"
    },
    {
      "id": "S4",
      "name": "high_exposure",
      "description": "Exposure set to High, beam opacity at maximum",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.exposureLevel === 2 && window.__3D_STATE__.beamOpacity >= 0.7"
    },
    {
      "id": "S5",
      "name": "polarization_switched",
      "description": "Polarization mode toggled to alternate state",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.polarizationMode === 'string' && window.__3D_STATE__.polarizationMode.length > 0"
    },
    {
      "id": "S6",
      "name": "abalone_rotated",
      "description": "Abalone model rotated 45 degrees, beam connection maintained",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.abaloneRotation === 'number' && (Math.abs(window.__3D_STATE__.abaloneRotation - 45) < 5 || Math.abs(window.__3D_STATE__.abaloneRotation - 0) < 5)"
    },
    {
      "id": "S7",
      "name": "stability_test",
      "description": "All parameters stable, 60-second continuous operation verification",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T0_1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Models loaded and visible",
        "Beam rendered between camera and abalone",
        "Default wavelength ~580nm set",
        "Exposure at Medium level"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wavelengthNm === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthNm >= 380 && window.__3D_STATE__.wavelengthNm <= 780",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beamOpacity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamOpacity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.exposureLevel === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1_2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 410; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wavelength set to violet range",
        "Beam color shifted to violet spectrum",
        "State reflects wavelength change"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wavelengthNm >= 380 && window.__3D_STATE__.wavelengthNm <= 450",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.wavelengthNm - 410) < 20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beamWidth === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamWidth > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2_3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[1].value = 1.5; sliders[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Focal distance adjusted to 1.5",
        "Beam width scaled accordingly",
        "Visual beam geometry updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.focalDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.focalDistance >= 0.5 && window.__3D_STATE__.focalDistance <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.focalDistance - 1.5) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamWidth)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamWidth > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3_4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const exposureSelect = document.querySelector('select') || document.querySelector('[data-exposure]'); if (exposureSelect.tagName === 'SELECT') { exposureSelect.value = 'High'; exposureSelect.dispatchEvent(new Event('change', {bubbles: true})); } else { exposureSelect.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Exposure level set to High (index 2)",
        "Beam opacity increased to maximum range",
        "Visual beam brightness enhanced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.exposureLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.exposureLevel === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beamOpacity >= 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beamOpacity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamOpacity)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4_5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const polarizationBtn = document.querySelector('button[data-polarization]') || Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/polarization|S|P/i)); if (polarizationBtn) polarizationBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Polarization mode toggled",
        "Mode switched between S and P",
        "State reflects new polarization"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.polarizationMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.polarizationMode !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polarizationMode.length > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthNm >= 380",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposureLevel >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.exposureLevel)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5_6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rotateBtn = document.querySelector('button[data-rotate]') || Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/rotate|abalone/i)); if (rotateBtn) rotateBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Abalone model rotated 45 degrees",
        "Beam connection maintained",
        "Rotation state updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.abaloneRotation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.abaloneRotation !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.abaloneRotation >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.abaloneRotation - 45) < 5 || Math.abs(window.__3D_STATE__.abaloneRotation - 0) < 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.abaloneRotation)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6_7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "All state fields remain stable for 60 seconds",
        "No crashes or errors",
        "Beam rendering continuous",
        "Models remain visible and interactive"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wavelengthNm === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthNm >= 380 && window.__3D_STATE__.wavelengthNm <= 780",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalDistance >= 0.5 && window.__3D_STATE__.focalDistance <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposureLevel >= 0 && window.__3D_STATE__.exposureLevel <= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beamOpacity > 0 && window.__3D_STATE__.beamOpacity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamWidth) && window.__3D_STATE__.beamWidth > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
