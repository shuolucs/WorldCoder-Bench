{
  "task_id": "P2867",
  "affordances": [
    {
      "id": "A1",
      "name": "Red Energy Slider",
      "type": "dom_element",
      "semantic": "Vertical slider controlling red channel energy allocation (0-100)",
      "locator_hints": [
        "input[type='range']",
        "slider for red",
        "R energy control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Green Energy Slider",
      "type": "dom_element",
      "semantic": "Vertical slider controlling green channel energy allocation (0-100)",
      "locator_hints": [
        "input[type='range']",
        "slider for green",
        "G energy control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Blue Energy Slider",
      "type": "dom_element",
      "semantic": "Vertical slider controlling blue channel energy allocation (0-100)",
      "locator_hints": [
        "input[type='range']",
        "slider for blue",
        "B energy control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Spectral Mode Selector",
      "type": "dom_element",
      "semantic": "Control to switch lantern spectral mode between red/green/blue",
      "locator_hints": [
        "select",
        "radio buttons",
        "spectral mode toggle"
      ],
      "check": "!!document.querySelector('select') || document.querySelectorAll('input[type=\"radio\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Glass Window Model",
      "type": "3d_object",
      "semantic": "GlassBrokenWindow.glb with custom shader material at (0,2,0)",
      "locator_hints": [
        "mesh with ShaderMaterial",
        "window geometry",
        "glass object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "Lantern Model",
      "type": "3d_object",
      "semantic": "Lantern.glb with glow shader at (0,0.5,2)",
      "locator_hints": [
        "mesh with emissive shader",
        "lantern geometry",
        "light source"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_dark",
      "description": "Scene loaded with both models present, all energy channels at zero, glass appears black, lantern has no glow",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === false) || (window.__3D_STATE__.redEnergy === 0 && window.__3D_STATE__.greenEnergy === 0 && window.__3D_STATE__.blueEnergy === 0)"
    },
    {
      "id": "S1",
      "name": "red_channel_active",
      "description": "Red energy slider adjusted, red channel reveals color in glass, total energy increased",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redEnergy > 0 && window.__3D_STATE__.greenEnergy === 0 && window.__3D_STATE__.blueEnergy === 0"
    },
    {
      "id": "S2",
      "name": "multi_channel_partial",
      "description": "Multiple RGB sliders adjusted, glass shows mixed color channels, energy distributed across channels",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redEnergy > 0 && window.__3D_STATE__.greenEnergy > 0 && window.__3D_STATE__.blueEnergy > 0 && window.__3D_STATE__.totalEnergyUnits < 130"
    },
    {
      "id": "S3",
      "name": "spectral_mode_switched",
      "description": "Lantern spectral mode changed, lantern glow tint updated to match selected mode",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.spectralMode === 'number' && window.__3D_STATE__.spectralMode !== 0"
    },
    {
      "id": "S4",
      "name": "full_energy_allocated",
      "description": "All three RGB channels at maximum or near-maximum, total energy units approach 150, glass fully visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redEnergy > 0.8 && window.__3D_STATE__.greenEnergy > 0.7 && window.__3D_STATE__.blueEnergy > 0.6 && window.__3D_STATE__.totalEnergyUnits > 130"
    },
    {
      "id": "S5",
      "name": "balanced_energy_state",
      "description": "Energy balanced across channels, isEnergyBalanced flag true, glass opacity stable",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isEnergyBalanced === true"
    },
    {
      "id": "S6",
      "name": "stable_runtime",
      "description": "System running stably for extended period with all shaders active and state consistent",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && isFinite(window.__3D_STATE__.totalEnergyUnits) && window.__3D_STATE__.historyStackSize !== undefined"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 50; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1200
      },
      "postconditions": [
        "Red energy channel increased from zero",
        "Glass window shader reflects red energy uniform update",
        "Total energy units incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.redEnergy >= 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyUnits > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.greenEnergy === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[1]){sliders[1].value=35; sliders[1].dispatchEvent(new Event('input',{bubbles:true}));} if(sliders[2]){sliders[2].value=25; sliders[2].dispatchEvent(new Event('input',{bubbles:true}));}",
        "wait_ms": 1500
      },
      "postconditions": [
        "Green and blue energy channels now non-zero",
        "Total energy units reflects sum of all three channels",
        "Glass shader displays mixed color channels"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.greenEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.blueEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyUnits > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyUnits)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.glassOpacity !== undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const spectralControl = document.querySelector('select') || document.querySelectorAll('input[type=\"radio\"]')[1]; if(spectralControl.tagName==='SELECT'){spectralControl.value='1'; spectralControl.dispatchEvent(new Event('change',{bubbles:true}));} else if(spectralControl){spectralControl.checked=true; spectralControl.dispatchEvent(new Event('change',{bubbles:true}));}",
        "wait_ms": 1000
      },
      "postconditions": [
        "Spectral mode changed to green (mode 1)",
        "Lantern shader uniform updated",
        "Lantern glow tint reflects green spectral mode"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.spectralMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spectralMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lanternIntensity !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.spectralMode)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders.forEach((s,i)=>{s.value=i===0?95:(i===1?90:85); s.dispatchEvent(new Event('input',{bubbles:true}));});",
        "wait_ms": 1800
      },
      "postconditions": [
        "All RGB energy channels at high values",
        "Total energy units approaches maximum (150)",
        "Glass opacity near maximum, fully visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redEnergy > 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.greenEnergy > 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blueEnergy > 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyUnits > 130",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassOpacity > 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glassOpacity)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders.forEach(s=>{s.value=50; s.dispatchEvent(new Event('input',{bubbles:true}));});",
        "wait_ms": 1200
      },
      "postconditions": [
        "All RGB channels set to equal values",
        "isEnergyBalanced flag becomes true",
        "Total energy units reflects balanced allocation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isEnergyBalanced === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isEnergyBalanced === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.redEnergy - 0.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.greenEnergy - 0.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blueEnergy - 0.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const spectralControl = document.querySelector('select') || document.querySelectorAll('input[type=\"radio\"]')[2]; if(spectralControl.tagName==='SELECT'){spectralControl.value='2'; spectralControl.dispatchEvent(new Event('change',{bubbles:true}));} else if(spectralControl){spectralControl.checked=true; spectralControl.dispatchEvent(new Event('change',{bubbles:true}));}",
        "wait_ms": 1000
      },
      "postconditions": [
        "Spectral mode switched to blue (mode 2)",
        "Lantern glow tint updated to blue",
        "All state fields remain stable and valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.spectralMode === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lanternIntensity !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyUnits)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All shader uniforms maintain consistent values",
        "No runtime errors or state corruption"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.greenEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.blueEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.redEnergy)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.greenEnergy)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.blueEnergy)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
