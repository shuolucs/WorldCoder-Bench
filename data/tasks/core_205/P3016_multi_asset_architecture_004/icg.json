{
  "task_id": "P3016",
  "affordances": [
    {
      "id": "A1",
      "name": "Add Avocado Button",
      "type": "dom_element",
      "semantic": "Button to spawn avocado on counter (max 5)",
      "locator_hints": [
        "button",
        "text:Add Avocado",
        "id:addAvocado"
      ],
      "check": "!!document.getElementById('addAvocado')"
    },
    {
      "id": "A2",
      "name": "Avocado Objects",
      "type": "3d_object",
      "semantic": "Draggable avocado models on counter",
      "locator_hints": [
        "mesh",
        "name:avocado",
        "userData.draggable"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.avocadoCount > 0)"
    },
    {
      "id": "A3",
      "name": "Coffee Machine",
      "type": "3d_object",
      "semantic": "Clickable coffee machine that rotates through 3 angles",
      "locator_hints": [
        "mesh",
        "name:coffeemat",
        "userData.clickable"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.coffeeMachineRotation !== undefined)"
    },
    {
      "id": "A4",
      "name": "Lighting Preset Toggle",
      "type": "dom_element",
      "semantic": "Button to cycle through lighting modes",
      "locator_hints": [
        "button",
        "text:Lighting",
        "id:lightingToggle"
      ],
      "check": "!!document.getElementById('lightingToggle')"
    },
    {
      "id": "A5",
      "name": "Counter Resize Slider",
      "type": "dom_element",
      "semantic": "Slider to adjust counter length",
      "locator_hints": [
        "input[type=range]",
        "id:counterLength"
      ],
      "check": "!!document.getElementById('counterLength')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_empty_counter",
      "description": "Scene loaded with empty counter, coffee machine at 0°, daylight lighting",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoCount === 0 && window.__3D_STATE__.coffeeMachineRotation === 0 && window.__3D_STATE__.lightingPreset === 0"
    },
    {
      "id": "S1",
      "name": "avocados_added",
      "description": "Multiple avocados placed on counter at random positions",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoCount > 0 && window.__3D_STATE__.avocadoCount <= 5"
    },
    {
      "id": "S2",
      "name": "avocado_repositioned",
      "description": "Avocado dragged to new x-position on counter",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.avocadoCount > 0 && window.__3D_STATE__.avocadoPositions !== null"
    },
    {
      "id": "S3",
      "name": "coffee_machine_rotated",
      "description": "Coffee machine rotated to 45° or -45°",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.coffeeMachineRotation) === 45"
    },
    {
      "id": "S4",
      "name": "lighting_changed",
      "description": "Lighting preset cycled to evening or spotlight mode",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lightingPreset > 0"
    },
    {
      "id": "S5",
      "name": "counter_resized",
      "description": "Counter length adjusted via slider",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.counterLength !== undefined && window.__3D_STATE__.counterLength !== 5.0"
    },
    {
      "id": "S6",
      "name": "final_configuration",
      "description": "All interactions complete, scene stable for 60s",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<3; i++) { document.querySelector('#addAvocado')?.click(); await new Promise(r => setTimeout(r, 400)); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "3 avocados spawned on counter at random x-positions"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avocadoCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avocadoCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoPositions !== undefined",
            "tier": "L2"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.avocadoPositions).length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoCount > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const startX = rect.left + rect.width * 0.4; const startY = rect.top + rect.height * 0.5; const endX = rect.left + rect.width * 0.6; canvas.dispatchEvent(new MouseEvent('mousedown', {clientX: startX, clientY: startY, bubbles: true})); await new Promise(r => setTimeout(r, 100)); canvas.dispatchEvent(new MouseEvent('mousemove', {clientX: endX, clientY: startY, bubbles: true})); await new Promise(r => setTimeout(r, 100)); canvas.dispatchEvent(new MouseEvent('mouseup', {clientX: endX, clientY: startY, bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "Avocado dragged along counter x-axis to new position"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avocadoPositions === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avocadoPositions !== null",
            "tier": "L1"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.avocadoPositions).length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const clickX = rect.left + rect.width * 0.7; const clickY = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('click', {clientX: clickX, clientY: clickY, bubbles: true})); await new Promise(r => setTimeout(r, 300)); canvas.dispatchEvent(new MouseEvent('click', {clientX: clickX, clientY: clickY, bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Coffee machine rotated to 45° or -45° after clicks"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.coffeeMachineRotation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coffeeMachineRotation !== 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.coffeeMachineRotation) === 45",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.coffeeMachineRotation)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coffeeMachineRotation !== undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('#lightingToggle')?.click(); await new Promise(r => setTimeout(r, 400)); document.querySelector('#lightingToggle')?.click();",
        "wait_ms": 1200
      },
      "postconditions": [
        "Lighting preset cycled to evening (1) or spotlight (2) mode"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lightingPreset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightingPreset > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.lightingPreset !== 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.lightingPreset)",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.ambientIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.directionalIntensity)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('#counterLength'); if(slider) { slider.value = 7.0; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Counter length adjusted to 7.0 units via slider"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.counterLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.counterLength > 4.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.counterLength - 7.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.counterLength)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('#addAvocado')?.click(); await new Promise(r => setTimeout(r, 400)); document.querySelector('#addAvocado')?.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "2 more avocados added, total now 5 (max capacity)"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avocadoCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.avocadoPositions).length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoCount > 4",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.avocadoCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene stable for 60 seconds with all interactions complete"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avocadoCount === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.counterLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightingPreset > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.coffeeMachineRotation) === 45",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.ambientIntensity)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avocadoPositions !== null",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
