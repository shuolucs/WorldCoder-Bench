{
  "task_id": "P3086",
  "affordances": [
    {
      "id": "A1",
      "name": "Bloom Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable UnrealBloomPass",
      "locator_hints": [
        "dat.GUI checkbox",
        "bloom toggle control"
      ],
      "check": "document.querySelectorAll('input[type=\"checkbox\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Bloom Strength Slider",
      "type": "dom_element",
      "semantic": "Slider controlling bloom intensity from 0 to 3",
      "locator_hints": [
        "dat.GUI slider",
        "bloom strength parameter"
      ],
      "check": "!!document.querySelector('input[type=\"number\"]')"
    },
    {
      "id": "A3",
      "name": "Color Grade Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable sepia color grading shader",
      "locator_hints": [
        "dat.GUI checkbox",
        "color grade toggle"
      ],
      "check": "document.querySelectorAll('input[type=\"checkbox\"]').length > 1"
    },
    {
      "id": "A4",
      "name": "Color Grade Mix Slider",
      "type": "dom_element",
      "semantic": "Slider controlling sepia tone intensity from 0 to 1",
      "locator_hints": [
        "dat.GUI slider",
        "color mix parameter"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"number\"]')).some(el => el.max == 1)"
    },
    {
      "id": "A5",
      "name": "DOF Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable BokehPass depth-of-field",
      "locator_hints": [
        "dat.GUI checkbox",
        "DOF toggle control"
      ],
      "check": "document.querySelectorAll('input[type=\"checkbox\"]').length > 2"
    },
    {
      "id": "A6",
      "name": "DOF Focus Slider",
      "type": "dom_element",
      "semantic": "Slider adjusting focus distance for depth-of-field",
      "locator_hints": [
        "dat.GUI slider",
        "focus distance parameter"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"number\"]')).some(el => parseFloat(el.value) > 3 || el.min > 0)"
    },
    {
      "id": "A7",
      "name": "Coffee Mug Model",
      "type": "3d_object",
      "semantic": "GLB model of coffee mug positioned at origin",
      "locator_hints": [
        "coffeeMug.glb",
        "mug mesh at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A8",
      "name": "Amber Specimen Model",
      "type": "3d_object",
      "semantic": "GLB model of mosquito in amber leaning against mug",
      "locator_hints": [
        "MosquitoInAmber.glb",
        "amber object near mug"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with models, no post-processing effects active",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded && !window.__3D_STATE__.bloomEnabled && !window.__3D_STATE__.colorGradeEnabled && !window.__3D_STATE__.dofEnabled)"
    },
    {
      "id": "S1",
      "name": "Bloom Active",
      "description": "UnrealBloomPass enabled with default strength 1.5",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bloomEnabled === true && Math.abs(window.__3D_STATE__.bloomStrength - 1.5) < 0.01"
    },
    {
      "id": "S2",
      "name": "Bloom Adjusted",
      "description": "Bloom strength modified to a different valid value",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bloomEnabled === true && Math.abs(window.__3D_STATE__.bloomStrength - 1.5) >= 0.01"
    },
    {
      "id": "S3",
      "name": "Color Grading Active",
      "description": "Sepia color grading shader enabled with mix intensity set",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.colorGradeEnabled === true"
    },
    {
      "id": "S4",
      "name": "DOF Active",
      "description": "BokehPass depth-of-field enabled with focus on amber object",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dofEnabled === true"
    },
    {
      "id": "S5",
      "name": "Multi-Effect Chain",
      "description": "Multiple post-processing effects active simultaneously",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.effectsChainLength >= 3"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "All effects configured and scene stable for 60 seconds",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"checkbox\"]').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bloom effect is enabled",
        "bloomEnabled state is true",
        "bloomStrength is set to default 1.5"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bloomEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bloomStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomStrength - 1.5) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"number\"]')).find(el => el.max == 3); if(slider) { slider.value = 2.5; slider.dispatchEvent(new Event('input', {bubbles: true})); slider.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bloom strength adjusted to 2.5",
        "bloomStrength state reflects new value",
        "Value is within valid range 0-3"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bloomStrength >= 0 && window.__3D_STATE__.bloomStrength <= 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomStrength - 2.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.bloomStrength)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const checkboxes = Array.from(document.querySelectorAll('input[type=\"checkbox\"]')); if(checkboxes[1]) checkboxes[1].click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color grading shader is enabled",
        "colorGradeEnabled state is true",
        "Sepia tone mixing is active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorGradeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorGradeMix === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorGradeMix >= 0 && window.__3D_STATE__.colorGradeMix <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const checkboxes = Array.from(document.querySelectorAll('input[type=\"checkbox\"]')); if(checkboxes[2]) checkboxes[2].click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "BokehPass depth-of-field is enabled",
        "dofEnabled state is true",
        "Focus distance is set to amber object distance"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dofEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dofFocusDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dofFocusDistance > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = Array.from(document.querySelectorAll('input[type=\"number\"]')); const focusSlider = sliders.find(el => parseFloat(el.value) > 3); if(focusSlider) { focusSlider.value = parseFloat(focusSlider.value) + 1; focusSlider.dispatchEvent(new Event('input', {bubbles: true})); focusSlider.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "DOF focus distance adjusted",
        "Multiple effects active in chain",
        "effectsChainLength reflects active passes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.effectsChainLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.effectsChainLength >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.effectsChainLength)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const mixSlider = Array.from(document.querySelectorAll('input[type=\"number\"]')).find(el => el.max == 1 && el.step); if(mixSlider) { mixSlider.value = 0.7; mixSlider.dispatchEvent(new Event('input', {bubbles: true})); mixSlider.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color grade mix intensity adjusted to 0.7",
        "All active effects remain stable",
        "State values are valid numbers"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorGradeMix !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.colorGradeMix - 0.7) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bloomEnabled === true && window.__3D_STATE__.colorGradeEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid",
        "No errors or crashes occur"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bloomStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.effectsChainLength >= 3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.bloomStrength) && isFinite(window.__3D_STATE__.colorGradeMix) && isFinite(window.__3D_STATE__.dofFocusDistance)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
