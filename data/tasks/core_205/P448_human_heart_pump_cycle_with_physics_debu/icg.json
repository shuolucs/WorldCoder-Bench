{
  "task_id": "P448_human_heart_pump_cycle_with_physics_debu",
  "affordances": [
    {
      "id": "A1",
      "name": "HeartChambers",
      "type": "3d_object",
      "semantic": "Four procedural sphere chambers representing heart anatomy",
      "locator_hints": [
        "scene.children with sphere geometry",
        "meshes named LA, RA, LV, RV"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.la === 'number' && typeof window.__3D_STATE__.ra === 'number')"
    },
    {
      "id": "A2",
      "name": "BloodParticles",
      "type": "3d_object",
      "semantic": "Particle system representing blood flow",
      "locator_hints": [
        "Points object in scene",
        "BufferGeometry with 200 points"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.particleCount > 0)"
    },
    {
      "id": "A3",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug information panel",
      "locator_hints": [
        "#debug-overlay"
      ],
      "check": "!!document.getElementById('debug-overlay')"
    },
    {
      "id": "A4",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggle animation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ],
      "check": "!!document.getElementById('btn-play-pause')"
    },
    {
      "id": "A5",
      "name": "HeartRateSlider",
      "type": "dom_element",
      "semantic": "Slider to control heart rate BPM",
      "locator_hints": [
        "#slider-heart-rate"
      ],
      "check": "!!document.getElementById('slider-heart-rate')"
    },
    {
      "id": "A6",
      "name": "DebugCheckbox",
      "type": "dom_element",
      "semantic": "Toggle debug overlay visibility",
      "locator_hints": [
        "#chk-debug"
      ],
      "check": "!!document.getElementById('chk-debug')"
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset all values to defaults",
      "locator_hints": [
        "#btn-reset"
      ],
      "check": "!!document.getElementById('btn-reset')"
    },
    {
      "id": "A8",
      "name": "NextPhaseButton",
      "type": "dom_element",
      "semantic": "Manually advance cardiac phase",
      "locator_hints": [
        "#btn-next-phase"
      ],
      "check": "!!document.getElementById('btn-next-phase')"
    },
    {
      "id": "A9",
      "name": "PhaseLabel",
      "type": "dom_element",
      "semantic": "Display of current cardiac phase name",
      "locator_hints": [
        "#phase-label"
      ],
      "check": "!!document.getElementById('phase-label')"
    },
    {
      "id": "A10",
      "name": "CityModel",
      "type": "3d_object",
      "semantic": "LittlestTokyo.glb background model",
      "locator_hints": [
        "GLTF loaded model in scene"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.heartRate === 72",
        "window.__3D_STATE__.debugVisible === true",
        "window.__3D_STATE__.particleCount === 200",
        "window.__3D_STATE__.cycleCount === 0 || window.__3D_STATE__.cycleCount >= 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.heartRate === 72 && window.__3D_STATE__.debugVisible === true"
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === false"
    },
    {
      "id": "S2",
      "name": "HeartRateChanged",
      "conditions": [
        "window.__3D_STATE__.heartRate !== 72",
        "window.__3D_STATE__.heartRate >= 40",
        "window.__3D_STATE__.heartRate <= 180"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heartRate !== 72 && window.__3D_STATE__.heartRate >= 40 && window.__3D_STATE__.heartRate <= 180"
    },
    {
      "id": "S3",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.debugVisible === false"
    },
    {
      "id": "S4",
      "name": "PhaseAdvanced",
      "conditions": [
        "window.__3D_STATE__.phaseIndex >= 0",
        "window.__3D_STATE__.phaseIndex <= 3"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.phaseIndex >= 0 && window.__3D_STATE__.phaseIndex <= 3"
    },
    {
      "id": "S5",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.heartRate === 72",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.debugVisible === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heartRate === 72 && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.debugVisible === true"
    },
    {
      "id": "S6",
      "name": "RunningAfterResume",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.cycleProgress >= 0",
        "window.__3D_STATE__.cycleProgress <= 100"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.cycleProgress >= 0 && window.__3D_STATE__.cycleProgress <= 100"
    },
    {
      "id": "S7",
      "name": "HighHeartRate",
      "conditions": [
        "window.__3D_STATE__.heartRate >= 140",
        "window.__3D_STATE__.heartRate <= 180"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heartRate >= 140 && window.__3D_STATE__.heartRate <= 180"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.la !== before.la || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.la === 'number' && !isNaN(window.__3D_STATE__.la)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ra === 'number' && !isNaN(window.__3D_STATE__.ra)",
            "tier": "L0"
          }
        ]
      }
    },
