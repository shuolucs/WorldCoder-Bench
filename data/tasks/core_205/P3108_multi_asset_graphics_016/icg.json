{
  "task_id": "P3108",
  "affordances": [
    {
      "id": "A1",
      "name": "Refraction Preset Dropdown",
      "type": "dom_element",
      "semantic": "Dropdown select with 5 refraction presets (Diamond, Water, Glass, Crystal, Air)",
      "locator_hints": [
        "select",
        "dropdown",
        "refraction",
        "preset",
        "ior"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A2",
      "name": "Environment Intensity Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling environment light intensity from 0 to 5",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "environment",
        "intensity"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A3",
      "name": "Sunglasses Object",
      "type": "3d_object",
      "semantic": "Clickable 3D sunglasses model that toggles polarization filter",
      "locator_hints": [
        "SunglassesKhronos",
        "sunglasses",
        "mesh",
        "clickable"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.glassObjectsLoaded > 0)"
    },
    {
      "id": "A4",
      "name": "Broken Window Object",
      "type": "3d_object",
      "semantic": "Clickable 3D broken window pane that toggles shattered state",
      "locator_hints": [
        "GlassBrokenWindow",
        "window",
        "broken",
        "mesh",
        "clickable"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.glassObjectsLoaded > 0)"
    },
    {
      "id": "A5",
      "name": "Glass Vase Object",
      "type": "3d_object",
      "semantic": "3D vase with flowers demonstrating glass refraction",
      "locator_hints": [
        "GlassVaseFlowers",
        "vase",
        "flowers",
        "mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.glassObjectsLoaded > 0)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading, assets not yet ready, default parameters not set",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.glassObjectsLoaded !== 3"
    },
    {
      "id": "S1",
      "name": "Default Glass State",
      "description": "All three GLB assets loaded with default Glass preset (ior=1.5), environment intensity at mid-range, no polarization, window intact",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.glassObjectsLoaded === 3 && Math.abs(window.__3D_STATE__.refractionIor - 1.5) < 0.01 && !window.__3D_STATE__.polarizationActive && !window.__3D_STATE__.windowShattered"
    },
    {
      "id": "S2",
      "name": "Diamond Refraction Active",
      "description": "User selected Diamond preset with high ior=2.42, all glass materials updated",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.refractionIor - 2.42) < 0.01 && window.__3D_STATE__.activePresetIndex === 0"
    },
    {
      "id": "S3",
      "name": "High Environment Intensity",
      "description": "Environment intensity slider set to maximum (5.0), scene brightly lit",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.environmentIntensity - 5.0) < 0.1"
    },
    {
      "id": "S4",
      "name": "Polarization Filter Enabled",
      "description": "Sunglasses clicked, polarization filter active, visual effect applied",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.polarizationActive === true"
    },
    {
      "id": "S5",
      "name": "Window Shattered",
      "description": "Broken window clicked and transitioned to shattered state",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.windowShattered === true"
    },
    {
      "id": "S6",
      "name": "Complex Multi-State",
      "description": "Water preset active, low environment intensity, polarization on, window shattered",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.refractionIor - 1.33) < 0.01 && window.__3D_STATE__.environmentIntensity < 0.5 && window.__3D_STATE__.polarizationActive === true && window.__3D_STATE__.windowShattered === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "All three GLB assets loaded successfully",
        "Glass materials applied with default ior=1.5",
        "Environment intensity initialized to valid range",
        "Camera positioned correctly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.glassObjectsLoaded === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.refractionIor - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.environmentIntensity >= 0 && window.__3D_STATE__.environmentIntensity <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMeshesWithGlass > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('select').selectedIndex = 0; document.querySelector('select').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Refraction preset changed to Diamond",
        "IOR updated to 2.42 on all glass materials",
        "Active preset index set to 0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.refractionIor - 2.42) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePresetIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refractionIor >= 1.0 && window.__3D_STATE__.refractionIor <= 2.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); slider.value = slider.max; slider.dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Environment intensity set to maximum value 5.0",
        "Scene brightness increased significantly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.environmentIntensity - 5.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.environmentIntensity >= 4.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.environmentIntensity === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width / 2; const y = rect.top + rect.height / 2; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Sunglasses clicked and polarization filter toggled on",
        "Polarization state changed to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.polarizationActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.polarizationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastInteractionTimestamp > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.75; const y = rect.top + rect.height / 2; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Broken window clicked and shattered state toggled",
        "Window shattered boolean set to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windowShattered === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windowShattered === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.glassObjectsLoaded)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const select = document.querySelector('select'); select.selectedIndex = 1; select.dispatchEvent(new Event('change', {bubbles: true})); setTimeout(() => { const slider = document.querySelector('input[type=\"range\"]'); slider.value = slider.min; slider.dispatchEvent(new Event('input', {bubbles: true})); }, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Water preset selected with ior=1.33",
        "Environment intensity reduced to minimum 0",
        "Polarization and shattered state remain active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.refractionIor - 1.33) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.environmentIntensity < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polarizationActive === true && window.__3D_STATE__.windowShattered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePresetIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid and within bounds",
        "No crashes or errors during extended runtime"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.glassObjectsLoaded === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refractionIor >= 1.0 && window.__3D_STATE__.refractionIor <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.environmentIntensity >= 0 && window.__3D_STATE__.environmentIntensity <= 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
