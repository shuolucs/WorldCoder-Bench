{
  "task_id": "P2925",
  "affordances": [
    {
      "id": "A1",
      "name": "Lantern Chamber",
      "type": "3d_object",
      "semantic": "reaction chamber holding gas mixture",
      "locator_hints": [
        "Lantern.glb",
        "centered at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Ion Drive",
      "type": "3d_object",
      "semantic": "ion excitation source",
      "locator_hints": [
        "PrimaryIonDrive.glb",
        "positioned right of lantern"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Hydrogen Slider",
      "type": "dom_element",
      "semantic": "adjusts hydrogen mole fraction",
      "locator_hints": [
        "input[type=range]",
        "hydrogen fraction control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 0"
    },
    {
      "id": "A4",
      "name": "Helium Slider",
      "type": "dom_element",
      "semantic": "adjusts helium mole fraction",
      "locator_hints": [
        "input[type=range]",
        "helium fraction control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 1"
    },
    {
      "id": "A5",
      "name": "Neon Slider",
      "type": "dom_element",
      "semantic": "adjusts neon mole fraction",
      "locator_hints": [
        "input[type=range]",
        "neon fraction control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 2"
    },
    {
      "id": "A6",
      "name": "Beam Energy Slider",
      "type": "dom_element",
      "semantic": "adjusts ion beam energy 1-10 eV",
      "locator_hints": [
        "input[type=range]",
        "beam energy control"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 3"
    },
    {
      "id": "A7",
      "name": "Beam Focus Toggle",
      "type": "dom_element",
      "semantic": "switches beam focus mode",
      "locator_hints": [
        "button or select",
        "narrow/medium/wide"
      ],
      "check": "!!(document.querySelector('select') || document.querySelectorAll('button').length > 1)"
    },
    {
      "id": "A8",
      "name": "Fire Ion Beam Button",
      "type": "dom_element",
      "semantic": "triggers ionization event",
      "locator_hints": [
        "button",
        "fire beam action"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A9",
      "name": "Particle Stream",
      "type": "interaction",
      "semantic": "animated spheres from drive to chamber",
      "locator_hints": [
        "visible particles",
        "beam animation"
      ],
      "check": "true"
    },
    {
      "id": "A10",
      "name": "Chamber Light",
      "type": "3d_object",
      "semantic": "point light inside lantern changing color by plasma state",
      "locator_hints": [
        "PointLight",
        "color varies with ionization stage"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene loads with default gas mixture, beam off, stage 0",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.ionizationStage === 0 && window.__3D_STATE__.ionizationEvents === 0)"
    },
    {
      "id": "S1",
      "name": "mixture_adjusted",
      "description": "User adjusts gas fractions ensuring sum=1.0, beam energy set",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.hydrogenFraction === 'number' && typeof window.__3D_STATE__.heliumFraction === 'number' && typeof window.__3D_STATE__.neonFraction === 'number' && window.__3D_STATE__.beamEnergy >= 1 && window.__3D_STATE__.beamEnergy <= 10 && window.__3D_STATE__.ionizationEvents === 0"
    },
    {
      "id": "S2",
      "name": "first_ionization",
      "description": "First beam fired, ionization stage increments, charge accumulates",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ionizationStage > 0 && window.__3D_STATE__.ionizationEvents > 0 && window.__3D_STATE__.ionizationStage < 3"
    },
    {
      "id": "S3",
      "name": "mid_stage_ionization",
      "description": "Multiple firings, stage 3-4, significant charge buildup",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ionizationStage >= 3 && window.__3D_STATE__.ionizationStage <= 4 && window.__3D_STATE__.ionizationEvents >= 4"
    },
    {
      "id": "S4",
      "name": "high_energy_ionization",
      "description": "Beam energy >7eV, stage 5-6, high charge state",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.beamEnergy > 7 && window.__3D_STATE__.ionizationStage >= 5 && window.__3D_STATE__.totalCharge > 50"
    },
    {
      "id": "S5",
      "name": "focus_mode_test",
      "description": "Beam focus toggled, different ionization efficiency observed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.beamFocus !== undefined && window.__3D_STATE__.beamFocus !== null && window.__3D_STATE__.ionizationEvents > 5"
    },
    {
      "id": "S6",
      "name": "stability_run",
      "description": "60-second continuous operation validating state consistency",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T0_S0_S1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=range]').dispatchEvent(new Event('input', {bubbles:true}));",
        "wait_ms": 1200
      },
      "postconditions": [
        "Gas mixture sliders functional",
        "Fractions sum to 1.0",
        "Beam energy adjustable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.hydrogenFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.heliumFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.neonFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamEnergy >= 1 && window.__3D_STATE__.beamEnergy <= 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.hydrogenFraction + window.__3D_STATE__.heliumFraction + window.__3D_STATE__.neonFraction) - 1.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1_S1_S2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Ion beam fired",
        "Ionization stage incremented",
        "Charge accumulated",
        "Particle stream visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ionizationStage > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalCharge > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ionizationEvents > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.ionizationStage)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalCharge)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2_S2_S3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0;i<3;i++){document.querySelector('button').click();await new Promise(r=>setTimeout(r,800));}",
        "wait_ms": 3500
      },
      "postconditions": [
        "Multiple ionization events",
        "Stage 3-4 reached",
        "Charge significantly increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ionizationStage >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionizationEvents >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCharge > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionizationStage <= 6",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.ionizationEvents)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.ionizationStage)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3_S3_S4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider=document.querySelectorAll('input[type=range]')[3];slider.value=8;slider.dispatchEvent(new Event('input',{bubbles:true}));await new Promise(r=>setTimeout(r,500));document.querySelector('button').click();",
        "wait_ms": 2500
      },
      "postconditions": [
        "Beam energy >7eV",
        "High ionization stage 5-6",
        "High charge state achieved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beamEnergy > 7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionizationStage >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCharge > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionizationStage <= 6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.beamEnergy - 8) < 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4_S4_S5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const toggle=document.querySelectorAll('button')[1]||document.querySelector('select');if(toggle.tagName==='SELECT'){toggle.selectedIndex=1;toggle.dispatchEvent(new Event('change',{bubbles:true}));}else{toggle.click();}await new Promise(r=>setTimeout(r,500));document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Beam focus mode changed",
        "Focus affects ionization efficiency",
        "State remains consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beamFocus !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beamFocus !== null",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.beamFocus === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ionizationEvents > 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalCharge)",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.ionizationStage)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5_S5_S6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second stability validated",
        "No state corruption",
        "All fields remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.hydrogenFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.heliumFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.neonFraction === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ionizationStage >= 0 && window.__3D_STATE__.ionizationStage <= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCharge >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamEnergy)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.hydrogenFraction + window.__3D_STATE__.heliumFraction + window.__3D_STATE__.neonFraction) - 1.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
