  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with models, post-processing disabled or at zero values",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.bloomStrength === 0 && window.__3D_STATE__.postProcessEnabled === false)"
    },
    {
      "id": "S1",
      "name": "Bloom Activated",
      "description": "Bloom strength and threshold adjusted to create glow effect",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bloomStrength > 1.5 && window.__3D_STATE__.bloomThreshold >= 0.5"
    },
    {
      "id": "S2",
      "name": "Depth-of-Field Applied",
      "description": "DoF focus distance and aperture configured for selective blur",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dofFocusDistance > 4.0 && window.__3D_STATE__.dofAperture > 0.005"
    },
    {
      "id": "S3",
      "name": "Chromatic Aberration Added",
      "description": "Chromatic aberration offset increased for color fringing effect",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.chromaticAberrationOffset > 0.002"
    },
    {
      "id": "S4",
      "name": "Vignette and Color Grading",
      "description": "Vignette darkness and color grading parameters adjusted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.vignetteDarkness > 1.0 && window.__3D_STATE__.colorGradingGamma >= 1.0"
    },
    {
      "id": "S5",
      "name": "Full Compositor Active",
      "description": "All post-processing effects layered and active simultaneously",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.postProcessEnabled === true && window.__3D_STATE__.totalPassCount >= 6"
    },
    {
      "id": "S6",
      "name": "Stable Multi-Pass Render",
      "description": "Compositor running stably with all effects for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.bloomStrength = 1.8; window.__3D_STATE__.bloomThreshold = 0.6;",
        "wait_ms": 1500
      },
      "postconditions": [
        "Bloom strength is set to 1.8",
        "Bloom threshold is set to 0.6",
        "Bloom effect is visible on bright areas"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bloomStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bloomStrength > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomStrength - 1.8) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bloomThreshold >= 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.dofFocusDistance = 5.5; window.__3D_STATE__.dofAperture = 0.007;",
        "wait_ms": 1500
      },
      "postconditions": [
        "DoF focus distance is set to 5.5",
        "DoF aperture is set to 0.007",
        "Depth-of-field blur is applied to out-of-focus areas"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dofFocusDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dofFocusDistance > 4.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dofFocusDistance - 5.5) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dofAperture > 0.005",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.chromaticAberrationOffset = 0.004;",
        "wait_ms": 1500
      },
      "postconditions": [
        "Chromatic aberration offset is set to 0.004",
        "Color fringing effect is visible at edges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chromaticAberrationOffset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticAberrationOffset > 0.002",
            "tier": "L2"
