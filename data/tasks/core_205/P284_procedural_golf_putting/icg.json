  "affordances": [
    {
      "id": "A1",
      "name": "GolfBall",
      "type": "3d_object",
      "semantic": "White sphere golf ball at starting position",
      "locator_hints": [
        "white sphere",
        "radius 0.1",
        "position z=5"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ballPosition)"
    },
