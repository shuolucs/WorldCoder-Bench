  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.ballPosition.z === 5",
        "window.__3D_STATE__.power === 0",
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.ballMoving === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.strokeCount === 0 && window.__3D_STATE__.ballMoving === false"
    },
    {
      "id": "S1",
      "name": "AimAdjusted",
      "conditions": [
        "window.__3D_STATE__.aimAngle !== 0",
        "window.__3D_STATE__.ballMoving === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.aimAngle !== 0 && window.__3D_STATE__.ballMoving === false"
    },
    {
      "id": "S2",
      "name": "PowerSet",
      "conditions": [
        "window.__3D_STATE__.power > 0",
        "window.__3D_STATE__.ballMoving === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.power > 0 && window.__3D_STATE__.ballMoving === false"
    },
    {
      "id": "S3",
      "name": "BallMoving",
      "conditions": [
        "window.__3D_STATE__.ballMoving === true",
        "window.__3D_STATE__.strokeCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballMoving === true && window.__3D_STATE__.strokeCount >= 1"
    },
    {
      "id": "S4",
      "name": "BallStopped",
      "conditions": [
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.strokeCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballMoving === false && window.__3D_STATE__.strokeCount >= 1"
    },
    {
      "id": "S5",
      "name": "HoleSunk",
      "conditions": [
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.holeSunk === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.score >= 1 && window.__3D_STATE__.holeSunk === true"
    },
    {
      "id": "S6",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.holesPlayed >= 3"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameOver === true && window.__3D_STATE__.holesPlayed >= 3"
    },
    {
      "id": "S7",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.holesPlayed === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.strokeCount === 0 && window.__3D_STATE__.score === 0"
    }
  ],
