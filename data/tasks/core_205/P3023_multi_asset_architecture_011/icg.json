{
  "task_id": "P3023",
  "affordances": [
    {
      "id": "A1",
      "name": "Add Bedroom Button",
      "type": "dom_element",
      "semantic": "Toolbar button to enter bedroom placement mode",
      "locator_hints": [
        "button",
        "text contains 'Bedroom'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Bedroom'))"
    },
    {
      "id": "A2",
      "name": "Add Courtyard Button",
      "type": "dom_element",
      "semantic": "Toolbar button to enter courtyard placement mode",
      "locator_hints": [
        "button",
        "text contains 'Courtyard'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Courtyard'))"
    },
    {
      "id": "A3",
      "name": "Undo Button",
      "type": "dom_element",
      "semantic": "Reverts the last placement or upgrade action",
      "locator_hints": [
        "button",
        "text contains 'Undo'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Undo'))"
    },
    {
      "id": "A4",
      "name": "Redo Button",
      "type": "dom_element",
      "semantic": "Re-applies an undone action",
      "locator_hints": [
        "button",
        "text contains 'Redo'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Redo'))"
    },
    {
      "id": "A5",
      "name": "Budget Display",
      "type": "dom_element",
      "semantic": "Shows remaining budget points",
      "locator_hints": [
        "div",
        "text contains 'Budget' or number"
      ],
      "check": "Array.from(document.querySelectorAll('div')).some(d => d.textContent.includes('Budget') || /\\d+/.test(d.textContent))"
    },
    {
      "id": "A6",
      "name": "Bedroom Module",
      "type": "3d_object",
      "semantic": "Cloned bedroom instance placed on rooftops",
      "locator_hints": [
        "mesh from minimalistic_modern_bedroom.glb"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.bedroomCount > 0)"
    },
    {
      "id": "A7",
      "name": "Chess Courtyard",
      "type": "3d_object",
      "semantic": "Chess set decoration placed at ground level",
      "locator_hints": [
        "mesh from ABeautifulGame.glb"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.courtyardCount > 0)"
    },
    {
      "id": "A8",
      "name": "Canvas Interaction",
      "type": "interaction",
      "semantic": "Left-click to place, right-click-drag to rotate bedrooms, left-click bedrooms to upgrade tier",
      "locator_hints": [
        "canvas element"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with city, budget at 100, no objects placed",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.bedroomCount === 0 && window.__3D_STATE__.courtyardCount === 0 && window.__3D_STATE__.budgetRemaining === 100)"
    },
    {
      "id": "S1",
      "name": "First Bedroom Placed",
      "description": "One bedroom module placed on a rooftop, budget reduced by 12",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bedroomCount === 1 && window.__3D_STATE__.courtyardCount === 0 && window.__3D_STATE__.budgetRemaining === 88"
    },
    {
      "id": "S2",
      "name": "Mixed Placements",
      "description": "Multiple bedrooms and at least one courtyard placed, budget partially consumed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bedroomCount >= 1 && window.__3D_STATE__.courtyardCount >= 1 && window.__3D_STATE__.budgetRemaining < 100"
    },
    {
      "id": "S3",
      "name": "Bedroom Upgraded",
      "description": "At least one bedroom upgraded to higher finish tier, budget further reduced",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.averageBedroomTier > 0 && window.__3D_STATE__.bedroomCount >= 1"
    },
    {
      "id": "S4",
      "name": "Undo Performed",
      "description": "User undid an action, undo stack decreased, redo stack increased, budget adjusted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redoStackSize >= 1"
    },
    {
      "id": "S5",
      "name": "Budget Near Limit",
      "description": "Budget remaining is less than 15 points, limiting further placements",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.budgetRemaining < 15 && window.__3D_STATE__.budgetRemaining >= 0"
    },
    {
      "id": "S6",
      "name": "Stable Configuration",
      "description": "Scene stable with multiple objects, no actions for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', { clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true })); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "One bedroom module placed on scene",
        "Budget reduced by 12 points to 88",
        "Bedroom count increased to 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bedroomCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bedroomCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining === 88",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpent === 12",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const courtyardBtn = buttons.find(b => b.textContent.includes('Courtyard')); if(courtyardBtn) courtyardBtn.click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', { clientX: rect.left + rect.width/3, clientY: rect.top + rect.height/2, bubbles: true })); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "One courtyard chess set placed at ground level",
        "Budget reduced by additional 8 points to 80",
        "Courtyard count increased to 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.courtyardCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.courtyardCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpent === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', { clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true }));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Bedroom finish tier upgraded by one level",
        "Budget reduced by 5 points for upgrade",
        "Average bedroom tier increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.averageBedroomTier === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.averageBedroomTier > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining === 75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpent === 25",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const undoBtn = buttons.find(b => b.textContent.includes('Undo')); if(undoBtn) undoBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Last action undone",
        "Undo stack size decreased by 1",
        "Redo stack size increased by 1",
        "Budget adjusted back"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.undoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.redoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining === 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const bedroomBtn = buttons.find(b => b.textContent.includes('Bedroom')); for(let i=0; i<5; i++) { if(bedroomBtn) bedroomBtn.click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', { clientX: rect.left + rect.width/2 + Math.random()*100, clientY: rect.top + rect.height/2 + Math.random()*100, bubbles: true })); }, 300 + i*400); }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Multiple additional bedrooms placed",
        "Budget reduced to less than 15 points remaining",
        "Bedroom count increased significantly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.budgetRemaining === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining < 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bedroomCount >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Scene remains stable with current configuration",
        "All state values remain valid and consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bedroomCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.courtyardCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalSpent >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalSpent <= 100",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.bedroomCount)",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.courtyardCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene stable for 60 seconds",
        "All objects remain in valid positions",
        "Budget conservation maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.budgetRemaining === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.budgetRemaining >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.budgetRemaining + window.__3D_STATE__.totalSpent - 100) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.highestBedroomY)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
