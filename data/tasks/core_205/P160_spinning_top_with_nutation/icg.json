{
  "task_id": "P160_spinning_top_with_nutation",
  "affordances": [
    {
      "id": "A1",
      "name": "SpinningTop",
      "type": "3d_object",
      "semantic": "The spinning top rigid body group with cone, disc, handle, and tip",
      "locator_hints": [
        "scene.children with cone geometry",
        "Group containing top components"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.topPosition)"
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Flat ground surface where the top spins",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Ground)"
    },
    {
      "id": "A3",
      "name": "LaunchButton",
      "type": "dom_element",
      "semantic": "Button to launch or reset the spinning top",
      "locator_hints": [
        "#launchBtn"
      ],
      "check": "!!document.getElementById('launchBtn')"
    },
    {
      "id": "A4",
      "name": "FrictionButton",
      "type": "dom_element",
      "semantic": "Button to toggle friction on/off",
      "locator_hints": [
        "#frictionBtn"
      ],
      "check": "!!document.getElementById('frictionBtn')"
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing physics values and status",
      "locator_hints": [
        "#hud"
      ],
      "check": "!!document.getElementById('hud')"
    },
    {
      "id": "A6",
      "name": "BoostKey",
      "type": "dom_element",
      "semantic": "Keyboard B key to boost spin rate",
      "locator_hints": [
        "KeyB"
      ],
      "check": "true"
    },
    {
      "id": "A7",
      "name": "TiltKey",
      "type": "dom_element",
      "semantic": "Keyboard T key to increase tilt",
      "locator_hints": [
        "KeyT"
      ],
      "check": "true"
    },
    {
      "id": "A8",
      "name": "PauseKey",
      "type": "dom_element",
      "semantic": "Space key to pause/resume simulation",
      "locator_hints": [
        "Space"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Idle",
      "conditions": [
        "window.__3D_STATE__.status === 'idle'",
        "window.__3D_STATE__.spinRate === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'idle' && window.__3D_STATE__.spinRate === 0"
    },
    {
      "id": "S1",
      "name": "Spinning",
      "conditions": [
        "window.__3D_STATE__.status === 'spinning'",
        "window.__3D_STATE__.spinRate > 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'spinning' && window.__3D_STATE__.spinRate > 2"
    },
    {
      "id": "S2",
      "name": "SpinningBoosted",
      "conditions": [
        "window.__3D_STATE__.status === 'spinning'",
        "window.__3D_STATE__.spinBoostCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'spinning' && window.__3D_STATE__.spinBoostCount >= 1"
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.status === 'paused'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'paused'"
    },
    {
      "id": "S4",
      "name": "SpinningNoFriction",
      "conditions": [
        "window.__3D_STATE__.status === 'spinning'",
        "window.__3D_STATE__.frictionEnabled === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'spinning' && window.__3D_STATE__.frictionEnabled === false"
    },
    {
      "id": "S5",
      "name": "SpinningTilted",
      "conditions": [
        "window.__3D_STATE__.status === 'spinning'",
        "window.__3D_STATE__.tiltAngle > 0.35"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'spinning' && window.__3D_STATE__.tiltAngle > 0.35"
    },
    {
      "id": "S6",
      "name": "Wobbling",
      "conditions": [
        "window.__3D_STATE__.status === 'spinning'",
        "window.__3D_STATE__.spinRate <= 5",
        "window.__3D_STATE__.spinRate > 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'spinning' && window.__3D_STATE__.spinRate <= 5 && window.__3D_STATE__.spinRate > 2"
    },
    {
      "id": "S7",
      "name": "Toppled",
      "conditions": [
        "window.__3D_STATE__.status === 'toppled'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.status === 'toppled'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#launchBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Mass !== before.Mass || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Mass === 'number' && !isNaN(window.__3D_STATE__.Mass)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Lights)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'spinning'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.spinRate - 15) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tiltAngle - 0.3) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionRate > 0",
            "tier": "L1"
          }
        ]
      }
    },
