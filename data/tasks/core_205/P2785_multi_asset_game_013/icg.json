{
  "task_id": "P2785",
  "affordances": [
    {
      "id": "A1",
      "name": "ReadyPlayerMe Avatar",
      "type": "3d_object",
      "semantic": "Player-controlled character model loaded from readyplayer.me.glb",
      "locator_hints": [
        "GLB model",
        "avatar mesh",
        "player character"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Godrays Temple Environment",
      "type": "3d_object",
      "semantic": "Ancient temple scene with volumetric lighting from godrays_demo.glb",
      "locator_hints": [
        "temple scene",
        "environment model",
        "godrays"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Light Pillars",
      "type": "3d_object",
      "semantic": "Five cylindrical pillars with unique emissive colors arranged in semicircle",
      "locator_hints": [
        "cylinder geometry",
        "glowing pillars",
        "colored emissive"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.patternLength === 5)"
    },
    {
      "id": "A4",
      "name": "WASD Movement Controls",
      "type": "interaction",
      "semantic": "Keyboard input for avatar movement in four directions",
      "locator_hints": [
        "keydown events",
        "WASD keys",
        "movement input"
      ],
      "check": "true"
    },
    {
      "id": "A5",
      "name": "UI Overlay",
      "type": "dom_element",
      "semantic": "Text display showing game instructions and current phase",
      "locator_hints": [
        "div overlay",
        "instruction text",
        "game status"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A6",
      "name": "Third-Person Camera",
      "type": "3d_object",
      "semantic": "Camera following avatar from behind with OrbitControls",
      "locator_hints": [
        "perspective camera",
        "orbit controls",
        "camera offset"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with avatar and temple, pillars visible, waiting to start pattern display",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.isShowingPattern === false && window.__3D_STATE__.isPlayerTurn === false)"
    },
    {
      "id": "S1",
      "name": "Pattern Display",
      "description": "Game showing the 5-pillar sequence with timed activations and glowing effects",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isShowingPattern === true && window.__3D_STATE__.gamePhase === 'showing'"
    },
    {
      "id": "S2",
      "name": "Player Input Phase",
      "description": "Waiting for player to walk to pillars and repeat the memorized sequence",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlayerTurn === true && window.__3D_STATE__.gamePhase === 'input' && window.__3D_STATE__.playerInputCount === 0"
    },
    {
      "id": "S3",
      "name": "Partial Progress",
      "description": "Player has correctly activated some pillars but sequence not yet complete",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlayerTurn === true && window.__3D_STATE__.playerInputCount > 0 && window.__3D_STATE__.correctMatches > 0 && window.__3D_STATE__.correctMatches < 5"
    },
    {
      "id": "S4",
      "name": "Sequence Complete",
      "description": "Player successfully activated all 5 pillars in correct order, portal unlocked",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.correctMatches === 5 && window.__3D_STATE__.portalUnlocked === true && window.__3D_STATE__.gamePhase === 'success'"
    },
    {
      "id": "S5",
      "name": "Failed Attempt",
      "description": "Player activated wrong pillar, sequence resets for another attempt",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gamePhase === 'failure' && window.__3D_STATE__.totalAttempts >= 1"
    },
    {
      "id": "S6",
      "name": "Victory State",
      "description": "Portal unlocked and game completed successfully",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.portalUnlocked === true && window.__3D_STATE__.correctMatches === 5 && window.__3D_STATE__.gamePhase === 'success'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Pattern display begins automatically after initial load",
        "isShowingPattern becomes true",
        "gamePhase changes to 'showing'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isShowingPattern === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gamePhase === 'showing'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sequenceStep >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Pattern display completes all 5 activations",
        "isPlayerTurn becomes true",
        "gamePhase changes to 'input'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isShowingPattern === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlayerTurn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gamePhase === 'input'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerInputCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const keys = {}; keys['KeyW'] = true; window.dispatchEvent(new KeyboardEvent('keydown', {code: 'KeyW'})); setTimeout(() => { keys['KeyW'] = false; window.dispatchEvent(new KeyboardEvent('keyup', {code: 'KeyW'})); }, 2000);",
        "wait_ms": 3000
      },
      "postconditions": [
        "Avatar moves forward toward pillars",
        "Player activates first pillar correctly",
        "correctMatches increments to 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avatarPositionZ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.playerInputCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.correctMatches >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Player completes all 5 pillar activations correctly",
        "portalUnlocked becomes true",
        "gamePhase changes to 'success'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.correctMatches === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.portalUnlocked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gamePhase === 'success'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.correctMatches = 2; window.__3D_STATE__.playerInputCount = 3;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Player activates wrong pillar",
        "gamePhase changes to 'failure'",
        "totalAttempts increments"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gamePhase === 'failure'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAttempts >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalAttempts)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Pattern display restarts after failure",
        "playerInputCount resets to 0",
        "isShowingPattern becomes true again"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isShowingPattern === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerInputCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.correctMatches === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Victory state confirmed",
        "Portal remains unlocked",
        "Game completed successfully"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.portalUnlocked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.correctMatches === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternLength === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable in victory state for 60 seconds",
        "All state values remain consistent",
        "No unexpected changes occur"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.portalUnlocked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.correctMatches === 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.avatarPositionX)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.avatarPositionZ)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
