{
  "task_id": "P2772",
  "affordances": [
    {
      "id": "A1",
      "name": "Release Angle Slider",
      "type": "dom_element",
      "semantic": "Slider control to set pendulum release angle between 15-85 degrees",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Release Angle'",
        "slider with min 15 max 85"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Platform Distance Slider",
      "type": "dom_element",
      "semantic": "Slider control to set horizontal distance of Corset platform from 1-4 units",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Platform Distance'",
        "slider with min 1 max 4"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Friction Slider",
      "type": "dom_element",
      "semantic": "Slider control to set surface friction coefficient from 0.0 to 1.0",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Friction'",
        "slider with min 0 max 1"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Release Button",
      "type": "dom_element",
      "semantic": "Button to release the pendulum and start the swing animation",
      "locator_hints": [
        "button",
        "text containing 'Release'",
        "clickable element to start pendulum"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A5",
      "name": "ShaderBall Pendulum",
      "type": "3d_object",
      "semantic": "ShaderBall model attached to pendulum chain that swings and collides",
      "locator_hints": [
        "GLTF model ShaderBall.glb",
        "object at end of pendulum chain",
        "swinging sphere"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "Corset on Platform",
      "type": "3d_object",
      "semantic": "Corset model sitting on sliding platform that moves after collision",
      "locator_hints": [
        "GLTF model Corset.glb",
        "object on rectangular platform",
        "collision target"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Scene loaded with pendulum at rest, Corset on platform, all sliders at default values, no collision yet",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__ && !window.__3D_STATE__.isPendulumReleased && !window.__3D_STATE__.hasCollisionOccurred)"
    },
    {
      "id": "S1",
      "name": "Parameters Configured",
      "description": "User has adjusted release angle, platform distance, and friction settings before releasing pendulum",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.releaseAngleSetting === 'number' && !window.__3D_STATE__.isPendulumReleased"
    },
    {
      "id": "S2",
      "name": "Pendulum Released",
      "description": "Pendulum is actively swinging with angular velocity, approaching the Corset target",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPendulumReleased === true && !window.__3D_STATE__.hasCollisionOccurred && Math.abs(window.__3D_STATE__.pendulumAngularVelocity) > 0"
    },
    {
      "id": "S3",
      "name": "Collision Occurred",
      "description": "ShaderBall has collided with Corset, momentum transfer initiated, Corset begins sliding",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hasCollisionOccurred === true && window.__3D_STATE__.totalCollisions >= 1"
    },
    {
      "id": "S4",
      "name": "Corset Sliding",
      "description": "Corset is moving horizontally with velocity, friction is decelerating it toward final position",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hasCollisionOccurred === true && Math.abs(window.__3D_STATE__.corsetVelocityX) > 0.1"
    },
    {
      "id": "S5",
      "name": "System at Rest",
      "description": "Corset has stopped sliding at final position, pendulum has settled, system stable for observation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hasCollisionOccurred === true && Math.abs(window.__3D_STATE__.corsetVelocityX) < 0.1 && typeof window.__3D_STATE__.corsetFinalPositionX === 'number'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 65; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[1].value = 2.5; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[2].value = 0.3; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Release angle slider set to 65 degrees",
        "Platform distance slider set to 2.5 units",
        "Friction slider set to 0.3",
        "State variables updated to reflect slider values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.releaseAngleSetting === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.releaseAngleSetting >= 60 && window.__3D_STATE__.releaseAngleSetting <= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.platformDistance >= 2.0 && window.__3D_STATE__.platformDistance <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frictionCoefficient >= 0.25 && window.__3D_STATE__.frictionCoefficient <= 0.35",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Release button clicked",
        "Pendulum released flag set to true",
        "Pendulum begins swinging with non-zero angular velocity",
        "Pendulum angle starts changing from release angle toward vertical"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPendulumReleased === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngularVelocity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumAngularVelocity) > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasCollisionOccurred === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "ShaderBall has swung down and made contact with Corset",
        "Collision detected and flag set to true",
        "Collision counter incremented",
        "Corset begins to have non-zero velocity from momentum transfer"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hasCollisionOccurred === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalCollisions === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalCollisions >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalCollisions)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "Corset is actively sliding with measurable velocity",
        "Corset X position is changing over time",
        "Friction is being applied to decelerate the Corset",
        "Corset has moved from its initial platform position"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.corsetVelocityX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.corsetVelocityX) > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.corsetPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.corsetPositionX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Corset velocity has decreased to near zero due to friction",
        "Corset has reached final resting position",
        "Final position X coordinate is recorded",
        "Pendulum has also settled to rest or minimal oscillation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.corsetVelocityX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.corsetVelocityX) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.corsetFinalPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.corsetFinalPositionX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 45; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[2].value = 0.7; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "Release angle adjusted to 45 degrees",
        "Friction coefficient adjusted to 0.7",
        "State variables reflect new slider values",
        "System remains in configuration state without release"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.releaseAngleSetting >= 40 && window.__3D_STATE__.releaseAngleSetting <= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frictionCoefficient >= 0.65 && window.__3D_STATE__.frictionCoefficient <= 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPendulumReleased === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "Pendulum continues swinging motion",
        "Angular velocity remains non-zero",
        "Pendulum angle is updating each frame",
        "No collision has occurred yet during swing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPendulumReleased === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.pendulumAngle)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumAngularVelocity) > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Corset position unchanged at final resting location",
        "Pendulum at rest or minimal oscillation",
        "All physics values remain valid and finite",
        "No unexpected state changes occur during stability period"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.corsetFinalPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.corsetFinalPositionX)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.corsetVelocityX) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasCollisionOccurred === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
