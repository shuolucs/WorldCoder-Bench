{
  "task_id": "P3131",
  "affordances": [
    {
      "id": "A1",
      "name": "Amber Specimen",
      "type": "3d_object",
      "semantic": "MosquitoInAmber.glb model on lab bench, clickable to begin dissolution",
      "locator_hints": [
        "amber",
        "mosquito",
        "specimen",
        "left side"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "HCl Concentration Slider",
      "type": "dom_element",
      "semantic": "HTML range input controlling reagent concentration 0-100ml",
      "locator_hints": [
        "slider",
        "hcl",
        "reagent",
        "concentration"
      ],
      "check": "!!document.querySelector('input[type=range]')"
    },
    {
      "id": "A3",
      "name": "Draggable Beaker",
      "type": "3d_object",
      "semantic": "Beaker mesh that can be dragged to pour solvent onto amber",
      "locator_hints": [
        "beaker",
        "draggable",
        "solvent",
        "pour"
      ],
      "check": "!!(window.scene && window.scene.getObjectByName('beaker'))"
    },
    {
      "id": "A4",
      "name": "Cuvette",
      "type": "3d_object",
      "semantic": "Small transparent container for DNA sample, positionable in laser path",
      "locator_hints": [
        "cuvette",
        "dna",
        "sample",
        "container"
      ],
      "check": "!!(window.scene && window.scene.getObjectByName('cuvette'))"
    },
    {
      "id": "A5",
      "name": "Laser Toggle Button",
      "type": "dom_element",
      "semantic": "Button to activate/deactivate laser beam",
      "locator_hints": [
        "laser",
        "toggle",
        "button",
        "on/off"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A6",
      "name": "Broken Glass Mount",
      "type": "3d_object",
      "semantic": "GlassBrokenWindow.glb on rotating mount, draggable to rotate Y-axis",
      "locator_hints": [
        "glass",
        "broken",
        "window",
        "mount",
        "diffraction",
        "right side"
      ],
      "check": "!!(window.scene && window.scene.getObjectByName('glassMount'))"
    },
    {
      "id": "A7",
      "name": "Spectral Screen",
      "type": "3d_object",
      "semantic": "Virtual projection screen behind glass showing diffraction bands",
      "locator_hints": [
        "screen",
        "spectral",
        "bands",
        "projection"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.diffractionBands !== undefined)"
    },
    {
      "id": "A8",
      "name": "Laser Emitter",
      "type": "3d_object",
      "semantic": "Point light source representing laser beam origin",
      "locator_hints": [
        "laser",
        "emitter",
        "source",
        "beam"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.laserActive !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Lab scene loaded with amber specimen and broken glass in place, no interactions yet",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.hclConcentration === undefined && window.__3D_STATE__.reagentVolumePoured === undefined)"
    },
    {
      "id": "S1",
      "name": "Reagent Prepared",
      "description": "HCl concentration set and solvent poured onto amber, dissolution in progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hclConcentration >= 70 && window.__3D_STATE__.reagentVolumePoured > 0 && window.__3D_STATE__.amberOpacity < 100 && !window.__3D_STATE__.dnaExtracted"
    },
    {
      "id": "S2",
      "name": "DNA Extracted",
      "description": "Amber dissolved sufficiently, DNA sample extracted into cuvette",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dnaExtracted === true && window.__3D_STATE__.amberOpacity < 20 && !window.__3D_STATE__.cuvettePositioned"
    },
    {
      "id": "S3",
      "name": "Laser Activated",
      "description": "Cuvette positioned in laser path and laser beam turned on",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cuvettePositioned === true && window.__3D_STATE__.laserActive === true && window.__3D_STATE__.laserIntensity > 0 && (window.__3D_STATE__.diffractionBands === undefined || window.__3D_STATE__.diffractionBands < 3)"
    },
    {
      "id": "S4",
      "name": "Diffraction Observed",
      "description": "Glass mount rotated to optimal angle, spectral bands visible on screen",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.glassRotationAngle > 0 && window.__3D_STATE__.diffractionBands >= 3 && !window.__3D_STATE__.wavelengthCalibrated"
    },
    {
      "id": "S5",
      "name": "Analysis Complete",
      "description": "Wavelength calibrated and spectral analysis finished successfully",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.wavelengthCalibrated === true && window.__3D_STATE__.analysisComplete === true && window.__3D_STATE__.spectralPeakWavelength >= 400 && window.__3D_STATE__.spectralPeakWavelength <= 700"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running stably with all parameters within expected ranges",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.analysisComplete === true && window.__3D_STATE__.diffractionBands >= 0 && isFinite(window.__3D_STATE__.spectralPeakWavelength)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 75; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles:true})); setTimeout(() => { const beaker = window.scene.getObjectByName('beaker'); if(beaker) beaker.position.y += 2; }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "HCl concentration set to 75ml",
        "Solvent poured onto amber specimen",
        "Amber opacity begins decreasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.hclConcentration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hclConcentration >= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reagentVolumePoured > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.amberOpacity < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const amber = window.scene.getObjectByName('amber'); if(amber) { const evt = new MouseEvent('click', {bubbles:true, clientX:window.innerWidth*0.3, clientY:window.innerHeight*0.5}); window.canvas.dispatchEvent(evt); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Amber opacity reduced below 20%",
        "DNA sample extracted from mosquito",
        "Cuvette contains DNA sample"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dnaExtracted === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dnaExtracted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amberOpacity < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const cuvette = window.scene.getObjectByName('cuvette'); if(cuvette) { cuvette.position.set(0, 1.5, 0); } setTimeout(() => { const laserBtn = document.querySelector('button'); if(laserBtn) laserBtn.click(); }, 800);",
        "wait_ms": 1800
      },
      "postconditions": [
        "Cuvette positioned in laser path between emitter and glass",
        "Laser beam activated and visible",
        "Laser intensity above zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cuvettePositioned === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cuvettePositioned === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.laserActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.laserIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const glass = window.scene.getObjectByName('glassMount'); if(glass) { glass.rotation.y = Math.PI * 0.35; }",
        "wait_ms": 1200
      },
      "postconditions": [
        "Broken glass mount rotated to diffraction angle",
        "Spectral bands appear on projection screen",
        "Multiple wavelengths separated and visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.glassRotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.glassRotationAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.diffractionBands >= 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.glassRotationAngle - 63) < 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const calibrateBtn = document.querySelectorAll('button')[1]; if(calibrateBtn) calibrateBtn.click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Wavelength calibration completed",
        "Spectral peak wavelength measured",
        "Analysis marked as complete"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wavelengthCalibrated === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthCalibrated === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spectralPeakWavelength >= 400 && window.__3D_STATE__.spectralPeakWavelength <= 700",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.analysisComplete === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "All state values stable and within valid ranges",
        "No unexpected changes in scene state",
        "System ready for extended operation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.analysisComplete !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.diffractionBands >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.spectralPeakWavelength)",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.diffractionBands)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stable state for 60 seconds",
        "All measurements remain consistent",
        "No degradation in scene state"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.amberOpacity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.amberOpacity >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.laserIntensity >= 0 && window.__3D_STATE__.laserIntensity <= 100",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glassRotationAngle)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
