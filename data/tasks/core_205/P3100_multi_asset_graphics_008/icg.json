{
  "task_id": "P3100",
  "affordances": [
    {
      "id": "A1",
      "name": "Spawn Duck Button",
      "type": "dom_element",
      "semantic": "Button that spawns a new duck at the next parade position",
      "locator_hints": [
        "button",
        "text contains 'Spawn Duck'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Spawn'))"
    },
    {
      "id": "A2",
      "name": "Duck Model",
      "type": "3d_object",
      "semantic": "Clickable rubber duck mesh in the scene",
      "locator_hints": [
        "mesh from Duck.glb",
        "clickable via raycasting"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount > 0)"
    },
    {
      "id": "A3",
      "name": "Attach Mask Button",
      "type": "dom_element",
      "semantic": "Button that attaches a venice mask to selected duck",
      "locator_hints": [
        "button",
        "text contains 'Attach Mask'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Mask'))"
    },
    {
      "id": "A4",
      "name": "Color Picker",
      "type": "dom_element",
      "semantic": "Input element for selecting mask tint color",
      "locator_hints": [
        "input[type='color']",
        "color picker"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A5",
      "name": "Canal Surface",
      "type": "3d_object",
      "semantic": "Reflective plane representing the canal water",
      "locator_hints": [
        "plane mesh",
        "MeshStandardMaterial with high metalness"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.canalReflectivity !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Empty Scene",
      "description": "Scene loaded with canal, lights, and no ducks spawned yet",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount === 0)"
    },
    {
      "id": "S1",
      "name": "First Duck Spawned",
      "description": "One duck has been placed in the parade formation",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount === 1)"
    },
    {
      "id": "S2",
      "name": "Duck Selected",
      "description": "A duck has been clicked and is now selected with highlight",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.selectedDuckIndex >= 0)"
    },
    {
      "id": "S3",
      "name": "Mask Attached",
      "description": "Selected duck now has a venice mask parented to it",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.maskedDuckCount === 1)"
    },
    {
      "id": "S4",
      "name": "Multiple Ducks with Masks",
      "description": "Several ducks spawned and multiple masks attached",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount >= 4 && window.__3D_STATE__.duckCount < 8)"
    },
    {
      "id": "S5",
      "name": "Max Capacity Parade",
      "description": "Eight ducks spawned, parade at maximum capacity",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount === 8 && window.__3D_STATE__.maxDucksReached === true)"
    },
    {
      "id": "S6",
      "name": "Stable Parade Formation",
      "description": "All ducks and masks stable in final configuration",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.duckCount === 8 && window.__3D_STATE__.lastMaskColor !== undefined)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "First duck spawned and visible in scene",
        "duckCount incremented to 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.duckCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duckCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true}); canvas.dispatchEvent(evt);",
        "wait_ms": 1000
      },
      "postconditions": [
        "Duck selected via raycasting",
        "selectedDuckIndex set to valid index"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedDuckIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedDuckIndex >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const maskBtn = buttons.find(b => b.textContent.includes('Mask')); if(maskBtn) maskBtn.click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Venice mask attached to selected duck",
        "maskedDuckCount incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.maskedDuckCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maskedDuckCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maskedDuckCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const spawnBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Spawn')); for(let i=0; i<3; i++) { if(spawnBtn) spawnBtn.click(); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Multiple ducks spawned",
        "duckCount increased to 4"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.duckCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duckCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.duckCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const spawnBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Spawn')); for(let i=0; i<4; i++) { if(spawnBtn) spawnBtn.click(); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Maximum 8 ducks spawned",
        "maxDucksReached flag set to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.duckCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duckCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDucksReached === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const colorPicker = document.querySelector('input[type=\"color\"]'); if(colorPicker) { colorPicker.value = '#ff00ff'; colorPicker.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color picker applied to mask",
        "lastMaskColor updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lastMaskColor === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastMaskColor !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastMaskColor.length > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.duckCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duckCount === 8",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.goldLightIntensity)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.canalReflectivity)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
