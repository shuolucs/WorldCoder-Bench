      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.energyTransferCount > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maskEnergyRed > 250 || window.__3D_STATE__.maskEnergyBlue > 250 || window.__3D_STATE__.maskEnergyGreen > 250 || window.__3D_STATE__.maskEnergyGold > 250",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const totemSliders = document.querySelectorAll('input[type=\"range\"]'); if(totemSliders.length > 3) { totemSliders[2].value = 180; totemSliders[2].dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { totemSliders[3].value = 270; totemSliders[3].dispatchEvent(new Event('input', {bubbles: true})); }, 500); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Second totem rotated to 180 degrees",
        "Third totem rotated to 270 degrees",
        "All three totems now at non-zero rotations",
        "Complex energy coupling patterns established"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totemRotation1 === 'number' && typeof window.__3D_STATE__.totemRotation2 === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totemRotation1 > 0 && window.__3D_STATE__.totemRotation2 > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totemRotation1 - 180) < 15 && Math.abs(window.__3D_STATE__.totemRotation2 - 270) < 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowsEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
