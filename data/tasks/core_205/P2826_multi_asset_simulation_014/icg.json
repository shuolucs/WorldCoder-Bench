          },
          {
            "expr": "window.__3D_STATE__.maskEnergyRed >= 0 && window.__3D_STATE__.maskEnergyBlue >= 0 && window.__3D_STATE__.maskEnergyGreen >= 0 && window.__3D_STATE__.maskEnergyGold >= 0",
