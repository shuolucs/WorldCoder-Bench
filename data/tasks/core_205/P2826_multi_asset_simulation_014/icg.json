            "expr": "Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01",
