      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length >= 3"
    },
    {
      "id": "A7",
      "name": "Shadow Totems",
      "type": "3d_object",
      "semantic": "Three ShadowmappableMesh instances on rooftops with directional lights",
      "locator_hints": [
        "ShadowmappableMesh.glb",
        "rooftop positions",
        "castShadow enabled"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && typeof window.__3D_STATE__.totemRotation0 === 'number' && typeof window.__3D_STATE__.totemRotation1 === 'number' && typeof window.__3D_STATE__.totemRotation2 === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Equilibrium",
      "description": "All four masks have equal energy (100 each), no mask selected, totems at 0 degrees, city animation playing",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.maskEnergyRed === 100 && window.__3D_STATE__.maskEnergyBlue === 100 && window.__3D_STATE__.maskEnergyGreen === 100 && window.__3D_STATE__.maskEnergyGold === 100 && window.__3D_STATE__.selectedMaskIndex === -1 && window.__3D_STATE__.totemRotation0 === 0 && window.__3D_STATE__.totemRotation1 === 0 && window.__3D_STATE__.totemRotation2 === 0)"
    },
    {
      "id": "S1",
      "name": "Red Mask Selected",
      "description": "Red mask is selected with outline highlight, energy slider visible showing its current energy value",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedMaskIndex === 0"
    },
    {
      "id": "S2",
      "name": "Energy Redistributed",
      "description": "Energy has been transferred between masks while maintaining conservation (total=400), at least one transfer event recorded",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyTransferCount > 0 && Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01"
    },
    {
      "id": "S3",
      "name": "Totem Rotation Applied",
      "description": "At least one shadow totem has been rotated from initial position, affecting energy bias toward nearest mask",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.totemRotation0 > 0 || window.__3D_STATE__.totemRotation1 > 0 || window.__3D_STATE__.totemRotation2 > 0)"
    },
    {
      "id": "S4",
      "name": "Extreme Energy Imbalance",
      "description": "One mask holds >250 energy while others share the remainder, demonstrating conservation under stress",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.maskEnergyRed > 250 || window.__3D_STATE__.maskEnergyBlue > 250 || window.__3D_STATE__.maskEnergyGreen > 250 || window.__3D_STATE__.maskEnergyGold > 250) && Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01"
    },
    {
      "id": "S5",
      "name": "Multi-Totem Coupling",
      "description": "All three totems rotated to non-zero angles, creating complex energy bias patterns across masks",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totemRotation0 > 0 && window.__3D_STATE__.totemRotation1 > 0 && window.__3D_STATE__.totemRotation2 > 0"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "System maintains energy conservation and rendering stability for extended period after interactions",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedMaskIndex === -1 && Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01 && window.__3D_STATE__.cityAnimationActive === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const masks = document.querySelectorAll('canvas'); if(masks.length > 0) { masks[0].click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Red mask is selected and highlighted",
        "Energy slider appears in UI overlay",
        "selectedMaskIndex is set to 0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedMaskIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedMaskIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maskEnergyRed >= 0 && window.__3D_STATE__.maskEnergyRed <= 400",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 200; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Red mask energy changed to 200",
        "Other masks redistributed remaining 200 energy proportionally",
        "Total energy remains exactly 400",
        "Energy transfer count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyTransferCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyTransferCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - window.__3D_STATE__.totalEnergyPool) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.maskEnergyRed - 200) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const totemSliders = document.querySelectorAll('input[type=\"range\"]'); if(totemSliders.length > 1) { totemSliders[1].value = 90; totemSliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "First shadow totem rotated to 90 degrees",
        "Totem rotation state updated in __3D_STATE__",
        "Energy conservation still maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totemRotation0 === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totemRotation0 >= 0 && window.__3D_STATE__.totemRotation0 <= 360",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totemRotation0 - 90) < 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.maskEnergyRed + window.__3D_STATE__.maskEnergyBlue + window.__3D_STATE__.maskEnergyGreen + window.__3D_STATE__.maskEnergyGold) - 400) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
