      "type": "3d_object",
      "semantic": "The main cell sphere that undergoes division",
      "locator_hints": [
        "semi-transparent blue sphere",
        "radius ~1.5 at center"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Nucleus",
      "type": "3d_object",
      "semantic": "Purple nucleus inside the cell",
      "locator_hints": [
