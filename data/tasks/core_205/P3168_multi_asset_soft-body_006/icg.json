{
  "task_id": "P3168",
  "affordances": [
    {
      "id": "A1",
      "name": "Stork Model",
      "type": "3d_object",
      "semantic": "Soft-body deformable stork with physics-driven wings",
      "locator_hints": [
        "stork.glb",
        "bird mesh",
        "wing vertices"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Nemetona Shrine",
      "type": "3d_object",
      "semantic": "Jelly-like shrine statue with deformable surface vertices",
      "locator_hints": [
        "nemetona.glb",
        "shrine mesh",
        "statue surface"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Wind Direction Slider",
      "type": "dom_element",
      "semantic": "Controls horizontal wind direction in degrees",
      "locator_hints": [
        "input[type='range']",
        "wind direction",
        "0-360"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Wind Strength Slider",
      "type": "dom_element",
      "semantic": "Controls magnitude of wind force on wings",
      "locator_hints": [
        "input[type='range']",
        "wind strength",
        "0.0-2.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A5",
      "name": "Wing Stiffness Slider",
      "type": "dom_element",
      "semantic": "Controls spring constant of stork wing deformation",
      "locator_hints": [
        "input[type='range']",
        "wing stiffness",
        "0.01-1.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A6",
      "name": "Shrine Elasticity Slider",
      "type": "dom_element",
      "semantic": "Controls spring recovery rate of shrine jelly surface",
      "locator_hints": [
        "input[type='range']",
        "shrine elasticity",
        "0.01-1.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A7",
      "name": "Bounce Dampening Slider",
      "type": "dom_element",
      "semantic": "Controls damping of shrine vertex oscillations",
      "locator_hints": [
        "input[type='range']",
        "bounce dampening",
        "0.0-1.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 4"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Descent",
      "description": "Stork positioned above shrine, beginning descent with default physics parameters",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.storkPositionY > 4.0 && window.__3D_STATE__.isStorkLanded === false)"
    },
    {
      "id": "S1",
      "name": "Wind Adjusted Flight",
      "description": "Wind parameters modified, stork trajectory affected by lateral forces",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.windDirection !== undefined && window.__3D_STATE__.storkPositionY > 4.0 && window.__3D_STATE__.isStorkLanded === false"
    },
    {
      "id": "S2",
      "name": "Approach Phase",
      "description": "Stork descending below Y=4.0, nearing shrine surface with controlled velocity",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.storkPositionY < 4.0 && window.__3D_STATE__.storkVelocityY < 0 && window.__3D_STATE__.isStorkLanded === false"
    },
    {
      "id": "S3",
      "name": "Impact Contact",
      "description": "Stork has made contact with shrine, surface deformation initiated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isStorkLanded === true && window.__3D_STATE__.maxShrineDeformation > 0 && window.__3D_STATE__.shrineStabilityScore < 0.7"
    },
    {
      "id": "S4",
      "name": "Surface Settling",
      "description": "Shrine surface oscillating, stork attempting to stabilize on deforming platform",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isStorkLanded === true && window.__3D_STATE__.shrineStabilityScore >= 0.5 && window.__3D_STATE__.shrineStabilityScore < 0.7"
    },
    {
      "id": "S5",
      "name": "Stable Perch",
      "description": "Stork landed with minimal slip, shrine deformation within acceptable bounds",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isStorkLanded === true && window.__3D_STATE__.storkSlipDistance < 0.5 && window.__3D_STATE__.shrineStabilityScore > 0.7 && window.__3D_STATE__.shrineStabilityScore <= 0.85"
    },
    {
      "id": "S6",
      "name": "Long-term Stability",
      "description": "System maintains stable configuration for extended duration without drift",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isStorkLanded === true && window.__3D_STATE__.shrineStabilityScore > 0.85 && Math.abs(window.__3D_STATE__.storkVelocityY) < 0.1"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 180; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Wind direction set to 180 degrees",
        "Stork trajectory begins lateral drift"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.windDirection === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windDirection >= 170 && window.__3D_STATE__.windDirection <= 190",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY !== undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Stork has descended below Y=4.0",
        "Vertical velocity is negative (descending)"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkPositionY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY < 4.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityY < 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Stork has made contact with shrine surface",
        "Shrine deformation has begun"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isStorkLanded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isStorkLanded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxShrineDeformation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxShrineDeformation > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[3].value = 0.6; sliders[3].dispatchEvent(new Event('input', {bubbles: true})); sliders[4].value = 0.4; sliders[4].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Shrine elasticity adjusted to 0.6",
        "Bounce dampening set to 0.4",
        "Surface oscillations moderating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shrineElasticity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shrineElasticity - 0.6) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bounceDampening === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bounceDampening - 0.4) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Stork slip distance below 0.5 units",
        "Shrine stability score above 0.7",
        "Max deformation decreasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkSlipDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkSlipDistance < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shrineStabilityScore === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shrineStabilityScore > 0.7",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.maxShrineDeformation)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Stork position Y stable within tolerance",
        "Shrine stability score above 0.85",
        "All physics values finite and valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkPositionY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkPositionY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shrineStabilityScore > 0.85",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkVelocityY) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stability for 60 seconds",
        "No drift or instability detected",
        "All state values remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isStorkLanded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isStorkLanded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shrineStabilityScore >= 0.8",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkPositionY) && isFinite(window.__3D_STATE__.storkVelocityY)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
