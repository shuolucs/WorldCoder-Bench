        "window.__3D_STATE__.fishCaught >= 0",
        "window.__3D_STATE__.gameOver === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.turn >= 3 && window.__3D_STATE__.fishCaught >= 0 && window.__3D_STATE__.gameOver === false"
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.phase === 'ENDED'",
        "window.__3D_STATE__.winner !== 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameOver === true && window.__3D_STATE__.phase === 'ENDED' && window.__3D_STATE__.winner !== 0"
    },
    {
      "id": "S10",
