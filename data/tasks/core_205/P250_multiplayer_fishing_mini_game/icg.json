        "window.__3D_STATE__.bobberX !== 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.phase === 'AIM' && window.__3D_STATE__.bobberX !== 0"
    },
    {
      "id": "S3",
      "name": "P1_Casting",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.phase === 'CAST'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.phase === 'CAST'"
    },
    {
      "id": "S4",
      "name": "P1_Reeling",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.phase === 'REEL'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.phase === 'REEL'"
    },
    {
      "id": "S5",
      "name": "P2_Turn_Start",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.phase === 'AIM'",
        "window.__3D_STATE__.turn === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 2 && window.__3D_STATE__.phase === 'AIM' && window.__3D_STATE__.turn === 2"
    },
    {
      "id": "S6",
