{
  "task_id": "P250_multiplayer_fishing_mini_game",
  "affordances": [
    {
      "id": "A1",
      "name": "WaterSurface",
      "type": "3d_object",
      "semantic": "Semi-transparent blue water plane where fish swim",
      "locator_hints": [
        "PlaneGeometry at y=0",
        "blue material"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Player1",
      "type": "3d_object",
      "semantic": "Red capsule mesh representing Player 1 on the left shore",
      "locator_hints": [
        "red mesh at x=-5"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Player2",
      "type": "3d_object",
      "semantic": "Blue capsule mesh representing Player 2 on the right shore",
      "locator_hints": [
        "blue mesh at x=5"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "FoxMascot",
      "type": "3d_object",
      "semantic": "Fox.glb model placed on the shore as a mascot",
      "locator_hints": [
        "GLTF model at (8, 0, 18)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.foxLoaded === true)"
    },
    {
      "id": "A5",
      "name": "Fish",
      "type": "3d_object",
      "semantic": "Array of 8 fish meshes swimming in the water",
      "locator_hints": [
        "ellipsoid meshes on water plane"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.fishCount === 8)"
    },
    {
      "id": "A6",
      "name": "Bobber",
      "type": "3d_object",
      "semantic": "Small sphere at the end of the fishing line",
      "locator_hints": [
        "sphere mesh, child of line geometry"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.phase !== 'ENDED')"
    },
    {
      "id": "A7",
      "name": "Reticle",
      "type": "3d_object",
      "semantic": "Targeting ring on water surface during AIM phase",
      "locator_hints": [
        "ring geometry on water"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.phase === 'AIM' && window.__3D_STATE__.reticleVisible === true)"
    },
    {
      "id": "A8",
      "name": "P1ScoreHUD",
      "type": "dom_element",
      "semantic": "Player 1 score display top-left",
      "locator_hints": [
        "div with red text",
        "top-left"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A9",
      "name": "P2ScoreHUD",
      "type": "dom_element",
      "semantic": "Player 2 score display top-right",
      "locator_hints": [
        "div with blue text",
        "top-right"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A10",
      "name": "TurnPhaseHUD",
      "type": "dom_element",
      "semantic": "Turn counter and phase indicator top-center",
      "locator_hints": [
        "top-center div"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A11",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset Game button at bottom-right",
      "locator_hints": [
        "button",
        "bottom-right"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A12",
      "name": "WinnerOverlay",
      "type": "dom_element",
      "semantic": "Centered overlay showing the winner at game end",
      "locator_hints": [
        "centered div",
        "large text"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.gameOver === true)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Load",
      "conditions": [
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.fishCount === 8",
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.phase === 'AIM'",
        "window.__3D_STATE__.turn === 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.foxLoaded === true && window.__3D_STATE__.fishCount === 8 && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.phase === 'AIM' && window.__3D_STATE__.turn === 1"
    },
    {
      "id": "S1",
      "name": "P1_Aiming",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 1",
