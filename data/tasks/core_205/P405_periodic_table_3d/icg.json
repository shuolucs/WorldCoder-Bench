{
  "task_id": "P405_periodic_table_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "PeriodicTableGrid",
      "type": "3d_object",
      "semantic": "Grid of 36 element boxes (H-Kr) arranged in periodic table layout",
      "locator_hints": [
        "scene.children with BoxGeometry",
        "36 element meshes",
        "grid positions"
      ],
      "check": "window.__3D_STATE__ && window.__3D_STATE__.elementBoxCount === 36"
    },
    {
      "id": "A2",
      "name": "FlamingoMascot",
      "type": "3d_object",
      "semantic": "Animated flamingo.glb model at (30, 25, 0) scaled 0.05",
      "locator_hints": [
        "GLTF model",
        "position (30, 25, 0)",
        "AnimationMixer"
      ],
      "check": "window.__3D_STATE__ && window.__3D_STATE__.flamingoLoaded === 1"
    },
    {
      "id": "A3",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera controls starting at (0, 30, 80)",
      "locator_hints": [
        "OrbitControls",
        "camera position",
        "mouse interaction"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "SceneLighting",
      "type": "3d_object",
      "semantic": "Ambient light (0.6) and directional light at (50, 50, 50, 0.8)",
      "locator_hints": [
        "AmbientLight",
        "DirectionalLight",
        "light intensities"
      ],
      "check": "window.__3D_STATE__ && window.__3D_STATE__.lightCount > 1"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Page loaded, Three.js scene initializing",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.sceneChildCount === undefined"
    },
    {
      "id": "S1",
      "name": "scene_ready",
      "description": "Scene, camera, renderer, and lights created",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sceneChildCount > 0 && window.__3D_STATE__.lightCount > 1 && (!window.__3D_STATE__.elementBoxCount || window.__3D_STATE__.elementBoxCount === 0)"
    },
    {
      "id": "S2",
      "name": "periodic_table_built",
      "description": "36 element boxes created and positioned in periodic table layout",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elementBoxCount === 36 && (!window.__3D_STATE__.flamingoLoaded || window.__3D_STATE__.flamingoLoaded === 0)"
    },
    {
      "id": "S3",
      "name": "flamingo_loaded",
      "description": "Flamingo model loaded, scaled, positioned, and animation started",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.flamingoLoaded === 1 && (!window.__3D_STATE__.frameCount || window.__3D_STATE__.frameCount < 10)"
    },
    {
      "id": "S4",
      "name": "rendering_active",
      "description": "Animation loop running, flamingo animating, scene rendering",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.frameCount > 10 && window.__3D_STATE__.mixerTime > 0 && (!window.__3D_STATE__.controlsEnabled || window.__3D_STATE__.controlsEnabled === 0)"
    },
    {
      "id": "S5",
      "name": "interactive_stable",
      "description": "OrbitControls responsive, all elements visible and stable",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.controlsEnabled === 1 && window.__3D_STATE__.visibleElements >= 36 && window.__3D_STATE__.frameCount > 50 && window.__3D_STATE__.frameCount < 1000"
    },
    {
      "id": "S6",
      "name": "long_term_stable",
      "description": "Scene runs stably for 60 seconds with continuous animation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.frameCount > 1000 && window.__3D_STATE__.mixerTime > 30"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Scene object exists",
        "Camera positioned at (0, 30, 80)",
        "Renderer created",
        "Lights added to scene"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneChildCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneChildCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.cameraZ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraZ - 80) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightCount > 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "postconditions": [
        "36 element boxes created",
        "Boxes arranged in periodic table grid",
        "Color-coded by element category",
        "Box dimensions 2.5 x 2.5 x 0.5"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elementBoxCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elementBoxCount === 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boxMeshCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boxMeshCount >= 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firstElementX !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.firstElementX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Flamingo model loaded from GLTF",
        "Flamingo scaled to 0.05",
        "Flamingo positioned at (30, 25, 0)",
        "Animation mixer created and playing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flamingoLoaded !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flamingoLoaded === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flamingoX !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.flamingoX - 30) < 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flamingoScale !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.flamingoScale - 0.05) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Animation loop running",
        "Flamingo animation playing",
        "Frame count incrementing",
        "Mixer updating each frame"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mixerTime !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mixerTime > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.mixerTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "if (window.__orbitControls) { window.__orbitControls.update(); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "OrbitControls initialized",
        "Camera controls responsive",
        "All 36 elements visible",
        "Flamingo visible and animating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.controlsEnabled !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlsEnabled === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleElements !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleElements >= 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 50",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.frameCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene stable for 60 seconds",
        "Animation continues smoothly",
        "No memory leaks",
        "Frame rate stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 1000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elementBoxCount === 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flamingoLoaded === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mixerTime > 30",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.mixerTime)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
