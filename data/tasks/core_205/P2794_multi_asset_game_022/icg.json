{
  "task_id": "P2794",
  "affordances": [
    {
      "id": "A1",
      "name": "Corset Model",
      "type": "3d_object",
      "semantic": "Central mannequin corset with 6 mounting points for gears",
      "locator_hints": [
        "Corset.glb",
        "center pedestal",
        "mounting points visible"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Gear Tray",
      "type": "3d_object",
      "semantic": "Wooden shelf holding 5 gear instances at different scales",
      "locator_hints": [
        "gears.glb clones",
        "right side shelf",
        "scales 0.5x to 1.5x"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Mounting Points",
      "type": "interaction",
      "semantic": "Six glowing circular indicators on corset for gear attachment",
      "locator_hints": [
        "chest",
        "waist-left",
        "waist-right",
        "back-upper",
        "back-lower",
        "hip"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "HUD Display",
      "type": "dom_element",
      "semantic": "Shows current torque, target torque (100), and step counter",
      "locator_hints": [
        "overlay UI",
        "torque values",
        "step count"
      ],
      "check": "document.querySelectorAll('.overlay, [class*=\"hud\"], [class*=\"UI\"]').length > 0 || !!document.querySelector('canvas')"
    },
    {
      "id": "A5",
      "name": "Gear Selection",
      "type": "interaction",
      "semantic": "Click gear from tray to select with emissive highlight",
      "locator_hints": [
        "clickable gears",
        "emissive glow on selection"
      ],
      "check": "true"
    },
    {
      "id": "A6",
      "name": "Gear Attachment",
      "type": "interaction",
      "semantic": "Click mounting point to attach selected gear with snap and spin",
      "locator_hints": [
        "mount interaction",
        "gear snaps to position",
        "begins rotation"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Workshop",
      "description": "Scene loaded with corset on pedestal, 5 gears in tray, all mounts empty, HUD shows 0 torque",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.attachedGearCount === 0 && window.__3D_STATE__.totalTorque === 0)"
    },
    {
      "id": "S1",
      "name": "First Gear Selected",
      "description": "Player has selected a gear from tray, it glows with emissive highlight, ready to attach",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isGearSelected === true && window.__3D_STATE__.attachedGearCount === 0"
    },
    {
      "id": "S2",
      "name": "Gears Attached",
      "description": "Multiple gears mounted and spinning, totalTorque accumulating, stepCounter incremented",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.attachedGearCount >= 1 && window.__3D_STATE__.attachedGearCount < 3 && window.__3D_STATE__.totalTorque > 0"
    },
    {
      "id": "S3",
      "name": "Torque Balancing",
      "description": "Player swapping gears to optimize torque, conservation law affecting neighboring gear speeds",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.attachedGearCount >= 3 && window.__3D_STATE__.totalTorque < 80"
    },
    {
      "id": "S4",
      "name": "Near Target",
      "description": "Total torque within 20 units of target (100), player fine-tuning placement",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalTorque >= 80 && window.__3D_STATE__.totalTorque < 100 && Math.abs(window.__3D_STATE__.torqueDeficit) < 20"
    },
    {
      "id": "S5",
      "name": "Target Achieved",
      "description": "Total torque >= 100, hasReachedTarget true, system stable with all gears spinning",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hasReachedTarget === true && window.__3D_STATE__.totalTorque >= 100"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "Target maintained for extended period, all physics settled, task complete",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.hasReachedTarget === true && window.__3D_STATE__.totalTorque >= 100 && window.__3D_STATE__.attachedGearCount >= 3"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.8, clientY: window.innerHeight * 0.5}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "A gear from the tray is selected and highlighted",
        "selectedGearIndex is set to valid index (>= 0)",
        "isGearSelected becomes true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedGearIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedGearIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isGearSelected === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.5, clientY: window.innerHeight * 0.4}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Selected gear attaches to a mounting point on corset",
        "attachedGearCount increments to 1",
        "stepCounter increments",
        "totalTorque becomes positive"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.attachedGearCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.attachedGearCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTorque > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.stepCounter >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<3; i++) { setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * (0.75 + Math.random()*0.1), clientY: window.innerHeight * (0.4 + Math.random()*0.2)})); setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * (0.45 + Math.random()*0.1), clientY: window.innerHeight * (0.35 + Math.random()*0.2)})); }, 800); }, i * 2000); }",
        "wait_ms": 7000
      },
      "postconditions": [
        "Multiple gears attached through selection and mounting cycles",
        "attachedGearCount increases to 3 or more",
        "stepCounter reflects multiple actions",
        "averageGearSpeed is computed and positive"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.attachedGearCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.attachedGearCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCounter >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageGearSpeed > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.averageGearSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<2; i++) { setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.82, clientY: window.innerHeight * 0.6})); setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.48, clientY: window.innerHeight * 0.55})); }, 900); }, i * 2500); }",
        "wait_ms": 6000
      },
      "postconditions": [
        "Player has swapped gears to optimize torque output",
        "totalTorque approaches target value of 100",
        "torqueDeficit is small (absolute value < 20)",
        "largestGearSize is tracked"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.torqueDeficit === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.largestGearSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torqueDeficit) < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTorque > 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.78, clientY: window.innerHeight * 0.45})); setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth * 0.52, clientY: window.innerHeight * 0.42})); }, 1000);",
        "wait_ms": 3000
      },
      "postconditions": [
        "Final gear adjustment pushes totalTorque to or above target",
        "hasReachedTarget becomes true",
        "totalTorque >= 100",
        "System is stable with all gears spinning"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.hasReachedTarget === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hasReachedTarget === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTorque >= 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalTorque - window.__3D_STATE__.targetTorque) < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Target torque maintained without player intervention",
        "All state values remain stable",
        "No gears detached or swapped",
        "Physics system settled"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalTorque >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasReachedTarget === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.attachedGearCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalTorque)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All torque values consistent",
        "No state degradation or drift",
        "Task completion verified"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalTorque >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasReachedTarget === true",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalTorque)",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.averageGearSpeed)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
