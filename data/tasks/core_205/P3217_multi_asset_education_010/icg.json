{
  "task_id": "P3217",
  "affordances": [
    {
      "id": "A1",
      "name": "Stork Model",
      "type": "3d_object",
      "semantic": "Interactive 3D stork model that users click to start lesson and that animates along migration path",
      "locator_hints": [
        "stork.glb model",
        "positioned at first waypoint",
        "clickable mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Kira Teaching Companion",
      "type": "3d_object",
      "semantic": "Animated teaching guide model positioned on pedestal in corner",
      "locator_hints": [
        "kira.glb model",
        "bottom-right corner",
        "small pedestal"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.kiraAnimationActive !== undefined)"
    },
    {
      "id": "A3",
      "name": "Waypoint Markers",
      "type": "3d_object",
      "semantic": "Six numbered glowing sphere markers along migration path with geographic labels",
      "locator_hints": [
        "glowing spheres",
        "labeled Europe/Sahara/Nile/Savanna/Coast/Destination",
        "clickable"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.currentWaypointIndex !== undefined)"
    },
    {
      "id": "A4",
      "name": "Text Overlay Box",
      "type": "dom_element",
      "semantic": "HTML overlay displaying welcome text, instructions, and quiz questions",
      "locator_hints": [
        "HTML text box",
        "appears after stork click",
        "shows lesson content"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A5",
      "name": "Waypoint Click Interaction",
      "type": "interaction",
      "semantic": "User clicks waypoints in correct sequence to guide stork along migration path",
      "locator_hints": [
        "click waypoint spheres",
        "validates sequence",
        "red flash for wrong picks"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Scene Loaded",
      "description": "Scene rendered with terrain, waypoints, stork at start position, Kira on pedestal, lesson not started",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.lessonStarted === false"
    },
    {
      "id": "S1",
      "name": "Lesson Started",
      "description": "User clicked stork, Kira animation active, welcome text displayed, ready for waypoint interaction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lessonStarted === true && window.__3D_STATE__.currentWaypointIndex === 0"
    },
    {
      "id": "S2",
      "name": "First Waypoint Reached",
      "description": "Stork animated to first intermediate waypoint after correct click, progress incremented",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentWaypointIndex >= 1 && window.__3D_STATE__.currentWaypointIndex < 3"
    },
    {
      "id": "S3",
      "name": "Mid-Journey Progress",
      "description": "Stork has reached 3+ waypoints, multiple quiz questions answered, altitude adjustments made",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentWaypointIndex >= 3 && window.__3D_STATE__.currentWaypointIndex < 4"
    },
    {
      "id": "S4",
      "name": "Near Destination",
      "description": "Stork at penultimate waypoint, 4-5 waypoints reached, approaching final destination",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentWaypointIndex >= 4 && window.__3D_STATE__.finalDestinationReached !== true"
    },
    {
      "id": "S5",
      "name": "Migration Complete",
      "description": "Stork reached final destination waypoint, all waypoints completed, lesson finished",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.finalDestinationReached === true"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "Scene stable with completed migration path, all state values settled, 60s stability verified",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2, clientY: window.innerHeight/2}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Lesson started flag set to true",
        "Kira animation becomes active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lessonStarted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kiraAnimationActive === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentWaypointIndex - 0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalWaypointsReached)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.wrongWaypointClicks) < 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2 + 100, clientY: window.innerHeight/2 - 50}));",
        "wait_ms": 3000
      },
      "postconditions": [
        "Current waypoint index incremented to 1",
        "Total waypoints reached is 1",
        "Stork flight progress advanced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentWaypointIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaypointsReached >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkFlightProgress >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 0.2) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkAltitude)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkAltitude) < 5000",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.quizQuestionsAnswered)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<2; i++) { setTimeout(() => document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2 + 150 + i*50, clientY: window.innerHeight/2})), i*2000); }",
        "wait_ms": 6000
      },
      "postconditions": [
        "Waypoint index at 3 or higher",
        "Multiple waypoints reached",
        "Quiz questions answered count increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentWaypointIndex >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaypointsReached >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quizQuestionsAnswered >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 0.6) < 0.4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentWaypointIndex - 3) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkAltitude)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.quizQuestionsAnswered) < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2 + 200, clientY: window.innerHeight/2 + 50}));",
        "wait_ms": 3000
      },
      "postconditions": [
        "Waypoint index at 4 or 5",
        "Near final destination",
        "Stork altitude adjusted for weather zones"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentWaypointIndex >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaypointsReached >= 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.storkAltitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 0.8) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkAltitude)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkAltitude - 1500) < 2000",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.currentWaypointIndex)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2 + 250, clientY: window.innerHeight/2 + 100}));",
        "wait_ms": 4000
      },
      "postconditions": [
        "Final destination reached flag set",
        "All 6 waypoints completed",
        "Migration path complete"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.finalDestinationReached === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentWaypointIndex >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaypointsReached >= 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 1.0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkAltitude)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentWaypointIndex - 5) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalWaypointsReached)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values unchanged",
        "No errors or crashes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.finalDestinationReached === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaypointsReached >= 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.wrongWaypointClicks)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkFlightProgress - 1.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalWaypointsReached - 5) < 2",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.quizQuestionsAnswered)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
