{
  "task_id": "P2815",
  "affordances": [
    {
      "id": "A1",
      "name": "Left Shader Ball",
      "type": "3d_object",
      "semantic": "thermodynamic body with temperature state",
      "locator_hints": [
        "ShaderBall.glb",
        "left side of chamber",
        "clickable mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Right Shader Ball",
      "type": "3d_object",
      "semantic": "thermodynamic body with temperature state",
      "locator_hints": [
        "ShaderBall2.glb",
        "right side of chamber",
        "clickable mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Conductivity Slider",
      "type": "dom_element",
      "semantic": "controls heat transfer rate between balls",
      "locator_hints": [
        "input[type='range']",
        "conductivity label",
        "0-1 range"
      ],
      "check": "!!Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Conduct') || s.nextElementSibling?.textContent?.includes('Conduct'))"
    },
    {
      "id": "A4",
      "name": "Heat Injection Slider",
      "type": "dom_element",
      "semantic": "adds energy to selected ball",
      "locator_hints": [
        "input[type='range']",
        "heat inject",
        "0-100 range"
      ],
      "check": "!!Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Heat') || s.nextElementSibling?.textContent?.includes('Heat'))"
    },
    {
      "id": "A5",
      "name": "Cool Extraction Slider",
      "type": "dom_element",
      "semantic": "removes energy from selected ball",
      "locator_hints": [
        "input[type='range']",
        "cool extract",
        "0-100 range"
      ],
      "check": "!!Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Cool') || s.nextElementSibling?.textContent?.includes('Cool'))"
    },
    {
      "id": "A6",
      "name": "Insulation Barrier Toggle",
      "type": "dom_element",
      "semantic": "blocks heat transfer when active",
      "locator_hints": [
        "button",
        "checkbox",
        "insulation toggle"
      ],
      "check": "!!Array.from(document.querySelectorAll('button, input[type=\"checkbox\"]')).find(el => el.textContent?.includes('Insulation') || el.previousElementSibling?.textContent?.includes('Insulation') || el.nextElementSibling?.textContent?.includes('Insulation'))"
    },
    {
      "id": "A7",
      "name": "Wireframe Chamber",
      "type": "3d_object",
      "semantic": "sealed container boundary visualization",
      "locator_hints": [
        "BoxGeometry",
        "wireframe material",
        "transparent"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with both balls at default temperatures, no selection, zero sliders",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === false || (!window.__3D_STATE__.selectedBall && window.__3D_STATE__.heatInjectionRate === 0 && window.__3D_STATE__.coolExtractionRate === 0))"
    },
    {
      "id": "S1",
      "name": "Ball Selected",
      "description": "User has clicked one ball, selectedBall state is set, ready for energy manipulation",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.selectedBall === 'string' && window.__3D_STATE__.heatInjectionRate === 0 && window.__3D_STATE__.coolExtractionRate === 0"
    },
    {
      "id": "S2",
      "name": "Heating Active",
      "description": "Heat injection slider > 0, energy flowing from environment to selected ball, temperature rising",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heatInjectionRate > 0"
    },
    {
      "id": "S3",
      "name": "Cooling Active",
      "description": "Cool extraction slider > 0, energy flowing from selected ball to environment, temperature dropping",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.coolExtractionRate > 0 && window.__3D_STATE__.heatInjectionRate === 0"
    },
    {
      "id": "S4",
      "name": "Conduction Enabled",
      "description": "Conductivity > 0 and insulation off, heat transferring between balls based on temperature gradient",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.conductivity > 0 && window.__3D_STATE__.insulationActive === false && !window.__3D_STATE__.equilibriumReached"
    },
    {
      "id": "S5",
      "name": "Insulation Blocking",
      "description": "Insulation barrier active, heat transfer between balls blocked despite conductivity setting",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.insulationActive === true"
    },
    {
      "id": "S6",
      "name": "Thermal Equilibrium",
      "description": "Temperature difference < 5K sustained, system reached equilibrium, equilibriumReached flag true",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.equilibriumReached === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth*0.3, clientY: window.innerHeight*0.5, bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Left ball is selected",
        "selectedBall state is 'left'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedBall === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBall === 'left'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Heat') || s.nextElementSibling?.textContent?.includes('Heat')); if(slider) { slider.value = 50; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Heat injection rate is positive",
        "Selected ball temperature is increasing",
        "Environment energy is decreasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.heatInjectionRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heatInjectionRate > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.leftBallTemp > 300",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const heatSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Heat') || s.nextElementSibling?.textContent?.includes('Heat')); if(heatSlider) { heatSlider.value = 0; heatSlider.dispatchEvent(new Event('input', {bubbles: true})); } const coolSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Cool') || s.nextElementSibling?.textContent?.includes('Cool')); if(coolSlider) { coolSlider.value = 40; coolSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Cool extraction rate is positive",
        "Heat injection rate is zero",
        "Selected ball temperature is decreasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.coolExtractionRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coolExtractionRate > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.heatInjectionRate === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const coolSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Cool') || s.nextElementSibling?.textContent?.includes('Cool')); if(coolSlider) { coolSlider.value = 0; coolSlider.dispatchEvent(new Event('input', {bubbles: true})); } const condSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Conduct') || s.nextElementSibling?.textContent?.includes('Conduct')); if(condSlider) { condSlider.value = 0.7; condSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2500
      },
      "postconditions": [
        "Conductivity is greater than zero",
        "Insulation is not active",
        "Heat is transferring between balls"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.conductivity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.conductivity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.insulationActive === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const insulationToggle = Array.from(document.querySelectorAll('button, input[type=\"checkbox\"]')).find(el => el.textContent?.includes('Insulation') || el.previousElementSibling?.textContent?.includes('Insulation') || el.nextElementSibling?.textContent?.includes('Insulation')); if(insulationToggle) { insulationToggle.click(); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Insulation barrier is active",
        "Heat transfer between balls is blocked"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.insulationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.insulationActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const insulationToggle = Array.from(document.querySelectorAll('button, input[type=\"checkbox\"]')).find(el => el.textContent?.includes('Insulation') || el.previousElementSibling?.textContent?.includes('Insulation') || el.nextElementSibling?.textContent?.includes('Insulation')); if(insulationToggle) { insulationToggle.click(); }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Insulation barrier is deactivated",
        "Heat conduction resumes between balls",
        "Temperature difference is decreasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.insulationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.insulationActive === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leftBallTemp - window.__3D_STATE__.rightBallTemp) < 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Temperature difference between balls is less than 5K",
        "System has reached thermal equilibrium",
        "Total system energy is conserved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.equilibriumReached === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.equilibriumReached === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leftBallTemp - window.__3D_STATE__.rightBallTemp) < 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalSystemEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable at equilibrium for 60 seconds",
        "Energy conservation maintained",
        "No unexpected state changes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.equilibriumReached === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.equilibriumReached === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalSystemEnergy)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
