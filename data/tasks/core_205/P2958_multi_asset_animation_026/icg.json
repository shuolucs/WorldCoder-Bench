{
  "task_id": "P2958",
  "affordances": [
    {
      "id": "A1",
      "name": "Animation Clip Dropdown",
      "type": "dom_element",
      "semantic": "Dropdown menu to select which animation clip to play on the soldier",
      "locator_hints": [
        "select element",
        "animation clip selector",
        "dropdown in control panel"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A2",
      "name": "Animation Speed Slider",
      "type": "dom_element",
      "semantic": "Slider controlling the timeScale of animation playback",
      "locator_hints": [
        "input type=range",
        "speed slider",
        "timeScale control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A3",
      "name": "Crossfade Duration Slider",
      "type": "dom_element",
      "semantic": "Slider setting the blend duration when switching between clips",
      "locator_hints": [
        "input type=range",
        "crossfade slider",
        "blend duration control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Shadow Intensity Slider",
      "type": "dom_element",
      "semantic": "Slider adjusting the opacity of rendered shadows",
      "locator_hints": [
        "input type=range",
        "shadow slider",
        "shadow intensity control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Camera Orbit Slider",
      "type": "dom_element",
      "semantic": "Slider rotating the camera horizontally around the soldier",
      "locator_hints": [
        "input type=range",
        "camera orbit slider",
        "rotation control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A6",
      "name": "Soldier Model",
      "type": "3d_object",
      "semantic": "Animated soldier mesh with multiple animation clips",
      "locator_hints": [
        "soldier.glb",
        "animated character",
        "main character mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalClipsAvailable > 0)"
    },
    {
      "id": "A7",
      "name": "Shadow Platform",
      "type": "3d_object",
      "semantic": "Ground platform mesh that receives shadows from the soldier",
      "locator_hints": [
        "ShadowmappableMesh.glb",
        "ground platform",
        "shadow receiver"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.shadowIntensity === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading assets, no animation playing yet",
      "condition": "!window.__3D_STATE__ || typeof window.__3D_STATE__.totalClipsAvailable !== 'number' || window.__3D_STATE__.totalClipsAvailable === 0"
    },
    {
      "id": "S1",
      "name": "Default Animation Playing",
      "description": "First animation clip is playing at default speed with shadows visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeClipIndex === 0 && Math.abs(window.__3D_STATE__.animationSpeed - 1.0) < 0.01 && window.__3D_STATE__.isAnimationPlaying === true"
    },
    {
      "id": "S2",
      "name": "Speed Modified",
      "description": "Animation speed has been changed from default value",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.animationSpeed > 1.0 && window.__3D_STATE__.isAnimationPlaying === true"
    },
    {
      "id": "S3",
      "name": "Clip Switched",
      "description": "User has selected a different animation clip with crossfade applied",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeClipIndex >= 1 && window.__3D_STATE__.isAnimationPlaying === true"
    },
    {
      "id": "S4",
      "name": "Shadow Adjusted",
      "description": "Shadow intensity has been modified from default",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.shadowIntensity === 'number' && window.__3D_STATE__.shadowIntensity >= 0 && window.__3D_STATE__.shadowIntensity < 1.0"
    },
    {
      "id": "S5",
      "name": "Camera Orbited",
      "description": "Camera has been rotated around the soldier to a new viewing angle",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.cameraOrbitAngle === 'number' && window.__3D_STATE__.cameraOrbitAngle > 0"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "All systems running smoothly with user-configured parameters",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isAnimationPlaying === true && typeof window.__3D_STATE__.crossfadeDuration === 'number' && window.__3D_STATE__.crossfadeDuration >= 0.1"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both models are loaded and visible",
        "First animation clip is playing",
        "Shadows are rendering on the platform",
        "State fields are initialized with default values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalClipsAvailable === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalClipsAvailable > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activeClipIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationSpeed - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimationPlaying === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 2.0; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Animation speed is set to 2.0",
        "Animation plays faster than default",
        "Speed value is reflected in UI label"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationSpeed > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationSpeed - 2.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMixerTime !== undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const dropdown = document.querySelector('select'); if(dropdown && dropdown.options.length > 1) { dropdown.selectedIndex = 1; dropdown.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Second animation clip is now active",
        "Crossfade transition has completed",
        "Active clip index has changed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeClipIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeClipIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.activeClipIndex)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activeClipIndex < window.__3D_STATE__.totalClipsAvailable",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); const shadowSlider = Array.from(sliders).find(s => s.min === '0' && parseFloat(s.max) <= 1.1); if(shadowSlider) { shadowSlider.value = 0.3; shadowSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Shadow intensity reduced to 0.3",
        "Shadows are visibly lighter on the platform",
        "Shadow state field updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shadowIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shadowIntensity >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shadowIntensity - 0.3) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowIntensity <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); const orbitSlider = Array.from(sliders).find(s => parseFloat(s.max) > 6); if(orbitSlider) { orbitSlider.value = 3.14; orbitSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Camera has orbited approximately 180 degrees",
        "Viewing angle changed to opposite side",
        "Camera orbit angle updated in state"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraOrbitAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraOrbitAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraOrbitAngle - 3.14) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraOrbitAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); const crossfadeSlider = Array.from(sliders).find(s => parseFloat(s.min) === 0.1 && parseFloat(s.max) <= 2.1); if(crossfadeSlider) { crossfadeSlider.value = 1.2; crossfadeSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Crossfade duration set to 1.2 seconds",
        "All controls responsive and functional",
        "Animation continues smoothly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.crossfadeDuration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.crossfadeDuration >= 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.crossfadeDuration - 1.2) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimationPlaying === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "Animation continues playing without errors",
        "All state values remain valid",
        "No memory leaks or performance degradation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isAnimationPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMixerTime !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMixerTime >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.currentMixerTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalClipsAvailable > 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
