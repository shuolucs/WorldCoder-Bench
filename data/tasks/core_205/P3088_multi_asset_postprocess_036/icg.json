{
  "task_id": "P3088",
  "affordances": [
    {
      "id": "A1",
      "name": "Xbot Model",
      "type": "3d_object",
      "semantic": "Animated character model at origin",
      "locator_hints": [
        "center of scene",
        "scale 1"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded)"
    },
    {
      "id": "A2",
      "name": "WaterBottle Model",
      "type": "3d_object",
      "semantic": "Water bottle model on left side",
      "locator_hints": [
        "position (-2, 0.5, 0)",
        "scaled 8x"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded)"
    },
    {
      "id": "A3",
      "name": "ShaderBall Model",
      "type": "3d_object",
      "semantic": "Shader ball model on right side",
      "locator_hints": [
        "position (2, 0.5, 0)",
        "scaled 1.5x"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded)"
    },
    {
      "id": "A4",
      "name": "Bloom Controls",
      "type": "dom_element",
      "semantic": "dat.GUI folder with bloom threshold, strength, radius sliders",
      "locator_hints": [
        "GUI panel",
        "Bloom folder"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    },
    {
      "id": "A5",
      "name": "Chromatic Aberration Control",
      "type": "dom_element",
      "semantic": "dat.GUI slider for chromatic aberration offset",
      "locator_hints": [
        "GUI panel",
        "Chromatic Aberration folder"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    },
    {
      "id": "A6",
      "name": "Vignette Controls",
      "type": "dom_element",
      "semantic": "dat.GUI folder with vignette intensity and smoothness sliders",
      "locator_hints": [
        "GUI panel",
        "Vignette folder"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    },
    {
      "id": "A7",
      "name": "Color Grading Controls",
      "type": "dom_element",
      "semantic": "dat.GUI folder with saturation, brightness, contrast sliders",
      "locator_hints": [
        "GUI panel",
        "Color Grading folder"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    },
    {
      "id": "A8",
      "name": "Pixelation Control",
      "type": "dom_element",
      "semantic": "dat.GUI slider for pixel size",
      "locator_hints": [
        "GUI panel",
        "pixelSize control"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    },
    {
      "id": "A9",
      "name": "Radial Blur Control",
      "type": "dom_element",
      "semantic": "dat.GUI slider for radial blur strength",
      "locator_hints": [
        "GUI panel",
        "radialBlurStrength control"
      ],
      "check": "!!document.querySelector('.dg.ac')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, assets loading, default post-processing values set",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.assetsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "All three GLB models loaded and positioned, default effects active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded === true && window.__3D_STATE__.bloomStrength < 2.0"
    },
    {
      "id": "S2",
      "name": "Bloom Enhanced",
      "description": "Bloom strength increased to create glowing aura effect",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.bloomStrength >= 2.0 && window.__3D_STATE__.chromaticOffset < 0.01"
    },
    {
      "id": "S3",
      "name": "Chromatic Distortion",
      "description": "Chromatic aberration offset increased for color fringing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.chromaticOffset >= 0.01 && window.__3D_STATE__.colorSaturation < 1.5"
    },
    {
      "id": "S4",
      "name": "Color Graded",
      "description": "Saturation and contrast adjusted for stylized look",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.colorSaturation >= 1.5 && window.__3D_STATE__.pixelSize <= 1.0"
    },
    {
      "id": "S5",
      "name": "Pixelated View",
      "description": "Pixelation effect applied with increased pixel size",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pixelSize > 1.0 && window.__3D_STATE__.radialBlurStrength <= 0.0"
    },
    {
      "id": "S6",
      "name": "Radial Blur Active",
      "description": "Radial blur effect applied from center creating motion effect",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.radialBlurStrength > 0.0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "All three GLB models are loaded and visible in scene"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assetsLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.bloomStrength = 2.5; window.__3D_STATE__.bloomThreshold = 0.2;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bloom strength increased to 2.5 and threshold lowered to 0.2"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomStrength - 2.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomThreshold - 0.2) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.chromaticOffset = 0.015;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Chromatic aberration offset set to 0.015 for visible color fringing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chromaticOffset >= 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chromaticOffset - 0.015) < 0.005",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.colorSaturation = 2.0; window.__3D_STATE__.colorContrast = 1.5;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color saturation increased to 2.0 and contrast to 1.5"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorSaturation >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.colorContrast - 1.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.pixelSize = 4.0;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pixelation effect enabled with pixel size of 4.0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pixelSize > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pixelSize - 4.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.radialBlurStrength = 0.6;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Radial blur effect activated with strength 0.6"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.radialBlurStrength > 0.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.radialBlurStrength - 0.6) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "All post-processing effects remain stable for 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bloomStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.radialBlurStrength > 0.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.pixelSize)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
