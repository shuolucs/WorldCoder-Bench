{
  "task_id": "P2984",
  "affordances": [
    {
      "id": "A1",
      "name": "DispersionTest Gem",
      "type": "3d_object",
      "semantic": "Left-side gem model that acts as prismatic light source",
      "locator_hints": [
        "DispersionTest.glb",
        "position x=-2",
        "rotating gem"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "ShaderBall2",
      "type": "3d_object",
      "semantic": "Right-side shader ball receiving chromatic light transfer",
      "locator_hints": [
        "ShaderBall2.glb",
        "position x=2",
        "material target"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "RGB Light Beams",
      "type": "3d_object",
      "semantic": "Three colored cylinder beams (red, green, blue) connecting gem to shader ball",
      "locator_hints": [
        "cylinder geometry",
        "red green blue materials",
        "animated wave motion"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.beamWavePhase === 'number')"
    },
    {
      "id": "A4",
      "name": "IOR Slider",
      "type": "dom_element",
      "semantic": "Slider controlling index of refraction (1.0-2.5) affecting gem material and beam spread",
      "locator_hints": [
        "input[type=range]",
        "IOR",
        "1.0-2.5"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 0"
    },
    {
      "id": "A5",
      "name": "Dispersion Strength Slider",
      "type": "dom_element",
      "semantic": "Slider controlling color separation width of prismatic beams (0-1)",
      "locator_hints": [
        "input[type=range]",
        "Dispersion",
        "0-1"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 1"
    },
    {
      "id": "A6",
      "name": "Transmission Slider",
      "type": "dom_element",
      "semantic": "Slider controlling shader ball transmission property (0-1)",
      "locator_hints": [
        "input[type=range]",
        "Transmission",
        "0-1"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 2"
    },
    {
      "id": "A7",
      "name": "Roughness Slider",
      "type": "dom_element",
      "semantic": "Slider controlling shader ball roughness property (0-1)",
      "locator_hints": [
        "input[type=range]",
        "Roughness",
        "0-1"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 3"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loads with both models, default materials, beams visible, gem rotating",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "IOR Adjusted",
      "description": "User adjusts IOR slider, gem material IOR changes, beam spread angle updates",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.gemIOR === 'number' && window.__3D_STATE__.gemIOR >= 1.8"
    },
    {
      "id": "S2",
      "name": "Dispersion Modified",
      "description": "User adjusts dispersion strength, RGB beam separation width changes visibly",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.dispersionStrength === 'number' && window.__3D_STATE__.dispersionStrength >= 0.5"
    },
    {
      "id": "S3",
      "name": "Transmission Applied",
      "description": "User adjusts transmission slider, shader ball becomes translucent",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.shaderBallTransmission === 'number' && window.__3D_STATE__.shaderBallTransmission >= 0.6"
    },
    {
      "id": "S4",
      "name": "Roughness Configured",
      "description": "User adjusts roughness slider, shader ball surface reflectivity changes",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.shaderBallRoughness === 'number' && window.__3D_STATE__.shaderBallRoughness <= 0.45"
    },
    {
      "id": "S5",
      "name": "Full Material Transfer",
      "description": "All parameters adjusted, chromatic transfer effect fully configured and animating",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.controlsInteracted === true && window.__3D_STATE__.materialsApplied === true"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System runs stably with all animations and material updates for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=range]').value = 2.0; document.querySelector('input[type=range]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "IOR value updated to 2.0",
        "Gem material IOR property reflects new value",
        "Beam spread angle recalculated based on IOR"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gemIOR === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gemIOR >= 1.8 && window.__3D_STATE__.gemIOR <= 2.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gemIOR - 2.0) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); sliders[1].value = 0.7; sliders[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Dispersion strength set to 0.7",
        "RGB beam offsets updated to show color separation",
        "Beam positions reflect dispersion value"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dispersionStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dispersionStrength >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dispersionStrength - 0.7) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); sliders[2].value = 0.8; sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Transmission slider set to 0.8",
        "Shader ball material transmission property updated",
        "Shader ball appears translucent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shaderBallTransmission === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderBallTransmission >= 0.6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderBallTransmission - 0.8) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); sliders[3].value = 0.3; sliders[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Roughness slider set to 0.3",
        "Shader ball material roughness property updated",
        "Surface reflectivity changed to smoother appearance"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shaderBallRoughness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderBallRoughness >= 0.15 && window.__3D_STATE__.shaderBallRoughness <= 0.45",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderBallRoughness - 0.3) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "All material parameters configured",
        "Gem continues rotating",
        "Beam wave animation active",
        "Controls have been interacted with"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gemRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gemRotationY > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.controlsInteracted === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Beam wave phase continues animating",
        "Beam offsets remain within valid ranges",
        "Materials remain applied to both models"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamWavePhase === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamWavePhase)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.materialsApplied === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Beam spread angle calculated and valid",
        "All beam Y-offsets are finite numbers",
        "System ready for stability check"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamSpreadAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamSpreadAngle >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.redBeamOffsetY) && isFinite(window.__3D_STATE__.greenBeamOffsetY) && isFinite(window.__3D_STATE__.blueBeamOffsetY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System operates stably for 60 seconds",
        "All animations continue without errors",
        "Material properties remain consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gemRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gemRotationY > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.beamWavePhase) && window.__3D_STATE__.materialsApplied === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
