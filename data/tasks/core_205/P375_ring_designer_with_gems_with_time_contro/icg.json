  "affordances": [
    {
      "id": "A1",
      "name": "Ring",
      "type": "3d_object",
      "semantic": "Main torus ring that rotates and changes material",
      "locator_hints": [
        "torus geometry at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ringMaterial !== undefined)"
    },
    {
      "id": "A2",
      "name": "Gems",
      "type": "3d_object",
      "semantic": "Octahedron gems placed on ring slots",
      "locator_hints": [
        "octahedron meshes on ring surface"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.gems !== undefined)"
    },
    {
      "id": "A3",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "Reference GLTF model displayed to the side",
      "locator_hints": [
        "GLB model at (3,0,0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.helmetLoaded === true)"
    },
    {
      "id": "A4",
      "name": "GemSelect",
