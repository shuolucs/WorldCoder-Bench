  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.gemCount === 0",
        "window.__3D_STATE__.ringMaterial === 'gold'",
        "window.__3D_STATE__.ringRotating === true",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.timeSpeed === 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gemCount === 0 && window.__3D_STATE__.ringMaterial === 'gold' && window.__3D_STATE__.ringRotating === true && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.timeSpeed === 1.0"
    },
    {
      "id": "S1",
      "name": "HelmetLoaded",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.helmetLoaded === true"
    },
    {
      "id": "S2",
      "name": "FirstGemAdded",
      "conditions": [
        "window.__3D_STATE__.gemCount === 1",
        "window.__3D_STATE__.gems.length === 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gemCount === 1 && window.__3D_STATE__.gems.length === 1"
    },
    {
      "id": "S3",
      "name": "MultipleGemsAdded",
      "conditions": [
        "window.__3D_STATE__.gemCount === 3",
        "window.__3D_STATE__.gems.length === 3"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gemCount === 3 && window.__3D_STATE__.gems.length === 3"
    },
    {
      "id": "S4",
      "name": "MaterialChanged",
      "conditions": [
        "window.__3D_STATE__.ringMaterial === 'platinum'",
        "window.__3D_STATE__.ringColor === 0xE5E4E2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ringMaterial === 'platinum' && window.__3D_STATE__.ringColor === 0xE5E4E2"
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.timeSpeed === 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S6",
      "name": "TimeSpeedChanged",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.timeSpeed === 2.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.timeSpeed === 2.0"
    },
    {
      "id": "S7",
      "name": "TimeReset",
      "conditions": [
        "window.__3D_STATE__.elapsedTime < 0.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elapsedTime < 0.5"
    },
    {
      "id": "S8",
      "name": "RotationToggled",
      "conditions": [
        "window.__3D_STATE__.ringRotating === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ringRotating === false"
    },
    {
      "id": "S9",
      "name": "GemRemoved",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gemCount === 2"
    },
    {
      "id": "S10",
      "name": "AllGemsCleared",
