{
  "task_id": "P2879",
  "affordances": [
    {
      "id": "A1",
      "name": "Venice Mask Model",
      "type": "3d_object",
      "semantic": "Main venetian mask GLB model positioned at scene center",
      "locator_hints": [
        "venice_mask.glb",
        "center mesh",
        "primary model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Sunglasses Model",
      "type": "3d_object",
      "semantic": "Sunglasses GLB model attached to mask face",
      "locator_hints": [
        "SunglassesKhronos.glb",
        "attached accessory",
        "secondary model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sunglassesAttached)"
    },
    {
      "id": "A3",
      "name": "Shader Mode Keys",
      "type": "interaction",
      "semantic": "Keyboard keys 1-5 to cycle shader modes",
      "locator_hints": [
        "keydown event",
        "keys 1-5",
        "mode selection"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "Intensity Slider",
      "type": "dom_element",
      "semantic": "UI slider controlling shader intensity",
      "locator_hints": [
        "input[type=range]",
        "intensity control",
        "shader parameter"
      ],
      "check": "!!document.querySelector('input[type=range]')"
    },
    {
      "id": "A5",
      "name": "Post-Processing Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable bloom post-processing",
      "locator_hints": [
        "input[type=checkbox]",
        "bloom toggle",
        "post-processing control"
      ],
      "check": "!!document.querySelector('input[type=checkbox]')"
    },
    {
      "id": "A6",
      "name": "Mode Display",
      "type": "dom_element",
      "semantic": "On-screen text showing current shader mode name",
      "locator_hints": [
        "mode indicator",
        "text display",
        "current mode label"
      ],
      "check": "document.querySelectorAll('[class*=\"mode\"], [id*=\"mode\"]').length > 0"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initialized with models loaded, default shader mode 1 (Holographic), intensity at 1.0",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.currentShaderMode === 1 && Math.abs(window.__3D_STATE__.shaderIntensity - 1.0) < 0.1)"
    },
    {
      "id": "S1",
      "name": "Shader Mode Cycled",
      "description": "User has pressed a number key, shader mode changed to selected mode (1-5)",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.currentShaderMode === 'number' && window.__3D_STATE__.currentShaderMode >= 1 && window.__3D_STATE__.currentShaderMode <= 5)"
    },
    {
      "id": "S2",
      "name": "Intensity Adjusted",
      "description": "User has moved intensity slider, shader intensity value updated between 0.0-2.0",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.shaderIntensity === 'number' && window.__3D_STATE__.shaderIntensity >= 0 && window.__3D_STATE__.shaderIntensity <= 2.0)"
    },
    {
      "id": "S3",
      "name": "Post-Processing Toggled",
      "description": "User has toggled post-processing checkbox, bloom effect enabled or disabled",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.postProcessingEnabled === 'boolean')"
    },
    {
      "id": "S4",
      "name": "Multi-Parameter Active",
      "description": "Multiple shader parameters active simultaneously with custom values",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.currentShaderMode && typeof window.__3D_STATE__.shaderIntensity === 'number' && window.__3D_STATE__.shaderIntensity !== 1.0)"
    },
    {
      "id": "S5",
      "name": "Animation Running",
      "description": "Shader animation loop running with time uniform updating each frame",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.animationActive === true && typeof window.__3D_STATE__.timeUniform === 'number' && window.__3D_STATE__.timeUniform > 0)"
    },
    {
      "id": "S6",
      "name": "Stable State",
      "description": "All systems stable, shaders rendering correctly for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: '3', code: 'Digit3', keyCode: 51}))",
        "wait_ms": 1000
      },
      "postconditions": [
        "Shader mode changed to mode 3 (Energy Pulse)",
        "currentShaderMode state updated to 3",
        "Mode display shows 'Energy Pulse'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentShaderMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentShaderMode === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 1.5; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Shader intensity adjusted to 1.5",
        "shaderIntensity state updated to 1.5",
        "Visual shader effect intensity increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shaderIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderIntensity >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderIntensity - 1.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const checkbox = document.querySelector('input[type=\"checkbox\"]'); if(checkbox) { checkbox.checked = true; checkbox.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Post-processing bloom enabled",
        "postProcessingEnabled state set to true",
        "Visual bloom effect visible on shaders"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.postProcessingEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.postProcessingEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: '5', code: 'Digit5', keyCode: 53}))",
        "wait_ms": 1000
      },
      "postconditions": [
        "Shader mode changed to mode 5 (X-Ray)",
        "currentShaderMode state updated to 5",
        "X-Ray shader with fresnel transparency active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentShaderMode === 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.currentShaderMode)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 0.3; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Shader intensity reduced to 0.3",
        "Multi-parameter state active with mode 5 and low intensity",
        "Visual effect subtly rendered"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shaderIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderIntensity >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderIntensity - 0.3) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Animation loop running continuously",
        "timeUniform incrementing each frame",
        "animationActive state is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.timeUniform === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.timeUniform > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.animationActive === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.timeUniform)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System stable for 60 seconds",
        "All shader modes functional",
        "No errors or crashes",
        "Animation continues smoothly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentShaderMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunglassesAttached === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.timeUniform)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
