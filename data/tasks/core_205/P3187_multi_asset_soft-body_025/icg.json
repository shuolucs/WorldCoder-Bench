{
  "task_id": "P3187",
  "affordances": [
    {
      "id": "A1",
      "name": "Flamingo Soft-Body Mesh",
      "type": "3d_object",
      "semantic": "Deformable flamingo model with mass-spring lattice",
      "locator_hints": [
        "flamingo.glb",
        "soft-body vertices",
        "spring constraints"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.flamingoVertexCount > 0)"
    },
    {
      "id": "A2",
      "name": "Control Point Spheres",
      "type": "3d_object",
      "semantic": "Four draggable spheres on flamingo wings, head, and tail",
      "locator_hints": [
        "control points",
        "yellow highlight",
        "wing tip",
        "head",
        "tail"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.selectedControlPoint !== 'undefined')"
    },
    {
      "id": "A3",
      "name": "CesiumMan Character",
      "type": "3d_object",
      "semantic": "Animated character model on platform",
      "locator_hints": [
        "CesiumMan.glb",
        "walk animation",
        "left side platform"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.cesiumManWalkCycles !== 'undefined')"
    },
    {
      "id": "A4",
      "name": "Marionette Strings",
      "type": "3d_object",
      "semantic": "Visible lines connecting CesiumMan hands to flamingo control points",
      "locator_hints": [
        "thin lines",
        "hands to control points",
        "string tension"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.marionetteStringTension !== 'undefined')"
    },
    {
      "id": "A5",
      "name": "Canvas Interaction",
      "type": "interaction",
      "semantic": "Mouse click and drag on control points",
      "locator_hints": [
        "click control point",
        "drag to deform",
        "release"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Scene Load",
      "description": "Scene loaded with CesiumMan walking, flamingo soft-body initialized, control points visible",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.flamingoVertexCount > 0 && window.__3D_STATE__.userInteractionCount === 0)"
    },
    {
      "id": "S1",
      "name": "Control Point Selected",
      "description": "User has clicked a control point, it is highlighted yellow",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.selectedControlPoint >= 0 && window.__3D_STATE__.isControlPointHighlighted === true)"
    },
    {
      "id": "S2",
      "name": "Soft-Body Deformed",
      "description": "User has dragged control point, flamingo mesh deformed beyond threshold",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.controlPointDragDistance > 0.5 && window.__3D_STATE__.softBodyDeformationMagnitude > 0.3)"
    },
    {
      "id": "S3",
      "name": "Spring Relaxation Active",
      "description": "Control point released, spring system relaxing with measurable energy",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.springRelaxationEnergy > 0 && window.__3D_STATE__.selectedControlPoint === -1)"
    },
    {
      "id": "S4",
      "name": "Multiple Interactions Completed",
      "description": "User has interacted with control points multiple times, system responsive",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.userInteractionCount >= 2)"
    },
    {
      "id": "S5",
      "name": "Simulation Stabilized",
      "description": "Soft-body system has reached low-energy stable state",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.simulationStableFrames > 30 && window.__3D_STATE__.springRelaxationEnergy < 0.5)"
    },
    {
      "id": "S6",
      "name": "Long-Term Stability",
      "description": "System maintains stability over extended period with continuous animation",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.simulationStableFrames > 1800 && window.__3D_STATE__.cesiumManWalkCycles >= 3)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.7; const y = rect.top + rect.height * 0.4; canvas.dispatchEvent(new MouseEvent('mousedown', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 500
      },
      "postconditions": [
        "Control point is selected and highlighted yellow"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedControlPoint === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedControlPoint >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isControlPointHighlighted === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.7; const y = rect.top + rect.height * 0.3; for(let i=0; i<5; i++) { setTimeout(() => canvas.dispatchEvent(new MouseEvent('mousemove', {clientX: x - i*10, clientY: y - i*15, bubbles: true})), i*50); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Flamingo soft-body deformed with drag distance exceeding 0.5 units"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.controlPointDragDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.controlPointDragDistance > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.softBodyDeformationMagnitude > 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); canvas.dispatchEvent(new MouseEvent('mouseup', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Control point released, spring system has measurable kinetic energy"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.springRelaxationEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.springRelaxationEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.selectedControlPoint === -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.65; const y = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('mousedown', {clientX: x, clientY: y, bubbles: true})); setTimeout(() => { for(let i=0; i<4; i++) { setTimeout(() => canvas.dispatchEvent(new MouseEvent('mousemove', {clientX: x + i*12, clientY: y + i*8, bubbles: true})), i*60); } }, 100); setTimeout(() => canvas.dispatchEvent(new MouseEvent('mouseup', {bubbles: true})), 500);",
        "wait_ms": 1200
      },
      "postconditions": [
        "Multiple control point interactions completed, interaction count increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.userInteractionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.userInteractionCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flamingoVertexCount >= 40",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Soft-body system stabilized with low energy and stable frames accumulated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationStableFrames === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationStableFrames > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.springRelaxationEnergy < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "CesiumMan walk animation continues, marionette strings maintain tension"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cesiumManWalkCycles === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cesiumManWalkCycles >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.marionetteStringTension >= 0 && isFinite(window.__3D_STATE__.marionetteStringTension)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stability over 60 seconds with all components functioning"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationStableFrames === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationStableFrames > 1800",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cesiumManWalkCycles >= 3 && window.__3D_STATE__.flamingoVertexCount >= 40",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
