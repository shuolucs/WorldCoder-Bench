        "positioned at z=-2",
        "visible through glass refraction"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.bottleLoaded)"
    },
    {
      "id": "A3",
      "name": "WetnessSlider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling glass surface wetness",
      "locator_hints": [
        "slider labeled 'wetness'",
        "range 0.0-1.0",
        "default 0.3"
      ],
      "check": "Array.from(document.querySelectorAll('.property-name')).some(el => el.textContent === 'wetness')"
    },
    {
      "id": "A4",
      "name": "StreakDensitySlider",
