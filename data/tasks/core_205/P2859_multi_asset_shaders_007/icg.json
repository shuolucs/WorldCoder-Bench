        "No memory leaks or performance degradation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.glassLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottleLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.wetness) && isFinite(window.__3D_STATE__.streakDensity)",
