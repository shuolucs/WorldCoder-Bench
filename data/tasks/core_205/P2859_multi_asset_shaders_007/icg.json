        "mesh loaded from GlassBrokenWindow.glb",
        "positioned at z=0",
        "has ShaderMaterial applied"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.glassLoaded)"
    },
    {
      "id": "A2",
      "name": "WaterBottle",
      "type": "3d_object",
      "semantic": "Water bottle mesh positioned behind glass window",
