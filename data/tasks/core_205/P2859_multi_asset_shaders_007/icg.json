    },
    {
      "id": "A6",
      "name": "ChromaticOffsetSlider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling chromatic aberration offset",
      "locator_hints": [
        "slider labeled 'chromaticOffset'",
        "range 0.0-0.05"
      ],
      "check": "Array.from(document.querySelectorAll('.property-name')).some(el => el.textContent === 'chromaticOffset')"
    },
    {
      "id": "A7",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera orbit controls with 45-degree arc limitation",
      "locator_hints": [
        "OrbitControls instance",
        "limited azimuth angle",
        "camera at z=3"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is initializing, assets are being loaded, shader not yet active",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.glassLoaded === false || window.__3D_STATE__.bottleLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "Both GLB models loaded successfully, shader material applied to glass",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.glassLoaded === true && window.__3D_STATE__.bottleLoaded === true && window.__3D_STATE__.shaderActive === true"
    },
    {
      "id": "S2",
      "name": "Default Shader State",
      "description": "Shader running with default parameters: wetness 0.3, streakDensity 15, windAngle 45",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.shaderActive === true && Math.abs(window.__3D_STATE__.wetness - 0.3) < 0.01 && window.__3D_STATE__.streakDensity === 15 && window.__3D_STATE__.windAngle === 45"
    },
    {
      "id": "S3",
      "name": "Modified Wetness",
      "description": "User has adjusted wetness slider, affecting glass surface glossiness",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.shaderActive === true && Math.abs(window.__3D_STATE__.wetness - 0.3) >= 0.01"
    },
    {
      "id": "S4",
      "name": "Modified Streak Density",
      "description": "User has adjusted streak density, changing rain pattern frequency",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.shaderActive === true && window.__3D_STATE__.streakDensity !== 15"
    },
    {
      "id": "S5",
      "name": "Modified Wind Direction",
      "description": "User has adjusted wind angle, rotating rain streak orientation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.shaderActive === true && window.__3D_STATE__.windAngle !== 45"
    },
    {
      "id": "S6",
      "name": "Stable Runtime",
      "description": "Scene running stably with all shader effects active and responsive",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.glassLoaded === true && window.__3D_STATE__.bottleLoaded === true && window.__3D_STATE__.shaderActive === true && typeof window.__3D_STATE__.chromaticOffset === 'number' && typeof window.__3D_STATE__.refractionStrength === 'number'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both GLB assets have loaded",
        "Glass and bottle meshes are present in scene",
        "Shader material is applied to glass window"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.glassLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.glassLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottleLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "Shader parameters initialized to default values",
        "Wetness is 0.3, streakDensity is 15, windAngle is 45"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wetness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wetness >= 0 && window.__3D_STATE__.wetness <= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.wetness - 0.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.streakDensity === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windAngle === 45",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.property-name').textContent === 'wetness' ? document.querySelector('input[type=\"range\"]').value = 0.7 : null; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wetness parameter changed from default 0.3 to 0.7",
        "Glass surface glossiness visually updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wetness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wetness > 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.wetness - 0.7) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); for(let s of sliders) { const label = s.parentElement.querySelector('.property-name'); if(label && label.textContent === 'streakDensity') { s.value = 30; s.dispatchEvent(new Event('input', {bubbles: true})); break; }}",
        "wait_ms": 1000
      },
      "postconditions": [
        "Streak density changed from 15 to 30",
        "Rain pattern frequency increased on glass surface"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.streakDensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.streakDensity >= 1 && window.__3D_STATE__.streakDensity <= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.streakDensity >= 25 && window.__3D_STATE__.streakDensity <= 35",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.streakDensity)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); for(let s of sliders) { const label = s.parentElement.querySelector('.property-name'); if(label && label.textContent === 'windAngle') { s.value = 180; s.dispatchEvent(new Event('input', {bubbles: true})); break; }}",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wind angle changed from 45 to 180 degrees",
        "Rain streak direction rotated in shader"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.windAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windAngle >= 0 && window.__3D_STATE__.windAngle <= 360",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windAngle - 180) < 10",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.windAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "All shader parameters remain stable",
        "Chromatic aberration and refraction effects active",
        "Scene rendering without errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chromaticOffset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticOffset >= 0 && window.__3D_STATE__.chromaticOffset <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.refractionStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refractionStrength >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.shaderActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
