{
  "task_id": "P2943",
  "affordances": [
    {
      "id": "A1",
      "name": "InterpolationTest Model",
      "type": "3d_object",
      "semantic": "The animated character model at origin with multiple animation clips",
      "locator_hints": [
        "center of stage",
        "animated mesh",
        "origin position"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "AntiqueCamera Model",
      "type": "3d_object",
      "semantic": "Camera rig model positioned on the dolly track with attached spotlight",
      "locator_hints": [
        "orbiting object",
        "dolly track",
        "camera model"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.cameraOrbitAngle === 'number')"
    },
    {
      "id": "A3",
      "name": "Timeline Track Bars",
      "type": "dom_element",
      "semantic": "Draggable colored bars in timeline panel representing clip time windows",
      "locator_hints": [
        "bottom overlay",
        "timeline panel",
        "horizontal bars"
      ],
      "check": "document.querySelectorAll('.timeline-bar').length > 0"
    },
    {
      "id": "A4",
      "name": "Speed Slider",
      "type": "dom_element",
      "semantic": "Slider control for adjusting selected clip playback speed (0.1x-3.0x)",
      "locator_hints": [
        "timeline controls",
        "speed control",
        "slider input"
      ],
      "check": "!!document.querySelector('.speed-slider')"
    },
    {
      "id": "A5",
      "name": "Reverse Toggle Button",
      "type": "dom_element",
      "semantic": "Button to toggle reverse playback for selected animation clip",
      "locator_hints": [
        "timeline controls",
        "reverse button",
        "playback direction"
      ],
      "check": "!!document.querySelector('.reverse-button')"
    },
    {
      "id": "A6",
      "name": "Dolly Track",
      "type": "3d_object",
      "semantic": "Visible torus geometry forming the circular camera track",
      "locator_hints": [
        "circular track",
        "torus geometry",
        "radius 5"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.dollyTrackRadius === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Both models loaded, camera at starting position, timeline initialized with all clips at default offsets",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.cameraOrbitAngle === 0 && window.__3D_STATE__.selectedClipIndex < 0)"
    },
    {
      "id": "S1",
      "name": "Camera Orbiting",
      "description": "Antique camera model actively rotating on dolly track, orbit angle increasing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cameraOrbitAngle > 0 && window.__3D_STATE__.cameraOrbitSpeed > 0"
    },
    {
      "id": "S2",
      "name": "Clip Selected",
      "description": "User has selected a timeline clip, selectedClipIndex is valid (>= 0)",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedClipIndex >= 0"
    },
    {
      "id": "S3",
      "name": "Speed Adjusted",
      "description": "User modified a clip's speed, energy conservation triggered auto-scaling of other clips",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalAnimationEnergy > 0 && Math.abs(window.__3D_STATE__.totalAnimationEnergy - 10) < 0.1"
    },
    {
      "id": "S4",
      "name": "Reverse Playback Active",
      "description": "At least one clip has reverse flag set, clipReverseFlags contains '1' values",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.clipReverseFlags === 'string' && window.__3D_STATE__.clipReverseFlags.includes('1')"
    },
    {
      "id": "S5",
      "name": "Multiple Clips Playing",
      "description": "Two or more animation clips are actively playing with weight > 0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeClipCount >= 2"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running smoothly with conservation law maintained and camera orbiting",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isTimelinePlaying === true && Math.abs(window.__3D_STATE__.totalAnimationEnergy - 10) < 0.1 && window.__3D_STATE__.cameraOrbitAngle >= 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Camera orbit angle has increased from initial value",
        "Camera orbit speed is positive and non-zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraOrbitAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraOrbitAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.cameraOrbitSpeed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('.timeline-bar')[0]?.click()",
        "wait_ms": 500
      },
      "postconditions": [
        "First clip is selected",
        "selectedClipIndex is 0 or greater"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedClipIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedClipIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.selectedClipIndex)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('.speed-slider'); if(slider) { slider.value = 2.0; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Total animation energy remains at conservation constant 10",
        "Playback master speed or individual clip speeds have changed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalAnimationEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalAnimationEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalAnimationEnergy - 10) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.reverse-button')?.click()",
        "wait_ms": 500
      },
      "postconditions": [
        "At least one clip has reverse flag enabled",
        "clipReverseFlags string contains at least one '1'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.clipReverseFlags === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.clipReverseFlags.length > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.clipReverseFlags.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "postconditions": [
        "Multiple animation clips are actively playing",
        "activeClipCount is 2 or greater"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeClipCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeClipCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.activeClipCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Camera continues orbiting with valid angle",
        "Dolly track radius is maintained at expected value",
        "Timeline is playing and system is stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dollyTrackRadius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dollyTrackRadius >= 4.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dollyTrackRadius - 5) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isTimelinePlaying === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraOrbitAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for extended period",
        "All state values remain valid and within expected ranges",
        "Conservation law maintained throughout"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalAnimationEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalAnimationEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalAnimationEnergy - 10) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraOrbitAngle >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.spotlightIntensity)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
