{
  "task_id": "P2890",
  "affordances": [
    {
      "id": "A1",
      "name": "GlassWindow",
      "type": "3d_object",
      "semantic": "Broken glass window partition with adjustable IOR, opacity, and tint",
      "locator_hints": [
        "GlassBrokenWindow.glb",
        "position (0,1.5,-3)",
        "MeshPhysicalMaterial with transmission"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded && typeof window.__3D_STATE__.glassIOR === 'number')"
    },
    {
      "id": "A2",
      "name": "CarPaint",
      "type": "3d_object",
      "semantic": "Car model with clear-coat paint shader requiring clearCoat and clearCoatRoughness tuning",
      "locator_hints": [
        "ClearCoatCarPaint.glb",
        "position (0,0.5,-5)",
        "MeshPhysicalMaterial with clearcoat"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded && typeof window.__3D_STATE__.carClearCoat === 'number')"
    },
    {
      "id": "A3",
      "name": "BarnLamp",
      "type": "3d_object",
      "semantic": "Barn lamp with anisotropic material requiring anisotropy strength, rotation, and metalness",
      "locator_hints": [
        "AnisotropyBarnLamp.glb",
        "position (2,3,-1)",
        "MeshPhysicalMaterial with anisotropy"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded && typeof window.__3D_STATE__.lampAnisotropy === 'number')"
    },
    {
      "id": "A4",
      "name": "ShaderGUI",
      "type": "dom_element",
      "semantic": "lil-gui control panel with 10 sliders and color pickers for shader parameters",
      "locator_hints": [
        "lil-gui panel",
        "10 controls",
        "glass/car/lamp parameters",
        "energy budget slider"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.guiInitialized)"
    },
    {
      "id": "A5",
      "name": "EnergyConservation",
      "type": "interaction",
      "semantic": "Energy budget enforcement system that clamps shader values when sum exceeds limit",
      "locator_hints": [
        "glassOpacity + carClearCoat + lampAnisotropy <= globalEnergyBudget",
        "automatic clamping"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading, assets not yet ready, GUI not initialized",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.assetsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Scene Ready",
      "description": "All three GLB models loaded, GUI initialized with default shader values",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded === true && window.__3D_STATE__.guiInitialized === true && (window.__3D_STATE__.totalParameterChanges || 0) < 2"
    },
    {
      "id": "S2",
      "name": "Glass Tuning",
      "description": "User adjusting glass IOR and opacity, energy budget not violated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalParameterChanges >= 2 && window.__3D_STATE__.totalParameterChanges < 4 && typeof window.__3D_STATE__.glassIOR === 'number'"
    },
    {
      "id": "S3",
      "name": "Car Paint Tuning",
      "description": "User adjusting car clearCoat parameters, energy conservation active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalParameterChanges >= 4 && window.__3D_STATE__.totalParameterChanges < 7 && typeof window.__3D_STATE__.carClearCoat === 'number'"
    },
    {
      "id": "S4",
      "name": "Lamp Anisotropy Tuning",
      "description": "User adjusting lamp anisotropy and rotation, multiple parameters changed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalParameterChanges >= 7 && (window.__3D_STATE__.energyViolationCount || 0) === 0 && typeof window.__3D_STATE__.lampAnisotropy === 'number'"
    },
    {
      "id": "S5",
      "name": "Energy Budget Exceeded",
      "description": "Sum of glass+car+lamp effects exceeds global budget, clamping triggered",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyViolationCount >= 1 && window.__3D_STATE__.globalEnergyBudget < 2.0"
    },
    {
      "id": "S6",
      "name": "Stable Configuration",
      "description": "All shader parameters stable, energy conserved, scene rendering correctly for 60s",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalParameterChanges >= 9 && window.__3D_STATE__.globalEnergyBudget >= 2.0 && (window.__3D_STATE__.glassOpacity + window.__3D_STATE__.carClearCoat + window.__3D_STATE__.lampAnisotropy) <= (window.__3D_STATE__.globalEnergyBudget + 0.01)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "All three GLB assets loaded into scene",
        "GUI panel created with 10 controls",
        "Default shader values applied to materials"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assetsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.guiInitialized === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glassIOR === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.glassIOR = 1.8; window.__3D_STATE__.glassOpacity = 0.6; window.__3D_STATE__.totalParameterChanges = (window.__3D_STATE__.totalParameterChanges || 0) + 2;",
        "wait_ms": 1500
      },
      "postconditions": [
        "Glass IOR set to 1.8",
        "Glass opacity set to 0.6",
        "Parameter change count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.glassIOR - 1.8) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassOpacity >= 0.5 && window.__3D_STATE__.glassOpacity <= 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParameterChanges >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.carClearCoat = 0.85; window.__3D_STATE__.carClearCoatRoughness = 0.15; window.__3D_STATE__.totalParameterChanges = (window.__3D_STATE__.totalParameterChanges || 0) + 2;",
        "wait_ms": 1500
      },
      "postconditions": [
        "Car clearCoat intensity set to 0.85",
        "Car clearCoat roughness set to 0.15",
        "Total parameter changes increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.carClearCoat - 0.85) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.carClearCoatRoughness >= 0.0 && window.__3D_STATE__.carClearCoatRoughness <= 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParameterChanges >= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.lampAnisotropy = 0.75; window.__3D_STATE__.lampAnisotropyRotation = 3.14; window.__3D_STATE__.lampMetalness = 0.9; window.__3D_STATE__.totalParameterChanges = (window.__3D_STATE__.totalParameterChanges || 0) + 3;",
        "wait_ms": 1500
      },
      "postconditions": [
        "Lamp anisotropy set to 0.75",
        "Lamp rotation set to PI radians",
        "Lamp metalness set to 0.9",
        "Multiple shader parameters adjusted"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampAnisotropy >= 0.7 && window.__3D_STATE__.lampAnisotropy <= 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lampAnisotropyRotation - 3.14) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParameterChanges >= 7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.globalEnergyBudget = 1.5; window.__3D_STATE__.energyViolationCount = (window.__3D_STATE__.energyViolationCount || 0) + 1;",
        "wait_ms": 2000
      },
      "postconditions": [
        "Global energy budget reduced to 1.5",
        "Energy conservation violation detected",
        "Shader parameters clamped to satisfy budget constraint"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.globalEnergyBudget - 1.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyViolationCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.glassOpacity + window.__3D_STATE__.carClearCoat + window.__3D_STATE__.lampAnisotropy) <= (window.__3D_STATE__.globalEnergyBudget + 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.globalEnergyBudget = 2.5; window.__3D_STATE__.glassIOR = 1.5; window.__3D_STATE__.totalParameterChanges = (window.__3D_STATE__.totalParameterChanges || 0) + 2;",
        "wait_ms": 2000
      },
      "postconditions": [
        "Energy budget increased to safe level",
        "Glass IOR adjusted to moderate value",
        "All shader parameters within valid ranges",
        "Scene stable and energy conserved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.globalEnergyBudget >= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassIOR >= 1.0 && window.__3D_STATE__.glassIOR <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParameterChanges >= 9",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.carClearCoat) && isFinite(window.__3D_STATE__.lampAnisotropy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All shader parameters unchanged",
        "Energy conservation maintained",
        "No rendering errors or crashes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assetsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.guiInitialized === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glassIOR === 'number' && isFinite(window.__3D_STATE__.glassIOR)",
            "tier": "L0"
          },
          {
            "expr": "(window.__3D_STATE__.glassOpacity + window.__3D_STATE__.carClearCoat + window.__3D_STATE__.lampAnisotropy) <= (window.__3D_STATE__.globalEnergyBudget + 0.01)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
