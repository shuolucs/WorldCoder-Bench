{
  "task_id": "P408_cell_division_animation",
  "affordances": [
    {
      "id": "A1",
      "name": "ParentCell",
      "type": "3d_object",
      "semantic": "The main cell membrane sphere that divides",
      "locator_hints": [
        "semi-transparent sphere",
        "radius ~2.0",
        "color 0x44aa88"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cellCount >= 1)"
    },
    {
      "id": "A2",
      "name": "Nucleus",
      "type": "3d_object",
      "semantic": "The cell nucleus inside the parent cell",
      "locator_hints": [
        "smaller opaque sphere",
        "radius ~0.7",
        "color 0x8844aa"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.nucleusCount >= 1)"
    },
    {
      "id": "A3",
      "name": "Chromosomes",
      "type": "3d_object",
      "semantic": "Line segments representing chromosomes",
      "locator_hints": [
        "4 short lines",
        "color 0x2266cc or 0xff4444"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.currentPhase >= 1)"
    },
    {
      "id": "A4",
      "name": "Organelles",
      "type": "3d_object",
      "semantic": "Small spheres representing mitochondria",
      "locator_hints": [
        "4 small spheres",
        "radius 0.15",
        "color 0xffaa00"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cellCount >= 1)"
    },
    {
      "id": "A5",
      "name": "SpindleApparatus",
      "type": "3d_object",
      "semantic": "Wireframe cones representing spindle fibers",
      "locator_hints": [
        "two cone shapes",
        "visible during metaphase-telophase"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.currentPhase >= 2 && window.__3D_STATE__.currentPhase <= 4)"
    },
    {
      "id": "A6",
      "name": "NextPhaseButton",
      "type": "dom_element",
      "semantic": "Button to advance to next mitosis phase",
      "locator_hints": [
        "id='btn-next'"
      ],
      "check": "!!document.getElementById('btn-next')"
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset to interphase",
      "locator_hints": [
        "id='btn-reset'"
      ],
      "check": "!!document.getElementById('btn-reset')"
    },
    {
      "id": "A8",
      "name": "PlayAllButton",
      "type": "dom_element",
      "semantic": "Button to auto-play all phases",
      "locator_hints": [
        "id='btn-play-all'"
      ],
      "check": "!!document.getElementById('btn-play-all')"
    },
    {
      "id": "A9",
      "name": "PhaseLabel",
      "type": "dom_element",
      "semantic": "Text label showing current phase",
      "locator_hints": [
        "id='phase-label'"
      ],
      "check": "!!document.getElementById('phase-label')"
    },
    {
      "id": "A10",
      "name": "ProgressBar",
      "type": "dom_element",
      "semantic": "Visual progress bar for phase completion",
      "locator_hints": [
        "id='progress-bar'"
      ],
      "check": "!!document.getElementById('progress-bar')"
    },
    {
      "id": "A11",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider to control animation speed",
      "locator_hints": [
        "id='speed-slider'"
      ],
      "check": "!!document.getElementById('speed-slider')"
    },
    {
      "id": "A12",
      "name": "DaughterCells",
      "type": "3d_object",
      "semantic": "Two daughter cells after cytokinesis",
      "locator_hints": [
        "two spheres at x=-2.5 and x=+2.5"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cellCount === 2)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'Interphase'",
        "window.__3D_STATE__.cellCount === 1",
        "window.__3D_STATE__.nucleusCount === 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 0 && window.__3D_STATE__.cellCount === 1"
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Prophase'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 1"
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Metaphase'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 2"
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'Anaphase'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 3"
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseName === 'Telophase'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 4"
    },
    {
      "id": "S5",
      "name": "Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 5",
        "window.__3D_STATE__.phaseName === 'Cytokinesis'",
        "window.__3D_STATE__.cellCount === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 5 && window.__3D_STATE__.cellCount === 2"
    },
    {
      "id": "S6",
      "name": "ResetFromEnd",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.cellCount === 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase === 0 && window.__3D_STATE__.cellCount === 1"
    },
    {
      "id": "S7",
      "name": "SpeedAdjusted",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.speedMultiplier !== 1.0"
    },
    {
      "id": "S8",
      "name": "PreviousPhaseNav",
      "conditions": [
        "window.__3D_STATE__.currentPhase >= 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPhase >= 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Lights !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Background !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Space !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Lights)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Lights)",
            "tier": "L2"
          }
        ]
