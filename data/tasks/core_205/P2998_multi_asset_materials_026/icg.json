{
  "task_id": "P2998",
  "affordances": [
    {
      "id": "A1",
      "name": "Barn Lamp Model",
      "type": "3d_object",
      "semantic": "AnisotropyBarnLamp.glb positioned at (-2, 0, 0)",
      "locator_hints": [
        "glb model",
        "left side",
        "lamp object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.lampModelLoaded)"
    },
    {
      "id": "A2",
      "name": "Broken Glass Window Model",
      "type": "3d_object",
      "semantic": "GlassBrokenWindow.glb positioned at (1.5, 1, 0)",
      "locator_hints": [
        "glb model",
        "right side",
        "glass panel"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.glassModelLoaded)"
    },
    {
      "id": "A3",
      "name": "Lamp Power Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider controlling PointLight intensity (0-10)",
      "locator_hints": [
        "gui control",
        "Lamp Power",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 0"
    },
    {
      "id": "A4",
      "name": "Lamp Color Picker",
      "type": "dom_element",
      "semantic": "dat.gui color picker for PointLight color",
      "locator_hints": [
        "gui control",
        "Lamp Color",
        "color picker"
      ],
      "check": "document.querySelectorAll('.slider').length > 1"
    },
    {
      "id": "A5",
      "name": "Light Distance Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider for PointLight distance (1-20)",
      "locator_hints": [
        "gui control",
        "Light Distance",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 2"
    },
    {
      "id": "A6",
      "name": "Glass Opacity Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider for glass material opacity (0-1)",
      "locator_hints": [
        "gui control",
        "Glass Opacity",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 3"
    },
    {
      "id": "A7",
      "name": "Glass Roughness Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider for glass material roughness (0-1)",
      "locator_hints": [
        "gui control",
        "Glass Roughness",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 4"
    },
    {
      "id": "A8",
      "name": "Glass IOR Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider for glass index of refraction (1.0-2.5)",
      "locator_hints": [
        "gui control",
        "Glass IOR",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 5"
    },
    {
      "id": "A9",
      "name": "Glass Transmission Slider",
      "type": "dom_element",
      "semantic": "dat.gui slider for glass transmission (0-1)",
      "locator_hints": [
        "gui control",
        "Glass Transmission",
        "slider"
      ],
      "check": "document.querySelectorAll('.slider').length > 6"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loads with both models, lamp off, default glass settings",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.lampModelLoaded === false || window.__3D_STATE__.glassModelLoaded === false)"
    },
    {
      "id": "S1",
      "name": "Lamp Activated",
      "description": "User has set lamp power above zero, PointLight is active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lampPowerIntensity > 0 && window.__3D_STATE__.pointLightActive === true"
    },
    {
      "id": "S2",
      "name": "Lamp Configured",
      "description": "User has adjusted lamp color and distance parameters",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.lampColorHex === 'string' && window.__3D_STATE__.lightDistanceValue >= 1 && window.__3D_STATE__.lightDistanceValue <= 20"
    },
    {
      "id": "S3",
      "name": "Glass Opacity Adjusted",
      "description": "User has modified glass opacity from default value",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.glassOpacityValue === 'number' && window.__3D_STATE__.totalGlassMeshCount > 0"
    },
    {
      "id": "S4",
      "name": "Glass Surface Configured",
      "description": "User has adjusted glass roughness parameter",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.glassRoughnessValue === 'number' && window.__3D_STATE__.glassRoughnessValue >= 0 && window.__3D_STATE__.glassRoughnessValue <= 1"
    },
    {
      "id": "S5",
      "name": "Glass Refraction Configured",
      "description": "User has set glass IOR and transmission values",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.glassIorValue >= 1.0 && window.__3D_STATE__.glassIorValue <= 2.5 && window.__3D_STATE__.glassTransmissionValue >= 0 && window.__3D_STATE__.glassTransmissionValue <= 1"
    },
    {
      "id": "S6",
      "name": "Final Stable State",
      "description": "All parameters configured and scene stable for 60 seconds",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.slider').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Both 3D models are loaded",
        "Lamp power intensity is greater than zero",
        "PointLight is active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampPowerIntensity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.pointLightActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.slider'); if(sliders[2]) sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Lamp color has been set",
        "Light distance value is within valid range",
        "Lamp power remains active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lampColorHex === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightDistanceValue >= 1 && window.__3D_STATE__.lightDistanceValue <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampPowerIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.slider'); if(sliders[3]) sliders[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Glass opacity has been modified from default",
        "Glass mesh count is greater than zero",
        "Opacity value is within valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalGlassMeshCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.glassOpacityValue >= 0 && window.__3D_STATE__.glassOpacityValue <= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glassOpacityValue === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.slider'); if(sliders[4]) sliders[4].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Glass roughness has been adjusted",
        "Roughness value is within valid range",
        "Glass opacity remains set"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.glassRoughnessValue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.glassRoughnessValue >= 0 && window.__3D_STATE__.glassRoughnessValue <= 1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glassRoughnessValue)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.slider'); if(sliders[5]) sliders[5].dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { if(sliders[6]) sliders[6].dispatchEvent(new Event('input', {bubbles: true})); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Glass IOR has been set within valid range",
        "Glass transmission has been configured",
        "All glass material properties are valid numbers"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.glassIorValue >= 1.0 && window.__3D_STATE__.glassIorValue <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassTransmissionValue >= 0 && window.__3D_STATE__.glassTransmissionValue <= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glassTransmissionValue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glassIorValue)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.slider'); if(sliders[0]) { sliders[0].value = Math.random() * 5 + 3; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Lamp power has been adjusted dynamically",
        "All glass parameters remain valid",
        "Scene continues to render properly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampPowerIntensity >= 0 && window.__3D_STATE__.lampPowerIntensity <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassTransmissionValue >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalGlassMeshCount > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid and finite",
        "Both models remain loaded"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glassModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lampPowerIntensity)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.glassIorValue)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalGlassMeshCount > 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
