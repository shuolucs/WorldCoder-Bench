{
  "task_id": "P225_basketball_free_throw",
  "affordances": [
    {
      "id": "A1",
      "name": "Basketball",
      "type": "3d_object",
      "semantic": "The orange basketball sphere that the player shoots",
      "locator_hints": [
        "orange sphere",
        "radius 0.4",
        "ball mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Basketball)"
    },
    {
      "id": "A2",
      "name": "Hoop/Rim",
      "type": "3d_object",
      "semantic": "The orange torus representing the basketball rim",
      "locator_hints": [
        "torus at y=7 z=-9.5",
        "orange ring"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sceneReady)"
    },
    {
      "id": "A3",
      "name": "Backboard",
      "type": "3d_object",
      "semantic": "The white rectangular backboard behind the rim",
      "locator_hints": [
        "white box at z=-10",
        "3x2x0.2 box"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sceneReady)"
    },
    {
      "id": "A4",
      "name": "Scoreboard",
      "type": "dom_element",
      "semantic": "DOM overlay showing score and shot count",
      "locator_hints": [
        "#scoreboard"
      ],
      "check": "!!document.getElementById('scoreboard')"
    },
    {
      "id": "A5",
      "name": "PowerBar",
      "type": "dom_element",
      "semantic": "Vertical power bar showing charge level",
      "locator_hints": [
        "#powerBar",
        "#powerFill"
      ],
      "check": "!!document.getElementById('powerBar')"
    },
    {
      "id": "A6",
      "name": "AimDisplay",
      "type": "dom_element",
      "semantic": "Text showing current aim angle in degrees",
      "locator_hints": [
        "#aimDisplay"
      ],
      "check": "!!document.getElementById('aimDisplay')"
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the ball to starting position",
      "locator_hints": [
        "#resetBtn"
      ],
      "check": "!!document.getElementById('resetBtn')"
    },
    {
      "id": "A8",
      "name": "StatusText",
      "type": "dom_element",
      "semantic": "Text showing current game status",
      "locator_hints": [
        "#statusText"
      ],
      "check": "!!document.getElementById('statusText')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.gameStatus === 'ready'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sceneReady === true && window.__3D_STATE__.gameStatus === 'ready'"
    },
    {
      "id": "S1",
      "name": "AimAdjusted",
      "conditions": [
        "window.__3D_STATE__.aimAngle !== 0",
        "window.__3D_STATE__.gameStatus === 'ready'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.aimAngle !== 0 && window.__3D_STATE__.gameStatus === 'ready'"
    },
    {
      "id": "S2",
      "name": "PowerCharging",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'charging'",
        "window.__3D_STATE__.power > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameStatus === 'charging' && window.__3D_STATE__.power > 0"
    },
    {
      "id": "S3",
      "name": "BallInFlight",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'flying'",
        "window.__3D_STATE__.ballLaunched === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameStatus === 'flying' && window.__3D_STATE__.ballLaunched === true"
    },
    {
      "id": "S4",
      "name": "BallScored",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'scored'",
        "window.__3D_STATE__.score >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameStatus === 'scored' && window.__3D_STATE__.score >= 1"
    },
    {
      "id": "S5",
      "name": "BallMissed",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'missed'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameStatus === 'missed'"
    },
    {
      "id": "S6",
      "name": "BallReset",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'ready'",
        "window.__3D_STATE__.shots >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gameStatus === 'ready' && window.__3D_STATE__.shots >= 1"
    },
    {
      "id": "S7",
      "name": "AimResetToCenter",
      "conditions": [
        "window.__3D_STATE__.aimAngle === 0",
        "window.__3D_STATE__.gameStatus === 'ready'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.aimAngle === 0 && window.__3D_STATE__.gameStatus === 'ready'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Lighting !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Ground !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Basketball !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.y >= 2.5 && window.__3D_STATE__.ballPosition.y <= 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.z >= 7.0 && window.__3D_STATE__.ballPosition.z <= 9.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "action": "press",
        "repeat": 5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('aimDisplay') !== null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "action": "keydown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "action": "keyup"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Lighting !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Ground !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Basketball !== undefined",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.x) && !isNaN(window.__3D_STATE__.ballPosition.y) && !isNaN(window.__3D_STATE__.ballPosition.z)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.y >= 2.5 && window.__3D_STATE__.ballPosition.y <= 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.z >= 7.0 && window.__3D_STATE__.ballPosition.z <= 9.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "action": "press",
        "repeat": 15
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space'})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keyup', {key: ' ', code: 'Space'})); }, 800); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.x) && !isNaN(window.__3D_STATE__.ballPosition.y)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
