{
  "task_id": "P431_planetary_orbit_simulator_with_dynamic_d",
  "affordances": [
    {
      "id": "A1",
      "name": "Sun",
      "type": "3d_object",
      "semantic": "Golden sphere at origin representing the sun with emissive material",
      "locator_hints": [
        "sphere at position (0,0,0)",
        "radius 5",
        "color 0xffaa00"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.sunRadius === 'number' && window.__3D_STATE__.sunRadius > 0)"
    },
    {
      "id": "A2",
      "name": "Mercury",
      "type": "3d_object",
      "semantic": "First planet orbiting sun with elliptical orbit",
      "locator_hints": [
        "radius 0.8",
        "color 0x888888",
        "semi-major axis 15",
        "eccentricity 0.2"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.mercuryAngle === 'number')"
    },
    {
      "id": "A3",
      "name": "Earth",
      "type": "3d_object",
      "semantic": "Third planet with soldier model on surface",
      "locator_hints": [
        "blue-green planet",
        "semi-major axis ~30",
        "has soldier model"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.earthAngle === 'number')"
    },
    {
      "id": "A4",
      "name": "Soldier",
      "type": "3d_object",
      "semantic": "GLB model representing astronaut observer on Earth surface",
      "locator_hints": [
        "soldier.glb",
        "scale 0.02",
        "rotates to face sun",
        "on Earth surface"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.soldierLoaded === true)"
    },
    {
      "id": "A5",
      "name": "StarField",
      "type": "3d_object",
      "semantic": "Background particles simulating stars",
      "locator_hints": [
        "200 white spheres",
        "scattered in radius 500 sphere"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.starFieldCount === 'number' && window.__3D_STATE__.starFieldCount > 0)"
    },
    {
      "id": "A6",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera controls for scene navigation",
      "locator_hints": [
        "mouse drag to rotate",
        "scroll to zoom"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loads with sun, planets, star field, and soldier model positioned on Earth",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.soldierLoaded === false"
    },
    {
      "id": "S1",
      "name": "scene_initialized",
      "description": "All scene objects created, soldier model loaded and positioned, lighting configured",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.soldierLoaded === true && window.__3D_STATE__.planetCount >= 3 && window.__3D_STATE__.starFieldCount > 0)"
    },
    {
      "id": "S2",
      "name": "orbits_active",
      "description": "Planets begin elliptical orbital motion around sun, soldier rotates to face sun",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.mercuryAngle > 0 && window.__3D_STATE__.earthAngle > 0)"
    },
    {
      "id": "S3",
      "name": "first_orbit_complete",
      "description": "At least one planet completes a full orbital cycle",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.mercuryOrbits >= 1)"
    },
    {
      "id": "S4",
      "name": "soldier_tracking",
      "description": "Soldier model continuously rotates to face sun as Earth orbits",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.soldierRotationY === 'number' && window.__3D_STATE__.soldierDistanceFromSun > 0)"
    },
    {
      "id": "S5",
      "name": "multi_orbit_stable",
      "description": "Multiple planets orbiting smoothly with correct elliptical paths",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.activePlanets >= 3 && window.__3D_STATE__.earthOrbits > 0 && window.__3D_STATE__.totalOrbits > 0)"
    },
    {
      "id": "S6",
      "name": "long_term_stable",
      "description": "System runs stably for extended period with consistent physics",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalOrbits > 5 && window.__3D_STATE__.fps > 30)"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Sun sphere created at origin",
        "Planets created with correct materials",
        "Soldier model loaded and scaled",
        "Star field particles rendered",
        "Camera and lights positioned"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sunRadius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sunRadius > 4.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.planetCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.planetCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soldierLoaded !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.starFieldCount > 150",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Planets begin moving in elliptical orbits",
        "Orbital velocities calculated correctly",
        "Soldier begins rotation tracking"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mercuryAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mercuryAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.earthX) > 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.soldierRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.soldierRotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Mercury completes at least one full orbit",
        "Orbital angle wraps correctly",
        "Elliptical path maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mercuryOrbits === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mercuryOrbits >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mercuryZ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mercuryZ) < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthAngle > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Soldier continuously faces sun",
        "Soldier position updates with Earth",
        "Rotation angle calculated correctly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.soldierX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.soldierZ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.soldierDistanceFromSun > 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.soldierRotationY) < 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soldierOnEarthSurface !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.soldierX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "postconditions": [
        "All planets maintain elliptical orbits",
        "No collision or drift",
        "Orbital periods consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activePlanets === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activePlanets >= 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthOrbits === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.earthOrbits > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.earthZ) < 50",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.frameCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 10000
      },
      "postconditions": [
        "System stable over extended time",
        "No memory leaks or performance degradation",
        "All animations smooth"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalOrbits === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalOrbits > 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.fps > 30",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mercuryX) < 25",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.earthAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second stability run completed",
        "All orbital mechanics functioning correctly",
        "Soldier tracking maintained throughout"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.uptime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.uptime > 60000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalOrbits > 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.soldierRotationY) < 10",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.mercuryAngle)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
