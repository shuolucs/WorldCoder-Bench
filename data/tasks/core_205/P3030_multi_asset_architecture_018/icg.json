{
  "task_id": "P3030",
  "affordances": [
    {
      "id": "A1",
      "name": "Pool X Position Slider",
      "type": "dom_element",
      "semantic": "Range input controlling pool X coordinate",
      "locator_hints": [
        "input[type='range']",
        "slider for pool X position",
        "min=-10 max=10"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Pool Y Position Slider",
      "type": "dom_element",
      "semantic": "Range input controlling pool Y coordinate",
      "locator_hints": [
        "input[type='range']",
        "slider for pool Y position",
        "vertical position control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A3",
      "name": "Pool Z Position Slider",
      "type": "dom_element",
      "semantic": "Range input controlling pool Z coordinate",
      "locator_hints": [
        "input[type='range']",
        "slider for pool Z position",
        "depth control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Dungeon Rotation Slider",
      "type": "dom_element",
      "semantic": "Range input rotating dungeon model on Y axis",
      "locator_hints": [
        "input[type='range']",
        "rotation slider",
        "0 to 360 degrees"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Pool Scale Slider",
      "type": "dom_element",
      "semantic": "Range input for uniform pool scaling",
      "locator_hints": [
        "input[type='range']",
        "scale slider",
        "min=0.5 max=3.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A6",
      "name": "Pool Color Picker",
      "type": "dom_element",
      "semantic": "Color input to change pool material color",
      "locator_hints": [
        "input[type='color']",
        "color picker",
        "pool color control"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A7",
      "name": "Water Glow Intensity Slider",
      "type": "dom_element",
      "semantic": "Range input controlling blue point light intensity",
      "locator_hints": [
        "input[type='range']",
        "water glow slider",
        "intensity 0 to 5"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A8",
      "name": "Cinematic View Button",
      "type": "dom_element",
      "semantic": "Button to toggle cinematic camera mode",
      "locator_hints": [
        "button",
        "cinematic view",
        "camera mode toggle"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A9",
      "name": "Pool 3D Model",
      "type": "3d_object",
      "semantic": "Loaded pool GLB asset in the scene",
      "locator_hints": [
        "pool.glb",
        "pool mesh",
        "bathhouse pool object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.poolLoaded)"
    },
    {
      "id": "A10",
      "name": "Dungeon 3D Model",
      "type": "3d_object",
      "semantic": "Loaded dungeon GLB asset structure",
      "locator_hints": [
        "dungeon_warkarma.glb",
        "dungeon mesh",
        "underground structure"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.dungeonLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, assets loading, default positions and lighting set",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.dungeonLoaded === false || window.__3D_STATE__.poolLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "Both dungeon and pool models loaded successfully into scene",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dungeonLoaded === true && window.__3D_STATE__.poolLoaded === true"
    },
    {
      "id": "S2",
      "name": "Pool Repositioned",
      "description": "User has adjusted pool X/Y/Z coordinates to new position",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.poolPositionX === 'number' && window.__3D_STATE__.poolPositionX !== 0"
    },
    {
      "id": "S3",
      "name": "Dungeon Rotated",
      "description": "Dungeon structure rotated on Y axis to new orientation",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.dungeonRotationY === 'number' && window.__3D_STATE__.dungeonRotationY !== 0"
    },
    {
      "id": "S4",
      "name": "Pool Styled",
      "description": "Pool scale and color modified from defaults",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.poolScale === 'number' && window.__3D_STATE__.poolScale !== 1.0 && typeof window.__3D_STATE__.poolColorHex === 'string'"
    },
    {
      "id": "S5",
      "name": "Lighting Adjusted",
      "description": "Water glow intensity changed to create different atmosphere",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.waterGlowIntensity === 'number' && window.__3D_STATE__.waterGlowIntensity > 0"
    },
    {
      "id": "S6",
      "name": "Cinematic Mode",
      "description": "Cinematic camera view activated, orbit controls disabled",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cinematicModeActive === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both dungeon and pool GLB assets are loaded and visible in scene"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dungeonLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poolLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 5; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pool X position updated to 5.0 units"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.poolPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.poolPositionX - 5.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rotSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => parseFloat(s.max) === 360); if(rotSlider) { rotSlider.value = 180; rotSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Dungeon rotated 180 degrees on Y axis"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dungeonRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dungeonRotationY - 180) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const scaleSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => parseFloat(s.min) === 0.5 && parseFloat(s.max) === 3.0); if(scaleSlider) { scaleSlider.value = 2.0; scaleSlider.dispatchEvent(new Event('input', {bubbles: true})); } const colorPicker = document.querySelector('input[type=\"color\"]'); if(colorPicker) { colorPicker.value = '#ff6600'; colorPicker.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pool scaled to 2.0x and color changed to orange"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.poolScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.poolScale - 2.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.poolColorHex === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const glowSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => parseFloat(s.max) === 5); if(glowSlider) { glowSlider.value = 4.0; glowSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Water glow intensity increased to 4.0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waterGlowIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waterGlowIntensity >= 3.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waterGlowIntensity - 4.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const cinematicBtn = document.querySelector('button'); if(cinematicBtn) { cinematicBtn.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Cinematic mode activated, orbit controls disabled"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cinematicModeActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cinematicModeActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable in cinematic mode for 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cinematicModeActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.poolScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.waterGlowIntensity)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
