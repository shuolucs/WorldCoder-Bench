{
  "task_id": "P201_wave_interference_pattern_with_time_cont",
  "affordances": [
    {
      "id": "A1",
      "name": "WaveSurface",
      "type": "3d_object",
      "semantic": "Plane mesh with 200x200 segments displaying wave interference",
      "locator_hints": [
        "PlaneGeometry",
        "vertices displaced by wave equation",
        "centered at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.vertexCount >= 40000)"
    },
    {
      "id": "A2",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle animation play/pause",
      "locator_hints": [
        "button",
        "play",
        "pause"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A3",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Slider to control simulation time",
      "locator_hints": [
        "input[type='range']",
        "time",
        "slider"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "WaveSourceA",
      "type": "3d_object",
      "semantic": "Point wave source at (-15, 0, 0)",
      "locator_hints": [
        "source A",
        "position x=-15"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.vertexCount > 0)"
    },
    {
      "id": "A5",
      "name": "WaveSourceB",
      "type": "3d_object",
      "semantic": "Point wave source at (15, 0, 0)",
      "locator_hints": [
        "source B",
        "position x=15"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.vertexCount > 0)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene initialized with wave mesh at t=0",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.currentTime === 0 || window.__3D_STATE__.currentTime < 0.1)"
    },
    {
      "id": "S1",
      "name": "animation_started",
      "description": "Wave animation playing, time advancing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentTime > 0 && window.__3D_STATE__.currentTime <= 3.0 && window.__3D_STATE__.isPaused === false"
    },
    {
      "id": "S2",
      "name": "interference_visible",
      "description": "Clear interference pattern with constructive and destructive regions",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentTime > 3.0 && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.maxDisplacement > 1.0"
    },
    {
      "id": "S3",
      "name": "animation_paused",
      "description": "Animation paused, pattern frozen",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true && typeof window.__3D_STATE__.frozenTime === 'number'"
    },
    {
      "id": "S4",
      "name": "time_scrubbed",
      "description": "Time manually adjusted via slider",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true && typeof window.__3D_STATE__.scrubbedTime === 'number'"
    },
    {
      "id": "S5",
      "name": "resumed_animation",
      "description": "Animation resumed after manual control",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === false && typeof window.__3D_STATE__.resumedTime === 'number' && window.__3D_STATE__.currentTime > window.__3D_STATE__.resumedTime"
    },
    {
      "id": "S6",
      "name": "stability_test",
      "description": "Long-duration stability verification",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentTime > 60.0 && window.__3D_STATE__.isPaused === false"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Wave animation has started",
        "Time is advancing",
        "Mesh vertices are being updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.vertexCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.vertexCount >= 40000",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxDisplacement === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxDisplacement > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Interference pattern fully developed",
        "Multiple wave cycles completed",
        "Displacement values stabilized"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime > 3.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.minDisplacement === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.minDisplacement < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDisplacement > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.maxDisplacement + window.__3D_STATE__.minDisplacement) < 5.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Animation paused",
        "Time frozen",
        "Pattern static"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frozenTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frozenTime > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - window.__3D_STATE__.frozenTime) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = parseFloat(slider.max) * 0.3; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Time scrubbed to earlier value",
        "Pattern updated to new time",
        "Still paused"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.scrubbedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.scrubbedTime < window.__3D_STATE__.frozenTime",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - window.__3D_STATE__.scrubbedTime) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.maxDisplacement)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Animation resumed",
        "Time advancing from scrubbed position",
        "Wave propagation continues"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.resumedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > window.__3D_STATE__.resumedTime",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexCount >= 40000",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.vertexCount)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.currentTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System stable over 60 seconds",
        "No memory leaks",
        "Continuous wave animation",
        "All state values remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > 60.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.currentTime)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.maxDisplacement)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.minDisplacement)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.vertexCount >= 40000",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
