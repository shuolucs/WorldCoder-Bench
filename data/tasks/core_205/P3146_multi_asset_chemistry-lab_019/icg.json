{
  "task_id": "P3146",
  "affordances": [
    {
      "id": "A1",
      "name": "Coffee Mug",
      "type": "3d_object",
      "semantic": "Reaction vessel containing acidic solution, receives reagent additions",
      "locator_hints": [
        "coffeeMug.glb model",
        "positioned on left side of table",
        "clickable to receive reagent"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.scene && window.scene.getObjectByName('CoffeeMug'))"
    },
    {
      "id": "A2",
      "name": "Water Bottle",
      "type": "3d_object",
      "semantic": "Reagent dispenser containing base solution, click to select then dispense",
      "locator_hints": [
        "WaterBottle.glb model",
        "positioned on right side of table",
        "clickable to select/dispense"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.scene && window.scene.getObjectByName('WaterBottle'))"
    },
    {
      "id": "A3",
      "name": "Rubber Duck",
      "type": "3d_object",
      "semantic": "pH indicator that changes color based on solution acidity, click to stir",
      "locator_hints": [
        "Duck.glb model",
        "floating inside mug",
        "color changes with pH",
        "clickable to trigger stir animation"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.scene && window.scene.getObjectByName('Duck'))"
    },
    {
      "id": "A4",
      "name": "HUD Display",
      "type": "dom_element",
      "semantic": "Overlay showing current pH, volumes, and step counter",
      "locator_hints": [
        "top-left overlay",
        "displays pH value",
        "shows mug and bottle volumes",
        "shows step counter"
      ],
      "check": "!!(document.querySelector('.hud') || document.querySelector('[class*=\"hud\"]') || document.querySelector('[id*=\"hud\"]'))"
    },
    {
      "id": "A5",
      "name": "Measurement Log Panel",
      "type": "dom_element",
      "semantic": "Right-side panel recording pH measurements after each stir",
      "locator_hints": [
        "right side of screen",
        "lists measurement entries",
        "updates after stir action"
      ],
      "check": "!!(document.querySelector('.measurement-log') || document.querySelector('[class*=\"log\"]') || document.querySelector('[id*=\"log\"]'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Scene loaded with mug at pH 2.0 (200mL), bottle full (300mL), duck red, no interactions yet",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.stepCounter === 0 && window.__3D_STATE__.currentPH <= 2.5)"
    },
    {
      "id": "S1",
      "name": "First Reagent Addition",
      "description": "User has dispensed first 25mL from bottle to mug, pH shifted toward neutral, duck color transitioning",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.stepCounter >= 1 && window.__3D_STATE__.stepCounter < 4 && window.__3D_STATE__.currentPH > 2.0 && window.__3D_STATE__.currentPH < 3.5)"
    },
    {
      "id": "S2",
      "name": "Multiple Additions Progress",
      "description": "User has performed 3-5 additions, pH approaching equivalence point, duck transitioning through orange/yellow",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.stepCounter >= 4 && window.__3D_STATE__.stepCounter < 6 && window.__3D_STATE__.currentPH >= 3.5 && window.__3D_STATE__.currentPH < 5.5)"
    },
    {
      "id": "S3",
      "name": "Near Equivalence Point",
      "description": "pH in range 5.5-6.5, duck yellow-green, next addition will cause steep pH jump",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.stepCounter >= 6 && window.__3D_STATE__.currentPH >= 5.5 && window.__3D_STATE__.currentPH < 6.5 && !window.__3D_STATE__.equivalencePointReached)"
    },
    {
      "id": "S4",
      "name": "Equivalence Reached",
      "description": "pH reached target range 6.5-7.5, duck green, user has stirred and logged measurements",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.equivalencePointReached === true && window.__3D_STATE__.currentPH >= 6.5 && window.__3D_STATE__.currentPH <= 7.5 && window.__3D_STATE__.stirCount >= 1 && window.__3D_STATE__.stirCount < 3)"
    },
    {
      "id": "S5",
      "name": "Experiment Complete",
      "description": "All reagent dispensed or pH stabilized at target, multiple measurements logged, conservation law verified",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.equivalencePointReached === true && window.__3D_STATE__.stirCount >= 3 && window.__3D_STATE__.measurementLogEntries >= 3)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const bottle = window.scene.getObjectByName('WaterBottle'); const mug = window.scene.getObjectByName('CoffeeMug'); if (bottle && mug) { bottle.dispatchEvent({type: 'click'}); setTimeout(() => mug.dispatchEvent({type: 'click'}), 500); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Water bottle selected and 25mL dispensed to mug",
        "Mug volume increased to 225mL, bottle volume decreased to 275mL",
        "pH shifted from 2.0 toward neutral",
        "Step counter incremented to 1",
        "Duck color begins transitioning from red"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stepCounter === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stepCounter >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mugLiquidVolume >= 220",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottleRemainingVolume <= 280",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPH > 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.mugLiquidVolume + window.__3D_STATE__.bottleRemainingVolume) - 500) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const bottle = window.scene.getObjectByName('WaterBottle'); const mug = window.scene.getObjectByName('CoffeeMug'); if (bottle && mug) { for (let i = 0; i < 3; i++) { setTimeout(() => { bottle.dispatchEvent({type: 'click'}); setTimeout(() => mug.dispatchEvent({type: 'click'}), 300); }, i * 1500); } }",
        "wait_ms": 5000
      },
      "postconditions": [
        "User performed 3 additional reagent additions",
        "Step counter now at 4 or higher",
        "pH progressed through 3-5 range",
        "Duck color transitioned through orange toward yellow",
        "Total liquid conservation maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCounter >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPH >= 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDispensedVolume >= 75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckColorHue !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckColorHue > 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.mugLiquidVolume + window.__3D_STATE__.bottleRemainingVolume) - 500) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const bottle = window.scene.getObjectByName('WaterBottle'); const mug = window.scene.getObjectByName('CoffeeMug'); if (bottle && mug) { for (let i = 0; i < 2; i++) { setTimeout(() => { bottle.dispatchEvent({type: 'click'}); setTimeout(() => mug.dispatchEvent({type: 'click'}), 300); }, i * 1500); } }",
        "wait_ms": 4000
      },
      "postconditions": [
        "Two more additions performed, approaching equivalence point",
        "pH now in range 5.5-6.5",
        "Duck color transitioning from yellow to yellow-green",
        "Step counter at 6 or higher",
        "Next addition will cause steep pH jump"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCounter >= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPH >= 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPH <= 6.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckColorHue >= 40",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentPH - 6.0) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const bottle = window.scene.getObjectByName('WaterBottle'); const mug = window.scene.getObjectByName('CoffeeMug'); const duck = window.scene.getObjectByName('Duck'); if (bottle && mug && duck) { bottle.dispatchEvent({type: 'click'}); setTimeout(() => { mug.dispatchEvent({type: 'click'}); setTimeout(() => duck.dispatchEvent({type: 'click'}), 800); }, 500); }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Final addition pushed pH into target range 6.5-7.5",
        "Duck clicked to stir solution",
        "Duck performing bobbing animation",
        "Duck color now green (equivalence point indicator)",
        "Measurement logged to panel"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPH >= 6.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPH <= 7.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stirCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.equivalencePointReached === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.measurementLogEntries >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckColorHue >= 100 && window.__3D_STATE__.duckColorHue <= 140",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const duck = window.scene.getObjectByName('Duck'); if (duck) { for (let i = 0; i < 2; i++) { setTimeout(() => duck.dispatchEvent({type: 'click'}), i * 1000); } }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Additional stir actions performed to finalize readings",
        "Multiple measurements logged showing pH stability",
        "Conservation law verified across all additions",
        "Duck color stable at green",
        "Experiment complete with documented results"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stirCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.measurementLogEntries >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.equivalencePointReached === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentPH - 7.0) < 0.8",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.stepCounter)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalDispensedVolume)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values maintain integrity",
        "pH remains in target range",
        "Conservation law holds",
        "No unexpected state changes occur"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentPH === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentPH >= 6.5 && window.__3D_STATE__.currentPH <= 7.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.equivalencePointReached === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.mugLiquidVolume + window.__3D_STATE__.bottleRemainingVolume) - 500) < 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.stepCounter) && window.__3D_STATE__.stepCounter >= 7",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
