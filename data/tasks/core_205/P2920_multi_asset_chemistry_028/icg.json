        "pH control",
        "pH level slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A11",
      "name": "PollutantDisplay",
      "type": "dom_element",
      "semantic": "Display showing current pollutant concentrations",
      "locator_hints": [
        "pollutant readout",
        "concentration display",
        "NOx SOx metals"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.noxConcentration === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Polluted State",
      "description": "City is heavily polluted, no catalysts placed, default flow rates and pH",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.activeCatalystCount === 0 || window.__3D_STATE__.activeCatalystCount === undefined)"
    },
    {
      "id": "S1",
      "name": "First Catalyst Activated",
      "description": "One abalone catalyst placed on a plant station, initial reaction started",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeCatalystCount === 1 && window.__3D_STATE__.reactionIntensity > 0"
    },
    {
      "id": "S2",
      "name": "Multi-Catalyst Operation",
      "description": "Multiple catalysts active, pollutants decreasing but byproducts accumulating",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeCatalystCount >= 2 && window.__3D_STATE__.byproductAccumulation >= 0"
    },
    {
      "id": "S3",
      "name": "Flow Rate Optimized",
      "description": "Water flow rates adjusted across stations for better distribution",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalWaterFlowRate >= 100 && window.__3D_STATE__.plantAbsorptionRate > 0"
    },
    {
      "id": "S4",
      "name": "pH Balanced",
      "description": "System pH levels optimized for maximum catalytic efficiency",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.averageSystemPH - 7.2) < 1.0 && window.__3D_STATE__.catalystEfficiency > 0.5"
    },
    {
      "id": "S5",
      "name": "Conservation Balanced",
      "description": "Pollutant reduction balanced with byproduct management, system approaching stability",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeCatalystCount === 3 && window.__3D_STATE__.byproductAccumulation < 50 && isFinite(window.__3D_STATE__.totalPollutantMass)"
    },
    {
      "id": "S6",
      "name": "System Stabilized",
      "description": "All pollutants below threshold, byproducts managed, system in equilibrium",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.systemStabilized === true && window.__3D_STATE__.noxConcentration < 20 && window.__3D_STATE__.soxConcentration < 20 && window.__3D_STATE__.heavyMetalConcentration < 10"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const catalyst = document.querySelector('[data-catalyst=\"1\"]'); const plant = document.querySelector('[data-plant=\"1\"]'); if (catalyst && plant) { const plantRect = plant.getBoundingClientRect(); const evt = new MouseEvent('mousedown', {clientX: catalyst.getBoundingClientRect().left + 10, clientY: catalyst.getBoundingClientRect().top + 10, bubbles: true}); catalyst.dispatchEvent(evt); const evt2 = new MouseEvent('mousemove', {clientX: plantRect.left + plantRect.width/2, clientY: plantRect.top + plantRect.height/2, bubbles: true}); document.dispatchEvent(evt2); const evt3 = new MouseEvent('mouseup', {bubbles: true}); document.dispatchEvent(evt3); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "First catalyst is placed on a plant station",
        "Catalyst glow effect activated",
        "Active catalyst count increased to 1",
        "Initial reaction intensity registered"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeCatalystCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeCatalystCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCatalystCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const catalyst2 = document.querySelector('[data-catalyst=\"2\"]'); const plant2 = document.querySelector('[data-plant=\"2\"]'); if (catalyst2 && plant2) { const plantRect = plant2.getBoundingClientRect(); const evt = new MouseEvent('mousedown', {clientX: catalyst2.getBoundingClientRect().left + 10, clientY: catalyst2.getBoundingClientRect().top + 10, bubbles: true}); catalyst2.dispatchEvent(evt); const evt2 = new MouseEvent('mousemove', {clientX: plantRect.left + plantRect.width/2, clientY: plantRect.top + plantRect.height/2, bubbles: true}); document.dispatchEvent(evt2); const evt3 = new MouseEvent('mouseup', {bubbles: true}); document.dispatchEvent(evt3); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Second catalyst placed on different plant station",
        "Multiple reactions occurring simultaneously",
        "Pollutant concentrations decreasing",
        "Byproduct accumulation starting"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeCatalystCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.byproductAccumulation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.byproductAccumulation >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.noxConcentration < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const flowSliders = document.querySelectorAll('input[type=\"range\"][data-control=\"flow\"]'); if (flowSliders.length > 0) { flowSliders[0].value = 75; flowSliders[0].dispatchEvent(new Event('input', {bubbles: true})); if (flowSliders[1]) { flowSliders[1].value = 60; flowSliders[1].dispatchEvent(new Event('input', {bubbles: true})); } }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Water flow rates adjusted at multiple stations",
        "Total water flow rate increased",
        "Plant absorption rate improved",
        "Pollutant distribution more balanced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalWaterFlowRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalWaterFlowRate > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalWaterFlowRate >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.plantAbsorptionRate > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const phSliders = document.querySelectorAll('input[type=\"range\"][data-control=\"ph\"]'); if (phSliders.length > 0) { phSliders.forEach((slider, idx) => { slider.value = 7.2 + (idx * 0.2); slider.dispatchEvent(new Event('input', {bubbles: true})); }); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "pH levels adjusted across all stations",
        "Average system pH optimized for catalysis",
        "Catalyst efficiency increased",
        "Reaction intensity improved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.averageSystemPH === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.averageSystemPH > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.averageSystemPH - 7.2) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystEfficiency > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const catalyst3 = document.querySelector('[data-catalyst=\"3\"]'); const plant3 = document.querySelector('[data-plant=\"3\"]'); if (catalyst3 && plant3) { const plantRect = plant3.getBoundingClientRect(); const evt = new MouseEvent('mousedown', {clientX: catalyst3.getBoundingClientRect().left + 10, clientY: catalyst3.getBoundingClientRect().top + 10, bubbles: true}); catalyst3.dispatchEvent(evt); const evt2 = new MouseEvent('mousemove', {clientX: plantRect.left + plantRect.width/2, clientY: plantRect.top + plantRect.height/2, bubbles: true}); document.dispatchEvent(evt2); const evt3 = new MouseEvent('mouseup', {bubbles: true}); document.dispatchEvent(evt3); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "All three catalysts deployed across stations",
        "Maximum catalytic coverage achieved",
        "Pollutant mass conservation maintained",
        "Byproduct accumulation controlled"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeCatalystCount === 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalPollutantMass === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalPollutantMass)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.byproductAccumulation < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "All pollutant concentrations below safe thresholds",
        "System reaches chemical equilibrium",
        "Conservation laws satisfied",
        "System stabilized flag set to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.systemStabilized === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.systemStabilized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.noxConcentration < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soxConcentration < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heavyMetalConcentration < 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stability for 60 seconds",
        "No pollutant concentration spikes",
        "Conservation laws continuously satisfied",
        "All state values remain valid and finite"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.systemStabilized === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalPollutantMass)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.noxConcentration >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.soxConcentration >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.heavyMetalConcentration >= 0",
            "tier": "L1"
          },
          {
