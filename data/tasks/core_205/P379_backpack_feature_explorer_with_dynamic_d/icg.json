{
  "task_id": "P379_backpack_feature_explorer_with_dynamic_d",
  "affordances": [
    {
      "id": "A1",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "Brand mascot horse model loaded from GLB or fallback geometry",
      "locator_hints": [
        "position near (2,0,0)",
        "scaled to ~2 units tall"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Backpack",
      "type": "3d_object",
      "semantic": "Backpack product made of primitive shapes",
      "locator_hints": [
        "position near (-2, 0.75, 0)",
        "green colored boxes"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Hotspots",
      "type": "3d_object",
      "semantic": "5 interactive glowing spheres on backpack features",
      "locator_hints": [
        "small orange emissive spheres",
        "pulsing animation"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "DifficultyButtons",
      "type": "dom_element",
      "semantic": "Three buttons to switch difficulty level",
      "locator_hints": [
        "bottom center",
        "Easy/Medium/Hard labels"
      ],
      "check": "document.querySelectorAll('button').length >= 3"
    },
    {
      "id": "A5",
      "name": "StatusPanel",
      "type": "dom_element",
      "semantic": "Top-left panel showing discovered count and difficulty",
      "locator_hints": [
        "top-left overlay"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A6",
      "name": "FeaturePanel",
      "type": "dom_element",
      "semantic": "Right-side panel showing clicked feature details",
      "locator_hints": [
        "right side of screen"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.featurePanelVisible)"
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset discovered features",
      "locator_hints": [
        "Reset label"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Reset'))"
    },
    {
      "id": "A8",
      "name": "SpinButton",
      "type": "dom_element",
      "semantic": "Button to trigger 360-degree backpack spin",
      "locator_hints": [
        "Spin Backpack label"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Spin'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.discoveredCount === 0",
        "window.__3D_STATE__.currentDifficulty === 'easy'",
        "window.__3D_STATE__.isSpinning === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.discoveredCount === 0 && window.__3D_STATE__.currentDifficulty === 'easy' && window.__3D_STATE__.isSpinning === false"
    },
    {
      "id": "S1",
      "name": "DifficultyMedium",
      "conditions": [
        "window.__3D_STATE__.currentDifficulty === 'medium'",
        "window.__3D_STATE__.hotspotScale === 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentDifficulty === 'medium' && window.__3D_STATE__.hotspotScale === 1.0"
    },
    {
      "id": "S2",
      "name": "DifficultyHard",
      "conditions": [
        "window.__3D_STATE__.currentDifficulty === 'hard'",
        "window.__3D_STATE__.hotspotScale === 0.6"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentDifficulty === 'hard' && window.__3D_STATE__.hotspotScale === 0.6"
    },
    {
      "id": "S3",
      "name": "FirstFeatureDiscovered",
      "conditions": [
        "window.__3D_STATE__.discoveredCount === 1",
        "window.__3D_STATE__.featurePanelVisible === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.discoveredCount === 1 && window.__3D_STATE__.featurePanelVisible === true"
    },
    {
      "id": "S4",
      "name": "MultipleDiscovered",
      "conditions": [
        "window.__3D_STATE__.discoveredCount >= 3"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.discoveredCount >= 3"
    },
    {
      "id": "S5",
      "name": "AllDiscovered",
      "conditions": [
        "window.__3D_STATE__.discoveredCount === 5",
        "window.__3D_STATE__.discoveredFeatures.length === 5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.discoveredCount === 5 && window.__3D_STATE__.discoveredFeatures.length === 5"
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.discoveredCount === 0",
        "window.__3D_STATE__.discoveredFeatures.length === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.discoveredCount === 0 && window.__3D_STATE__.discoveredFeatures.length === 0"
    },
    {
      "id": "S7",
      "name": "SpinComplete",
      "conditions": [
        "window.__3D_STATE__.isSpinning === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isSpinning === false"
    },
    {
      "id": "S8",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraDistance - 5) < 0.5"
      ],
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.cameraDistance - 5) < 0.5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Easy !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Medium !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Hard !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.discoveredCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.discoveredCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isSpinning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.discoveredCount >= 0",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.discoveredFeatures)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Medium"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.discoveredCount !== before.discoveredCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.discoveredCount === 'number' && !isNaN(window.__3D_STATE__.discoveredCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.discoveredFeatures)",
            "tier": "L2"
