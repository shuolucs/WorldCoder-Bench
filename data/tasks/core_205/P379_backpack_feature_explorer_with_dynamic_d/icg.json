      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Easy')) b.click(); }); await new Promise(r => setTimeout(r, 500)); const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(-0.4, 0.1); raycaster.setFromCamera(mouse, window.__camera || document.querySelector('canvas').__camera); const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width * 0.3; const cy = rect.top + rect.height * 0.45; canvas.dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.discoveredCount !== before.discoveredCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
