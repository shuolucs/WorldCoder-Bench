{
  "task_id": "P505_sound_reactive_sculpture_with_particle_e",
  "affordances": [
    {
      "id": "A1",
      "name": "XbotModel",
      "type": "3d_object",
      "semantic": "The loaded Xbot.glb humanoid sculpture at scene center",
      "locator_hints": [
        "window.__3D_STATE__.modelLoaded"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "2000 particles orbiting the model in toroidal pattern",
      "locator_hints": [
        "window.__3D_STATE__.particleCount"
      ]
    },
    {
      "id": "A3",
      "name": "HUDStatus",
      "type": "dom_element",
      "semantic": "Play/pause status display",
      "locator_hints": [
        "#hud-status"
      ]
    },
    {
      "id": "A4",
      "name": "ColorModeDisplay",
      "type": "dom_element",
      "semantic": "Current color mode display",
      "locator_hints": [
        "#color-mode-display"
      ]
    },
    {
      "id": "A5",
      "name": "BeatCounter",
      "type": "dom_element",
      "semantic": "Beat count display",
      "locator_hints": [
        "#beat-counter"
      ]
    },
    {
      "id": "A6",
      "name": "IntensityDisplay",
      "type": "dom_element",
      "semantic": "Intensity multiplier display",
      "locator_hints": [
        "#intensity-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.colorMode === 'spectrum'"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Playing",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.particleCount === 2000"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed_Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Color_Monochrome",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'monochrome'"
      ]
    },
    {
      "id": "S5",
      "name": "Color_Neon",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'neon'"
      ]
    },
    {
      "id": "S6",
      "name": "Color_Spectrum_Again",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'spectrum'"
      ]
    },
    {
      "id": "S7",
      "name": "Burst_Active",
      "conditions": [
        "window.__3D_STATE__.burstActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "Intensity_Increased",
      "conditions": [
        "window.__3D_STATE__.intensity > 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "Intensity_Decreased",
      "conditions": [
        "window.__3D_STATE__.intensity < 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.modelRotationY === 0",
        "window.__3D_STATE__.beatCount === 0",
        "window.__3D_STATE__.colorMode === 'spectrum'",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 2000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.length === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.every(f => f >= 0.0 && f <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleDistance >= 1.0 && window.__3D_STATE__.avgParticleDistance <= 5.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status').textContent.includes('PAUSED')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number' && !isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelScaleY >= 1.0 && window.__3D_STATE__.modelScaleY <= 1.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status').textContent.includes('PLAYING')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'monochrome'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('color-mode-display').textContent.toLowerCase().includes('monochrome')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.every(f => !isNaN(f))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'neon'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('color-mode-display').textContent.toLowerCase().includes('neon')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleDistance >= 1.0 && window.__3D_STATE__.avgParticleDistance <= 5.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.burstActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.every(f => f >= 0.0 && f <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScaleY >= 1.0 && window.__3D_STATE__.modelScaleY <= 1.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleDistance >= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intensity >= 1.1 && window.__3D_STATE__.intensity <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 1.1) < 0.01 || window.__3D_STATE__.intensity > 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('intensity-display').textContent.includes('1.1') || window.__3D_STATE__.intensity > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<15;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intensity < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity >= 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.every(f => typeof f === 'number' && !isNaN(f))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beatCount === 'number' && window.__3D_STATE__.beatCount >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelRotationY === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beatCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode === 'spectrum'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('color-mode-display').textContent.toLowerCase().includes('spectrum')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S10",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelRotationY > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies.every(f => f >= 0.0 && f <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleDistance >= 1.0 && window.__3D_STATE__.avgParticleDistance <= 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScaleY >= 1.0 && window.__3D_STATE__.modelScaleY <= 1.3",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}