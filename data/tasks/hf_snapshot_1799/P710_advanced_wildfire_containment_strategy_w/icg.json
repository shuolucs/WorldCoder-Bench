            "tier": "L0"
          },
          {
            "expr": "document.getElementById('windDir').textContent.toLowerCase().includes('east')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windDirection === 'string'",
            "tier": "L0"
          },
          {
