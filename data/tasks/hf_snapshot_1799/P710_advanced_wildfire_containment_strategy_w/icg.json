            "tier": "L0"
          },
          {
            "expr": "document.getElementById('currentTool').textContent.toUpperCase().includes('WATER')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection === 'east'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && window.__3D_STATE__.score >= 0",
            "tier": "L0"
