  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.fireCount === 3",
        "window.__3D_STATE__.grassCount === 397",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.resources === 200"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "FirebreakToolSelected",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'FIREBREAK'"
      ]
    },
    {
      "id": "S3",
      "name": "WaterToolSelected",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'WATER'"
      ]
    },
    {
      "id": "S4",
      "name": "WindChanged",
      "conditions": [
        "window.__3D_STATE__.windDirection !== 'north'"
      ]
    },
    {
      "id": "S5",
      "name": "FireSpreading",
      "conditions": [
        "window.__3D_STATE__.tickCount > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "FirebreakPlaced",
      "conditions": [
        "window.__3D_STATE__.firebreakCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.fireCount === 3",
        "window.__3D_STATE__.grassCount === 397",
        "window.__3D_STATE__.resources === 200"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.grid) && window.__3D_STATE__.grid.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.grid[0].length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fireCount + window.__3D_STATE__.grassCount + window.__3D_STATE__.burnedCount + window.__3D_STATE__.firebreakCount + window.__3D_STATE__.waterCount === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[5][5] === 'FIRE' && window.__3D_STATE__.grid[3][14] === 'FIRE' && window.__3D_STATE__.grid[15][10] === 'FIRE'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && !isNaN(window.__3D_STATE__.score)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number' && !isNaN(window.__3D_STATE__.tickCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.resources === 200",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus') !== null && document.getElementById('simStatus').textContent.toLowerCase().includes('run')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fireCount + window.__3D_STATE__.grassCount + window.__3D_STATE__.burnedCount + window.__3D_STATE__.firebreakCount + window.__3D_STATE__.waterCount === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fireCount >= 3 || window.__3D_STATE__.burnedCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grassCount <= 397",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S5",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'FIREBREAK'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('currentTool') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('currentTool').textContent.toUpperCase().includes('FIREBREAK')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.resources === 'number' && window.__3D_STATE__.resources >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
