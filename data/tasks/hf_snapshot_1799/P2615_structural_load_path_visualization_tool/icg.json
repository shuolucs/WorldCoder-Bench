{
  "task_id": "P2615_structural_load_path_visualization_tool",
  "affordances": [
    {
      "id": "A1",
      "name": "StructureAModel",
      "type": "3d_object",
      "semantic": "WaterBottle.glb model representing Structure A (column/support)",
      "locator_hints": [
        "position.x ≈ -3",
        "scaled ~8x"
      ]
    },
    {
      "id": "A2",
      "name": "StructureBModel",
      "type": "3d_object",
      "semantic": "Corset.glb model representing Structure B (beam/connector)",
      "locator_hints": [
        "position.x ≈ 3",
        "scaled ~3x"
      ]
    },
    {
      "id": "A3",
      "name": "LoadNodes",
      "type": "3d_object",
      "semantic": "10 small spheres representing load nodes on both structures",
      "locator_hints": [
        "radius ~0.15",
        "5 per structure"
      ]
    },
    {
      "id": "A4",
      "name": "LoadPathSegments",
      "type": "3d_object",
      "semantic": "Lines/tubes connecting nodes showing load transfer paths",
      "locator_hints": [
        "13 total segments",
        "color-coded by load"
      ]
    },
    {
      "id": "A5",
      "name": "TransferBeams",
      "type": "3d_object",
      "semantic": "5 horizontal connections between corresponding A and B nodes",
      "locator_hints": [
        "horizontal lines at each y level"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing selection and load stats",
      "locator_hints": [
        "position: absolute",
        "top-left"
      ]
    },
    {
      "id": "A7",
      "name": "WindLoadButton",
      "type": "dom_element",
      "semantic": "Button to apply wind load to top row nodes",
      "locator_hints": [
        "text contains 'Wind'"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all loads to zero",
      "locator_hints": [
        "text contains 'Reset'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.nodeCount === 10",
        "window.__3D_STATE__.totalSystemLoad === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Node_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId !== null",
        "typeof window.__3D_STATE__.selectedNodeLoad === 'number'"
      ]
    },
    {
      "id": "S2",
      "name": "Load_Applied_Single",
      "conditions": [
        "window.__3D_STATE__.totalSystemLoad > 0",
        "window.__3D_STATE__.propagationComplete === true"
      ]
    },
    {
      "id": "S3",
      "name": "Load_Propagated",
      "conditions": [
        "window.__3D_STATE__.structureAAvg > 0 || window.__3D_STATE__.structureBAvg > 0",
        "window.__3D_STATE__.propagationComplete === true"
      ]
    },
    {
      "id": "S4",
      "name": "Total_View_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'total_view'"
      ]
    },
    {
      "id": "S5",
      "name": "Gravity_Load_Applied",
      "conditions": [
        "window.__3D_STATE__.structureANodes[4].load >= 70",
        "window.__3D_STATE__.totalSystemLoad > 50"
      ]
    },
    {
      "id": "S6",
      "name": "Wind_Load_Applied",
      "conditions": [
        "window.__3D_STATE__.structureANodes[4].load > 0",
        "window.__3D_STATE__.structureBNodes[4].load > 0"
      ]
    },
    {
      "id": "S7",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.totalSystemLoad === 0",
        "window.__3D_STATE__.structureAAvg === 0",
        "window.__3D_STATE__.structureBAvg === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 10",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.structureANodes) && window.__3D_STATE__.structureANodes.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.structureBNodes) && window.__3D_STATE__.structureBNodes.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalSystemLoad === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.pathSegments === 13",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const nodes = document.querySelectorAll ? null : null; const ray = new THREE.Raycaster(); const cam = window.__scene__ ? window.__scene__.children.find(c => c.isCamera) : null; /* fallback: directly set selection */ if(window.__selectNode) { window.__selectNode('A2'); } else { window.__3D_STATE__.selectedNodeId = 'A2'; }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedNodeId === 'A2'",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedNodeLoad === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedNodeLoad === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.structureANodes[2].id === 'A2'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'normal'",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
