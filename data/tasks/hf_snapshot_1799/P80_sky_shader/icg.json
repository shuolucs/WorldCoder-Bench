      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "(function(){ const sp = window.__3D_STATE__.sunPosition; const el = window.__3D_STATE__.elevation * Math.PI / 180; const az = window.__3D_STATE__.azimuth * Math.PI / 180; const len = Math.sqrt(sp.x*sp.x + sp.y*sp.y + sp.z*sp.z); const ny = sp.y / len; return Math.abs(ny - Math.sin(el)) < 0.15; })()",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
