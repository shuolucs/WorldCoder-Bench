{
  "task_id": "P185_domino_chain_reaction_with_varied_spacin",
  "affordances": [
    {
      "id": "A1",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to push the first domino and start the chain reaction",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all dominoes to upright",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A3",
      "name": "DifficultySlider",
      "type": "dom_element",
      "semantic": "Slider to adjust difficulty (spacing multiplier)",
      "locator_hints": [
        "#difficultySlider"
      ]
    },
    {
      "id": "A4",
      "name": "DominoChain",
      "type": "3d_object",
      "semantic": "Array of 20 domino box meshes arranged in S-curve",
      "locator_hints": [
        "domino mesh",
        "BoxGeometry"
      ]
    },
    {
      "id": "A5",
      "name": "DragonModel",
      "type": "3d_object",
      "semantic": "Loaded DragonAttenuation.glb model as centerpiece",
      "locator_hints": [
        "GLTF model",
        "dragon"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing chain status",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A7",
      "name": "FallenCountDisplay",
      "type": "dom_element",
      "semantic": "Display showing number of fallen dominoes",
      "locator_hints": [
        "#fallenCount"
      ]
    },
    {
      "id": "A8",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Green ground plane for the scene",
      "locator_hints": [
        "PlaneGeometry",
        "ground"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.dominoCount === 20",
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.chainActive === false",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.difficulty === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "DragonLoaded",
      "conditions": [
        "window.__3D_STATE__.dragonLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "ChainStarted",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.chainActive === true",
        "window.__3D_STATE__.fallingCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Zone1Complete",
      "conditions": [
        "window.__3D_STATE__.zone1Complete === true",
        "window.__3D_STATE__.fallenCount >= 7"
      ]
    },
    {
      "id": "S4",
      "name": "Zone2Complete",
      "conditions": [
        "window.__3D_STATE__.zone2Complete === true",
        "window.__3D_STATE__.fallenCount >= 14"
      ]
    },
    {
      "id": "S5",
      "name": "ChainComplete",
      "conditions": [
        "window.__3D_STATE__.chainComplete === true",
        "window.__3D_STATE__.fallenCount === 20",
        "window.__3D_STATE__.zone3Complete === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetAfterComplete",
      "conditions": [
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.chainActive === false",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.chainComplete === false"
      ]
    },
    {
      "id": "S7",
      "name": "DifficultyChanged",
      "conditions": [
        "window.__3D_STATE__.difficulty !== 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dragonLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dragonPosition !== undefined && typeof window.__3D_STATE__.dragonPosition.x === 'number'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.dragonPosition.y)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.dominoRotations) && window.__3D_STATE__.dominoRotations.length === 20",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[0] > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastFallenIndex >= -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.zone1Complete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount >= 7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[0] >= 1.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[6] >= 1.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.slice(0,7).every(r => r >= 1.4)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.zone2Complete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount >= 14",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[13] >= 1.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zone3Complete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastFallenIndex === 19",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.every(r => r >= 1.4 && r <= 1.5 && !isNaN(r))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallingCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.every(r => r === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('difficultySlider').value = '1.5'; document.getElementById('difficultySlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 1.5 || Math.abs(window.__3D_STATE__.difficulty - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 1.5 || Math.abs(window.__3D_STATE__.difficulty - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[0] > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}