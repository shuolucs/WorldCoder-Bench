          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultTriangleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canUndo === true",
            "tier": "L2"
          },
          {
