{
  "task_id": "P2162_mesh_boolean_operations_csg_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "The loaded horse.glb mesh serving as operandA for CSG operations",
