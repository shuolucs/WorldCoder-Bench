        "operandA"
      ]
    },
    {
      "id": "A2",
      "name": "OperandBWireframe",
      "type": "3d_object",
      "semantic": "Wireframe overlay of the primitive shape used as operandB",
      "locator_hints": [
        "wireframe mesh",
        "operandB",
        "green wireframe"
      ]
    },
    {
      "id": "A3",
      "name": "ResultMesh",
      "type": "3d_object",
      "semantic": "The result mesh produced after applying a CSG boolean operation",
      "locator_hints": [
        "result mesh",
        "pink/magenta material"
      ]
    },
    {
      "id": "A4",
