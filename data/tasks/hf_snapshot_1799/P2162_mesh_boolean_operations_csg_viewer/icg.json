      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBPosition.x - 0.6) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBPosition.y - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBPosition.z - 0.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.operandBPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.operandBPosition.y)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
