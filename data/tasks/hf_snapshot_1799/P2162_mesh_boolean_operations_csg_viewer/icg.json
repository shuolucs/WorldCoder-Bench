    {
      "id": "A12",
      "name": "LblHistory",
      "type": "dom_element",
      "semantic": "Label showing history stack position",
      "locator_hints": [
        "#lbl-history"
      ]
    },
    {
      "id": "A13",
      "name": "HudOpBPos",
      "type": "dom_element",
      "semantic": "HUD showing operandB position",
      "locator_hints": [
        "#hud-opb-pos"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoading",
      "conditions": [
        "window.__3D_STATE__.sceneReady === false || window.__3D_STATE__.horseLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "SceneReady_DefaultState",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.horseLoaded === true",
        "window.__3D_STATE__.operationMode === 'union'",
        "window.__3D_STATE__.operandBPrimitive === 'box'",
        "window.__3D_STATE__.operationsApplied === 0"
      ]
    },
    {
      "id": "S2",
      "name": "SubtractModeSelected",
      "conditions": [
        "window.__3D_STATE__.operationMode === 'subtract'"
      ]
    },
    {
      "id": "S3",
      "name": "OperandBMoved",
      "conditions": [
        "window.__3D_STATE__.operandBPosition.x !== 0 || window.__3D_STATE__.operandBPosition.z !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "FirstOperationApplied",
      "conditions": [
        "window.__3D_STATE__.operationsApplied === 1",
        "window.__3D_STATE__.historyLength >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "OperandBScaled",
      "conditions": [
        "Math.abs(window.__3D_STATE__.operandBScale - 1.0) > 0.05"
      ]
    },
    {
      "id": "S6",
      "name": "SecondOperationApplied",
      "conditions": [
        "window.__3D_STATE__.operationsApplied === 2",
        "window.__3D_STATE__.historyLength >= 3"
      ]
    },
    {
      "id": "S7",
      "name": "UndoneOnce",
      "conditions": [
        "window.__3D_STATE__.canRedo === true",
        "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S8",
      "name": "RedoneOnce",
      "conditions": [
        "window.__3D_STATE__.canRedo === false || window.__3D_STATE__.historyIndex === window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S9",
      "name": "PrimitiveChanged",
      "conditions": [
        "window.__3D_STATE__.operandBPrimitive !== 'box'"
      ]
    },
    {
      "id": "S10",
      "name": "IntersectApplied",
      "conditions": [
        "window.__3D_STATE__.operationMode === 'intersect'",
        "window.__3D_STATE__.operationsApplied >= 3"
      ]
    },
    {
      "id": "S11",
      "name": "OperandBReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.operandBPosition.x) < 0.01",
        "Math.abs(window.__3D_STATE__.operandBPosition.y - 1.5) < 0.01",
        "Math.abs(window.__3D_STATE__.operandBScale - 1.0) < 0.01"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.originalVertexCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operationMode === 'union'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operandBPrimitive === 'box'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-subtract"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.operationMode === 'subtract'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operationsApplied === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.operandBPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.operandBPosition !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBPosition.y - 1.5) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "repeat": 3
