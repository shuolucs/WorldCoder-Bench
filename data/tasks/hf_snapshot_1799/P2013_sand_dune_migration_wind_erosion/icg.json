{
  "task_id": "P2013_sand_dune_migration_wind_erosion",
  "affordances": [
    {
      "id": "A1",
      "name": "SandTerrain",
      "type": "3d_object",
      "semantic": "Subdivided plane mesh whose vertex Y-values form the sand heightfield with dune shapes",
      "locator_hints": [
        "geometry with 64x64+ subdivisions",
        "sand-colored material"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button that resets simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A3",
      "name": "SandstormButton",
      "type": "dom_element",
      "semantic": "Button that triggers a temporary sandstorm with doubled erosion",
      "locator_hints": [
        "#sandstormBtn"
      ]
    },
    {
      "id": "A4",
      "name": "HUD_WindSpeed",
      "type": "dom_element",
      "semantic": "Displays current wind speed value",
      "locator_hints": [
        "#hudWindSpeed"
      ]
    },
    {
      "id": "A5",
      "name": "HUD_WindAngle",
      "type": "dom_element",
      "semantic": "Displays current wind angle in degrees",
      "locator_hints": [
        "#hudWindAngle"
      ]
    },
    {
      "id": "A6",
      "name": "HUD_Volume",
      "type": "dom_element",
      "semantic": "Displays total sand volume",
      "locator_hints": [
        "#hudVolume"
      ]
    },
    {
      "id": "A7",
      "name": "HUD_Status",
      "type": "dom_element",
      "semantic": "Displays Paused or Running",
      "locator_hints": [
        "#hudStatus"
      ]
    },
    {
      "id": "A8",
      "name": "HUD_Tick",
      "type": "dom_element",
      "semantic": "Displays simulation tick count",
      "locator_hints": [
        "#hudTick"
      ]
    },
    {
      "id": "A9",
      "name": "HUD_DuneCount",
      "type": "dom_element",
      "semantic": "Displays number of tracked dunes",
      "locator_hints": [
        "#hudDuneCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.windSpeed === 5",
        "window.__3D_STATE__.duneCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.tickCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "WindSpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.windSpeed > 5"
      ]
    },
    {
      "id": "S3",
      "name": "WindDirectionChanged",
      "conditions": [
        "window.__3D_STATE__.windAngleDeg !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "SandstormActive",
      "conditions": [
        "window.__3D_STATE__.sandstormActive === true",
        "window.__3D_STATE__.erosionRate === 0.04"
      ]
    },
    {
      "id": "S5",
      "name": "PostSandstorm",
      "conditions": [
        "window.__3D_STATE__.sandstormActive === false",
        "window.__3D_STATE__.tickCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AfterSimulationRun",
      "conditions": [
        "window.__3D_STATE__.tickCount > 60"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.windSpeed === 5"
      ]
    },
    {
      "id": "S8",
      "name": "WindSpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.windSpeed < 5"
      ]
    },
    {
      "id": "S9",
      "name": "SimPausedAfterRun",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.tickCount > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simRunning === 'boolean' && window.__3D_STATE__.simRunning === false",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalVolume === 'number' && window.__3D_STATE__.totalVolume > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.initialVolume === 'number' && window.__3D_STATE__.initialVolume > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.duneCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false && window.__3D_STATE__.vertexCount >= 4096",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudStatus') !== null && document.getElementById('hudStatus').textContent.toLowerCase().includes('running')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number' && window.__3D_STATE__.tickCount >= 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windAngleDeg === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeConservationError < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalVolume - window.__3D_STATE__.initialVolume) / window.__3D_STATE__.initialVolume < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S6",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 60",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudStatus') !== null && document.getElementById('hudStatus').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeConservationError < 0.02",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S9",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windSpeed === 6",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudWindSpeed') !== null && document.getElementById('hudWindSpeed').textContent.includes('6')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed >= 0 && window.__3D_STATE__.windSpeed <= 15",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windAngleDeg === 15 || window.__3D_STATE__.windAngleDeg === -15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudWindAngle') !== null && document.getElementById('hudWindAngle').textContent.includes('15')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windAngleDeg === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#sandstormBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sandstormActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionRate === 0.04",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sandstormActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sandstormActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionRate === 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed !== 15 || window.__3D_STATE__.sandstormActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeConservationError < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windAngleDeg === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duneCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalVolume - window.__3D_STATE__.initialVolume) / window.__3D_STATE__.initialVolume < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windSpeed === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed >= 0 && window.__3D_STATE__.windSpeed <= 15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudWindSpeed') !== null && document.getElementById('hudWindSpeed').textContent.includes('4')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasNaN === false",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}