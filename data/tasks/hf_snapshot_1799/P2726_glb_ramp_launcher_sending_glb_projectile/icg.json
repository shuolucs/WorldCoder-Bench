  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelsLoaded.skull === true",
        "window.__3D_STATE__.modelsLoaded.dish === true"
      ]
    },
    {
      "id": "S1",
      "name": "Ready",
      "conditions": [
        "window.__3D_STATE__.status === 'READY'",
        "window.__3D_STATE__.isLaunched === false",
        "window.__3D_STATE__.launchPower === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Charging",
      "conditions": [
        "window.__3D_STATE__.status === 'CHARGING'",
        "window.__3D_STATE__.isCharging === true",
        "window.__3D_STATE__.launchPower > 0"
      ]
    },
    {
      "id": "S3",
      "name": "InFlight",
      "conditions": [
        "window.__3D_STATE__.status === 'IN_FLIGHT'",
        "window.__3D_STATE__.isLaunched === true",
        "window.__3D_STATE__.isLanded === false"
      ]
    },
    {
      "id": "S4",
      "name": "Landed",
      "conditions": [
        "window.__3D_STATE__.status === 'LANDED'",
        "window.__3D_STATE__.isLanded === true",
        "window.__3D_STATE__.currentSpeed === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Hit",
      "conditions": [
        "window.__3D_STATE__.status === 'HIT'",
        "window.__3D_STATE__.isHit === true",
        "window.__3D_STATE__.isLanded === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetAfterLaunch",
      "conditions": [
        "window.__3D_STATE__.status === 'READY'",
        "window.__3D_STATE__.launchCount >= 1",
        "window.__3D_STATE__.isLaunched === false"
      ]
    },
    {
      "id": "S7",
      "name": "ChaseCameraActive",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'chase'"
      ]
    },
    {
      "id": "S8",
      "name": "FixedCameraRestored",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'fixed'"
      ]
    }
  ],
