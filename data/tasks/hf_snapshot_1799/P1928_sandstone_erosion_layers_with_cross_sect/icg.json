  "states": [
    {
      "id": "S0",
      "name": "Initial_Pristine",
      "conditions": [
        "window.__3D_STATE__.erosionLevel === 0",
        "window.__3D_STATE__.layerCount === 6",
        "window.__3D_STATE__.crossSectionActive === false",
        "window.__3D_STATE__.selectedLayer === -1",
        "window.__3D_STATE__.windDirection === 'None'"
      ]
    },
    {
      "id": "S1",
      "name": "Mild_Erosion",
      "conditions": [
        "window.__3D_STATE__.erosionLevel === 30",
        "window.__3D_STATE__.layerCount >= 4"
      ]
    },
    {
      "id": "S2",
      "name": "CrossSection_Active",
      "conditions": [
        "window.__3D_STATE__.crossSectionActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "Layer_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedLayer >= 0",
        "window.__3D_STATE__.selectedLayerName !== ''"
      ]
    },
    {
      "id": "S4",
      "name": "Wind_Active",
      "conditions": [
        "window.__3D_STATE__.windDirection !== 'None'"
      ]
    },
    {
      "id": "S5",
      "name": "Heavy_Erosion",
      "conditions": [
        "window.__3D_STATE__.erosionLevel === 75",
        "window.__3D_STATE__.layerCount <= 4"
      ]
    },
    {
      "id": "S6",
      "name": "Max_Erosion",
      "conditions": [
        "window.__3D_STATE__.erosionLevel === 100",
        "window.__3D_STATE__.layerCount <= 4"
      ]
    },
    {
      "id": "S7",
      "name": "Wind_With_Erosion",
      "conditions": [
        "window.__3D_STATE__.windDirection !== 'None'",
        "window.__3D_STATE__.erosionLevel > 0"
      ]
    },
    {
      "id": "S8",
      "name": "CrossSection_Disabled",
      "conditions": [
        "window.__3D_STATE__.crossSectionActive === false"
      ]
    },
    {
      "id": "S9",
      "name": "Erosion_Reset",
      "conditions": [
        "window.__3D_STATE__.erosionLevel === 0",
        "window.__3D_STATE__.layerCount === 6"
      ]
    }
  ],
