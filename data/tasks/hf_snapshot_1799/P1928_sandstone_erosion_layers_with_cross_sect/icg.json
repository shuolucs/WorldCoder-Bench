        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerRadii) && window.__3D_STATE__.layerRadii.length === 6",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerVisibility) && window.__3D_STATE__.layerVisibility.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layerVisibility.every(v => v === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerRadii.every(r => typeof r === 'number' && !isNaN(r) && r > 2.0)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalVisibleVolume === 'number' && window.__3D_STATE__.totalVisibleVolume > 0",
