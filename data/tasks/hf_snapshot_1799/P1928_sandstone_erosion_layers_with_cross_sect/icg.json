            "expr": "window.__3D_STATE__.layerRadii[4] < window.__3D_STATE__.layerRadii[1]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerRadii.every(r => r >= 0 && !isNaN(r))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerRadii[0] > window.__3D_STATE__.layerRadii[5]",
            "tier": "L2"
          }
