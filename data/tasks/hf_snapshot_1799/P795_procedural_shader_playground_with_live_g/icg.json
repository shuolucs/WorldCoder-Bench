{
  "task_id": "P795_procedural_shader_playground_with_live_g",
  "affordances": [
    {
      "id": "A1",
      "name": "ShaderQuad",
      "type": "3d_object",
      "semantic": "Full-screen quad displaying the procedural shader output",
      "locator_hints": [
        "scene.children mesh with PlaneGeometry or PlaneBufferGeometry"
      ]
    },
    {
      "id": "A2",
      "name": "ShaderEditor",
      "type": "dom_element",
      "semantic": "Textarea for editing GLSL fragment shader code",
      "locator_hints": [
        "#shader-editor"
      ]
    },
    {
      "id": "A3",
      "name": "CompileButton",
      "type": "dom_element",
      "semantic": "Button to compile the current shader code",
      "locator_hints": [
        "#btn-compile"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset shader to default",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "PresetSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select preset shaders",
      "locator_hints": [
        "#preset-select"
      ]
    },
    {
      "id": "A6",
      "name": "StatusBar",
      "type": "dom_element",
      "semantic": "Status display for compilation results",
      "locator_hints": [
        "#status-bar"
      ]
    },
    {
      "id": "A7",
      "name": "AnimateCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox to toggle animation on/off",
      "locator_hints": [
        "#chk-animate"
      ]
    },
    {
      "id": "A8",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling animation speed",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A9",
      "name": "FPSDisplay",
      "type": "dom_element",
      "semantic": "FPS counter display",
      "locator_hints": [
        "#fps-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Default_Shader",
      "conditions": [
        "window.__3D_STATE__.shaderCompiled === true",
        "window.__3D_STATE__.currentPreset === 'default'",
        "window.__3D_STATE__.animating === true",
        "window.__3D_STATE__.animationSpeed === 1.0",
        "window.__3D_STATE__.compilationCount >= 0"
      ]
    },
    {
      "id": "S1",
      "name": "Animation_Paused",
      "conditions": [
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S2",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.animationSpeed !== 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "Preset_Circles_Active",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'circles'",
        "window.__3D_STATE__.shaderCompiled === true"
      ]
    },
    {
      "id": "S4",
      "name": "Preset_Noise_Active",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'noise'",
        "window.__3D_STATE__.shaderCompiled === true"
      ]
    },
    {
      "id": "S5",
      "name": "Custom_Shader_Compiled",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'custom'",
        "window.__3D_STATE__.shaderCompiled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Compilation_Failed",
      "conditions": [
        "window.__3D_STATE__.errorMessage.length > 0",
        "window.__3D_STATE__.failedCompilations > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_To_Default",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'default'",
        "window.__3D_STATE__.shaderCompiled === true"
      ]
    },
    {
      "id": "S8",
      "name": "Time_Advancing_After_Resume",
      "conditions": [
        "window.__3D_STATE__.animating === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Preset_Plasma_With_Speed",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'plasma'",
        "window.__3D_STATE__.animationSpeed > 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quadVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'default'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === true && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0 && isFinite(window.__3D_STATE__.fps)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#chk-animate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quadVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const t0 = window.__3D_STATE__.elapsedTime; window.__T3_frozenTime = t0; await new Promise(r => setTimeout(r, 800));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.elapsedTime - window.__T3_frozenTime) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('chk-animate').click(); const slider = document.getElementById('slider-speed'); const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '3.0'); slider.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animating === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationSpeed - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationSpeed >= 0.1 && window.__3D_STATE__.animationSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_prevCompileCount = window.__3D_STATE__.compilationCount; const sel = document.getElementById('preset-select'); sel.value = 'circles'; sel.dispatchEvent(new Event('change', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'circles'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationCount > window.__T5_prevCompileCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorContent.includes('distance') || window.__3D_STATE__.editorContent.includes('length')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.statusText.toLowerCase().includes('ok') || window.__3D_STATE__.statusText.toLowerCase().includes('compiled') || window.__3D_STATE__.statusText.toLowerCase().includes('success')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T6_prevCompileCount = window.__3D_STATE__.compilationCount; const sel = document.getElementById('preset-select'); sel.value = 'noise'; sel.dispatchEvent(new Event('change', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'noise'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationCount > window.__T6_prevCompileCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorContent.includes('fract') || window.__3D_STATE__.editorContent.includes('sin')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage === ''",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T7_prevFailed = window.__3D_STATE__.failedCompilations; window.__T7_prevSuccess = window.__3D_STATE__.compilationCount; const editor = document.getElementById('shader-editor'); editor.value = 'void main() { gl_FragColor = INVALID_SYNTAX; }'; editor.dispatchEvent(new Event('input', {bubbles: true})); document.getElementById('btn-compile').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.failedCompilations > window.__T7_prevFailed",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationCount === window.__T7_prevSuccess",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quadVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.statusText.length > 0 && !window.__3D_STATE__.statusText.toLowerCase().includes('ok')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T8_prevCompile = window.__3D_STATE__.compilationCount; const editor = document.getElementById('shader-editor'); editor.value = 'uniform float u_time;\\nvarying vec2 vUv;\\nvoid main() {\\n  float r = sin(vUv.x * 20.0 + u_time) * 0.5 + 0.5;\\n  gl_FragColor = vec4(r, 0.2, 0.8, 1.0);\\n}'; editor.dispatchEvent(new Event('input', {bubbles: true})); document.getElementById('btn-compile').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationCount > window.__T8_prevCompile",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage === ''",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'default'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorContent.includes('u_time')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorContent.includes('sin')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage === ''",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quadVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T10_prevCompile = window.__3D_STATE__.compilationCount; const slider = document.getElementById('slider-speed'); const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '4.5'); slider.dispatchEvent(new Event('input', {bubbles: true})); const sel = document.getElementById('preset-select'); sel.value = 'plasma'; sel.dispatchEvent(new Event('change', {bubbles: true})); await new Promise(r => setTimeout(r, 500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'plasma'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationSpeed - 4.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationCount > window.__T10_prevCompile",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0 && isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsActive === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}