{
  "task_id": "P533_verlet_rope_bridge",
  "affordances": [
    {"id": "A1", "name": "RopeParticles", "type": "3d_object", "semantic": "30 particles forming the rope bridge", "locator_hints": ["sphere meshes in scene"]},
    {"id": "A2", "name": "RopeSegments", "type": "3d_object", "semantic": "Cylinders/lines connecting particles", "locator_hints": ["cylinder or line meshes"]},
    {"id": "A3", "name": "Pillars", "type": "3d_object", "semantic": "Two anchor pillars", "locator_hints": ["cylinder meshes at x=-15 and x=15"]},
    {"id": "A4", "name": "GravitySlider", "type": "dom_element", "semantic": "Gravity control", "locator_hints": ["#slider-gravity"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.particleCount === 30", "window.__3D_STATE__.isIntact === true", "window.__3D_STATE__.hasWeight === false"]},
    {"id": "S1", "name": "Sagging", "conditions": ["window.__3D_STATE__.bridgeSag > 0"]},
    {"id": "S2", "name": "Weighted", "conditions": ["window.__3D_STATE__.hasWeight === true"]},
    {"id": "S3", "name": "Snapped", "conditions": ["window.__3D_STATE__.isIntact === false"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.isIntact === true", "window.__3D_STATE__.hasWeight === false"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 30", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bridgeSag > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "w"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.hasWeight === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-weight').textContent.includes('Yes')", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bridgeSag > 1.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lowestParticleY < 5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P1",
      "action": {"type": "keyboard", "key": "q"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.hasWeight === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-weight').textContent.includes('No')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isIntact === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-intact').textContent.includes('No')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lowestParticleY < before.lowestParticleY", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isIntact === true", "tier": "L2"},
        {"expr": "window.__3D_STATE__.hasWeight === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-intact').textContent.includes('Yes')", "tier": "L2"}
      ]}
    }
  ]
}
