  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 1",
        "window.__3D_STATE__.turnNumber === 1",
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.player1Score === 0",
        "window.__3D_STATE__.player2Score === 0",
        "window.__3D_STATE__.population === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ResidentialSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'residential'"
      ]
    },
    {
      "id": "S2",
      "name": "FirstBuildingPlaced",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 1",
        "window.__3D_STATE__.currentPlayer === 2",
        "window.__3D_STATE__.turnNumber === 2"
      ]
    },
    {
      "id": "S3",
      "name": "SecondBuildingPlaced",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 2",
        "window.__3D_STATE__.currentPlayer === 1",
        "window.__3D_STATE__.turnNumber === 3"
      ]
    },
    {
      "id": "S4",
      "name": "ParkPlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCounts.park >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "AdjacencyBonusEarned",
      "conditions": [
        "window.__3D_STATE__.player1Score > 10 || window.__3D_STATE__.player2Score > 10"
      ]
    },
    {
      "id": "S6",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.canUndo === false"
      ]
    },
    {
      "id": "S7",
      "name": "CommercialAndRoadPlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCounts.commercial >= 1",
        "window.__3D_STATE__.buildingCounts.road >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleBuildings",
      "conditions": [
        "window.__3D_STATE__.totalBuildings >= 5"
      ]
    },
    {
      "id": "S9",
      "name": "CityReset",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.turnNumber === 1",
        "window.__3D_STATE__.player1Score === 0",
        "window.__3D_STATE__.player2Score === 0"
      ]
    }
  ],
