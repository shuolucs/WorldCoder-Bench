{
  "task_id": "P309_population_density_globe_with_particle_e",
  "affordances": [
    {
      "id": "A1",
      "name": "Globe",
      "type": "3d_object",
      "semantic": "Wireframe sphere representing Earth",
      "locator_hints": [
        "wireframe sphere at origin",
        "radius 1.5"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "2000 colored particles on globe surface representing population density",
      "locator_hints": [
        "THREE.Points object",
        "2000 particles"
      ]
    },
    {
      "id": "A3",
      "name": "CorsetMarker",
      "type": "3d_object",
      "semantic": "Loaded Corset.glb model as a data-station marker on the globe",
      "locator_hints": [
        "name: corsetMarker",
        "position (1.5, 0, 0)"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleRotateButton",
      "type": "dom_element",
      "semantic": "Button to toggle auto-rotation",
      "locator_hints": [
        "#btnToggleRotate"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleParticlesButton",
      "type": "dom_element",
      "semantic": "Button to toggle particle visibility",
      "locator_hints": [
        "#btnToggleParticles"
      ]
    },
    {
      "id": "A6",
      "name": "ResetViewButton",
      "type": "dom_element",
      "semantic": "Button to reset camera to initial position",
      "locator_hints": [
        "#btnResetView"
      ]
    },
    {
      "id": "A7",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing particle count and rotation status",
      "locator_hints": [
        "#statsPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.particleCount === 2000",
        "window.__3D_STATE__.globeExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "RotationDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S3",
      "name": "ParticlesRestored",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S4",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraY - 2) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraZ - 5) < 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "!isNaN(window.__3D_STATE__.cameraX)",
        "!isNaN(window.__3D_STATE__.cameraY)",
        "!isNaN(window.__3D_STATE__.cameraZ)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particlesVisible !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.autoRotate !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraX !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particlesVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
