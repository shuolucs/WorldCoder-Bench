            "expr": "window.__3D_STATE__.particleCount !== before.particleCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && !isNaN(window.__3D_STATE__.particleCount)",
