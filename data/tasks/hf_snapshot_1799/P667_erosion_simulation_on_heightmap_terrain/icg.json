          },
          {
            "expr": "window.__3D_STATE__.heightmapChecksum !== window.__test_preRedoChecksum",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapChecksum === window.__test_preUndoChecksum",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEroded - window.__3D_STATE__.totalDeposited) / Math.max(window.__3D_STATE__.totalEroded, 0.001) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sel = document.getElementById('select-preset'); sel.value = 'mountain'; sel.dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPreset === 'mountain'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionSteps === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEroded === 0 && window.__3D_STATE__.totalDeposited === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmap instanceof Float32Array && window.__3D_STATE__.heightmap.length === 16384",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__test_preRunSteps = window.__3D_STATE__.erosionSteps; document.getElementById('btn-run').click();"
