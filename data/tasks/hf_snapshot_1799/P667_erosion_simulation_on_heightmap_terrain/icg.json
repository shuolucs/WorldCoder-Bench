      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__test_preUndoSteps = window.__3D_STATE__.erosionSteps; window.__test_preUndoChecksum = window.__3D_STATE__.heightmapChecksum; document.getElementById('btn-undo').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.erosionSteps === window.__test_preUndoSteps - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapChecksum !== window.__test_preUndoChecksum",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!Array.from(window.__3D_STATE__.heightmap).some(v => isNaN(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__test_preRedoSteps = window.__3D_STATE__.erosionSteps; window.__test_preRedoChecksum = window.__3D_STATE__.heightmapChecksum; document.getElementById('btn-redo').click();"
