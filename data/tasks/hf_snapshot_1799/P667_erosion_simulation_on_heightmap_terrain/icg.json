{
  "task_id": "P667_erosion_simulation_on_heightmap_terrain",
  "affordances": [
    {
      "id": "A1",
      "name": "TerrainMesh",
      "type": "3d_object",
      "semantic": "128x128 heightmap terrain grid with vertex colors",
      "locator_hints": [
