      "semantic": "HUD overlay showing simulation stats",
      "locator_hints": [
        "top-left panel",
        "div with erosion stats"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.erosionSteps === 0",
        "window.__3D_STATE__.totalEroded === 0",
        "window.__3D_STATE__.totalDeposited === 0",
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S1",
      "name": "AfterOneStep",
      "conditions": [
        "window.__3D_STATE__.erosionSteps === 1",
        "window.__3D_STATE__.totalEroded > 0"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMultipleSteps",
      "conditions": [
        "window.__3D_STATE__.erosionSteps >= 3"
      ]
    },
    {
      "id": "S3",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "SlopeColorMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'slope'"
      ]
    },
    {
      "id": "S5",
      "name": "MountainPreset",
      "conditions": [
        "window.__3D_STATE__.selectedPreset === 'mountain'",
        "window.__3D_STATE__.erosionSteps === 0"
      ]
    },
    {
      "id": "S6",
      "name": "AfterUndone",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "AfterRedone",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S8",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S9",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.erosionSteps > 0"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.erosionSteps === 0",
        "window.__3D_STATE__.totalEroded === 0"
      ]
    },
    {
      "id": "S11",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.simulationSpeed >= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridSize === 128",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmap instanceof Float32Array && window.__3D_STATE__.heightmap.length === 128 * 128",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionSteps === 0 && window.__3D_STATE__.totalEroded === 0 && window.__3D_STATE__.totalDeposited === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 30 && window.__3D_STATE__.maxHeight > window.__3D_STATE__.minHeight",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.erosionSteps === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEroded > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDeposited > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEroded - window.__3D_STATE__.totalDeposited) / Math.max(window.__3D_STATE__.totalEroded, 0.001) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!Array.from(window.__3D_STATE__.heightmap).some(v => isNaN(v))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevChecksum = window.__3D_STATE__.heightmapChecksum; document.getElementById('btn-step').click(); document.getElementById('btn-step').click(); window.__test_prevChecksum = prevChecksum;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.erosionSteps === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapChecksum !== window.__test_prevChecksum",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meanHeight > 0 && window.__3D_STATE__.meanHeight < 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionSteps === 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.wireframeEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sel = document.getElementById('select-colormode'); sel.value = 'slope'; sel.dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'slope'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('select-colormode').value === 'slope'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionSteps === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
