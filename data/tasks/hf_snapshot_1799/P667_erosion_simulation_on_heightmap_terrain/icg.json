            "expr": "window.__3D_STATE__.erosionSteps === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEroded === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDeposited === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minHeight >= 0 && window.__3D_STATE__.maxHeight <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0 && window.__3D_STATE__.redoStackSize === 0",
