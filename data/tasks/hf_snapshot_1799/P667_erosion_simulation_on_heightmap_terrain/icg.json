          },
          {
            "expr": "typeof window.__3D_STATE__.simulationSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dropletsPerStep >= 100 && window.__3D_STATE__.dropletsPerStep <= 2000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 1500)); window.__test_runningSteps = window.__3D_STATE__.erosionSteps; document.getElementById('btn-run').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.erosionSteps > window.__test_preRunSteps",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEroded > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEroded - window.__3D_STATE__.totalDeposited) / Math.max(window.__3D_STATE__.totalEroded, 0.001) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "!Array.from(window.__3D_STATE__.heightmap).some(v => isNaN(v))",
            "tier": "L2"
          }
