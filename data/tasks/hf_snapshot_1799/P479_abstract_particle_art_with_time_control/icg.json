{
  "task_id": "P479_abstract_particle_art_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "The main particle system with 2000 particles animated by flow field",
      "locator_hints": [
        "scene.children with type Points",
        "geometry with 2000 vertices"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing simulation stats",
      "locator_hints": [
        "div in top-left corner",
        "contains timeScale and palette info"
      ]
    },
    {
      "id": "A3",
      "name": "TimeBar",
      "type": "dom_element",
      "semantic": "Bottom bar showing timeScale visually",
      "locator_hints": [
        "id='timeBar'",
        "horizontal bar at bottom"
      ]
    },
    {
      "id": "A4",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "Perspective camera that can orbit or stay static",
      "locator_hints": [
        "PerspectiveCamera at z=80"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 2000",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.palette === 'galaxy'",
        "window.__3D_STATE__.bloomEnabled === false",
        "window.__3D_STATE__.cameraMode === 'static'"
      ]
    },
    {
      "id": "S1",
      "name": "TimeSpedUp",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.timeScale === 0"
      ]
    },
    {
      "id": "S3",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.timeScale > 0"
      ]
    },
    {
      "id": "S4",
      "name": "PaletteChanged",
      "conditions": [
        "window.__3D_STATE__.palette === 'fire'"
      ]
    },
    {
      "id": "S5",
      "name": "BloomEnabled",
      "conditions": [
        "window.__3D_STATE__.bloomEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "AfterExplosion",
      "conditions": [
        "window.__3D_STATE__.explosionCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "CameraOrbiting",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'orbit'"
      ]
    },
    {
      "id": "S8",
      "name": "ReverseTime",
      "conditions": [
        "window.__3D_STATE__.timeScale < 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.explosionCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ArrowUp !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ArrowDown !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Space !== undefined",
