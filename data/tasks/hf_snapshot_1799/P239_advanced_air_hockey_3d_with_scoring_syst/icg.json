  "states": [
    {
      "id": "S0",
      "name": "Initial_PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.playerScore === 0",
        "window.__3D_STATE__.aiScore === 0",
        "window.__3D_STATE__.gamePaused === false"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Running",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gamePaused === false",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S2",
      "name": "Game_Paused",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gamePaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Game_Resumed",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gamePaused === false",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S4",
      "name": "Goal_Scored",
      "conditions": [
        "window.__3D_STATE__.playerScore + window.__3D_STATE__.aiScore > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Puck_Moving",
      "conditions": [
        "window.__3D_STATE__.puckSpeed > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.playerScore === 0",
        "window.__3D_STATE__.aiScore === 0",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.winner !== null"
      ]
    }
  ],
