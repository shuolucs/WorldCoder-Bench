        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.clickSeedCount === 0",
        "window.__3D_STATE__.randomSeedCount === 0"
      ]
    },
    {
      "id": "S11",
      "name": "MassConserved",
