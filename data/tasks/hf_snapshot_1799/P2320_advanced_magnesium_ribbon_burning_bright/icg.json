      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.phase === 'string' && window.__3D_STATE__.phase === 'SETUP'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number' && window.__3D_STATE__.temperature === 25",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && window.__3D_STATE__.score === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxScore === 60",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.completedSteps) && window.__3D_STATE__.completedSteps.length === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ribbonScale === 1.0 && window.__3D_STATE__.mgMassRemaining === 2.43",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature) && !isNaN(window.__3D_STATE__.burnElapsed)",
            "tier": "L2"
          }
        ]
      }
    },
