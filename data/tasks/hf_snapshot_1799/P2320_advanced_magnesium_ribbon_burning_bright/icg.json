  "states": [
    {
      "id": "S0",
      "name": "InitialSetup",
      "conditions": [
        "window.__3D_STATE__.phase === 'SETUP'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.goggleOn === false",
        "window.__3D_STATE__.burnerLit === false"
      ]
    },
    {
      "id": "S1",
      "name": "GogglesOn",
      "conditions": [
        "window.__3D_STATE__.goggleOn === true",
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.phase === 'SETUP'"
      ]
    },
    {
      "id": "S2",
      "name": "BurnerLit",
      "conditions": [
        "window.__3D_STATE__.burnerLit === true",
        "window.__3D_STATE__.phase === 'BURNER_LIT'",
        "window.__3D_STATE__.score >= 20"
      ]
    },
    {
      "id": "S3",
      "name": "RibbonPlacedBurning",
      "conditions": [
        "window.__3D_STATE__.ribbonPlaced === true",
        "window.__3D_STATE__.phase === 'BURNING' || window.__3D_STATE__.phase === 'PEAK'",
        "window.__3D_STATE__.temperature > 25"
      ]
    },
    {
      "id": "S4",
      "name": "PeakBrightness",
      "conditions": [
        "window.__3D_STATE__.temperature > 1500",
        "window.__3D_STATE__.brightLightIntensity > 3.0",
        "window.__3D_STATE__.phase === 'PEAK'"
      ]
    },
    {
      "id": "S5",
      "name": "LookedAway",
      "conditions": [
        "window.__3D_STATE__.lookedAway === true",
        "window.__3D_STATE__.score >= 50"
      ]
    },
    {
      "id": "S6",
      "name": "BurnComplete",
      "conditions": [
        "window.__3D_STATE__.burnComplete === true",
        "window.__3D_STATE__.phase === 'COMPLETE'",
        "window.__3D_STATE__.ribbonScale <= 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "ObservationRecorded",
      "conditions": [
        "window.__3D_STATE__.recorded === true",
        "window.__3D_STATE__.score === 60",
        "window.__3D_STATE__.phase === 'COMPLETE'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
