      ]
    },
    {
      "id": "A6",
      "name": "NodeLabels",
      "type": "3d_object",
      "semantic": "Text sprite labels above each node",
      "locator_hints": [
        "Sprite objects above nodes"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing network stats",
      "locator_hints": [
        "div in top-left corner"
      ]
    },
    {
      "id": "A8",
      "name": "TrafficButton",
      "type": "dom_element",
      "semantic": "Button to toggle traffic animation",
      "locator_hints": [
        "#btn-toggle-traffic"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 7",
        "window.__3D_STATE__.edgeCount === 8",
        "window.__3D_STATE__.selectedNode === null",
        "window.__3D_STATE__.trafficActive === false",
        "window.__3D_STATE__.currentLayout === 'hexagonal'",
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNode !== null",
        "window.__3D_STATE__.selectedNode >= 0 && window.__3D_STATE__.selectedNode <= 6"
      ]
    },
    {
      "id": "S2",
      "name": "TrafficOn",
      "conditions": [
        "window.__3D_STATE__.trafficActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "LayoutChanged",
      "conditions": [
        "window.__3D_STATE__.currentLayout !== 'hexagonal'"
      ]
    },
    {
      "id": "S4",
      "name": "LabelsHidden",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "PathHighlighted",
      "conditions": [
        "window.__3D_STATE__.pathHighlighted === true"
      ]
    },
    {
      "id": "S6",
      "name": "PulseActive",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.selectedNode === null",
        "window.__3D_STATE__.trafficActive === false",
        "window.__3D_STATE__.currentLayout === 'hexagonal'",
        "window.__3D_STATE__.labelsVisible === true",
        "window.__3D_STATE__.pathHighlighted === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
