{
  "task_id": "P2250_dithering_ordered_bayer_pattern_shader",
  "affordances": [
    {
      "id": "A1",
      "name": "FoxModel",
      "type": "3d_object",
      "semantic": "The loaded Fox.glb 3D model centered at origin",
      "locator_hints": [
        "scene.children with type Mesh or Group",
        "gltf.scene"
      ]
    },
    {
      "id": "A2",
      "name": "DitherScaleSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling dither scale uniform",
      "locator_hints": [
        "#ditherScale"
      ]
    },
    {
      "id": "A3",
      "name": "PatternSizeSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling Bayer pattern pixel scale",
      "locator_hints": [
        "#patternSize"
      ]
    },
    {
      "id": "A4",
      "name": "ColorModeRadios",
      "type": "dom_element",
      "semantic": "Radio buttons for color mode selection",
      "locator_hints": [
        "#modeColor",
        "#modeGray",
        "#modeBW"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleDitherButton",
      "type": "dom_element",
      "semantic": "Button toggling dithering on/off",
      "locator_hints": [
        "#toggleDither"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button resetting all parameters to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "DitherShaderPass",
      "type": "3d_object",
      "semantic": "Custom ShaderPass implementing Bayer dithering",
      "locator_hints": [
        "EffectComposer passes array"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Defaults",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.ditherEnabled === true",
        "window.__3D_STATE__.ditherScale === 0.5",
        "window.__3D_STATE__.patternSize === 1",
        "window.__3D_STATE__.colorMode === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Dither_Scale_Changed",
      "conditions": [
        "window.__3D_STATE__.ditherScale === 0.8"
      ]
    },
    {
      "id": "S3",
      "name": "Color_Mode_Grayscale",
      "conditions": [
        "window.__3D_STATE__.colorMode === 1"
      ]
    },
    {
      "id": "S4",
      "name": "Pattern_Size_Increased",
      "conditions": [
        "window.__3D_STATE__.patternSize === 4"
      ]
    },
    {
      "id": "S5",
      "name": "Dithering_Disabled",
      "conditions": [
        "window.__3D_STATE__.ditherEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "Color_Mode_BW_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.colorMode === 2"
      ]
    },
    {
      "id": "S7",
      "name": "All_Reset_To_Defaults",
      "conditions": [
        "window.__3D_STATE__.ditherEnabled === true",
        "window.__3D_STATE__.ditherScale === 0.5",
        "window.__3D_STATE__.patternSize === 1",
        "window.__3D_STATE__.colorMode === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bayerMatrixSize === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('ditherScale').value = '0.8'; document.getElementById('ditherScale').dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ditherScale === 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ditherScale - 0.8) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ditherScale >= 0 && window.__3D_STATE__.ditherScale <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ditherScale)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ditherEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#modeGray"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorMode >= 0 && window.__3D_STATE__.colorMode <= 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('modeGray').checked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ditherEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('patternSize').value = '4'; document.getElementById('patternSize').dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.patternSize === 4",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.patternSize)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSize >= 1 && window.__3D_STATE__.patternSize <= 8",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.patternSize)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ditherEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ditherEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('toggleDither').textContent.toLowerCase().includes('off')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSize === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ditherEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('modeBW').checked === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorMode >= 0 && window.__3D_STATE__.colorMode <= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ditherEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ditherScale === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastResetFrame > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleDither').textContent.toLowerCase().includes('on')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}