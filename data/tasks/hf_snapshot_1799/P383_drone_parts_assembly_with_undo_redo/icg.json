  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 0",
        "window.__3D_STATE__.droneComplete === false",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.progressPercent === 0"
      ]
    },
    {
      "id": "S1",
      "name": "FrameAssembled",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 1",
        "window.__3D_STATE__.frameAssembled === true",
        "window.__3D_STATE__.progressPercent >= 14"
      ]
    },
    {
      "id": "S2",
      "name": "ThreePartsAssembled",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 3",
        "window.__3D_STATE__.frameAssembled === true",
        "window.__3D_STATE__.undoStackSize === 3"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 2",
        "window.__3D_STATE__.redoStackSize >= 1",
        "window.__3D_STATE__.undoStackSize === 2"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 3",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.undoStackSize === 3"
      ]
    },
    {
      "id": "S5",
      "name": "AllMotorsAndBattery",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 6",
        "window.__3D_STATE__.allMotorsAssembled === true",
        "window.__3D_STATE__.batteryAssembled === true"
      ]
    },
    {
      "id": "S6",
      "name": "DroneComplete",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 7",
        "window.__3D_STATE__.droneComplete === true",
        "window.__3D_STATE__.progressPercent === 100",
        "window.__3D_STATE__.cameraAssembled === true"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.partsAssembled === 0",
        "window.__3D_STATE__.droneComplete === false",
        "window.__3D_STATE__.frameAssembled === false",
        "window.__3D_STATE__.progressPercent === 0"
      ]
    }
  ],
  "transitions": [
