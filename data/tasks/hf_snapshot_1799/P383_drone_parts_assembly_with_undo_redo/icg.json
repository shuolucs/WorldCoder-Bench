      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-assemble"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.partsAssembled !== before.partsAssembled || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.partsAssembled === 'number' && !isNaN(window.__3D_STATE__.partsAssembled)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.undoStackSize === 'number' && !isNaN(window.__3D_STATE__.undoStackSize)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.assemblyOrder)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 0",
            "tier": "L2"
          }
        ]
