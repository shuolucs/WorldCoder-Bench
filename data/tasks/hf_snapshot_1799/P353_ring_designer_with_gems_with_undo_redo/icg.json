  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.gemCount === 0",
        "window.__3D_STATE__.selectedGemType === 'ruby'",
        "window.__3D_STATE__.selectedSlot === 0",
        "window.__3D_STATE__.historyLength === 0",
        "window.__3D_STATE__.canUndo === false",
        "window.__3D_STATE__.canRedo === false"
      ]
    },
    {
      "id": "S1",
      "name": "OneGemPlaced",
      "conditions": [
        "window.__3D_STATE__.gemCount === 1",
        "window.__3D_STATE__.slots[0] === 'ruby'",
        "window.__3D_STATE__.historyLength === 1",
        "window.__3D_STATE__.canUndo === true"
      ]
    },
    {
      "id": "S2",
      "name": "GemTypeChanged",
      "conditions": [
        "window.__3D_STATE__.selectedGemType === 'sapphire'"
      ]
    },
    {
      "id": "S3",
      "name": "TwoGemsPlaced",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.slots[0] === 'ruby'",
        "window.__3D_STATE__.slots[2] === 'sapphire'",
        "window.__3D_STATE__.historyLength === 2"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.gemCount === 1",
        "window.__3D_STATE__.slots[2] === null",
        "window.__3D_STATE__.canRedo === true",
        "window.__3D_STATE__.historyPosition === 1"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.slots[2] === 'sapphire'",
        "window.__3D_STATE__.canRedo === false",
        "window.__3D_STATE__.historyPosition === 2"
      ]
    },
    {
      "id": "S6",
      "name": "ThreeGemsPlaced",
      "conditions": [
        "window.__3D_STATE__.gemCount === 3",
        "window.__3D_STATE__.historyLength === 3"
      ]
    },
    {
      "id": "S7",
      "name": "GemRemoved",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.slots[0] === null",
        "window.__3D_STATE__.historyLength === 4"
      ]
    },
    {
      "id": "S8",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.gemCount === 0",
        "window.__3D_STATE__.slots.every(s => s === null)",
        "window.__3D_STATE__.lastAction === 'clear'"
      ]
    },
    {
      "id": "S9",
      "name": "ClearUndone",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.canRedo === true",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S10",
      "name": "RotationToggled",
      "conditions": [
        "window.__3D_STATE__.ringAutoRotate === false"
      ]
    }
  ],
