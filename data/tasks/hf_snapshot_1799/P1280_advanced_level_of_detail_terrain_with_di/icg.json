      "semantic": "8x8 virtual grid tracking camera exploration",
      "locator_hints": [
        "exploredCells in __3D_STATE__"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.chunkCount === 16",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "LODDistributionValid",
      "conditions": [
        "window.__3D_STATE__.lodDistribution.lod0 + window.__3D_STATE__.lodDistribution.lod1 + window.__3D_STATE__.lodDistribution.lod2 + window.__3D_STATE__.lodDistribution.lod3 === 16"
      ]
    },
    {
      "id": "S2",
      "name": "CameraMoved",
      "conditions": [
        "window.__3D_STATE__.cameraPos.z !== 200 || window.__3D_STATE__.cameraPos.x !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "ExplorationStarted",
      "conditions": [
        "window.__3D_STATE__.exploredCells > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S4",
      "name": "WireframeToggled",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPos.y - 80) < 2",
        "Math.abs(window.__3D_STATE__.cameraPos.z - 200) < 2"
      ]
    },
    {
      "id": "S6",
      "name": "ScoreReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.exploredCells === 0"
      ]
    },
    {
      "id": "S7",
      "name": "LODShifted",
      "conditions": [
        "window.__3D_STATE__.lodDistribution.lod0 !== window.__3D_STATE__._prevLod0 || window.__3D_STATE__.lodDistribution.lod3 !== window.__3D_STATE__._prevLod3"
      ]
    },
    {
      "id": "S8",
      "name": "CameraElevated",
      "conditions": [
        "window.__3D_STATE__.cameraPos.y > 100"
      ]
    },
    {
      "id": "S9",
      "name": "PitchClamped",
      "conditions": [
        "window.__3D_STATE__.cameraRotation.pitch >= -1.2 && window.__3D_STATE__.cameraRotation.pitch <= 1.2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chunkCount === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lodDistribution.lod0 + window.__3D_STATE__.lodDistribution.lod1 + window.__3D_STATE__.lodDistribution.lod2 + window.__3D_STATE__.lodDistribution.lod3 === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTriangles > 0 && !isNaN(window.__3D_STATE__.totalTriangles)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0 && window.__3D_STATE__.exploredCells >= 0",
            "tier": "L2"
          }
        ]
      }
    },
