      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.simulationHour - 12.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.exteriorTemp - (20 + 15 * Math.sin((12 - 6) * Math.PI / 12))) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerTemperatures[0] > window.__3D_STATE__.layerTemperatures[4]",
