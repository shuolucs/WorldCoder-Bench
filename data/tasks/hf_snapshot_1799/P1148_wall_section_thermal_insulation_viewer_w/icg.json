          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalResistance - (0.5/0.72 + 0.1/0.025 + 0.3/0.035 + 0.6/1.4 + 0.1/0.5)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatFlux > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureGradients.every(g => typeof g === 'number' && !isNaN(g))",
            "tier": "L2"
          }
        ]
      }
    },
