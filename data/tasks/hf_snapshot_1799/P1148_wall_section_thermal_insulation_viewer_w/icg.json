  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.layerCount === 5",
        "window.__3D_STATE__.arrowCount === 4",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.selectedLayerIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "TimeSetToNoon",
      "conditions": [
        "Math.abs(window.__3D_STATE__.simulationHour - 12.0) < 0.05",
        "Math.abs(window.__3D_STATE__.exteriorTemp - 35.0) < 0.5"
      ]
    },
    {
      "id": "S2",
      "name": "LayerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLayerIndex >= 0 && window.__3D_STATE__.selectedLayerIndex <= 4"
      ]
    },
    {
      "id": "S3",
      "name": "PlaybackActive",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "InsulationRemoved",
      "conditions": [
        "window.__3D_STATE__.insulationRemoved === true"
      ]
    },
    {
      "id": "S6",
      "name": "InsulationRestored",
      "conditions": [
        "window.__3D_STATE__.insulationRemoved === false"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "Math.abs(window.__3D_STATE__.simulationHour - 6.0) < 0.05",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.playbackSpeed === 1.0",
        "window.__3D_STATE__.selectedLayerIndex === -1",
        "window.__3D_STATE__.cumulativeEnergy === 0"
      ]
    },
    {
      "id": "S8",
      "name": "MidnightCold",
      "conditions": [
        "Math.abs(window.__3D_STATE__.simulationHour - 0.0) < 0.1",
        "window.__3D_STATE__.exteriorTemp < 10"
      ]
    },
    {
      "id": "S9",
      "name": "KeyboardLayerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLayerIndex >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "EnergyAccumulated",
      "conditions": [
        "window.__3D_STATE__.cumulativeEnergy > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowCount === 4",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerTemperatures) && window.__3D_STATE__.layerTemperatures.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerConductivities) && window.__3D_STATE__.layerConductivities.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layerTemperatures.every(t => typeof t === 'number' && !isNaN(t))",
            "tier": "L2"
          }
        ]
      }
    },
    {
