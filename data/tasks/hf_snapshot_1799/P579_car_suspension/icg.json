            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.carBodyY > 0 && window.__3D_STATE__.carBodyY < 3",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S1",
      "severity": "P0",
      "action": { "type": "wait", "duration_ms": 5000 },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.carZ !== before.carZ",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.suspensionValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const maxComp = Math.max(Math.abs(s.compressionFL), Math.abs(s.compressionFR), Math.abs(s.compressionRL), Math.abs(s.compressionRR)); return maxComp < 0.5; })()",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.pitchAngle) && isFinite(window.__3D_STATE__.rollAngle)",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
