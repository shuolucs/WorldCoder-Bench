  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "conditions": ["window.__3D_STATE__ !== undefined", "window.__3D_STATE__.frameCount >= 0"]
    },
    {
      "id": "S1",
      "name": "running",
      "conditions": ["window.__3D_STATE__.frameCount > 30", "window.__3D_STATE__.speed > 0"]
    },
    {
      "id": "S2",
      "name": "stiffness_changed",
      "conditions": ["window.__3D_STATE__.stiffness !== 30000"]
    },
    {
      "id": "S3",
      "name": "damping_changed",
      "conditions": ["window.__3D_STATE__.damping !== 3000"]
    },
    {
      "id": "S4",
      "name": "paused",
      "conditions": ["window.__3D_STATE__.isPaused === true"]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": { "type": "wait", "duration_ms": 2000 },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.compressionFL === 'number' && typeof window.__3D_STATE__.compressionFR === 'number' && typeof window.__3D_STATE__.compressionRL === 'number' && typeof window.__3D_STATE__.compressionRR === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.suspensionValid === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": { "type": "wait", "duration_ms": 4000 },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 60",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.carZ > before.carZ",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.speed > 0 && window.__3D_STATE__.speed <= 20",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.suspensionValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Math.abs(s.compressionFL) < 0.5 && Math.abs(s.compressionFR) < 0.5 && Math.abs(s.compressionRL) < 0.5 && Math.abs(s.compressionRR) < 0.5; })()",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.carBodyY > 0 && window.__3D_STATE__.carBodyY < 3",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-stiffness').value = 80000; document.getElementById('slider-stiffness').dispatchEvent(new Event('input')); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stiffness >= 75000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.suspensionValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Math.abs(s.compressionFL) < 0.5 && Math.abs(s.compressionFR) < 0.5; })()",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-damping').value = 8000; document.getElementById('slider-damping').dispatchEvent(new Event('input')); return true;"
