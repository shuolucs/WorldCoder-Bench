{
  "task_id": "P2396_calcium_carbonate_dissolving_in_hydrochl",
  "affordances": [
    {
      "id": "A1",
      "name": "Beaker",
      "type": "3d_object",
      "semantic": "Transparent cylindrical beaker containing the reaction",
      "locator_hints": [
        "cylinder geometry with transmission material",
        "radius ~1.5"
      ]
    },
    {
      "id": "A2",
      "name": "HClSolution",
      "type": "3d_object",
      "semantic": "Green translucent acid solution inside beaker",
      "locator_hints": [
        "inner cylinder",
        "color #88ff88",
        "transparent material"
      ]
    },
    {
      "id": "A3",
      "name": "CaCO3Chunk",
      "type": "3d_object",
      "semantic": "Dissolving calcium carbonate solid",
      "locator_hints": [
