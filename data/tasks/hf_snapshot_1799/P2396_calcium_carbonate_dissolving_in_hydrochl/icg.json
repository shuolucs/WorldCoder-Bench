      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Undo to previous snapshot",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A8",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Redo previously undone snapshot",
      "locator_hints": [
        "#btn-redo"
      ]
    },
    {
      "id": "A9",
      "name": "RateSlider",
      "type": "dom_element",
      "semantic": "Slider to adjust reaction rate factor",
      "locator_hints": [
        "#slider-rate",
        "range 0.01-0.2"
      ]
    },
    {
      "id": "A10",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Chemistry data readout overlay",
      "locator_hints": [
        "#hud-panel",
        "top-left"
      ]
    },
    {
      "id": "A11",
      "name": "RateChart",
      "type": "dom_element",
      "semantic": "2D line chart of reaction rate over time",
      "locator_hints": [
        "#chart-canvas",
        "bottom-right"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.caco3Moles === 1.0",
        "window.__3D_STATE__.hclMoles === 2.0",
        "window.__3D_STATE__.co2Produced === 0",
        "window.__3D_STATE__.reactionRunning === false",
        "window.__3D_STATE__.reactionComplete === false"
      ]
    },
    {
      "id": "S1",
      "name": "Reaction_Running",
      "conditions": [
        "window.__3D_STATE__.reactionRunning === true",
        "window.__3D_STATE__.reactionRate > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Reaction_Paused_Midway",
      "conditions": [
        "window.__3D_STATE__.reactionRunning === false",
        "window.__3D_STATE__.caco3Moles < 1.0",
        "window.__3D_STATE__.caco3Moles > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "Rate_Factor_Changed",
      "conditions": [
        "window.__3D_STATE__.rateFactor !== 0.05"
      ]
    },
    {
      "id": "S4",
      "name": "Snapshot_Taken",
      "conditions": [
        "window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0",
        "window.__3D_STATE__.reactionRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0"
      ]
    },
    {
      "id": "S7",
      "name": "Reaction_Advanced",
      "conditions": [
        "window.__3D_STATE__.co2Produced > 0.1",
        "window.__3D_STATE__.bubbleCount >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "Reaction_Complete",
      "conditions": [
        "window.__3D_STATE__.reactionComplete === true",
        "window.__3D_STATE__.reactionRate <= 0.0001"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Done",
      "conditions": [
        "window.__3D_STATE__.caco3Moles === 1.0",
        "window.__3D_STATE__.hclMoles === 2.0",
        "window.__3D_STATE__.co2Produced === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reactionRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.reactionRate)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rateFactor === 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.caco3Moles < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hclMoles < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.co2Produced > 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((1.0 - window.__3D_STATE__.caco3Moles) - window.__3D_STATE__.co2Produced) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((2.0 - window.__3D_STATE__.hclMoles) - 2 * window.__3D_STATE__.co2Produced) < 0.002",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.massConservationError < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S7",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Moles < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Moles > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.caco3Radius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.caco3Radius < 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-rate').value = '0.15'; document.getElementById('slider-rate').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rateFactor >= 0.14 && window.__3D_STATE__.rateFactor <= 0.16",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.snapshotCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rateFactor)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-toggle').click(); await new Promise(r => setTimeout(r, 3000)); document.getElementById('btn-toggle').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chartDataPoints > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chartDataPoints === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 4.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var pre = {...window.__3D_STATE__}; window.__pre_undo = pre; document.getElementById('btn-undo').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Moles > window.__pre_undo.caco3Moles - 0.0001 || window.__3D_STATE__.elapsedTime < window.__pre_undo.elapsedTime + 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.co2Produced <= window.__pre_undo.co2Produced + 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.massConservationError < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var preRedo = {...window.__3D_STATE__}; window.__pre_redo = preRedo; document.getElementById('btn-redo').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize < window.__pre_redo.redoStackSize + 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.co2Produced === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.hclMoles)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.massConservationError < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Moles >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hclMoles >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Radius > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.caco3Radius - 0.6 * Math.pow(window.__3D_STATE__.caco3Moles, 1/3)) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.caco3Moles === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hclMoles === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.co2Produced === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionComplete === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-rate').value = '0.20'; document.getElementById('slider-rate').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btn-toggle').click(); await new Promise(r => setTimeout(r, 18000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactionComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.caco3Moles < 0.01 || window.__3D_STATE__.hclMoles < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionRate < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.co2Produced > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.massConservationError < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chartDataPoints >= 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}