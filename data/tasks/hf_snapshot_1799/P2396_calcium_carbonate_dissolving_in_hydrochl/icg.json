        "beige color #f5f5dc",
        "shrinks over time"
      ]
    },
    {
      "id": "A4",
      "name": "CO2Bubbles",
      "type": "3d_object",
      "semantic": "Rising CO2 gas bubbles from reaction",
      "locator_hints": [
        "small white spheres",
        "additive blending",
        "rise upward"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleButton",
