{
  "task_id": "P551_predator_prey",
  "affordances": [
    {"id": "A1", "name": "Foxes", "type": "3d_object", "semantic": "Fox GLB models (predators)", "locator_hints": ["GLTF Fox models"]},
    {"id": "A2", "name": "Storks", "type": "3d_object", "semantic": "Stork GLB models (prey)", "locator_hints": ["GLTF stork models"]},
    {"id": "A3", "name": "Trees", "type": "3d_object", "semantic": "Procedural tree decorations", "locator_hints": ["cylinder + cone groups"]},
    {"id": "A4", "name": "FoxSpeedSlider", "type": "dom_element", "semantic": "Fox speed control", "locator_hints": ["#slider-fox-speed"]},
    {"id": "A5", "name": "StorkSpeedSlider", "type": "dom_element", "semantic": "Stork speed control", "locator_hints": ["#slider-stork-speed"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Loaded", "conditions": ["window.__3D_STATE__.modelsLoaded === true"]},
    {"id": "S2", "name": "HuntingActive", "conditions": ["window.__3D_STATE__.totalCatches > 0 || window.__3D_STATE__.frameCount > 100"]},
    {"id": "S3", "name": "SpeedChanged", "conditions": ["window.__3D_STATE__.foxSpeed !== 4"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.totalCatches === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 4000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.foxCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.storkCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.animalsValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 10000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.foxCount >= 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.storkCount >= 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.animalsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-fox-speed').value = 7; document.getElementById('slider-fox-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.foxSpeed >= 6", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.storkCount > before.storkCount || window.__3D_STATE__.storkCount >= before.storkCount", "tier": "L1"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalCatches === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.foxCount > 0 && window.__3D_STATE__.storkCount > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-foxes') !== null", "tier": "L2"}
      ]}
    }
  ]
}
