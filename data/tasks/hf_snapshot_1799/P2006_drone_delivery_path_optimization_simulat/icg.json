{
  "task_id": "P2006_drone_delivery_path_optimization_simulat",
  "affordances": [
    {
      "id": "A1",
      "name": "Drone",
      "type": "3d_object",
      "semantic": "Delivery drone that flies along computed paths",
      "locator_hints": [
        "drone group at y=10",
        "box body with 4 cyan rotor cylinders"
      ]
    },
    {
      "id": "A2",
      "name": "Warehouse",
      "type": "3d_object",
      "semantic": "Yellow box at (-60,0,-60), drone launch/return point",
      "locator_hints": [
        "yellow box mesh",
        "position (-60,0,-60)"
      ]
    },
    {
      "id": "A3",
      "name": "DeliveryPoints",
      "type": "3d_object",
      "semantic": "5 red spheres at known positions representing delivery targets",
      "locator_hints": [
        "red sphere radius 2",
        "labeled D1-D5"
      ]
    },
    {
      "id": "A4",
      "name": "NoFlyZones",
      "type": "3d_object",
      "semantic": "6 semi-transparent red boxes representing restricted airspace",
      "locator_hints": [
        "semi-transparent red boxes",
        "height 30"
      ]
    },
    {
      "id": "A5",
      "name": "PathLine",
      "type": "3d_object",
      "semantic": "Line geometry showing the computed delivery route",
      "locator_hints": [
        "blue line for greedy",
        "green line for optimized"
      ]
    },
    {
      "id": "A6",
      "name": "GenerateGreedyButton",
      "type": "dom_element",
      "semantic": "Button to compute nearest-neighbor greedy path",
      "locator_hints": [
        "#btn-greedy"
      ]
    },
    {
      "id": "A7",
      "name": "OptimizeButton",
      "type": "dom_element",
      "semantic": "Button to run 2-opt optimization on current path",
      "locator_hints": [
        "#btn-optimize"
      ]
    },
    {
      "id": "A8",
      "name": "StartDeliveryButton",
      "type": "dom_element",
      "semantic": "Button to begin drone flight along path",
      "locator_hints": [
        "#btn-start"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "ToggleNFZButton",
      "type": "dom_element",
      "semantic": "Button to toggle no-fly zone visibility",
      "locator_hints": [
        "#btn-toggle-nfz"
      ]
    },
    {
      "id": "A11",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing simulation stats",
      "locator_hints": [
        "top-left overlay",
        "algorithm, distance, deliveries, speed, status"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.algorithm === 'none'",
        "window.__3D_STATE__.droneStatus === 'idle'",
        "window.__3D_STATE__.deliveriesCompleted === 0",
        "window.__3D_STATE__.totalDistance === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Greedy_Path_Computed",
      "conditions": [
        "window.__3D_STATE__.algorithm === 'greedy'",
        "window.__3D_STATE__.greedyDistance > 0",
        "window.__3D_STATE__.pathOrder.length === 5",
        "window.__3D_STATE__.droneStatus === 'idle'"
      ]
    },
    {
      "id": "S2",
      "name": "Optimized_Path_Computed",
      "conditions": [
        "window.__3D_STATE__.algorithm === 'optimized'",
        "window.__3D_STATE__.optimizedDistance > 0",
        "window.__3D_STATE__.optimizedDistance <= window.__3D_STATE__.greedyDistance",
        "window.__3D_STATE__.droneStatus === 'idle'"
      ]
    },
    {
      "id": "S3",
      "name": "Drone_Flying",
      "conditions": [
        "window.__3D_STATE__.droneStatus === 'flying'",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Drone_Paused",
      "conditions": [
        "window.__3D_STATE__.droneStatus === 'paused'",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Partial_Deliveries",
      "conditions": [
        "window.__3D_STATE__.deliveriesCompleted > 0",
        "window.__3D_STATE__.deliveriesCompleted < 5"
      ]
    },
    {
      "id": "S6",
      "name": "All_Delivered",
      "conditions": [
        "window.__3D_STATE__.deliveriesCompleted === 5"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.droneStatus === 'idle'",
        "window.__3D_STATE__.deliveriesCompleted === 0",
        "window.__3D_STATE__.algorithm === 'none'"
      ]
    },
    {
      "id": "S8",
      "name": "Speed_Modified",
      "conditions": [
        "window.__3D_STATE__.droneSpeed !== 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "NFZ_Hidden",
      "conditions": [
        "window.__3D_STATE__.nfzVisible === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-greedy"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.greedyDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.algorithm === 'greedy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.greedyDistance > 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pathOrder.length === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.pathOrder) && window.__3D_STATE__.pathOrder.every(p => ['d1','d2','d3','d4','d5'].includes(p))",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pathWaypoints >= 7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-optimize"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.algorithm === 'optimized'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.optimizedDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.optimizedDistance > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.optimizedDistance <= window.__3D_STATE__.greedyDistance",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pathOrder.length === 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.optimizedDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneStatus === 'flying'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dronePosition === 'object' && window.__3D_STATE__.dronePosition !== null",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.dronePosition.x) && !isNaN(window.__3D_STATE__.dronePosition.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dronePosition.y - 10) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneStatus === 'paused'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dronePosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.dronePosition.x)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dronePosition.y - 10) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneStatus === 'flying'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTarget === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['warehouse','d1','d2','d3','d4','d5'].includes(window.__3D_STATE__.currentTarget)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dronePosition.y - 10) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.deliveriesCompleted >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visitedPoints.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.visitedPoints)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.visitedPoints.every(p => ['d1','d2','d3','d4','d5'].includes(p))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.droneStatus === 'flying' || window.__3D_STATE__.deliveriesCompleted === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "+"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneSpeed > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.droneSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.droneSpeed - Math.round(window.__3D_STATE__.droneSpeed * 2) / 2) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.droneStatus === 'flying'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.droneSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "-"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneSpeed >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.droneSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.droneSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.droneStatus === 'flying'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.droneSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S2",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-nfz"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nfzVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.nfzVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.algorithm === 'optimized'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.droneStatus === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDistance > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneStatus === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deliveriesCompleted === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.algorithm === 'none'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDistance === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visitedPoints.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}