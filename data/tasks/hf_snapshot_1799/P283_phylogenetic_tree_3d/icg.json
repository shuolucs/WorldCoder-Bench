{
  "task_id": "P283_phylogenetic_tree_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "TreeGroup",
      "type": "3d_object",
      "semantic": "The parent group containing all tree nodes and branches",
      "locator_hints": [
        "scene.getObjectByName('treeGroup')",
        "window.__3D_STATE__.totalNodes"
      ]
    },
    {
      "id": "A2",
      "name": "RootNode",
      "type": "3d_object",
      "semantic": "The root node sphere at depth 0",
      "locator_hints": [
        "node_0",
        "depth 0 node"
      ]
    },
    {
      "id": "A3",
      "name": "LeafNodes",
      "type": "3d_object",
      "semantic": "The 12 leaf nodes at depth 3 with species labels",
      "locator_hints": [
        "leaf_1 through leaf_12"
      ]
    },
    {
      "id": "A4",
      "name": "SpeciesLabels",
      "type": "3d_object",
      "semantic": "Sprite text labels on leaf nodes",
      "locator_hints": [
        "Species_1 through Species_12"
      ]
    },
    {
      "id": "A5",
      "name": "RotateButton",
      "type": "dom_element",
      "semantic": "HTML button to toggle auto-rotation",
      "locator_hints": [
        "#btn-rotate"
      ]
    },
    {
      "id": "A6",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "DOM panel showing tree info and selection state",
      "locator_hints": [
        "#info-panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneReady",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.totalNodes === 22",
        "window.__3D_STATE__.leafCount === 12",
        "window.__3D_STATE__.maxDepth === 3"
      ]
    },
    {
      "id": "S1",
      "name": "NodeHovered",
      "conditions": [
        "window.__3D_STATE__.hoveredNode !== null"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNode !== null",
        "window.__3D_STATE__.highlightedPath.length > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SelectionReset",
      "conditions": [
        "window.__3D_STATE__.selectedNode === null",
        "window.__3D_STATE__.highlightedPath.length === 0"
      ]
    },
    {
      "id": "S4",
      "name": "LabelsHidden",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "LabelsVisible",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "TreeCollapsed",
      "conditions": [
        "window.__3D_STATE__.isCollapsed === true"
      ]
    },
    {
      "id": "S7",
      "name": "TreeExpanded",
      "conditions": [
        "window.__3D_STATE__.isCollapsed === false"
      ]
    },
    {
      "id": "S8",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.isAutoRotating === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const nodes = document.querySelectorAll ? null : null; const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const rootPos = window.__3D_STATE__.nodePositions['node_0']; canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height * 0.85, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
