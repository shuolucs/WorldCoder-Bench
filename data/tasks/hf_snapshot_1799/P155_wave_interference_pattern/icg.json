{
  "task_id": "P155_wave_interference_pattern",
  "affordances": [
    {
      "id": "A1",
      "name": "WaveSurface",
      "type": "3d_object",
      "semantic": "The subdivided plane mesh representing the water surface with vertex displacement",
      "locator_hints": [
        "PlaneGeometry mesh",
        "wave surface"
      ]
    },
    {
      "id": "A2",
      "name": "Source1Marker",
      "type": "3d_object",
      "semantic": "Red sphere marking position of wave source 1",
      "locator_hints": [
        "source1Marker",
        "red sphere at negative X"
      ]
    },
    {
      "id": "A3",
      "name": "Source2Marker",
      "type": "3d_object",
      "semantic": "Red sphere marking position of wave source 2",
      "locator_hints": [
        "source2Marker",
        "red sphere at positive X"
      ]
    },
    {
      "id": "A4",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Slider controlling wave frequency",
      "locator_hints": [
        "#frequencySlider"
      ]
    },
    {
      "id": "A5",
      "name": "WavelengthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling wavelength",
      "locator_hints": [
        "#wavelengthSlider"
      ]
    },
    {
      "id": "A6",
      "name": "AmplitudeSlider",
      "type": "dom_element",
      "semantic": "Slider controlling wave amplitude",
      "locator_hints": [
        "#amplitudeSlider"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleSource2Button",
      "type": "dom_element",
      "semantic": "Button to enable/disable second wave source",
      "locator_hints": [
        "#toggleSource2"
      ]
    },
    {
      "id": "A8",
      "name": "SeparationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling source separation distance",
      "locator_hints": [
        "#separationSlider"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A10",
      "name": "MaxDisplacementDisplay",
      "type": "dom_element",
      "semantic": "HUD readout of current max Y displacement",
      "locator_hints": [
        "#maxDisplacement"
      ]
    },
    {
      "id": "A11",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "HUD readout of elapsed simulation time",
      "locator_hints": [
        "#timeDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.wavelength === 8.0",
        "window.__3D_STATE__.amplitude === 2.0",
        "window.__3D_STATE__.separation === 20.0",
        "window.__3D_STATE__.source2Active === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "WavesAnimating",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0.5",
        "window.__3D_STATE__.maxY > 0",
        "!isNaN(window.__3D_STATE__.maxY)",
        "!isNaN(window.__3D_STATE__.minY)"
      ]
    },
    {
      "id": "S2",
      "name": "FrequencyChanged",
      "conditions": [
        "window.__3D_STATE__.frequency === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "Source2Disabled",
      "conditions": [
        "window.__3D_STATE__.source2Active === false"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SeparationChanged",
      "conditions": [
        "window.__3D_STATE__.separation === 10.0"
      ]
    },
    {
      "id": "S6",
      "name": "AmplitudeChanged",
      "conditions": [
        "window.__3D_STATE__.amplitude === 3.5"
      ]
    },
    {
      "id": "S7",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.wavelength === 8.0",
        "window.__3D_STATE__.amplitude === 2.0",
        "window.__3D_STATE__.separation === 20.0",
        "window.__3D_STATE__.source2Active === true",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxY > 0 && window.__3D_STATE__.maxY <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minY < 0 && window.__3D_STATE__.minY >= -4.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.maxY) && !isNaN(window.__3D_STATE__.minY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('frequencySlider').value = 2.0; document.getElementById('frequencySlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "!isNaN(window.__3D_STATE__.maxY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleSource2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxY > 0 && window.__3D_STATE__.maxY <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.maxY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('separationSlider').value = 10.0; document.getElementById('separationSlider').dispatchEvent(new Event('input')); document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.source1Pos.x === -5.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('amplitudeSlider').value = 3.5; document.getElementById('amplitudeSlider').dispatchEvent(new Event('input')); document.getElementById('toggleSource2').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxY > 0 && window.__3D_STATE__.maxY <= 7.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.minY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.source1Pos.x === -10.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}