  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.selectedType === 'residential'",
        "window.__3D_STATE__.deleteMode === false",
        "window.__3D_STATE__.isNight === false"
      ]
    },
    {
      "id": "S1",
      "name": "ResidentialPlaced",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 1",
        "window.__3D_STATE__.residentialCount === 1"
      ]
    },
    {
      "id": "S2",
      "name": "CommercialSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'commercial'"
      ]
    },
    {
      "id": "S3",
      "name": "MultipleBuildings",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 2",
        "window.__3D_STATE__.residentialCount === 1",
        "window.__3D_STATE__.commercialCount === 1"
      ]
    },
    {
      "id": "S4",
      "name": "DeleteModeOn",
      "conditions": [
        "window.__3D_STATE__.deleteMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "BuildingDeleted",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 1",
        "window.__3D_STATE__.deleteMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 2"
      ]
    },
    {
      "id": "S7",
      "name": "NightMode",
      "conditions": [
        "window.__3D_STATE__.isNight === true",
        "window.__3D_STATE__.ambientIntensity <= 0.15"
      ]
    },
    {
      "id": "S8",
      "name": "CityRandomized",
      "conditions": [
        "window.__3D_STATE__.totalBuildings >= 10"
      ]
    },
    {
      "id": "S9",
      "name": "CityCleared",
      "conditions": [
        "window.__3D_STATE__.totalBuildings === 0"
      ]
    },
    {
      "id": "S10",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 30) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 40) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 30) < 1"
      ]
    }
  ],
