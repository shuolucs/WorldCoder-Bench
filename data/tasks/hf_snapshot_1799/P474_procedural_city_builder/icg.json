      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Simulate placing a residential building at cell (5,5)\nconst cellCenter = {x: -45 + 5*10, z: -45 + 5*10};\nconst event = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2});\n// Use the exposed placement function directly\nif(window.__placeBuildingAt) { window.__placeBuildingAt(5, 5); } else { const canvas = document.querySelector('canvas'); canvas.dispatchEvent(event); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
