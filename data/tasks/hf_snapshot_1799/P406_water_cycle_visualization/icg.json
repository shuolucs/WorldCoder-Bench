{
  "task_id": "P406_water_cycle_visualization",
  "affordances": [
    {
      "id": "A1",
      "name": "WaterBody",
      "type": "3d_object",
      "semantic": "Blue semi-transparent lake/ocean on left side of scene",
      "locator_hints": [
        "position.x ~ -10",
        "blue colored mesh"
      ]
    },
    {
      "id": "A2",
      "name": "Clouds",
      "type": "3d_object",
      "semantic": "White cloud clusters at top of scene",
      "locator_hints": [
        "position.y ~ 18",
        "white spheres"
      ]
    },
    {
      "id": "A3",
      "name": "WaterBottle",
      "type": "3d_object",
      "semantic": "Loaded GLB water bottle model",
      "locator_hints": [
        "position near (0, 0.5, 8)",
        "GLTF model"
      ]
    },
    {
      "id": "A4",
      "name": "PlayPauseBtn",
      "type": "dom_element",
      "semantic": "Toggle play/pause button",
      "locator_hints": [
        "#playPauseBtn"
      ]
    },
    {
      "id": "A5",
      "name": "NextPhaseBtn",
      "type": "dom_element",
      "semantic": "Button to advance to next phase",
      "locator_hints": [
        "#nextPhaseBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetBtn",
      "type": "dom_element",
      "semantic": "Reset button",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Speed control slider",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A8",
      "name": "PhaseLabel",
      "type": "dom_element",
      "semantic": "Current phase name display",
      "locator_hints": [
        "#phaseLabel"
      ]
    },
    {
      "id": "A9",
      "name": "CycleCounter",
      "type": "dom_element",
      "semantic": "Completed cycle count display",
      "locator_hints": [
        "#cycleCounter"
      ]
    },
    {
      "id": "A10",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Educational description panel",
      "locator_hints": [
        "#infoPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Evaporation",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'EVAPORATION'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.cycleCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "Condensation_Phase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'CONDENSATION'",
        "window.__3D_STATE__.phaseIndex === 1"
      ]
    },
    {
      "id": "S3",
      "name": "Precipitation_Phase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'PRECIPITATION'",
        "window.__3D_STATE__.phaseIndex === 2"
      ]
    },
    {
      "id": "S4",
      "name": "Collection_Phase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'COLLECTION'",
        "window.__3D_STATE__.phaseIndex === 3"
      ]
    },
    {
      "id": "S5",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "Cycle_Completed",
      "conditions": [
        "window.__3D_STATE__.cycleCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'EVAPORATION'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.cycleCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.waterBottleLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterBodyVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0 && window.__3D_STATE__.particleCount <= 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('playPauseBtn').textContent.trim().toLowerCase().includes('play')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPhase === 'EVAPORATION'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.phaseElapsed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 'CONDENSATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('phaseLabel').textContent.toUpperCase().includes('CONDENSATION')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoPanel').textContent.length > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#nextPhaseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 'PRECIPITATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('phaseLabel').textContent.toUpperCase().includes('PRECIPITATION')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0 && window.__3D_STATE__.particleCount <= 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 'COLLECTION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('phaseLabel').textContent.toUpperCase().includes('COLLECTION')",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.phaseElapsed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.speed - 2.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.speed)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedSlider').value == 2.0 || Math.abs(parseFloat(document.getElementById('speedSlider').value) - 2.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.isPlaying = true; document.getElementById('playPauseBtn').click(); setTimeout(() => { for(let i=0;i<5;i++){document.getElementById('nextPhaseBtn').click();} }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cycleCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cycleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('cycleCounter').textContent.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseIndex >= 0 && window.__3D_STATE__.phaseIndex <= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 'EVAPORATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cycleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterBottleLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('phaseLabel').textContent.toUpperCase().includes('EVAPORATION')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}