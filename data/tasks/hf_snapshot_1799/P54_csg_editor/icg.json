            "expr": "window.__3D_STATE__.primitives && window.__3D_STATE__.primitives.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.primitives[0].type === 'sphere'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.primitives[1].type === 'box'",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.primitiveCount)",
            "tier": "L2"
