{
  "task_id": "P538_robot_arm_ik",
  "affordances": [
    {"id": "A1", "name": "RobotArm", "type": "3d_object", "semantic": "3-segment robot arm with joints", "locator_hints": ["cylinder and sphere meshes forming arm"]},
    {"id": "A2", "name": "Target", "type": "3d_object", "semantic": "Draggable green target sphere", "locator_hints": ["green sphere mesh"]},
    {"id": "A3", "name": "EndEffector", "type": "3d_object", "semantic": "Red sphere at arm tip", "locator_hints": ["red sphere"]},
    {"id": "A4", "name": "SpeedSlider", "type": "dom_element", "semantic": "IK iterations control", "locator_hints": ["#slider-speed"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.segmentCount === 3", "window.__3D_STATE__.jointsValid === true"]},
    {"id": "S1", "name": "TargetMoved", "conditions": ["window.__3D_STATE__.targetPos.x !== 4 || window.__3D_STATE__.targetPos.y !== 4"]},
    {"id": "S2", "name": "Converged", "conditions": ["window.__3D_STATE__.distanceToTarget < 0.5"]},
    {"id": "S3", "name": "WorkspaceShown", "conditions": ["true"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.segmentCount === 3"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 800},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.segmentCount === 3", "tier": "L2"},
        {"expr": "window.__3D_STATE__.jointsValid === true", "tier": "L0"},
        {"expr": "(function(){ const a = window.__3D_STATE__.jointAngles; return Array.isArray(a) && a.length === 3 && a.every(v => isFinite(v)); })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.endEffectorPos && typeof s.endEffectorPos.x === 'number' && !isNaN(s.endEffectorPos.x); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "window.__3D_STATE__._setTarget && window.__3D_STATE__._setTarget(2, 6); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.jointsValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.distanceToTarget >= 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.distanceToTarget < 1.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.jointsValid === true", "tier": "L0"},
        {"expr": "(function(){ const a = window.__3D_STATE__.jointAngles; return a[0] >= -180 && a[0] <= 180 && a[1] >= -135 && a[1] <= 135 && a[2] >= -120 && a[2] <= 120; })()", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "w"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.jointsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-speed').value = 20; document.getElementById('slider-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ikIterations === 20", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.jointsValid === true", "tier": "L0"},
        {"expr": "document.getElementById('hud-reachable').textContent.includes('Yes') || document.getElementById('hud-reachable').textContent.includes('No')", "tier": "L2"}
      ]}
    }
  ]
}
