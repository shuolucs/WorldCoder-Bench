{
  "task_id": "P316_multiplayer_protein_folding_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinModel",
      "type": "3d_object",
      "semantic": "The loaded GLB model representing a protein structure",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "WireframeOverlay",
      "type": "3d_object",
      "semantic": "Wireframe mesh overlaying the protein model",
      "locator_hints": [
        "wireframe material, color 0x00ff88"
      ]
    },
    {
      "id": "A3",
      "name": "PlayerCursors",
      "type": "3d_object",
      "semantic": "Three colored spheres simulating multiplayer cursors",
      "locator_hints": [
        "small spheres with red/blue/green materials"
      ]
    },
    {
      "id": "A4",
      "name": "RibbonButton",
      "type": "dom_element",
      "semantic": "Button to switch to Ribbon visualization mode",
      "locator_hints": [
        "#btn-ribbon"
      ]
    },
    {
      "id": "A5",
      "name": "WireframeButton",
      "type": "dom_element",
      "semantic": "Button to switch to Wireframe visualization mode",
      "locator_hints": [
        "#btn-wireframe"
      ]
    },
    {
      "id": "A6",
      "name": "SurfaceButton",
      "type": "dom_element",
      "semantic": "Button to switch to Surface visualization mode",
      "locator_hints": [
        "#btn-surface"
      ]
    },
    {
      "id": "A7",
      "name": "FoldButton",
      "type": "dom_element",
      "semantic": "Button to trigger the folding animation",
      "locator_hints": [
        "#btn-fold"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing viewer stats",
      "locator_hints": [
        "top-right positioned div with monospace font"
      ]
    },
    {
      "id": "A9",
      "name": "AnnotationMarkers",
      "type": "3d_object",
      "semantic": "Yellow spheres placed as annotation markers",
      "locator_hints": [
        "small yellow spheres radius 0.08"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Ribbon",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.visualizationMode === 'ribbon'",
        "window.__3D_STATE__.foldStatus === 'idle'",
        "window.__3D_STATE__.annotationCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Wireframe_Mode",
      "conditions": [
        "window.__3D_STATE__.visualizationMode === 'wireframe'"
      ]
    },
    {
      "id": "S3",
      "name": "Surface_Mode",
      "conditions": [
        "window.__3D_STATE__.visualizationMode === 'surface'"
      ]
    },
    {
      "id": "S4",
      "name": "Back_To_Ribbon",
      "conditions": [
        "window.__3D_STATE__.visualizationMode === 'ribbon'"
      ]
    },
    {
      "id": "S5",
      "name": "Annotation_Added",
      "conditions": [
        "window.__3D_STATE__.annotationCount >= 1",
        "window.__3D_STATE__.annotationCount <= 5"
      ]
    },
    {
      "id": "S6",
      "name": "Folding_Active",
      "conditions": [
        "window.__3D_STATE__.foldStatus === 'folding'",
        "window.__3D_STATE__.foldProgress > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Folding_Complete",
      "conditions": [
        "window.__3D_STATE__.foldStatus === 'idle'",
        "window.__3D_STATE__.modelScale >= 0.99"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'ribbon'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldStatus === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.annotationCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerCursors.length === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-wireframe"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'wireframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-surface"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'surface'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldStatus === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-ribbon"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'ribbon'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerCursors.every(c => !isNaN(c.x) && !isNaN(c.y) && !isNaN(c.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.annotationCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'ribbon'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldStatus === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScale >= 0.99",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-fold"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldStatus === 'folding'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldProgress > 0 && window.__3D_STATE__.foldProgress <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScale >= 0.5 && window.__3D_STATE__.modelScale <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.annotationCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldStatus === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScale >= 0.99 && window.__3D_STATE__.modelScale <= 1.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldProgress === 0 || window.__3D_STATE__.foldProgress >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerCursors.every(c => Math.sqrt(c.x*c.x + c.y*c.y + c.z*c.z) > 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}