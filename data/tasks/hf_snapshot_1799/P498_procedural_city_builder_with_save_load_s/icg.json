    },
    {
      "id": "A10",
      "name": "SelectedTypeLabel",
      "type": "dom_element",
      "semantic": "Label showing selected building type",
      "locator_hints": [
        "#selected-type"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 0",
        "window.__3D_STATE__.selectedType === 'house'",
        "window.__3D_STATE__.cleared === true || window.__3D_STATE__.buildingCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "TowerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'tower'"
      ]
    },
    {
      "id": "S2",
      "name": "HousePlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCount >= 1",
        "window.__3D_STATE__.lastPlacedType === 'house'",
        "window.__3D_STATE__.totalHouses >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "TowerPlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCount >= 2",
        "window.__3D_STATE__.lastPlacedType === 'tower'",
        "window.__3D_STATE__.totalTowers >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S5",
      "name": "Cleared",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 0",
        "window.__3D_STATE__.cleared === true"
      ]
    },
    {
      "id": "S6",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.buildingCount >= 2",
        "window.__3D_STATE__.cleared === false"
      ]
    },
    {
      "id": "S7",
      "name": "ParkPlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCount >= 3",
        "window.__3D_STATE__.lastPlacedType === 'park'",
        "window.__3D_STATE__.totalParks >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate placing a house at grid cell (0,0) by dispatching a click on the canvas center area. We use the script to directly invoke placement logic. */ const event = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(event);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-tower"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('selected-type').textContent.includes('tower')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const event = new MouseEvent('click', {clientX: window.innerWidth/2 + 80, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(event);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-save"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "localStorage.getItem('cityBuilderState') !== null",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('cityBuilderState')) !== null",
            "tier": "L0"
          },
          {
            "expr": "Object.keys(JSON.parse(localStorage.getItem('cityBuilderState'))).length >= 2",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-clear"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('building-count').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-load"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "Object.keys(window.__3D_STATE__.gridOccupancy).length >= 2",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-park').click(); setTimeout(() => { const event = new MouseEvent('click', {clientX: window.innerWidth/2 - 80, clientY: window.innerHeight/2 + 40}); document.querySelector('canvas').dispatchEvent(event); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Lighting !== undefined",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}