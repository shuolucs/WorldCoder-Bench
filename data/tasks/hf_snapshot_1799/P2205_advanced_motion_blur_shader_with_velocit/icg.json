    },
    {
      "id": "S3",
      "name": "Blur_Strength_Adjusted",
      "conditions": [
        "window.__3D_STATE__.blurStrength !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "Bobbing_Enabled",
      "conditions": [
        "window.__3D_STATE__.bobbingEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "High_Speed_Orbit",
      "conditions": [
        "window.__3D_STATE__.orbitSpeed === 4.0"
      ]
    },
    {
