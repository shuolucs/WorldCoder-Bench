        "window.__3D_STATE__.currentScore <= 100"
      ]
    },
    {
      "id": "S9",
      "name": "Parameters_Reset",
      "conditions": [
        "window.__3D_STATE__.blurStrength === 1.0",
        "window.__3D_STATE__.blurSamples === 16",
        "window.__3D_STATE__.velocityScale === 1.0",
        "window.__3D_STATE__.orbitSpeed === 1.0"
      ]
    }
  ],
