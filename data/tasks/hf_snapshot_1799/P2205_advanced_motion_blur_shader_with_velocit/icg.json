          },
          {
            "expr": "window.__3D_STATE__.rendererReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityBufferActive === true && window.__3D_STATE__.colorBufferActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true && window.__3D_STATE__.blurStrength === 1.0 && window.__3D_STATE__.blurSamples === 16",
            "tier": "L2"
          }
