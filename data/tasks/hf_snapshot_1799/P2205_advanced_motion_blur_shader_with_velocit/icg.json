        "code": "var s = window.__3D_STATE__; document.getElementById('blurStrengthSlider').value = String(s.idealStrength.toFixed(1)); document.getElementById('blurStrengthSlider').dispatchEvent(new Event('input',{bubbles:true})); document.getElementById('blurSamplesSlider').value = String(Math.round(s.idealSamples/2)*2); document.getElementById('blurSamplesSlider').dispatchEvent(new Event('input',{bubbles:true})); document.getElementById('velocityScaleSlider').value = String(s.idealVelocityScale.toFixed(2)); document.getElementById('velocityScaleSlider').dispatchEvent(new Event('input',{bubbles:true}));"
      },
