      ]
    },
    {
      "id": "A10",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark green ground plane at y=0",
      "locator_hints": [
        "30x30 plane",
        "y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.visibleDepth === 0",
        "window.__3D_STATE__.colorMode === 'natural'",
        "window.__3D_STATE__.wireframe === false"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "MidGrowth",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.4 && window.__3D_STATE__.currentTime <= 0.6",
        "window.__3D_STATE__.visibleDepth >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "ManualScrub",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S5",
      "name": "FullGrowth",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.95",
        "window.__3D_STATE__.visibleDepth >= 6"
      ]
    },
    {
      "id": "S6",
      "name": "FruitsVisible",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.85",
        "window.__3D_STATE__.totalFruits > 0"
      ]
    },
    {
      "id": "S7",
      "name": "RainbowMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'rainbow'"
      ]
    },
    {
      "id": "S8",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.visibleDepth === 0",
        "window.__3D_STATE__.totalFruits === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Space !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.speed !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.speed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBranches >= 0",
            "tier": "L2"
          }
        ]
      }
    },
