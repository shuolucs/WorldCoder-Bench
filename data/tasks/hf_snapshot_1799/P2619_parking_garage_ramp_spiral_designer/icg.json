  "states": [
    {
      "id": "S0",
      "name": "AssetsLoaded_DefaultState",
      "conditions": [
        "window.__3D_STATE__.assetsLoaded === true",
        "window.__3D_STATE__.levels === 4",
        "window.__3D_STATE__.innerRadius === 8",
        "window.__3D_STATE__.outerRadius === 16",
        "window.__3D_STATE__.levelHeight === 3.5",
        "window.__3D_STATE__.selectedLevel === 0"
      ]
    },
    {
      "id": "S1",
      "name": "LevelsChanged",
      "conditions": [
        "window.__3D_STATE__.levels === 6",
        "window.__3D_STATE__.vehicleCount === 18",
        "window.__3D_STATE__.columnCount === 6"
      ]
    },
    {
      "id": "S2",
      "name": "RadiusAdjusted",
      "conditions": [
        "window.__3D_STATE__.innerRadius === 10",
        "window.__3D_STATE__.rampWidth === window.__3D_STATE__.outerRadius - 10"
      ]
    },
    {
      "id": "S3",
      "name": "HeightAdjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.totalHeight - window.__3D_STATE__.levels * window.__3D_STATE__.levelHeight) < 0.001"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoStack.length > 0"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.levels === 4",
        "window.__3D_STATE__.innerRadius === 8",
        "window.__3D_STATE__.outerRadius === 16",
        "window.__3D_STATE__.levelHeight === 3.5",
        "window.__3D_STATE__.lastAction === 'reset'"
