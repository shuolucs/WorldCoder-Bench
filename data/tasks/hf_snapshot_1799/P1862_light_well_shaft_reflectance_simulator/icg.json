  "states": [
    {
      "id": "S0",
      "name": "InitialDefaultState",
      "conditions": [
        "window.__3D_STATE__.shaftWidth === 4",
        "window.__3D_STATE__.shaftHeight === 20",
        "window.__3D_STATE__.wallReflectance === 0.55",
        "window.__3D_STATE__.wallMaterial === 'Sandstone'",
        "window.__3D_STATE__.topCoverActive === false",
        "window.__3D_STATE__.simulationRunCount >= 1",
        "window.__3D_STATE__.zoneIlluminances.length === 10"
      ]
    },
    {
      "id": "S1",
      "name": "WidthAdjusted",
      "conditions": [
        "window.__3D_STATE__.shaftWidth === 6",
        "window.__3D_STATE__.shaftDepth === 6"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationRerunAfterWidth",
      "conditions": [
        "window.__3D_STATE__.shaftWidth === 6",
        "window.__3D_STATE__.simulationRunCount >= 2",
        "window.__3D_STATE__.bottomIlluminance > 0"
      ]
    },
    {
      "id": "S3",
      "name": "WhitePaintMaterial",
      "conditions": [
        "window.__3D_STATE__.wallMaterial === 'White Paint'",
        "window.__3D_STATE__.wallReflectance === 0.85"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationAfterWhitePaint",
      "conditions": [
        "window.__3D_STATE__.wallMaterial === 'White Paint'",
        "window.__3D_STATE__.bottomIlluminance > 0"
      ]
    },
    {
      "id": "S5",
      "name": "TopCoverActivated",
      "conditions": [
        "window.__3D_STATE__.topCoverActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "DarkBrickViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.wallMaterial === 'Dark Brick'",
        "window.__3D_STATE__.wallReflectance === 0.20"
      ]
    },
    {
      "id": "S7",
      "name": "HeightAdjustedTall",
      "conditions": [
        "window.__3D_STATE__.shaftHeight === 35"
      ]
    },
    {
      "id": "S8",
      "name": "DataExported",
      "conditions": [
        "window.__3D_STATE__.dataExported === true"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.shaftWidth === 4",
        "window.__3D_STATE__.shaftHeight === 20",
        "window.__3D_STATE__.wallReflectance === 0.55",
        "window.__3D_STATE__.wallMaterial === 'Sandstone'",
        "window.__3D_STATE__.topCoverActive === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.zoneIlluminances) && window.__3D_STATE__.zoneIlluminances.length === 10",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances[0] === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every((v, i, a) => i === 0 || v <= a[i-1])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every(v => typeof v === 'number' && !isNaN(v) && v >= 0 && v <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sensorPatchCount === 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range][min=\"2\"]').value = 6; document.querySelector('input[type=range][min=\"2\"]').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shaftWidth === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaftDepth === 6",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.geometryFactor === 'number' && !isNaN(window.__3D_STATE__.geometryFactor)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.geometryFactor === Math.min(1.0, (6 * 6) / ((window.__3D_STATE__.shaftHeight / 10) * 2.0))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaftWidth !== 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Run Simulation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances[0] === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottomIlluminance === window.__3D_STATE__.zoneIlluminances[9]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every((v, i, a) => i === 0 || v <= a[i-1])",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalLightSum - window.__3D_STATE__.zoneIlluminances.reduce((a,b) => a+b, 0)) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wallMaterial === 'White Paint'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wallReflectance === 0.85",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wallColor === '#F0F0F0' || window.__3D_STATE__.wallColor === '#f0f0f0'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bottomIlluminance === 'number' && !isNaN(window.__3D_STATE__.bottomIlluminance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
