      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.querySelector('input[type=range][max=\"40\"]'); s.value = 35; s.dispatchEvent(new Event('input', {bubbles:true})); document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Run Simulation')) b.click(); });"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shaftHeight === 35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.geometryFactor === Math.min(1.0, (window.__3D_STATE__.shaftWidth * window.__3D_STATE__.shaftDepth) / ((35 / 10) * 2.0))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every((v, i, a) => i === 0 || v <= a[i-1])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottomIlluminance >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalLightSum === 'number' && !isNaN(window.__3D_STATE__.totalLightSum)",
            "tier": "L0"
          }
        ]
      }
    },
