      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wallMaterial === 'Dark Brick'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wallReflectance === 0.20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottomIlluminance < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zonesAboveThreshold <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances[9] < window.__3D_STATE__.zoneIlluminances[0]",
            "tier": "L2"
          }
