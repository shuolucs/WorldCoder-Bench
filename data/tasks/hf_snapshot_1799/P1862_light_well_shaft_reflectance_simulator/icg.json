            "expr": "window.__3D_STATE__.zoneIlluminances[1] > window.__3D_STATE__.zoneIlluminances[9]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every(v => v >= 0 && v <= 1.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
