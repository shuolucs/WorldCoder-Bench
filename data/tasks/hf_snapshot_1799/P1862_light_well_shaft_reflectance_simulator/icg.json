            "expr": "window.__3D_STATE__.zoneIlluminances[0] <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottomIlluminance < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances.every(v => typeof v === 'number' && !isNaN(v) && v >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneIlluminances[0] <= 0.71",
            "tier": "L2"
