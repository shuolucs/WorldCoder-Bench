  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.objectY === 4.0",
        "window.__3D_STATE__.isDropped === false"
      ]
    },
    {
      "id": "S1",
      "name": "Dropped_Falling_InAir",
      "conditions": [
        "window.__3D_STATE__.isDropped === true",
        "window.__3D_STATE__.objectY < 4.0",
        "window.__3D_STATE__.objectY > 1.5",
        "window.__3D_STATE__.objectVelocity < 0"
      ]
    },
    {
      "id": "S2",
      "name": "Entering_Water",
      "conditions": [
        "window.__3D_STATE__.isDropped === true",
        "window.__3D_STATE__.objectY <= 2.0",
        "window.__3D_STATE__.submergedFraction > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Sunk_In_Water",
      "conditions": [
        "window.__3D_STATE__.fluidName === 'water'",
        "window.__3D_STATE__.objectY <= -1.5",
        "Math.abs(window.__3D_STATE__.objectVelocity) < 0.1"
      ]
    },
    {
      "id": "S4",
      "name": "Paused_State",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed_State",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isDropped === true"
      ]
    },
    {
      "id": "S6",
      "name": "Mercury_Selected",
      "conditions": [
        "window.__3D_STATE__.fluidName === 'mercury'",
        "window.__3D_STATE__.fluidDensity === 13546"
      ]
    },
    {
      "id": "S7",
      "name": "Floating_In_Mercury",
      "conditions": [
        "window.__3D_STATE__.fluidName === 'mercury'",
        "window.__3D_STATE__.objectY > 0.5",
        "window.__3D_STATE__.submergedFraction < 0.5",
        "Math.abs(window.__3D_STATE__.objectVelocity) < 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "Oil_Sunk",
      "conditions": [
        "window.__3D_STATE__.fluidName === 'oil'",
        "window.__3D_STATE__.objectY <= -1.5",
        "Math.abs(window.__3D_STATE__.objectVelocity) < 0.1"
      ]
    },
    {
      "id": "S9",
      "name": "Impulse_Applied",
      "conditions": [
        "window.__3D_STATE__.objectVelocity > 0",
        "window.__3D_STATE__.isDropped === true"
      ]
    },
    {
      "id": "S10",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.objectY === 4.0",
        "window.__3D_STATE__.objectVelocity === 0",
        "window.__3D_STATE__.isPaused === true"
      ]
    }
  ],
