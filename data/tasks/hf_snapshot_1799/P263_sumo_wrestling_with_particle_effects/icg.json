  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.roundActive === false",
        "window.__3D_STATE__.currentRound === 1"
      ]
    },
    {
      "id": "S1",
      "name": "RoundActive",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.roundActive === true",
        "window.__3D_STATE__.playerInRing === true",
        "window.__3D_STATE__.opponentInRing === true"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerMovedForward",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.playerPosition.z !== 0 || window.__3D_STATE__.playerPosition.x !== -2"
      ]
    },
    {
      "id": "S3",
      "name": "CollisionOccurred",
      "conditions": [
        "window.__3D_STATE__.collisionCount > 0",
        "window.__3D_STATE__.activeParticleCount > 0"
      ]
    },
    {
      "id": "S4",
      "name": "RoundEnded",
      "conditions": [
        "window.__3D_STATE__.roundActive === false",
        "window.__3D_STATE__.gameStarted === true",
        "(window.__3D_STATE__.playerScore + window.__3D_STATE__.opponentScore) >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "NextRoundStarted",
      "conditions": [
        "window.__3D_STATE__.currentRound >= 2",
        "window.__3D_STATE__.roundActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.winner !== 'none'"
      ]
    }
  ],
