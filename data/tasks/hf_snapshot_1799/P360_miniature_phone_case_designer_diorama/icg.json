{
  "task_id": "P360_miniature_phone_case_designer_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "PhoneModel",
      "type": "3d_object",
      "semantic": "The phone body mesh on the workbench",
      "locator_hints": [
        "dark colored box at center",
        "dimensions ~1.2x2.4x0.15"
      ]
    },
    {
      "id": "A2",
      "name": "PhoneCase",
      "type": "3d_object",
      "semantic": "The customizable phone case shell",
      "locator_hints": [
        "slightly larger transparent box around phone",
        "starts red"
      ]
    },
    {
      "id": "A3",
      "name": "ColorSwatchRed",
      "type": "3d_object",
      "semantic": "Red color swatch sphere",
      "locator_hints": [
        "sphere at z=2, leftmost"
      ]
    },
    {
      "id": "A4",
      "name": "ColorSwatchBlue",
      "type": "3d_object",
      "semantic": "Blue color swatch sphere",
      "locator_hints": [
        "sphere at z=2, second from left"
      ]
    },
    {
      "id": "A5",
      "name": "ColorSwatchGreen",
      "type": "3d_object",
      "semantic": "Green color swatch sphere",
      "locator_hints": [
        "sphere at z=2, center"
      ]
    },
    {
      "id": "A6",
      "name": "MaterialSwatchMatte",
      "type": "3d_object",
      "semantic": "Matte material swatch cube",
      "locator_hints": [
        "cube at z=-2, leftmost"
      ]
    },
    {
      "id": "A7",
      "name": "MaterialSwatchMetallic",
      "type": "3d_object",
      "semantic": "Metallic material swatch cube",
      "locator_hints": [
        "cube at z=-2, rightmost"
      ]
    },
    {
      "id": "A8",
      "name": "DeskLamp",
      "type": "3d_object",
      "semantic": "Miniature desk lamp with toggleable light",
      "locator_hints": [
        "lamp at position (3, y, -2)"
      ]
    },
    {
      "id": "A9",
      "name": "AddToCartButton",
      "type": "dom_element",
      "semantic": "HTML button to add current config to cart",
      "locator_hints": [
        "button in top-right corner",
        "text 'Add to Cart'"
      ]
    },
    {
      "id": "A10",
      "name": "StatusHUD",
      "type": "dom_element",
      "semantic": "HUD overlay showing current color and material",
      "locator_hints": [
        "top-left text overlay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.caseColor === 'red'",
        "window.__3D_STATE__.caseColorHex === 0xff4444",
        "window.__3D_STATE__.materialType === 'matte'",
        "window.__3D_STATE__.lampOn === true",
        "window.__3D_STATE__.exploded === false",
        "window.__3D_STATE__.cartCount === 0",
        "window.__3D_STATE__.swatchCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChangedBlue",
      "conditions": [
        "window.__3D_STATE__.caseColor === 'blue'",
        "window.__3D_STATE__.caseColorHex === 0x4444ff"
      ]
    },
    {
      "id": "S2",
      "name": "MaterialChangedMetallic",
      "conditions": [
        "window.__3D_STATE__.materialType === 'metallic'",
        "window.__3D_STATE__.caseMetalness === 1.0",
        "window.__3D_STATE__.caseRoughness === 0.3"
      ]
    },
    {
      "id": "S3",
      "name": "PhoneRotated",
      "conditions": [
        "window.__3D_STATE__.rotationAngle === 90"
      ]
    },
    {
      "id": "S4",
      "name": "LampToggled",
      "conditions": [
        "window.__3D_STATE__.lampOn === false"
      ]
    },
    {
      "id": "S5",
      "name": "ExplodedView",
      "conditions": [
        "window.__3D_STATE__.exploded === true",
        "window.__3D_STATE__.caseYPosition >= 1.8"
      ]
    },
    {
      "id": "S6",
      "name": "ExplodedCollapsed",
      "conditions": [
        "window.__3D_STATE__.exploded === false",
        "window.__3D_STATE__.caseYPosition <= 0.7"
      ]
    },
    {
      "id": "S7",
      "name": "AddedToCart",
      "conditions": [
        "window.__3D_STATE__.cartCount === 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A4",
        "description": "Click the blue color swatch sphere"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
