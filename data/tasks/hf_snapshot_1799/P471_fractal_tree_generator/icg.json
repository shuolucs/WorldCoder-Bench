{
  "task_id": "P471_fractal_tree_generator",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalTree",
      "type": "3d_object",
      "semantic": "The procedurally generated fractal tree made of cylinder branch segments",
      "locator_hints": [
        "Group containing all branch meshes",
        "tree group in scene"
      ]
    },
    {
      "id": "A2",
      "name": "LeafSpheres",
      "type": "3d_object",
      "semantic": "Small green spheres at terminal branches representing leaves",
      "locator_hints": [
        "SphereGeometry meshes at branch tips"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark green ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ]
    },
    {
      "id": "A4",
      "name": "GenerateButton",
      "type": "dom_element",
      "semantic": "Button to regenerate tree with current parameters",
      "locator_hints": [
        "#generateBtn"
      ]
    },
    {
      "id": "A5",
      "name": "WindButton",
      "type": "dom_element",
      "semantic": "Button to toggle wind animation",
      "locator_hints": [
        "#windBtn"
      ]
    },
    {
      "id": "A6",
      "name": "LeavesButton",
      "type": "dom_element",
      "semantic": "Button to toggle leaf visibility",
      "locator_hints": [
        "#leavesBtn"
      ]
    },
    {
      "id": "A7",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Button to randomize all parameters and regenerate",
      "locator_hints": [
        "#randomizeBtn"
      ]
    },
    {
      "id": "A8",
      "name": "DepthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling recursion depth",
      "locator_hints": [
        "input[type=range] for depth"
      ]
    },
    {
      "id": "A9",
      "name": "BranchInfo",
      "type": "dom_element",
      "semantic": "Info display for selected branch",
      "locator_hints": [
        "#branchInfo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialTreeGenerated",
      "conditions": [
        "window.__3D_STATE__.treeGenerated === true",
        "window.__3D_STATE__.depth === 5",
        "window.__3D_STATE__.branchLength === 3.0",
        "window.__3D_STATE__.branchAngle === 30",
        "window.__3D_STATE__.windEnabled === false",
        "window.__3D_STATE__.leavesVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "WindEnabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true",
        "window.__3D_STATE__.animationRunning === true"
      ]
    },
    {
      "id": "S2",
      "name": "WindDisabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "LeavesHidden",
      "conditions": [
        "window.__3D_STATE__.leavesVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "LeavesShown",
      "conditions": [
        "window.__3D_STATE__.leavesVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "DepthIncreased",
      "conditions": [
        "window.__3D_STATE__.depth === 6",
        "window.__3D_STATE__.treeGenerated === true"
      ]
    },
    {
      "id": "S6",
      "name": "DepthDecreased",
      "conditions": [
        "window.__3D_STATE__.depth === 5",
        "window.__3D_STATE__.treeGenerated === true"
      ]
    },
    {
      "id": "S7",
      "name": "Randomized",
      "conditions": [
        "window.__3D_STATE__.treeGenerated === true",
        "window.__3D_STATE__.depth >= 1 && window.__3D_STATE__.depth <= 8"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
