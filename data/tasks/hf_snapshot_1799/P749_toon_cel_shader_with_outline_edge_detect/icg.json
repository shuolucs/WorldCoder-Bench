  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.toonBands === 4",
        "window.__3D_STATE__.outlineThickness === 1.5",
        "window.__3D_STATE__.outlineColor === '#000000'",
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.selectedObject === -1",
        "window.__3D_STATE__.undoStackLength === 0",
        "window.__3D_STATE__.redoStackLength === 0",
        "window.__3D_STATE__.objectStates.length === 5",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.outlinePassEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "ObjectSelected",
      "conditions": [
        "window.__3D_STATE__.selectedObject >= 0 && window.__3D_STATE__.selectedObject <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectLaunched",
      "conditions": [
        "window.__3D_STATE__.objectStates[window.__3D_STATE__.selectedObject].velocity.y > 0",
        "window.__3D_STATE__.undoStackLength >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "DebugOverlayOn",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "BandsChanged",
      "conditions": [
        "window.__3D_STATE__.toonBands !== 4"
      ]
    },
    {
      "id": "S5",
      "name": "OutlineThicknessChanged",
      "conditions": [
        "window.__3D_STATE__.outlineThickness !== 1.5"
      ]
    },
    {
      "id": "S6",
      "name": "OutlineColorWhite",
      "conditions": [
        "window.__3D_STATE__.outlineColor === '#FFFFFF'"
      ]
    },
    {
      "id": "S7",
      "name": "LaunchUndone",
      "conditions": [
        "window.__3D_STATE__.redoStackLength >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "LaunchRedone",
      "conditions": [
        "window.__3D_STATE__.redoStackLength === 0",
        "window.__3D_STATE__.undoStackLength >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "SceneReset",
