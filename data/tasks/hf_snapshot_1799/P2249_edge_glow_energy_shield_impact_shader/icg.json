{
  "task_id": "P2249_edge_glow_energy_shield_impact_shader",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "The loaded GLTF helmet model at the origin",
      "locator_hints": [
        "scene.children find mesh with geometry from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "EnergyShield",
      "type": "3d_object",
      "semantic": "Transparent sphere with custom ShaderMaterial surrounding the helmet",
      "locator_hints": [
        "sphere mesh with ShaderMaterial",
        "shield mesh"
      ]
    },
    {
      "id": "A3",
      "name": "ShieldStatusHUD",
      "type": "dom_element",
      "semantic": "HUD text showing shield on/off status",
      "locator_hints": [
        "#shield-status"
      ]
    },
    {
      "id": "A4",
      "name": "ShieldColorHUD",
      "type": "dom_element",
      "semantic": "HUD text showing current shield color name",
      "locator_hints": [
        "#shield-color"
      ]
    },
    {
      "id": "A5",
      "name": "ImpactCountHUD",
      "type": "dom_element",
      "semantic": "HUD text showing number of active impacts",
      "locator_hints": [
        "#impact-count"
      ]
    },
    {
      "id": "A6",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "The Three.js WebGL canvas for click interactions",
      "locator_hints": [
        "canvas",
        "renderer.domElement"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "SceneReady",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.shieldVisible === true",
        "window.__3D_STATE__.shieldColor === 'cyan'"
      ]
    },
    {
      "id": "S2",
      "name": "AfterImpact",
      "conditions": [
        "window.__3D_STATE__.activeImpactCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "ImpactDecayed",
      "conditions": [
        "window.__3D_STATE__.activeImpactCount === 0"
      ]
    },
    {
      "id": "S4",
      "name": "ShieldOff",
      "conditions": [
        "window.__3D_STATE__.shieldVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ShieldBackOn",
      "conditions": [
        "window.__3D_STATE__.shieldVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.shieldColor === 'magenta'"
      ]
    },
    {
      "id": "S7",
      "name": "PulseActive",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "PulseComplete",
      "conditions": [
        "window.__3D_STATE__.pulseActive === false",
        "window.__3D_STATE__.pulseFactor === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColor === 'cyan'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColorHex === '#00ffff'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "canvas",
        "position": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.impactPoints) && window.__3D_STATE__.impactPoints.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeImpactCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.impactPoints.some(p => p.strength > 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.impactPoints.filter(p => p.strength > 0.01).every(p => isFinite(p.x) && isFinite(p.y) && isFinite(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.impactPoints.filter(p => p.strength > 0.01).every(p => p.strength >= 0.0 && p.strength <= 1.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeImpactCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.impactPoints.every(p => p.strength <= 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.impactPoints.every(p => p.strength >= 0.0)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.timeUniform === 'number' && window.__3D_STATE__.timeUniform > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shieldVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('shield-status') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('shield-status').textContent.toLowerCase().includes('off')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shieldVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('shield-status').textContent.toLowerCase().includes('on')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldScale >= 0.99 && window.__3D_STATE__.shieldScale <= 1.09",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColor === 'cyan'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shieldColor === 'magenta'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColorHex === '#ff00ff'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('shield-color').textContent.toLowerCase().includes('magenta')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pulseActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pulseFactor > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldScale >= 1.0 && window.__3D_STATE__.shieldScale <= 1.09",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldOpacityBoost >= 0.0 && window.__3D_STATE__.shieldOpacityBoost <= 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColor === 'magenta'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pulseActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pulseFactor === 0 || window.__3D_STATE__.pulseFactor < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldScale >= 0.99 && window.__3D_STATE__.shieldScale <= 1.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldOpacityBoost < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldColor === 'magenta'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}