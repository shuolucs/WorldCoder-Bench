      "type": "dom_element",
      "semantic": "Triggers calculation and 3D update",
      "locator_hints": [
        "#btnCalculate"
      ]
    },
    {
      "id": "A11",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets all inputs to defaults",
      "locator_hints": [
        "#btnReset"
      ]
    },
    {
      "id": "A12",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Reverts to previous calculation state",
      "locator_hints": [
        "#btnUndo"
      ]
    },
    {
      "id": "A13",
      "name": "ResultsPanel",
      "type": "dom_element",
      "semantic": "Displays calculated bearing capacity results",
      "locator_hints": [
        "#resultQult",
        "#resultQallow",
        "#resultSafetyRatio",
        "#resultStatus"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Default",
      "conditions": [
        "window.__3D_STATE__.footingWidth === 2.0",
        "window.__3D_STATE__.footingDepth === 1.5",
        "window.__3D_STATE__.appliedLoad === 500",
        "window.__3D_STATE__.calculationCount >= 0"
      ]
    },
    {
      "id": "S1",
      "name": "After_First_Calculate",
      "conditions": [
        "window.__3D_STATE__.calculationCount >= 1",
        "window.__3D_STATE__.q_ult > 0",
        "window.__3D_STATE__.safetyRatio > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Depth_Changed_Clay",
      "conditions": [
        "window.__3D_STATE__.footingDepth >= 1.0 && window.__3D_STATE__.footingDepth <= 4.0",
        "window.__3D_STATE__.currentSoilLayer === 'Clay'"
      ]
    },
    {
      "id": "S3",
      "name": "Depth_Changed_Sand",
      "conditions": [
        "window.__3D_STATE__.footingDepth > 4.0 && window.__3D_STATE__.footingDepth <= 7.0",
        "window.__3D_STATE__.currentSoilLayer === 'Sand'"
      ]
    },
    {
      "id": "S4",
      "name": "High_Load_Unsafe",
      "conditions": [
        "window.__3D_STATE__.isSafe === false",
        "window.__3D_STATE__.safetyRatio < 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "After_Undo",
      "conditions": [
        "window.__3D_STATE__.historyIndex >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.footingWidth === 2.0",
        "window.__3D_STATE__.footingLength === 2.0",
        "window.__3D_STATE__.footingDepth === 1.5",
        "window.__3D_STATE__.appliedLoad === 500"
      ]
    },
    {
      "id": "S7",
      "name": "Gravel_Layer_Deep",
      "conditions": [
        "window.__3D_STATE__.footingDepth > 7.0 && window.__3D_STATE__.footingDepth <= 10.0",
        "window.__3D_STATE__.currentSoilLayer === 'Gravel'"
      ]
    },
    {
      "id": "S8",
      "name": "Custom_FOS_Applied",
      "conditions": [
        "window.__3D_STATE__.factorOfSafety !== 3.0",
        "window.__3D_STATE__.q_allow > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Large_Footing_Safe",
      "conditions": [
        "window.__3D_STATE__.footingWidth >= 4.0",
        "window.__3D_STATE__.isSafe === true"
      ]
    },
    {
      "id": "S10",
      "name": "After_Second_Undo",
      "conditions": [
        "window.__3D_STATE__.historyIndex >= 0"
      ]
    },
    {
      "id": "S11",
      "name": "Bedrock_Maximum_Capacity",
      "conditions": [
        "window.__3D_STATE__.footingDepth > 10.0",
        "window.__3D_STATE__.currentSoilLayer === 'Bedrock'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnCalculate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.q_ult === 'number' && !isNaN(window.__3D_STATE__.q_ult)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.q_allow === 'number' && !isNaN(window.__3D_STATE__.q_allow)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.safetyRatio === 'number' && !isNaN(window.__3D_STATE__.safetyRatio)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.calculationCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSoilLayer === 'Clay'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.footingBottomY - (-1.5)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('inputDepth').value = '2.5'; document.getElementById('inputDepth').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btnCalculate').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.footingDepth === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSoilLayer === 'Clay'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.c === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.phi === 22",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.gamma === 18",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.footingBottomY - (-2.5)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('inputDepth').value = '5.5'; document.getElementById('inputDepth').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btnCalculate').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.footingDepth === 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSoilLayer === 'Sand'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.c === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.phi === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.gamma === 17",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.q_applied - (500 / (2.0 * 2.0))) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('inputLoad').value = '9000'; document.getElementById('inputLoad').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('inputWidth').value = '0.5'; document.getElementById('inputWidth').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('inputLength').value = '0.5'; document.getElementById('inputLength').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btnCalculate').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isSafe === false",
