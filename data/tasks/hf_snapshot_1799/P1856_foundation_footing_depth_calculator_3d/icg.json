          },
          {
            "expr": "window.__3D_STATE__.footingLength === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.footingDepth === 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.appliedLoad === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSoilLayer === 'Sand'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSafe === true",
            "tier": "L2"
          }
        ]
