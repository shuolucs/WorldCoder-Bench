          },
          {
            "expr": "window.__3D_STATE__.q_allow > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.q_ult > window.__3D_STATE__.q_allow",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.Nq === 'number' && window.__3D_STATE__.Nq > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
