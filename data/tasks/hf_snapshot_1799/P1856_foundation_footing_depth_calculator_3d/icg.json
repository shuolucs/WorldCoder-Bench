          },
          {
            "expr": "window.__3D_STATE__.safetyRatio < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.appliedLoad === 9000",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.q_applied - (9000 / (0.5 * 0.5))) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.footingVolume - (0.5 * 0.5 * 0.5)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
