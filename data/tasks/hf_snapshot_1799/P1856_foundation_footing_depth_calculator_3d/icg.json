          },
          {
            "expr": "window.__3D_STATE__.footingLength === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.footingThickness === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.footingDepth === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.appliedLoad === 500",
