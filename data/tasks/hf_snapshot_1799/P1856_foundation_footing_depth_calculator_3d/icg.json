        "code": "document.getElementById('inputDepth').value = '11.0'; document.getElementById('inputDepth').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('inputFOS').value = '3.0'; document.getElementById('inputFOS').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btnCalculate').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.footingDepth === 11.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSoilLayer === 'Bedrock'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.c === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.phi === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soilParams.gamma === 22",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.q_ult > window.__3D_STATE__.q_allow && window.__3D_STATE__.q_allow > 0",
