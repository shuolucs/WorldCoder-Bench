{
  "task_id": "P354_sunglasses_try_on",
  "affordances": [
    {
      "id": "A1",
      "name": "HeadMannequin",
      "type": "3d_object",
      "semantic": "Stylized 3D head built from primitives",
      "locator_hints": [
        "sphere radius 1.5 at origin"
      ]
    },
    {
      "id": "A2",
      "name": "SunglassesGroup",
      "type": "3d_object",
      "semantic": "Sunglasses model with frames, lenses, bridge, and arms",
      "locator_hints": [
        "group containing lens frames and temple arms"
      ]
    },
    {
      "id": "A3",
      "name": "StyleButtons",
      "type": "dom_element",
      "semantic": "5 buttons to select sunglasses style",
      "locator_hints": [
        "#style-btn-0 through #style-btn-4"
      ]
    },
    {
      "id": "A4",
      "name": "TryOnButton",
      "type": "dom_element",
      "semantic": "Toggle button for wearing/removing sunglasses",
      "locator_hints": [
        "#try-on-btn"
      ]
    },
    {
      "id": "A5",
      "name": "LensOpacitySlider",
      "type": "dom_element",
      "semantic": "Slider to control lens opacity",
      "locator_hints": [
        "#lens-opacity-slider"
      ]
    },
    {
      "id": "A6",
      "name": "HeadRotationSlider",
      "type": "dom_element",
      "semantic": "Slider to rotate head on Y axis",
      "locator_hints": [
        "#head-rotation-slider"
      ]
    },
    {
      "id": "A7",
      "name": "ZoomButton",
      "type": "dom_element",
      "semantic": "Toggle button for camera zoom",
      "locator_hints": [
        "#zoom-btn"
      ]
    },
    {
      "id": "A8",
      "name": "AddToCartButton",
      "type": "dom_element",
      "semantic": "Button to add item to cart",
      "locator_hints": [
        "#add-to-cart-btn"
      ]
    },
    {
      "id": "A9",
      "name": "PriceDisplay",
      "type": "dom_element",
      "semantic": "Shows price of selected style",
      "locator_hints": [
        "#price-display"
      ]
    },
    {
      "id": "A10",
      "name": "CartCount",
      "type": "dom_element",
      "semantic": "Displays number of items in cart",
      "locator_hints": [
        "#cart-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedStyle === 0",
        "window.__3D_STATE__.isWorn === false",
        "window.__3D_STATE__.cartCount === 0",
        "window.__3D_STATE__.cameraZ === 6",
        "window.__3D_STATE__.sunglassesY >= 2.0"
      ]
    },
    {
      "id": "S1",
      "name": "SunglassesWorn",
      "conditions": [
        "window.__3D_STATE__.isWorn === true",
        "Math.abs(window.__3D_STATE__.sunglassesY - 0.15) < 0.1"
      ]
    },
    {
      "id": "S2",
      "name": "StyleChanged",
      "conditions": [
        "window.__3D_STATE__.selectedStyle !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "OpacityAdjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.lensOpacity - 0.3) < 0.05"
      ]
    },
    {
      "id": "S4",
      "name": "HeadRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.headRotationY - 45) < 2"
      ]
    },
    {
      "id": "S5",
      "name": "Zoomed",
      "conditions": [
        "window.__3D_STATE__.isZoomed === true",
        "Math.abs(window.__3D_STATE__.cameraZ - 3.5) < 0.3"
      ]
    },
    {
      "id": "S6",
      "name": "CartUpdated",
      "conditions": [
        "window.__3D_STATE__.cartCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "SunglassesRemoved",
      "conditions": [
        "window.__3D_STATE__.isWorn === false",
        "window.__3D_STATE__.sunglassesY >= 2.0"
      ]
    },
    {
      "id": "S8",
      "name": "ZoomReset",
      "conditions": [
        "window.__3D_STATE__.isZoomed === false",
        "Math.abs(window.__3D_STATE__.cameraZ - 6) < 0.3"
      ]
    },
    {
      "id": "S9",
      "name": "KeyboardStyleSelect",
      "conditions": [
        "window.__3D_STATE__.selectedStyle === 3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#try-on-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ],
        "wait_ms": 800
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#style-btn-1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('lens-opacity-slider'); slider.value = 30; slider.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
