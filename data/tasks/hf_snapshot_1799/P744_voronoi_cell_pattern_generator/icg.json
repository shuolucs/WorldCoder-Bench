  "states": [
    {
      "id": "S0",
      "name": "Initial8Seeds",
      "conditions": [
        "window.__3D_STATE__.seedCount === 8",
        "window.__3D_STATE__.distanceMetric === 0",
        "window.__3D_STATE__.borderWidth === 0.015",
        "window.__3D_STATE__.animationSpeed === 0.0",
        "window.__3D_STATE__.showDistanceField === false",
        "window.__3D_STATE__.lastAction === 'init'"
      ]
    },
    {
      "id": "S1",
      "name": "SeedAdded",
      "conditions": [
        "window.__3D_STATE__.seedCount === 9",
        "window.__3D_STATE__.lastAction === 'addSeed'"
      ]
    },
    {
      "id": "S2",
      "name": "MetricManhattan",
      "conditions": [
        "window.__3D_STATE__.distanceMetric === 1",
        "window.__3D_STATE__.distanceMetricName === 'Manhattan'"
      ]
    },
    {
      "id": "S3",
      "name": "MetricChebyshev",
      "conditions": [
        "window.__3D_STATE__.distanceMetric === 2",
        "window.__3D_STATE__.distanceMetricName === 'Chebyshev'"
      ]
    },
    {
      "id": "S4",
      "name": "DistanceFieldOn",
      "conditions": [
        "window.__3D_STATE__.showDistanceField === true"
      ]
    },
    {
      "id": "S5",
      "name": "BorderWidthIncreased",
      "conditions": [
        "window.__3D_STATE__.borderWidth === 0.02"
      ]
    },
    {
      "id": "S6",
      "name": "SeedRemoved",
      "conditions": [
        "window.__3D_STATE__.seedCount === 8",
        "window.__3D_STATE__.lastAction === 'removeSeed'"
      ]
    },
    {
      "id": "S7",
      "name": "UndoneRemoval",
      "conditions": [
        "window.__3D_STATE__.seedCount === 9",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S8",
      "name": "RedoneRemoval",
      "conditions": [
        "window.__3D_STATE__.seedCount === 8",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S9",
      "name": "AnimationActive",
      "conditions": [
        "window.__3D_STATE__.animationSpeed > 0",
        "window.__3D_STATE__.isAnimating === true"
      ]
    },
    {
      "id": "S10",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.seedCount === 8",
        "window.__3D_STATE__.lastAction === 'reset'",
        "window.__3D_STATE__.distanceMetric === 0"
      ]
    },
    {
      "id": "S11",
      "name": "MetricBackToEuclidean",
      "conditions": [
        "window.__3D_STATE__.distanceMetric === 0",
        "window.__3D_STATE__.distanceMetricName === 'Euclidean'"
      ]
    }
  ],
  "transitions": [
