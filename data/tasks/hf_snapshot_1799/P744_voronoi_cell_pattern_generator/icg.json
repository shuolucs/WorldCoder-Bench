      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.seedCount === 8",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.seeds) && window.__3D_STATE__.seeds.length === 8",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.seeds.every(s => typeof s.x === 'number' && typeof s.y === 'number' && !isNaN(s.x) && !isNaN(s.y))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.seeds.every(s => s.x >= 0.0 && s.x <= 1.0 && s.y >= 0.0 && s.y <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distanceMetric === 0 && window.__3D_STATE__.distanceMetricName === 'Euclidean'",
            "tier": "L2"
          }
        ]
      }
    },
