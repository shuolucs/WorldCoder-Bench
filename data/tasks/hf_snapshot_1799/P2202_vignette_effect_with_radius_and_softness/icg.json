  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultVignetteActive",
      "conditions": [
        "window.__3D_STATE__.vignetteEnabled === true",
        "window.__3D_STATE__.radius === 0.75",
        "window.__3D_STATE__.softness === 0.45",
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.activePreset === 'Custom'"
      ]
    },
    {
      "id": "S2",
      "name": "RadiusAdjusted",
      "conditions": [
        "window.__3D_STATE__.radius !== 0.75",
        "window.__3D_STATE__.uniformsSynced === true"
      ]
    },
    {
      "id": "S3",
      "name": "SoftnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.softness !== 0.45",
        "window.__3D_STATE__.uniformsSynced === true"
      ]
    },
    {
      "id": "S4",
      "name": "IntensityAdjusted",
      "conditions": [
        "window.__3D_STATE__.intensity !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "VignetteDisabled",
      "conditions": [
        "window.__3D_STATE__.vignetteEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "VignetteReEnabled",
      "conditions": [
        "window.__3D_STATE__.vignetteEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "CinematicPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Cinematic'",
        "window.__3D_STATE__.radius === 0.6"
      ]
    },
    {
      "id": "S8",
      "name": "WarmGlowPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Warm Glow'",
        "window.__3D_STATE__.tintColor === '#331100'"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.radius === 0.75",
        "window.__3D_STATE__.softness === 0.45",
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.vignetteEnabled === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vignetteEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius === 0.75 && window.__3D_STATE__.softness === 0.45 && window.__3D_STATE__.intensity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-radius'); s.value = 1.1; s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.radius === 1.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('slider-radius').value) - 1.1) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius >= 0.1 && window.__3D_STATE__.radius <= 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('label-radius') !== null && document.getElementById('label-radius').textContent.includes('1.1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-softness'); s.value = 0.8; s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.softness === 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('slider-softness').value) - 0.8) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.softness >= 0.05 && window.__3D_STATE__.softness <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius === 1.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-intensity'); s.value = 1.8; s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intensity === 1.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('slider-intensity').value) - 1.8) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity >= 0.0 && window.__3D_STATE__.intensity <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.radius) && !isNaN(window.__3D_STATE__.softness) && !isNaN(window.__3D_STATE__.intensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
