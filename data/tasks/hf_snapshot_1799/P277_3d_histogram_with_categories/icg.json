  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.barValues[0] === 4.0",
        "window.__3D_STATE__.barValues[1] === 7.0",
        "window.__3D_STATE__.barValues[2] === 3.0",
        "window.__3D_STATE__.barValues[3] === 5.5",
        "window.__3D_STATE__.barValues[4] === 6.0",
        "window.__3D_STATE__.totalValue === 25.5",
        "window.__3D_STATE__.selectedBarIndex === -1",
        "window.__3D_STATE__.sortState === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "BarSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBarIndex >= 0",
        "window.__3D_STATE__.selectedBarIndex <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "BarValueIncreased",
      "conditions": [
        "window.__3D_STATE__.barValues[window.__3D_STATE__.selectedBarIndex] > 4.0 || window.__3D_STATE__.selectedBarIndex !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "BarValueDecreased",
      "conditions": [
        "window.__3D_STATE__.totalValue < 25.5"
      ]
    },
    {
      "id": "S4",
      "name": "SortedAscending",
      "conditions": [
        "window.__3D_STATE__.sortState === 'ascending'"
      ]
    },
    {
      "id": "S5",
      "name": "SortedDescending",
      "conditions": [
        "window.__3D_STATE__.sortState === 'descending'"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeMode",
      "conditions": [
        "window.__3D_STATE__.wireframeMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "SolidMode",
      "conditions": [
        "window.__3D_STATE__.wireframeMode === false"
      ]
    },
    {
      "id": "S8",
      "name": "BarPulsing",
      "conditions": [
        "window.__3D_STATE__.pulsingBarIndex >= 0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.barValues[0] === 4.0",
        "window.__3D_STATE__.barValues[1] === 7.0",
        "window.__3D_STATE__.barValues[2] === 3.0",
        "window.__3D_STATE__.barValues[3] === 5.5",
        "window.__3D_STATE__.barValues[4] === 6.0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "FishOnNewTallest",
      "conditions": [
        "window.__3D_STATE__.fishLoaded === true"
      ]
    },
    {
      "id": "S11",
      "name": "MaxBarShifted",
      "conditions": [
        "window.__3D_STATE__.maxBarIndex !== 1"
      ]
    }
  ],
