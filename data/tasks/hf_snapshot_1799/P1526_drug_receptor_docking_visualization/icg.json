        "checks": [
          {
            "expr": "window.__3D_STATE__.receptorOpacity === 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dockingState === 'undocked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === 0.0",
            "tier": "L2"
