{
  "task_id": "P1526_drug_receptor_docking_visualization",
  "affordances": [
    {
      "id": "A1",
      "name": "ReceptorGroup",
      "type": "3d_object",
      "semantic": "Protein receptor binding pocket made of 12-16 spheres in horseshoe shape",
      "locator_hints": [
        "receptorGroup",
        "blue-purple spheres at origin"
      ]
    },
    {
      "id": "A2",
      "name": "LigandGroup",
      "type": "3d_object",
      "semantic": "Drug molecule made of 5 connected warm-colored spheres",
      "locator_hints": [
        "ligandGroup",
        "starts at x=10"
      ]
    },
    {
      "id": "A3",
      "name": "HydrogenBonds",
      "type": "3d_object",
      "semantic": "3 dashed green lines representing hydrogen bonds when docked",
      "locator_hints": [
        "green dashed lines",
        "bond indicators"
      ]
    },
    {
      "id": "A4",
      "name": "DockButton",
      "type": "dom_element",
      "semantic": "Button to start/stop docking animation",
      "locator_hints": [
        "#dockBtn"
      ]
    },
    {
      "id": "A5",
      "name": "BindingEnergyDisplay",
      "type": "dom_element",
      "semantic": "Shows binding energy in kcal/mol",
      "locator_hints": [
        "#bindingEnergy"
      ]
    },
    {
      "id": "A6",
      "name": "DistanceDisplay",
      "type": "dom_element",
      "semantic": "Shows live distance between ligand and receptor",
      "locator_hints": [
        "#distanceDisplay"
      ]
    },
    {
      "id": "A7",
      "name": "StatusText",
      "type": "dom_element",
      "semantic": "Shows current docking state text",
      "locator_hints": [
        "#statusText"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Undocked",
      "conditions": [
        "window.__3D_STATE__.dockingState === 'undocked'",
        "window.__3D_STATE__.ligandPosition.x >= 9.5",
        "window.__3D_STATE__.bindingEnergy === 0.0",
        "window.__3D_STATE__.bondsVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "Docking_In_Progress",
      "conditions": [
        "window.__3D_STATE__.dockingState === 'docking'",
        "window.__3D_STATE__.animationProgress > 0 && window.__3D_STATE__.animationProgress < 1",
        "window.__3D_STATE__.distance < 10"
      ]
    },
    {
      "id": "S2",
      "name": "Fully_Docked",
      "conditions": [
        "window.__3D_STATE__.dockingState === 'docked'",
        "window.__3D_STATE__.distance < 1.0",
        "window.__3D_STATE__.bindingEnergy === -8.3",
        "window.__3D_STATE__.bondsVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "Receptor_Opaque",
      "conditions": [
        "window.__3D_STATE__.receptorOpacity === 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "Bonds_Toggled_Off",
      "conditions": [
        "window.__3D_STATE__.dockingState === 'docked'",
        "window.__3D_STATE__.bondsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Undocking_Complete",
      "conditions": [
        "window.__3D_STATE__.dockingState === 'undocked'",
        "window.__3D_STATE__.ligandPosition.x >= 9.5",
        "window.__3D_STATE__.bondsVisible === false",
        "window.__3D_STATE__.bindingEnergy === 0.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.dockingState === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dockingState === 'undocked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.receptorAtomCount >= 12 && window.__3D_STATE__.receptorAtomCount <= 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ligandAtomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ligandPosition.x) && window.__3D_STATE__.ligandPosition.x >= 9.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#dockBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dockingState === 'docking'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationProgress >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusText').textContent.toLowerCase().includes('docking')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dockingState === 'docked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distance < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === -8.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondsVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hydrogenBondCount === 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('dockBtn').textContent.toLowerCase().includes('undock')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.receptorOpacity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dockingState === 'docked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondsVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === -8.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
