      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bondsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dockingState === 'docked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === -8.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distance < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bondsVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dockingState === 'docked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hydrogenBondCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === -8.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('dockBtn').click(); await new Promise(r => setTimeout(r, 2500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dockingState === 'undocked'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ligandPosition.x >= 9.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bindingEnergy === 0.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.distance) && window.__3D_STATE__.distance >= 9.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('dockBtn').textContent.toLowerCase().includes('start')",
            "tier": "L2"
          }
        ]
