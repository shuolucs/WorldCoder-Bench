    {
      "id": "A7",
      "name": "SliderTilt",
      "type": "dom_element",
      "semantic": "Table tilt angle slider",
      "locator_hints": ["slider-tilt"]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Game loaded, ball ready to launch, score 0",
      "conditions": ["window.__3D_STATE__ !== undefined"]
    },
    {
      "id": "S1",
      "name": "playing",
      "description": "Ball in play, rolling on table"
    },
    {
      "id": "S2",
      "name": "flippers_tested",
      "description": "Flippers activated and ball redirected"
    },
    {
      "id": "S3",
      "name": "multi_ball",
      "description": "Multiple balls active on the table"
    },
    {
      "id": "S4",
      "name": "tilt_changed",
      "description": "Table tilt angle adjusted"
    },
    {
      "id": "S5",
      "name": "stable_play",
      "description": "Extended play session, physics stable"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1500},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.score === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.lives === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.activeBalls === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.tiltAngle === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.leftFlipperAngle === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.rightFlipperAngle === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.gameOver === 'boolean'", "tier": "L0"},
          {"expr": "window.__3D_STATE__.lives > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.score >= 0", "tier": "L1"}
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 3000,
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "window.__3D_STATE__.activeBalls >= 1", "tier": "L1"},
          {"expr": "Array.isArray(window.__3D_STATE__.ballPositions) && window.__3D_STATE__.ballPositions.length >= 1", "tier": "L1"},
          {"expr": "(function(){ const bp = window.__3D_STATE__.ballPositions; return bp.length > 0 && isFinite(bp[0].x) && isFinite(bp[0].z); })()", "tier": "L0"},
          {"expr": "window.__3D_STATE__.lives > 0", "tier": "L1"},
          {"expr": "!window.__3D_STATE__.gameOver", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {"type": "keyboard", "key": "Shift"},
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1500,
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.leftFlipperAngle === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.rightFlipperAngle === 'number'", "tier": "L0"},
          {"expr": "window.__3D_STATE__.activeBalls >= 1 || window.__3D_STATE__.lives >= 0", "tier": "L1"},
          {"expr": "isFinite(window.__3D_STATE__.leftFlipperAngle) && isFinite(window.__3D_STATE__.rightFlipperAngle)", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {"type": "keyboard", "key": "m"},
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 2000,
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.activeBalls === 'number'", "tier": "L0"},
          {"expr": "window.__3D_STATE__.activeBalls >= 1", "tier": "L1"},
          {"expr": "Array.isArray(window.__3D_STATE__.ballPositions)", "tier": "L0"},
          {"expr": "(function(){ const bp = window.__3D_STATE__.ballPositions; return bp.every(b => isFinite(b.x) && isFinite(b.z)); })()", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('slider-tilt'); s.value = 10; s.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 3000,
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.tiltAngle === 'number'", "tier": "L0"},
          {"expr": "Math.abs(window.__3D_STATE__.tiltAngle - 10) < 1.5", "tier": "L1"},
          {"expr": "isFinite(window.__3D_STATE__.tiltAngle)", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 10000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "window.__3D_STATE__.simTime > 10", "tier": "L1"},
          {"expr": "typeof window.__3D_STATE__.score === 'number' && window.__3D_STATE__.score >= 0", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.lives === 'number'", "tier": "L0"},
          {"expr": "isFinite(window.__3D_STATE__.score) && isFinite(window.__3D_STATE__.lives)", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S0",
      "severity": "P1",
      "action": {"type": "keyboard", "key": "n"},
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1000,
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined", "tier": "L0"},
          {"expr": "window.__3D_STATE__.score === 0", "tier": "L2"},
          {"expr": "window.__3D_STATE__.lives > 0", "tier": "L1"},
          {"expr": "!window.__3D_STATE__.gameOver", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.keys(s).filter(k => typeof s[k] === 'number').every(k => isFinite(s[k])); })()", "tier": "L0"}
        ]
      }
    }
