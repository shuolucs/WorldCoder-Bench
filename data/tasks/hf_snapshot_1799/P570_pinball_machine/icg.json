{
  "task_id": "P570_pinball_machine",
  "affordances": [
    {
      "id": "A1",
      "name": "PinballTable",
      "type": "3d_object",
      "semantic": "Tilted playfield with lavatile.jpg texture and walls",
      "locator_hints": ["table", "playfield", "surface"]
    },
    {
      "id": "A2",
      "name": "Balls",
      "type": "3d_object",
      "semantic": "Chrome pinball(s) rolling on the table",
      "locator_hints": ["ball", "sphere", "pinball"]
    },
    {
      "id": "A3",
      "name": "Bumpers",
      "type": "3d_object",
      "semantic": "5 circular bumpers with spring bounce",
      "locator_hints": ["bumper", "cylinder"]
    },
    {
      "id": "A4",
      "name": "Flippers",
      "type": "3d_object",
      "semantic": "Left and right flippers controlled by Shift keys",
      "locator_hints": ["flipper", "paddle"]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score, lives, combo display",
      "locator_hints": ["hud", "hud-score", "hud-lives"]
    },
    {
      "id": "A6",
      "name": "PowerBar",
      "type": "dom_element",
      "semantic": "Ball launcher power charge indicator",
