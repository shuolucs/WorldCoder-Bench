  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.gameState === 'ready'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.bricksRemaining === 25"
      ]
    },
    {
      "id": "S1",
      "name": "Ball_Launched",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.ballVelocity.z < 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paddle_Moved_Right",
      "conditions": [
        "window.__3D_STATE__.paddleX > 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "Paddle_Moved_Left",
      "conditions": [
        "window.__3D_STATE__.paddleX < -0.5"
      ]
    },
    {
      "id": "S4",
      "name": "First_Brick_Destroyed",
      "conditions": [
        "window.__3D_STATE__.totalBricksDestroyed >= 1",
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.speedMultiplier > 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "Debug_Visible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "Debug_Hidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.gameState === 'paused'"
      ]
    },
    {
      "id": "S8",
      "name": "Game_Unpaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S9",
      "name": "Dragon_Damaged",
      "conditions": [
        "window.__3D_STATE__.dragonHP < 10",
        "window.__3D_STATE__.dragonAlive === true"
      ]
    },
    {
      "id": "S10",
      "name": "Dragon_Destroyed",
      "conditions": [
        "window.__3D_STATE__.dragonHP === 0",
        "window.__3D_STATE__.dragonAlive === false"
      ]
    },
    {
      "id": "S11",
      "name": "Life_Lost",
      "conditions": [
        "window.__3D_STATE__.lives < 3"
      ]
    },
    {
      "id": "S12",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.gameState === 'ready'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3"
      ]
    }
  ],
