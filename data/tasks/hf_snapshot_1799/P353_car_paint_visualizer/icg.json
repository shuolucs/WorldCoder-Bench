{
  "task_id": "P353_car_paint_visualizer",
  "affordances": [
    {
      "id": "A1",
      "name": "XbotModel",
      "type": "3d_object",
      "semantic": "The loaded Xbot.glb model used as the product to paint",
      "locator_hints": [
        "scene.children",
        "GLTF model at origin"
      ]
    },
    {
      "id": "A2",
      "name": "ColorButtons",
      "type": "dom_element",
      "semantic": "Six color swatch buttons for paint selection",
      "locator_hints": [
        ".color-btn"
      ]
    },
    {
      "id": "A3",
      "name": "FinishButtons",
      "type": "dom_element",
      "semantic": "Three finish type buttons (glossy, matte, metallic)",
      "locator_hints": [
        ".finish-btn"
      ]
    },
    {
      "id": "A4",
      "name": "RotateToggle",
      "type": "dom_element",
      "semantic": "Toggle button for auto-rotation",
      "locator_hints": [
        "#rotate-toggle"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset button to restore defaults",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A6",
      "name": "InfoDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current color and finish",
      "locator_hints": [
        "#info-display"
      ]
    },
    {
      "id": "A7",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Top-left panel with all controls",
      "locator_hints": [
        "#control-panel"
      ]
    },
    {
      "id": "A8",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Reflective ground plane",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentColor === '#cc0000'",
        "window.__3D_STATE__.currentFinish === 'glossy'",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S2",
      "name": "BluePaintApplied",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#0055aa'",
        "window.__3D_STATE__.currentColorName === 'Ocean Blue'"
      ]
    },
    {
      "id": "S3",
      "name": "MatteFinishApplied",
      "conditions": [
        "window.__3D_STATE__.currentFinish === 'matte'",
        "window.__3D_STATE__.metalness === 0.1",
        "window.__3D_STATE__.roughness === 0.9"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S6",
      "name": "OrangeMetallic",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#ff6600'",
        "window.__3D_STATE__.currentFinish === 'metallic'"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefault",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#cc0000'",
        "window.__3D_STATE__.currentFinish === 'glossy'",
        "window.__3D_STATE__.autoRotate === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColor === '#cc0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'glossy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 1.5 && window.__3D_STATE__.cameraDistance <= 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": ".color-btn[data-color='#0055aa']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentColor === '#0055aa'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColorName === 'Ocean Blue'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'glossy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.metalness === 0.9",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('info-display').textContent.includes('Ocean Blue')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": ".finish-btn[data-finish='matte']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentFinish === 'matte'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.metalness - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - 0.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColor === '#0055aa'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('info-display').textContent.includes('Matte')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#rotate-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const rotBefore = window.__3D_STATE__.modelRotationY; await new Promise(r => setTimeout(r, 500)); const rotAfter = window.__3D_STATE__.modelRotationY; window.__TEST_ROT_DELTA__ = rotAfter - rotBefore; document.getElementById('rotate-toggle').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__TEST_ROT_DELTA__ > 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 1.5 && window.__3D_STATE__.cameraDistance <= 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('.color-btn[data-color=\"#ff6600\"]').click(); await new Promise(r => setTimeout(r, 100)); document.querySelector('.finish-btn[data-finish=\"metallic\"]').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentColor === '#ff6600'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColorName === 'Sunset Orange'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'metallic'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.metalness - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - 0.3) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentColor === '#cc0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColorName === 'Ruby Red'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'glossy'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.metalness - 0.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}