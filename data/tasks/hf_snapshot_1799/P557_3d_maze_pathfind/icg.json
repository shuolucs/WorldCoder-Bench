{
  "task_id": "P557_3d_maze_pathfind",
  "affordances": [
    {"id": "A1", "name": "MazeWalls", "type": "3d_object", "semantic": "Textured wall boxes forming the maze", "locator_hints": ["box meshes with brick texture"]},
    {"id": "A2", "name": "Player", "type": "3d_object", "semantic": "First-person camera + flashlight", "locator_hints": ["camera", "point light"]},
    {"id": "A3", "name": "PathOverlay", "type": "3d_object", "semantic": "Green floor cubes showing A* path", "locator_hints": ["small green cubes on floor"]},
    {"id": "A4", "name": "Minimap", "type": "dom_element", "semantic": "Canvas minimap overlay", "locator_hints": ["canvas element top-right"]},
    {"id": "A5", "name": "ExitMarker", "type": "3d_object", "semantic": "Glowing green pillar at exit", "locator_hints": ["green emissive cylinder"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.status === 'Playing'", "window.__3D_STATE__.playerCell.x === 0"]},
    {"id": "S1", "name": "Moving", "conditions": ["window.__3D_STATE__.frameCount > 30"]},
    {"id": "S2", "name": "PathEnabled", "conditions": ["window.__3D_STATE__.pathfindingEnabled === true"]},
    {"id": "S3", "name": "NewMaze", "conditions": ["window.__3D_STATE__.elapsedTime < 1"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.playerCell.x === 0 && window.__3D_STATE__.playerCell.y === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.mazeSize === 15", "tier": "L1"},
        {"expr": "window.__3D_STATE__.status === 'Playing'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.playerValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.distToExit > 0", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "p"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.pathfindingEnabled === true", "tier": "L2"},
        {"expr": "window.__3D_STATE__.pathLength > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "w"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.playerValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.wallCollisions >= 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "n"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.playerValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.mazeSize === 15", "tier": "L1"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.playerCell.x === 0 && window.__3D_STATE__.playerCell.y === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.status === 'Playing'", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "m"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.minimapEnabled !== before.minimapEnabled", "tier": "L2"}
      ]}
    }
  ]
}
