  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.physicsRunning === false",
        "window.__3D_STATE__.gradingEnabled === true",
        "window.__3D_STATE__.intensity === 0.5",
        "window.__3D_STATE__.brightness === 0",
        "window.__3D_STATE__.contrast === 1.0",
        "window.__3D_STATE__.activePreset === 'Custom'",
        "window.__3D_STATE__.debugOverlayVisible === true",
        "window.__3D_STATE__.sphereCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "PhysicsStarted",
      "conditions": [
        "window.__3D_STATE__.physicsRunning === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PhysicsPaused",
      "conditions": [
        "window.__3D_STATE__.physicsRunning === false",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "PresetApplied",
      "conditions": [
        "window.__3D_STATE__.activePreset !== 'Custom'"
      ]
    },
    {
      "id": "S4",
      "name": "GradingDisabled",
      "conditions": [
        "window.__3D_STATE__.gradingEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "IntensityAdjusted",
      "conditions": [
        "window.__3D_STATE__.intensity !== 0.5"
      ]
    },
    {
      "id": "S6",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S7",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.historyIndex > 0"
      ]
    },
    {
      "id": "S8",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.physicsRunning === false",
        "window.__3D_STATE__.intensity === 0.5",
        "window.__3D_STATE__.brightness === 0",
        "window.__3D_STATE__.contrast === 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "PhysicsAdvanced",
      "conditions": [
        "window.__3D_STATE__.frameCount > 60"
      ]
    },
    {
      "id": "S11",
      "name": "BounceOccurred",
      "conditions": [
        "window.__3D_STATE__.spheres.some(s => s.vy > 0)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.physicsRunning === 'boolean' && window.__3D_STATE__.physicsRunning === false",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.spheres) && window.__3D_STATE__.spheres.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spheres.every(s => typeof s.y === 'number' && Math.abs(s.y - 3) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gradingEnabled === true && window.__3D_STATE__.intensity === 0.5 && window.__3D_STATE__.brightness === 0 && window.__3D_STATE__.contrast === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gradientMapSize === 256 && window.__3D_STATE__.restitution === 0.7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-physics"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.physicsRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.initialTotalEnergy === 'number' && window.__3D_STATE__.initialTotalEnergy > 0",
            "tier": "L0"
          },
          {
            "expr": "document.querySelector('#btn-toggle-physics').textContent.toLowerCase().includes('pause')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spheres.every(s => !isNaN(s.y) && !isNaN(s.vy) && s.y >= 0.49)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy <= window.__3D_STATE__.initialTotalEnergy + 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spheres.every(s => typeof s.vx === 'number' && typeof s.vy === 'number' && typeof s.vz === 'number')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spheres.some(s => s.y < 2.9)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S10",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.physicsRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 60",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var fc = window.__3D_STATE__.frameCount; return typeof fc === 'number' && fc > 0; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spheres.every(s => s.y >= 0.49 && !isNaN(s.y))",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#btn-toggle-physics').textContent.toLowerCase().includes('start')",
            "tier": "L2"
          }
        ]
      }
    },
    {
