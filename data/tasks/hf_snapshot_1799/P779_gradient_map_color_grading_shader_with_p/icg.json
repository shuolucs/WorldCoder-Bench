          },
          {
            "expr": "Math.abs(window.__3D_STATE__.brightness - 0.05) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.contrast - 1.3) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.querySelector('#intensity-slider').value) - 0.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#preset-select').value === 'Cinematic'",
            "tier": "L2"
          }
        ]
      }
    },
