{
  "task_id": "P315_advanced_traffic_flow_simulation_with_sc",
  "affordances": [
    {
      "id": "A1",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark gray ground plane forming the road area",
      "locator_hints": [
        "100x100 plane at y=0"
      ]
    },
    {
      "id": "A2",
      "name": "Monument",
      "type": "3d_object",
      "semantic": "DamagedHelmet.glb model as roadside sculpture",
      "locator_hints": [
        "position (20, 2, 20)",
        "scale (2,2,2)"
      ]
    },
    {
      "id": "A3",
      "name": "TrafficLights",
      "type": "3d_object",
      "semantic": "4 traffic light posts at intersection corners",
      "locator_hints": [
        "positions at ±7, 0, ±7"
      ]
    },
    {
      "id": "A4",
      "name": "Vehicles",
      "type": "3d_object",
      "semantic": "Colored box vehicles moving through intersection",
      "locator_hints": [
        "2x1x3 boxes"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score and stats overlay",
      "locator_hints": [
        "div#hud",
        "top-left"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedToggleButton",
      "type": "dom_element",
      "semantic": "Button to cycle simulation speed",
      "locator_hints": [
        "button#speed-toggle"
      ]
    },
    {
      "id": "A7",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "Shows current score",
      "locator_hints": [
        "#score-display"
      ]
    },
    {
      "id": "A8",
      "name": "PhaseDisplay",
      "type": "dom_element",
      "semantic": "Shows current traffic phase",
      "locator_hints": [
        "#phase-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.vehiclesSpawned === 0",
        "window.__3D_STATE__.vehiclesCompleted === 0",
        "window.__3D_STATE__.collisions === 0",
        "window.__3D_STATE__.trafficPhase === 'A'",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simSpeed === 1",
        "window.__3D_STATE__.vehicleCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "MonumentLoaded",
      "conditions": [
        "window.__3D_STATE__.monumentLoaded === true",
        "window.__3D_STATE__.monument !== null && window.__3D_STATE__.monument !== undefined"
      ]
    },
    {
      "id": "S2",
      "name": "VehiclesSpawning",
      "conditions": [
        "window.__3D_STATE__.vehiclesSpawned > 0",
        "window.__3D_STATE__.vehicleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "PhaseToggled",
      "conditions": [
        "window.__3D_STATE__.trafficPhase === 'B'"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.simSpeed === 2"
      ]
    },
    {
      "id": "S7",
      "name": "VehiclesCompleting",
      "conditions": [
        "window.__3D_STATE__.vehiclesCompleted > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.vehiclesSpawned === 0",
        "window.__3D_STATE__.vehiclesCompleted === 0",
        "window.__3D_STATE__.collisions === 0",
        "window.__3D_STATE__.vehicleCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "ManualSpawnTriggered",
      "conditions": [
        "window.__3D_STATE__.vehiclesSpawned >= 1",
        "window.__3D_STATE__.vehicleCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.monument !== null && window.__3D_STATE__.monument !== undefined",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.monument.position.x - 20) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.monument.position.z - 20) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.monument.scale.x - 2) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.trafficPhase === 'B'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
