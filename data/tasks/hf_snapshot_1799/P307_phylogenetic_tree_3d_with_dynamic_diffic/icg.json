  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.treeDepth === 3",
        "window.__3D_STATE__.totalNodes > 0",
        "window.__3D_STATE__.colorMode === 'depth'",
        "window.__3D_STATE__.labelsVisible === false",
        "window.__3D_STATE__.spinEnabled === false",
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.treeGenCount === 1"
      ]
    },
    {
      "id": "S1",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.treeDepth === 4",
        "window.__3D_STATE__.treeGenCount === 2"
      ]
    },
    {
      "id": "S2",
      "name": "MaxDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.treeDepth === 7"
      ]
    },
    {
      "id": "S3",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId !== null",
        "window.__3D_STATE__.selectedNodeDepth !== null",
        "window.__3D_STATE__.selectedNodeDescendants !== null"
      ]
    },
    {
      "id": "S4",
      "name": "NodeDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.selectedNodeDepth === null"
      ]
    },
    {
      "id": "S5",
      "name": "CladeColorMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'clade'"
      ]
    },
    {
      "id": "S6",
      "name": "DepthColorMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'depth'"
      ]
    },
    {
      "id": "S7",
      "name": "LabelsOn",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "SpinEnabled",
      "conditions": [
        "window.__3D_STATE__.spinEnabled === true"
      ]
    },
    {
      "id": "S9",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 0) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 5) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 25) < 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "DifficultyDecreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 4",
        "window.__3D_STATE__.treeDepth === 6"
      ]
    }
  ],
