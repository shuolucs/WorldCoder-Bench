      "action": {
        "type": "script",
        "code": "(() => { const wait = ms => new Promise(r => setTimeout(r, ms)); async function build() { await wait(2500); const addBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Add to Sequence')); if(addBtn) { addBtn.click(); await wait(100); const circleBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Circle')); if(circleBtn) circleBtn.click(); await wait(2500); addBtn.click(); } } build(); })()"
      },
