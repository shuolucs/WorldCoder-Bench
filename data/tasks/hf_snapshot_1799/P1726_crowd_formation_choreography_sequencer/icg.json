  "states": [
    {
      "id": "S0",
      "name": "InitialGridFormation",
      "conditions": [
        "window.__3D_STATE__.currentFormation === 'grid'",
        "window.__3D_STATE__.agentCount === 36",
        "window.__3D_STATE__.isTransitioning === false",
        "window.__3D_STATE__.sequence.length === 0"
      ]
    },
    {
      "id": "S1",
      "name": "TransitioningToCircle",
      "conditions": [
        "window.__3D_STATE__.isTransitioning === true",
        "window.__3D_STATE__.targetFormation === 'circle'"
      ]
    },
    {
      "id": "S2",
      "name": "CircleFormationReached",
      "conditions": [
        "window.__3D_STATE__.currentFormation === 'circle'",
        "window.__3D_STATE__.isTransitioning === false",
        "window.__3D_STATE__.transitionProgress === 1 || window.__3D_STATE__.transitionProgress === 0"
      ]
    },
    {
      "id": "S3",
      "name": "VShapeFormationReached",
      "conditions": [
        "window.__3D_STATE__.currentFormation === 'vShape'",
        "window.__3D_STATE__.isTransitioning === false"
      ]
    },
    {
      "id": "S4",
      "name": "SequenceBuilt",
      "conditions": [
        "window.__3D_STATE__.sequence.length >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "SequencePlaying",
      "conditions": [
        "window.__3D_STATE__.isPlayingSequence === true",
        "window.__3D_STATE__.sequenceIndex >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "SequenceStopped",
      "conditions": [
        "window.__3D_STATE__.isPlayingSequence === false"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedModified",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "QueuedFormationPending",
      "conditions": [
        "window.__3D_STATE__.isTransitioning === true",
        "window.__3D_STATE__.queuedFormation !== null"
      ]
    },
    {
      "id": "S9",
      "name": "SequenceCleared",
      "conditions": [
        "window.__3D_STATE__.sequence.length === 0",
        "window.__3D_STATE__.isPlayingSequence === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentCount === 36",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.agentPositions) && window.__3D_STATE__.agentPositions.length === 36",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentFormation === 'grid'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.formationNames) && window.__3D_STATE__.formationNames.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentPositions.every(p => typeof p.x === 'number' && !isNaN(p.x) && typeof p.z === 'number' && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isTransitioning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetFormation === 'circle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transitionProgress >= 0.0 && window.__3D_STATE__.transitionProgress <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agentPositions.every(p => Math.sqrt(p.x*p.x + p.z*p.z) <= 20)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agentPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z) && isFinite(p.x) && isFinite(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
