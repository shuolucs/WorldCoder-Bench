            "expr": "window.__3D_STATE__.isTransitioning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agentPositions.filter(p => Math.abs(Math.sqrt(p.x*p.x + p.z*p.z) - 8) < 1.0).length >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agentPositions.every(p => Math.abs(p.y) < 2.0)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('currentFormation') !== null && document.getElementById('currentFormation').textContent.toLowerCase().includes('circle')",
            "tier": "L2"
