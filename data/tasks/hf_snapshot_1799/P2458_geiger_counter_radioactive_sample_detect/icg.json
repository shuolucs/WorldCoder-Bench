            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedCPM > 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.detectedCPM)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedCPM >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectionRadius === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samples.every(s => typeof s.currentCPM === 'number' && !isNaN(s.currentCPM))",
            "tier": "L2"
          }
        ]
      }
    },
    {
