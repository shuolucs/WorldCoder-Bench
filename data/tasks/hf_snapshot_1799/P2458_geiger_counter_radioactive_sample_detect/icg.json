{
  "task_id": "P2458_geiger_counter_radioactive_sample_detect",
  "affordances": [
    {
      "id": "A1",
      "name": "GeigerCounterWand",
      "type": "3d_object",
      "semantic": "Movable Geiger counter wand for detecting radiation from samples",
      "locator_hints": [
        "cylinder with sphere tip",
        "child of facecap model"
      ]
    },
    {
      "id": "A2",
      "name": "RadioactiveSamples",
      "type": "3d_object",
      "semantic": "Array of 5 radioactive sample spheres with different CPM levels on the bench",
      "locator_hints": [
        "small glowing spheres",
        "sample rack area around x=-2 to x=0"
      ]
    },
    {
      "id": "A3",
      "name": "FaceCapModel",
      "type": "3d_object",
      "semantic": "Loaded facecap.glb model serving as detector apparatus housing",
      "locator_hints": [
        "GLTF model at (2, 1.5, 0)",
        "scaled 0.3"
      ]
    },
    {
      "id": "A4",
      "name": "ShieldButton",
      "type": "dom_element",
      "semantic": "Button to apply lead shielding to nearest sample",
      "locator_hints": [
        "#btn-shield"
      ]
    },
    {
      "id": "A5",
      "name": "UnshieldButton",
      "type": "dom_element",
      "semantic": "Button to remove lead shielding from nearest sample",
      "locator_hints": [
        "#btn-unshield"
      ]
    },
    {
      "id": "A6",
      "name": "RadiationBar",
      "type": "dom_element",
      "semantic": "Visual bar showing detected radiation level with color coding",
      "locator_hints": [
        "bottom-center div bar"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing CPM, status, elapsed time",
      "locator_hints": [
        "top-left panel"
      ]
    },
    {
      "id": "A8",
      "name": "SampleTable",
      "type": "dom_element",
      "semantic": "Top-right table listing all 5 samples with their properties",
      "locator_hints": [
        "top-right panel table"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.geigerOn === false",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.heldSampleIndex === -1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GeigerActivated",
      "conditions": [
        "window.__3D_STATE__.geigerOn === true",
        "window.__3D_STATE__.detectedCPM >= 5"
      ]
    },
    {
      "id": "S2",
      "name": "WandMoved",
      "conditions": [
        "window.__3D_STATE__.undoStackSize > 0",
        "Math.abs(window.__3D_STATE__.wandPosition.x) <= 3"
      ]
    },
    {
      "id": "S3",
      "name": "NearSampleDetecting",
      "conditions": [
        "window.__3D_STATE__.geigerOn === true",
        "window.__3D_STATE__.detectedCPM > 20"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S5",
      "name": "DecayProgressed",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SampleHeld",
      "conditions": [
        "window.__3D_STATE__.heldSampleIndex >= 0",
        "window.__3D_STATE__.heldSampleIndex < 5"
      ]
    },
    {
      "id": "S7",
      "name": "SampleShielded",
      "conditions": [
        "window.__3D_STATE__.samples.some(s => s.shielded === true)"
      ]
    },
    {
      "id": "S8",
      "name": "SampleUnshielded",
      "conditions": [
        "window.__3D_STATE__.samples.every(s => s.shielded === false)"
      ]
    },
    {
      "id": "S9",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S10",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0"
      ]
    },
    {
      "id": "S11",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.samples[0].currentCPM === 10"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.geigerOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.geigerOn === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.detectedCPM === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.detectedCPM)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedCPM >= window.__3D_STATE__.backgroundCPM",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.backgroundCPM === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "repeat": 20
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wandPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.wandPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.wandPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wandPosition.x >= -3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
