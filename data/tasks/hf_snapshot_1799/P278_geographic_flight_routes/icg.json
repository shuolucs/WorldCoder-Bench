{
  "task_id": "P278_geographic_flight_routes",
  "affordances": [
    {
      "id": "A1",
      "name": "Globe",
      "type": "3d_object",
      "semantic": "Earth sphere with wireframe overlay",
      "locator_hints": [
        "blue sphere at origin",
        "radius 5"
      ]
    },
    {
      "id": "A2",
      "name": "CityMarkers",
      "type": "3d_object",
      "semantic": "5 small red spheres on globe surface representing cities",
      "locator_hints": [
        "red spheres",
        "radius 0.12"
      ]
    },
    {
      "id": "A3",
      "name": "FlightRoutes",
      "type": "3d_object",
      "semantic": "4 colored arc lines connecting cities",
      "locator_hints": [
        "curved lines above globe"
      ]
    },
    {
      "id": "A4",
      "name": "Planes",
      "type": "3d_object",
      "semantic": "4 small meshes animating along route arcs",
      "locator_hints": [
        "small cones or triangles on arcs"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleRoutesButton",
      "type": "dom_element",
      "semantic": "Button to toggle route visibility",
      "locator_hints": [
        "#toggleRoutes"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedToggleButton",
      "type": "dom_element",
      "semantic": "Button to cycle animation speed",
      "locator_hints": [
        "#speedToggle"
      ]
    },
    {
      "id": "A7",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing city/route/selection info",
      "locator_hints": [
        "#infoPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.cityCount === 5",
        "window.__3D_STATE__.routeCount === 4",
        "window.__3D_STATE__.routesVisible === true",
        "window.__3D_STATE__.selectedCity === null",
        "window.__3D_STATE__.speedMultiplier === 1"
      ]
    },
    {
      "id": "S1",
      "name": "RoutesHidden",
      "conditions": [
        "window.__3D_STATE__.routesVisible === false"
      ]
    },
    {
      "id": "S2",
      "name": "RoutesVisible",
      "conditions": [
        "window.__3D_STATE__.routesVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "CitySelected",
      "conditions": [
        "window.__3D_STATE__.selectedCity !== null",
        "typeof window.__3D_STATE__.selectedCity === 'string'"
      ]
    },
    {
      "id": "S4",
      "name": "Speed2x",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedHalf",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleRoutes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleRoutes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#speedToggle').textContent.includes('2x')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#speedToggle').textContent.includes('0.5x')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#speedToggle').textContent.includes('1x')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}