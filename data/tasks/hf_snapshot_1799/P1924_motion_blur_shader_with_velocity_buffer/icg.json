  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === true",
        "window.__3D_STATE__.blurStrength === 1.0",
        "window.__3D_STATE__.sampleCount === 8",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.velocityBufferActive === true"
      ]
    },
    {
      "id": "S1",
      "name": "BlurDisabled",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === false",
        "window.__3D_STATE__.velocityBufferActive === false"
      ]
    },
    {
      "id": "S2",
      "name": "BlurReEnabled",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === true",
        "window.__3D_STATE__.velocityBufferActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S4",
      "name": "AnimationResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "BlurStrengthChanged",
      "conditions": [
        "window.__3D_STATE__.blurStrength === 2.5"
      ]
    },
    {
      "id": "S6",
      "name": "SampleCountChanged",
      "conditions": [
        "window.__3D_STATE__.sampleCount === 16"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedMultiplierChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 3.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.spherePositions) && window.__3D_STATE__.spherePositions.length === 3",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.sphereVelocitiesScreenSpace) && window.__3D_STATE__.sphereVelocitiesScreenSpace.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0 && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleBlur"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityBufferActive === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleBlur').textContent.toLowerCase().includes('enable')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => Math.abs(p.y - 1) < 0.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleBlur"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityBufferActive === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleBlur').textContent.toLowerCase().includes('disable')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.toLowerCase().includes('resume')",
            "tier": "L2"
          },
          {
            "expr": "(()=>{ const before = JSON.parse(JSON.stringify(window.__3D_STATE__.spherePositions)); return new Promise(r => setTimeout(()=>{ const after = window.__3D_STATE__.spherePositions; r(Math.abs(before[0].x - after[0].x) < 0.001 && Math.abs(before[0].z - after[0].z) < 0.001); }, 500)); })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocitiesScreenSpace.every(v => Math.abs(v.x) < 0.01 && Math.abs(v.y) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.toLowerCase().includes('pause')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fps > 0 && !isNaN(window.__3D_STATE__.fps)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('blurStrength').value = 2.5; document.getElementById('blurStrength').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurStrength === 2.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blurStrength').value === '2.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blurStrengthValue') !== null && document.getElementById('blurStrengthValue').textContent.includes('2.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityBufferActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sampleCount').value = '16'; document.getElementById('sampleCount').dispatchEvent(new Event('change', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sampleCount === 16",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('sampleCount').value === '16'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedMultiplier').value = 3.0; document.getElementById('speedMultiplier').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 3.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedMultiplier').value === '3'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedMultiplierValue') !== null && document.getElementById('speedMultiplierValue').textContent.includes('3')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => Math.sqrt(p.x*p.x + p.z*p.z) > 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.x) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}