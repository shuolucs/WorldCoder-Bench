    {
      "id": "S0",
      "name": "ModelsLoading",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === false || window.__3D_STATE__.modelsLoaded === undefined"
      ]
    },
    {
      "id": "S1",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.progress === 0",
        "window.__3D_STATE__.autoPlay === false",
        "window.__3D_STATE__.phase === 'idle' || window.__3D_STATE__.phase === 'dissolve_out'"
      ]
    },
    {
      "id": "S2",
      "name": "AutoPlayForward",
      "conditions": [
        "window.__3D_STATE__.autoPlay === true",
        "window.__3D_STATE__.direction === 1"
      ]
    },
    {
      "id": "S3",
      "name": "MidTransitionDissolve",
      "conditions": [
        "window.__3D_STATE__.progress > 0.05 && window.__3D_STATE__.progress < 0.4",
        "window.__3D_STATE__.phase === 'dissolve_out'"
      ]
    },
    {
      "id": "S4",
      "name": "MidTransitionMorph",
      "conditions": [
        "window.__3D_STATE__.progress >= 0.4 && window.__3D_STATE__.progress <= 0.6",
        "window.__3D_STATE__.phase === 'morph'"
      ]
    },
    {
      "id": "S5",
      "name": "MidTransitionResolve",
      "conditions": [
        "window.__3D_STATE__.progress > 0.6 && window.__3D_STATE__.progress < 1.0",
        "window.__3D_STATE__.phase === 'resolve_in'"
      ]
    },
    {
      "id": "S6",
      "name": "FullyCity",
      "conditions": [
        "window.__3D_STATE__.progress >= 0.98",
        "window.__3D_STATE__.activeModel === 'city'"
      ]
    },
    {
      "id": "S7",
      "name": "CustomColors",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'custom'"
      ]
    },
    {
      "id": "S8",
      "name": "LargeParticles",
      "conditions": [
        "window.__3D_STATE__.particleSize === 4.0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.progress === 0",
        "window.__3D_STATE__.autoPlay === false"
      ]
    }
  ],
