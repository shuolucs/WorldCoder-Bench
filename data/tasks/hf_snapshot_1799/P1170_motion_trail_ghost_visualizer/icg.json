        "#btn-clear"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling animation speed multiplier",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A6",
      "name": "LifetimeSlider",
      "type": "dom_element",
      "semantic": "Slider controlling ghost lifetime duration",
      "locator_hints": [
        "#slider-lifetime"
      ]
    },
    {
      "id": "A7",
      "name": "ColorCycleButton",
      "type": "dom_element",
      "semantic": "Toggle button for automatic hue cycling on new ghosts",
      "locator_hints": [
        "#btn-color-cycle"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing ghost count, speed, lifetime, paused state",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.ghostCount === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.ghostLifetime === 2.0",
        "window.__3D_STATE__.colorCycleEnabled === false",
        "window.__3D_STATE__.totalGhostsSpawned === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GhostsSpawning",
      "conditions": [
        "window.__3D_STATE__.ghostCount > 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.totalGhostsSpawned > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "TrailCleared",
      "conditions": [
        "window.__3D_STATE__.ghostCount === 0"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "LifetimeChanged",
      "conditions": [
        "window.__3D_STATE__.ghostLifetime !== 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "ColorCycleActive",
      "conditions": [
        "window.__3D_STATE__.colorCycleEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.ghostCount >= 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ghostCount === 'number' && window.__3D_STATE__.ghostCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsSpawned >= window.__3D_STATE__.ghostCount",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mainObjectPosition === 'object' && !isNaN(window.__3D_STATE__.mainObjectPosition.x) && !isNaN(window.__3D_STATE__.mainObjectPosition.y) && !isNaN(window.__3D_STATE__.mainObjectPosition.z)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ghostCount <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oldestGhostOpacity !== null && window.__3D_STATE__.oldestGhostOpacity >= 0 && window.__3D_STATE__.oldestGhostOpacity <= 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pathParameter === 'number' && !isNaN(window.__3D_STATE__.pathParameter)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ghostCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mainObjectPosition.y >= 1.0 && window.__3D_STATE__.mainObjectPosition.y <= 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ghostCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.speed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mainObjectPosition.x >= -4.0 && window.__3D_STATE__.mainObjectPosition.x <= 4.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S7",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-clear"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ghostCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oldestGhostOpacity === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsSpawned > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mainObjectPosition === 'object' && !isNaN(window.__3D_STATE__.mainObjectPosition.z)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-speed').value = '2.5'; document.getElementById('slider-speed').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speed === 2.5 || Math.abs(window.__3D_STATE__.speed - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pathParameter === 'number' && !isNaN(window.__3D_STATE__.pathParameter)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
