            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ghostCount <= 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ghostLifetime === 'number' && !isNaN(window.__3D_STATE__.ghostLifetime)",
