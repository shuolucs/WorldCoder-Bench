      ]
    },
    {
      "id": "A2",
      "name": "GhostTrail",
      "type": "3d_object",
      "semantic": "Collection of semi-transparent ghost clones left behind by the main object",
      "locator_hints": [
        "transparent meshes",
        "opacity < 1.0"
      ]
    },
    {
      "id": "A3",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle animation pause",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A4",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to remove all ghosts",
