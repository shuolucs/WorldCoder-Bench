  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'sole'",
        "window.__3D_STATE__.colors.sole === 'white'",
        "window.__3D_STATE__.colors.body === 'white'",
        "window.__3D_STATE__.colors.toecap === 'white'",
        "window.__3D_STATE__.spinning === false",
        "window.__3D_STATE__.sneakerScale === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.dioramaVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "BodySelected",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'body'"
      ]
    },
    {
      "id": "S3",
      "name": "BodyColoredRed",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'body'",
        "window.__3D_STATE__.colors.body === 'red'",
        "window.__3D_STATE__.partsCustomized >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "ToecapSelectedAndBlue",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'toecap'",
        "window.__3D_STATE__.colors.toecap === 'blue'",
        "window.__3D_STATE__.partsCustomized >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "SpinningActive",
      "conditions": [
        "window.__3D_STATE__.spinning === true"
      ]
    },
    {
      "id": "S6",
      "name": "ScaledUp",
      "conditions": [
        "window.__3D_STATE__.sneakerScale >= 1.4",
        "window.__3D_STATE__.sneakerScale <= 1.6"
      ]
    },
    {
      "id": "S7",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.colors.sole === 'white'",
        "window.__3D_STATE__.colors.body === 'white'",
        "window.__3D_STATE__.colors.toecap === 'white'",
        "window.__3D_STATE__.partsCustomized === 0"
      ]
    }
  ],
