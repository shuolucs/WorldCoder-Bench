{
  "task_id": "P321_molecular_dynamics_viewer_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "Atom0_Oxygen",
      "type": "3d_object",
      "semantic": "Central oxygen atom at origin",
      "locator_hints": [
        "red sphere at (0,0,0)",
        "radius 0.8"
      ]
    },
    {
      "id": "A2",
      "name": "Atom1_Carbon",
      "type": "3d_object",
      "semantic": "Carbon atom to the right",
      "locator_hints": [
        "gray sphere at (3,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "Atom3_Hydrogen",
      "type": "3d_object",
      "semantic": "Hydrogen atom in +Z",
      "locator_hints": [
        "white sphere at (0,0,3)"
      ]
    },
    {
      "id": "A4",
      "name": "BtnAdd",
      "type": "dom_element",
      "semantic": "Add atom button",
      "locator_hints": [
        "#btn-add"
      ]
    },
    {
      "id": "A5",
      "name": "BtnDelete",
      "type": "dom_element",
      "semantic": "Delete atom button",
      "locator_hints": [
        "#btn-delete"
      ]
    },
    {
      "id": "A6",
      "name": "BtnSimulate",
      "type": "dom_element",
      "semantic": "Toggle simulation button",
      "locator_hints": [
        "#btn-simulate"
      ]
    },
    {
      "id": "A7",
      "name": "BtnUndo",
      "type": "dom_element",
      "semantic": "Undo button",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A8",
      "name": "BtnRedo",
      "type": "dom_element",
      "semantic": "Redo button",
      "locator_hints": [
        "#btn-redo"
      ]
    },
    {
      "id": "A9",
      "name": "AtomCountDisplay",
      "type": "dom_element",
      "semantic": "Atom count HUD",
      "locator_hints": [
        "#atom-count"
      ]
    },
    {
      "id": "A10",
      "name": "HistorySizeDisplay",
      "type": "dom_element",
      "semantic": "History stack display",
      "locator_hints": [
        "#history-size"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.atomCount === 5",
        "window.__3D_STATE__.bondCount === 4",
        "window.__3D_STATE__.selectedAtomIndex === -1",
        "window.__3D_STATE__.simulationActive === false",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AtomSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAtomIndex === 1",
        "window.__3D_STATE__.lastAction === 'select'"
      ]
    },
    {
      "id": "S2",
      "name": "AtomMoved",
      "conditions": [
        "window.__3D_STATE__.selectedAtomIndex === 1",
        "Math.abs(window.__3D_STATE__.atoms[1].x - 3.5) < 0.01",
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'move'"
      ]
    },
    {
      "id": "S3",
      "name": "MoveUndone",
      "conditions": [
        "Math.abs(window.__3D_STATE__.atoms[1].x - 3.0) < 0.01",
        "window.__3D_STATE__.redoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S4",
      "name": "MoveRedone",
      "conditions": [
        "Math.abs(window.__3D_STATE__.atoms[1].x - 3.5) < 0.01",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S5",
      "name": "AtomAdded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 6",
        "window.__3D_STATE__.bondCount === 5",
        "window.__3D_STATE__.lastAction === 'add'"
      ]
    },
    {
      "id": "S6",
      "name": "AddUndone",
      "conditions": [
        "window.__3D_STATE__.atomCount === 5",
        "window.__3D_STATE__.bondCount === 4",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S7",
      "name": "AtomSelectedForDelete",
      "conditions": [
        "window.__3D_STATE__.selectedAtomIndex === 3",
        "window.__3D_STATE__.atomCount === 5"
      ]
    },
    {
      "id": "S8",
      "name": "AtomDeleted",
      "conditions": [
        "window.__3D_STATE__.atomCount === 4",
        "window.__3D_STATE__.bondCount === 3",
        "window.__3D_STATE__.selectedAtomIndex === -1",
        "window.__3D_STATE__.lastAction === 'delete'"
      ]
    },
    {
      "id": "S9",
      "name": "DeleteUndone",
      "conditions": [
        "window.__3D_STATE__.atomCount === 5",
        "window.__3D_STATE__.bondCount === 4",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S10",
      "name": "SimulationActive",
      "conditions": [
        "window.__3D_STATE__.simulationActive === true",
        "window.__3D_STATE__.lastAction === 'simulate_toggle'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "Atom1_Carbon",
        "description": "Click on the carbon atom (atom index 1) to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 4",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d",
        "description": "Press D to move selected atom +X by 0.5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[1].x - 3.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[1].z - 0.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'move'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-undo",
        "description": "Click Undo to revert the move"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[1].x - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-redo",
        "description": "Click Redo to re-apply the move"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[1].x - 3.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-add",
        "description": "Click Add to create a new hydrogen atom bonded to atom 0"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[5].y - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[5].radius - 0.4) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-undo",
        "description": "Undo the add atom action"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "Atom3_Hydrogen",
        "description": "Click on atom 3 (hydrogen at (0,0,3)) to select it for deletion"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#selected-atom').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-delete",
        "description": "Delete the selected atom 3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'delete'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z",
        "modifiers": [
          "ctrl"
        ],
        "description": "Press Ctrl+Z to undo the deletion"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[3].z - 3.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-simulate",
        "description": "Toggle simulation on to start oscillation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'simulate_toggle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#sim-status').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}