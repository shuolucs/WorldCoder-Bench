        "code": "if(window.__triggerSubstationFailure) { for(let i=0;i<6;i++) window.__triggerSubstationFailure(i); } else { window.__3D_STATE__.substations.forEach((s,i) => { s.status='failed'; s.load=0; }); window.__3D_STATE__.failedCount=6; window.__3D_STATE__.onlineCount=0; window.__3D_STATE__.isBlackout=true; window.__3D_STATE__.gridStability=0; window.__3D_STATE__.powerPlant.status='offline'; }"
