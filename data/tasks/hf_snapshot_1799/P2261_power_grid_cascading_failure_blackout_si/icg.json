  "states": [
    {
      "id": "S0",
      "name": "InitialGridOnline",
      "conditions": [
        "window.__3D_STATE__.onlineCount === 6",
        "window.__3D_STATE__.failedCount === 0",
        "window.__3D_STATE__.gridStability === 100",
        "window.__3D_STATE__.isBlackout === false",
        "window.__3D_STATE__.powerPlant.status === 'online'"
      ]
    },
    {
      "id": "S1",
      "name": "SingleSubstationFailed",
      "conditions": [
        "window.__3D_STATE__.onlineCount === 5",
        "window.__3D_STATE__.failedCount === 1",
        "window.__3D_STATE__.cascadeEvents.length >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "CascadeInProgress",
      "conditions": [
        "window.__3D_STATE__.failedCount >= 2",
        "window.__3D_STATE__.cascadeEvents.length >= 2",
        "window.__3D_STATE__.gridStability < 100"
      ]
    },
    {
      "id": "S3",
      "name": "FullBlackout",
      "conditions": [
        "window.__3D_STATE__.onlineCount === 0",
        "window.__3D_STATE__.isBlackout === true",
        "window.__3D_STATE__.powerPlant.status === 'offline'",
        "window.__3D_STATE__.gridStability === 0"
      ]
    },
    {
      "id": "S4",
      "name": "GridRepaired",
      "conditions": [
        "window.__3D_STATE__.onlineCount === 6",
        "window.__3D_STATE__.failedCount === 0",
        "window.__3D_STATE__.gridStability === 100",
        "window.__3D_STATE__.isBlackout === false"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "FastForwardActive",
      "conditions": [
        "window.__3D_STATE__.isFastForward === true"
      ]
    },
    {
      "id": "S7",
      "name": "PartialFailure",
      "conditions": [
        "window.__3D_STATE__.onlineCount >= 1 && window.__3D_STATE__.onlineCount <= 4",
        "window.__3D_STATE__.failedCount >= 2",
        "window.__3D_STATE__.isBlackout === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.substations) && window.__3D_STATE__.substations.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.substations.every(s => s.status === 'online')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSystemLoad > 0 && !isNaN(window.__3D_STATE__.totalSystemLoad)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.transmissionLines) && window.__3D_STATE__.transmissionLines.length === 8",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__PRE_TOTAL_LOAD__ = window.__3D_STATE__.totalSystemLoad; window.__PRE_SUB0_LOAD__ = window.__3D_STATE__.substations[0].load; const sub0 = window.__3D_STATE__.substations[0]; if(sub0._mesh) { sub0._mesh.dispatchEvent({type:'click'}); } else { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(evt); } if(window.__triggerSubstationFailure) window.__triggerSubstationFailure(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.substations[0].status === 'failed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.failedCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.onlineCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gridStability - (5/6)*100) < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cascadeEvents.length >= 1 && window.__3D_STATE__.cascadeEvents[0].type === 'failure'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.failedCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cascadeEvents.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.substations.filter(s => s.status === 'failed').length === window.__3D_STATE__.failedCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.substations.filter(s => s.status === 'online').every(s => !isNaN(s.load) && s.load >= 0)",
            "tier": "L2"
          },
