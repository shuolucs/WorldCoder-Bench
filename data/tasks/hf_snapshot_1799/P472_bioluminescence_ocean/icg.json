        "window.__3D_STATE__.colorIndex === 0",
        "window.__3D_STATE__.waveMode === 'calm'"
      ]
    },
    {
      "id": "S1",
      "name": "GlowHidden",
      "conditions": [
        "window.__3D_STATE__.glowVisible === false"
      ]
    },
    {
