      "conditions": [
        "window.__3D_STATE__.glowVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "WaveIntense",
      "conditions": [
        "window.__3D_STATE__.waveMode === 'intense'"
      ]
    },
    {
      "id": "S5",
      "name": "FlamingoRotated",
      "conditions": [
        "window.__3D_STATE__.flamingoRotationY > 0.1"
      ]
    }
  ],
