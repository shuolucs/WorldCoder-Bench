  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 0",
        "window.__3D_STATE__.currentPH === 1.0",
        "window.__3D_STATE__.buretteRemaining === 50",
        "window.__3D_STATE__.indicatorState === 'colorless'"
