        "window.__3D_STATE__.volumeAdded === 1",
        "window.__3D_STATE__.currentPH > 1.0",
        "window.__3D_STATE__.currentPH < 2.0"
      ]
    },
    {
      "id": "S2",
      "name": "FineDropAdded",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 1.2",
        "window.__3D_STATE__.historyLength >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "BulkAddition",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 6.2",
        "window.__3D_STATE__.buretteRemaining === 43.8"
      ]
    },
    {
      "id": "S4",
      "name": "StirrerActive",
      "conditions": [
        "window.__3D_STATE__.isStirring === true"
      ]
    },
    {
      "id": "S5",
      "name": "NearEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded >= 49.0",
        "window.__3D_STATE__.volumeAdded < 50.0",
        "window.__3D_STATE__.currentPH < 7.0"
      ]
    },
    {
      "id": "S6",
      "name": "AtEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 50.0",
        "Math.abs(window.__3D_STATE__.currentPH - 7.0) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "PastEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded > 50.0",
        "window.__3D_STATE__.currentPH > 7.0",
        "window.__3D_STATE__.equivalenceReached === true"
      ]
    },
    {
      "id": "S8",
      "name": "IndicatorPink",
      "conditions": [
        "window.__3D_STATE__.indicatorState === 'pink'",
        "window.__3D_STATE__.currentPH > 10.0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.volumeAdded < 55.0",
        "window.__3D_STATE__.historyLength >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 0",
        "window.__3D_STATE__.currentPH === 1.0",
        "window.__3D_STATE__.historyLength === 0"
      ]
    },
    {
      "id": "S11",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.dropRate !== 5"
      ]
    }
