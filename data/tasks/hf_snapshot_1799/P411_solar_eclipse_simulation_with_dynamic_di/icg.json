  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.eclipsesCaught === 0",
        "window.__3D_STATE__.speedMultiplier === 0.5"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.isPaused === false",
        "!isNaN(window.__3D_STATE__.moonAngle)"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.frameCount > 20"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficulty === 2",
        "window.__3D_STATE__.speedMultiplier === 0.8"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyDecreased",
      "conditions": [
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.speedMultiplier === 0.5"
      ]
    },
    {
      "id": "S6",
      "name": "OrbitToggled",
      "conditions": [
        "window.__3D_STATE__.orbitVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "InclinationChanged",
      "conditions": [
        "window.__3D_STATE__.inclination !== 2"
      ]
    },
    {
      "id": "S8",
      "name": "EclipseOccurring",
      "conditions": [
        "window.__3D_STATE__.eclipseIntensity > 0.1",
        "window.__3D_STATE__.eclipseType !== 'none'"
      ]
    },
    {
      "id": "S9",
      "name": "ScoredDuringEclipse",
      "conditions": [
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.eclipsesCaught > 0"
      ]
    },
    {
      "id": "S10",
      "name": "HighDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty >= 4",
        "window.__3D_STATE__.speedMultiplier >= 1.5"
      ]
    },
    {
      "id": "S11",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.eclipsesCaught === 0",
        "window.__3D_STATE__.eclipsesMissed === 0"
      ]
    },
    {
      "id": "S12",
      "name": "ObserverModelLoaded",
      "conditions": [
        "window.__3D_STATE__.observerLoaded === true"
      ]
    }
  ],
