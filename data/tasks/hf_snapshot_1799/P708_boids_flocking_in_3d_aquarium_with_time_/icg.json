      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boidCount === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSpeed > 0 && window.__3D_STATE__.avgSpeed <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidsInBounds === 60",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.centerOfMass.x) && Number.isFinite(window.__3D_STATE__.centerOfMass.y) && Number.isFinite(window.__3D_STATE__.centerOfMass.z)",
            "tier": "L2"
