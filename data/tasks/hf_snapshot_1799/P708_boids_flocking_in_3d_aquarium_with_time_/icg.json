  "states": [
    {
      "id": "S0",
      "name": "Initial Running",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.boidCount === 60",
        "window.__3D_STATE__.scatterMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.timeScale === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "SpedUp",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.5",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S4",
      "name": "SlowedDown",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.25",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "ScatterActive",
      "conditions": [
        "window.__3D_STATE__.scatterMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "ScatterDeactivated",
      "conditions": [
        "window.__3D_STATE__.scatterMode === false"
      ]
    },
    {
      "id": "S7",
      "name": "SeparationAdjusted",
      "conditions": [
        "window.__3D_STATE__.separationWeight !== 1.5"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.boidCount === 60",
        "window.__3D_STATE__.scatterMode === false"
      ]
    },
    {
      "id": "S9",
      "name": "MaxTimeScale",
      "conditions": [
        "window.__3D_STATE__.timeScale === 3.0"
      ]
    }
  ],
  "transitions": [
