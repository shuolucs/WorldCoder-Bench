      "name": "MildGlitch",
      "conditions": [
        "window.__3D_STATE__.glitchMode === 1",
        "window.__3D_STATE__.glitchIntensity >= 0.1"
      ]
    },
    {
      "id": "S2",
      "name": "ModerateGlitch",
      "conditions": [
