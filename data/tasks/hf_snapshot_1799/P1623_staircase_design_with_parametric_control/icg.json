        "code": "(() => { const e = new KeyboardEvent('keydown', {key: '+'}); document.dispatchEvent(e); const e2 = new KeyboardEvent('keydown', {key: '+'}); document.dispatchEvent(e2); const e3 = new KeyboardEvent('keydown', {key: '+'}); document.dispatchEvent(e3); })()"
      },
