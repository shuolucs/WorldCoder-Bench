    {
      "id": "A10",
      "name": "StepTooltip",
      "type": "dom_element",
      "semantic": "Tooltip showing selected step info",
      "locator_hints": [
        "#stepTooltip"
      ]
    },
    {
      "id": "A11",
      "name": "ValidationPanel",
      "type": "dom_element",
      "semantic": "Panel showing building code validation results",
      "locator_hints": [
