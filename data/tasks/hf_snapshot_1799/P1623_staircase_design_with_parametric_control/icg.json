            "expr": "Math.abs(window.__3D_STATE__.blondelValue - (2 * window.__3D_STATE__.stepHeight + window.__3D_STATE__.stepDepth)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stairAngle - Math.atan(window.__3D_STATE__.stepHeight / window.__3D_STATE__.stepDepth) * 180 / Math.PI) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.stepHeight > 0.20) ? window.__3D_STATE__.riserValid === false : true",
            "tier": "L2"
          }
        ]
      }
    },
