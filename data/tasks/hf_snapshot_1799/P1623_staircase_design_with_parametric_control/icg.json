            "expr": "window.__3D_STATE__.meshCount === window.__3D_STATE__.stepCount",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blondelValue - (2 * window.__3D_STATE__.stepHeight + window.__3D_STATE__.stepDepth)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
