{
  "task_id": "P1623_staircase_design_with_parametric_control",
  "affordances": [
    {
      "id": "A1",
      "name": "StaircaseGroup",
      "type": "3d_object",
      "semantic": "Group of step meshes forming the parametric staircase",
      "locator_hints": [
        "step meshes with wood-tone material",
        "BoxGeometry children"
      ]
    },
    {
      "id": "A2",
      "name": "Handrails",
      "type": "3d_object",
      "semantic": "Handrail cylinders and balusters along staircase edge",
      "locator_hints": [
        "CylinderGeometry meshes",
        "metallic silver color"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground plane and grid at y=0",
