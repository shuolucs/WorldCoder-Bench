          {
            "expr": "window.__3D_STATE__.handrailSegments === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount === window.__3D_STATE__.stepCount",
            "tier": "L2"
          },
          {
