      ]
    },
    {
      "id": "A12",
      "name": "StepHeightSlider",
      "type": "dom_element",
      "semantic": "Slider controlling step riser height",
      "locator_hints": [
        "input[type=range] for stepHeight"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialDefaults",
      "conditions": [
        "window.__3D_STATE__.stepCount === 12",
        "window.__3D_STATE__.staircaseType === 'straight'",
        "window.__3D_STATE__.handrailEnabled === true",
        "window.__3D_STATE__.stepHeight === 0.18",
        "window.__3D_STATE__.stepDepth === 0.3",
        "window.__3D_STATE__.selectedStepIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "StepCountModified",
      "conditions": [
        "window.__3D_STATE__.stepCount !== 12",
        "window.__3D_STATE__.meshCount === window.__3D_STATE__.stepCount",
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "SpiralTypeActive",
      "conditions": [
        "window.__3D_STATE__.staircaseType === 'spiral'",
        "window.__3D_STATE__.spiralAngle >= 90 && window.__3D_STATE__.spiralAngle <= 720"
      ]
    },
    {
      "id": "S3",
      "name": "LShapedTypeActive",
      "conditions": [
        "window.__3D_STATE__.staircaseType === 'lshaped'"
      ]
    },
    {
      "id": "S4",
      "name": "HandrailDisabled",
      "conditions": [
        "window.__3D_STATE__.handrailEnabled === false",
        "window.__3D_STATE__.handrailSegments === 0"
      ]
    },
    {
      "id": "S5",
      "name": "StepSelected",
      "conditions": [
        "window.__3D_STATE__.selectedStepIndex >= 0",
        "window.__3D_STATE__.selectedStepIndex < window.__3D_STATE__.stepCount"
      ]
    },
    {
      "id": "S6",
      "name": "ValidationFailing",
      "conditions": [
        "window.__3D_STATE__.validationPassed === false"
      ]
    },
    {
      "id": "S7",
      "name": "UndoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "RedoneState",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.stepCount === 12",
        "window.__3D_STATE__.stepHeight === 0.18",
        "window.__3D_STATE__.stepDepth === 0.3",
        "window.__3D_STATE__.staircaseType === 'straight'",
        "window.__3D_STATE__.handrailEnabled === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number' && typeof window.__3D_STATE__.staircaseType === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 12 && window.__3D_STATE__.stepWidth === 1.2 && window.__3D_STATE__.stepDepth === 0.3 && window.__3D_STATE__.stepHeight === 0.18",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount === 12",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalRise - 12 * 0.18) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blondelValue - (2 * 0.18 + 0.3)) < 0.001 && window.__3D_STATE__.blondelValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount === 13",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalRise - 13 * 0.18) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalRise) && isFinite(window.__3D_STATE__.totalRise)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stairAngle - Math.atan(0.18 / 0.3) * 180 / Math.PI) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.staircaseType === 'spiral'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spiralAngle === 360",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spiralRadius === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount === window.__3D_STATE__.stepCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.staircaseType === 'lshaped'",
