  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.player1Budget === 2000",
        "window.__3D_STATE__.player2Budget === 2000",
        "window.__3D_STATE__.selectedType === 0",
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.population === 0",
        "window.__3D_STATE__.demolishMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "HousePlaced",
      "conditions": [
        "window.__3D_STATE__.player1Budget === 1900",
        "window.__3D_STATE__.player1Buildings === 1",
        "window.__3D_STATE__.totalBuildings >= 1",
        "window.__3D_STATE__.population >= 10"
      ]
    },
    {
      "id": "S2",
      "name": "OfficePlaced",
      "conditions": [
        "window.__3D_STATE__.player1Budget === 1650",
        "window.__3D_STATE__.player1Buildings === 2",
        "window.__3D_STATE__.selectedType === 1"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.player1Budget === 1900",
        "window.__3D_STATE__.player1Buildings === 1"
      ]
    },
    {
      "id": "S4",
      "name": "DemolishModeActive",
      "conditions": [
        "window.__3D_STATE__.demolishMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "AfterDemolish",
      "conditions": [
        "window.__3D_STATE__.player1Buildings === 0",
        "window.__3D_STATE__.demolishMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "DemolishModeOff",
      "conditions": [
        "window.__3D_STATE__.demolishMode === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.player1Budget === 2000",
        "window.__3D_STATE__.player2Budget === 2000",
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.population === 0"
      ]
    }
  ],
