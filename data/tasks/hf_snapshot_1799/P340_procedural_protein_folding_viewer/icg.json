{
  "task_id": "P340_procedural_protein_folding_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinChain",
      "type": "3d_object",
      "semantic": "Group of 20 amino acid residue spheres connected by bonds",
      "locator_hints": [
        "scene.children group containing residue meshes"
      ]
    },
    {
      "id": "A2",
      "name": "UnfoldedButton",
      "type": "dom_element",
      "semantic": "Button to set unfolded conformation",
      "locator_hints": [
        "#btn-unfolded"
      ]
    },
    {
      "id": "A3",
      "name": "HelixButton",
      "type": "dom_element",
      "semantic": "Button to set alpha helix conformation",
      "locator_hints": [
        "#btn-helix"
      ]
    },
    {
      "id": "A4",
      "name": "SheetButton",
      "type": "dom_element",
      "semantic": "Button to set beta sheet conformation",
      "locator_hints": [
        "#btn-sheet"
      ]
    },
    {
      "id": "A5",
      "name": "SpinButton",
      "type": "dom_element",
      "semantic": "Toggle auto-rotation of protein",
      "locator_hints": [
        "#btn-spin"
      ]
    },
    {
      "id": "A6",
      "name": "HighlightButton",
      "type": "dom_element",
      "semantic": "Toggle hydrophobic residue highlighting",
      "locator_hints": [
        "#btn-highlight"
      ]
    },
    {
      "id": "A7",
      "name": "InfoDisplay",
      "type": "dom_element",
      "semantic": "Label showing current conformation and residue count",
      "locator_hints": [
        "#info-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialUnfolded",
      "conditions": [
        "window.__3D_STATE__.conformation === 'unfolded'",
        "window.__3D_STATE__.residueCount === 20",
        "window.__3D_STATE__.isAnimating === false",
        "window.__3D_STATE__.spinEnabled === false",
        "window.__3D_STATE__.highlightEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "FoldingToHelix",
      "conditions": [
        "window.__3D_STATE__.conformation === 'helix'",
        "window.__3D_STATE__.isAnimating === true"
      ]
    },
    {
      "id": "S2",
      "name": "HelixComplete",
      "conditions": [
        "window.__3D_STATE__.conformation === 'helix'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S3",
      "name": "SheetComplete",
      "conditions": [
        "window.__3D_STATE__.conformation === 'sheet'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S4",
      "name": "SpinningHelix",
      "conditions": [
        "window.__3D_STATE__.conformation === 'helix'",
        "window.__3D_STATE__.spinEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "HighlightedHelix",
      "conditions": [
        "window.__3D_STATE__.conformation === 'helix'",
        "window.__3D_STATE__.highlightEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "BackToUnfolded",
      "conditions": [
        "window.__3D_STATE__.conformation === 'unfolded'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-helix"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conformation === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "!window.__3D_STATE__.residuePositions.some(p => isNaN(p.x) || isNaN(p.y) || isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isAnimating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conformation === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - 2*Math.cos(0)) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].y - (0*0.8 - 8)) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBonds === 19",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-spin"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.spinEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conformation === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.proteinRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.proteinRotationY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.spinEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conformation === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.proteinRotationY) >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-highlight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highlightEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[0] === 'hydrophobic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[1] === 'hydrophilic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[2] === 'neutral'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[3] === 'hydrophobic'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conformation === 'sheet'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "!window.__3D_STATE__.residuePositions.some(p => isNaN(p.x) || isNaN(p.y) || isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.every(p => Math.sqrt(p.x*p.x + p.y*p.y + p.z*p.z) < 20)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conformation === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBonds === 19",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#info-display').textContent.includes('Unfolded')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isAnimating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conformation === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[10].y) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[10].z) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 100",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}