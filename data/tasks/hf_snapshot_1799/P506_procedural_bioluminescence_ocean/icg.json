            "expr": "window.__3D_STATE__.waveAmplitude === 2.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.waveAmplitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.waveAmplitude)",
            "tier": "L2"
          },
