  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.waveAmplitude === 2.0",
        "window.__3D_STATE__.colorTheme === 'cyan'",
        "window.__3D_STATE__.clickCount === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "WaveAmplitudeIncreased",
      "conditions": [
        "window.__3D_STATE__.waveAmplitude === 2.5"
      ]
    },
    {
      "id": "S2",
      "name": "WaveAmplitudeDecreased",
      "conditions": [
        "window.__3D_STATE__.waveAmplitude === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "BloomsHidden",
      "conditions": [
        "window.__3D_STATE__.bloomsVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "BloomsRestored",
      "conditions": [
        "window.__3D_STATE__.bloomsVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "FoxJumped",
      "conditions": [
        "window.__3D_STATE__.foxJumpCount === 1"
      ]
    },
    {
      "id": "S6",
      "name": "ColorThemePurple",
      "conditions": [
        "window.__3D_STATE__.colorTheme === 'purple'"
      ]
    },
    {
      "id": "S7",
      "name": "NightModeOn",
      "conditions": [
        "window.__3D_STATE__.nightMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "OceanClicked",
      "conditions": [
        "window.__3D_STATE__.clickCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S10",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S11",
      "name": "CameraZoomed",
      "conditions": [
        "window.__3D_STATE__.cameraZ < 30"
      ]
    },
    {
      "id": "S12",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.waveAmplitude === 2.0",
        "window.__3D_STATE__.colorTheme === 'cyan'",
        "window.__3D_STATE__.nightMode === false",
        "window.__3D_STATE__.clickCount === 0"
      ]
    }
  ],
