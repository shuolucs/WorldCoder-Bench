          },
          {
            "expr": "typeof window.__3D_STATE__.fov === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pointCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointSize >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pointCount === 'number' && window.__3D_STATE__.pointCount >= 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.depthRange && isFinite(window.__3D_STATE__.depthRange.near) && isFinite(window.__3D_STATE__.depthRange.far)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.pointCount)",
            "tier": "L2"
