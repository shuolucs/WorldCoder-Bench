{
  "task_id": "P1052_chromatography_separation_simulator_with",
  "affordances": [
    {
      "id": "A1",
      "name": "ChromatographyColumn",
      "type": "3d_object",
      "semantic": "Transparent glass column containing stationary phase and compound bands",
      "locator_hints": [
        "cylinder mesh at center",
        "transmission material",
        "radius ~1.5"
      ]
    },
    {
      "id": "A2",
      "name": "CompoundBandA",
      "type": "3d_object",
      "semantic": "Red compound band (fastest, lowest polarity)",
      "locator_hints": [
        "red colored disc/torus inside column",
        "highest y initially"
      ]
    },
    {
      "id": "A3",
      "name": "CompoundBandB",
      "type": "3d_object",
      "semantic": "Green compound band (medium speed)",
      "locator_hints": [
        "green colored disc/torus inside column"
      ]
    },
    {
      "id": "A4",
      "name": "CompoundBandC",
      "type": "3d_object",
      "semantic": "Blue compound band (slowest, highest polarity)",
      "locator_hints": [
        "blue colored disc/torus inside column"
      ]
    },
    {
      "id": "A5",
      "name": "FractionBeakers",
      "type": "3d_object",
      "semantic": "Row of 5 collection beakers below column",
      "locator_hints": [
        "5 small cylinders at y=-5",
        "spaced along x-axis"
      ]
    },
    {
      "id": "A6",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the chromatography simulation",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A7",
      "name": "CollectButton",
      "type": "dom_element",
      "semantic": "Button to advance fraction collector to next beaker",
      "locator_hints": [
        "#collectBtn"
      ]
    },
    {
      "id": "A8",
      "name": "DifficultyButton",
      "type": "dom_element",
      "semantic": "Button to cycle difficulty level",
      "locator_hints": [
        "#difficultyBtn"
      ]
    },
    {
      "id": "A9",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A10",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "Purity score readout",
      "locator_hints": [
        "#scoreDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialReady",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'ready'",
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.currentBeakerIndex === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'running'",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyChanged",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2"
      ]
    },
    {
      "id": "S3",
      "name": "CompoundsSeparating",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'running'",
        "window.__3D_STATE__.separationDistances[0] > 0.1",
        "window.__3D_STATE__.compoundPositions[0] < window.__3D_STATE__.compoundPositions[2]"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'paused'",
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'running'",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S6",
      "name": "FlowBoosted",
      "conditions": [
        "window.__3D_STATE__.flowRateBoosted === true",
        "window.__3D_STATE__.simulationStatus === 'running'"
      ]
    },
    {
      "id": "S7",
      "name": "BeakerAdvanced",
      "conditions": [
        "window.__3D_STATE__.currentBeakerIndex >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "CompoundACollected",
      "conditions": [
        "window.__3D_STATE__.compoundCollected[0] === true"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.simulationStatus === 'ready'",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationStatus === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'running'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.compoundPositions !== 'undefined' && Array.isArray(window.__3D_STATE__.compoundPositions)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions.length === 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.compoundPositions[0]) && !isNaN(window.__3D_STATE__.compoundPositions[1]) && !isNaN(window.__3D_STATE__.compoundPositions[2])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCompoundsMass === 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#difficultyBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.difficultyLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.difficultyLevel === 2",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.migrationRates) && window.__3D_STATE__.migrationRates.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.migrationRates[0] > window.__3D_STATE__.migrationRates[1]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.migrationRates[1] > window.__3D_STATE__.migrationRates[2]",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('difficultyDisplay') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.separationDistances[0] > 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[0] < window.__3D_STATE__.compoundPositions[2]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[1] < window.__3D_STATE__.compoundPositions[2]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCompoundsMass >= 2.99 && window.__3D_STATE__.totalCompoundsMass <= 3.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.migrationRates[0] > window.__3D_STATE__.migrationRates[2]",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'paused'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusDisplay') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'running'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.compoundPositions[0])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCompoundsMass >= 2.99 && window.__3D_STATE__.totalCompoundsMass <= 3.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "keyAction": "keydown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flowRateBoosted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'running'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.migrationRates[0] === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.migrationRates[0] > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.separationDistances[0]) && !isNaN(window.__3D_STATE__.separationDistances[1])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#collectBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentBeakerIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentBeakerIndex <= 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beakerContents !== 'undefined' && Array.isArray(window.__3D_STATE__.beakerContents)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakerContents.length === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beakerContents[0] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('beakerDisplay') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S1",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 15000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.compoundCollected[0] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[0] <= -3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[0] < window.__3D_STATE__.compoundPositions[1]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCompoundsMass >= 2.99 && window.__3D_STATE__.totalCompoundsMass <= 3.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.purityScore === 'number' && !isNaN(window.__3D_STATE__.purityScore)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'ready'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentBeakerIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundCollected[0] === false && window.__3D_STATE__.compoundCollected[1] === false && window.__3D_STATE__.compoundCollected[2] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.purityScore === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStatus === 'running'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[0] >= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compoundPositions[2] >= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCompoundsMass === 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.separationDistances[0] >= 0 && window.__3D_STATE__.separationDistances[1] >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}