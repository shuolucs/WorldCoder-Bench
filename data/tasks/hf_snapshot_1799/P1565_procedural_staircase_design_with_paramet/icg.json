  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.stepCount === 8",
        "window.__3D_STATE__.staircaseType === 'straight'",
        "window.__3D_STATE__.railingEnabled === true",
        "window.__3D_STATE__.materialPreset === 'wood'",
        "window.__3D_STATE__.lastAction === 'init'"
      ]
    },
    {
      "id": "S1",
      "name": "StepCountIncreased",
      "conditions": [
        "window.__3D_STATE__.stepCount === 9",
        "window.__3D_STATE__.lastAction === 'param_change'"
      ]
    },
    {
      "id": "S2",
      "name": "StepCountIncreasedAgain",
      "conditions": [
        "window.__3D_STATE__.stepCount === 12",
        "window.__3D_STATE__.lastAction === 'param_change'"
      ]
    },
    {
      "id": "S3",
      "name": "TypeChangedToSpiral",
      "conditions": [
        "window.__3D_STATE__.staircaseType === 'spiral'",
        "window.__3D_STATE__.stepCount === 12"
      ]
    },
    {
      "id": "S4",
      "name": "MaterialChangedToMarble",
      "conditions": [
        "window.__3D_STATE__.materialPreset === 'marble'",
        "window.__3D_STATE__.staircaseType === 'spiral'"
      ]
    },
    {
      "id": "S5",
      "name": "RailingDisabled",
      "conditions": [
        "window.__3D_STATE__.railingEnabled === false",
        "window.__3D_STATE__.isCodeCompliant === false"
      ]
    },
    {
      "id": "S6",
      "name": "StepHeightAdjusted",
      "conditions": [
        "window.__3D_STATE__.stepHeight === 0.25",
        "window.__3D_STATE__.isCodeCompliant === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.stepCount === 8",
        "window.__3D_STATE__.staircaseType === 'straight'",
        "window.__3D_STATE__.materialPreset === 'wood'",
        "window.__3D_STATE__.railingEnabled === true",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S10",
      "name": "TypeCycledViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.staircaseType === 'spiral'",
        "window.__3D_STATE__.lastAction === 'param_change'"
      ]
    },
    {
      "id": "S11",
      "name": "AfterExport",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'export'",
        "window.__3D_STATE__.exportedJSON !== ''"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 8 && window.__3D_STATE__.stepWidth === 1.2 && window.__3D_STATE__.stepDepth === 0.3 && window.__3D_STATE__.stepHeight === 0.18",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.staircaseType === 'straight' && window.__3D_STATE__.railingEnabled === true && window.__3D_STATE__.materialPreset === 'wood'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalRise - 8 * 0.18) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.slopeAngle - Math.atan2(8 * 0.18, 8 * 0.3) * 180 / Math.PI) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0 && window.__3D_STATE__.isCodeCompliant === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
