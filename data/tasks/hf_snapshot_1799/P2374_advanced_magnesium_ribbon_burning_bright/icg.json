      ]
    },
    {
      "id": "A12",
      "name": "HUDPhase",
      "type": "dom_element",
      "semantic": "Reaction phase display",
      "locator_hints": [
        "#hud-phase"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneReady_Idle",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.reactionPhase === 'idle'",
        "window.__3D_STATE__.burnProgress === 0",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GogglesOn",
      "conditions": [
        "window.__3D_STATE__.gogglesOn === true",
        "window.__3D_STATE__.reactionPhase === 'idle'"
      ]
    },
    {
      "id": "S2",
      "name": "InitialMassRecorded",
      "conditions": [
        "window.__3D_STATE__.gogglesOn === true",
        "window.__3D_STATE__.initialMassRecorded === true",
        "window.__3D_STATE__.score >= 20"
      ]
    },
    {
      "id": "S3",
      "name": "Ignited_Burning",
      "conditions": [
        "window.__3D_STATE__.ignited === true",
        "window.__3D_STATE__.reactionPhase === 'burning'",
        "window.__3D_STATE__.burnProgress > 0"
      ]
    },
    {
      "id": "S4",
      "name": "BurnMidpoint",
      "conditions": [
        "window.__3D_STATE__.burnProgress >= 0.4",
        "window.__3D_STATE__.burnProgress <= 0.7",
        "window.__3D_STATE__.reactionPhase === 'burning'"
      ]
    },
    {
      "id": "S5",
      "name": "BurnComplete_Cooling",
      "conditions": [
        "window.__3D_STATE__.burnProgress >= 1.0",
        "window.__3D_STATE__.reactionPhase === 'cooling' || window.__3D_STATE__.reactionPhase === 'complete'"
      ]
    },
    {
      "id": "S6",
      "name": "FinalMassRecorded",
      "conditions": [
        "window.__3D_STATE__.finalMassRecorded === true",
        "window.__3D_STATE__.score >= 85"
      ]
    },
    {
      "id": "S7",
      "name": "YieldCalculated",
      "conditions": [
        "window.__3D_STATE__.yieldCalculated === true",
        "window.__3D_STATE__.score === 100"
      ]
    },
    {
      "id": "S8",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S9",
      "name": "ExperimentReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.burnProgress === 0",
        "window.__3D_STATE__.reactionPhase === 'idle'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.burnProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reactionPhase === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTemperature >= 20 && window.__3D_STATE__.currentTemperature <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyReleased === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-goggles"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gogglesOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.includes('goggles')",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.completedSteps)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reactionPhase === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-record-mass"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.initialMassRecorded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.includes('record_initial_mass')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mgMassRemaining === 2.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mgoMassProduced === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-ignite"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ignited === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionPhase === 'burning'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.includes('ignite')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burnProgress >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.burnProgress >= 0.35 && window.__3D_STATE__.burnProgress <= 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTemperature > 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burnLightIntensity > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyReleased > 20 && window.__3D_STATE__.energyReleased < 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mgoMassProduced > 0 && window.__3D_STATE__.mgoMassProduced < 4.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.burnProgress >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionPhase === 'cooling' || window.__3D_STATE__.reactionPhase === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakTemperature >= 2000 && window.__3D_STATE__.peakTemperature <= 3000",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyReleased - 120.4) < 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mgoMassProduced - 4.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-record-mass"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.finalMassRecorded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 85",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.includes('record_final_mass')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mgMassRemaining < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mgoMassProduced >= 3.8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-calc-yield"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.yieldCalculated === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.percentYield >= 95 && window.__3D_STATE__.percentYield <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.includes('calculate_yield')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.length === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S3",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.burnProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTemperature)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTemperature >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burnProgress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionPhase === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ignited === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gogglesOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.completedSteps.length === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}