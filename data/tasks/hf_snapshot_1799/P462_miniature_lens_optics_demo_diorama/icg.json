{
  "task_id": "P462_miniature_lens_optics_demo_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "ObjectArrow",
      "type": "3d_object",
      "semantic": "Draggable red arrow representing the optical object",
      "locator_hints": [
        "red arrow on principal axis",
        "mesh at negative z"
      ]
    },
    {
      "id": "A2",
      "name": "ImageArrow",
      "type": "3d_object",
      "semantic": "Green arrow representing the computed image",
      "locator_hints": [
        "green arrow",
        "computed image position"
      ]
    },
    {
      "id": "A3",
      "name": "Lens",
      "type": "3d_object",
      "semantic": "The convex/concave lens at the origin",
      "locator_hints": [
        "semi-transparent shape at z=0"
      ]
    },
    {
      "id": "A4",
      "name": "RayLines",
      "type": "3d_object",
      "semantic": "Three principal ray lines for ray tracing",
      "locator_hints": [
        "yellow, cyan, magenta lines"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleRaysButton",
      "type": "dom_element",
      "semantic": "Button to show/hide ray lines",
      "locator_hints": [
        "button with text 'Toggle Rays'"
      ]
    },
    {
      "id": "A6",
      "name": "SwitchLensButton",
      "type": "dom_element",
      "semantic": "Button to toggle convex/concave lens",
      "locator_hints": [
        "button with text 'Switch Lens'"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the scene",
      "locator_hints": [
        "button with text 'Reset'"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Overlay panel showing optics values",
      "locator_hints": [
        "bottom-right overlay",
        "panel showing do, di, m"
      ]
    },
    {
      "id": "A9",
      "name": "FocalPoints",
      "type": "3d_object",
      "semantic": "Red spheres at focal points",
      "locator_hints": [
        "small red spheres at z=-3 and z=3"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.objectZ === -6",
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.lensType === 'convex'",
        "window.__3D_STATE__.raysVisible === true",
        "window.__3D_STATE__.infoPanelVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "InitialOpticsComputed",
      "conditions": [
        "window.__3D_STATE__.objectDistance === 6",
        "window.__3D_STATE__.isRealImage === true",
        "Math.abs(window.__3D_STATE__.imageDistance - 6) < 0.1",
        "Math.abs(window.__3D_STATE__.magnification - (-1)) < 0.1"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectMovedBeyondFocal",
      "conditions": [
        "window.__3D_STATE__.objectZ > -9 && window.__3D_STATE__.objectZ < -3",
        "window.__3D_STATE__.isRealImage === true",
        "window.__3D_STATE__.imageDistance > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ObjectInsideFocal",
      "conditions": [
        "window.__3D_STATE__.objectZ > -3 && window.__3D_STATE__.objectZ < -0.5",
        "window.__3D_STATE__.isRealImage === false",
        "window.__3D_STATE__.imageDistance < 0"
      ]
    },
    {
      "id": "S4",
      "name": "RaysHidden",
      "conditions": [
        "window.__3D_STATE__.raysVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ConcaveLens",
      "conditions": [
        "window.__3D_STATE__.lensType === 'concave'",
        "window.__3D_STATE__.focalLength === -3",
        "window.__3D_STATE__.isRealImage === false"
      ]
    },
    {
      "id": "S6",
      "name": "InfoPanelShown",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.objectZ === -6",
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.lensType === 'convex'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Magnification !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.values !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.objectZ = -4; if(window.__moveObject) window.__moveObject(-4);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.objectZ = -2; if(window.__moveObject) window.__moveObject(-2);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Toggle Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Switch Lens"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "i"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.querySelector('[id*=info], [class*=info], [class*=panel]') !== null || window.__3D_STATE__.infoPanelVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "i"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}