        "window.__3D_STATE__.volumeLoaded === true",
        "window.__3D_STATE__.raymarching === true",
        "window.__3D_STATE__.controlPointCount === 5",
        "window.__3D_STATE__.brightness === 1.0",
        "window.__3D_STATE__.stepCount === 256",
        "window.__3D_STATE__.activePreset === 'Custom'",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "BrightnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.brightness === 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "PresetBoneApplied",
      "conditions": [
