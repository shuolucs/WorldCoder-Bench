{
  "task_id": "P2144_spectroscopy_peak_interactive_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectroscopyChart",
      "type": "dom_element",
      "semantic": "2D canvas overlay rendering the IR spectroscopy transmittance curve with 8 labeled peaks",
      "locator_hints": [
        "canvas on left half of viewport",
        "2D chart overlay"
      ]
    },
    {
      "id": "A2",
      "name": "MaterialSampleModel",
      "type": "3d_object",
      "semantic": "GLB model of shoe loaded as material sample, positioned on right side, glows with emissive color on peak selection",
      "locator_hints": [
        "GLB model at x=1.5",
        "MaterialsVariantsShoe.glb"
      ]
    },
    {
      "id": "A3",
      "name": "AnalyzeButton",
      "type": "dom_element",
      "semantic": "Button that computes FWHM of selected peak",
      "locator_hints": [
        "#analyzeBtn"
      ]
    },
    {
      "id": "A4",
      "name": "CompareButton",
      "type": "dom_element",
      "semantic": "Button that toggles comparison mode between two peaks",
      "locator_hints": [
        "#compareBtn"
      ]
    },
    {
      "id": "A5",
      "name": "NoiseSlider",
      "type": "dom_element",
      "semantic": "Slider controlling Gaussian noise level 0-20 on the spectrum",
      "locator_hints": [
        "#noiseSlider"
      ]
    },
    {
      "id": "A6",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel displaying detailed peak information",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A7",
      "name": "ModeIndicator",
      "type": "dom_element",
      "semantic": "Text element showing current mode: Normal, Zoom, or Compare",
      "locator_hints": [
        "#modeIndicator"
      ]
    },
    {
      "id": "A8",
      "name": "PeakCountLabel",
      "type": "dom_element",
      "semantic": "Label showing total number of peaks",
      "locator_hints": [
        "#peakCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.chartRendered === true",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.selectedPeakIndex === -1",
        "window.__3D_STATE__.zoomMode === false",
        "window.__3D_STATE__.compareMode === false",
        "window.__3D_STATE__.noiseLevel === 0"
      ]
    },
    {
      "id": "S1",
      "name": "PeakSelectedViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex >= 0 && window.__3D_STATE__.selectedPeakIndex <= 7",
        "window.__3D_STATE__.modelEmissiveColor !== null"
      ]
    },
    {
      "id": "S2",
      "name": "FWHMAnalyzed",
      "conditions": [
        "window.__3D_STATE__.fwhmComputed !== null",
        "window.__3D_STATE__.fwhmComputed > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ZoomModeActive",
      "conditions": [
        "window.__3D_STATE__.zoomMode === true",
        "window.__3D_STATE__.zoomRange.max - window.__3D_STATE__.zoomRange.min <= 400"
      ]
    },
    {
      "id": "S4",
      "name": "PeakCycledNext",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex >= 0"
      ]
    },
    {
      "id": "S5",
      "name": "CompareModeActive",
      "conditions": [
        "window.__3D_STATE__.compareMode === true",
        "window.__3D_STATE__.comparisonData !== null"
      ]
    },
    {
      "id": "S6",
      "name": "NoiseApplied",
      "conditions": [
        "window.__3D_STATE__.noiseLevel > 0"
      ]
    },
    {
      "id": "S7",
      "name": "PeakCycledPrevious",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex === -1",
        "window.__3D_STATE__.zoomMode === false",
        "window.__3D_STATE__.compareMode === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peaks) && window.__3D_STATE__.peaks.length === 8",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chartRendered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].wavenumber === 3350 && window.__3D_STATE__.peaks[7].wavenumber === 1050",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === -1 && window.__3D_STATE__.interactionCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].wavenumber === 2850",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].transmittance === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].label === 'C-H sym stretch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelEmissiveColor !== null && typeof window.__3D_STATE__.modelEmissiveColor === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#analyzeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fwhmComputed !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fwhmComputed - 2.3548 * 35) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fwhmComputed - 82.418) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].fwhm !== null && Math.abs(window.__3D_STATE__.peaks[2].fwhm - 82.418) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.zoomMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoomRange.min === 2650",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoomRange.max === 3050",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoomRange.max - window.__3D_STATE__.zoomRange.min === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[3].wavenumber === 1730",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[3].label === 'C=O stretch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousPeakIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelEmissiveColor !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.zoomRange.min === 1530 && window.__3D_STATE__.zoomRange.max === 1930",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#compareBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.compareMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.comparisonData !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.comparisonData.deltaWavenumber === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.comparisonData.deltaWavenumber) === Math.abs(2850 - 1730)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.comparisonData.deltaTransmittance) === Math.abs(45 - 15)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 3 && window.__3D_STATE__.previousPeakIndex === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('noiseSlider').value = 10; document.getElementById('noiseSlider').dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.noiseLevel === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].wavenumber === 3350",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[3].wavenumber === 1730",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[7].wavenumber === 1050",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.noiseLevel >= 0 && window.__3D_STATE__.noiseLevel <= 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousPeakIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].wavenumber === 2850",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelEmissiveColor !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peakColors) && window.__3D_STATE__.peakColors.length === 8",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].wavenumber === 3350",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].transmittance === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].sigma === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].label === 'O-H stretch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelEmissiveColor !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S1",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoomMode === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compareMode === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelEmissiveColor === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoomRange.min === 400 && window.__3D_STATE__.zoomRange.max === 4000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.comparisonData === null",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}