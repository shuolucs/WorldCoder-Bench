{
  "task_id": "P140_robot_dance",
  "affordances": [
    {
      "id": "A1",
      "name": "robot",
      "type": "3d_object",
      "semantic": "GLB 模型 robot.glb",
      "locator_hints": [
        "robot"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "编排器就绪"
    },
    {
      "id": "S2",
      "name": "playing",
      "description": "播放中"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.isPlaying === false"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.keyframeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const c = document.querySelector('canvas'); if(!c) return false; const gl = c.getContext('webgl2') || c.getContext('webgl'); return gl !== null; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const b=document.getElementById(\"playBtn\"); if(b) b.click(); })()",
        "wait_ms": 1000
      },
      "postconditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentTime > 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime !== before.currentTime || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number' && !isNaN(window.__3D_STATE__.currentTime)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.keyframeCount === 'number' && !isNaN(window.__3D_STATE__.keyframeCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}