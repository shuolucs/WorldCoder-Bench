{
  "task_id": "P461_electrical_circuit_builder_with_dynamic_",
  "affordances": [
    {
      "id": "A1",
      "name": "Battery",
      "type": "3d_object",
      "semantic": "Voltage source (9V default) represented as yellow cylinder",
      "locator_hints": [
        "yellow cylinder",
        "battery mesh"
      ]
    },
    {
      "id": "A2",
      "name": "ResistorR1",
      "type": "3d_object",
      "semantic": "100 ohm resistor represented as brown box",
      "locator_hints": [
        "brown box",
        "R1 mesh"
      ]
    },
    {
      "id": "A3",
      "name": "ResistorR2",
      "type": "3d_object",
      "semantic": "200 ohm resistor represented as brown box",
      "locator_hints": [
        "second brown box",
        "R2 mesh"
      ]
    },
    {
      "id": "A4",
      "name": "LED",
      "type": "3d_object",
      "semantic": "Red LED sphere that glows when current flows",
      "locator_hints": [
        "red sphere",
        "LED mesh"
      ]
    },
    {
      "id": "A5",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing circuit stats",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A6",
      "name": "Instructions",
      "type": "dom_element",
      "semantic": "Bottom instruction bar",
      "locator_hints": [
        "#instructions"
      ]
    },
    {
      "id": "A7",
      "name": "VoltageSlider",
      "type": "dom_element",
      "semantic": "Slider for adjusting battery voltage in Level 3",
      "locator_hints": [
        "#voltageSlider",
        "#sliderPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Unconnected",
      "conditions": [
        "window.__3D_STATE__.level === 1",
        "window.__3D_STATE__.circuitComplete === false",
        "window.__3D_STATE__.connectedComponents.length === 0",
        "window.__3D_STATE__.ledOn === false"
      ]
    },
    {
      "id": "S1",
      "name": "BatterySelected",
      "conditions": [
        "window.__3D_STATE__.selectedComponent === 'battery'"
      ]
    },
    {
      "id": "S2",
      "name": "BatteryConnected",
      "conditions": [
        "window.__3D_STATE__.connectedComponents.includes('battery')",
        "window.__3D_STATE__.circuitComplete === false"
      ]
    },
    {
      "id": "S3",
      "name": "R1Connected",
      "conditions": [
        "window.__3D_STATE__.connectedComponents.includes('r1')",
        "window.__3D_STATE__.circuitComplete === false"
      ]
    },
    {
      "id": "S4",
      "name": "Level1Complete",
      "conditions": [
        "window.__3D_STATE__.level === 1",
        "window.__3D_STATE__.circuitComplete === true",
        "window.__3D_STATE__.ledOn === true"
      ]
    },
    {
      "id": "S5",
      "name": "Level2Complete",
      "conditions": [
        "window.__3D_STATE__.level === 2",
        "window.__3D_STATE__.circuitComplete === true"
      ]
    },
    {
      "id": "S6",
      "name": "Level3Active",
      "conditions": [
        "window.__3D_STATE__.level === 3"
      ]
    },
    {
      "id": "S7",
      "name": "Level3VoltageAdjusted",
      "conditions": [
        "window.__3D_STATE__.level === 3",
        "window.__3D_STATE__.batteryVoltage !== 9"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.level === 1",
        "window.__3D_STATE__.connectedComponents.length === 0",
        "window.__3D_STATE__.circuitComplete === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A1",
        "description": "Click on the battery to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c",
        "description": "Press C to connect the selected battery to the circuit"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Select R1 then connect\nconst raycaster = new THREE.Raycaster(); /* simulate click on R1 */; window.__3D_STATE__.selectedComponent = 'r1'; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c'}));",
        "description": "Select R1 and press C to connect it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedComponent = 'led'; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c'}));",
        "description": "Select LED and press C to complete the Level 1 series circuit"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n",
        "description": "Press N to advance to Level 2 (parallel resistors)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n",
        "description": "Press N to advance to Level 3 with variable voltage"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('voltageSlider') !== null || document.getElementById('sliderPanel') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('voltageSlider'); if(slider) { slider.value = 3; slider.dispatchEvent(new Event('input')); }",
        "description": "Set voltage slider to 3V to test low voltage behavior"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset the entire circuit back to Level 1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}