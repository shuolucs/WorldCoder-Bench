  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.marbleX !== undefined",
        "window.__3D_STATE__.tiltX === 0 || Math.abs(window.__3D_STATE__.tiltX) < 0.01",
        "window.__3D_STATE__.undoCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "BoardTiltedRight",
      "conditions": [
        "window.__3D_STATE__.tiltZ > 0.02",
        "window.__3D_STATE__.tiltZ <= 0.15"
      ]
    },
    {
      "id": "S2",
      "name": "MarbleMoving",
      "conditions": [
        "window.__3D_STATE__.marbleSpeed > 0.005",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S3",
      "name": "HistoryRecorded",
      "conditions": [
        "window.__3D_STATE__.historyLength > 1"
      ]
    },
    {
      "id": "S4",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoCount > 0",
        "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "BoardTiltedForward",
      "conditions": [
        "window.__3D_STATE__.tiltX > 0.02"
      ]
    },
    {
      "id": "S7",
      "name": "MarbleFrictionSlowed",
      "conditions": [
        "window.__3D_STATE__.marbleSpeed < 0.01",
        "Math.abs(window.__3D_STATE__.tiltX) < 0.01",
        "Math.abs(window.__3D_STATE__.tiltZ) < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.elapsedTime <= 1",
        "window.__3D_STATE__.undoCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "GoalReached",
      "conditions": [
        "window.__3D_STATE__.goalReached === true",
        "window.__3D_STATE__.gameState === 'won'"
      ]
    }
  ],
