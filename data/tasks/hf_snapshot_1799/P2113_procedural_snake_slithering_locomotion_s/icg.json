            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wavePhase !== undefined && typeof window.__3D_STATE__.wavePhase === 'number' && !isNaN(window.__3D_STATE__.wavePhase)",
            "tier": "L2"
