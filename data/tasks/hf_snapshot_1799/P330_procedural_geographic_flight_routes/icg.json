  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.routeCount === 5",
        "window.__3D_STATE__.activeRoutes === 5",
        "window.__3D_STATE__.selectedRoute === -1",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.highlightMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "RouteToggled",
      "conditions": [
        "window.__3D_STATE__.activeRoutes === 4",
        "window.__3D_STATE__.selectedRoute === 0"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.speedMultiplier - 1.5) < 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedDecreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.speedMultiplier - 1.0) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "RouteSelectedByKey",
      "conditions": [
        "window.__3D_STATE__.selectedRoute === 2"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "HighlightOn",
      "conditions": [
        "window.__3D_STATE__.highlightMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraDistance - 15) < 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "AnimationResumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S9",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.activeRoutes === 5",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.highlightMode === false"
      ]
    }
  ],
