          },
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBones === 15",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.boneNames) && window.__3D_STATE__.boneNames.length === 15",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Wave Pose"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPose === 'wave-pose'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBones === 15",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.boneNames)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Toggle Hierarchy"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hierarchyExpanded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPose === 'wave-pose'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBones === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Toggle Hierarchy"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hierarchyExpanded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPose === 'wave-pose'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBones === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJoint === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('[data-bone=\"LeftHand\"]') ? document.querySelector('[data-bone=\"LeftHand\"]').click() : (() => { const items = document.querySelectorAll('[data-bone], .tree-node, .bone-node'); for (const el of items) { if (el.textContent.trim() === 'LeftHand' || el.textContent.trim().startsWith('LeftHand')) { el.click(); break; } } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'LeftHand'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointDepth === 5",
            "tier": "L2"
          },
          {
