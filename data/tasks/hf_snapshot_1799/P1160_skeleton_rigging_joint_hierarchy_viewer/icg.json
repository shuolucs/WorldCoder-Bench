{
  "task_id": "P1160_skeleton_rigging_joint_hierarchy_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "JointSpheres",
      "type": "3d_object",
      "semantic": "Clickable spheres representing skeleton joints",
      "locator_hints": [
        "mesh with sphere geometry",
        "emissive material 0x00ffaa"
      ]
    },
    {
      "id": "A2",
      "name": "BoneConnectors",
      "type": "3d_object",
      "semantic": "Lines or cylinders connecting parent-child joints",
      "locator_hints": [
        "line segments or thin cylinders",
        "color 0x4488ff"
      ]
    },
    {
      "id": "A3",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Top-right overlay showing selected joint details",
      "locator_hints": [
        "position: absolute",
        "top-right corner"
      ]
    },
    {
      "id": "A4",
      "name": "HierarchyTree",
      "type": "dom_element",
      "semantic": "Left-side collapsible tree view of bone hierarchy",
      "locator_hints": [
        "left side panel",
        "nested list or tree structure"
      ]
    },
    {
      "id": "A5",
      "name": "TPoseButton",
      "type": "dom_element",
      "semantic": "Button to apply T-Pose preset",
      "locator_hints": [
        "button text 'T-Pose'"
      ]
    },
    {
      "id": "A6",
      "name": "APoseButton",
      "type": "dom_element",
      "semantic": "Button to apply A-Pose preset",
      "locator_hints": [
        "button text 'A-Pose'"
      ]
    },
    {
      "id": "A7",
      "name": "WavePoseButton",
      "type": "dom_element",
      "semantic": "Button to apply Wave Pose preset",
      "locator_hints": [
        "button text 'Wave Pose'"
      ]
    },
    {
      "id": "A8",
      "name": "ToggleHierarchyButton",
      "type": "dom_element",
      "semantic": "Button to toggle hierarchy tree panel visibility",
      "locator_hints": [
        "button text 'Toggle Hierarchy'"
      ]
    },
    {
      "id": "A9",
      "name": "GridFloor",
      "type": "3d_object",
      "semantic": "Grid helper on the floor plane",
      "locator_hints": [
        "GridHelper at y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalBones === 15",
        "window.__3D_STATE__.selectedJoint === null",
        "window.__3D_STATE__.currentPose === 't-pose'",
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S1",
      "name": "JointSelected",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "window.__3D_STATE__.selectedJointDepth >= 0",
        "window.__3D_STATE__.chainLength > 0"
      ]
    },
    {
      "id": "S2",
      "name": "JointRotatedX",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "window.__3D_STATE__.currentPose === 'custom'",
        "window.__3D_STATE__.jointRotationCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "JointRotationReset",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "Math.abs(window.__3D_STATE__.selectedJointLocalRot.x) < 1",
        "Math.abs(window.__3D_STATE__.selectedJointLocalRot.y) < 1",
        "Math.abs(window.__3D_STATE__.selectedJointLocalRot.z) < 1"
      ]
    },
    {
      "id": "S4",
      "name": "Deselected",
      "conditions": [
        "window.__3D_STATE__.selectedJoint === null",
        "window.__3D_STATE__.chainLength === 0"
      ]
    },
    {
      "id": "S5",
      "name": "APoseApplied",
      "conditions": [
        "window.__3D_STATE__.currentPose === 'a-pose'",
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S6",
      "name": "WavePoseApplied",
      "conditions": [
        "window.__3D_STATE__.currentPose === 'wave-pose'",
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S7",
      "name": "HierarchyHidden",
      "conditions": [
        "window.__3D_STATE__.hierarchyExpanded === false"
      ]
    },
    {
      "id": "S8",
      "name": "HierarchyVisible",
      "conditions": [
        "window.__3D_STATE__.hierarchyExpanded === true"
      ]
    },
    {
      "id": "S9",
      "name": "TreeNodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "window.__3D_STATE__.selectedJointDepth >= 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBones === 15",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.boneNames) && window.__3D_STATE__.boneNames.length === 15",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedJoint === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPose === 't-pose'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === false && window.__3D_STATE__.jointRotationCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('[data-bone=\"Spine\"]') ? document.querySelector('[data-bone=\"Spine\"]').click() : (() => { const items = document.querySelectorAll('[data-bone], .tree-node, .bone-node'); for (const el of items) { if (el.textContent.trim().includes('Spine') && !el.textContent.trim().includes('Shoulder')) { el.click(); break; } } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'Spine'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointDepth === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedJointWorldPos === 'object' && !isNaN(window.__3D_STATE__.selectedJointWorldPos.y)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointWorldPos.y > 4.5 && window.__3D_STATE__.selectedJointWorldPos.y < 6.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainLength > 0 && window.__3D_STATE__.chainLength < 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "x"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'Spine'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedJointLocalRot.x - 15) < 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPose === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointRotationCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.selectedJointWorldPos.x) && !isNaN(window.__3D_STATE__.selectedJointWorldPos.y) && !isNaN(window.__3D_STATE__.selectedJointWorldPos.z)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.chainLength)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'Spine'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedJointLocalRot.x) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedJointLocalRot.y) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedJointLocalRot.z) < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointWorldPos.y > 4.5 && window.__3D_STATE__.selectedJointWorldPos.y < 6.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainLength === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointDepth === 0 || window.__3D_STATE__.selectedJointDepth === undefined || window.__3D_STATE__.selectedJointDepth === -1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedJointWorldPos === 'object'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
