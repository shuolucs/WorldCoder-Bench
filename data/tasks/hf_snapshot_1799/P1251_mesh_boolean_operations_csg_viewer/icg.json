        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "PositionsReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.operandAPosition.x - (-1.5)) < 0.01",
        "Math.abs(window.__3D_STATE__.operandBPosition.x - 0) < 0.01"
