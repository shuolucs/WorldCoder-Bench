      "id": "S0",
      "name": "InitialSubtractState",
      "conditions": [
        "window.__3D_STATE__.operationMode === 'subtract'",
        "window.__3D_STATE__.previewMode === false",
        "window.__3D_STATE__.operandAShape === 'box'",
        "window.__3D_STATE__.operandBShape === 'sphere'",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "UnionOperationActive",
      "conditions": [
        "window.__3D_STATE__.operationMode === 'union'",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S2",
      "name": "IntersectOperationActive",
      "conditions": [
