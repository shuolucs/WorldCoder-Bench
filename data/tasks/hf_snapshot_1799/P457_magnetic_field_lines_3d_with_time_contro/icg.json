  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.time === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.fieldLinesVisible === true",
        "window.__3D_STATE__.polarityMode === 'attracting'"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.time > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused_MidTime",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.time > 0.05"
      ]
    },
    {
      "id": "S3",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1"
      ]
    },
    {
      "id": "S4",
      "name": "FieldLines_Hidden",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Repelling_Mode",
      "conditions": [
        "window.__3D_STATE__.polarityMode === 'repelling'",
        "window.__3D_STATE__.time === 0"
      ]
    },
    {
      "id": "S6",
      "name": "Time_Stepped",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.time > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_After_Play",
      "conditions": [
        "window.__3D_STATE__.time === 0",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S8",
      "name": "FieldLines_Restored",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "High_Speed_Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.speedMultiplier === 4"
      ]
    }
  ],
