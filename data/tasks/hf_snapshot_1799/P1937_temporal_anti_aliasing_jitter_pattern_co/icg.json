  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'halton23'",
        "window.__3D_STATE__.sampleCount === 8",
        "window.__3D_STATE__.splitViewActive === false",
        "window.__3D_STATE__.cameraAnimating === false",
        "window.__3D_STATE__.objectCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "Converged_Halton",
      "conditions": [
        "window.__3D_STATE__.isConverged === true",
        "window.__3D_STATE__.currentSampleIndex === window.__3D_STATE__.sampleCount",
        "window.__3D_STATE__.activePattern === 'halton23'"
      ]
    },
    {
      "id": "S2",
      "name": "Pattern_Changed_R2",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'r2'",
        "window.__3D_STATE__.accumulationCleared === true"
      ]
    },
    {
      "id": "S3",
      "name": "SampleCount_Increased",
      "conditions": [
        "window.__3D_STATE__.sampleCount === 16",
        "window.__3D_STATE__.accumulationCleared === true"
      ]
    },
    {
      "id": "S4",
      "name": "SplitView_Active",
      "conditions": [
        "window.__3D_STATE__.splitViewActive === true",
        "window.__3D_STATE__.splitPosition >= 0.05",
        "window.__3D_STATE__.splitPosition <= 0.95"
      ]
    },
    {
      "id": "S5",
      "name": "Converged_R2_16",
      "conditions": [
        "window.__3D_STATE__.isConverged === true",
        "window.__3D_STATE__.activePattern === 'r2'",
        "window.__3D_STATE__.sampleCount === 16"
      ]
    },
    {
      "id": "S6",
      "name": "Pattern_Cycled_UniformGrid",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'uniform_grid'",
        "window.__3D_STATE__.accumulationCleared === true"
      ]
    },
    {
      "id": "S7",
      "name": "Exported_Jitter",
      "conditions": [
        "window.__3D_STATE__.exportedData !== null",
        "typeof window.__3D_STATE__.exportedData === 'string'"
      ]
    },
    {
      "id": "S8",
      "name": "Undo_Pattern",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'r2'",
        "window.__3D_STATE__.patternHistoryIndex < window.__3D_STATE__.patternHistory.length - 1"
      ]
    },
    {
      "id": "S9",
      "name": "Redo_Pattern",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'uniform_grid'",
        "window.__3D_STATE__.patternHistoryIndex === window.__3D_STATE__.patternHistory.length - 1"
      ]
    },
    {
