        "window.__3D_STATE__.cameraAnimating === true"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_During_Animation",
      "conditions": [
        "window.__3D_STATE__.accumulationCleared === true",
        "window.__3D_STATE__.cameraAnimating === true",
        "window.__3D_STATE__.currentSampleIndex <= 1"
      ]
    },
    {
      "id": "S12",
      "name": "SampleCount_Decreased",
      "conditions": [
        "window.__3D_STATE__.sampleCount === 8"
      ]
    }
