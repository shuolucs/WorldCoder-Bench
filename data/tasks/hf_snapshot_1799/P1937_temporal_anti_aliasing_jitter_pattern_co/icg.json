      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isConverged === true && window.__3D_STATE__.currentSampleIndex === 8",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.jitterOffsets) && window.__3D_STATE__.jitterOffsets.length === 8",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jitterOffsets.every(p => Array.isArray(p) && p.length === 2 && p[0] >= -0.5 && p[0] <= 0.5 && p[1] >= -0.5 && p[1] <= 0.5)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.convergenceVariance === 'number' && window.__3D_STATE__.convergenceVariance >= 0 && isFinite(window.__3D_STATE__.convergenceVariance)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jitterOffsets.every(p => !isNaN(p[0]) && !isNaN(p[1]) && isFinite(p[0]) && isFinite(p[1]))",
            "tier": "L2"
          }
        ]
