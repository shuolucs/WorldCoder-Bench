      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelectorAll('button, div[style*=\"border-radius\"]').forEach(el => { const bg = el.style.backgroundColor || getComputedStyle(el).backgroundColor; if(bg && (bg.includes('0, 68, 204') || bg.includes('0044cc') || el.dataset.color === '#0044cc' || el.dataset.index === '1')) el.click(); });"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentColor === '#0044cc'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorChangeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleCurrentRadius)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 100
      },
      "verifier": {
