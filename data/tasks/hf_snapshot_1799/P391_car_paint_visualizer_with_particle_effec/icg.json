          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Env Map"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.envMapEnabled === true",
