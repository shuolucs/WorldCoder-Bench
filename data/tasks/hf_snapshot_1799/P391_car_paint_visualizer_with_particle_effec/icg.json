  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentColor === '#cc0000'",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.cameraZoomed === false"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChangedToBlue",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#0044cc'",
        "window.__3D_STATE__.colorIndex === 1",
        "window.__3D_STATE__.colorChangeCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "BurstActive",
      "conditions": [
        "window.__3D_STATE__.particleBurstActive === true",
        "window.__3D_STATE__.particleCurrentRadius > 1.5"
      ]
    },
    {
      "id": "S3",
      "name": "BurstSettled",
      "conditions": [
        "window.__3D_STATE__.particleBurstActive === false",
        "window.__3D_STATE__.particleCurrentRadius <= 1.8"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S5",
      "name": "CameraZoomedIn",
      "conditions": [
        "window.__3D_STATE__.cameraZoomed === true",
        "window.__3D_STATE__.cameraZ <= 3.5"
      ]
    },
    {
      "id": "S6",
      "name": "CameraZoomedOut",
      "conditions": [
        "window.__3D_STATE__.cameraZoomed === false",
        "window.__3D_STATE__.cameraZ >= 4.5"
      ]
    },
    {
      "id": "S7",
      "name": "EnvMapOn",
      "conditions": [
        "window.__3D_STATE__.envMapEnabled === true",
        "window.__3D_STATE__.envMapIntensity === 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleColorChanges",
      "conditions": [
        "window.__3D_STATE__.colorChangeCount >= 3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColor === '#cc0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
