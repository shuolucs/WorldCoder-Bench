    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const btns = document.querySelectorAll('button, div[style*=\"border-radius\"]'); function clickColor(idx, list) { list.forEach(el => { const bg = el.style.backgroundColor || ''; const dc = el.dataset.color || ''; const di = el.dataset.index || ''; if(di == String(idx) || (idx===2 && (bg.includes('0, 204, 68') || dc.includes('00cc44'))) || (idx===4 && (bg.includes('17, 17, 17') || dc.includes('111111')))) el.click(); }); } clickColor(2, btns); setTimeout(() => clickColor(4, btns), 600); setTimeout(() => clickColor(3, btns), 1200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorChangeCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 50",
            "tier": "L2"
          }
        ]
      }
