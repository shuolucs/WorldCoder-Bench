          },
          {
            "expr": "window.__3D_STATE__.currentColor === '#0044cc'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleCurrentRadius)",
            "tier": "L2"
          }
        ]
      }
    },
