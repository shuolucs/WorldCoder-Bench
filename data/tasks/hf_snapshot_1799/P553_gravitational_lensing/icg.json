{
  "task_id": "P553_gravitational_lensing",
  "affordances": [
    {"id": "A1", "name": "LensObject", "type": "3d_object", "semantic": "Dark sphere with Fresnel edge glow", "locator_hints": ["sphere mesh dark"]},
    {"id": "A2", "name": "AccretionDisk", "type": "3d_object", "semantic": "Hot glowing ring around lens", "locator_hints": ["ring/torus mesh"]},
    {"id": "A3", "name": "BackgroundGalaxy", "type": "3d_object", "semantic": "Procedural galaxy billboard", "locator_hints": ["plane mesh at z=-50"]},
    {"id": "A4", "name": "EinsteinSlider", "type": "dom_element", "semantic": "Einstein radius control", "locator_hints": ["#slider-einstein-radius"]},
    {"id": "A5", "name": "ChromaticSlider", "type": "dom_element", "semantic": "Chromatic aberration control", "locator_hints": ["#slider-chromatic"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.shaderValid === true"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.frameCount > 10"]},
    {"id": "S2", "name": "RadiusChanged", "conditions": ["window.__3D_STATE__.einsteinRadius !== 0.15"]},
    {"id": "S3", "name": "BloomToggled", "conditions": ["window.__3D_STATE__.bloomEnabled === false"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.lensPosition.x === 0 && window.__3D_STATE__.lensPosition.y === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.shaderValid === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.einsteinRadius > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lensValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-einstein-radius').value = 0.3; document.getElementById('slider-einstein-radius').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.einsteinRadius >= 0.25", "tier": "L2"},
        {"expr": "document.getElementById('hud-er') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-chromatic').value = 0.04; document.getElementById('slider-chromatic').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.chromaticStrength >= 0.03", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "b"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bloomEnabled === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-bloom').textContent.includes('OFF')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "Math.abs(window.__3D_STATE__.lensPosition.x) < 0.1 && Math.abs(window.__3D_STATE__.lensPosition.y) < 0.1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.lensValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-lens-mass').value = 3.5; document.getElementById('slider-lens-mass').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lensRadius >= 3.0", "tier": "L2"}
      ]}
    }
  ]
}
