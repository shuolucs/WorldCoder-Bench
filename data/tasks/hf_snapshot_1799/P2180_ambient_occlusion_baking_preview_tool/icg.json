      ]
    },
    {
      "id": "A10",
      "name": "StatusLine",
      "type": "dom_element",
      "semantic": "Text showing bake status and duration",
      "locator_hints": [
        "element containing 'Status:'"
      ]
    },
    {
      "id": "A11",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Top-left UI panel containing all controls",
      "locator_hints": [
        "div positioned top-left, 280px wide"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoadedReady",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.bakeComplete === false",
        "window.__3D_STATE__.isBaking === false"
      ]
    },
    {
      "id": "S2",
      "name": "BakingInProgress",
      "conditions": [
        "window.__3D_STATE__.isBaking === true",
        "window.__3D_STATE__.bakeProgress >= 0",
        "window.__3D_STATE__.bakeProgress <= 100"
      ]
    },
    {
      "id": "S3",
      "name": "BakeComplete",
      "conditions": [
        "window.__3D_STATE__.bakeComplete === true",
        "window.__3D_STATE__.isBaking === false",
        "window.__3D_STATE__.aoDataApplied === true"
      ]
    },
    {
      "id": "S4",
      "name": "AOResetState",
      "conditions": [
        "window.__3D_STATE__.aoDataApplied === false",
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S5",
      "name": "AOOnlyView",
      "conditions": [
        "window.__3D_STATE__.showAOOnly === true",
        "window.__3D_STATE__.bakeComplete === true"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeActive",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "ParametersModified",
      "conditions": [
        "window.__3D_STATE__.sampleCount !== 32 || window.__3D_STATE__.aoRadius !== 1.0 || window.__3D_STATE__.aoIntensity !== 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.meshCount === 'number' && window.__3D_STATE__.meshCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isBaking === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bakeComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.aoIntensity === 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Verify initial defaults and structural integrity */ void(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.aoRadius === 'number' && window.__3D_STATE__.aoRadius === 1.0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.aoDataApplied === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.showAOOnly === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && window.__3D_STATE__.cameraDistance > 0 && isFinite(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.groundPlaneVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
