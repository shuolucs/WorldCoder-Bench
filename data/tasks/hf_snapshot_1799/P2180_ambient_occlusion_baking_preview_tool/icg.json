{
  "task_id": "P2180_ambient_occlusion_baking_preview_tool",
  "affordances": [
    {
      "id": "A1",
      "name": "CoffeematModel",
      "type": "3d_object",
      "semantic": "The loaded coffeemat.glb model centered on the ground plane",
      "locator_hints": [
        "scene.children with isMesh or traverse",
        "model group at origin"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane at y=0",
      "locator_hints": [
