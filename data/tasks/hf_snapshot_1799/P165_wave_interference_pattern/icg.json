{
  "task_id": "P165_wave_interference_pattern",
  "affordances": [
    {
      "id": "A1",
      "name": "WaveSurface",
      "type": "3d_object",
      "semantic": "Deformable plane mesh representing the wave medium",
      "locator_hints": [
        "256x256 segment plane",
        "MeshPhongMaterial blue"
      ]
    },
    {
      "id": "A2",
      "name": "AmberSpecimen",
      "type": "3d_object",
      "semantic": "MosquitoInAmber.glb model at center acting as wave obstacle",
      "locator_hints": [
        "position (0,2,0)",
        "scaled ~4 units"
      ]
    },
    {
      "id": "A3",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggle simulation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "AmplitudeSlider",
      "type": "dom_element",
      "semantic": "Controls wave amplitude",
      "locator_hints": [
        "#slider-amplitude"
      ]
    },
    {
      "id": "A6",
      "name": "WavelengthSlider",
      "type": "dom_element",
      "semantic": "Controls wavelength",
      "locator_hints": [
        "#slider-wavelength"
      ]
    },
    {
      "id": "A7",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Controls wave frequency",
      "locator_hints": [
        "#slider-frequency"
      ]
    },
    {
      "id": "A8",
      "name": "HUDTime",
      "type": "dom_element",
      "semantic": "Displays simulation time",
      "locator_hints": [
        "#hud-time"
      ]
    },
    {
      "id": "A9",
      "name": "HUDSources",
      "type": "dom_element",
      "semantic": "Displays active source count",
      "locator_hints": [
        "#hud-sources"
      ]
    },
    {
      "id": "A10",
      "name": "HUDObstacle",
      "type": "dom_element",
      "semantic": "Displays obstacle status",
      "locator_hints": [
        "#hud-obstacle"
      ]
    },
    {
      "id": "A11",
      "name": "HUDColorMode",
      "type": "dom_element",
      "semantic": "Displays color mode",
      "locator_hints": [
        "#hud-colormode"
      ]
    },
    {
      "id": "A12",
      "name": "HUDMaxDisp",
      "type": "dom_element",
      "semantic": "Displays max vertex displacement",
      "locator_hints": [
        "#hud-max-displacement"
      ]
    },
    {
      "id": "A13",
      "name": "HUDMinDisp",
      "type": "dom_element",
      "semantic": "Displays min vertex displacement",
      "locator_hints": [
        "#hud-min-displacement"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.amplitude === 2.0",
        "window.__3D_STATE__.wavelength === 8.0",
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.source2Active === true",
        "window.__3D_STATE__.obstacleActive === true",
        "window.__3D_STATE__.colorMode === 'solid'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "WavesEvolved",
      "conditions": [
        "window.__3D_STATE__.simTime > 1.0",
        "window.__3D_STATE__.maxDisplacement > 0.1",
        "window.__3D_STATE__.minDisplacement < -0.1"
      ]
    },
    {
      "id": "S3",
      "name": "SingleSourceMode",
      "conditions": [
        "window.__3D_STATE__.source2Active === false"
      ]
    },
    {
      "id": "S4",
      "name": "ObstacleDisabled",
      "conditions": [
        "window.__3D_STATE__.obstacleActive === false"
      ]
    },
    {
      "id": "S5",
      "name": "HeightmapColorMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'heightmap'"
      ]
    },
    {
      "id": "S6",
      "name": "NarrowSpacing",
      "conditions": [
        "window.__3D_STATE__.source1Pos.x === -10"
      ]
    },
    {
      "id": "S7",
      "name": "AmplitudeModified",
      "conditions": [
        "window.__3D_STATE__.amplitude !== 2.0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.amplitude === 2.0"
      ]
    },
    {
      "id": "S9",
      "name": "HighFrequencyRunning",
      "conditions": [
        "window.__3D_STATE__.frequency > 2.0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S10",
      "name": "WideSpacingRestored",
      "conditions": [
        "window.__3D_STATE__.source1Pos.x === -20"
      ]
    },
    {
      "id": "S11",
      "name": "FullyConfiguredRunning",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.source2Active === true",
        "window.__3D_STATE__.obstacleActive === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-sources').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-obstacle').textContent.includes('OFF')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-colormode').textContent.includes('Height')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-amplitude'); let nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(s, '4.0'); s.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('val-amplitude').textContent.includes('4')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-frequency'); let nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(s, '2.5'); s.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('val-frequency').textContent.includes('2.5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S11",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}