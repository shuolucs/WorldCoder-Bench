{
  "task_id": "P2210_radial_zoom_blur_with_focal_point",
  "affordances": [
    {
      "id": "A1",
      "name": "MosquitoModel",
      "type": "3d_object",
      "semantic": "The loaded MosquitoInAmber.glb model centered at origin, slowly rotating",
      "locator_hints": [
        "scene.children find mesh",
        "gltf.scene"
      ]
    },
    {
      "id": "A2",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "The WebGL rendering canvas for click interactions",
      "locator_hints": [
        "canvas",
        "renderer.domElement"
      ]
    },
    {
      "id": "A3",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing all blur parameters",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A4",
      "name": "FocalIndicator",
      "type": "dom_element",
      "semantic": "Small circle overlay showing current focal point position",
      "locator_hints": [
        "#focal-indicator"
      ]
    },
    {
      "id": "A5",
      "name": "BlurShaderPass",
      "type": "3d_object",
      "semantic": "Custom ShaderPass implementing radial zoom blur in EffectComposer",
      "locator_hints": [
        "composer.passes[1]",
        "ShaderPass"
      ]
    },
    {
      "id": "A6",
      "name": "EffectComposer",
      "type": "3d_object",
      "semantic": "Three.js EffectComposer managing render and blur passes",
      "locator_hints": [
        "composer"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "typeof window.__3D_STATE__.modelLoaded === 'boolean'"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Default_Blur",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.blurStrength === 0.3",
        "window.__3D_STATE__.blurEnabled === true"
      ]
    },
    {
      "id": "S2",
      "name": "Focal_Point_Moved",
      "conditions": [
        "window.__3D_STATE__.focalPointX !== 0.5 || window.__3D_STATE__.focalPointY !== 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "Blur_Strength_Increased",
      "conditions": [
        "window.__3D_STATE__.blurStrength > 0.3"
      ]
    },
    {
      "id": "S4",
      "name": "Sample_Count_Changed",
      "conditions": [
        "window.__3D_STATE__.sampleCount !== 16"
      ]
    },
    {
      "id": "S5",
      "name": "Falloff_Toggled",
      "conditions": [
        "window.__3D_STATE__.falloffStart === 0.35"
      ]
    },
    {
      "id": "S6",
      "name": "Blur_Disabled",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "Preset_Active",
      "conditions": [
        "window.__3D_STATE__.currentPreset !== 'Custom'"
      ]
    },
    {
      "id": "S8",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.blurStrength === 0.3",
        "window.__3D_STATE__.sampleCount === 16",
        "window.__3D_STATE__.focalPointX === 0.5",
        "window.__3D_STATE__.focalPointY === 0.5"
      ]
    },
    {
      "id": "S9",
      "name": "Dramatic_Preset_After_Reset",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'Dramatic'",
        "window.__3D_STATE__.blurStrength === 0.6"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength === 0.3 && window.__3D_STATE__.sampleCount === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalPointX === 0.5 && window.__3D_STATE__.focalPointY === 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 256,
        "y": 192,
        "description": "Click upper-left quadrant to move focal point"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.focalPointX >= 0.0 && window.__3D_STATE__.focalPointX <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalPointY >= 0.0 && window.__3D_STATE__.focalPointY <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.focalPointX - 0.25) < 0.08",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.focalPointY - 0.25) < 0.08",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.focalIndicatorLeft === 'number' && !isNaN(window.__3D_STATE__.focalIndicatorLeft)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Custom' || window.__3D_STATE__.focalPointX !== 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "description": "Press ArrowUp 3 times to increase blur strength by 0.15"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurStrength > 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 0.45) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.blurStrength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "description": "Press ArrowRight twice to increase sample count by 4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sampleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount >= 4 && window.__3D_STATE__.sampleCount <= 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount % 2 === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength > 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Custom'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f",
        "description": "Press f to toggle falloff start to wide clear zone"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.falloffStart === 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.falloffStart < window.__3D_STATE__.falloffEnd",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.falloffEnd === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number' && !isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b",
        "description": "Press b to disable blur entirely"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurPassEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press r to reset all parameters to defaults"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurStrength === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalPointX === 0.5 && window.__3D_STATE__.focalPointY === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.falloffStart === 0.15 && window.__3D_STATE__.falloffEnd === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true && window.__3D_STATE__.blurPassEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Custom'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s",
        "description": "Press s to activate first preset (Subtle)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Subtle'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 0.15) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.falloffStart - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.falloffEnd - 0.6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s",
        "description": "Press s again to cycle to Dramatic preset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Dramatic'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 0.6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 24",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.falloffStart - 0.2) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.falloffEnd - 0.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.falloffStart < window.__3D_STATE__.falloffEnd",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "description": "Press ArrowUp while in Dramatic preset to modify strength, switching to Custom"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Custom'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 0.65) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength <= 1.0 && window.__3D_STATE__.blurStrength >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sampleCount === 24",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY) && window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}