  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.bricksRemaining === 24",
        "window.__3D_STATE__.p1Score === 0",
        "window.__3D_STATE__.p2Score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Running",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S2",
      "name": "P1_Paddle_Moved_Left",
      "conditions": [
        "window.__3D_STATE__.p1PaddleX < 0"
      ]
    },
    {
      "id": "S3",
      "name": "P2_Paddle_Moved_Right",
      "conditions": [
        "window.__3D_STATE__.p2PaddleX > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Balls_Moving",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "!isNaN(window.__3D_STATE__.ball1Position.x)",
        "!isNaN(window.__3D_STATE__.ball2Position.z)"
      ]
    },
    {
      "id": "S5",
      "name": "Brick_Destroyed",
      "conditions": [
        "window.__3D_STATE__.bricksDestroyed > 0",
        "window.__3D_STATE__.bricksRemaining < 24"
      ]
    },
    {
      "id": "S6",
      "name": "Truck_Spinning_Faster",
      "conditions": [
        "window.__3D_STATE__.truckRotationSpeed > 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "Score_Updated",
      "conditions": [
        "window.__3D_STATE__.p1Score + window.__3D_STATE__.p2Score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.bricksRemaining === 24",
        "window.__3D_STATE__.p1Score === 0",
        "window.__3D_STATE__.p2Score === 0",
        "window.__3D_STATE__.bricksDestroyed === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.bricksRemaining === 0",
        "window.__3D_STATE__.winner !== null"
      ]
    }
  ],
