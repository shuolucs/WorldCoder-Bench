  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.stationHP === 100",
        "window.__3D_STATE__.p1Score === 0",
        "window.__3D_STATE__.p2Score === 0",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.wave === 1"
      ]
    },
    {
      "id": "S1",
      "name": "P1Moved",
      "conditions": [
        "window.__3D_STATE__.p1Position.x !== 15 || window.__3D_STATE__.p1Position.z !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "P2Moved",
      "conditions": [
        "window.__3D_STATE__.p2Position.x !== -15 || window.__3D_STATE__.p2Position.z !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "AsteroidsSpawned",
      "conditions": [
        "window.__3D_STATE__.asteroidCount > 0",
        "window.__3D_STATE__.totalAsteroidsSpawned > 0"
      ]
    },
    {
      "id": "S4",
      "name": "P1FiredBullet",
      "conditions": [
        "window.__3D_STATE__.bulletCount > 0",
        "window.__3D_STATE__.p1LastShotTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "P2FiredBullet",
      "conditions": [
        "window.__3D_STATE__.p2LastShotTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AsteroidDestroyed",
      "conditions": [
        "window.__3D_STATE__.p1Kills + window.__3D_STATE__.p2Kills > 0"
      ]
    },
    {
      "id": "S7",
      "name": "StationDamaged",
      "conditions": [
        "window.__3D_STATE__.stationHP < 100"
      ]
    },
    {
      "id": "S8",
      "name": "WaveAdvanced",
      "conditions": [
        "window.__3D_STATE__.wave >= 2"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.stationHP <= 0"
      ]
    }
  ],
