{
  "task_id": "P550_wildfire_spread",
  "affordances": [
    {"id": "A1", "name": "Terrain", "type": "3d_object", "semantic": "80x80 heightmap terrain with cell colors", "locator_hints": ["plane geometry mesh"]},
    {"id": "A2", "name": "FireParticles", "type": "3d_object", "semantic": "Billboard fire sprites above burning cells", "locator_hints": ["sprite/points"]},
    {"id": "A3", "name": "WindArrow", "type": "3d_object", "semantic": "Ground arrow showing wind direction", "locator_hints": ["ArrowHelper"]},
    {"id": "A4", "name": "SpeedSlider", "type": "dom_element", "semantic": "Simulation speed control", "locator_hints": ["#slider-speed"]},
    {"id": "A5", "name": "WindSlider", "type": "dom_element", "semantic": "Wind strength control", "locator_hints": ["#slider-wind-strength"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.burningCount === 0", "window.__3D_STATE__.burntCount === 0"]},
    {"id": "S1", "name": "FireStarted", "conditions": ["window.__3D_STATE__.burningCount > 0"]},
    {"id": "S2", "name": "Spreading", "conditions": ["window.__3D_STATE__.burntCount > 0"]},
    {"id": "S3", "name": "WindChanged", "conditions": ["window.__3D_STATE__.windDirection !== 'N'"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.burningCount === 0", "window.__3D_STATE__.burntCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.vegetationCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.burningCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.gridValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.vegetationCount + s.burningCount + s.burntCount > 5000; })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.left + rect.width*0.5, clientY: rect.top + rect.height*0.5})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.burningCount > 0", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.burntCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.burnPercent > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gridValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.vegetationCount + s.burningCount + s.burntCount > 5000; })()", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "w"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.windDirection !== undefined", "tier": "L2"},
        {"expr": "document.getElementById('hud-wind') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.burningCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.burntCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.vegetationCount > 5000", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-wind-strength').value = 0.8; document.getElementById('slider-wind-strength').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.windStrength >= 0.7", "tier": "L2"}
      ]}
    }
  ]
}
