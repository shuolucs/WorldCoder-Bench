{
  "task_id": "P118_lamp_lighting_studio",
  "affordances": [
    {
      "id": "A1",
      "name": "IridescenceLamp",
      "type": "3d_object",
      "semantic": "GLB 模型 IridescenceLamp.glb",
      "locator_hints": [
        "iridescencelamp"
      ]
    },
    {
      "id": "A2",
      "name": "Lantern",
      "type": "3d_object",
      "semantic": "GLB 模型 Lantern.glb",
      "locator_hints": [
        "lantern"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "灯具加载完成，灯光就绪"
    },
    {
      "id": "S2",
      "name": "intensity_changed",
      "description": "灯光强度被调整"
    },
    {
      "id": "S3",
      "name": "shadow_toggled",
      "description": "阴影开关被切换"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.lightCount >= 2"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shadowEnabled !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.intensity !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.shadowEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.lightCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const c = document.querySelector('canvas'); if(!c) return false; const gl = c.getContext('webgl2') || c.getContext('webgl'); return gl !== null; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const s=document.getElementById(\"intensitySlider\"); if(s){s.value=\"3\"; s.dispatchEvent(new Event(\"input\"));} })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.intensity > 2"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightCount !== before.lightCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightCount === 'number' && !isNaN(window.__3D_STATE__.lightCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity === 'number' && !isNaN(window.__3D_STATE__.intensity)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity !== before.intensity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ const b=document.getElementById(\"shadowToggle\"); if(b) b.click(); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.shadowEnabled !== undefined"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightCount !== before.lightCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightCount === 'number' && !isNaN(window.__3D_STATE__.lightCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity === 'number' && !isNaN(window.__3D_STATE__.intensity)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}