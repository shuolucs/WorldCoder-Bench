{
  "task_id": "P2519_elastic_bridge_rope_constraint_solver_wi",
  "affordances": [
    {
      "id": "A1",
      "name": "BridgeNodes",
      "type": "3d_object",
      "semantic": "Array of 21 particle spheres forming the rope bridge",
      "locator_hints": [
        "spheres along x-axis at ~y=6",
        "cyan/blue small spheres"
      ]
    },
    {
      "id": "A2",
      "name": "AnchorNodes",
      "type": "3d_object",
      "semantic": "Two fixed red anchor spheres at bridge endpoints",
      "locator_hints": [
        "red spheres at x=-8 and x=8",
        "larger radius 0.25"
      ]
    },
    {
      "id": "A3",
      "name": "WeightObject",
      "type": "3d_object",
      "semantic": "Gold sphere representing the hanging weight",
      "locator_hints": [
        "gold/yellow sphere radius 0.4",
        "attached to a bridge node"
      ]
    },
    {
      "id": "A4",
      "name": "ConstraintLines",
      "type": "3d_object",
      "semantic": "Cyan line segments connecting adjacent bridge nodes",
      "locator_hints": [
        "cyan lines between node spheres"
      ]
    },
    {
      "id": "A5",
      "name": "WeightSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling weight in kg (0-50)",
      "locator_hints": [
        "#weightSlider",
        "input[type=range]"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle pause/resume of simulation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Overlay panel showing weight, node, sag, energy info",
      "locator_hints": [
        "top-left overlay",
        "semi-transparent panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.nodeCount === 21"
      ]
    },
    {
      "id": "S1",
      "name": "Settled_Default",
      "conditions": [
        "window.__3D_STATE__.simStep > 120",
        "window.__3D_STATE__.kineticEnergy < 1.0",
        "window.__3D_STATE__.weightNodeIndex === 10",
        "window.__3D_STATE__.weightValue === 10"
      ]
    },
    {
      "id": "S2",
      "name": "Weight_Increased",
      "conditions": [
        "window.__3D_STATE__.weightValue === 35",
        "window.__3D_STATE__.bridgeSag > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Settled_Heavy",
      "conditions": [
        "window.__3D_STATE__.simStep > 300",
        "window.__3D_STATE__.kineticEnergy < 1.5"
      ]
    },
    {
      "id": "S4",
      "name": "Weight_Moved_Right",
      "conditions": [
        "window.__3D_STATE__.weightNodeIndex > 10"
      ]
    },
    {
      "id": "S5",
      "name": "Weight_Moved_Left",
      "conditions": [
        "window.__3D_STATE__.weightNodeIndex < 10"
      ]
    },
    {
      "id": "S6",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S8",
      "name": "Zero_Weight",
      "conditions": [
        "window.__3D_STATE__.weightValue === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.weightNodeIndex === 10",
        "window.__3D_STATE__.weightValue === 10"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 21",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.nodePositions) && window.__3D_STATE__.nodePositions.length === 21",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.anchorIndices[0] === 0 && window.__3D_STATE__.anchorIndices[1] === 20",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.anchorPositionsCorrect === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalConstraints === 20",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.restHeight === 6",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.constraintIterations === 5",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.bridgeSag > 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.kineticEnergy) && window.__3D_STATE__.kineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions[0].x === -8 && Math.abs(window.__3D_STATE__.nodePositions[0].y - 6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions[20].x === 8 && Math.abs(window.__3D_STATE__.nodePositions[20].y - 6) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('weightSlider').value = 35; document.getElementById('weightSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightValue === 35",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.bridgeSag > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.bridgeSag) && isFinite(window.__3D_STATE__.bridgeSag)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maxStretch < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lowestNodeIndex >= 1 && window.__3D_STATE__.lowestNodeIndex <= 19",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.kineticEnergy < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bridgeSag > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageBridgeY < 6.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions[10].y < window.__3D_STATE__.nodePositions[0].y",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(function(p){ return !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z); })",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightNodeIndex === 13",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.weightNodeIndex > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weightNodeIndex <= 19",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lowestNodeIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions[window.__3D_STATE__.weightNodeIndex].y < 6.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "count": 7
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightNodeIndex === 6",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.weightNodeIndex < 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weightNodeIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bridgeSag > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions[window.__3D_STATE__.weightNodeIndex].y < window.__3D_STATE__.restHeight",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ window.__pausedStep = window.__3D_STATE__.simStep; return true; })()",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.simStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.kineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anchorPositionsCorrect === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simStep >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.kineticEnergy)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 21",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalConstraints === 20",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('weightSlider').value = 0; document.getElementById('weightSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightValue === 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.bridgeSag)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maxStretch < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(function(p){ return isFinite(p.y); })",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.anchorPositionsCorrect === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightNodeIndex === 10",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.weightValue === 10",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anchorPositionsCorrect === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nodePositions[10].y - 6) < 0.5 || window.__3D_STATE__.simStep < 10",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}