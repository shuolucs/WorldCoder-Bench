{
  "task_id": "P2182_vertex_displacement_wave_function_editor",
  "affordances": [
    {
      "id": "A1",
      "name": "DragonModel",
      "type": "3d_object",
      "semantic": "The loaded DragonAttenuation.glb model with displaced vertices",
      "locator_hints": [
        "scene.children mesh",
        "GLTFLoader result"
      ]
    },
    {
      "id": "A2",
      "name": "WavePanel",
      "type": "dom_element",
      "semantic": "Left-side UI panel for wave function editing",
      "locator_hints": [
        "fixed left panel",
        "width 320px"
      ]
    },
    {
      "id": "A3",
      "name": "AddLayerButton",
      "type": "dom_element",
      "semantic": "Button to add a new wave layer",
      "locator_hints": [
        "#btn-add-layer"
      ]
    },
    {
      "id": "A4",
      "name": "RemoveLayerButton",
      "type": "dom_element",
      "semantic": "Button to remove the last wave layer",
      "locator_hints": [
        "#btn-remove-layer"
      ]
    },
    {
      "id": "A5",
      "name": "ResetAllButton",
      "type": "dom_element",
      "semantic": "Button to reset all layers and geometry",
      "locator_hints": [
        "#btn-reset-all"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleAnimButton",
      "type": "dom_element",
      "semantic": "Button to toggle animation",
      "locator_hints": [
        "#btn-toggle-anim"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleWireframeButton",
      "type": "dom_element",
      "semantic": "Button to toggle wireframe mode",
      "locator_hints": [
        "#btn-toggle-wireframe"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_DefaultWave",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.waveLayers[0].type === 'sine'",
        "window.__3D_STATE__.animating === true"
      ]
    },
    {
      "id": "S1",
      "name": "TwoLayersActive",
      "conditions": [
        "window.__3D_STATE__.layerCount === 2",
        "window.__3D_STATE__.waveLayers.length === 2"
      ]
    },
    {
      "id": "S2",
      "name": "ThreeLayersActive",
      "conditions": [
        "window.__3D_STATE__.layerCount === 3"
      ]
    },
    {
      "id": "S3",
      "name": "Layer2Selected",
      "conditions": [
        "window.__3D_STATE__.activeLayerIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "AmplitudeModified",
      "conditions": [
        "window.__3D_STATE__.waveLayers[1].amplitude !== 0.2"
      ]
    },
    {
      "id": "S5",
      "name": "FrequencyModified",
      "conditions": [
        "window.__3D_STATE__.waveLayers[1].frequency !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S7",
      "name": "WireframeEnabled",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S8",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 0",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S9",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S10",
      "name": "LayerRemoved",
      "conditions": [
        "window.__3D_STATE__.layerCount === 2",
        "window.__3D_STATE__.lastAction === 'remove_layer'"
      ]
    },
    {
      "id": "S11",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.waveLayers[0].type === 'sine'",
        "window.__3D_STATE__.waveLayers[0].amplitude === 0.2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexCount > 0 && Number.isFinite(window.__3D_STATE__.vertexCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.originalPositionsStored === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.waveLayers) && window.__3D_STATE__.waveLayers.length === 1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[0].type === 'sine' && window.__3D_STATE__.waveLayers[0].amplitude === 0.2 && window.__3D_STATE__.waveLayers[0].frequency === 1.0 && window.__3D_STATE__.waveLayers[0].axis === 'y'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-layer"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[1].type === 'sine' && window.__3D_STATE__.waveLayers[1].amplitude === 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[1].enabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add_layer'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-layer"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[2].amplitude === 0.2 && window.__3D_STATE__.waveLayers[2].frequency === 1.0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy) && window.__3D_STATE__.totalDisplacementEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeLayerIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'select_layer'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.maxDisplacement) && !Number.isNaN(window.__3D_STATE__.minDisplacement)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.waveLayers[1].amplitude - 0.25) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'set_amplitude'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[1].amplitude >= 0 && window.__3D_STATE__.waveLayers[1].amplitude <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.waveLayers[1].frequency - 1.5) < 0.001 || Math.abs(window.__3D_STATE__.waveLayers[1].frequency - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[1].frequency >= 0.1 && window.__3D_STATE__.waveLayers[1].frequency <= 10.0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy) && window.__3D_STATE__.totalDisplacementEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.maxDisplacement) <= (window.__3D_STATE__.waveLayers.reduce((s,l) => s + (l.enabled ? l.amplitude : 0), 0) + 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_anim'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframe === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_wireframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy) && window.__3D_STATE__.totalDisplacementEnergy >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframe === false",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "x"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframe === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0 || window.__3D_STATE__.redoStackSize >= 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy) && window.__3D_STATE__.totalDisplacementEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-remove-layer"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'remove_layer'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalDisplacementEnergy) && window.__3D_STATE__.totalDisplacementEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.maxDisplacement) <= (window.__3D_STATE__.waveLayers.reduce((s,l) => s + (l.enabled ? l.amplitude : 0), 0) + 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset-all"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveLayers[0].type === 'sine'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waveLayers[0].amplitude - 0.2) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waveLayers[0].frequency - 1.0) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset_all'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}