{
  "task_id": "P2000_urban_heat_island_microclimate_simulatio",
  "affordances": [
    {
      "id": "A1",
      "name": "CityGrid",
      "type": "3d_object",
      "semantic": "20x20 grid of thermally-interacting urban cells",
      "locator_hints": [
        "ground plane children",
        "grid mesh group"
      ]
    },
    {
      "id": "A2",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggles simulation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A3",
      "name": "StepButton",
      "type": "dom_element",
      "semantic": "Advances simulation by one tick",
      "locator_hints": [
        "#btn-step"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "SolarSlider",
      "type": "dom_element",
      "semantic": "Controls solar intensity 0.0-2.0",
      "locator_hints": [
        "#slider-solar"
      ]
    },
    {
      "id": "A6",
      "name": "ToolSelector",
      "type": "dom_element",
      "semantic": "Dropdown to select inspect/add-park/add-water/add-building",
      "locator_hints": [
        "#select-tool"
      ]
    },
    {
      "id": "A7",
      "name": "WindToggle",
      "type": "dom_element",
      "semantic": "Toggles directional wind effect",
      "locator_hints": [
        "#btn-wind"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Displays tick count, avg/min/max temp, hotspot count",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A9",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Shows details of selected cell",
      "locator_hints": [
        "#info-panel"
      ]
    },
    {
      "id": "A10",
      "name": "Legend",
      "type": "dom_element",
      "semantic": "Color legend for temperature mapping",
      "locator_hints": [
        "#legend"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.solarIntensity === 1.0",
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "AfterOneStep",
      "conditions": [
        "window.__3D_STATE__.tickCount === 1",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMultipleSteps",
      "conditions": [
        "window.__3D_STATE__.tickCount === 5",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.tickCount > 5"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPausedMidRun",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.tickCount > 5"
      ]
    },
    {
      "id": "S5",
      "name": "SolarIntensityChanged",
      "conditions": [
        "window.__3D_STATE__.solarIntensity === 1.8"
      ]
    },
    {
      "id": "S6",
      "name": "AfterHighSolarStep",
      "conditions": [
        "window.__3D_STATE__.tickCount > 5",
        "window.__3D_STATE__.solarIntensity === 1.8"
      ]
    },
    {
      "id": "S7",
      "name": "WindEnabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "CellConverted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'convert_cell'"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.isRunning === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.gridData) && window.__3D_STATE__.gridData.length === 400",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 0 && window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgTemp === 'number' && !isNaN(window.__3D_STATE__.avgTemp) && window.__3D_STATE__.avgTemp > 15 && window.__3D_STATE__.avgTemp < 40",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellTypeCount.building > 0 && window.__3D_STATE__.cellTypeCount.road > 0 && window.__3D_STATE__.cellTypeCount.park > 0 && window.__3D_STATE__.cellTypeCount.water > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => typeof c.temperature === 'number' && !isNaN(c.temperature) && isFinite(c.temperature))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => !isNaN(c.temperature) && isFinite(c.temperature))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'road').every(c => c.temperature > 34 && c.temperature < 37)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'water').every(c => c.temperature < 19)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalHeatEnergy === 'number' && !isNaN(window.__3D_STATE__.totalHeatEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){document.getElementById('btn-step').click(); await new Promise(r=>setTimeout(r,100));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp < window.__3D_STATE__.avgTemp && window.__3D_STATE__.avgTemp < window.__3D_STATE__.maxTemp",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'water').reduce((s,c) => s + c.temperature, 0) / window.__3D_STATE__.gridData.filter(c => c.type === 'water').length < window.__3D_STATE__.gridData.filter(c => c.type === 'road').reduce((s,c) => s + c.temperature, 0) / window.__3D_STATE__.gridData.filter(c => c.type === 'road').length",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hotspotCount >= 0 && typeof window.__3D_STATE__.hotspotCount === 'number'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'play'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgTemp === 'number' && !isNaN(window.__3D_STATE__.avgTemp)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r=>setTimeout(r,1200)); document.getElementById('btn-play-pause').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => !isNaN(c.temperature) && isFinite(c.temperature) && c.temperature > -50 && c.temperature < 200)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'pause'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avgTemp - window.__3D_STATE__.gridData.reduce((s,c) => s + c.temperature, 0) / 400) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('slider-solar'); const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '1.8'); slider.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.solarIntensity === 1.8 || Math.abs(window.__3D_STATE__.solarIntensity - 1.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'set_solar'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.solarIntensity === 'number' && !isNaN(window.__3D_STATE__.solarIntensity)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.solarIntensity >= 0 && window.__3D_STATE__.solarIntensity <= 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevAvg = window.__3D_STATE__.avgTemp; window.__PREV_AVG__ = prevAvg; for(let i=0;i<3;i++){document.getElementById('btn-step').click(); await new Promise(r=>setTimeout(r,100);}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.solarIntensity === 1.8 || Math.abs(window.__3D_STATE__.solarIntensity - 1.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemp > window.__PREV_AVG__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => !isNaN(c.temperature) && isFinite(c.temperature))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'road').reduce((s,c) => s + c.temperature, 0) / Math.max(1, window.__3D_STATE__.gridData.filter(c => c.type === 'road').length) > window.__3D_STATE__.gridData.filter(c => c.type === 'park').reduce((s,c) => s + c.temperature, 0) / Math.max(1, window.__3D_STATE__.gridData.filter(c => c.type === 'park').length)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.hotspotCount === 'number' && window.__3D_STATE__.hotspotCount >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-wind"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_wind'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => !isNaN(c.temperature) && isFinite(c.temperature))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sel = document.getElementById('select-tool'); sel.value = 'add-park'; sel.dispatchEvent(new Event('change', {bubbles:true})); await new Promise(r=>setTimeout(r,200)); const prevBuildingCount = window.__3D_STATE__.cellTypeCount.building; window.__PREV_BUILDING_COUNT__ = prevBuildingCount; const buildingCell = window.__3D_STATE__.gridData.find(c => c.type === 'building'); if(buildingCell) { window.__TARGET_ROW__ = buildingCell.row; window.__TARGET_COL__ = buildingCell.col; } const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); if(buildingCell) { const cellX = -20 + buildingCell.col * 2 + 1; const cellZ = -20 + buildingCell.row * 2 + 1; canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedTool === 'add-park'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellTypeCount.park >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => ['building','road','park','water'].includes(c.type))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellTypeCount.building + window.__3D_STATE__.cellTypeCount.road + window.__3D_STATE__.cellTypeCount.park + window.__3D_STATE__.cellTypeCount.water === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.every(c => !isNaN(c.temperature) && isFinite(c.temperature))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'building').every(c => Math.abs(c.temperature - 30) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'road').every(c => Math.abs(c.temperature - 35) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridData.filter(c => c.type === 'water').every(c => Math.abs(c.temperature - 18) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}