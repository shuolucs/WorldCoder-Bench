  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.magnetPower === 0",
        "window.__3D_STATE__.activePreset === 'iron'",
        "window.__3D_STATE__.spikeCount === 0",
        "window.__3D_STATE__.historyStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Low_Field_Active",
      "conditions": [
        "window.__3D_STATE__.magnetPower > 0 && window.__3D_STATE__.magnetPower <= 2.0",
        "window.__3D_STATE__.spikeCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "High_Field_Active",
      "conditions": [
        "window.__3D_STATE__.magnetPower > 2.0",
        "window.__3D_STATE__.spikeCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Field_Moved",
      "conditions": [
        "window.__3D_STATE__.fieldCenter.x !== 0 || window.__3D_STATE__.fieldCenter.z !== 0 || window.__3D_STATE__.fieldCenter.y !== 1"
      ]
    },
    {
      "id": "S4",
      "name": "Pulsing",
      "conditions": [
        "window.__3D_STATE__.isPulsing === true"
      ]
    },
    {
      "id": "S5",
      "name": "Cobalt_Preset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'cobalt'"
      ]
    },
    {
      "id": "S6",
      "name": "Nickel_Preset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'nickel'"
      ]
    },
    {
      "id": "S7",
      "name": "After_Undo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S8",
      "name": "After_Redo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0 && window.__3D_STATE__.historyStackSize > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.magnetPower === 0",
        "window.__3D_STATE__.fieldCenter.x === 0 && window.__3D_STATE__.fieldCenter.y === 1 && window.__3D_STATE__.fieldCenter.z === 0"
      ]
    }
