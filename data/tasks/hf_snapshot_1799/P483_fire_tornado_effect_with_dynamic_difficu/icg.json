        "#toggleWind"
      ]
    },
    {
      "id": "A5",
      "name": "Difficulty System",
      "type": "3d_object",
      "semantic": "Dynamic difficulty controlling tornado intensity",
      "locator_hints": [
        "window.__3D_STATE__.difficultyLevel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.tornadoActive === true",
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.difficultyLevel === 1"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel > 1",
        "window.__3D_STATE__.tornadoActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "MaxDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.difficultyLabel === 'Apocalypse'"
      ]
    },
    {
      "id": "S4",
      "name": "TornadoPaused",
      "conditions": [
        "window.__3D_STATE__.tornadoActive === false"
      ]
    },
    {
      "id": "S5",
      "name": "TornadoResumed",
      "conditions": [
        "window.__3D_STATE__.tornadoActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "WindEnabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.tornadoActive === true",
        "window.__3D_STATE__.windEnabled === false"
      ]
    }
  ],
