{
  "task_id": "P2428_electrolysis_of_brine_chlorine_generatio",
  "affordances": [
    {
      "id": "A1",
      "name": "ElectrolysisCell",
      "type": "3d_object",
      "semantic": "Transparent glass cell containing brine solution and electrodes",
      "locator_hints": [
        "cellExists === true"
      ]
    },
    {
      "id": "A2",
      "name": "Anode",
      "type": "3d_object",
      "semantic": "Left electrode (dark gray) where Cl₂ is generated",
      "locator_hints": [
        "anodeExists === true"
      ]
    },
    {
      "id": "A3",
      "name": "Cathode",
      "type": "3d_object",
      "semantic": "Right electrode (silver) where H₂ is generated",
      "locator_hints": [
        "cathodeExists === true"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleButton",
      "type": "dom_element",
      "semantic": "Start/Stop electrolysis toggle button",
      "locator_hints": [
        "#toggleBtn"
      ]
    },
    {
      "id": "A5",
      "name": "VoltageSlider",
      "type": "dom_element",
      "semantic": "Slider controlling applied voltage (0-7V)",
      "locator_hints": [
        "#voltageSlider"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Displays real-time simulation data",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Toggleable panel showing balanced equation",
      "locator_hints": [
        "#infoPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialStopped",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.cl2Moles === 0",
        "window.__3D_STATE__.h2Moles === 0",
        "window.__3D_STATE__.naohMoles === 0",
        "window.__3D_STATE__.voltage === 3.0"
      ]
    },
    {
      "id": "S1",
      "name": "ElectrolysisRunning",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.voltage >= 2.0"
      ]
    },
    {
      "id": "S2",
      "name": "GasAccumulated",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.cl2Moles > 0",
        "window.__3D_STATE__.h2Moles > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ElectrolysisPaused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.cl2Moles > 0"
      ]
    },
    {
      "id": "S4",
      "name": "VoltageAdjusted",
      "conditions": [
        "window.__3D_STATE__.voltage !== 3.0"
      ]
    },
    {
      "id": "S5",
      "name": "InfoPanelShown",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.cl2Moles === 0",
        "window.__3D_STATE__.h2Moles === 0",
        "window.__3D_STATE__.naohMoles === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anodeExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cathodeExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === false && window.__3D_STATE__.cl2Moles === 0 && window.__3D_STATE__.h2Moles === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.voltage === 'number' && !isNaN(window.__3D_STATE__.voltage) && window.__3D_STATE__.voltage === 3.0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.voltage >= 2.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bubbleCount === 'number' && window.__3D_STATE__.bubbleCount >= 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cl2Moles >= 0 && window.__3D_STATE__.h2Moles >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cl2Moles > 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.h2Moles > 0.005",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cl2Moles - window.__3D_STATE__.h2Moles) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.naohMoles - 2 * window.__3D_STATE__.h2Moles) < 0.002",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cl2GasOpacity > 0 && window.__3D_STATE__.cl2GasOpacity <= 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cl2Moles > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.h2Moles > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.naohMoles > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cl2Moles - window.__3D_STATE__.h2Moles) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('voltageSlider').value = 1.5; document.getElementById('voltageSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.voltage === 1.5 || Math.abs(window.__3D_STATE__.voltage - 1.5) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voltage < 2.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.voltage === 'number' && !isNaN(window.__3D_STATE__.voltage)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('toggleBtn').click(); await new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voltage < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cl2Moles === 'number' && !isNaN(window.__3D_STATE__.cl2Moles)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "i"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.infoPanelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.infoPanelVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('infoPanel') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('infoPanel').style.display !== 'none' || document.getElementById('infoPanel').offsetParent !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cl2Moles === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.h2Moles === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.naohMoles === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cl2GasOpacity === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}