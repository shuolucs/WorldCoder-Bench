        "code": "const preBefore = window.__3D_STATE__.stockPrices.map(p=>p); document.querySelector('#stepBtn').click(); await new Promise(r => setTimeout(r, 500)); window.__testPreCrashPrices = preBefore;"
      },
      "verifier": {
