{
  "task_id": "P308_miniature_stock_market_landscape_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "DioramaBase",
      "type": "3d_object",
      "semantic": "Circular green platform serving as diorama base",
      "locator_hints": [
        "circle geometry at y=0",
        "dark green material"
      ]
    },
    {
      "id": "A2",
      "name": "StockBarRows",
      "type": "3d_object",
      "semantic": "5 rows of 20 vertical bars representing stock price histories",
      "locator_hints": [
        "BoxGeometry bars",
        "colored by stock"
      ]
    },
    {
      "id": "A3",
      "name": "FoxMascot",
      "type": "3d_object",
      "semantic": "Fox.glb model as market mascot on platform edge",
      "locator_hints": [
        "GLTF model",
        "scale 0.03"
      ]
    },
    {
      "id": "A4",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggle simulation play/pause",
      "locator_hints": [
        "#playPauseBtn"
      ]
    },
    {
      "id": "A5",
      "name": "StepButton",
      "type": "dom_element",
      "semantic": "Advance simulation by one tick",
      "locator_hints": [
        "#stepBtn"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Control simulation tick speed",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing tick count, prices, selection, state",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A8",
      "name": "GridHelper",
      "type": "3d_object",
      "semantic": "Toggleable grid overlay on diorama",
      "locator_hints": [
        "GridHelper"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.simState === 'PAUSED'",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.selectedStock === -1",
        "window.__3D_STATE__.gridVisible === false",
        "window.__3D_STATE__.foxLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "After_Step",
      "conditions": [
        "window.__3D_STATE__.tickCount === 1",
        "window.__3D_STATE__.simState === 'PAUSED'"
      ]
    },
    {
      "id": "S2",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.simState === 'PLAYING'"
      ]
    },
    {
      "id": "S3",
      "name": "Paused_After_Play",
      "conditions": [
        "window.__3D_STATE__.simState === 'PAUSED'",
        "window.__3D_STATE__.tickCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "Stock_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedStock >= 0 && window.__3D_STATE__.selectedStock <= 4"
      ]
    },
    {
      "id": "S5",
      "name": "Camera_TopDown",
      "conditions": [
        "window.__3D_STATE__.cameraPreset === 1"
      ]
    },
    {
      "id": "S6",
      "name": "Grid_Visible",
      "conditions": [
        "window.__3D_STATE__.gridVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Fox_Moved_To_Stock",
      "conditions": [
        "window.__3D_STATE__.selectedStock >= 0",
        "Math.abs(window.__3D_STATE__.foxPosition.x - (-5)) < 1.5"
      ]
    },
    {
      "id": "S8",
      "name": "Crash_Pending",
      "conditions": [
        "window.__3D_STATE__.crashPending === true"
      ]
    },
    {
      "id": "S9",
      "name": "After_Crash_Tick",
      "conditions": [
        "window.__3D_STATE__.crashPending === false"
      ]
    },
    {
      "id": "S10",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#stepBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#playPauseBtn').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 4500)); document.querySelector('#playPauseBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#playPauseBtn').textContent.trim() === 'Play'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
