      ]
    },
    {
      "id": "A7",
      "name": "WireframeOverlay",
      "type": "3d_object",
      "semantic": "Wireframe sphere overlay indicating selected bubble",
      "locator_hints": [
        "wireframe mesh slightly larger than selected bubble"
      ]
    },
    {
      "id": "A8",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing bubble count, selection, pause state",
      "locator_hints": [
        "div overlay top-left"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.bubbleCount === 5",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.selectedBubbleIndex === -1",
        "window.__3D_STATE__.filmThickness === 300"
      ]
    },
    {
      "id": "S1",
      "name": "BubbleSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBubbleIndex >= 0",
        "window.__3D_STATE__.selectedBubbleIndex < window.__3D_STATE__.bubbleCount"
      ]
    },
    {
      "id": "S2",
      "name": "ThicknessAdjusted",
      "conditions": [
        "window.__3D_STATE__.filmThickness !== 300"
      ]
    },
    {
      "id": "S3",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S4",
      "name": "BubblePopped",
      "conditions": [
        "window.__3D_STATE__.bubbleCount < 5",
        "window.__3D_STATE__.lastPoppedIndex >= 0"
      ]
    },
    {
      "id": "S5",
      "name": "BubblesRandomized",
      "conditions": [
        "window.__3D_STATE__.bubblePositions.length === window.__3D_STATE__.bubbleCount"
      ]
    },
    {
      "id": "S6",
      "name": "IOR_Adjusted",
      "conditions": [
        "window.__3D_STATE__.ior !== 1.33"
      ]
    },
    {
      "id": "S7",
      "name": "AnimationResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bubblePositions) && window.__3D_STATE__.bubblePositions.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bubbleRadii) && window.__3D_STATE__.bubbleRadii.every(r => r >= 0.25 && r <= 0.6)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.filmThickness === 300 && window.__3D_STATE__.opacity === 0.6 && window.__3D_STATE__.ior === 1.33",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const raycaster = new THREE.Raycaster(); const cam = window.__3D_STATE__._camera || document.querySelector('canvas').__scene?.camera; const pos = window.__3D_STATE__.bubblePositions[0]; const canvas = document.querySelector('canvas'); const event = new MouseEvent('click', {clientX: canvas.width/2, clientY: canvas.height/2, bubbles: true}); canvas.dispatchEvent(event); await new Promise(r => setTimeout(r, 500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBubbleIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBubbleIndex < window.__3D_STATE__.bubbleCount",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedBubbleIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBubbleIndex !== -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider) { slider.value = 450; slider.dispatchEvent(new Event('input', {bubbles:true})); } await new Promise(r => setTimeout(r, 300));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.filmThickness === 450",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filmThickness >= 100 && window.__3D_STATE__.filmThickness <= 600",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.filmThickness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.filmThickness)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filmThickness !== 300",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.paused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "(function(){ const t = window.__3D_STATE__.time; return typeof t === 'number' && !isNaN(t); })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.time === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.time)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "description": "Click the Pop Bubble button to remove the selected bubble"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bubbleCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastPoppedIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bubblePositions) && window.__3D_STATE__.bubblePositions.length === 4",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bubbleRadii) && window.__3D_STATE__.bubbleRadii.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.bubblePositions) && window.__3D_STATE__.bubblePositions.length === window.__3D_STATE__.bubbleCount",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bubblePositions.every(p => p.x >= -1.5 && p.x <= 1.5 && p.y >= 0.0 && p.y <= 2.5 && p.z >= -1.0 && p.z <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleRadii.every(r => r >= 0.25 && r <= 0.6 && !isNaN(r))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubblePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); const iorSlider = Array.from(sliders).find(s => s.max == 2 || s.step == '0.01' && parseFloat(s.max) === 2); if(iorSlider) { iorSlider.value = 1.8; iorSlider.dispatchEvent(new Event('input', {bubbles:true})); } await new Promise(r => setTimeout(r, 300));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.ior === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ior >= 1.0 && window.__3D_STATE__.ior <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ior)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ior - 1.8) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fresnelEnabled === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}