{
  "task_id": "P2184_soap_bubble_thin_film_interference_simul",
  "affordances": [
    {
      "id": "A1",
      "name": "SoapBubble",
      "type": "3d_object",
      "semantic": "Iridescent soap bubble sphere with thin-film interference shader",
      "locator_hints": [
        "SphereGeometry mesh with ShaderMaterial",
        "transparent sphere in scene"
      ]
    },
    {
      "id": "A2",
      "name": "WaterBottleModel",
      "type": "3d_object",
      "semantic": "Loaded WaterBottle.glb model used as decorative prop",
      "locator_hints": [
        "GLTF model at (-2, -0.5, 0)",
        "scaled 3x"
      ]
    },
    {
      "id": "A3",
      "name": "ThicknessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling thin-film thickness in nm for all bubbles",
      "locator_hints": [
        "input[type=range] for thickness",
