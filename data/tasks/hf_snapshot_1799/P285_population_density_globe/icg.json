  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'density'",
        "window.__3D_STATE__.autoRotateEnabled === true",
        "window.__3D_STATE__.globeOpacity === 1.0",
        "window.__3D_STATE__.totalBars === 200",
        "window.__3D_STATE__.cameraDistance >= 3.4 && window.__3D_STATE__.cameraDistance <= 3.6"
      ]
    },
    {
      "id": "S1",
      "name": "AfterAutoRotation",
      "conditions": [
        "window.__3D_STATE__.globeRotationY > 0",
        "!isNaN(window.__3D_STATE__.globeRotationY)",
        "window.__3D_STATE__.autoRotateEnabled === true"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.autoRotateSpeed === 0.005",
        "window.__3D_STATE__.autoRotateEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "GrowthMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'growth'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S4",
      "name": "UrbanMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'urban'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S5",
      "name": "TransparencyToggled",
      "conditions": [
        "window.__3D_STATE__.globeOpacity === 0.5"
      ]
    },
    {
      "id": "S6",
      "name": "TransparencySecond",
      "conditions": [
        "window.__3D_STATE__.globeOpacity === 0.2"
      ]
    },
    {
      "id": "S7",
      "name": "TransparencyReset",
      "conditions": [
        "window.__3D_STATE__.globeOpacity === 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "SearchFiltered",
      "conditions": [
        "window.__3D_STATE__.searchQuery.length > 0",
        "window.__3D_STATE__.visibleBars < 200"
      ]
    },
    {
      "id": "S9",
      "name": "SearchCleared",
      "conditions": [
        "window.__3D_STATE__.searchQuery === ''",
        "window.__3D_STATE__.visibleBars === 200"
      ]
    },
    {
      "id": "S10",
      "name": "CameraZoomed",
      "conditions": [
        "window.__3D_STATE__.cameraDistance >= 2.0 && window.__3D_STATE__.cameraDistance <= 2.5"
      ]
    },
    {
      "id": "S11",
      "name": "CameraReset",
      "conditions": [
        "window.__3D_STATE__.cameraDistance >= 3.4 && window.__3D_STATE__.cameraDistance <= 3.6",
        "window.__3D_STATE__.autoRotateEnabled === true"
      ]
    },
    {
      "id": "S12",
      "name": "BackToDensity",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'density'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    }
