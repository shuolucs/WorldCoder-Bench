  "states": [
    {
      "id": "S0",
      "name": "Initial_Load",
      "conditions": [
        "window.__3D_STATE__.gameActive === true",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.dartsLeft === 3",
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.roundNumber === 1"
