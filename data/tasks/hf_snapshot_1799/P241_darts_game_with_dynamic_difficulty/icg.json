      ]
    },
    {
      "id": "S2",
      "name": "Dart_Hit_Board",
      "conditions": [
        "window.__3D_STATE__.dartInFlight === false",
        "window.__3D_STATE__.lastHitZone !== 'miss'",
        "window.__3D_STATE__.lastHitPoints > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Dart_Missed",
      "conditions": [
        "window.__3D_STATE__.dartInFlight === false",
        "window.__3D_STATE__.lastHitZone === 'miss'",
        "window.__3D_STATE__.lastHitPoints === 0"
      ]
    },
    {
      "id": "S4",
      "name": "Round_Complete",
      "conditions": [
        "window.__3D_STATE__.dartsLeft === 0",
        "window.__3D_STATE__.dartInFlight === false"
      ]
    },
    {
      "id": "S5",
      "name": "Difficulty_Increased",
      "conditions": [
        "window.__3D_STATE__.difficulty > 1"
      ]
    },
    {
      "id": "S6",
      "name": "Next_Round_Started",
      "conditions": [
        "window.__3D_STATE__.dartsLeft === 3",
        "window.__3D_STATE__.roundNumber > 1",
        "window.__3D_STATE__.roundScore === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.roundNumber === 1",
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.dartsLeft === 3"
      ]
    }
