{
  "task_id": "P742_matcap_shader_editor_with_custom_texture",
  "affordances": [
    {
      "id": "A1",
      "name": "MatcapMesh",
      "type": "3d_object",
      "semantic": "The central 3D mesh rendered with matcap shader",
      "locator_hints": [
        "scene.children mesh",
        "ShaderMaterial object"
      ]
    },
    {
      "id": "A2",
      "name": "MatcapPreviews",
      "type": "dom_element",
      "semantic": "Clickable matcap texture preview canvases",
      "locator_hints": [
        ".matcap-preview",
        "data-index attribute"
      ]
    },
    {
      "id": "A3",
      "name": "BrightnessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling brightness uniform",
      "locator_hints": [
