          },
          {
            "expr": "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyLength - 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.normalScale - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.hueShift - Math.PI) < 0.02",
            "tier": "L2"
          }
        ]
      }
    },
    {
