        "code": "document.getElementById('slider-contrast').value = 2.2; document.getElementById('slider-contrast').dispatchEvent(new Event('input')); setTimeout(() => { document.getElementById('slider-saturation').value = 0.4; document.getElementById('slider-saturation').dispatchEvent(new Event('input')); }, 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
