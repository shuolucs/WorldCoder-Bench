          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.brightness - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.contrast - 1.0) < 0.001",
            "tier": "L2"
          },
          {
