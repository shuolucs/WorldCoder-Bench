      ]
    },
    {
      "id": "A6",
      "name": "SaturationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling saturation uniform",
      "locator_hints": [
        "#slider-saturation"
      ]
    },
    {
      "id": "A7",
      "name": "NormalScaleSlider",
      "type": "dom_element",
      "semantic": "Slider controlling normal scale uniform",
      "locator_hints": [
        "#slider-normalScale"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A9",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last parameter change",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A10",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone parameter change",
      "locator_hints": [
        "#btn-redo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.shaderCompiled === true",
        "window.__3D_STATE__.meshType === 'torusknot'",
        "window.__3D_STATE__.activeMatcapIndex === 0",
        "window.__3D_STATE__.uniforms.brightness === 1.0",
        "window.__3D_STATE__.uniforms.hueShift === 0.0"
      ]
    },
    {
      "id": "S1",
      "name": "MatcapChanged",
      "conditions": [
        "window.__3D_STATE__.activeMatcapIndex !== 0",
        "window.__3D_STATE__.lastAction === 'matcap_changed'"
      ]
    },
    {
      "id": "S2",
      "name": "BrightnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.uniforms.brightness !== 1.0",
        "window.__3D_STATE__.lastAction === 'slider_brightness'"
      ]
    },
    {
      "id": "S3",
      "name": "MeshSwitched",
      "conditions": [
        "window.__3D_STATE__.meshType !== 'torusknot'",
        "window.__3D_STATE__.lastAction === 'mesh_changed'"
      ]
    },
    {
      "id": "S4",
      "name": "HueShifted",
      "conditions": [
        "window.__3D_STATE__.uniforms.hueShift > 0",
        "window.__3D_STATE__.lastAction === 'slider_hueShift'"
      ]
    },
    {
      "id": "S5",
      "name": "MultiParamsChanged",
      "conditions": [
        "window.__3D_STATE__.historyLength >= 4"
      ]
    },
    {
      "id": "S6",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S7",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'reset'",
        "window.__3D_STATE__.uniforms.brightness === 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "AutoRotateToggled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S10",
      "name": "ContrastAndSaturationTuned",
      "conditions": [
        "window.__3D_STATE__.uniforms.contrast !== 1.0",
        "window.__3D_STATE__.uniforms.saturation !== 1.0"
      ]
    },
    {
      "id": "S11",
      "name": "FullChainComplete",
      "conditions": [
        "window.__3D_STATE__.shaderCompiled === true",
        "window.__3D_STATE__.meshType === 'cube'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": ".matcap-preview[data-index='2']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeMatcapIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeMatcapIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'matcap_changed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-brightness').value = 1.8; document.getElementById('slider-brightness').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.uniforms.brightness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.brightness - 1.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider_brightness'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.brightness > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.brightness <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.meshType === 'sphere'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'mesh_changed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshVertexCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.brightness - 1.8) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-hueShift').value = 180; document.getElementById('slider-hueShift').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.uniforms.hueShift === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.uniforms.hueShift - Math.PI) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider_hueShift'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.hueShift >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.hueShift <= 2 * Math.PI",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-normalScale').value = 2.5; document.getElementById('slider-normalScale').dispatchEvent(new Event('input'));"
