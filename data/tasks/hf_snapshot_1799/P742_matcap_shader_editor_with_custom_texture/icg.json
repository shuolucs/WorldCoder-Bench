          {
            "expr": "window.__3D_STATE__.historyLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.normalScale >= 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniforms.normalScale <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.uniforms.normalScale)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
