{
  "task_id": "P1172_lip_sync_phoneme_mapping_demo",
  "affordances": [
    {
      "id": "A1",
      "name": "HeadMesh",
      "type": "3d_object",
      "semantic": "Stylized 3D head/face sphere",
      "locator_hints": [
        "sphere with skin-tone color",
        "radius ~1.0 at origin"
      ]
    },
    {
      "id": "A2",
      "name": "MouthMesh",
      "type": "3d_object",
      "semantic": "Deformable mouth geometry that changes shape per phoneme",
      "locator_hints": [
        "torus or custom shape below center of head",
        "child of head group"
      ]
    },
    {
      "id": "A3",
      "name": "PhonemeButtonREST",
      "type": "dom_element",
      "semantic": "Button to set REST phoneme",
      "locator_hints": [
        "button containing text 'REST'"
      ]
    },
    {
      "id": "A4",
      "name": "PhonemeButtonAA",
      "type": "dom_element",
      "semantic": "Button to set AA phoneme",
      "locator_hints": [
        "button containing text 'AA'"
      ]
    },
    {
      "id": "A5",
      "name": "PhonemeButtonEE",
      "type": "dom_element",
      "semantic": "Button to set EE phoneme",
      "locator_hints": [
        "button containing text 'EE'"
      ]
    },
    {
      "id": "A6",
      "name": "PhonemeButtonOO",
      "type": "dom_element",
      "semantic": "Button to set OO phoneme",
      "locator_hints": [
        "button containing text 'OO'"
      ]
    },
    {
      "id": "A7",
      "name": "PhonemeButtonMM",
      "type": "dom_element",
      "semantic": "Button to set MM phoneme",
      "locator_hints": [
        "button containing text 'MM'"
      ]
    },
    {
      "id": "A8",
      "name": "PlaySequenceButton",
      "type": "dom_element",
      "semantic": "Button to start HELLO phoneme sequence playback",
      "locator_hints": [
        "button with green background",
        "text 'Play Sequence'"
      ]
    },
    {
      "id": "A9",
      "name": "SpeedToggleButton",
      "type": "dom_element",
      "semantic": "Button to cycle playback speed 1x/0.5x/2x",
      "locator_hints": [
        "button containing text 'Speed'"
      ]
    },
    {
      "id": "A10",
      "name": "HUDOverlay",
      "type": "dom_element",
      "semantic": "Top-left HUD showing current phoneme, speed, playing status",
      "locator_hints": [
        "top-left positioned div",
        "overlay text"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_REST",
      "conditions": [
        "window.__3D_STATE__.currentPhoneme === 'REST'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.phonemeIndex === -1",
        "window.__3D_STATE__.playbackSpeed === 1"
      ]
    },
    {
      "id": "S1",
      "name": "Phoneme_AA_Active",
      "conditions": [
        "window.__3D_STATE__.currentPhoneme === 'AA'",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "Phoneme_OO_Active",
      "conditions": [
        "window.__3D_STATE__.currentPhoneme === 'OO'",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "Sequence_Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.phonemeIndex >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "Sequence_Finished",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentPhoneme === 'REST'"
      ]
    },
    {
      "id": "S5",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 1"
      ]
    },
    {
      "id": "S6",
      "name": "Phoneme_EE_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.currentPhoneme === 'EE'",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S7",
      "name": "Phoneme_MM_Active",
      "conditions": [
        "window.__3D_STATE__.currentPhoneme === 'MM'",
        "window.__3D_STATE__.isPlaying === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentPhoneme === 'string' && window.__3D_STATE__.currentPhoneme === 'REST'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.phonemeCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sequenceLength === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false && window.__3D_STATE__.phonemeIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleX >= 0.04 && window.__3D_STATE__.mouthScaleX <= 1.5 && !isNaN(window.__3D_STATE__.mouthScaleX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "AA"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhoneme === 'AA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleX - 0.8) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleY - 1.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleY > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "OO"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhoneme === 'OO'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleX - 0.4) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleY - 0.5) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleX < window.__3D_STATE__.mouthScaleY + 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhoneme === 'EE'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleX - 1.4) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleY < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleX > 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S6",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phonemeIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transitionProgress >= 0 && window.__3D_STATE__.transitionProgress <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime) && window.__3D_STATE__.elapsedTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleX >= 0.04 && window.__3D_STATE__.mouthScaleX <= 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPhoneme === 'REST'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleX - 1.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleY - 0.3) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleY >= 0.04 && !isNaN(window.__3D_STATE__.mouthScaleY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Speed"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 0.5 || window.__3D_STATE__.playbackSpeed === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed !== 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.playbackSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playbackSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "6"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhoneme === 'MM'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mouthScaleY < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mouthScaleX - 1.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed !== 1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}