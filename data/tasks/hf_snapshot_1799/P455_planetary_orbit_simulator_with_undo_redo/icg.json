  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.planetCount === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "TwoPlanets",
      "conditions": [
        "window.__3D_STATE__.planetCount === 2",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S2",
      "name": "ThreePlanets",
      "conditions": [
        "window.__3D_STATE__.planetCount === 3",
        "window.__3D_STATE__.undoStackSize === 2"
      ]
    },
    {
      "id": "S3",
      "name": "UndoneToTwo",
      "conditions": [
        "window.__3D_STATE__.planetCount === 2",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S4",
      "name": "RedoneToThree",
      "conditions": [
        "window.__3D_STATE__.planetCount === 3",
        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
