{
  "task_id": "P1985_satellite_constellation_orbital_coverage",
  "affordances": [
    {
      "id": "A1",
      "name": "Earth",
      "type": "3d_object",
      "semantic": "Central Earth sphere that rotates, radius 6.371 units",
      "locator_hints": [
        "blue-green sphere at origin",
        "radius ~6.371"
      ]
    },
    {
      "id": "A2",
      "name": "Satellites",
      "type": "3d_object",
      "semantic": "Small icosahedron meshes orbiting Earth in constellation patterns",
      "locator_hints": [
        "small bright colored meshes",
        "IcosahedronGeometry"
      ]
    },
    {
      "id": "A3",
      "name": "CoverageCones",
      "type": "3d_object",
      "semantic": "Semi-transparent cones from satellites toward Earth showing sensor footprint",
      "locator_hints": [
        "cone meshes",
        "semi-transparent"
      ]
    },
    {
      "id": "A4",
      "name": "CoverageGrid",
      "type": "3d_object",
      "semantic": "Lat/lon grid overlay on Earth showing covered/uncovered cells",
      "locator_hints": [
        "grid overlay",
        "green and red cells"
      ]
    },
    {
      "id": "A5",
      "name": "WalkerDeltaButton",
      "type": "dom_element",
      "semantic": "Button to load Walker Delta 24/3/1 constellation preset",
      "locator_hints": [
        "button text 'Walker Delta'"
      ]
    },
    {
      "id": "A6",
      "name": "PolarButton",
      "type": "dom_element",
      "semantic": "Button to load Polar 12/3/0 constellation preset",
      "locator_hints": [
        "button text 'Polar'"
      ]
    },
    {
      "id": "A7",
      "name": "EquatorialButton",
      "type": "dom_element",
      "semantic": "Button to load Equatorial 6/1/0 constellation preset",
      "locator_hints": [
        "button text 'Equatorial'"
      ]
    },
    {
      "id": "A8",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to remove all satellites",
      "locator_hints": [
        "button text 'Clear'"
      ]
    },
    {
      "id": "A9",
      "name": "AddPlaneButton",
      "type": "dom_element",
      "semantic": "Button to add a new orbital plane with 4 satellites",
      "locator_hints": [
        "button text 'Add Plane'"
      ]
    },
    {
      "id": "A10",
      "name": "AltitudeSlider",
      "type": "dom_element",
      "semantic": "Slider controlling orbital altitude for new planes (0.5-5.0)",
      "locator_hints": [
        "input[type=range]",
        "altitude"
      ]
    },
    {
      "id": "A11",
      "name": "InclinationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling orbital inclination (0-90 degrees)",
      "locator_hints": [
        "input[type=range]",
        "inclination"
      ]
    },
    {
      "id": "A12",
      "name": "SensorAngleSlider",
      "type": "dom_element",
      "semantic": "Slider controlling sensor half-angle (5-60 degrees)",
      "locator_hints": [
        "input[type=range]",
        "sensor"
      ]
    },
    {
      "id": "A13",
      "name": "SimSpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed multiplier (1-500)",
      "locator_hints": [
        "input[type=range]",
        "speed"
      ]
    },
    {
      "id": "A14",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing satellite count, coverage, revisit time, sim time",
      "locator_hints": [
        "top-left",
        "dark semi-transparent panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 0",
        "window.__3D_STATE__.planeCount === 0",
        "window.__3D_STATE__.coveragePercent === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "WalkerDelta_Loaded",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 24",
        "window.__3D_STATE__.planeCount === 3",
        "window.__3D_STATE__.constellationName === 'Walker Delta 24/3/1'"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Simulation_Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S4",
      "name": "Grid_Visible",
      "conditions": [
        "window.__3D_STATE__.gridVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "Polar_Loaded",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 12",
        "window.__3D_STATE__.planeCount === 3",
        "window.__3D_STATE__.constellationName === 'Polar 12/3/0'"
      ]
    },
    {
      "id": "S6",
      "name": "Cleared",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 0",
        "window.__3D_STATE__.planeCount === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Custom_Plane_Added",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 4",
        "window.__3D_STATE__.planeCount === 1",
        "window.__3D_STATE__.constellationName === 'custom'"
      ]
    },
    {
      "id": "S8",
      "name": "Sensor_Angle_Changed",
      "conditions": [
        "window.__3D_STATE__.sensorAngle !== 25"
      ]
    },
    {
      "id": "S9",
      "name": "Camera_Top_View",
      "conditions": [
        "window.__3D_STATE__.cameraView === 'top'"
      ]
    },
    {
      "id": "S10",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S12",
      "name": "Equatorial_Loaded",
      "conditions": [
        "window.__3D_STATE__.satelliteCount === 6",
        "window.__3D_STATE__.planeCount === 1",
        "window.__3D_STATE__.constellationName === 'Equatorial 6/1/0'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Walker Delta"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.satelliteCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.satelliteCount === 24",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.constellationName === 'Walker Delta 24/3/1'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.satellites) && window.__3D_STATE__.satellites.length === 24",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(Math.sqrt(s.x*s.x + s.y*s.y + s.z*s.z) - (6.371 + 2.0)) < 0.05)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satelliteCount === 24",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gridVisible === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.coverageGrid)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coverageGrid.length === 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coverageGrid[0].length === 18",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coveragePercent >= 0 && window.__3D_STATE__.coveragePercent <= 100",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.latBandCoverage) && window.__3D_STATE__.latBandCoverage.length === 18",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satelliteCount === 24",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy < 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Polar"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.constellationName === 'Polar 12/3/0'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(s.inclination - 90) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Clear"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coveragePercent === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Add Plane"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.constellationName === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(s.altitude - window.__3D_STATE__.altitude) < 0.15)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - (-0.3986004418 / (2 * (6.371 + window.__3D_STATE__.altitude))) * 4) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range][min=\"5\"]') || [...document.querySelectorAll('input[type=range]')].find(s => s.min == '5'); if(slider){slider.value=45; slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sensorAngle === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sensorAngle !== 25",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sensorAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.coveragePercent >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.coveragePercent)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraView === 'top'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraView === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.satelliteCount === 4",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.earthRotation)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthRotation === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coveragePercent === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.constellationName === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(Math.sqrt(s.x*s.x + s.y*s.y + s.z*s.z) - (6.371 + s.altitude)) < 0.05)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S11",
      "to": "S12",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Equatorial"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.satelliteCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.planeCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.constellationName === 'Equatorial 6/1/0'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(s.inclination) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(s.y) < 0.1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.satellites.every(s => Math.abs(Math.sqrt(s.x*s.x + s.y*s.y + s.z*s.z) - (6.371 + 1.2)) < 0.05)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}