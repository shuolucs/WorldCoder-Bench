{
  "task_id": "P575_parachute_drag",
  "affordances": [
    {"id": "A1", "name": "Skydiver", "type": "3d_object", "semantic": "soldier.glb model representing the skydiver in freefall or descent", "locator_hints": ["soldier", "skydiver", "model"]},
    {"id": "A2", "name": "Parachute", "type": "3d_object", "semantic": "Half-sphere canopy that deploys to slow descent", "locator_hints": ["parachute", "canopy", "chute"]},
    {"id": "A3", "name": "Ground", "type": "3d_object", "semantic": "Landing field at y=0", "locator_hints": ["ground", "floor", "plane"]},
    {"id": "A4", "name": "HUD", "type": "dom_element", "semantic": "Top-left overlay showing altitude, velocity, phase", "locator_hints": ["hud", "overlay"]},
    {"id": "A5", "name": "SliderArea", "type": "dom_element", "semantic": "Slider controlling parachute area in m^2", "locator_hints": ["slider-area"]},
    {"id": "A6", "name": "SliderCd", "type": "dom_element", "semantic": "Slider controlling drag coefficient", "locator_hints": ["slider-cd"]},
    {"id": "A7", "name": "SliderMass", "type": "dom_element", "semantic": "Slider controlling skydiver mass in kg", "locator_hints": ["slider-mass"]}
  ],
  "states": [
    {"id": "S0", "name": "initial_freefall", "conditions": ["window.__3D_STATE__.phase === 'freefall'", "window.__3D_STATE__.altitude > 400"]},
    {"id": "S1", "name": "accelerating_freefall", "conditions": ["window.__3D_STATE__.phase === 'freefall'", "window.__3D_STATE__.velocity > 10"]},
    {"id": "S2", "name": "parachute_deployed", "conditions": ["window.__3D_STATE__.parachuteDeployed === true"]},
    {"id": "S3", "name": "stable_descent", "conditions": ["window.__3D_STATE__.phase === 'descent'"]}
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
          {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"},
          {"expr": "window.__3D_STATE__.altitude > 0 && window.__3D_STATE__.altitude <= 500", "tier": "L1"},
          {"expr": "window.__3D_STATE__.phase === 'freefall'", "tier": "L1"},
          {"expr": "typeof window.__3D_STATE__.isValid === 'boolean' && window.__3D_STATE__.isValid === true", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.velocity > before.velocity || window.__3D_STATE__.velocity > 10", "tier": "L1"},
          {"expr": "window.__3D_STATE__.altitude < before.altitude", "tier": "L1"},
          {"expr": "window.__3D_STATE__.dragForce > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.phase === 'freefall'", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.parachuteDeployed === true", "tier": "L1"},
          {"expr": "window.__3D_STATE__.phase === 'deploying' || window.__3D_STATE__.phase === 'descent'", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 4000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.velocity < before.velocity || window.__3D_STATE__.velocity < 15", "tier": "L1"},
          {"expr": "window.__3D_STATE__.phase === 'descent'", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; const vt = s.terminalVelocity; return typeof vt === 'number' && vt > 0 && vt < 20; })()", "tier": "L1"},
          {"expr": "window.__3D_STATE__.altitude < before.altitude && window.__3D_STATE__.altitude > 0", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-area').value = 60; document.getElementById('slider-area').dispatchEvent(new Event('input')); return true;"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "Math.abs(window.__3D_STATE__.parachuteArea - 60) < 2", "tier": "L2"},
          {"expr": "window.__3D_STATE__.terminalVelocity < before.terminalVelocity", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; const vt = Math.sqrt(2 * s.mass * 9.81 / (s.dragCoefficient * s.parachuteArea * 1.225)); return Math.abs(s.terminalVelocity - vt) / vt < 0.3; })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-cd').value = 2.5; document.getElementById('slider-cd').dispatchEvent(new Event('input')); return true;"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "Math.abs(window.__3D_STATE__.dragCoefficient - 2.5) < 0.2", "tier": "L2"},
          {"expr": "window.__3D_STATE__.terminalVelocity < before.terminalVelocity", "tier": "L1"},
          {"expr": "window.__3D_STATE__.dragForce > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    }
  ]
}
