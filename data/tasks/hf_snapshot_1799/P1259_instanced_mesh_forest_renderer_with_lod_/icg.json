  "states": [
    {
      "id": "S0",
      "name": "InitialRender",
      "conditions": [
        "window.__3D_STATE__.totalTrees === 3000",
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.lodFilter === 'all'",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S1",
      "name": "DebugOverlayEnabled",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === true",
        "window.__3D_STATE__.debugBoxCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "DebugOverlayDisabled",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.debugBoxCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "CameraMoved",
      "conditions": [
        "window.__3D_STATE__.cameraPosition !== undefined",
        "window.__3D_STATE__.frameCount > 10"
      ]
    },
    {
      "id": "S4",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 80) < 5",
        "window.__3D_STATE__.cameraDistance > 190 && window.__3D_STATE__.cameraDistance < 230"
      ]
    },
    {
      "id": "S5",
      "name": "LODFiltered",
      "conditions": [
        "window.__3D_STATE__.lodFilter !== 'all'"
      ]
    },
    {
      "id": "S6",
      "name": "LODFilterRestored",
      "conditions": [
        "window.__3D_STATE__.lodFilter === 'all'",
        "window.__3D_STATE__.lodCountSum === 3000"
      ]
    }
  ],
  "transitions": [
