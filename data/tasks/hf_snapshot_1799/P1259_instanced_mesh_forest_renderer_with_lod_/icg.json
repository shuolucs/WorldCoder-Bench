            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lodCounts.lod0 + window.__3D_STATE__.lodCounts.lod1 + window.__3D_STATE__.lodCounts.lod2 === 3000",
            "tier": "L2"
          },
          {
