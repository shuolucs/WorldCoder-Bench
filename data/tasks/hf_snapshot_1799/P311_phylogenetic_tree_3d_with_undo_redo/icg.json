      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const mesh = window.__scene__ ? window.__scene__.getObjectByName('Root') : null; if (!mesh) { const allMeshes = []; window.__scene__ && window.__scene__.traverse(c => { if(c.isMesh) allMeshes.push(c.name); }); console.log('Available meshes:', allMeshes); } else { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(0, 0); raycaster.setFromCamera(mouse, window.__camera__); const intersects = raycaster.intersectObject(mesh); if (intersects.length > 0 || true) { mesh.dispatchEvent({type:'click'}); } } /* Fallback: simulate clicking the Root node */ if (window.__selectNode__) window.__selectNode__('Root');"
      },
