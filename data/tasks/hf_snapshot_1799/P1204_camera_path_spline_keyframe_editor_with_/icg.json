{
  "task_id": "P1204_camera_path_spline_keyframe_editor_with_",
  "affordances": [
    {
      "id": "A1",
      "name": "SplineTube",
      "type": "3d_object",
      "semantic": "Visible tube geometry representing the CatmullRom spline path through keyframes",
      "locator_hints": [
        "tube mesh with color 0x00ffaa"
      ]
    },
    {
      "id": "A2",
      "name": "KeyframeSpheres",
      "type": "3d_object",
      "semantic": "Small orange/yellow spheres marking each keyframe position",
      "locator_hints": [
        "sphere meshes at keyframe positions"
      ]
    },
    {
      "id": "A3",
      "name": "PreviewMarker",
      "type": "3d_object",
      "semantic": "Cone mesh that travels along the spline during playback",
      "locator_hints": [
        "cone mesh color 0xff0044"
      ]
    },
    {
      "id": "A4",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "Particle trail emitted from the preview marker during playback",
      "locator_hints": [
        "points or small sphere pool near marker"
      ]
    },
    {
      "id": "A5",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle playback on/off",
      "locator_hints": [
        "button containing Play or Pause text"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset keyframes and stop playback",
      "locator_hints": [
        "button containing Reset text"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing keyframe count, selection, speed, time",
      "locator_hints": [
        "div in top-left corner"
      ]
    },
    {
      "id": "A8",
      "name": "LandmarkBoxes",
      "type": "3d_object",
      "semantic": "Five colored reference boxes placed in the scene",
      "locator_hints": [
        "box meshes at landmark positions"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEditorState",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 2",
        "window.__3D_STATE__.selectedKeyframeIndex === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.playbackSpeed === 1.0",
        "window.__3D_STATE__.splineTubeVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "KeyframeAdded",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 3",
        "window.__3D_STATE__.splineTubeVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "KeyframeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedKeyframeIndex === 1"
      ]
    },
    {
      "id": "S3",
      "name": "KeyframeMoved",
      "conditions": [
        "window.__3D_STATE__.selectedKeyframeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "PlaybackStarted",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S5",
      "name": "ParticlesEmitting",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.activeParticleCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed === 1.5"
      ]
    },
    {
      "id": "S7",
      "name": "PlaybackPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S8",
      "name": "KeyframeDeleted",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 2"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 2",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.playbackSpeed === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.keyframeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframePositions.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineTubeVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineLength > 0 && isFinite(window.__3D_STATE__.splineLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splinePointCount === 201",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Tab"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedKeyframePosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedKeyframePosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.selectedKeyframePosition.x)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.selectedKeyframePosition.y)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.selectedKeyframePosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedKeyframePosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframePositions[1].x !== window.__3D_STATE__.keyframePositions[0].x",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineLength > 0 && isFinite(window.__3D_STATE__.splineLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineTubeVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match": "Play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.playbackTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.previewMarkerPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.previewMarkerPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.previewMarkerPosition.y)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1200
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticlesEmitted > 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.previewMarkerPosition.x) && isFinite(window.__3D_STATE__.previewMarkerPosition.y) && isFinite(window.__3D_STATE__.previewMarkerPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime <= (window.__3D_STATE__.keyframeCount - 1) * 2 + 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "+"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 1.25 || window.__3D_STATE__.playbackSpeed === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match": "Pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.playbackTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.previewMarkerPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Delete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.keyframeCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframePositions.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineTubeVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineLength > 0 && isFinite(window.__3D_STATE__.splineLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex >= 0 && window.__3D_STATE__.selectedKeyframeIndex < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.keyframeCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.keyframePositions[0].x - (-10)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.keyframePositions[1].x - 10) < 0.01",
            "tier": "L2"
          }
        ]
      }
