{
  "task_id": "P1869_spectroscopy_peak_interactive_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumLine",
      "type": "3d_object",
      "semantic": "The main IR spectrum curve rendered as a THREE.Line with 2000 sample points",
      "locator_hints": [
        "scene.children with isLine",
        "BufferGeometry with 2000 positions"
      ]
    },
    {
      "id": "A2",
      "name": "PeakMarkers",
      "type": "3d_object",
      "semantic": "Six sphere markers at peak minima positions, clickable for selection",
      "locator_hints": [
        "Mesh with SphereGeometry",
        "six children with isMesh"
      ]
    },
    {
      "id": "A3",
      "name": "BaselineLine",
      "type": "3d_object",
      "semantic": "Horizontal reference line at 100% transmittance, toggled by B key",
      "locator_hints": [
        "Line at y=100",
        "toggled visibility"
      ]
    },
    {
      "id": "A4",
      "name": "PeakLabels",
      "type": "3d_object",
      "semantic": "Text labels above each peak showing chemical assignment",
      "locator_hints": [
        "CSS2DObject or Sprite",
        "six label objects"
      ]
    },
    {
      "id": "A5",
      "name": "PeakInfoPanel",
      "type": "dom_element",
      "semantic": "DOM panel showing selected peak details",
      "locator_hints": [
        "#peak-info"
      ]
    },
    {
      "id": "A6",
      "name": "StatusBar",
      "type": "dom_element",
      "semantic": "Bottom status bar showing zoom and view range",
      "locator_hints": [
        "#status-bar"
      ]
    },
    {
      "id": "A7",
      "name": "HUDControls",
      "type": "dom_element",
      "semantic": "Top-left panel listing keyboard shortcuts",
      "locator_hints": [
        "#hud-controls"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.peakCount === 6",
        "window.__3D_STATE__.selectedPeakIndex === -1",
        "window.__3D_STATE__.baselineVisible === false",
        "window.__3D_STATE__.labelsVisible === false",
        "window.__3D_STATE__.normalized === false",
        "window.__3D_STATE__.zoomLevel === 1"
      ]
    },
    {
      "id": "S1",
      "name": "PeakSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex >= 0 && window.__3D_STATE__.selectedPeakIndex < 6"
      ]
    },
    {
      "id": "S2",
      "name": "ZoomedIn",
      "conditions": [
        "window.__3D_STATE__.zoomLevel > 1.0",
        "window.__3D_STATE__.viewRange.max - window.__3D_STATE__.viewRange.min < 3600"
      ]
    },
    {
      "id": "S3",
      "name": "PannedView",
      "conditions": [
        "window.__3D_STATE__.panOffset !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "BaselineOn",
      "conditions": [
        "window.__3D_STATE__.baselineVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "LabelsOn",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "Normalized",
      "conditions": [
        "window.__3D_STATE__.normalized === true"
      ]
    },
    {
      "id": "S7",
      "name": "Exported",
      "conditions": [
        "window.__3D_STATE__.lastExport !== null"
      ]
    },
    {
      "id": "S8",
      "name": "NormalizationReverted",
      "conditions": [
        "window.__3D_STATE__.normalized === false"
      ]
    },
    {
      "id": "S9",
      "name": "PeakDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex === -1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peakCount === 6",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peaks) && window.__3D_STATE__.peaks.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].wavenumber === 3400 && window.__3D_STATE__.peaks[0].assignment === 'O-H stretch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.min === 400 && window.__3D_STATE__.viewRange.max === 4000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "peak_marker_2",
        "description": "Click near the C=O stretch peak at wavenumber ~1720. Compute canvas coordinates mapping wavenumber 1720 to the X pixel position within the canvas, and the transmittance minimum to Y pixel.",
        "coordinates_normalized": [
          0.633,
          0.7
        ]
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].selected === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].wavenumber === 1720",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].assignment === 'C=O stretch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks.filter(p => p.selected).length === 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('peak-info').textContent.includes('1720')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width * 0.5; const cy = rect.top + rect.height * 0.5; for (let i = 0; i < 5; i++) { canvas.dispatchEvent(new WheelEvent('wheel', {deltaY: -100, clientX: cx, clientY: cy, bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.zoomLevel > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.max - window.__3D_STATE__.viewRange.min < 3600",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.min >= 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.max <= 4000",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.zoomLevel === 'number' && !isNaN(window.__3D_STATE__.zoomLevel)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.panOffset !== 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.panOffset === 'number' && !isNaN(window.__3D_STATE__.panOffset)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.min >= 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewRange.max <= 4000",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.panOffset) >= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.baselineVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.baselineVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peakCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalized === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.labelsVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baselineVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.labelsVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peakCount === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.normalized === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.normalizedTransmittances) && window.__3D_STATE__.normalizedTransmittances.length === 6",
            "tier": "L0"
          },
          {
            "expr": "Math.min(...window.__3D_STATE__.normalizedTransmittances) >= -0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.max(...window.__3D_STATE__.normalizedTransmittances) <= 100.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedTransmittances.some(t => t < 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedTransmittances.every(t => !isNaN(t))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastExport !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastExport === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastExport.viewRange === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastExport.selectedPeakIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastExport.timestamp === 'number' && window.__3D_STATE__.lastExport.timestamp > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.normalized === false",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.normalizedTransmittances) && window.__3D_STATE__.normalizedTransmittances.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peaks[2].transmittance > 20 && window.__3D_STATE__.peaks[2].transmittance < 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedTransmittances.every(t => !isNaN(t))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baselineVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "empty_space",
        "description": "Click on empty area of the spectrum away from any peak marker to deselect",
        "coordinates_normalized": [
          0.1,
          0.1
        ]
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks.every(p => p.selected === false)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('peak-info').textContent.toLowerCase().includes('no peak') || !document.getElementById('peak-info').textContent.includes('1720')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.labelsVisible === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}