  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.roundNumber === 1",
        "window.__3D_STATE__.isThrown === false"
      ]
    },
    {
      "id": "S1",
      "name": "AimMoved",
      "conditions": [
        "window.__3D_STATE__.aimX !== 0 || window.__3D_STATE__.aimY !== 1.7",
        "window.__3D_STATE__.isThrown === false"
      ]
    },
    {
      "id": "S2",
      "name": "DartInFlight",
      "conditions": [
        "window.__3D_STATE__.isThrown === true",
        "window.__3D_STATE__.dartOnBoard === false"
      ]
    },
    {
      "id": "S3",
      "name": "DartLanded",
      "conditions": [
        "window.__3D_STATE__.dartOnBoard === true",
        "window.__3D_STATE__.dartsThrown >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "RoundComplete",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 3"
      ]
    },
    {
      "id": "S5",
      "name": "NewRoundStarted",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.roundNumber >= 2"
      ]
    },
    {
      "id": "S6",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.roundNumber === 1"
      ]
    }
  ],
