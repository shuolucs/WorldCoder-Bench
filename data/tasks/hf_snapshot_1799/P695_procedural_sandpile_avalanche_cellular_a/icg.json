    {
      "id": "A10",
      "name": "GrainsPerClickDisplay",
      "type": "dom_element",
      "semantic": "Text showing current grains per click value",
      "locator_hints": [
        "#grainsPerClick"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Grid",
      "conditions": [
        "window.__3D_STATE__.totalGrains === 0",
        "window.__3D_STATE__.grainsLost === 0",
        "window.__3D_STATE__.toppleEvents === 0",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.unstableCells === 0",
        "window.__3D_STATE__.mode === 'drop'",
        "window.__3D_STATE__.grainsPerClick === 4"
      ]
    },
    {
      "id": "S1",
      "name": "After_Center_Drop_Initiated",
      "conditions": [
        "window.__3D_STATE__.totalEverAdded === 100",
        "window.__3D_STATE__.isAvalancheRunning === true || window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === 100"
      ]
    },
    {
      "id": "S2",
      "name": "Avalanche_Completed",
      "conditions": [
        "window.__3D_STATE__.unstableCells === 0",
        "window.__3D_STATE__.isAvalancheRunning === false",
        "window.__3D_STATE__.toppleEvents > 0",
        "window.__3D_STATE__.stepCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Conservation_Verified",
      "conditions": [
        "window.__3D_STATE__.conservationCheck().balanced === true",
        "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === window.__3D_STATE__.totalEverAdded"
      ]
    },
    {
      "id": "S4",
      "name": "Paused_State",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed_State",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S6",
      "name": "Grains_Per_Click_Increased",
      "conditions": [
        "window.__3D_STATE__.grainsPerClick > 4"
      ]
    },
    {
      "id": "S7",
      "name": "After_Programmatic_Add",
      "conditions": [
        "window.__3D_STATE__.totalEverAdded > 100"
      ]
    },
    {
      "id": "S8",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.totalGrains === 0",
        "window.__3D_STATE__.grainsLost === 0",
        "window.__3D_STATE__.toppleEvents === 0",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "After_Second_Avalanche_Conservation",
      "conditions": [
        "window.__3D_STATE__.conservationCheck().balanced === true",
        "window.__3D_STATE__.unstableCells === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnCenterDrop"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.grid === 'object' && window.__3D_STATE__.grid.length === 64",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalGrains === 'number' && !isNaN(window.__3D_STATE__.totalGrains)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalEverAdded === 100",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isAvalancheRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === window.__3D_STATE__.totalEverAdded",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.unstableCells === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAvalancheRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toppleEvents > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxHeightOnGrid <= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains >= 0 && window.__3D_STATE__.grainsLost >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* verify conservation law at equilibrium */ true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conservationCheck().balanced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck().totalGrains === window.__3D_STATE__.totalGrains",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck().grainsLost === window.__3D_STATE__.grainsLost",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck().totalEverAdded === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === window.__3D_STATE__.totalEverAdded",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridSize === 64",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains === window.__3D_STATE__.conservationCheck().totalGrains",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stepCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "="
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.grainsPerClick === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.grainsPerClick === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.grainsPerClick >= 1 && window.__3D_STATE__.grainsPerClick <= 50",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('grainsPerClick') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('grainsPerClick').textContent.includes('5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevTotal = window.__3D_STATE__.totalEverAdded; window.__3D_STATE__.addGrains(32, 32, 50); window.__3D_STATE__._prevTotalBeforeAdd = prevTotal;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalEverAdded === window.__3D_STATE__._prevTotalBeforeAdd + 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEverAdded > 100",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.getCell === 'function'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.addGrains === 'function'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost <= window.__3D_STATE__.totalEverAdded",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnReset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalGrains === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainsLost === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toppleEvents === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.unstableCells === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.getCell(32, 32) === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.addGrains(32, 32, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalEverAdded === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGrains + window.__3D_STATE__.grainsLost === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck().balanced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxHeightOnGrid >= 0 && !isNaN(window.__3D_STATE__.maxHeightOnGrid)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.grid[0]) && window.__3D_STATE__.grid[0].length === 64",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalGrains === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainsLost === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEverAdded === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck().balanced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'drop'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}