{
  "task_id": "P695_procedural_sandpile_avalanche_cellular_a",
  "affordances": [
    {
      "id": "A1",
      "name": "SandHeightmap",
      "type": "3d_object",
      "semantic": "The 64x64 plane geometry whose vertex heights and colors represent grain counts",
      "locator_hints": [
        "PlaneGeometry mesh with vertexColors",
        "child of scene with 63x63 segments"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Flat dark gray ground plane beneath the sandpile",
      "locator_hints": [
        "PlaneGeometry at Y=-0.5",
        "dark gray material"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay panel showing simulation stats",
      "locator_hints": [
