            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightIntensitySum - 3.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materials[0].roughness === 1.0 && window.__3D_STATE__.materials[0].metalness === 0.0",
