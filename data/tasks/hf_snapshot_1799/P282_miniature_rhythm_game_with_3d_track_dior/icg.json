  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.gameState === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.noteSpeed === 5",
        "window.__3D_STATE__.totalNotes === 20"
      ]
    },
    {
      "id": "S1",
      "name": "Helmet_Loaded",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "Game_Playing",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S3",
      "name": "Speed_Increased",
      "conditions": [
        "window.__3D_STATE__.noteSpeed === 6"
      ]
    },
    {
      "id": "S4",
      "name": "Speed_Decreased_Back",
      "conditions": [
        "window.__3D_STATE__.noteSpeed === 5"
      ]
    },
    {
      "id": "S5",
      "name": "Game_Paused",
      "conditions": [
        "window.__3D_STATE__.gameState === 'paused'",
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Resumed",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S7",
      "name": "Notes_Being_Hit",
      "conditions": [
        "window.__3D_STATE__.notesHit > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Combo_Active",
      "conditions": [
        "window.__3D_STATE__.combo >= 2",
        "window.__3D_STATE__.lastJudgment !== 'Miss'"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Finished",
      "conditions": [
        "window.__3D_STATE__.gameState === 'finished'",
        "window.__3D_STATE__.notesProcessed === 20",
        "window.__3D_STATE__.grade !== 'none'"
      ]
    },
    {
      "id": "S10",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.gameState === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.notesHit === 0",
        "window.__3D_STATE__.notesMissed === 0"
      ]
    }
  ],
