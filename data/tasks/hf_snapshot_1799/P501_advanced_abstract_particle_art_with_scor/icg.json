{
  "task_id": "P501_advanced_abstract_particle_art_with_scor",
  "affordances": [
    {
      "id": "A1",
      "name": "BaseParticles",
      "type": "3d_object",
      "semantic": "500 orbiting particles forming the base art",
      "locator_hints": [
        "THREE.Points with 500 vertices"
      ]
    },
    {
      "id": "A2",
      "name": "BurstParticles",
      "type": "3d_object",
      "semantic": "Temporary particles spawned on click",
      "locator_hints": [
        "Dynamically created Points or sprite groups"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score and status overlay",
      "locator_hints": [
        "div containing hud-score, hud-combo, etc."
      ]
    },
    {
      "id": "A4",
      "name": "GravityWell",
      "type": "3d_object",
      "semantic": "Invisible attractor at mouse position on z=0 plane",
      "locator_hints": [
        "Raycasted position updated on mousemove"
      ]
    },
    {
      "id": "A5",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas",
      "locator_hints": [
        "canvas element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 1",
        "window.__3D_STATE__.totalBursts === 0",
        "window.__3D_STATE__.baseParticleCount === 500",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.colorMode === 'rainbow'",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstClick",
      "conditions": [
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.totalBursts === 1",
        "window.__3D_STATE__.burstParticleCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "ComboActive",
      "conditions": [
        "window.__3D_STATE__.combo >= 2",
        "window.__3D_STATE__.totalBursts >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "ColorModeMonochrome",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'monochrome'"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 1",
        "window.__3D_STATE__.totalBursts === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": [
          400,
          300
        ],
        "description": "Click on canvas center to trigger first burst"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": [
          350,
          250
        ],
        "description": "Click again quickly to build combo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-combo').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g",
        "description": "Press G to toggle gravity well off"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c",
        "description": "Press C to cycle color mode to monochrome"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-colormode').textContent.toLowerCase().includes('monochrome')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "description": "Press Space to pause animation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "description": "Press Space again to unpause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset the entire scene"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-score').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "position": [
          500,
          400
        ],
        "description": "Click after reset to verify scoring works again"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}