{
  "task_id": "P247_parkour_runner_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "StorkPlayer",
      "type": "3d_object",
      "semantic": "The stork.glb model serving as the parkour runner character",
      "locator_hints": [
        "window.__3D_STATE__.modelLoaded === true",
        "player mesh in scene"
      ]
    },
    {
      "id": "A2",
      "name": "Platforms",
      "type": "3d_object",
      "semantic": "Floating platforms the player can land on",
      "locator_hints": [
        "window.__3D_STATE__.platformCount >= 15"
      ]
    },
    {
      "id": "A3",
      "name": "Coins",
      "type": "3d_object",
      "semantic": "Yellow collectible spheres scattered across the course",
      "locator_hints": [
        "window.__3D_STATE__.coinsTotal >= 10"
      ]
    },
    {
      "id": "A4",
      "name": "Obstacles",
      "type": "3d_object",
      "semantic": "Red obstacle boxes that damage the player",
      "locator_hints": [
        "window.__3D_STATE__.obstaclesTotal >= 8"
      ]
    },
    {
      "id": "A5",
      "name": "ScoreHUD",
      "type": "dom_element",
