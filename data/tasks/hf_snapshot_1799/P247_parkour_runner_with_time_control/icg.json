  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.gameStarted === false || window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Running_Normal",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.timeMode === 'NORMAL'",
        "window.__3D_STATE__.lives > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Player_Jumping",
      "conditions": [
        "window.__3D_STATE__.isGrounded === false",
        "window.__3D_STATE__.velocityY > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Slow_Motion_Active",
      "conditions": [
        "window.__3D_STATE__.timeMode === 'SLOW_MO'",
        "window.__3D_STATE__.timeScale === 0.25"
      ]
    },
    {
      "id": "S4",
      "name": "Rewind_Active",
      "conditions": [
        "window.__3D_STATE__.timeMode === 'REWIND'"
      ]
    },
    {
      "id": "S5",
      "name": "Freeze_Active",
      "conditions": [
        "window.__3D_STATE__.timeMode === 'FREEZE'",
        "window.__3D_STATE__.freezeActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "Player_Hit_Invincible",
      "conditions": [
        "window.__3D_STATE__.isInvincible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Coin_Collected",
      "conditions": [
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Energy_Depleted",
      "conditions": [
        "window.__3D_STATE__.timeEnergy <= 0",
        "window.__3D_STATE__.timeMode === 'NORMAL'"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.lives === 0"
      ]
    }
  ],
