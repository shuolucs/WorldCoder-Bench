{
  "task_id": "P2226_procedural_wood_grain_lathe_shader",
  "affordances": [
    {
      "id": "A1",
      "name": "WoodGrainModel",
      "type": "3d_object",
      "semantic": "The loaded BrainStem GLB model with procedural wood grain shader applied",
      "locator_hints": [
        "scene.children with ShaderMaterial",
        "model centered at origin"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing all lathe parameters",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A3",
      "name": "LatheStatusDisplay",
      "type": "dom_element",
      "semantic": "Shows ON/OFF lathe status",
      "locator_hints": [
        "#hud-lathe-status"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets all parameters to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "OakPresetButton",
      "type": "dom_element",
      "semantic": "Applies oak wood preset",
      "locator_hints": [
        "#btn-preset-oak"
      ]
    },
    {
      "id": "A6",
      "name": "PinePresetButton",
      "type": "dom_element",
      "semantic": "Applies pine wood preset",
      "locator_hints": [
        "#btn-preset-pine"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedDisplay",
      "type": "dom_element",
      "semantic": "Shows current rotation speed",
      "locator_hints": [
        "#hud-speed"
      ]
    },
    {
      "id": "A8",
      "name": "GrainFreqDisplay",
      "type": "dom_element",
      "semantic": "Shows current grain frequency",
      "locator_hints": [
        "#hud-grain-freq"
      ]
    },
    {
      "id": "A9",
      "name": "CuttingDepthDisplay",
      "type": "dom_element",
      "semantic": "Shows current cutting depth",
      "locator_hints": [
        "#hud-cutting-depth"
      ]
    },
    {
      "id": "A10",
      "name": "TurbulenceScaleDisplay",
      "type": "dom_element",
      "semantic": "Shows current turbulence scale",
      "locator_hints": [
        "#hud-turbulence-scale"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedLatheOff",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.latheRunning === false",
        "window.__3D_STATE__.rotationSpeed === 0"
      ]
    },
    {
      "id": "S1",
      "name": "LatheRunning",
      "conditions": [
        "window.__3D_STATE__.latheRunning === true",
        "window.__3D_STATE__.rotationSpeed > 0"
      ]
    },
    {
      "id": "S2",
      "name": "GrainFrequencyIncreased",
      "conditions": [
        "window.__3D_STATE__.grainFrequency > 12"
      ]
    },
    {
      "id": "S3",
      "name": "CuttingDepthAdvanced",
      "conditions": [
        "window.__3D_STATE__.cuttingDepth > 0"
      ]
    },
    {
      "id": "S4",
      "name": "TurbulenceScaleCycled",
      "conditions": [
        "window.__3D_STATE__.turbulenceScale !== 3.0"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedCycled",
      "conditions": [
        "window.__3D_STATE__.targetSpeed !== 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "OakPresetActive",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'oak'"
      ]
    },
    {
      "id": "S7",
      "name": "PinePresetActive",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'pine'"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'default'",
        "window.__3D_STATE__.grainFrequency === 12",
        "window.__3D_STATE__.cuttingDepth === 0"
      ]
    },
    {
      "id": "S9",
      "name": "LatheStopped",
      "conditions": [
        "window.__3D_STATE__.latheRunning === false",
        "window.__3D_STATE__.rotationSpeed === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderCompiled === 'boolean' && window.__3D_STATE__.shaderCompiled === true",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationAngle === 0 || window.__3D_STATE__.rotationAngle < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.latheRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed === window.__3D_STATE__.targetSpeed",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed === 2.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number' && !isNaN(window.__3D_STATE__.rotationAngle)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-lathe-status').textContent.includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.grainFrequency === 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency >= 1 && window.__3D_STATE__.grainFrequency <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.latheRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationAngle > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-grain-freq').textContent.includes('13')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.cuttingDepth - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cuttingDepth >= 0 && window.__3D_STATE__.cuttingDepth <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceAmount <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cuttingDepth === 'number' && !isNaN(window.__3D_STATE__.cuttingDepth)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-cutting-depth').textContent.includes('0.1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.turbulenceScale === 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceScaleIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "[1.0, 3.0, 5.0, 8.0].includes(window.__3D_STATE__.turbulenceScale)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.turbulenceScale === 'number' && !isNaN(window.__3D_STATE__.turbulenceScale)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-turbulence-scale').textContent.includes('5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.targetSpeed === 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed === 3.5",
            "tier": "L2"
          },
          {
            "expr": "[1.0, 2.0, 3.5, 5.0].includes(window.__3D_STATE__.targetSpeed)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-speed').textContent.includes('3.5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-preset-oak"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'oak'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 18",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[0] - 0.55) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.turbulenceAmount - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceScale === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-preset-pine"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'pine'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[0] - 0.75) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ringColor[1] - 0.4) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.turbulenceAmount - 0.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceScale === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'default'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cuttingDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.latheRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceScale === 3.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[0] - 0.6) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let before = window.__3D_STATE__.rotationAngle; setTimeout(() => { window.__testDelta = window.__3D_STATE__.rotationAngle - before; }, 500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.latheRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number' && !isNaN(window.__3D_STATE__.rotationAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.targetSpeed === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedIndex === 0 || window.__3D_STATE__.speedIndex === 1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}