        "window.__3D_STATE__.gameState === 'idle'"
      ]
    },
    {
      "id": "S2",
      "name": "Casting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'casting'",
        "window.__3D_STATE__.castCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "Waiting_Hook_Submerged",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.hookSubmerged === true",
        "window.__3D_STATE__.hookPosition.y < 0"
      ]
    },
    {
      "id": "S4",
      "name": "Rod_Rotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.rodAngle) > 0.1"
      ]
    },
    {
      "id": "S5",
      "name": "Debug_Enabled",
      "conditions": [
        "window.__3D_STATE__.debugOverlay === true"
      ]
    },
    {
      "id": "S6",
      "name": "Fish_Attracted",
      "conditions": [
        "window.__3D_STATE__.attractedFishCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Fish_On_Hook",
      "conditions": [
        "window.__3D_STATE__.gameState === 'fish_on'"
      ]
    },
    {
      "id": "S8",
      "name": "Reeling_With_Fish",
      "conditions": [
        "window.__3D_STATE__.gameState === 'reeling'"
      ]
    },
    {
      "id": "S9",
      "name": "Fish_Caught_Score_Up",
      "conditions": [
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.fishCount <= 4"
      ]
    },
    {
      "id": "S10",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.fishCount === 5",
        "window.__3D_STATE__.gameState === 'idle'"
      ]
    }
