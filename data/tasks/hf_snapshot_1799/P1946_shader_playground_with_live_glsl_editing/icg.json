    {
      "id": "A12",
      "name": "PausePhysicsButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume debug sphere physics",
      "locator_hints": [
        "#btn-pause-physics"
      ]
    },
    {
      "id": "A13",
      "name": "CompileErrorDiv",
      "type": "dom_element",
      "semantic": "Div displaying shader compilation errors",
      "locator_hints": [
        "#compile-error"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.compileCount === 1",
        "window.__3D_STATE__.editorVisible === true",
        "window.__3D_STATE__.debugOverlayVisible === true",
        "window.__3D_STATE__.physicsPaused === false",
        "window.__3D_STATE__.amplitude === 0.15",
        "window.__3D_STATE__.fresnelPower === 3.0",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AmplitudeChanged",
      "conditions": [
        "window.__3D_STATE__.amplitude === 0.5"
      ]
    },
    {
      "id": "S2",
      "name": "ShaderCompileError",
      "conditions": [
        "window.__3D_STATE__.lastCompileSuccess === false",
        "window.__3D_STATE__.shaderError !== null"
      ]
    },
    {
      "id": "S3",
      "name": "ShaderRecompiled",
      "conditions": [
        "window.__3D_STATE__.compileCount >= 2",
        "window.__3D_STATE__.lastCompileSuccess === true"
      ]
    },
    {
      "id": "S4",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.arrowHelpersCount === 0"
      ]
    },
    {
      "id": "S5",
      "name": "PhysicsPaused",
      "conditions": [
        "window.__3D_STATE__.physicsPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "EditorHidden",
      "conditions": [
        "window.__3D_STATE__.editorVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S9",
      "name": "AmplitudePresetCycled",
      "conditions": [
        "window.__3D_STATE__.amplitudePresetIndex >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "ShadersReset",
      "conditions": [
        "window.__3D_STATE__.amplitude === 0.15",
        "window.__3D_STATE__.lastCompileSuccess === true"
      ]
    },
    {
      "id": "S11",
      "name": "FullStateRestored",
      "conditions": [
        "window.__3D_STATE__.editorVisible === true",
        "window.__3D_STATE__.debugOverlayVisible === true",
        "window.__3D_STATE__.physicsPaused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres !== undefined && Array.isArray(window.__3D_STATE__.debugSpheres) && window.__3D_STATE__.debugSpheres.length === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshVertexCount > 0 && !isNaN(window.__3D_STATE__.meshVertexCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time > 0.5 && !isNaN(window.__3D_STATE__.time)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z) && Math.abs(Math.sqrt(s.x*s.x + s.z*s.z) - s.orbitRadius) < 0.05)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-amplitude').value = 0.5; document.getElementById('slider-amplitude').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.amplitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.amplitude !== 0.15",
            "tier": "L2"
          },
          {
            "expr": "parseFloat(document.getElementById('slider-amplitude').value) === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compileCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('fragment-editor').value = 'void main() { INVALID_SYNTAX'; document.getElementById('btn-compile').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastCompileSuccess === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderError !== null && window.__3D_STATE__.shaderError.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compileErrorCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('compile-error').textContent.length > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 0.5) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastCompileSuccess === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderError === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compileCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexShaderLength > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fragmentShaderLength > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheresVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowHelpersCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.length === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.every(s => !isNaN(s.angle))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '2', bubbles: true})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.physicsPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowHelpersCount === 8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.debugSpheres[0].speed === 'number' && window.__3D_STATE__.debugSpheres[0].speed > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.every(s => s.orbitRadius >= 1.5 && s.orbitRadius <= 2.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "var angles = window.__3D_STATE__.debugSpheres.map(s => s.angle); window.__test_frozen_angles = angles; document.dispatchEvent(new KeyboardEvent('keydown', {key: '1', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.editorVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('editor-panel').style.display === 'none' || document.getElementById('editor-panel').offsetWidth === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.every((s, i) => Math.abs(s.angle - window.__test_frozen_angles[i]) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '1', bubbles: true})); document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'z', ctrlKey: true, bubbles: true})); }, 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.editorVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompileSuccess === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'y', ctrlKey: true, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompileSuccess === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexShaderLength > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fragmentShaderLength > 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'u', bubbles: true})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'u', bubbles: true})); }, 150);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.amplitudePresetIndex >= 2",
            "tier": "L2"
          },
          {
            "expr": "[0.0, 0.15, 0.5, 1.0].includes(window.__3D_STATE__.amplitude)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.amplitudePresetIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.amplitude === [0.0, 0.15, 0.5, 1.0][window.__3D_STATE__.amplitudePresetIndex]",
            "tier": "L2"
          },
          {
            "expr": "parseFloat(document.getElementById('slider-amplitude').value) === window.__3D_STATE__.amplitude",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastCompileSuccess === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderError === null",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 0.15) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexShaderLength > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fragmentShaderLength > 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor.r - 0.2) < 0.05 && Math.abs(window.__3D_STATE__.baseColor.g - 0.6) < 0.05 && Math.abs(window.__3D_STATE__.baseColor.b - 1.0) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-fresnel').value = 6.5; document.getElementById('slider-fresnel').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('input-basecolor').value = '#ff3300'; document.getElementById('input-basecolor').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.fresnelPower - 6.5) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baseColor.r > 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baseColor.g < 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baseColor.b < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorVisible === true && window.__3D_STATE__.debugOverlayVisible === true && window.__3D_STATE__.physicsPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugSpheres.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z) && Math.abs(Math.sqrt(s.x*s.x + s.z*s.z) - s.orbitRadius) < 0.05)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}