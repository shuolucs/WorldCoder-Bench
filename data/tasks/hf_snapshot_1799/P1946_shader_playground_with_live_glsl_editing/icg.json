{
  "task_id": "P1946_shader_playground_with_live_glsl_editing",
  "affordances": [
    {
      "id": "A1",
      "name": "Icosahedron",
      "type": "3d_object",
      "semantic": "Central icosahedron mesh with custom ShaderMaterial",
      "locator_hints": [
        "IcosahedronGeometry",
        "ShaderMaterial mesh at origin"
      ]
    },
    {
      "id": "A2",
      "name": "DebugSpheres",
      "type": "3d_object",
      "semantic": "8 wireframe spheres orbiting the icosahedron",
      "locator_hints": [
        "wireframe spheres",
        "debug overlay objects"
      ]
    },
    {
      "id": "A3",
      "name": "ArrowHelpers",
      "type": "3d_object",
      "semantic": "Velocity vector arrows attached to debug spheres",
      "locator_hints": [
        "ArrowHelper instances"
      ]
    },
    {
      "id": "A4",
      "name": "VertexEditor",
      "type": "dom_element",
      "semantic": "Textarea for vertex shader GLSL source",
