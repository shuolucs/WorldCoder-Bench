{
  "task_id": "P161_projectile_motion_with_drag",
  "affordances": [
    {
      "id": "A1",
      "name": "Projectile",
      "type": "3d_object",
      "semantic": "Red sphere that is launched as the projectile",
      "locator_hints": [
        "red sphere",
        "radius 0.5",
        "main projectile"
      ]
    },
    {
      "id": "A2",
      "name": "GhostProjectile",
      "type": "3d_object",
      "semantic": "Green transparent sphere showing ideal no-drag trajectory",
      "locator_hints": [
        "green sphere",
        "opacity 0.3",
        "ghost"
      ]
    },
    {
      "id": "A3",
      "name": "TargetRing",
      "type": "3d_object",
      "semantic": "Blue wireframe torus target",
      "locator_hints": [
        "blue torus",
        "wireframe",
        "position (20,5,0)"
      ]
    },
    {
      "id": "A4",
      "name": "LaunchButton",
      "type": "dom_element",
      "semantic": "Button to launch the projectile",
      "locator_hints": [
        "#btn-launch"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleDragButton",
      "type": "dom_element",
      "semantic": "Button to toggle air drag on/off",
      "locator_hints": [
        "#btn-toggle-drag"
      ]
    },
    {
      "id": "A7",
      "name": "AngleSlider",
      "type": "dom_element",
      "semantic": "Slider to set launch angle",
      "locator_hints": [
        "#slider-angle"
      ]
    },
    {
      "id": "A8",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider to set launch speed",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display with velocity, height, time, distance, drag status",
      "locator_hints": [
        "#hud-velocity",
        "#hud-height",
        "#hud-time",
        "#hud-distance",
        "#hud-drag-status"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.launched === false",
        "window.__3D_STATE__.landed === false",
        "window.__3D_STATE__.dragEnabled === true",
        "window.__3D_STATE__.launchAngle === 45",
        "window.__3D_STATE__.launchSpeed === 25"
      ]
    },
    {
      "id": "S1",
      "name": "InFlight_DragOn",
      "conditions": [
        "window.__3D_STATE__.launched === true",
        "window.__3D_STATE__.landed === false",
        "window.__3D_STATE__.dragEnabled === true",
        "window.__3D_STATE__.time > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Landed_DragOn",
      "conditions": [
        "window.__3D_STATE__.launched === true",
        "window.__3D_STATE__.landed === true",
        "window.__3D_STATE__.dragEnabled === true",
        "window.__3D_STATE__.landingX !== null"
      ]
    },
    {
      "id": "S3",
      "name": "Reset_After_Landing",
      "conditions": [
        "window.__3D_STATE__.launched === false",
        "window.__3D_STATE__.landed === false",
        "window.__3D_STATE__.time === 0",
        "window.__3D_STATE__.landingX === null"
      ]
    },
    {
      "id": "S4",
      "name": "DragOff_Ready",
      "conditions": [
        "window.__3D_STATE__.launched === false",
        "window.__3D_STATE__.dragEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "InFlight_DragOff",
      "conditions": [
        "window.__3D_STATE__.launched === true",
        "window.__3D_STATE__.landed === false",
        "window.__3D_STATE__.dragEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "Landed_DragOff",
      "conditions": [
        "window.__3D_STATE__.launched === true",
        "window.__3D_STATE__.landed === true",
        "window.__3D_STATE__.dragEnabled === false",
        "window.__3D_STATE__.landingX !== null"
      ]
    },
    {
      "id": "S7",
      "name": "AngleChanged",
      "conditions": [
        "window.__3D_STATE__.launched === false",
        "window.__3D_STATE__.launchAngle === 30"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-launch"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.launched === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landed === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.projectileY > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialKE > 0 && Math.abs(window.__3D_STATE__.initialKE - 0.5 * 1.0 * 25 * 25) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.landed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landingX !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.landingX < window.__3D_STATE__.ghostLandingX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.projectileY <= 0.6",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.landingX) && !isNaN(window.__3D_STATE__.ghostLandingX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.launched === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landed === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landingX === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trailCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btn-toggle-drag"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dragEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-drag-status').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.launched === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-launch"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.launched === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dragEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.projectileY > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocity > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentKE) && !isNaN(window.__3D_STATE__.currentPE)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.landed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landingX !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.landingX - window.__3D_STATE__.ghostLandingX) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.projectileY <= 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time > 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-reset').click(); setTimeout(() => { document.getElementById('btn-toggle-drag').click(); const slider = document.getElementById('slider-angle'); const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '30'); slider.dispatchEvent(new Event('input', { bubbles: true })); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.launched === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.launchAngle === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dragEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('label-angle').textContent.includes('30')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-launch"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.launched === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.launchAngle === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dragEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.projectileY > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trailCount >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}