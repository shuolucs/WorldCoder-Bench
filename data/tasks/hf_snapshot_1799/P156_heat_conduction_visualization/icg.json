  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.temperatures.length === 20",
        "window.__3D_STATE__.temperatures.every(t => t === 20)",
        "window.__3D_STATE__.heatSourceTemp === 20",
        "window.__3D_STATE__.coldSinkTemp === 20"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stepCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "HeatSourceSet",
      "conditions": [
        "window.__3D_STATE__.heatSourceTemp === 100",
        "window.__3D_STATE__.temperatures[0] === 100"
      ]
    },
    {
      "id": "S4",
      "name": "AfterHeatPropagation",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 10",
        "window.__3D_STATE__.temperatures[1] > 20"
      ]
    },
    {
      "id": "S5",
      "name": "ColdSinkSet",
      "conditions": [
        "window.__3D_STATE__.coldSinkTemp === 0",
        "window.__3D_STATE__.temperatures[19] === 0"
      ]
    },
    {
      "id": "S6",
      "name": "HeatImpulseApplied",
      "conditions": [
        "window.__3D_STATE__.temperatures[10] === 100"
      ]
    },
    {
      "id": "S7",
      "name": "AfterImpulseDiffusion",
      "conditions": [
        "window.__3D_STATE__.temperatures[9] > 20",
        "window.__3D_STATE__.temperatures[11] > 20"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.temperatures.every(t => t === 20)"
      ]
    },
    {
      "id": "S9",
      "name": "SteadyStateApproach",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 50"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatures.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures.every(t => typeof t === 'number' && !isNaN(t))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avgTemp - 20) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('heatSourceSlider').value = 100; document.getElementById('heatSourceSlider').dispatchEvent(new Event('input'));"
