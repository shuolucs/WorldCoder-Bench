  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Scene",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.historySize === 0",
        "window.__3D_STATE__.redoSize === 0",
        "window.__3D_STATE__.selectedCabinetId === -1"
      ]
    },
    {
      "id": "S1",
      "name": "One_Base_Cabinet_Added",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 1",
        "window.__3D_STATE__.historySize === 1",
        "window.__3D_STATE__.lastAction === 'add_base'"
      ]
    },
    {
      "id": "S2",
      "name": "Two_Cabinets_Added",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 2",
        "window.__3D_STATE__.historySize === 2"
      ]
    },
    {
      "id": "S3",
      "name": "Cabinet_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedCabinetId !== -1",
        "window.__3D_STATE__.selectedCabinetType !== 'none'"
      ]
    },
    {
      "id": "S4",
      "name": "Cabinet_Moved",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'move'",
        "window.__3D_STATE__.historySize >= 3"
      ]
    },
    {
      "id": "S5",
      "name": "After_Undo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "After_Redo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'",
        "window.__3D_STATE__.redoSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Cabinet_Deleted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'delete'"
      ]
    },
    {
      "id": "S8",
      "name": "Delete_Undone",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    }
  ],
