{
  "task_id": "P555_citation_network",
  "affordances": [
    {"id": "A1", "name": "Nodes", "type": "3d_object", "semantic": "40 paper spheres sized by citations", "locator_hints": ["sphere meshes"]},
    {"id": "A2", "name": "Edges", "type": "3d_object", "semantic": "60 citation line connections", "locator_hints": ["line segments"]},
    {"id": "A3", "name": "Labels", "type": "dom_element", "semantic": "CSS2D hover labels", "locator_hints": ["CSS2DObject divs"]},
    {"id": "A4", "name": "SpringSlider", "type": "dom_element", "semantic": "Spring stiffness control", "locator_hints": ["#slider-spring"]},
    {"id": "A5", "name": "RepulsionSlider", "type": "dom_element", "semantic": "Repulsion strength control", "locator_hints": ["#slider-repulsion"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.nodeCount === 40", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Simulating", "conditions": ["window.__3D_STATE__.avgVelocity > 0"]},
    {"id": "S2", "name": "Converging", "conditions": ["window.__3D_STATE__.avgVelocity < before.avgVelocity || window.__3D_STATE__.avgVelocity < 0.5"]},
    {"id": "S3", "name": "SpringChanged", "conditions": ["window.__3D_STATE__.springK !== 0.5"]},
    {"id": "S4", "name": "Filtered", "conditions": ["window.__3D_STATE__.fieldFilter !== 'All'"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.nodeCount === 40", "tier": "L2"},
        {"expr": "window.__3D_STATE__.edgeCount === 60", "tier": "L2"},
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgVelocity < 1 || window.__3D_STATE__.totalKE < before.totalKE", "tier": "L1"},
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-spring').value = 1.5; document.getElementById('slider-spring').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.springK >= 1.2", "tier": "L2"},
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.fieldFilter !== 'All'", "tier": "L2"},
        {"expr": "document.getElementById('hud-filter') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S4", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.avgVelocity > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"}
      ]}
    }
  ]
}
