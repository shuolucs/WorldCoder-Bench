  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.activeNotes === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Playing",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'playing'",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Notes_Spawning",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'playing'",
        "window.__3D_STATE__.notesSpawned > 0",
        "window.__3D_STATE__.activeNotes > 0"
      ]
    },
    {
      "id": "S3",
      "name": "After_Hit",
      "conditions": [
        "window.__3D_STATE__.totalHits > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Combo_Built",
      "conditions": [
        "window.__3D_STATE__.combo >= 2",
        "window.__3D_STATE__.totalHits >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "Game_Paused",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'paused'",
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Resumed",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'playing'",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S7",
      "name": "State_Saved",
      "conditions": [
        "window.__3D_STATE__.hasSaveData === true"
      ]
    },
    {
      "id": "S8",
      "name": "State_Reset",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0"
      ]
    },
    {
      "id": "S9",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.hasSaveData === true",
        "window.__3D_STATE__.score > 0"
      ]
    }
  ],
