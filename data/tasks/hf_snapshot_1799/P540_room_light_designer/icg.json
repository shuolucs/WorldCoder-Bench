{
  "task_id": "P540_room_light_designer",
  "affordances": [
    {"id": "A1", "name": "Room", "type": "3d_object", "semantic": "Room box with floor, walls, ceiling", "locator_hints": ["floor mesh", "wall meshes"]},
    {"id": "A2", "name": "FurnitureModels", "type": "3d_object", "semantic": "Loaded GLB furniture models", "locator_hints": ["GLTF scene children"]},
    {"id": "A3", "name": "PointLights", "type": "3d_object", "semantic": "User-placed point lights with helpers", "locator_hints": ["PointLight", "PointLightHelper"]},
    {"id": "A4", "name": "AddLightBtn", "type": "dom_element", "semantic": "Button to add light", "locator_hints": ["#btn-add-light"]},
    {"id": "A5", "name": "IntensitySlider", "type": "dom_element", "semantic": "Light intensity slider", "locator_hints": ["#slider-intensity"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.lightCount === 1", "window.__3D_STATE__.shadowsEnabled === true"]},
    {"id": "S1", "name": "ModelsLoaded", "conditions": ["window.__3D_STATE__.modelsLoaded === 3"]},
    {"id": "S2", "name": "LightAdded", "conditions": ["window.__3D_STATE__.lightCount > 1"]},
    {"id": "S3", "name": "IntensityChanged", "conditions": ["window.__3D_STATE__.selectedIntensity !== 2.0"]},
    {"id": "S4", "name": "ShadowsToggled", "conditions": ["window.__3D_STATE__.shadowsEnabled === false"]},
    {"id": "S5", "name": "MaxLights", "conditions": ["window.__3D_STATE__.lightCount === 5"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded >= 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lightCount >= 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lightsValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('btn-add-light').click(); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lightCount === 2", "tier": "L2"},
        {"expr": "window.__3D_STATE__.lightsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-intensity').value = 4.0; document.getElementById('slider-intensity').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.selectedIntensity >= 3.5", "tier": "L2"},
        {"expr": "document.getElementById('hud-intensity') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.shadowsEnabled === false", "tier": "L1"},
        {"expr": "document.getElementById('hud-shadows').textContent.includes('OFF')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S4", "to": "S5", "severity": "P0",
      "action": {"type": "script", "code": "for(let i=0; i<3; i++){ document.getElementById('btn-add-light').click(); } return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lightCount === 5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalLightIntensity > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lightsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S5", "to": "S5", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('btn-remove-light').click(); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lightCount === 4", "tier": "L2"},
        {"expr": "window.__3D_STATE__.lightsValid === true", "tier": "L0"}
      ]}
    }
  ]
}
