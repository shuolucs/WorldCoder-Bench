      ]
    },
    {
      "id": "A10",
      "name": "OpacitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling opacity of selected cloud",
      "locator_hints": [
        "#slider-opacity"
      ]
    },
    {
      "id": "A11",
      "name": "CloudParticles",
      "type": "3d_object",
      "semantic": "Individual sphere particles forming clouds",
      "locator_hints": [
        "scene children with SphereGeometry"
      ]
    },
    {
      "id": "A12",
      "name": "DensityValueDisplay",
      "type": "dom_element",
      "semantic": "Span showing current density value",
      "locator_hints": [
        "#density-value"
      ]
    },
    {
      "id": "A13",
      "name": "OpacityValueDisplay",
      "type": "dom_element",
      "semantic": "Span showing current opacity value",
      "locator_hints": [
        "#opacity-value"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 1",
        "window.__3D_STATE__.selectedCloudIndex === -1",
        "window.__3D_STATE__.lastAction === 'none'",
        "window.__3D_STATE__.totalParticles >= 15 && window.__3D_STATE__.totalParticles <= 30"
      ]
    },
    {
      "id": "S1",
      "name": "CloudAdded",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 2",
        "window.__3D_STATE__.lastAction === 'add'"
      ]
    },
    {
      "id": "S2",
      "name": "CloudSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCloudIndex >= 0",
        "window.__3D_STATE__.lastAction === 'select'",
        "window.__3D_STATE__.selectedCloudParticleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "CloudGrown",
      "conditions": [
        "window.__3D_STATE__.selectedCloudScale > 1.0",
        "window.__3D_STATE__.lastAction === 'grow'"
      ]
    },
    {
      "id": "S4",
      "name": "CloudShrunk",
      "conditions": [
        "window.__3D_STATE__.selectedCloudScale < 1.2",
        "window.__3D_STATE__.lastAction === 'shrink'"
      ]
    },
    {
      "id": "S5",
      "name": "SceneSaved",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'save'",
        "window.__3D_STATE__.hasSavedState === true",
        "window.__3D_STATE__.lastSaveTimestamp > 0"
      ]
    },
    {
      "id": "S6",
      "name": "CloudDeleted",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 1",
        "window.__3D_STATE__.lastAction === 'delete'"
      ]
    },
    {
      "id": "S7",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 2",
        "window.__3D_STATE__.lastAction === 'load'",
        "window.__3D_STATE__.lastLoadTimestamp > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-add"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudIndex === -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(0, 0.3); const cam = document.querySelector('canvas').__scene__ || window.__scene__; raycaster.setFromCamera(mouse, window.__camera__); /* fallback: simulate click at center */ document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/3, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCloudIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'select'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-grow"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'grow'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale >= 1.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudIndex >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-shrink"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'shrink'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale >= 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale < 1.25",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.selectedCloudScale)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-save"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'save'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasSavedState === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastSaveTimestamp > 0",
            "tier": "L2"
          },
          {
            "expr": "localStorage.getItem('cloudSculptorState') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-delete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'delete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-load"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'load'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastLoadTimestamp > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastLoadTimestamp >= window.__3D_STATE__.lastSaveTimestamp",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#slider-density').value = 35; document.querySelector('#slider-density').dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleDensity === 35",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#density-value').textContent.includes('35')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}