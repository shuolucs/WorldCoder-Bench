    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.flamingo_loaded === true",
        "window.__3D_STATE__.status === 'GROUNDED'",
        "window.__3D_STATE__.launchAngle === 45",
        "window.__3D_STATE__.launchSpeed === 30"
      ]
    },
    {
      "id": "S1",
      "name": "Angle_Adjusted_Up",
      "conditions": [
        "window.__3D_STATE__.launchAngle === 50",
        "window.__3D_STATE__.status === 'GROUNDED'"
      ]
    },
    {
      "id": "S2",
      "name": "Speed_Adjusted_Up",
      "conditions": [
        "window.__3D_STATE__.launchSpeed === 35",
        "window.__3D_STATE__.status === 'GROUNDED'"
      ]
    },
    {
      "id": "S3",
      "name": "Launched_With_Drag",
      "conditions": [
        "window.__3D_STATE__.status === 'FLYING'",
        "window.__3D_STATE__.dragEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "In_Flight_Ascending",
      "conditions": [
        "window.__3D_STATE__.status === 'FLYING'",
        "window.__3D_STATE__.velocity.y > 0"
      ]
    },
    {
      "id": "S5",
      "name": "In_Flight_Descending",
      "conditions": [
        "window.__3D_STATE__.status === 'FLYING'",
        "window.__3D_STATE__.velocity.y < 0"
      ]
    },
    {
      "id": "S6",
      "name": "Landed_First",
      "conditions": [
        "window.__3D_STATE__.status === 'LANDED'",
        "window.__3D_STATE__.launchCount === 1"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_After_First",
      "conditions": [
        "window.__3D_STATE__.status === 'GROUNDED'",
        "window.__3D_STATE__.launchCount === 1"
      ]
    },
    {
      "id": "S8",
      "name": "Drag_Disabled",
      "conditions": [
        "window.__3D_STATE__.dragEnabled === false",
        "window.__3D_STATE__.status === 'GROUNDED'"
      ]
    },
    {
      "id": "S9",
      "name": "Launched_No_Drag",
      "conditions": [
        "window.__3D_STATE__.status === 'FLYING'",
        "window.__3D_STATE__.dragEnabled === false"
      ]
    },
    {
      "id": "S10",
      "name": "Landed_No_Drag",
      "conditions": [
        "window.__3D_STATE__.status === 'LANDED'",
        "window.__3D_STATE__.launchCount === 2"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_Final",
