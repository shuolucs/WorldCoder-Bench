      ]
    },
    {
      "id": "A10",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing simulation stats",
      "locator_hints": [
        "div with helicase position, unzipped count, labels"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.totalBasePairs === 20",
        "window.__3D_STATE__.basePairsUnzipped === 0",
        "window.__3D_STATE__.isUnzipping === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.sceneReady === true"
      ]
    },
    {
      "id": "S2",
      "name": "UnzippingStarted",
      "conditions": [
        "window.__3D_STATE__.isUnzipping === true",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S3",
      "name": "PartiallyUnzipped",
      "conditions": [
        "window.__3D_STATE__.basePairsUnzipped >= 5",
        "window.__3D_STATE__.basePairsUnzipped <= 15",
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "Player2Active",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2"
      ]
    },
    {
      "id": "S7",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.isUnzipping === true",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.basePairsUnzipped >= 5"
      ]
    },
    {
      "id": "S8",
      "name": "FullyUnzipped",
      "conditions": [
        "window.__3D_STATE__.basePairsUnzipped === 20",
        "window.__3D_STATE__.isUnzipping === false"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.basePairsUnzipped === 0",
        "window.__3D_STATE__.isUnzipping === false",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
