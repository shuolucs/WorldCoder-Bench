  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultState",
      "conditions": [
        "window.__3D_STATE__.distortionStrength === 0",
        "window.__3D_STATE__.showGrid === true",
        "window.__3D_STATE__.gridDensity === 20",
        "window.__3D_STATE__.chromaticAberration === 0"
      ]
    },
    {
      "id": "S2",
      "name": "BarrelDistortionApplied",
      "conditions": [
        "window.__3D_STATE__.distortionStrength < 0"
      ]
    },
    {
      "id": "S3",
      "name": "PincushionDistortionApplied",
      "conditions": [
        "window.__3D_STATE__.distortionStrength > 0"
      ]
    },
    {
      "id": "S4",
      "name": "GridHidden",
      "conditions": [
        "window.__3D_STATE__.showGrid === false"
      ]
    },
    {
      "id": "S5",
      "name": "BarrelPresetActive",
      "conditions": [
        "window.__3D_STATE__.presetActive === 'barrel'",
        "Math.abs(window.__3D_STATE__.distortionStrength - (-0.5)) < 0.001"
      ]
    },
    {
      "id": "S6",
      "name": "PincushionPresetActive",
      "conditions": [
        "window.__3D_STATE__.presetActive === 'pincushion'",
        "Math.abs(window.__3D_STATE__.distortionStrength - 0.4) < 0.001"
      ]
    },
    {
      "id": "S7",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S8",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S9",
      "name": "GridColorChanged",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'setGridColor'"
      ]
    },
    {
      "id": "S10",
      "name": "ChromaticAberrationActive",
      "conditions": [
        "window.__3D_STATE__.chromaticAberration > 0"
      ]
    },
    {
      "id": "S11",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.distortionStrength === 0",
        "window.__3D_STATE__.showGrid === true",
        "window.__3D_STATE__.gridDensity === 20",
        "window.__3D_STATE__.chromaticAberration === 0",
        "window.__3D_STATE__.gridOpacity === 0.4"
      ]
    }
