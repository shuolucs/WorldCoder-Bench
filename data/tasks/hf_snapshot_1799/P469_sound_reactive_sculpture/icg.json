      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'wave'",
        "window.__3D_STATE__.rotationEnabled === true",
        "window.__3D_STATE__.sensitivity === 4.0",
        "window.__3D_STATE__.colorScheme === 'rainbow'",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.barCount === 64"
      ]
    },
    {
      "id": "S1",
      "name": "PulseMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'pulse'"
      ]
    },
    {
      "id": "S2",
      "name": "ChaosMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'chaos'"
      ]
    },
    {
      "id": "S3",
      "name": "RotationStopped",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "RotationSpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed >= 0.4"
      ]
    },
    {
      "id": "S5",
      "name": "SensitivityIncreased",
      "conditions": [
        "window.__3D_STATE__.sensitivity === 5.0"
      ]
    },
    {
      "id": "S6",
      "name": "MonochromeScheme",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'monochrome'"
      ]
    },
    {
      "id": "S7",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S8",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S9",
      "name": "SensitivityDecreased",
      "conditions": [
        "window.__3D_STATE__.sensitivity === 4.0"
      ]
    },
    {
      "id": "S10",
      "name": "WarmScheme",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'warm'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
