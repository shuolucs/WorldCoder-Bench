  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.soleColor === '#ffffff'",
        "window.__3D_STATE__.upperColor === '#ffffff'",
        "window.__3D_STATE__.isRotating === false",
        "window.__3D_STATE__.spotlightIntensity === 0.6",
        "window.__3D_STATE__.cameraZ === 10",
        "window.__3D_STATE__.sneakerScale === 1.0",
        "window.__3D_STATE__.changeCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "FlamingoLoaded",
      "conditions": [
        "window.__3D_STATE__.flamingoLoaded === true",
        "window.__3D_STATE__.flamingoAnimating === true"
      ]
    },
    {
      "id": "S2",
      "name": "SoleColorChanged",
      "conditions": [
        "window.__3D_STATE__.soleColor === '#ff0000'",
        "window.__3D_STATE__.changeCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "UpperColorChanged",
      "conditions": [
        "window.__3D_STATE__.soleColor === '#ff0000'",
        "window.__3D_STATE__.upperColor === '#ff8c00'",
        "window.__3D_STATE__.changeCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "RotationEnabled",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ]
    },
    {
      "id": "S5",
      "name": "RotationProgressed",
      "conditions": [
        "window.__3D_STATE__.isRotating === true",
        "window.__3D_STATE__.rotationAngle > 0.05"
      ]
    },
    {
      "id": "S6",
      "name": "SpotlightAdjusted",
      "conditions": [
        "window.__3D_STATE__.spotlightIntensity <= 0.35"
      ]
    },
    {
      "id": "S7",
      "name": "ZoomedIn",
      "conditions": [
        "window.__3D_STATE__.cameraZ <= 6"
      ]
    },
    {
      "id": "S8",
      "name": "SneakerScaled",
      "conditions": [
        "window.__3D_STATE__.sneakerScale >= 1.4"
      ]
    },
    {
      "id": "S9",
      "name": "SnapshotFrozen",
      "conditions": [
        "window.__3D_STATE__.isSnapshotFrozen === true"
      ]
    },
    {
      "id": "S10",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.soleColor === '#ffffff'",
        "window.__3D_STATE__.upperColor === '#ffffff'",
        "window.__3D_STATE__.isRotating === false",
        "window.__3D_STATE__.sneakerScale === 1.0",
        "window.__3D_STATE__.changeCount === 0"
      ]
    }
  ],
