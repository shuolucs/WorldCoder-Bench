{
  "task_id": "P358_multiplayer_bike_frame_builder",
  "affordances": [
    {
      "id": "A1",
      "name": "BikeFrame",
      "type": "3d_object",
      "semantic": "Group of cylindrical tubes forming bike frame",
      "locator_hints": [
        "frame tubes group",
        "CylinderGeometry meshes"
      ]
    },
    {
      "id": "A2",
      "name": "RobotAssistant",
      "type": "3d_object",
      "semantic": "Loaded robot.glb model as assembly assistant",
      "locator_hints": [
        "robot.glb model at (4,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "Player1Cursor",
      "type": "3d_object",
      "semantic": "Blue sphere cursor for Player1",
      "locator_hints": [
        "sphere at (-2,1,2)",
        "color #3366FF"
      ]
    },
    {
      "id": "A4",
      "name": "Player2Cursor",
      "type": "3d_object",
      "semantic": "Orange sphere cursor for Player2",
      "locator_hints": [
        "sphere at (2,1,-2)",
        "color #FF6633"
      ]
    },
    {
      "id": "A5",
      "name": "PlayerDisplay",
      "type": "dom_element",
      "semantic": "HUD showing active player",
      "locator_hints": [
        "#playerDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "TubeCount",
      "type": "dom_element",
      "semantic": "HUD showing tube count",
      "locator_hints": [
        "#tubeCount"
      ]
    },
    {
      "id": "A7",
      "name": "ScaleDisplay",
      "type": "dom_element",
      "semantic": "HUD showing frame scale",
      "locator_hints": [
        "#scaleDisplay"
      ]
    },
    {
      "id": "A8",
      "name": "ExportButton",
      "type": "dom_element",
      "semantic": "Button to export frame data",
      "locator_hints": [
        "#exportBtn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Frame",
      "conditions": [
        "window.__3D_STATE__.tubesPlaced === 0",
        "window.__3D_STATE__.activePlayer === 'Player1'",
        "window.__3D_STATE__.robotLoaded === true",
        "window.__3D_STATE__.frameScale === 1.0",
        "window.__3D_STATE__.exported === false"
      ]
    },
    {
      "id": "S1",
      "name": "First_Tube_Placed",
      "conditions": [
        "window.__3D_STATE__.tubesPlaced === 1",
        "window.__3D_STATE__.tubeOwners[1] === 'Player1'"
      ]
    },
    {
      "id": "S2",
      "name": "Player_Switched",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 'Player2'"
      ]
    },
    {
      "id": "S3",
      "name": "Multiple_Tubes_Placed",
      "conditions": [
        "window.__3D_STATE__.tubesPlaced >= 3"
      ]
    },
    {
      "id": "S4",
      "name": "Tube_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedTube !== null",
        "window.__3D_STATE__.selectedTube >= 1 && window.__3D_STATE__.selectedTube <= 6"
      ]
    },
    {
      "id": "S5",
      "name": "Color_Changed",
      "conditions": [
        "window.__3D_STATE__.frameColor !== '#CC0000'",
        "window.__3D_STATE__.colorCycleIndex > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Scale_Changed",
      "conditions": [
        "window.__3D_STATE__.frameScale !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "Tube_Deleted",
      "conditions": [
        "window.__3D_STATE__.tubesPlaced < 3"
      ]
    },
    {
      "id": "S8",
      "name": "Frame_Reset",
      "conditions": [
        "window.__3D_STATE__.tubesPlaced === 0",
        "window.__3D_STATE__.selectedTube === null"
      ]
    },
    {
      "id": "S9",
      "name": "Frame_Exported",
      "conditions": [
        "window.__3D_STATE__.exported === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('tubeCount').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Tab"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('playerDisplay').textContent.includes('Player2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '2'})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: '3'})), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('tubeCount').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('scaleDisplay').textContent.includes('1.2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('scaleDisplay').textContent.includes('0.8')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.__selectTubeForTest && window.__3D_STATE__.__selectTubeForTest(2); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'Delete'})), 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('tubeCount').textContent.includes('0')",
            "tier": "L2"
          },
          {
            "expr": "Object.keys(window.__3D_STATE__.tubeOwners).length === 0 || window.__3D_STATE__.tubesPlaced === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#exportBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.exported === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}