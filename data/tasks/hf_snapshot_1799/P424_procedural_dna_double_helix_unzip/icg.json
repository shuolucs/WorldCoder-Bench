        "top-left overlay div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.pairsUnzipped === 0",
        "window.__3D_STATE__.isUnzipping === false",
        "window.__3D_STATE__.totalPairs === 24"
      ]
    },
    {
      "id": "S1",
      "name": "Unzipping_Started",
      "conditions": [
        "window.__3D_STATE__.isUnzipping === true",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Partially_Unzipped",
      "conditions": [
        "window.__3D_STATE__.pairsUnzipped > 0",
        "window.__3D_STATE__.pairsUnzipped < 24",
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S5",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speed !== 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "Fully_Unzipped",
      "conditions": [
        "window.__3D_STATE__.pairsUnzipped === 24",
        "window.__3D_STATE__.unzipComplete === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.pairsUnzipped === 0",
        "window.__3D_STATE__.isUnzipping === false",
        "window.__3D_STATE__.helicaseY <= -11"
      ]
    }
  ],
  "transitions": [
