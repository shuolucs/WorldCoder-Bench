        "button",
        "Reset Game"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.pinsStanding === 10",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.throwCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.undoAvailable === false",
        "window.__3D_STATE__.redoAvailable === false"
      ]
    },
    {
      "id": "S1",
      "name": "BallAimed",
      "conditions": [
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.ballPosition.x !== 0",
        "window.__3D_STATE__.throwCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "BallLaunched",
      "conditions": [
        "window.__3D_STATE__.ballMoving === true"
      ]
    },
    {
      "id": "S3",
      "name": "ThrowComplete",
      "conditions": [
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.throwCount >= 1",
        "window.__3D_STATE__.undoAvailable === true"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoAvailable === true",
        "window.__3D_STATE__.pinsStanding === 10",
        "window.__3D_STATE__.throwCount === 0"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoAvailable === false",
        "window.__3D_STATE__.undoAvailable === true",
        "window.__3D_STATE__.throwCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "SecondThrowComplete",
      "conditions": [
        "window.__3D_STATE__.throwCount >= 2",
        "window.__3D_STATE__.ballMoving === false"
      ]
    },
    {
      "id": "S7",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.pinsStanding === 10",
        "window.__3D_STATE__.throwCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.undoAvailable === false",
        "window.__3D_STATE__.redoAvailable === false"
      ]
    }
  ],
