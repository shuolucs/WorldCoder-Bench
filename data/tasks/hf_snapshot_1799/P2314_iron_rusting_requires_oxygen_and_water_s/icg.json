      "name": "Jar1_DryAir",
      "type": "3d_object",
      "semantic": "Sealed jar containing iron nail in dry air (oxygen only, no water)",
      "locator_hints": [
        "mesh at x=-3",
        "label 'Dry Air'",
        "contains floating white particles"
      ]
    },
    {
      "id": "A2",
      "name": "Jar2_BoiledWater",
      "type": "3d_object",
      "semantic": "Sealed jar containing iron nail in boiled water (water only, no oxygen)",
