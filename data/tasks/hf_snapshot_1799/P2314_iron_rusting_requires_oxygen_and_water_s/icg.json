        "top-left",
        "text 'Day: X / 14'"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected jar details including rust status",
      "locator_hints": [
        "top-right",
        "shows jar name, O2/H2O presence, rust percentage"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.elapsedDays === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.jar3.rustProgress === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Experiment_Running",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedDays > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Experiment_Paused",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Mid_Experiment",
      "conditions": [
        "window.__3D_STATE__.elapsedDays >= 6",
        "window.__3D_STATE__.jar3.rustProgress > 0.4",
        "window.__3D_STATE__.jar3.rustSpotCount >= 3"
      ]
    },
    {
      "id": "S4",
      "name": "Experiment_Complete",
      "conditions": [
        "window.__3D_STATE__.elapsedDays >= 14",
        "window.__3D_STATE__.experimentComplete === true",
        "window.__3D_STATE__.jar3.rustProgress === 1"
      ]
    },
    {
      "id": "S5",
      "name": "Jar_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedJar !== null"
      ]
    },
    {
      "id": "S6",
      "name": "Transparency_Toggled",
      "conditions": [
        "window.__3D_STATE__.jarTransparency === 0.6"
      ]
    },
    {
      "id": "S7",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.elapsedDays === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.jar3.rustProgress === 0",
        "window.__3D_STATE__.jar3.rustSpotCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedDays === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jar1.rustProgress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jar2.rustProgress === 0",
            "tier": "L2"
          }
