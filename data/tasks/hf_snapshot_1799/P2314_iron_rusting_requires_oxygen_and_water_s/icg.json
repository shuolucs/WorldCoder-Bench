            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedDays)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedDays >= 0 && window.__3D_STATE__.elapsedDays <= 14",
            "tier": "L2"
          }
        ]
