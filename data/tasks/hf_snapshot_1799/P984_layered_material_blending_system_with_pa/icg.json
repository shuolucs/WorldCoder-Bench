        "displays active layer count, dominant index, roughness, speed"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.activeLayerCount === 1",
        "window.__3D_STATE__.dominantLayerIndex === 0",
        "window.__3D_STATE__.layers[0].opacity === 1.0",
        "window.__3D_STATE__.layers[1].opacity === 0.0",
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Layer1Activated",
      "conditions": [
        "window.__3D_STATE__.activeLayerCount === 2",
        "window.__3D_STATE__.layers[1].opacity === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "Layer2Activated",
      "conditions": [
        "window.__3D_STATE__.activeLayerCount === 3",
        "window.__3D_STATE__.layers[2].opacity === 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "RoughnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.editTargetLayerIndex >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ParticlesRestored",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "Layer0Deactivated",
      "conditions": [
        "window.__3D_STATE__.layers[0].opacity === 0.0"
      ]
    },
    {
      "id": "S7",
      "name": "Layer3Activated",
      "conditions": [
        "window.__3D_STATE__.layers[3].opacity === 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "RoughnessDecreasedFurther",
      "conditions": [
        "window.__3D_STATE__.editTargetLayerIndex >= 0"
      ]
    },
    {
      "id": "S9",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.activeLayerCount === 1",
        "window.__3D_STATE__.dominantLayerIndex === 0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layers) && window.__3D_STATE__.layers.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 1500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereRadius === 1.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].opacity === 1.0 && window.__3D_STATE__.layers[1].opacity === 0.0 && window.__3D_STATE__.layers[2].opacity === 0.0 && window.__3D_STATE__.layers[3].opacity === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 1 && window.__3D_STATE__.dominantLayerIndex === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(2)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[1].opacity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominantLayerIndex === 0 || window.__3D_STATE__.dominantLayerIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageRoughness === (window.__3D_STATE__.layers[0].roughness + window.__3D_STATE__.layers[1].roughness) / 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpeedMultiplier > 0 && window.__3D_STATE__.particleSpeedMultiplier <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(3)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[2].opacity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.averageRoughness - (window.__3D_STATE__.layers[0].roughness + window.__3D_STATE__.layers[1].roughness + window.__3D_STATE__.layers[2].roughness) / 3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.particleSpeedMultiplier - (1.0 - window.__3D_STATE__.averageRoughness * 0.7)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editTargetLayerIndex === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.editTargetLayerIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.layers[2].roughness - 0.4) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[2].roughness >= 0.0 && window.__3D_STATE__.layers[2].roughness <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpeedMultiplier > 0 && !isNaN(window.__3D_STATE__.particleSpeedMultiplier)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.particleSpeedMultiplier - (1.0 - window.__3D_STATE__.averageRoughness * 0.7)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particlesVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 1500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[2].roughness < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particlesVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleDistance >= 1.5 && window.__3D_STATE__.avgParticleDistance <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleDistance)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 1500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(1)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[0].opacity === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominantLayerIndex !== 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blendedColor) && window.__3D_STATE__.blendedColor.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blendedColor.every(c => c >= 0 && c <= 1 && !isNaN(c))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(4)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[3].opacity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editTargetLayerIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominantLayerIndex === 1 || window.__3D_STATE__.dominantLayerIndex === 2 || window.__3D_STATE__.dominantLayerIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.particleSpeedMultiplier - (1.0 - window.__3D_STATE__.averageRoughness * 0.7)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.editTargetLayerIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[3].roughness >= 0.0 && window.__3D_STATE__.layers[3].roughness <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.layers[3].roughness - 0.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageRoughness)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpeedMultiplier <= 1.0 && window.__3D_STATE__.particleSpeedMultiplier > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominantLayerIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].opacity === 1.0 && window.__3D_STATE__.layers[1].opacity === 0.0 && window.__3D_STATE__.layers[2].opacity === 0.0 && window.__3D_STATE__.layers[3].opacity === 0.0",
