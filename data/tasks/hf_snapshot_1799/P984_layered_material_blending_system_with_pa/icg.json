          },
          {
            "expr": "Math.abs(window.__3D_STATE__.layers[0].roughness - 0.8) < 0.01 && Math.abs(window.__3D_STATE__.layers[1].roughness - 0.2) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.averageRoughness - 0.8) < 0.01 && Math.abs(window.__3D_STATE__.particleSpeedMultiplier - (1.0 - 0.8 * 0.7)) < 0.01",
            "tier": "L2"
          }
        ]
