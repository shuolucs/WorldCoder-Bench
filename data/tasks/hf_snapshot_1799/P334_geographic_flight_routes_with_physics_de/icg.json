  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.globeExists === true",
        "window.__3D_STATE__.routeCount === 3",
        "window.__3D_STATE__.activeRoute === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "ParrotLoaded",
      "conditions": [
        "window.__3D_STATE__.parrotLoaded === true",
        "window.__3D_STATE__.paramT >= 0 && window.__3D_STATE__.paramT <= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Route2Active",
      "conditions": [
        "window.__3D_STATE__.activeRoute === 2",
        "window.__3D_STATE__.paramT === 0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Speed2x",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2"
      ]
    },
    {
      "id": "S6",
      "name": "Route3Active",
      "conditions": [
        "window.__3D_STATE__.activeRoute === 3",
        "window.__3D_STATE__.paramT === 0"
      ]
    },
    {
