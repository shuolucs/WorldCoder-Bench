  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.elapsedTime >= 0",
        "window.__3D_STATE__.randomizeCount === 0",
        "window.__3D_STATE__.saveCount === 0",
        "window.__3D_STATE__.loadCount === 0",
        "window.__3D_STATE__.params.breathingSpeed === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "Randomized",
      "conditions": [
        "window.__3D_STATE__.randomizeCount > 0",
        "window.__3D_STATE__.undoStack.length > 0"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.saveCount > 0",
        "window.__3D_STATE__.savedSlots.length > 0"
      ]
    },
    {
      "id": "S5",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.loadCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Undone",
      "conditions": [
        "window.__3D_STATE__.redoStack.length > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Redone",
      "conditions": [
        "window.__3D_STATE__.redoStack.length === 0"
      ]
    },
    {
      "id": "S8",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "TimeReset",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    },
    {
      "id": "S10",
      "name": "MultiSaved",
      "conditions": [
        "window.__3D_STATE__.savedSlots.length >= 2"
      ]
    }
