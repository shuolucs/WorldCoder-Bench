          },
          {
            "expr": "window.__3D_STATE__.lightPosition.y >= 0 && window.__3D_STATE__.lightPosition.y <= 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'move_light_up'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightScreenPos.x >= -2 && window.__3D_STATE__.lightScreenPos.x <= 2 && window.__3D_STATE__.lightScreenPos.y >= -2 && window.__3D_STATE__.lightScreenPos.y <= 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.lightPosition.x) && !isNaN(window.__3D_STATE__.lightPosition.y) && !isNaN(window.__3D_STATE__.lightPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedStateExists === true",
