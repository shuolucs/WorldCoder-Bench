    {
      "id": "A10",
      "name": "PresetSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select god ray presets",
      "locator_hints": [
        "#presetSelect"
      ]
    },
    {
      "id": "A11",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark ground plane at y=-1",
      "locator_hints": [
        "plane mesh at y=-1"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultGodRaysActive",
      "conditions": [
        "window.__3D_STATE__.godRaysEnabled === true",
        "Math.abs(window.__3D_STATE__.decay - 0.96) < 0.001",
        "Math.abs(window.__3D_STATE__.exposure - 0.22) < 0.001"
      ]
    },
    {
      "id": "S2",
      "name": "GodRaysDisabled",
      "conditions": [
        "window.__3D_STATE__.godRaysEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "GodRaysReEnabled",
      "conditions": [
        "window.__3D_STATE__.godRaysEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "ParametersModified",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'Custom' || window.__3D_STATE__.decay !== 0.96"
      ]
    },
    {
      "id": "S5",
      "name": "PresetApplied",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'Intense'"
      ]
    },
    {
      "id": "S6",
      "name": "LightMoved",
      "conditions": [
        "window.__3D_STATE__.lightPosition.y !== 5"
      ]
    },
    {
      "id": "S7",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true",
        "window.__3D_STATE__.lastAction === 'save'"
      ]
    },
    {
      "id": "S8",
      "name": "StateReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.decay - 0.96) < 0.001",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S9",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'load'"
      ]
    },
    {
      "id": "S10",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoIndex >= 0"
      ]
    },
    {
      "id": "S11",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoIndex >= 1"
      ]
    },
    {
      "id": "S12",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.animationPaused === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true && window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.godRaysEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.decay - 0.96) < 0.001 && Math.abs(window.__3D_STATE__.exposure - 0.22) < 0.001 && Math.abs(window.__3D_STATE__.density - 0.97) < 0.001 && Math.abs(window.__3D_STATE__.weight - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samples === 80 && window.__3D_STATE__.currentPreset === 'Default'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightPosition === 'object' && typeof window.__3D_STATE__.lightScreenPos === 'object' && !isNaN(window.__3D_STATE__.lightScreenPos.x) && !isNaN(window.__3D_STATE__.lightScreenPos.y)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.godRaysEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_godrays'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.undoStack) && window.__3D_STATE__.undoStack.length >= 1",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('toggleGodRays') !== null && document.getElementById('toggleGodRays').checked === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleGodRays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.godRaysEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.occlusionPassActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compositePassActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetWidth > 0 && window.__3D_STATE__.renderTargetHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleGodRays').checked === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sliderDecay').value = 0.99; document.getElementById('sliderDecay').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.decay - 0.99) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.decay >= 0.9 && window.__3D_STATE__.decay <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.decay) && !isNaN(window.__3D_STATE__.exposure) && !isNaN(window.__3D_STATE__.density) && !isNaN(window.__3D_STATE__.weight)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStack.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Custom' || window.__3D_STATE__.decay !== 0.96",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Intense'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.decay - 0.99) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.exposure - 0.45) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.density - 1.3) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weight - 1.2) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samples === 120",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.lightPosition.y - 5.5) < 0.05",
