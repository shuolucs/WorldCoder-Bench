          },
          {
            "expr": "window.__3D_STATE__.godRaysEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightPosition.z === 'number' && window.__3D_STATE__.lightPosition.z >= -8 && window.__3D_STATE__.lightPosition.z <= -5",
