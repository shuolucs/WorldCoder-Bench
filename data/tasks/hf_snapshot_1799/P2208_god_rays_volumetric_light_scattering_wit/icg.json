{
  "task_id": "P2208_god_rays_volumetric_light_scattering_wit",
  "affordances": [
    {
      "id": "A1",
      "name": "LightSource",
      "type": "3d_object",
      "semantic": "Glowing sphere representing the volumetric light origin for god rays",
      "locator_hints": [
        "emissive sphere at elevated position",
        "light source mesh"
      ]
    },
    {
      "id": "A2",
      "name": "AntiqueCameraModel",
      "type": "3d_object",
      "semantic": "Loaded AntiqueCamera.glb model acting as occluder",
      "locator_hints": [
        "GLTF model at origin",
        "AntiqueCamera"
      ]
    },
    {
      "id": "A3",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "UI panel with sliders, buttons, and presets",
