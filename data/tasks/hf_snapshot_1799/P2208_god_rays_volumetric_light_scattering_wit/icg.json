          },
          {
            "expr": "window.__3D_STATE__.decay >= 0.9 && window.__3D_STATE__.decay <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposure >= 0.0 && window.__3D_STATE__.exposure <= 1.0",
