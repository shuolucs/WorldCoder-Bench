          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'save'",
            "tier": "L2"
          },
          {
            "expr": "localStorage.getItem('godRayState') !== null",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('godRayState')).decay !== undefined && Math.abs(JSON.parse(localStorage.getItem('godRayState')).decay - 0.99) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('godRayState')).samples === 120",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.decay - 0.96) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.exposure - 0.22) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.density - 0.97) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weight - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samples === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'load'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.decay - 0.99) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samples === 120",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.exposure - 0.45) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.savedStateExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z",
        "ctrlKey": true
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStack.length >= 1",
            "tier": "L2"
          },
          {
