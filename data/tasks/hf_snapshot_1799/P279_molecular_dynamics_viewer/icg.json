{
  "task_id": "P279_molecular_dynamics_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation play/pause",
      "locator_hints": [
        "#playPauseBtn"
      ]
    },
    {
      "id": "A2",
      "name": "TemperatureSlider",
      "type": "dom_element",
      "semantic": "Slider controlling temperature from 0-500K",
      "locator_hints": [
        "#tempSlider"
      ]
    },
    {
      "id": "A3",
      "name": "TemperatureLabel",
      "type": "dom_element",
      "semantic": "Label showing current temperature",
      "locator_hints": [
        "#tempLabel"
      ]
    },
    {
      "id": "A4",
      "name": "DisplayModeButton",
      "type": "dom_element",
      "semantic": "Button cycling display modes",
      "locator_hints": [
        "#displayModeBtn"
      ]
    },
    {
      "id": "A5",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing simulation info",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A6",
      "name": "OxygenAtoms",
      "type": "3d_object",
      "semantic": "Red oxygen spheres in the scene",
      "locator_hints": [
        "red spheres",
        "radius 0.8"
      ]
    },
    {
      "id": "A7",
      "name": "HydrogenAtoms",
      "type": "3d_object",
      "semantic": "White hydrogen spheres in the scene",
      "locator_hints": [
        "white spheres",
        "radius 0.5"
      ]
    },
    {
      "id": "A8",
      "name": "Bonds",
      "type": "3d_object",
      "semantic": "Gray cylinders representing O-H bonds",
      "locator_hints": [
        "gray cylinders"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.displayMode === 'ball-and-stick'",
        "window.__3D_STATE__.atomCount === 15",
        "window.__3D_STATE__.bondCount === 10",
        "window.__3D_STATE__.hydrogenVisible === true",
        "window.__3D_STATE__.selectedAtomIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "HighTemperature",
      "conditions": [
        "window.__3D_STATE__.temperature > 400",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S3",
      "name": "LowTemperature",
      "conditions": [
        "window.__3D_STATE__.temperature < 100",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "SpaceFillMode",
      "conditions": [
        "window.__3D_STATE__.displayMode === 'space-fill'"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeMode",
      "conditions": [
        "window.__3D_STATE__.displayMode === 'wireframe'"
      ]
    },
    {
      "id": "S6",
      "name": "HydrogenHidden",
      "conditions": [
        "window.__3D_STATE__.hydrogenVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('playPauseBtn').textContent.trim() === 'Play'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('playPauseBtn').textContent.trim() === 'Pause'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.displayMode === 'ball-and-stick'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('tempSlider').value = 450; document.getElementById('tempSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 450",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vibrationAmplitude > 0.15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempLabel').textContent.includes('450')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageDistance >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('tempSlider').value = 50; document.getElementById('tempSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vibrationAmplitude < 0.15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempLabel').textContent.includes('50')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageDistance < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S0",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#displayModeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode === 'space-fill'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoPanel').textContent.includes('space-fill')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#displayModeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode === 'wireframe'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoPanel').textContent.includes('wireframe')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculePositions.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hydrogenVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageDistance >= 0 && window.__3D_STATE__.averageDistance < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempSlider').value === '300'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempLabel').textContent.includes('300')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageDistance > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}