  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 0",
        "window.__3D_STATE__.currentPH >= 0.9 && window.__3D_STATE__.currentPH <= 1.1",
        "window.__3D_STATE__.equivalenceReached === false",
        "window.__3D_STATE__.dataPoints.length === 0 || window.__3D_STATE__.dataPoints.length === 1"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstAddition",
      "conditions": [
        "window.__3D_STATE__.volumeAdded > 0",
        "window.__3D_STATE__.currentPH > 1.0",
        "window.__3D_STATE__.dataPoints.length >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "MidTitration",
      "conditions": [
        "window.__3D_STATE__.volumeAdded >= 10 && window.__3D_STATE__.volumeAdded < 50",
        "window.__3D_STATE__.currentPH > 1.0 && window.__3D_STATE__.currentPH < 7.0",
        "window.__3D_STATE__.equivalenceReached === false"
      ]
    },
    {
      "id": "S3",
      "name": "NearEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded >= 45 && window.__3D_STATE__.volumeAdded < 50",
        "window.__3D_STATE__.currentPH > 2.5 && window.__3D_STATE__.currentPH < 7.0"
      ]
    },
    {
      "id": "S4",
      "name": "AtEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded >= 50",
        "window.__3D_STATE__.equivalenceReached === true"
      ]
    },
    {
      "id": "S5",
      "name": "PastEquivalence",
      "conditions": [
        "window.__3D_STATE__.volumeAdded > 50",
        "window.__3D_STATE__.currentPH > 7.0",
        "window.__3D_STATE__.equivalenceReached === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.volumeAdded === 0",
        "window.__3D_STATE__.equivalenceReached === false"
      ]
    },
    {
      "id": "S7",
      "name": "CustomStepVolume",
      "conditions": [
        "window.__3D_STATE__.stepVolume !== 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "AutoTitrating",
      "conditions": [
        "window.__3D_STATE__.isAutoTitrating === true"
      ]
    },
    {
      "id": "S9",
      "name": "AutoTitrationComplete",
      "conditions": [
        "window.__3D_STATE__.isAutoTitrating === false",
        "window.__3D_STATE__.volumeAdded >= 100"
      ]
    }
  ],
