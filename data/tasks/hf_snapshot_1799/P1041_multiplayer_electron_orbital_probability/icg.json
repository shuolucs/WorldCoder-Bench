    {
      "id": "S0",
      "name": "Initial_1s_NoElectrons",
      "conditions": [
        "window.__3D_STATE__.currentOrbital === '1s'",
        "window.__3D_STATE__.electronCount === 0",
        "window.__3D_STATE__.totalEnergy === 0",
        "window.__3D_STATE__.superpositionMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "OneElectron_1s_Up",
      "conditions": [
        "window.__3D_STATE__.electronCount === 1",
        "window.__3D_STATE__.electrons[0].orbital === '1s'",
        "window.__3D_STATE__.electrons[0].spin === 'up'"
      ]
    },
    {
      "id": "S2",
      "name": "TwoElectrons_1s_Full",
      "conditions": [
        "window.__3D_STATE__.electronCount === 2",
        "window.__3D_STATE__.electrons[1].orbital === '1s'",
        "window.__3D_STATE__.electrons[1].spin === 'down'"
      ]
    },
    {
      "id": "S3",
      "name": "PauliViolation_Rejected",
      "conditions": [
        "window.__3D_STATE__.pauliViolationCount >= 1",
        "window.__3D_STATE__.electronCount === 2"
      ]
    },
    {
      "id": "S4",
      "name": "Orbital_Switched_2p_x",
      "conditions": [
        "window.__3D_STATE__.currentOrbital === '2p_x'",
        "window.__3D_STATE__.visibleOrbitals.includes('2p_x')"
      ]
    },
    {
      "id": "S5",
      "name": "ThreeElectrons_Mixed",
      "conditions": [
        "window.__3D_STATE__.electronCount === 3"
      ]
    },
    {
      "id": "S6",
      "name": "Superposition_On",
      "conditions": [
        "window.__3D_STATE__.superpositionMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "Electron_Removed_Undo",
      "conditions": [
        "window.__3D_STATE__.electronCount === 2",
        "window.__3D_STATE__.undoStackSize === 1"
