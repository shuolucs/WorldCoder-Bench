{
  "task_id": "P2135_accessible_ramp_gradient_compliance_chec",
  "affordances": [
    {
      "id": "A1",
      "name": "Ramp",
      "type": "3d_object",
      "semantic": "The parametric ramp mesh group that changes color based on compliance",
      "locator_hints": [
        "ramp mesh",
        "inclined surface",
        "colored by compliance"
      ]
    },
    {
      "id": "A2",
      "name": "AmberExhibit",
      "type": "3d_object",
      "semantic": "The loaded MosquitoInAmber.glb model on a pedestal",
      "locator_hints": [
        "GLTF model",
        "MosquitoInAmber",
        "pedestal at (6,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "RiseSlider",
      "type": "dom_element",
      "semantic": "Slider controlling ramp rise in meters",
      "locator_hints": [
        "input[type=range] for rise",
        "range 0.1-3.0"
      ]
    },
    {
      "id": "A4",
      "name": "RunSlider",
      "type": "dom_element",
      "semantic": "Slider controlling ramp run in meters",
      "locator_hints": [
        "input[type=range] for run",
        "range 1.0-36.0"
      ]
    },
    {
      "id": "A5",
      "name": "WidthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling ramp width in meters",
      "locator_hints": [
        "input[type=range] for width",
        "range 1.0-5.0"
      ]
    },
    {
      "id": "A6",
      "name": "CheckComplianceBtn",
      "type": "dom_element",
      "semantic": "Button that triggers full compliance check",
      "locator_hints": [
        "button",
        "Check Compliance"
      ]
    },
    {
      "id": "A7",
      "name": "ResetADABtn",
      "type": "dom_element",
      "semantic": "Button that resets parameters to ADA minimum values",
      "locator_hints": [
        "button",
        "Reset to ADA Minimum"
      ]
    },
    {
      "id": "A8",
      "name": "UndoBtn",
      "type": "dom_element",
      "semantic": "Button to undo last parameter change",
      "locator_hints": [
        "button",
        "Undo"
      ]
    },
    {
      "id": "A9",
      "name": "RedoBtn",
      "type": "dom_element",
      "semantic": "Button to redo undone parameter change",
      "locator_hints": [
        "button",
        "Redo"
      ]
    },
    {
      "id": "A10",
      "name": "MeasurementToggleBtn",
      "type": "dom_element",
      "semantic": "Button to toggle measurement overlay on/off",
      "locator_hints": [
        "button",
        "Toggle Measurement Overlay"
      ]
    },
    {
      "id": "A11",
      "name": "ExportReportBtn",
      "type": "dom_element",
      "semantic": "Button to generate compliance report text",
      "locator_hints": [
        "button",
        "Export Report"
      ]
    },
    {
      "id": "A12",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Text display showing compliance status",
      "locator_hints": [
        "Status:",
        "COMPLIANT",
        "WARNING",
        "NON-COMPLIANT"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.rise === 0.5",
        "window.__3D_STATE__.run === 6.0",
        "window.__3D_STATE__.width === 2.0",
        "window.__3D_STATE__.complianceStatus === 'COMPLIANT'",
        "window.__3D_STATE__.measurementOverlayVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoadedAndSceneReady",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rampMeshExists === true"
      ]
    },
    {
      "id": "S2",
      "name": "RiseIncreasedViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.rise === 0.6",
        "window.__3D_STATE__.historyLength >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "NonCompliantState",
      "conditions": [
        "window.__3D_STATE__.complianceStatus === 'NON-COMPLIANT'",
        "window.__3D_STATE__.rampColor === '#CC0000'"
      ]
    },
    {
      "id": "S4",
      "name": "WarningState",
      "conditions": [
        "window.__3D_STATE__.complianceStatus === 'WARNING'",
        "window.__3D_STATE__.rampColor === '#CCCC00'"
      ]
    },
    {
      "id": "S5",
      "name": "MeasurementOverlayOn",
      "conditions": [
        "window.__3D_STATE__.measurementOverlayVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.undoStackLength >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.undoStackLength === 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToADA",
      "conditions": [
        "window.__3D_STATE__.rise === 0.75",
        "window.__3D_STATE__.run === 9.0",
        "window.__3D_STATE__.width === 1.5"
      ]
    },
    {
      "id": "S9",
      "name": "LandingsRequired",
      "conditions": [
        "window.__3D_STATE__.landingsRequired >= 1",
        "window.__3D_STATE__.segmentCount >= 2"
      ]
    },
    {
      "id": "S10",
      "name": "ReportExported",
      "conditions": [
        "window.__3D_STATE__.reportText.length > 0"
      ]
    },
    {
      "id": "S11",
      "name": "ComplianceChecked",
      "conditions": [
        "window.__3D_STATE__.checkCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rampMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rise === 'number' && !isNaN(window.__3D_STATE__.rise)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.gradient === 'number' && !isNaN(window.__3D_STATE__.gradient)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'COMPLIANT'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rise - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rampTopY - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.slopeAngleDeg - Math.atan(0.6 / 6.0) * 180 / Math.PI) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gradient - (6.0 / 0.6)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction !== ''",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let riseSlider = document.querySelector('input[type=range]'); if(riseSlider) { riseSlider.value = 2.5; riseSlider.dispatchEvent(new Event('input', {bubbles:true})); } let runSlider = document.querySelectorAll('input[type=range]')[1]; if(runSlider) { runSlider.value = 5.0; runSlider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rise - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.run - 5.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'NON-COMPLIANT'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rampColor === '#CC0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gradient < 8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.landingsRequired === 'number' && !isNaN(window.__3D_STATE__.landingsRequired)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let runSlider = document.querySelectorAll('input[type=range]')[1]; if(runSlider) { runSlider.value = 25.0; runSlider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.run - 25.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'WARNING'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rampColor === '#CCCC00'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gradient >= 8 && window.__3D_STATE__.gradient < 12",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.slopeAngleDeg - Math.atan(2.5 / 25.0) * 180 / Math.PI) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.measurementOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'WARNING'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalLength === 'number' && window.__3D_STATE__.totalLength > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rampMeshExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackLength >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rise === 'number' && !isNaN(window.__3D_STATE__.rise)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.run === 'number' && !isNaN(window.__3D_STATE__.run)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction.toLowerCase().includes('undo')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y",
        "ctrlKey": true
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackLength === 0 || window.__3D_STATE__.undoStackLength < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction.toLowerCase().includes('redo')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.gradient === 'number' && !isNaN(window.__3D_STATE__.gradient)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rampTopY - window.__3D_STATE__.rise) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rise > 0 && window.__3D_STATE__.run > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Reset to ADA Minimum"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rise - 0.75) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.run - 9.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.width - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'COMPLIANT'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rampColor === '#00CC44'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gradient - 12.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let riseSlider = document.querySelector('input[type=range]'); if(riseSlider) { riseSlider.value = 2.0; riseSlider.dispatchEvent(new Event('input', {bubbles:true})); } let runSlider = document.querySelectorAll('input[type=range]')[1]; if(runSlider) { runSlider.value = 30.0; runSlider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rise - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.run - 30.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.landingsRequired >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.complianceStatus === 'COMPLIANT'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLength > Math.sqrt(2.0*2.0 + 30.0*30.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Check Compliance"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.checkCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.complianceStatus === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['COMPLIANT','WARNING','NON-COMPLIANT'].includes(window.__3D_STATE__.complianceStatus)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.slopeAngleDeg === 'number' && window.__3D_STATE__.slopeAngleDeg > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gradient === window.__3D_STATE__.run / window.__3D_STATE__.rise || Math.abs(window.__3D_STATE__.gradient - window.__3D_STATE__.run / window.__3D_STATE__.rise) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S11",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Export Report"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reportText === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reportText.length > 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reportText.toLowerCase().includes('gradient') || window.__3D_STATE__.reportText.toLowerCase().includes('slope')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reportText.toLowerCase().includes('compliant') || window.__3D_STATE__.reportText.toLowerCase().includes('status')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.checkCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.measurementOverlayVisible === true || window.__3D_STATE__.measurementOverlayVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rise === 'number' && !isNaN(window.__3D_STATE__.rise)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.run === 'number' && !isNaN(window.__3D_STATE__.run)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.width === 'number' && !isNaN(window.__3D_STATE__.width)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rise >= 0.1 && window.__3D_STATE__.rise <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.run >= 1.0 && window.__3D_STATE__.run <= 36.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}