{
  "task_id": "P266_breakout_3d_with_save_load_state",
  "affordances": [
    {
      "id": "A1",
      "name": "Ball",
      "type": "3d_object",
      "semantic": "The breakout ball that bounces around the arena",
      "locator_hints": [
        "SphereGeometry",
        "color #ff00ff",
        "radius 0.4"
      ]
    },
    {
      "id": "A2",
      "name": "Paddle",
      "type": "3d_object",
      "semantic": "Player-controlled paddle at bottom of arena",
      "locator_hints": [
        "BoxGeometry(4, 0.5, 1)",
        "z=12"
      ]
    },
    {
      "id": "A3",
      "name": "Bricks",
      "type": "3d_object",
      "semantic": "Grid of 30 breakable bricks",
      "locator_hints": [
        "5 rows x 6 columns",
        "BoxGeometry(2.8, 0.8, 1.2)"
      ]
    },
    {
      "id": "A4",
      "name": "RobotModel",
      "type": "3d_object",
      "semantic": "Decorative robot GLB model rotating in the arena",
      "locator_hints": [
        "robot.glb",
        "GLTFLoader"
      ]
    },
    {
      "id": "A5",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save game state",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A6",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load game state",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score and lives display",
      "locator_hints": [
        "Score",
        "Lives"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.gameRunning === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.bricksRemaining === 30"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Running",
      "conditions": [
        "window.__3D_STATE__.gameRunning === true",
        "window.__3D_STATE__.lives >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Ball_Moving",
      "conditions": [
        "window.__3D_STATE__.gameRunning === true",
        "window.__3D_STATE__.ballPosition.z < 13"
      ]
    },
    {
      "id": "S3",
      "name": "Paddle_Moved",
      "conditions": [
        "Math.abs(window.__3D_STATE__.paddleX) > 0.5"
      ]
    },
    {
      "id": "S4",
      "name": "Brick_Destroyed",
      "conditions": [
        "window.__3D_STATE__.bricksRemaining < 30",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S5",
      "name": "State_Saved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S6",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.lastLoadTime > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Robot_Loaded",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballVelocity !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballVelocity !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "hold_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballVelocity !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#saveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "window.__savedState !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__savedState.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__savedState.lives === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__savedState.bricks) || window.__savedState.bricksRemaining !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.score = 999; document.getElementById('loadBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.lastLoadTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballVelocity !== undefined",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}