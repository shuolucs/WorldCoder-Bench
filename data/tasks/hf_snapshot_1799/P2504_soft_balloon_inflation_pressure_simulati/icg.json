{
  "task_id": "P2504_soft_balloon_inflation_pressure_simulati",
  "affordances": [
    {
      "id": "A1",
      "name": "Balloon",
      "type": "3d_object",
      "semantic": "Deformable soft-body balloon mesh that inflates/deflates under pressure",
      "locator_hints": [
        "IcosahedronGeometry mesh",
        "semi-transparent red object at scene center"
      ]
    },
    {
      "id": "A2",
      "name": "PumpButton",
      "type": "dom_element",
      "semantic": "Button that adds 0.5 atm pressure per click",
      "locator_hints": [
        "#btn-pump"
      ]
    },
    {
      "id": "A3",
      "name": "ReleaseButton",
      "type": "dom_element",
      "semantic": "Button that releases 0.3 atm pressure per click",
      "locator_hints": [
        "#btn-release"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button that resets balloon to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "HUD_Pressure",
      "type": "dom_element",
      "semantic": "Displays current internal pressure",
      "locator_hints": [
        "#hud-pressure"
      ]
    },
    {
      "id": "A6",
      "name": "HUD_Volume",
      "type": "dom_element",
      "semantic": "Displays current balloon volume",
      "locator_hints": [
        "#hud-volume"
      ]
    },
    {
      "id": "A7",
      "name": "HUD_Stretch",
      "type": "dom_element",
      "semantic": "Displays current stretch factor",
      "locator_hints": [
        "#hud-stretch"
      ]
    },
    {
      "id": "A8",
      "name": "HUD_Status",
      "type": "dom_element",
      "semantic": "Displays balloon status string",
      "locator_hints": [
        "#hud-status"
      ]
    },
    {
      "id": "A9",
      "name": "HUD_Pokes",
      "type": "dom_element",
      "semantic": "Displays poke count",
      "locator_hints": [
        "#hud-pokes"
      ]
    },
    {
      "id": "A10",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry at y=0",
        "grid or checkerboard"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.internalPressure === 1.0",
        "window.__3D_STATE__.isPopped === false",
        "window.__3D_STATE__.status === 'idle'",
        "window.__3D_STATE__.pokeCount === 0",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "After_Pump_Click",
      "conditions": [
        "window.__3D_STATE__.internalPressure >= 1.4",
        "window.__3D_STATE__.isPopped === false",
        "window.__3D_STATE__.stretchFactor > 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "Keyboard_Inflating",
      "conditions": [
        "window.__3D_STATE__.isInflating === true",
        "window.__3D_STATE__.status === 'inflating'"
      ]
    },
    {
      "id": "S3",
      "name": "Post_Keyboard_Inflate",
      "conditions": [
        "window.__3D_STATE__.internalPressure > 1.5",
        "window.__3D_STATE__.isInflating === false",
        "window.__3D_STATE__.status === 'idle'"
      ]
    },
    {
      "id": "S4",
      "name": "After_Release",
      "conditions": [
        "window.__3D_STATE__.isPopped === false"
      ]
    },
    {
      "id": "S5",
      "name": "High_Pressure_Warning",
      "conditions": [
        "window.__3D_STATE__.internalPressure >= 4.0",
        "window.__3D_STATE__.stretchFactor > 2.0",
        "window.__3D_STATE__.isPopped === false"
      ]
    },
    {
      "id": "S6",
      "name": "Balloon_Popped",
      "conditions": [
        "window.__3D_STATE__.isPopped === true",
        "window.__3D_STATE__.status === 'popped'",
        "window.__3D_STATE__.fragmentCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "After_Reset_From_Pop",
      "conditions": [
        "window.__3D_STATE__.isPopped === false",
        "window.__3D_STATE__.internalPressure === 1.0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "After_Poke",
      "conditions": [
        "window.__3D_STATE__.pokeCount >= 1",
        "window.__3D_STATE__.isPopped === false"
      ]
    },
    {
      "id": "S9",
      "name": "Deflating_State",
      "conditions": [
        "window.__3D_STATE__.isDeflating === true",
        "window.__3D_STATE__.status === 'deflating'"
      ]
    },
    {
      "id": "S10",
      "name": "Minimum_Pressure",
      "conditions": [
        "window.__3D_STATE__.internalPressure <= 0.3",
        "window.__3D_STATE__.isPopped === false"
      ]
    },
    {
      "id": "S11",
      "name": "Post_Second_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 2",
        "window.__3D_STATE__.internalPressure === 1.0",
        "window.__3D_STATE__.pokeCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.internalPressure === 'number' && !isNaN(window.__3D_STATE__.internalPressure)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.volume === 'number' && !isNaN(window.__3D_STATE__.volume)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.stretchFactor === 'number' && !isNaN(window.__3D_STATE__.stretchFactor)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false && window.__3D_STATE__.status === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.internalPressure - 1.0) < 0.01 && window.__3D_STATE__.maxPressure === 5.0 && window.__3D_STATE__.compliance === 0.15 && window.__3D_STATE__.springStiffness === 8.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-pump"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.internalPressure >= 1.45 && window.__3D_STATE__.internalPressure <= 1.55",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume > window.__3D_STATE__.restVolume",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stretchFactor > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elasticEnergy === 'number' && window.__3D_STATE__.elasticEnergy >= 0 && isFinite(window.__3D_STATE__.elasticEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "action": "keydown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isInflating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'inflating'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isDeflating === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status') !== null && document.getElementById('hud-status').textContent.toLowerCase().includes('inflating')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "action": "keyup"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isInflating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'idle'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.internalPressure > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume > window.__3D_STATE__.restVolume * 1.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stretchFactor - (window.__3D_STATE__.volume / window.__3D_STATE__.restVolume)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-release"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(function(){ var prev = window.__3D_STATE__._prevPressureT5 || 999; return window.__3D_STATE__.internalPressure < prev; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.internalPressure >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.volume === 'number' && window.__3D_STATE__.volume > 0 && isFinite(window.__3D_STATE__.volume)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-pressure') !== null && document.getElementById('hud-pressure').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<8;i++){document.getElementById('btn-pump').click();} return new Promise(r=>setTimeout(r,500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.internalPressure >= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stretchFactor > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elasticEnergy > 0 && isFinite(window.__3D_STATE__.elasticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorHex !== '#cc3333'",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<5;i++){document.getElementById('btn-pump').click();} return new Promise(r=>setTimeout(r,800));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPopped === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'popped'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.fragmentCount >= 30 && window.__3D_STATE__.fragmentCount <= 50",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status') !== null && document.getElementById('hud-status').textContent.toLowerCase().includes('popped')",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.internalPressure > window.__3D_STATE__.maxPressure || window.__3D_STATE__.isPopped === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-pump"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPopped === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'popped'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.fragmentCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status').textContent.toLowerCase().includes('popped')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.internalPressure - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'idle'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.fragmentCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stretchFactor - 1.0) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.5,
          "y": 0.4
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pokeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pokeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-pokes') !== null && parseInt(document.getElementById('hud-pokes').textContent) >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elasticEnergy >= 0 && isFinite(window.__3D_STATE__.elasticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
