        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDeflating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'deflating'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isInflating === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status') !== null && document.getElementById('hud-status').textContent.toLowerCase().includes('deflating')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keyup',{key:'s'})); return new Promise(r=>setTimeout(r,200)).then(()=>{document.getElementById('btn-reset').click(); return new Promise(r2=>setTimeout(r2,500));});"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.internalPressure - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pokeCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isPopped === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'idle'",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.volume - window.__3D_STATE__.restVolume) < window.__3D_STATE__.restVolume * 0.15",
            "tier": "L2"
          }
        ]
      }
