  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.partsCount === 4",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.mascotVisible === true",
        "window.__3D_STATE__.exploded === false",
        "window.__3D_STATE__.currentPreset === 'custom' || window.__3D_STATE__.currentPreset === 'classic'"
      ]
    },
    {
      "id": "S1",
      "name": "NeonPresetApplied",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'neon'",
        "window.__3D_STATE__.soleColor === '#00ff00'",
        "window.__3D_STATE__.upperColor === '#ff00ff'"
      ]
    },
    {
      "id": "S2",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S3",
      "name": "RotationReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.rotationY) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "MascotHidden",
      "conditions": [
        "window.__3D_STATE__.mascotVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Exploded",
      "conditions": [
        "window.__3D_STATE__.exploded === true"
      ]
    },
    {
      "id": "S6",
      "name": "EarthPresetApplied",
      "conditions": [
        "window.__3D_STATE__.currentPreset === 'earth'",
        "window.__3D_STATE__.soleColor === '#4a3728'"
      ]
    },
    {
      "id": "S7",
      "name": "MascotRestoredAndCollapsed",
      "conditions": [
        "window.__3D_STATE__.mascotVisible === true",
        "window.__3D_STATE__.exploded === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.soleColor !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.upperColor !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tongueColor !== undefined",
