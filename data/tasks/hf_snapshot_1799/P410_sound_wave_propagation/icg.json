{
  "task_id": "P410_sound_wave_propagation",
  "affordances": [
    {
      "id": "A1",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle play/pause of wave simulation",
      "locator_hints": [
        "#btn-play"
      ]
    },
    {
      "id": "A2",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Slider controlling wave spawn frequency",
      "locator_hints": [
        "#slider-freq"
      ]
    },
    {
      "id": "A3",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling wave propagation speed",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A4",
      "name": "SoundSource",
      "type": "3d_object",
      "semantic": "Yellow sphere representing the sound emitter",
      "locator_hints": [
        "yellow sphere at (-8,2,0)"
      ]
    },
    {
      "id": "A5",
      "name": "NefertitiModel",
      "type": "3d_object",
      "semantic": "Loaded Nefertiti bust at origin",
      "locator_hints": [
        "GLTF model at (0,1.5,0)"
      ]
    },
    {
      "id": "A6",
      "name": "WaveRings",
      "type": "3d_object",
      "semantic": "Expanding concentric torus rings",
      "locator_hints": [
        "cyan torus geometries"
      ]
    },
    {
      "id": "A7",
      "name": "HUDStats",
      "type": "dom_element",
      "semantic": "Statistics display panel",
      "locator_hints": [
        "#hud-stats"
      ]
    },
    {
      "id": "A8",
      "name": "FreqLabel",
      "type": "dom_element",
      "semantic": "Label showing current frequency value",
      "locator_hints": [
        "#label-freq"
      ]
    },
    {
      "id": "A9",
      "name": "SpeedLabel",
      "type": "dom_element",
      "semantic": "Label showing current speed value",
      "locator_hints": [
        "#label-speed"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.activeRings === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Rings_Active",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.activeRings > 0",
        "window.__3D_STATE__.totalSpawned > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Frequency_Changed",
      "conditions": [
        "window.__3D_STATE__.frequency !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speed !== 3.0"
      ]
    },
    {
      "id": "S5",
      "name": "Diffraction_Occurred",
      "conditions": [
        "window.__3D_STATE__.diffractionCount > 0",
        "window.__3D_STATE__.diffractionEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Diffraction_Disabled",
      "conditions": [
        "window.__3D_STATE__.diffractionEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "Source_Moved",
      "conditions": [
        "window.__3D_STATE__.sourceIndex !== 0"
      ]
    },
    {
      "id": "S8",
      "name": "Wireframe_On",
      "conditions": [
        "window.__3D_STATE__.wireframeMode === true"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Done",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.activeRings === 0",
        "window.__3D_STATE__.totalSpawned === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#btn-play').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#slider-freq').value = 2.5; document.querySelector('#slider-freq').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#slider-freq').value == '2.5'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#label-freq') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#slider-speed').value = 5.0; document.querySelector('#slider-speed').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#slider-speed').value == '5'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#label-speed') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "/* Simulate clicking on Nefertiti model by dispatching a raycaster-based event. We directly toggle via script since canvas click coordinates are hard to target. */ if(window.__toggleWireframe) { window.__toggleWireframe(); } else { /* fallback: dispatch click at center of canvas */ var cv = document.querySelector('canvas'); var rect = cv.getBoundingClientRect(); var evt = new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2}); cv.dispatchEvent(evt); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#btn-play').textContent.trim() === 'Play'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}