  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 3000",
        "window.__3D_STATE__.emberCount === 500",
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.colorTheme === 'fire'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.embersVisible === true",
        "window.__3D_STATE__.wireframeVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "ParticlesActive",
      "conditions": [
        "window.__3D_STATE__.activeParticleCount > 0",
        "window.__3D_STATE__.maxParticleHeight > 0",
        "window.__3D_STATE__.elapsedTime > 0.5"
      ]
    },
    {
      "id": "S2",
      "name": "HighIntensity",
      "conditions": [
        "window.__3D_STATE__.intensity === 2.5"
      ]
    },
    {
      "id": "S3",
      "name": "IceTheme",
      "conditions": [
        "window.__3D_STATE__.colorTheme === 'ice'",
        "window.__3D_STATE__.themeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "ToxicTheme",
      "conditions": [
        "window.__3D_STATE__.colorTheme === 'toxic'",
        "window.__3D_STATE__.themeIndex === 2"
      ]
    },
    {
      "id": "S5",
      "name": "EmbersHidden",
      "conditions": [
        "window.__3D_STATE__.embersVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "TornadoMoved",
      "conditions": [
        "Math.abs(window.__3D_STATE__.tornadoBaseX) > 0.5 || Math.abs(window.__3D_STATE__.tornadoBaseZ) > 0.5"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.colorTheme === 'fire'",
        "window.__3D_STATE__.embersVisible === true",
        "window.__3D_STATE__.isPaused === false"
      ]
    }
  ],
