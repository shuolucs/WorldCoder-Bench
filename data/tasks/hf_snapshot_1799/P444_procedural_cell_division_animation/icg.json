{
  "task_id": "P444_procedural_cell_division_animation",
  "affordances": [
    {
      "id": "A1",
      "name": "ParentCell",
      "type": "3d_object",
      "semantic": "The main cell sphere that undergoes division",
      "locator_hints": [
        "semi-transparent green sphere at origin",
        "radius 1.5"
      ]
    },
    {
      "id": "A2",
      "name": "Nucleus",
      "type": "3d_object",
      "semantic": "Purple nucleus inside the cell",
      "locator_hints": [
        "smaller purple sphere inside parent cell"
      ]
    },
    {
      "id": "A3",
      "name": "Chromosomes",
      "type": "3d_object",
      "semantic": "Red cylinder chromosome objects",
      "locator_hints": [
        "small red cylinders inside nucleus"
      ]
    },
    {
      "id": "A4",
      "name": "CleavageFurrow",
      "type": "3d_object",
      "semantic": "Torus that pinches cell during telophase",
      "locator_hints": [
        "torus at y=0 that shrinks"
      ]
    },
    {
      "id": "A5",
      "name": "DaughterCells",
      "type": "3d_object",
      "semantic": "Two resulting cells after cytokinesis",
      "locator_hints": [
        "two spheres at y=+2 and y=-2"
      ]
    },
    {
      "id": "A6",
      "name": "PhaseDisplay",
      "type": "dom_element",
      "semantic": "Shows current phase name and number",
      "locator_hints": [
        "div#phase-display",
        "top-left"
      ]
    },
    {
      "id": "A7",
      "name": "CellCount",
      "type": "dom_element",
      "semantic": "Shows total cell count",
      "locator_hints": [
        "div#cell-count",
        "top-right"
      ]
    },
    {
      "id": "A8",
      "name": "ProgressBar",
      "type": "dom_element",
      "semantic": "Shows phase transition progress",
      "locator_hints": [
        "div#progress-bar"
      ]
    },
    {
      "id": "A9",
      "name": "Timer",
      "type": "dom_element",
      "semantic": "Elapsed time display",
      "locator_hints": [
        "div#timer",
        "bottom-left"
      ]
    },
    {
      "id": "A10",
      "name": "BackgroundModel",
      "type": "3d_object",
      "semantic": "LittlestTokyo.glb decorative model",
      "locator_hints": [
        "positioned at (8,-2,-5)",
        "scale 0.002"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'Interphase'",
        "window.__3D_STATE__.cellCount === 1",
        "window.__3D_STATE__.chromosomeCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Prophase'",
        "window.__3D_STATE__.phaseComplete === true"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Metaphase'",
        "window.__3D_STATE__.phaseComplete === true"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.chromosomeCount === 8",
        "window.__3D_STATE__.phaseComplete === true"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseComplete === true"
      ]
    },
    {
      "id": "S5",
      "name": "Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 5",
        "window.__3D_STATE__.cellCount === 2",
        "window.__3D_STATE__.phaseComplete === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetToInterphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.cellCount === 1",
        "window.__3D_STATE__.chromosomeCount === 4"
      ]
    },
    {
      "id": "S7",
      "name": "AutoPlayActive",
      "conditions": [
        "window.__3D_STATE__.autoPlayActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "LabelsVisible",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "DaughterCellSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCell !== null"
      ]
    },
    {
      "id": "S10",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
