  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.particleCount === 0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.viewMode === 'Inertial Frame'",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.frameCount > 0",
        "window.__3D_STATE__.earthAngle > 0"
      ]
    },
    {
      "id": "S2",
      "name": "ParticleAtL4Placed",
      "conditions": [
        "window.__3D_STATE__.activeParticles.L4 === true",
        "window.__3D_STATE__.particleCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "ParticleAtL1Placed",
      "conditions": [
        "window.__3D_STATE__.activeParticles.L1 === true",
        "window.__3D_STATE__.particleCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "ViewRotatingFrame",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'Rotating Frame'"
      ]
    },
    {
      "id": "S7",
      "name": "L1Drifted",
      "conditions": [
        "window.__3D_STATE__.particleDisplacements.L1 > 2.0"
      ]
    },
    {
      "id": "S8",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 0",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.particleCount === 0",
        "window.__3D_STATE__.earthAngle === 0"
      ]
    },
    {
      "id": "S11",
      "name": "EarthFollowView",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'Earth Follow'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number' && window.__3D_STATE__.simTime > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthAngle === 'number' && window.__3D_STATE__.earthAngle > 0 && !isNaN(window.__3D_STATE__.earthAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lagrangePositions === 'object' && typeof window.__3D_STATE__.lagrangePositions.L1 === 'object' && !isNaN(window.__3D_STATE__.lagrangePositions.L1.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthPosition === 'object' && Math.abs(Math.sqrt(window.__3D_STATE__.earthPosition.x**2 + window.__3D_STATE__.earthPosition.z**2) - 120) < 2",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10 && window.__3D_STATE__.sunPosition.x === 0 && window.__3D_STATE__.sunPosition.z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeParticles.L4 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleDisplacements.L4 === 'number' && window.__3D_STATE__.particleDisplacements.L4 >= 0 && !isNaN(window.__3D_STATE__.particleDisplacements.L4)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.jacobiConstants.L4 === 'number' && !isNaN(window.__3D_STATE__.jacobiConstants.L4)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeParticles.L1 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L4 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jacobiConstants.L1 === 'number' && !isNaN(window.__3D_STATE__.jacobiConstants.L1)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleDisplacements.L1 !== null && window.__3D_STATE__.particleDisplacements.L1 < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L1 === true && window.__3D_STATE__.activeParticles.L4 === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('pauseBtn').click(); document.getElementById('speedSlider').value = 3.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.speedMultiplier - 3.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number' && !isNaN(window.__3D_STATE__.simTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleDisplacements.L1 > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleDisplacements.L4 < 15",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jacobiConstants.L4 === 'number' && typeof window.__3D_STATE__._initialJacobi !== 'undefined' ? true : (Math.abs(window.__3D_STATE__.jacobiConstants.L4) >= 0)",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleDisplacements.L1) && !isNaN(window.__3D_STATE__.particleDisplacements.L4)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthAngle > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S7",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('viewSelect').value = 'Rotating Frame'; document.getElementById('viewSelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewMode === 'Rotating Frame'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthPosition === 'object' && !isNaN(window.__3D_STATE__.earthPosition.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lagrangePositions.L4 === 'object' && !isNaN(window.__3D_STATE__.lagrangePositions.L4.x)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.earthPosition.x**2 + window.__3D_STATE__.earthPosition.z**2) - 120) < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L1 === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L4 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleDisplacements.L1 === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L1 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L4 === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleDisplacements.L1 === 'number' && !isNaN(window.__3D_STATE__.particleDisplacements.L1)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('viewSelect').value = 'Earth Follow'; document.getElementById('viewSelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewMode === 'Earth Follow'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthPosition === 'object' && !isNaN(window.__3D_STATE__.earthPosition.x) && !isNaN(window.__3D_STATE__.earthPosition.z)",
            "tier": "L0"
