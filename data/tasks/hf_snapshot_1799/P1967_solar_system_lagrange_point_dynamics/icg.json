        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles.L1 === false && window.__3D_STATE__.activeParticles.L4 === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.earthAngle) < 0.01",
            "tier": "L2"
