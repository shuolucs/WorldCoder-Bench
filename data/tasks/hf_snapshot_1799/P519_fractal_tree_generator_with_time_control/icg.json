      ]
    },
    {
      "id": "A6",
      "name": "AngleSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling branchAngle 10-60",
      "locator_hints": [
        "#slider-angle"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling animation speed 1-10",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A8",
      "name": "InfoDisplay",
      "type": "dom_element",
      "semantic": "Text display showing current tree parameters",
      "locator_hints": [
        "#info-display"
      ]
    },
    {
      "id": "A9",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused_Full",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.maxDepth === 7",
        "window.__3D_STATE__.branchAngle === 30",
        "window.__3D_STATE__.growthTime === 1.0 || window.__3D_STATE__.growthTime === 0.0"
      ]
    },
    {
      "id": "S1",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.growthTime === 0.0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.visibleBranches === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Playing_Growing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.growthTime > 0.0",
        "window.__3D_STATE__.growthTime < 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "Fully_Grown",
      "conditions": [
        "window.__3D_STATE__.growthTime >= 1.0",
        "window.__3D_STATE__.visibleBranches === window.__3D_STATE__.totalBranches"
      ]
    },
    {
      "id": "S4",
      "name": "Depth_Changed",
      "conditions": [
        "window.__3D_STATE__.maxDepth !== 7"
      ]
    },
    {
      "id": "S5",
      "name": "Angle_Changed",
      "conditions": [
        "window.__3D_STATE__.branchAngle !== 30"
      ]
    },
    {
      "id": "S6",
      "name": "Manual_Time_Scrub",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.growthTime > 0.0",
        "window.__3D_STATE__.growthTime < 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "Low_Depth_Grown",
      "conditions": [
        "window.__3D_STATE__.maxDepth <= 3",
        "window.__3D_STATE__.growthTime >= 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "High_Depth_Growing",
      "conditions": [
        "window.__3D_STATE__.maxDepth >= 9",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
