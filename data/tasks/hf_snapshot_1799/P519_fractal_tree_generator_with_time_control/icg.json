{
  "task_id": "P519_fractal_tree_generator_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalTree",
      "type": "3d_object",
      "semantic": "The procedurally generated fractal tree made of cylinder branches and sphere leaves",
      "locator_hints": [
        "scene children group",
        "tree root group"
      ]
    },
    {
      "id": "A2",
      "name": "PlayPauseButton",
      "type": "dom_element",
