      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset growth time to 0",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A4",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling growthTime manually",
      "locator_hints": [
        "#slider-time"
      ]
    },
    {
      "id": "A5",
      "name": "DepthSlider",
      "type": "dom_element",
