          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.cursorPositions[0].x**2 + window.__3D_STATE__.cursorPositions[0].y**2) > 5 && Math.sqrt(window.__3D_STATE__.cursorPositions[0].x**2 + window.__3D_STATE__.cursorPositions[0].y**2) < 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeTypes.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeTypes.every(t => ['ALA','GLY','VAL','LEU','ILE','PRO','PHE','TRP'].includes(t))",
