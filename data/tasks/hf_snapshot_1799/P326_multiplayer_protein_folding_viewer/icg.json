    {
      "id": "A9",
      "name": "EnergySurface",
      "type": "3d_object",
      "semantic": "Transparent wireframe sphere toggled by E key",
      "locator_hints": [
        "wireframe sphere radius 12"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Helix",
      "conditions": [
        "window.__3D_STATE__.foldMode === 'helix'",
        "window.__3D_STATE__.nodeCount === 20",
        "window.__3D_STATE__.selectedNode === -1",
        "window.__3D_STATE__.visiblePlayerCount === 3",
        "window.__3D_STATE__.animationPaused === false"
      ]
    },
    {
      "id": "S1",
      "name": "Sheet_Mode",
      "conditions": [
        "window.__3D_STATE__.foldMode === 'sheet'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S2",
      "name": "Coil_Mode",
      "conditions": [
        "window.__3D_STATE__.foldMode === 'coil'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S3",
      "name": "Node_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedNode >= 0",
        "window.__3D_STATE__.selectedNode < 20"
      ]
    },
    {
      "id": "S4",
      "name": "Player_Hidden",
      "conditions": [
        "window.__3D_STATE__.visiblePlayerCount < 3"
      ]
    },
    {
      "id": "S5",
      "name": "Animation_Paused",
      "conditions": [
        "window.__3D_STATE__.animationPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Energy_Surface_Visible",
      "conditions": [
        "window.__3D_STATE__.energySurfaceVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_To_Helix",
      "conditions": [
        "window.__3D_STATE__.foldMode === 'helix'",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S8",
      "name": "Node_Deselected",
      "conditions": [
        "window.__3D_STATE__.selectedNode === -1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-sheet"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldMode === 'sheet'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nodePositions[0].y - 0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energy === 'number' && !isNaN(window.__3D_STATE__.energy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-coil"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldMode === 'coil'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.backboneLength === 'number' && window.__3D_STATE__.backboneLength > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.backboneLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energy === 'number' && isFinite(window.__3D_STATE__.energy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedNode = 5; if(window.__selectNode) window.__selectNode(5);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedNode === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeTypes[5] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeTypes[5] === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['ALA','GLY','VAL','LEU','ILE','PRO','PHE','TRP'].includes(window.__3D_STATE__.nodeTypes[5])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S0",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cursorVisible[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePlayerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cursorVisible[1] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cursorVisible[2] === true",
            "tier": "L2"
          }
        ]
