    {
      "id": "T10",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cursorPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
