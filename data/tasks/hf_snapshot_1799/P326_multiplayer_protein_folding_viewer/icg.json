          {
            "expr": "window.__3D_STATE__.animationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cursorPositions.length === 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cursorPositions[0].x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cursorPositions[1].z)",
            "tier": "L2"
          }
        ]
