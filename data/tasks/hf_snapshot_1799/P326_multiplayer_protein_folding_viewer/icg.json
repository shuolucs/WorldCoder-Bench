        "checks": [
          {
            "expr": "window.__3D_STATE__.foldMode === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.backboneLength === 'number' && window.__3D_STATE__.backboneLength > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(p => Math.abs(p.x) < 10 && Math.abs(p.y) < 10 && Math.abs(p.z) < 10)",
