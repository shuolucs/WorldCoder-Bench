            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && !isNaN(window.__3D_STATE__.particleCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.helmetRotationY === 'number' && !isNaN(window.__3D_STATE__.helmetRotationY)",
