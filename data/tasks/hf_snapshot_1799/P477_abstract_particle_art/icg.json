      "conditions": [
        "window.__3D_STATE__.mode === 'converge'"
      ]
    },
    {
      "id": "S3",
      "name": "Orbit_Mode_Restored",
      "conditions": [
        "window.__3D_STATE__.mode === 'orbit'"
      ]
    },
    {
      "id": "S4",
      "name": "Helmet_Hidden",
      "conditions": [
        "window.__3D_STATE__.helmetVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Helmet_Spinning",
      "conditions": [
        "window.__3D_STATE__.helmetSpinning === true"
      ]
    },
    {
      "id": "S6",
      "name": "Particles_Hidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Colors_Reset",
      "conditions": [
        "window.__3D_STATE__.colorResetCount >= 1"
      ]
    }
  ],
