        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.mode === 'orbit'",
        "window.__3D_STATE__.particleCount === 2000",
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.helmetVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Explode_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'explode'"
      ]
    },
    {
      "id": "S2",
