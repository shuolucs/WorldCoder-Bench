      ]
    },
    {
      "id": "A8",
      "name": "PulseStatusDisplay",
      "type": "dom_element",
      "semantic": "Span showing pulse status OFF or ON",
      "locator_hints": [
        "#pulse-status"
      ]
    },
    {
      "id": "A9",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last action",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A10",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo last undone action",
      "locator_hints": [
        "#btn-redo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_AllDefaults",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.layerEnabled.every(v => v === true)",
        "window.__3D_STATE__.peelDepth === 0",
        "window.__3D_STATE__.fresnelPower === 2.0",
        "window.__3D_STATE__.pulseEnabled === false",
        "window.__3D_STATE__.scanActive === false",
        "window.__3D_STATE__.activeLayerCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "Layer2Toggled_Off",
      "conditions": [
        "window.__3D_STATE__.layerEnabled[2] === false",
        "window.__3D_STATE__.activeLayerCount === 4",
        "window.__3D_STATE__.lastAction === 'toggle_layer_2'"
      ]
    },
    {
      "id": "S2",
      "name": "PeelDepthAdjusted",
      "conditions": [
        "window.__3D_STATE__.peelDepth > 0",
        "window.__3D_STATE__.peelUniformValue === window.__3D_STATE__.peelDepth"
      ]
    },
    {
      "id": "S3",
      "name": "FresnelAdjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.fresnelPower - 2.0) > 0.1",
        "window.__3D_STATE__.fresnelUniformValue === window.__3D_STATE__.fresnelPower"
      ]
    },
    {
      "id": "S4",
      "name": "PulseEnabled",
      "conditions": [
        "window.__3D_STATE__.pulseEnabled === true",
        "window.__3D_STATE__.lastAction === 'toggle_pulse'"
      ]
    },
    {
      "id": "S5",
      "name": "ScanActive",
      "conditions": [
        "window.__3D_STATE__.scanActive === true",
        "window.__3D_STATE__.lastAction === 'start_scan'"
      ]
    },
    {
      "id": "S6",
      "name": "ScanCompleted",
      "conditions": [
        "window.__3D_STATE__.scanActive === false"
      ]
    },
    {
      "id": "S7",
      "name": "MultipleLayersOff",
      "conditions": [
        "window.__3D_STATE__.layerEnabled[0] === false",
        "window.__3D_STATE__.layerEnabled[2] === false",
        "window.__3D_STATE__.activeLayerCount === 3"
      ]
    },
    {
      "id": "S8",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S10",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.layerEnabled.every(v => v === true)",
        "window.__3D_STATE__.peelDepth === 0",
        "window.__3D_STATE__.fresnelPower === 2.0",
        "window.__3D_STATE__.pulseEnabled === false",
        "window.__3D_STATE__.activeLayerCount === 5",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S11",
      "name": "ChainedPeelAndLayerState",
      "conditions": [
        "window.__3D_STATE__.peelDepth >= 0.5",
        "window.__3D_STATE__.layerEnabled[4] === false",
        "window.__3D_STATE__.activeLayerCount === 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerEnabled) && window.__3D_STATE__.layerEnabled.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layerEnabled.every(v => v === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelBounds === 'object' && Number.isFinite(window.__3D_STATE__.modelBounds.min.y) && Number.isFinite(window.__3D_STATE__.modelBounds.max.y)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerEnabled[2] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerEnabled[0] === true && window.__3D_STATE__.layerEnabled[1] === true && window.__3D_STATE__.layerEnabled[3] === true && window.__3D_STATE__.layerEnabled[4] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_layer_2'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-peel').value = 60; document.getElementById('slider-peel').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.peelDepth - 0.6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peelUniformValue - 0.6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.peelDepth) && !Number.isNaN(window.__3D_STATE__.peelDepth)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peelDepth >= 0.0 && window.__3D_STATE__.peelDepth <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){window.dispatchEvent(new WheelEvent('wheel',{deltaY:-100,bubbles:true}));document.querySelector('canvas').dispatchEvent(new WheelEvent('wheel',{deltaY:-100,bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fresnelPower >= 0.5 && window.__3D_STATE__.fresnelPower <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.fresnelPower)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fresnelUniformValue - window.__3D_STATE__.fresnelPower) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fresnelUniformValue === 'number' && !Number.isNaN(window.__3D_STATE__.fresnelUniformValue)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pulseEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_pulse'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pulse-status').textContent.trim() === 'ON'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.scanActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'start_scan'",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.scanLineY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanLineY >= window.__3D_STATE__.modelBounds.min.y - 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('scan-status').textContent.trim() === 'SCANNING'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.scanActive === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('scan-status').textContent.trim() === 'IDLE'",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.scanLineY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pulseEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerEnabled[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerEnabled[2] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_layer_0'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('active-layers').textContent.trim() === '3'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerEnabled[0] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerEnabled[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0 || window.__3D_STATE__.redoStackSize >= 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('active-layers').textContent.trim() === '3'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerEnabled.every(v => v === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peelDepth) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fresnelPower - 2.0) < 0.001",
            "tier": "L2"
          },
