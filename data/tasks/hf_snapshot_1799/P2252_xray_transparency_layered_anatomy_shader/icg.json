{
  "task_id": "P2252_xray_transparency_layered_anatomy_shader",
  "affordances": [
    {
      "id": "A1",
      "name": "FishModel",
      "type": "3d_object",
      "semantic": "The loaded BarramundiFish GLB model with custom x-ray shader applied",
      "locator_hints": [
        "scene.children",
        "gltf.scene"
      ]
    },
    {
      "id": "A2",
      "name": "LayerToggleButtons",
      "type": "dom_element",
      "semantic": "Five buttons to toggle anatomy layers on/off",
      "locator_hints": [
        "#btn-layer-0",
        "#btn-layer-1",
        "#btn-layer-2",
        "#btn-layer-3",
        "#btn-layer-4"
      ]
    },
    {
      "id": "A3",
      "name": "PeelSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling peel depth uniform",
      "locator_hints": [
        "#slider-peel"
      ]
    },
    {
      "id": "A4",
      "name": "PeelValueDisplay",
      "type": "dom_element",
      "semantic": "Span showing current peel depth percentage",
      "locator_hints": [
        "#peel-value"
      ]
    },
    {
      "id": "A5",
      "name": "FresnelValueDisplay",
      "type": "dom_element",
      "semantic": "Span showing current fresnel power",
