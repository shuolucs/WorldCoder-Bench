          },
          {
            "expr": "window.__3D_STATE__.layerEnabled[4] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peelUniformValue - window.__3D_STATE__.peelDepth) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.peelUniformValue) && Number.isFinite(window.__3D_STATE__.fresnelUniformValue)",
            "tier": "L2"
          }
        ]
