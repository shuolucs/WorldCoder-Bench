    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-peel').value = 50; document.getElementById('slider-peel').dispatchEvent(new Event('input', {bubbles:true})); setTimeout(()=>{ window.dispatchEvent(new KeyboardEvent('keydown',{key:'5',bubbles:true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.peelDepth - 0.5) < 0.02",
