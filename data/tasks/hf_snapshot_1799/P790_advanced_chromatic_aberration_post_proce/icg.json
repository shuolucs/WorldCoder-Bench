{
  "task_id": "P790_advanced_chromatic_aberration_post_proce",
  "affordances": [
    {
      "id": "A1",
      "name": "TorusKnot",
      "type": "3d_object",
      "semantic": "Central torus knot mesh, primary scene object",
      "locator_hints": [
        "scene.children with TorusKnot geometry",
        "color #ff6633"
      ]
    },
    {
      "id": "A2",
      "name": "SphereLeft",
      "type": "3d_object",
      "semantic": "Left sphere at (-2,0,0)",
      "locator_hints": [
        "position.x === -2"
      ]
    },
    {
      "id": "A3",
      "name": "SphereRight",
      "type": "3d_object",
      "semantic": "Right sphere at (2,0,0)",
      "locator_hints": [
        "position.x === 2"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD panel showing shader parameters and score",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A5",
      "name": "HistoryCount",
      "type": "dom_element",
      "semantic": "Bottom-right element showing snapshot count",
      "locator_hints": [
        "#history-count"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleButton",
      "type": "dom_element",
      "semantic": "Button to toggle post-process effect on/off",
      "locator_hints": [
        "#btn-toggle-effect"
      ]
    },
    {
      "id": "A7",
      "name": "ChromaticShader",
      "type": "3d_object",
      "semantic": "The full-screen chromatic aberration shader material",
      "locator_hints": [
        "ShaderMaterial with uIntensity uniform"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.01",
        "window.__3D_STATE__.direction === 0",
        "window.__3D_STATE__.blend === 1.0",
        "window.__3D_STATE__.effectEnabled === true",
        "window.__3D_STATE__.historyCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "IntensityIncreased",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.015",
        "window.__3D_STATE__.lastAction === 'increase_intensity'"
      ]
    },
    {
      "id": "S2",
      "name": "IntensityMaxClamped",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.05",
        "window.__3D_STATE__.score > 60"
      ]
    },
    {
      "id": "S3",
      "name": "DirectionCycled",
      "conditions": [
        "window.__3D_STATE__.direction === 1",
        "window.__3D_STATE__.directionName === 'Vertical'"
      ]
    },
    {
      "id": "S4",
      "name": "RadialMode",
      "conditions": [
        "window.__3D_STATE__.direction === 2",
        "window.__3D_STATE__.directionName === 'Radial'"
      ]
    },
    {
      "id": "S5",
      "name": "BlendCycled",
      "conditions": [
        "window.__3D_STATE__.blend === 0.0",
        "window.__3D_STATE__.lastAction === 'cycle_blend'"
      ]
    },
    {
      "id": "S6",
      "name": "SnapshotSaved",
      "conditions": [
        "window.__3D_STATE__.historyCount >= 1",
        "window.__3D_STATE__.lastAction === 'save_snapshot'"
      ]
    },
    {
      "id": "S7",
      "name": "SnapshotRestored",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'restore_snapshot'"
      ]
    },
    {
      "id": "S8",
      "name": "EffectDisabled",
      "conditions": [
        "window.__3D_STATE__.effectEnabled === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.rank === 'Off'"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.01",
        "window.__3D_STATE__.direction === 0",
        "window.__3D_STATE__.blend === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity === 'number' && !isNaN(window.__3D_STATE__.intensity)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.direction === 'number' && [0,1,2].includes(window.__3D_STATE__.direction)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.blend === 'number' && !isNaN(window.__3D_STATE__.blend)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && typeof window.__3D_STATE__.score === 'number'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 0.015) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'increase_intensity'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.round((window.__3D_STATE__.intensity / 0.05) * 40 + (window.__3D_STATE__.direction === 2 ? 30 : window.__3D_STATE__.direction === 1 ? 15 : 0) + window.__3D_STATE__.blend * 30)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.intensity) && window.__3D_STATE__.intensity <= 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<8;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 0.05) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 61",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rank === 'string' && window.__3D_STATE__.rank.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'increase_intensity'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.direction === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.directionName === 'Vertical'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'cycle_direction'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.round((window.__3D_STATE__.intensity / 0.05) * 40 + 15 + window.__3D_STATE__.blend * 30)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.effectEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.direction === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.directionName === 'Radial'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.round((window.__3D_STATE__.intensity / 0.05) * 40 + 30 + window.__3D_STATE__.blend * 30)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rank === 'Extreme'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.historyCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.historyEntries) && window.__3D_STATE__.historyEntries.length === 1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.historyEntries[0].score === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyEntries[0].direction === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'save_snapshot'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.historyEntries[0].timestamp === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blend - 0.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'cycle_blend'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.round((window.__3D_STATE__.intensity / 0.05) * 40 + 30 + 0.0 * 30)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score < 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rank !== 'Extreme'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'restore_snapshot'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blend - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.direction === 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 0.05) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-effect"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.effectEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rank === 'Off'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_effect'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 10",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-toggle-effect').click(); setTimeout(()=>window.dispatchEvent(new KeyboardEvent('keydown',{key:'r'})),200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.effectEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 0.01) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.direction === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.directionName === 'Horizontal'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blend - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.round((0.01 / 0.05) * 40 + 0 + 1.0 * 30)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}