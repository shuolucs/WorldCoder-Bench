  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(function(){ const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const peakNm = 520; const xFrac = (peakNm - 400) / (4000 - 400); const cx = rect.left + xFrac * rect.width; const cy = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true})); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.peaksFoundCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peaksFoundCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalScore > 0 && window.__3D_STATE__.totalScore <= 100",
            "tier": "L2"
          },
          {
