  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.peaksFoundCount === 0",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.markerCount === 0",
        "window.__3D_STATE__.hintsActive === false",
        "window.__3D_STATE__.allPeaksFound === false",
        "window.__3D_STATE__.completionBannerVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "FirstPeakIdentified",
      "conditions": [
        "window.__3D_STATE__.peaksFoundCount === 1",
        "window.__3D_STATE__.totalScore > 0",
        "window.__3D_STATE__.markerCount === 1"
      ]
    },
    {
      "id": "S2",
      "name": "MissPlaced",
      "conditions": [
        "window.__3D_STATE__.markerCount === 2",
        "window.__3D_STATE__.peaksFoundCount === 1"
      ]
    },
    {
      "id": "S3",
      "name": "UndoneOnce",
      "conditions": [
        "window.__3D_STATE__.markerCount === 1",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "RedoneOnce",
      "conditions": [
        "window.__3D_STATE__.markerCount === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S5",
      "name": "SecondPeakIdentified",
      "conditions": [
