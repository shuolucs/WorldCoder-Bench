        "window.__3D_STATE__.totalScore > 0"
      ]
    },
    {
      "id": "S6",
      "name": "HintsToggled",
      "conditions": [
        "window.__3D_STATE__.hintsActive === true",
        "window.__3D_STATE__.hintPenaltyApplied === true"
      ]
    },
    {
      "id": "S7",
      "name": "CameraPanned",
      "conditions": [
        "window.__3D_STATE__.cameraX !== 0"
      ]
    },
    {
      "id": "S8",
      "name": "CameraZoomed",
      "conditions": [
        "window.__3D_STATE__.zoomLevel !== window.__3D_STATE__._initialZoomLevel"
      ]
    },
    {
      "id": "S9",
      "name": "FullReset",
      "conditions": [
