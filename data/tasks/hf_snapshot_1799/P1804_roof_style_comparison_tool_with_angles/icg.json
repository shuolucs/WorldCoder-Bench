      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.swapCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.roofA.style === 'string' && window.__3D_STATE__.roofStyles.includes(window.__3D_STATE__.roofA.style)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.roofB.style === 'string' && window.__3D_STATE__.roofStyles.includes(window.__3D_STATE__.roofB.style)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle >= 5 && window.__3D_STATE__.roofA.pitchAngle <= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofB.pitchAngle >= 5 && window.__3D_STATE__.roofB.pitchAngle <= 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roofA.style === 'mansard'",
            "tier": "L2"
          },
          {
            "expr": "(() => { let p = window.__3D_STATE__.roofA.pitchAngle; let w = 4; let lower = (w/2)*Math.tan(p*Math.PI/180); let upper = (w/2)*Math.tan((p/3)*Math.PI/180); return Math.abs(window.__3D_STATE__.roofA.roofHeight - (lower + upper)) < 0.05; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.roofHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofA.roofHeight) && isFinite(window.__3D_STATE__.roofA.roofHeight)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.heightDifference === 'number' && !isNaN(window.__3D_STATE__.heightDifference)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
