          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle === window.__3D_STATE__.roofB.pitchAngle",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angleDifference === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle >= 5 && window.__3D_STATE__.roofA.pitchAngle <= 80",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofA.roofHeight) && !isNaN(window.__3D_STATE__.roofB.roofHeight)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
