          },
          {
            "expr": "(() => { let p = window.__3D_STATE__.roofA.pitchAngle; let d = 4; let expected = d * Math.tan(p * Math.PI / 180); return Math.abs(window.__3D_STATE__.roofA.roofHeight - expected) < 0.05; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.roofHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofA.roofHeight) && isFinite(window.__3D_STATE__.roofA.roofHeight)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle >= 5 && window.__3D_STATE__.roofA.pitchAngle <= 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
