            "expr": "window.__3D_STATE__.roofA.pitchAngle === window.__3D_STATE__.roofB.pitchAngle",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angleDifference === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.syncEnabled === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.syncEnabled === true",
