  "states": [
    {
      "id": "S0",
      "name": "Initial_Default",
      "conditions": [
        "window.__3D_STATE__.roofA.style === 'gable'",
        "window.__3D_STATE__.roofA.pitchAngle === 35",
        "window.__3D_STATE__.roofB.style === 'gable'",
        "window.__3D_STATE__.roofB.pitchAngle === 35",
        "window.__3D_STATE__.syncEnabled === false",
        "window.__3D_STATE__.angleDifference === 0"
      ]
    },
    {
      "id": "S1",
      "name": "RoofA_Style_Changed",
      "conditions": [
        "window.__3D_STATE__.roofA.style === 'hip'",
        "window.__3D_STATE__.roofB.style === 'gable'"
      ]
    },
    {
      "id": "S2",
      "name": "RoofA_Angle_Adjusted",
      "conditions": [
        "window.__3D_STATE__.roofA.pitchAngle === 50",
        "window.__3D_STATE__.angleDifference === 15"
      ]
    },
    {
      "id": "S3",
      "name": "RoofB_Style_Changed_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.roofB.style !== 'gable'"
      ]
    },
    {
      "id": "S4",
      "name": "Sync_Enabled",
      "conditions": [
        "window.__3D_STATE__.syncEnabled === true",
        "window.__3D_STATE__.roofA.pitchAngle === window.__3D_STATE__.roofB.pitchAngle"
      ]
    },
    {
      "id": "S5",
      "name": "Synced_Angle_Changed",
      "conditions": [
        "window.__3D_STATE__.syncEnabled === true",
        "window.__3D_STATE__.angleDifference === 0"
      ]
    },
    {
      "id": "S6",
      "name": "Styles_Swapped",
      "conditions": [
        "window.__3D_STATE__.swapCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Mansard_Roof_Height_Verified",
      "conditions": [
        "window.__3D_STATE__.roofA.style === 'mansard'"
      ]
    },
    {
      "id": "S8",
      "name": "Shed_Roof_Applied",
      "conditions": [
        "window.__3D_STATE__.roofA.style === 'shed'"
      ]
    },
    {
      "id": "S9",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.roofA.style === 'gable'",
        "window.__3D_STATE__.roofA.pitchAngle === 35",
        "window.__3D_STATE__.roofB.style === 'gable'",
        "window.__3D_STATE__.roofB.pitchAngle === 35",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.roofA === 'object' && typeof window.__3D_STATE__.roofB === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roofA.style === 'gable' && window.__3D_STATE__.roofA.pitchAngle === 35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofB.style === 'gable' && window.__3D_STATE__.roofB.pitchAngle === 35",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.roofStyles) && window.__3D_STATE__.roofStyles.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.buildingWidth === 4 && window.__3D_STATE__.buildingDepth === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "selector_hint": "Next Style button for building A in left panel"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roofA.style === 'hip'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofB.style === 'gable'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle === 35",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roofA.roofHeight - (4/2) * Math.tan(35 * Math.PI / 180)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofA.roofHeight) && isFinite(window.__3D_STATE__.roofA.roofHeight)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.querySelectorAll('input[type=range]')[0]; if(s){s.value=50; s.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofB.pitchAngle === 35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angleDifference === 15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roofA.roofHeight - (4/2) * Math.tan(50 * Math.PI / 180)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.heightDifference - Math.abs(window.__3D_STATE__.roofA.roofHeight - window.__3D_STATE__.roofB.roofHeight)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roofA.style === 'hip'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roofA.pitchAngle === 50",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofA.roofHeight) && isFinite(window.__3D_STATE__.roofA.roofHeight)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.roofB.roofHeight) && isFinite(window.__3D_STATE__.roofB.roofHeight)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.angleDifference === 'number' && !isNaN(window.__3D_STATE__.angleDifference)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
