      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const waveOutPort = document.querySelector('[data-node=\"Wave\"] .output-port, .node-wave .output-port'); if(waveOutPort) waveOutPort.click(); setTimeout(() => { const outInPort = document.querySelector('[data-node=\"Output\"] .input-port-wave, .node-output .input-port:nth-child(3), [data-input=\"Wave\"]'); if(outInPort) outInPort.click(); setTimeout(() => { const waveSlider = document.querySelector('[data-node=\"Wave\"] input[type=\"range\"], .node-wave input[type=\"range\"]'); if(waveSlider) { waveSlider.value = 0.5; waveSlider.dispatchEvent(new Event('input', {bubbles:true})); } }, 200); }, 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.connectionCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections.some(c => c.from === 'Wave')",
            "tier": "L2"
          },
          {
            "expr": "Object.keys(window.__3D_STATE__.normalizedWeights).length === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Object.values(window.__3D_STATE__.normalizedWeights).reduce((a,b) => a+b, 0) - 1.0) < 0.002",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightArmRotationZ >= -105 && window.__3D_STATE__.rightArmRotationZ <= 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preSpeedTime = window.__3D_STATE__.animationTime; const speedSlider = document.querySelector('input.speed-slider, .speed-control input[type=\"range\"]'); if(speedSlider) { speedSlider.value = 2.0; speedSlider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.speedMultiplier - 2.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > window.__preSpeedTime",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterY >= 0 && window.__3D_STATE__.characterY <= 0.6",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.torsoPositionY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const jumpOutPort = document.querySelector('[data-node=\"Jump\"] .output-port, .node-jump .output-port'); if(jumpOutPort) jumpOutPort.click(); setTimeout(() => { const outInPort = document.querySelector('[data-node=\"Output\"] .input-port-jump, .node-output .input-port:nth-child(4), [data-input=\"Jump\"]'); if(outInPort) outInPort.click(); setTimeout(() => { const jumpSlider = document.querySelector('[data-node=\"Jump\"] input[type=\"range\"], .node-jump input[type=\"range\"]'); if(jumpSlider) { jumpSlider.value = 0.8; jumpSlider.dispatchEvent(new Event('input', {bubbles:true})); } }, 200); }, 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.connectionCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections.some(c => c.from === 'Jump')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weights.Jump > 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Object.values(window.__3D_STATE__.normalizedWeights).reduce((a,b) => a+b, 0) - 1.0) < 0.002",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeAnimations.length >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterY >= 0 && window.__3D_STATE__.characterY <= 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preDisconnectCount = window.__3D_STATE__.connectionCount; window.__preDisconnectNorm = JSON.parse(JSON.stringify(window.__3D_STATE__.normalizedWeights)); const walkConnection = document.querySelector('svg path[data-from=\"Walk\"], svg .connection-walk, svg line[data-from=\"Walk\"]'); if(walkConnection) { walkConnection.dispatchEvent(new MouseEvent('contextmenu', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.connectionCount === window.__preDisconnectCount - 1",
            "tier": "L2"
          },
          {
            "expr": "!window.__3D_STATE__.connections.some(c => c.from === 'Walk')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedWeights.Walk === undefined || window.__3D_STATE__.normalizedWeights.Walk === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Object.values(window.__3D_STATE__.normalizedWeights).filter(v => typeof v === 'number').reduce((a,b) => a+b, 0) - 1.0) < 0.002",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connectionCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button.reset-btn, button:has-text('Reset')"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.connectionCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections[0].from === 'Idle'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weights.Idle - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weights.Walk === 0 || window.__3D_STATE__.weights.Walk === undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.normalizedWeights.Idle - 1.0) < 0.001",
            "tier": "L2"
          }
