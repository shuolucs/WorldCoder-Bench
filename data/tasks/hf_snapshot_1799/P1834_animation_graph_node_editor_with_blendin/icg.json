  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.connectionCount === 1",
        "window.__3D_STATE__.connections.length === 1",
        "window.__3D_STATE__.connections[0].from === 'Idle'",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.weights.Idle === 1.0",
        "window.__3D_STATE__.speedMultiplier === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.animationTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "WalkConnected",
      "conditions": [
        "window.__3D_STATE__.connectionCount === 2",
        "window.__3D_STATE__.connections.some(c => c.from === 'Walk')"
      ]
    },
    {
      "id": "S4",
      "name": "WalkWeightAdjusted",
      "conditions": [
        "window.__3D_STATE__.weights.Walk > 0",
        "Math.abs(window.__3D_STATE__.normalizedWeights.Idle + window.__3D_STATE__.normalizedWeights.Walk - 1.0) < 0.001"
      ]
    },
    {
      "id": "S5",
      "name": "ThreeNodesBlended",
      "conditions": [
        "window.__3D_STATE__.connectionCount === 3",
        "window.__3D_STATE__.activeAnimations.length >= 2"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "JumpActive",
      "conditions": [
        "window.__3D_STATE__.connections.some(c => c.from === 'Jump')",
        "window.__3D_STATE__.weights.Jump > 0"
      ]
    },
    {
      "id": "S8",
      "name": "ConnectionRemoved",
      "conditions": [
        "window.__3D_STATE__.connectionCount < 3"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.connectionCount === 1",
        "window.__3D_STATE__.connections[0].from === 'Idle'",
        "window.__3D_STATE__.weights.Idle === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationTime === 'number' && window.__3D_STATE__.animationTime > 0.5",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.torsoPositionY === 'number' && !isNaN(window.__3D_STATE__.torsoPositionY)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.normalizedWeights.Idle - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterY >= 0 && window.__3D_STATE__.characterY <= 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendMode === 'normalized_weighted'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button.play-pause-btn, button:has-text('Pause')"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterY)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rightArmRotationZ)",
            "tier": "L2"
          }
        ]
      }
    },
    {
