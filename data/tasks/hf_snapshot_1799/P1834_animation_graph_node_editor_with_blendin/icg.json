      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const pausedTime = window.__3D_STATE__.animationTime; window.__pausedTimeSnapshot = pausedTime; document.querySelector('button.play-pause-btn, button:has-text(\"Play\")').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > window.__pausedTimeSnapshot",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTime - window.__pausedTimeSnapshot < 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.torsoPositionY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.leftLegRotationX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const walkOutPort = document.querySelector('[data-node=\"Walk\"] .output-port, .node-walk .output-port'); if(walkOutPort) walkOutPort.click(); setTimeout(() => { const outInPort = document.querySelector('[data-node=\"Output\"] .input-port-walk, .node-output .input-port:nth-child(2), [data-input=\"Walk\"]'); if(outInPort) outInPort.click(); }, 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.connectionCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections.some(c => c.from === 'Walk')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connections.some(c => c.from === 'Idle')",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.connections)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.normalizedWeights === 'object'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preAdjustWeights = JSON.parse(JSON.stringify(window.__3D_STATE__.normalizedWeights)); const walkSlider = document.querySelector('[data-node=\"Walk\"] input[type=\"range\"], .node-walk input[type=\"range\"]'); if(walkSlider) { walkSlider.value = 0.7; walkSlider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.weights.Walk - 0.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.normalizedWeights.Idle + window.__3D_STATE__.normalizedWeights.Walk - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedWeights.Walk > window.__3D_STATE__.normalizedWeights.Idle",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftLegRotationX >= -30 && window.__3D_STATE__.leftLegRotationX <= 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.normalizedWeights.Walk === 'number' && !isNaN(window.__3D_STATE__.normalizedWeights.Walk)",
            "tier": "L0"
          }
        ]
      }
    },
    {
