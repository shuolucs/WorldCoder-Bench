  "states": [
    {
      "id": "S0",
      "name": "Initial_AllInactive",
      "conditions": [
        "window.__3D_STATE__.flasks.every(f => f.active === false)",
        "window.__3D_STATE__.flasks.every(f => f.phase === 'colorless')",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.selectedFlask === -1"
      ]
    },
    {
      "id": "S1",
      "name": "FlaskSelected",
      "conditions": [
        "window.__3D_STATE__.selectedFlask >= 0 && window.__3D_STATE__.selectedFlask <= 3"
      ]
    },
    {
      "id": "S2",
      "name": "SingleFlaskOscillating",
      "conditions": [
        "window.__3D_STATE__.flasks.filter(f => f.active).length === 1"
      ]
    },
    {
      "id": "S3",
      "name": "FlaskReachedBlue",
      "conditions": [
        "window.__3D_STATE__.flasks.some(f => f.phase === 'blue' && f.active)"
      ]
    },
    {
      "id": "S4",
      "name": "AllFlasksActive",
      "conditions": [
        "window.__3D_STATE__.allActive === true",
        "window.__3D_STATE__.flasks.every(f => f.active === true)"
      ]
    },
    {
      "id": "S5",
      "name": "ConcentrationModified",
      "conditions": [
        "window.__3D_STATE__.flasks.some(f => f.concentration !== 1.0)"
      ]
    },
    {
      "id": "S6",
      "name": "TemperatureChanged",
      "conditions": [
        "window.__3D_STATE__.temperature !== 25"
      ]
    },
    {
      "id": "S7",
      "name": "MultipleCyclesCompleted",
      "conditions": [
        "window.__3D_STATE__.flasks.some(f => f.totalCycles >= 2)"
      ]
    },
    {
      "id": "S8",
      "name": "AllFlasksStopped",
      "conditions": [
        "window.__3D_STATE__.flasks.every(f => f.active === false)"
      ]
    },
    {
      "id": "S9",
      "name": "FlaskReset",
      "conditions": [
        "window.__3D_STATE__.flasks.some(f => f.totalCycles === 0 && f.active === false && f.phase === 'colorless')"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A1",
        "description": "Click on Flask 1 to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedFlask === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedFlask === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.flasks[0].active === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0].active === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0].phase === 'colorless'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "description": "Press SPACE to activate selected Flask 1 oscillation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flasks[0].active === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks.filter(f => f.active).length === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.flasks[0].blueAmount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.flasks[0].blueAmount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0].blueAmount >= 0 && window.__3D_STATE__.flasks[0].blueAmount <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 3000,
        "description": "Wait 3 seconds for oscillation to reach blue phase"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flasks[0].active === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0].blueAmount > 0.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.flasks[0].elapsedInCycle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.flasks[0].elapsedInCycle)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flasks[0].effectiveCycleTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseChanges >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
