  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.truckLoaded === true",
        "window.__3D_STATE__.magnetAngle === 0",
        "window.__3D_STATE__.fieldLinesVisible === true",
        "window.__3D_STATE__.gridArrowsVisible === true",
        "window.__3D_STATE__.secondMagnetActive === false",
        "window.__3D_STATE__.activePlane === 'XZ'",
        "window.__3D_STATE__.particlesAnimating === false"
      ]
    },
    {
      "id": "S1",
      "name": "MagnetRotated",
      "conditions": [
        "window.__3D_STATE__.magnetAngle === 90"
      ]
    },
    {
      "id": "S2",
      "name": "FieldLinesHidden",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === false"
      ]
    },
    {
      "id": "S3",
      "name": "GridArrowsHidden",
      "conditions": [
        "window.__3D_STATE__.gridArrowsVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "TruckMoved",
      "conditions": [
        "window.__3D_STATE__.truckPosition.x !== 8 || window.__3D_STATE__.truckPosition.z !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "SecondMagnetActive",
      "conditions": [
        "window.__3D_STATE__.secondMagnetActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "PlaneChanged",
      "conditions": [
        "window.__3D_STATE__.activePlane === 'XY'"
      ]
    },
    {
      "id": "S7",
      "name": "ParticlesAnimating",
      "conditions": [
        "window.__3D_STATE__.particlesAnimating === true",
        "window.__3D_STATE__.particleCount === 50"
      ]
    },
    {
      "id": "S8",
      "name": "TruckNearMagnet",
      "conditions": [
        "window.__3D_STATE__.fieldStrengthAtProbe > 0.1"
      ]
    },
    {
      "id": "S9",
      "name": "SecondMagnetRemoved",
      "conditions": [
        "window.__3D_STATE__.secondMagnetActive === false",
        "window.__3D_STATE__.secondMagnetPosition === null"
      ]
    }
  ],
