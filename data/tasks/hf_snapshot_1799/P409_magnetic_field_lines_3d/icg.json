{
  "task_id": "P409_magnetic_field_lines_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "BarMagnet",
      "type": "3d_object",
      "semantic": "Primary bar magnet at origin with N (red) and S (blue) poles",
      "locator_hints": [
        "scene.getObjectByName('barMagnet')",
        "red and blue box pair at origin"
      ]
    },
    {
      "id": "A2",
      "name": "FieldLines",
      "type": "3d_object",
      "semantic": "16 tube geometry curves showing magnetic field lines",
      "locator_hints": [
        "scene.getObjectByName('fieldLines')",
        "group of curved tubes"
      ]
    },
    {
      "id": "A3",
      "name": "GridArrows",
      "type": "3d_object",
      "semantic": "10x10 grid of arrows showing field direction and magnitude",
      "locator_hints": [
        "scene.getObjectByName('gridArrows')",
        "arrow grid on plane"
      ]
    },
    {
      "id": "A4",
      "name": "ProbeTruck",
      "type": "3d_object",
      "semantic": "CesiumMilkTruck GLB model used as field probe vehicle",
      "locator_hints": [
        "scene.getObjectByName('probeTruck')",
        "GLTF loaded truck model"
      ]
    },
    {
      "id": "A5",
      "name": "MagnetRotationSlider",
      "type": "dom_element",
      "semantic": "Slider to rotate the bar magnet 0-360 degrees",
      "locator_hints": [
        "#magnet-rotation-slider"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleFieldLinesButton",
      "type": "dom_element",
