          },
          {
            "expr": "typeof window.__3D_STATE__.magnetAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.fieldStrengthAtProbe === 'number'",
            "tier": "L0"
          },
