      "locator_hints": [
        "top-left panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.activeRouteIndex === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isAutoRotating === false",
        "window.__3D_STATE__.numRoutesVisible === 4"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.truckAtAirport === 'JFK'"
      ]
    },
    {
      "id": "S2",
      "name": "Route2Selected",
      "conditions": [
        "window.__3D_STATE__.activeRouteIndex === 2",
        "window.__3D_STATE__.activeRouteName === 'LHR → NRT'"
      ]
    },
    {
      "id": "S3",
      "name": "FlightPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "FlightResumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.isAutoRotating === true"
      ]
    },
    {
      "id": "S6",
      "name": "AutoRotationStopped",
      "conditions": [
        "window.__3D_STATE__.isAutoRotating === false"
      ]
    },
    {
      "id": "S7",
      "name": "TruckTeleported",
      "conditions": [
        "window.__3D_STATE__.truckAtAirport !== 'JFK'"
      ]
    },
    {
      "id": "S8",
      "name": "Route3Selected",
      "conditions": [
        "window.__3D_STATE__.activeRouteIndex === 3",
        "window.__3D_STATE__.activeRouteName === 'NRT → SYD'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.JFK !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.LAX !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.LHR !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.NRT !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.globeRadius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeRouteIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
