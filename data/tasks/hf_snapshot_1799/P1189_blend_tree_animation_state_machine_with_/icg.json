  "states": [
    {
      "id": "S0",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.currentState === 'idle'",
        "window.__3D_STATE__.blendFactor === 1.0",
        "window.__3D_STATE__.isBlending === false",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.isGrounded === true"
      ]
    },
    {
      "id": "S1",
      "name": "WalkState",
      "conditions": [
        "window.__3D_STATE__.currentState === 'walk'",
        "window.__3D_STATE__.blendFactor === 1.0",
        "window.__3D_STATE__.isBlending === false"
      ]
    },
    {
      "id": "S2",
      "name": "RunState",
      "conditions": [
        "window.__3D_STATE__.currentState === 'run'",
        "window.__3D_STATE__.blendFactor === 1.0",
        "window.__3D_STATE__.isBlending === false"
      ]
    },
    {
      "id": "S3",
      "name": "JumpFromWalk",
      "conditions": [
        "window.__3D_STATE__.currentState === 'jump'",
        "window.__3D_STATE__.previousState === 'walk'",
        "window.__3D_STATE__.isGrounded === false"
      ]
    },
    {
      "id": "S4",
      "name": "DebugOn",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "SlowMotion",
      "conditions": [
        "window.__3D_STATE__.timeScale === 0.25"
      ]
    },
    {
      "id": "S6",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStack.length > 0"
      ]
    },
    {
      "id": "S7",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStack.length === 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentState === 'idle'",
        "window.__3D_STATE__.characterPosition.x === 0",
        "window.__3D_STATE__.characterPosition.z === 0"
      ]
    },
    {
      "id": "S9",
      "name": "BlendingInProgress",
      "conditions": [
        "window.__3D_STATE__.isBlending === true",
        "window.__3D_STATE__.blendFactor > 0.0",
        "window.__3D_STATE__.blendFactor < 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "JumpAscending",
      "conditions": [
        "window.__3D_STATE__.jumpPhase === 'ascending'",
        "window.__3D_STATE__.isGrounded === false"
      ]
    },
    {
      "id": "S11",
      "name": "JumpDescending",
      "conditions": [
        "window.__3D_STATE__.jumpPhase === 'descending'",
        "window.__3D_STATE__.isGrounded === false"
      ]
    }
  ],
