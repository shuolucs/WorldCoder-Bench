          {
            "expr": "Math.abs(window.__3D_STATE__.snowThreshold - 0.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windStrength === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vertexDisplacementMax === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('snowAmountSlider').value === '0' && document.getElementById('windStrengthSlider').value === '0'",
            "tier": "L2"
          }
        ]
      }
    },
    {
