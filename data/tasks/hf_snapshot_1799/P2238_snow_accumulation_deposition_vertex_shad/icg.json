        "PlaneGeometry 20x20"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedNoSnow",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.snowAmount === 0",
        "window.__3D_STATE__.snowThreshold === 0.3",
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "PartialSnow",
      "conditions": [
        "window.__3D_STATE__.snowAmount > 0 && window.__3D_STATE__.snowAmount < 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "FullSnow",
      "conditions": [
        "window.__3D_STATE__.snowAmount === 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "WindActive",
      "conditions": [
        "window.__3D_STATE__.windStrength > 0 && window.__3D_STATE__.windDirection !== 'None'"
      ]
    },
    {
      "id": "S4",
      "name": "BlizzardRunning",
      "conditions": [
        "window.__3D_STATE__.blizzardActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "BlizzardComplete",
      "conditions": [
        "window.__3D_STATE__.blizzardActive === false && window.__3D_STATE__.snowAmount === 1.0 && window.__3D_STATE__.windStrength === 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.snowAmount === 0 && window.__3D_STATE__.snowThreshold === 0.3 && window.__3D_STATE__.windStrength === 0 && window.__3D_STATE__.windDirection === 'None'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsApplied === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 3000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowAmount === 0 && window.__3D_STATE__.vertexDisplacementMax === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('snowAmountSlider').value = 50; document.getElementById('snowAmountSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.snowAmount - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vertexDisplacementMax - 0.075) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowCoverage > 0 && window.__3D_STATE__.snowCoverage <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowCoverage === Math.min(100, Math.max(0, Math.round(window.__3D_STATE__.snowAmount * (1.0 - window.__3D_STATE__.snowThreshold) * 100)))",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('snowCoverageDisplay').textContent.includes('%')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('snowThresholdSlider').value = 70; document.getElementById('snowThresholdSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.snowThreshold - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowAmount === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowCoverage === Math.min(100, Math.max(0, Math.round(0.5 * (1.0 - 0.7) * 100)))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowCoverage <= 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vertexDisplacementMax - 0.075) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.snowAmount === 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vertexDisplacementMax - 0.15) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('snowAmountSlider').value === '100'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowCoverage > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.snowCoverage) && window.__3D_STATE__.snowCoverage <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('windDirectionSelect').value = 'East'; document.getElementById('windDirectionSelect').dispatchEvent(new Event('change')); document.getElementById('windStrengthSlider').value = 60; document.getElementById('windStrengthSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windDirection === 'East'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windStrength - 0.6) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.windVector) && window.__3D_STATE__.windVector.length === 2",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windVector[0] === 1 && window.__3D_STATE__.windVector[1] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsApplied === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
