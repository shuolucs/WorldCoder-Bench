      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 30",
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "Stork_Loaded",
      "conditions": [
        "window.__3D_STATE__.storkLoaded === true",
        "window.__3D_STATE__.nodeCount === 30"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.iterationCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S4",
      "name": "Debug_Overlay_On",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "Debug_Overlay_Off",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "Node_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex >= 0"
      ]
    },
    {
      "id": "S7",
      "name": "Cluster_Highlighted",
      "conditions": [
        "window.__3D_STATE__.highlightedCluster > 0"
      ]
    },
    {
      "id": "S8",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.iterationCount < 5",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    }
  ],
