{
  "task_id": "P237_bowling_game_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "BowlingBall",
      "type": "3d_object",
      "semantic": "Dark blue bowling ball that can be aimed and launched",
      "locator_hints": [
        "sphere at z=8",
        "radius 0.3"
      ]
    },
    {
      "id": "A2",
      "name": "BowlingPins",
      "type": "3d_object",
      "semantic": "10 white cylindrical pins in triangle formation",
      "locator_hints": [
        "cylinders near z=-8 to z=-10"
      ]
    },
    {
      "id": "A3",
      "name": "BowlingLane",
      "type": "3d_object",
      "semantic": "Brown rectangular lane surface",
      "locator_hints": [
        "box at y=-0.1"
      ]
    },
    {
      "id": "A4",
      "name": "AntiqueCamera",
      "type": "3d_object",
      "semantic": "Loaded GLB model as decorative replay camera",
      "locator_hints": [
        "position (4, 1, 5)",
        "scaled 0.5"
      ]
    },
    {
      "id": "A5",
      "name": "SlowMoButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 0.25",
      "locator_hints": [
        "#btn-slowmo"
      ]
    },
    {
      "id": "A6",
      "name": "NormalButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 1.0",
      "locator_hints": [
        "#btn-normal"
      ]
    },
    {
      "id": "A7",
      "name": "FastFwdButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 3.0",
      "locator_hints": [
        "#btn-fastfwd"
      ]
    },
    {
      "id": "A8",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 0.0",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets ball and pins",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Displays score, power, aim, phase, timescale",
      "locator_hints": [
        "#hud-score",
        "#hud-power",
        "#hud-aim",
        "#hud-phase",
        "#hud-timescale"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Aiming",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.ballLaunched === false",
        "window.__3D_STATE__.pinsRemaining === 10",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "Aim_Adjusted_Right",
      "conditions": [
        "window.__3D_STATE__.aimValue > 0",
        "window.__3D_STATE__.phase === 'aiming'"
      ]
    },
    {
      "id": "S2",
      "name": "Power_Increased",
      "conditions": [
        "window.__3D_STATE__.power > 5",
        "window.__3D_STATE__.phase === 'aiming'"
      ]
    },
    {
      "id": "S3",
      "name": "Ball_Rolling",
      "conditions": [
        "window.__3D_STATE__.ballLaunched === true",
        "window.__3D_STATE__.phase === 'rolling'",
        "window.__3D_STATE__.ballVelocity.z < 0"
      ]
    },
    {
      "id": "S4",
      "name": "SlowMotion_Active",
      "conditions": [
        "window.__3D_STATE__.timeScale === 0.25",
        "window.__3D_STATE__.phase === 'rolling'"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.timeScale === 0.0"
      ]
    },
    {
      "id": "S6",
      "name": "FastForward_Active",
      "conditions": [
        "window.__3D_STATE__.timeScale === 3.0"
      ]
    },
    {
      "id": "S7",
      "name": "Pins_Knocked",
      "conditions": [
        "window.__3D_STATE__.pinsKnocked > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Ball_Finished",
      "conditions": [
        "window.__3D_STATE__.phase === 'finished'"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.ballLaunched === false",
        "window.__3D_STATE__.pinsRemaining === 10"
      ]
    }
  ],
  "transitions": [
