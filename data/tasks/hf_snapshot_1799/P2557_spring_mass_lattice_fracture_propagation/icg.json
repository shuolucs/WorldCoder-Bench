      "id": "S5",
      "name": "FractureActive",
      "conditions": [
        "window.__3D_STATE__.fracturedSpringCount > 0",
        "window.__3D_STATE__.activeSpringCount < window.__3D_STATE__.initialSpringCount"
      ]
    },
    {
      "id": "S6",
      "name": "PostExplosion",
      "conditions": [
