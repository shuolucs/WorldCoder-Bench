{
  "task_id": "P317_real_time_audio_spectrum_3d_with_dynamic",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumBars",
      "type": "3d_object",
      "semantic": "64 frequency bars arranged in a row, height driven by simulated audio",
      "locator_hints": [
        "BoxGeometry bars",
        "children of scene with bar mesh"
      ]
    },
    {
      "id": "A2",
      "name": "EasyButton",
      "type": "dom_element",
      "semantic": "Button to switch to easy difficulty",
      "locator_hints": [
        "#btn-easy"
      ]
    },
    {
      "id": "A3",
      "name": "MediumButton",
      "type": "dom_element",
      "semantic": "Button to switch to medium difficulty",
      "locator_hints": [
        "#btn-medium"
      ]
    },
    {
      "id": "A4",
      "name": "HardButton",
      "type": "dom_element",
      "semantic": "Button to switch to hard difficulty",
      "locator_hints": [
        "#btn-hard"
      ]
    },
    {
      "id": "A5",
      "name": "CameraToggleButton",
      "type": "dom_element",
      "semantic": "Button to toggle camera mode",
      "locator_hints": [
        "#btn-camera-toggle"
      ]
    },
    {
      "id": "A6",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume animation",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A7",
      "name": "HUDDifficulty",
      "type": "dom_element",
      "semantic": "Text showing current difficulty",
      "locator_hints": [
        "#hud-difficulty"
      ]
    },
    {
      "id": "A8",
      "name": "HUDCamera",
      "type": "dom_element",
      "semantic": "Text showing current camera mode",
      "locator_hints": [
        "#hud-camera"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEasyStatic",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.cameraMode === 'static'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.barCount === 64"
      ]
    },
    {
      "id": "S1",
      "name": "MediumMode",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'medium'",
        "window.__3D_STATE__.frequencyMultiplier === 2.5",
        "window.__3D_STATE__.lerpFactor === 0.1"
      ]
    },
    {
      "id": "S2",
      "name": "HardMode",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.frequencyMultiplier === 5.0",
        "window.__3D_STATE__.barsRotating === true"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "OrbitCamera",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'orbit'"
      ]
    },
    {
      "id": "S5",
      "name": "ResumedEasy",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.difficulty === 'easy'"
      ]
    },
    {
      "id": "S6",
      "name": "BackToEasy",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.frequencyMultiplier === 1.0",
        "window.__3D_STATE__.barsRotating === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Easy !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Medium !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Hard !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Title !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-medium"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-difficulty').textContent.toLowerCase().includes('medium')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-difficulty').textContent.toLowerCase().includes('hard')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('btn-pause').textContent.toLowerCase().includes('resume')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const t1 = window.__3D_STATE__.elapsedTime; await new Promise(r => setTimeout(r, 1000)); return window.__3D_STATE__.elapsedTime === t1;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-pause').click(); await new Promise(r => setTimeout(r, 200)); document.getElementById('btn-camera-toggle').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-camera').textContent.toLowerCase().includes('orbit')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-pause').textContent.toLowerCase().includes('pause')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Easy !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Medium !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Hard !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Title !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c'})); await new Promise(r => setTimeout(r, 200)); document.dispatchEvent(new KeyboardEvent('keydown', {key: '1'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}