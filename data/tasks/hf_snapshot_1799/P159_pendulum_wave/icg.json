      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "button with text Reset"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed",
      "locator_hints": [
