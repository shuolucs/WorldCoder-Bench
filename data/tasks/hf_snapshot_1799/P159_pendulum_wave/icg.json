      ]
    },
    {
      "id": "A7",
      "name": "PhaseDisplay",
      "type": "dom_element",
      "semantic": "Shows phase alignment status",
      "locator_hints": [
        "text containing 'Phase:'"
      ]
    },
    {
      "id": "A8",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane at y=-2",
      "locator_hints": [
        "plane at y=-2"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.pendulumCount === 15"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0",
        "window.__3D_STATE__.running === true"
      ]
    },
    {
      "id": "S4",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.resetCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "RunningAfterReset",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.resetCount > 0",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AdvancedTime",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.elapsedTime > 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxAngle === 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.length === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lengths.length === 15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.angles[0] - 0.4) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => !isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => Math.abs(a) <= 0.41)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lengths[0] > window.__3D_STATE__.lengths[14]",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lengths[0] - 9.81 * Math.pow(60/(15*2*Math.PI), 2)) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => !isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => Math.abs(a) <= 0.41)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "(() => { window.__pausedTime = window.__3D_STATE__.elapsedTime; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === window.__pausedTime",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.angles[0] - 0.4) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.angles[14] - 0.4) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => !isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angles.every(a => Math.abs(a) <= 0.41)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
