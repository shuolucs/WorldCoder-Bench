{
  "task_id": "P159_pendulum_wave",
  "affordances": [
    {
      "id": "A1",
      "name": "SupportBar",
      "type": "3d_object",
      "semantic": "Horizontal bar from which pendulums hang",
      "locator_hints": [
        "box at y=10",
        "dark gray bar"
      ]
    },
    {
      "id": "A2",
      "name": "PendulumBobs",
      "type": "3d_object",
      "semantic": "15 colored spheres swinging as pendulums",
      "locator_hints": [
        "sphere radius 0.3",
        "rainbow colored"
      ]
    },
    {
      "id": "A3",
      "name": "StartPauseButton",
      "type": "dom_element",
      "semantic": "Button to start/pause simulation",
      "locator_hints": [
