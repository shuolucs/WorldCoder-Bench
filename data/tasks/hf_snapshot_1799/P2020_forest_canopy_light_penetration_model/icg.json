{
  "task_id": "P2020_forest_canopy_light_penetration_model",
  "affordances": [
    {
      "id": "A1",
      "name": "GroundSensorGrid",
      "type": "3d_object",
      "semantic": "10x10 grid of ground patches that measure and visualize light intensity",
      "locator_hints": [
        "ground plane",
        "sensor patches",
        "100 patches"
      ]
    },
    {
      "id": "A2",
      "name": "CanopyLayer1",
      "type": "3d_object",
      "semantic": "Top canopy layer at y=30 with LAI=2.0",
      "locator_hints": [
        "layer 1",
        "top canopy",
        "y=30"
      ]
    },
    {
      "id": "A3",
      "name": "CanopyLayer2",
      "type": "3d_object",
      "semantic": "Middle canopy layer at y=20 with LAI=1.5",
      "locator_hints": [
        "layer 2",
        "middle canopy",
        "y=20"
      ]
    },
    {
      "id": "A4",
      "name": "CanopyLayer3",
      "type": "3d_object",
      "semantic": "Bottom canopy layer at y=10 with LAI=1.0",
      "locator_hints": [
        "layer 3",
        "bottom canopy",
        "y=10"
      ]
    },
    {
      "id": "A5",
      "name": "SunLight",
      "type": "3d_object",
      "semantic": "Directional light representing the sun",
      "locator_hints": [
        "directional light",
        "sun"
      ]
    },
    {
      "id": "A6",
      "name": "ElevationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling sun elevation angle",
      "locator_hints": [
        "#elevationSlider"
      ]
    },
    {
      "id": "A7",
      "name": "ExtinctionSlider",
      "type": "dom_element",
      "semantic": "Slider controlling extinction coefficient k",
      "locator_hints": [
        "#kSlider"
      ]
    },
    {
      "id": "A8",
      "name": "Layer1Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable canopy layer 1",
      "locator_hints": [
        "#layer1Toggle"
      ]
    },
    {
      "id": "A9",
      "name": "Layer2Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable canopy layer 2",
      "locator_hints": [
        "#layer2Toggle"
      ]
    },
    {
      "id": "A10",
      "name": "Layer3Toggle",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable canopy layer 3",
      "locator_hints": [
        "#layer3Toggle"
      ]
    },
    {
      "id": "A11",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A12",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation metrics",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.sunElevation === 60",
        "window.__3D_STATE__.extinctionK === 0.5",
        "window.__3D_STATE__.layersActive[0] === true && window.__3D_STATE__.layersActive[1] === true && window.__3D_STATE__.layersActive[2] === true",
        "window.__3D_STATE__.cameraMode === 'perspective'",
        "window.__3D_STATE__.heatmapMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "LowSunElevation",
      "conditions": [
        "window.__3D_STATE__.sunElevation === 20",
        "window.__3D_STATE__.effectiveLAI > window.__3D_STATE__.cumulativeLAI"
      ]
    },
    {
      "id": "S2",
      "name": "HighExtinction",
      "conditions": [
        "window.__3D_STATE__.extinctionK === 0.9",
        "window.__3D_STATE__.avgGroundIrradiance < 0.05"
      ]
    },
    {
      "id": "S3",
      "name": "Layer1Disabled",
      "conditions": [
        "window.__3D_STATE__.layersActive[0] === false",
        "window.__3D_STATE__.activeLayerCount === 2"
      ]
    },
    {
      "id": "S4",
      "name": "AllLayersDisabled",
      "conditions": [
        "window.__3D_STATE__.layersActive[0] === false && window.__3D_STATE__.layersActive[1] === false && window.__3D_STATE__.layersActive[2] === false",
        "window.__3D_STATE__.activeLayerCount === 0"
      ]
    },
    {
      "id": "S5",
      "name": "TopDownView",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'orthographic'"
      ]
    },
    {
      "id": "S6",
      "name": "HeatmapActive",
      "conditions": [
        "window.__3D_STATE__.heatmapMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.sunElevation === 60",
        "window.__3D_STATE__.extinctionK === 0.5",
        "window.__3D_STATE__.activeLayerCount === 3"
      ]
    },
    {
      "id": "S8",
      "name": "HighSunMaxTransmittance",
      "conditions": [
        "window.__3D_STATE__.sunElevation === 90",
        "window.__3D_STATE__.effectiveLAI <= window.__3D_STATE__.cumulativeLAI + 0.01"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.patchCount === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundPatchesExist === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canopyLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.patchIntensities) && window.__3D_STATE__.patchIntensities.length === 100",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cumulativeLAI === 4.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.effectiveLAI - (4.5 / Math.sin(60 * Math.PI / 180))) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance > 0 && window.__3D_STATE__.avgGroundIrradiance < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmittancePct - window.__3D_STATE__.avgGroundIrradiance * 100) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLightEnergy >= 0 && !isNaN(window.__3D_STATE__.totalLightEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('elevationSlider').value = 20; document.getElementById('elevationSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunElevation === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.effectiveLAI > window.__3D_STATE__.cumulativeLAI",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.effectiveLAI - (window.__3D_STATE__.cumulativeLAI / Math.sin(20 * Math.PI / 180))) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance < 0.05",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('elevationValue').textContent.includes('20')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('elevationSlider').value = 60; document.getElementById('elevationSlider').dispatchEvent(new Event('input')); document.getElementById('kSlider').value = 0.9; document.getElementById('kSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extinctionK === 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunElevation === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transmittancePct < 2.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('kValue').textContent.includes('0.9')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('kSlider').value = 0.5; document.getElementById('kSlider').dispatchEvent(new Event('input')); document.getElementById('layer1Toggle').checked = false; document.getElementById('layer1Toggle').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layersActive[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cumulativeLAI === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance > 0.15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('activeLayers').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('layer2Toggle').checked = false; document.getElementById('layer2Toggle').dispatchEvent(new Event('change')); document.getElementById('layer3Toggle').checked = false; document.getElementById('layer3Toggle').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cumulativeLAI === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance > 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transmittancePct > 90",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalLightEnergy - window.__3D_STATE__.patchIntensities.reduce((a,b) => a+b, 0)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraMode === 'orthographic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance > 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatmapMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraMode === 'orthographic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundPatchesExist === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patchIntensities.every(v => !isNaN(v) && v >= 0 && v <= 1.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunElevation === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.extinctionK === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cumulativeLAI === 4.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layersActive[0] === true && window.__3D_STATE__.layersActive[1] === true && window.__3D_STATE__.layersActive[2] === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('elevationSlider').value = 90; document.getElementById('elevationSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunElevation === 90",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.effectiveLAI - window.__3D_STATE__.cumulativeLAI) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgGroundIrradiance > 0.08 && window.__3D_STATE__.avgGroundIrradiance < 0.20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmittancePct - window.__3D_STATE__.avgGroundIrradiance * 100) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLightEnergy >= 0 && !isNaN(window.__3D_STATE__.totalLightEnergy)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}