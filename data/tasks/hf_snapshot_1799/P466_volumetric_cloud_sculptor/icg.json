{
  "task_id": "P466_volumetric_cloud_sculptor",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "GLTF helmet model at scene center",
      "locator_hints": [
        "scene.children with gltf",
        "helmet mesh"
      ]
    },
    {
      "id": "A2",
      "name": "CloudPuffs",
      "type": "3d_object",
      "semantic": "Array of 30 semi-transparent sphere cloud puffs",
      "locator_hints": [
        "cloudPuffs array",
        "sphere geometry meshes"
      ]
    },
    {
      "id": "A3",
      "name": "CarveButton",
      "type": "dom_element",
      "semantic": "Carve tool button",
      "locator_hints": [
        "#btn-carve"
      ]
    },
    {
      "id": "A4",
      "name": "InflateButton",
      "type": "dom_element",
      "semantic": "Inflate tool button",
      "locator_hints": [
        "#btn-inflate"
      ]
    },
    {
      "id": "A5",
      "name": "PaintButton",
      "type": "dom_element",
      "semantic": "Paint tool button",
      "locator_hints": [
        "#btn-paint"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset tool button",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "BrushSizeSlider",
      "type": "dom_element",
      "semantic": "Brush radius slider",
      "locator_hints": [
        "#brush-size"
      ]
    },
    {
      "id": "A8",
      "name": "ColorPicker",
      "type": "dom_element",
      "semantic": "Color picker for paint tool",
      "locator_hints": [
        "#color-picker"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === false || window.__3D_STATE__.frameCount < 2"
      ]
    },
    {
      "id": "S1",
      "name": "Scene_Ready",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.totalPuffs === 30",
        "window.__3D_STATE__.visiblePuffs === 30",
        "window.__3D_STATE__.activeTool === 'carve'"
      ]
    },
    {
      "id": "S2",
      "name": "Inflate_Tool_Active",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'inflate'"
      ]
    },
    {
      "id": "S3",
      "name": "Cloud_Carved",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'carve'",
        "window.__3D_STATE__.sculptedPuffs > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Paint_Tool_Active",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'paint'"
      ]
    },
    {
      "id": "S5",
      "name": "Brush_Size_Changed",
      "conditions": [
        "window.__3D_STATE__.brushSize !== 2.5"
      ]
    },
    {
      "id": "S6",
      "name": "Helmet_Hidden",
      "conditions": [
        "window.__3D_STATE__.helmetVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Helmet_Rotated",
      "conditions": [
        "window.__3D_STATE__.helmetRotationY > 1.4"
      ]
    },
    {
      "id": "S8",
      "name": "Clouds_Reset",
      "conditions": [
        "window.__3D_STATE__.visiblePuffs === 30",
        "window.__3D_STATE__.sculptedPuffs === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Animation_Running",
      "conditions": [
        "window.__3D_STATE__.frameCount > 60"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTool === 'carve'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-inflate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'inflate'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'carve'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushSize === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-paint"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'paint'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paintColor !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.paintColor === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('brush-size').value = 4; document.getElementById('brush-size').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.brushSize === 4 || window.__3D_STATE__.brushSize === '4'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTool === 'paint'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.helmetVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.helmetVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S1",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.helmetRotationY >= 1.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.helmetRotationY <= 1.7",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.helmetRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visiblePuffs === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sculptedPuffs === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPuffs === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudPositionsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDensity > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalDensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePuffs === 30",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}