{
  "task_id": "P142_multi_model_scene",
  "affordances": [
    {
      "id": "A1",
      "name": "ferrari",
      "type": "3d_object",
      "semantic": "GLB 模型 ferrari.glb",
      "locator_hints": [
        "ferrari"
      ]
    },
    {
      "id": "A2",
      "name": "robot",
      "type": "3d_object",
      "semantic": "GLB 模型 robot.glb",
      "locator_hints": [
        "robot"
      ]
    },
    {
      "id": "A3",
      "name": "Duck",
      "type": "3d_object",
      "semantic": "GLB 模型 Duck.glb",
      "locator_hints": [
        "duck"
      ]
    },
    {
      "id": "A4",
      "name": "Lantern",
      "type": "3d_object",
      "semantic": "GLB 模型 Lantern.glb",
      "locator_hints": [
        "lantern"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型预加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "所有模型加载完成"
    },
    {
      "id": "S2",
      "name": "placed",
      "description": "放置了一个模型"
    },
    {
      "id": "S3",
      "name": "selected",
      "description": "选中了一个对象"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.objectCount === 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gridSnap !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelsLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const btns=document.querySelectorAll(\"#palette button\"); if(btns.length>0) btns[0].click(); setTimeout(()=>{ document.querySelector(\"canvas\").dispatchEvent(new MouseEvent(\"click\",{clientX:400,clientY:400,bubbles:true})); },500); })()",
        "wait_ms": 1500
      },
      "postconditions": [
        "window.__3D_STATE__.objectCount >= 0"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectCount !== before.objectCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectCount === 'number' && !isNaN(window.__3D_STATE__.objectCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCount === 'number' && !isNaN(window.__3D_STATE__.selectedCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelsLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}