{
  "task_id": "P322_supply_chain_flow_with_save_load_state",
  "affordances": [
    {
      "id": "A1",
      "name": "ShipmentCar",
      "type": "3d_object",
      "semantic": "Toy car model representing a shipment moving between supply chain stations",
      "locator_hints": [
        "ToyCar GLB model",
        "mesh at y≈0.3"
      ]
    },
    {
      "id": "A2",
      "name": "SupplierStation",
      "type": "3d_object",
      "semantic": "Red box at x=-10 representing the supplier node",
      "locator_hints": [
        "box mesh at (-10, 0.5, 0)",
        "color #e94560"
      ]
    },
    {
      "id": "A3",
      "name": "WarehouseStation",
      "type": "3d_object",
      "semantic": "Blue box at x=0 representing the warehouse node",
      "locator_hints": [
        "box mesh at (0, 0.5, 0)",
        "color #0f3460"
      ]
    },
    {
      "id": "A4",
      "name": "RetailerStation",
      "type": "3d_object",
      "semantic": "Purple box at x=10 representing the retailer node",
      "locator_hints": [
        "box mesh at (10, 0.5, 0)",
        "color #533483"
      ]
    },
    {
      "id": "A5",
      "name": "ShipButton",
      "type": "dom_element",
      "semantic": "Button to trigger shipment from current station to next",
      "locator_hints": [
        "#shipBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset car to supplier",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state to localStorage",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A8",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load state from localStorage",
      "locator_hints": [
        "#loadBtn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.stationCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "CarAtSupplier",
      "conditions": [
        "window.__3D_STATE__.currentSegment === 0",
        "Math.abs(window.__3D_STATE__.carPositionX - (-10)) < 0.5",
        "window.__3D_STATE__.isMoving === false"
      ]
    },
    {
      "id": "S2",
      "name": "CarAtWarehouse",
      "conditions": [
        "window.__3D_STATE__.currentSegment === 1",
        "Math.abs(window.__3D_STATE__.carPositionX - 0) < 0.5",
        "window.__3D_STATE__.isMoving === false"
      ]
    },
    {
      "id": "S3",
      "name": "CarAtRetailer",
      "conditions": [
        "window.__3D_STATE__.currentSegment === 2",
        "Math.abs(window.__3D_STATE__.carPositionX - 10) < 0.5",
        "window.__3D_STATE__.isMoving === false"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.stateSaved === true"
      ]
    },
    {
      "id": "S5",
      "name": "StateLoadedAtSupplier",
      "conditions": [
        "window.__3D_STATE__.stateLoaded === true",
        "window.__3D_STATE__.currentSegment === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#shipBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#shipBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
