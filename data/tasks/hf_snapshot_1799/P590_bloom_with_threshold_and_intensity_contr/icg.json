  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.bloomEnabled === true",
        "window.__3D_STATE__.threshold === 0.5",
        "window.__3D_STATE__.strength === 1.0",
        "window.__3D_STATE__.radius === 0.4",
        "window.__3D_STATE__.sphereCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "ThresholdAdjusted",
      "conditions": [
        "window.__3D_STATE__.threshold !== 0.5",
        "window.__3D_STATE__.bloomEnabled === true"
      ]
    },
    {
      "id": "S2",
      "name": "IntensityAdjusted",
      "conditions": [
        "window.__3D_STATE__.strength !== 1.0",
        "window.__3D_STATE__.bloomEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "BloomDisabled",
      "conditions": [
        "window.__3D_STATE__.bloomEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "BloomReEnabled",
      "conditions": [
        "window.__3D_STATE__.bloomEnabled === true",
        "window.__3D_STATE__.composerActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "SubtlePreset",
      "conditions": [
        "window.__3D_STATE__.threshold === 0.8",
        "window.__3D_STATE__.strength === 0.3",
        "window.__3D_STATE__.radius === 0.2"
      ]
    },
    {
      "id": "S6",
      "name": "IntensePreset",
      "conditions": [
        "window.__3D_STATE__.threshold === 0.1",
        "window.__3D_STATE__.strength === 2.5",
        "window.__3D_STATE__.radius === 0.8"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.threshold === 0.5",
        "window.__3D_STATE__.strength === 1.0",
        "window.__3D_STATE__.radius === 0.4"
      ]
    },
    {
      "id": "S8",
      "name": "KeyboardThresholdUp",
      "conditions": [
        "window.__3D_STATE__.threshold === 0.6",
        "window.__3D_STATE__.lastAction === 'key_threshold_up'"
      ]
    },
    {
      "id": "S9",
      "name": "KeyboardIntensityUp",
      "conditions": [
        "window.__3D_STATE__.strength === 1.5",
        "window.__3D_STATE__.lastAction === 'key_intensity_up'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bloomPassExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderPassExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('thresholdSlider').value = 0.75; document.getElementById('thresholdSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.threshold - 0.75) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider_threshold'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bloomEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.threshold)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.threshold >= 0 && window.__3D_STATE__.threshold <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('intensitySlider').value = 2.0; document.getElementById('intensitySlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.strength - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider_intensity'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strength >= 0 && window.__3D_STATE__.strength <= 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.strength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
