          {
            "expr": "window.__3D_STATE__.composerActive === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('bloomToggle').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bloomPassExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
