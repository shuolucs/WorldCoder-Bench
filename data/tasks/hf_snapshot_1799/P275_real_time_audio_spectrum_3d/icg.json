{
  "task_id": "P275_real_time_audio_spectrum_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumBarGroup",
      "type": "3d_object",
      "semantic": "Group of 64 bars visualizing audio spectrum",
      "locator_hints": [
        "scene.children group containing 64 box meshes"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing current state",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A3",
      "name": "ModeDisplay",
      "type": "dom_element",
      "semantic": "Shows current visualization mode",
      "locator_hints": [
        "#hud-mode"
      ]
    },
    {
      "id": "A4",
      "name": "PlayingDisplay",
      "type": "dom_element",
      "semantic": "Shows playing or paused status",
      "locator_hints": [
        "#hud-playing"
      ]
    },
    {
      "id": "A5",
      "name": "GainDisplay",
      "type": "dom_element",
      "semantic": "Shows current gain value",
      "locator_hints": [
        "#hud-gain"
      ]
    },
    {
      "id": "A6",
      "name": "FreqDisplay",
      "type": "dom_element",
      "semantic": "Shows current oscillator frequency",
      "locator_hints": [
        "#hud-freq"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets all parameters to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A8",
      "name": "RotateDisplay",
      "type": "dom_element",
      "semantic": "Shows auto-rotate ON/OFF",
      "locator_hints": [
        "#hud-rotate"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.mode === 'circular'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.gain === 0.3",
        "window.__3D_STATE__.frequency === 220",
        "window.__3D_STATE__.barCount === 64",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.analyserFFTSize === 256"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S2",
      "name": "LinearMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'linear'"
      ]
    },
    {
      "id": "S3",
      "name": "WaveMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'wave'"
      ]
    },
    {
      "id": "S4",
      "name": "GainIncreased",
      "conditions": [
        "window.__3D_STATE__.gain === 0.4"
      ]
    },
    {
      "id": "S5",
      "name": "FrequencyChanged",
      "conditions": [
        "window.__3D_STATE__.frequency === 270"
      ]
    },
    {
      "id": "S6",
      "name": "RotationDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S7",
      "name": "GainDecreased",
      "conditions": [
        "window.__3D_STATE__.gain === 0.0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.mode === 'circular'",
        "window.__3D_STATE__.gain === 0.3",
        "window.__3D_STATE__.frequency === 220",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.isPlaying === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-playing').textContent.includes('Playing')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-mode').textContent.includes('linear')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-mode').textContent.includes('wave')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-gain').textContent.includes('0.4')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-freq').textContent.includes('270')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-rotate').textContent.includes('OFF')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "let ry = window.__3D_STATE__.groupRotationY; return ry;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<5;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));} return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-gain').textContent.includes('0.0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}