{
  "task_id": "P534_sph_dam_break",
  "affordances": [
    {"id": "A1", "name": "Particles", "type": "3d_object", "semantic": "200 SPH fluid particles", "locator_hints": ["InstancedMesh spheres"]},
    {"id": "A2", "name": "Container", "type": "3d_object", "semantic": "Wireframe container box", "locator_hints": ["wireframe box mesh"]},
    {"id": "A3", "name": "DamWall", "type": "3d_object", "semantic": "Removable dam wall", "locator_hints": ["plane or box at x=-2"]},
    {"id": "A4", "name": "ViscositySlider", "type": "dom_element", "semantic": "Viscosity control", "locator_hints": ["#slider-viscosity"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial_DamIntact", "conditions": ["window.__3D_STATE__.damBroken === false", "window.__3D_STATE__.isPaused === true"]},
    {"id": "S1", "name": "Running_DamIntact", "conditions": ["window.__3D_STATE__.isPaused === false", "window.__3D_STATE__.damBroken === false"]},
    {"id": "S2", "name": "DamBroken", "conditions": ["window.__3D_STATE__.damBroken === true"]},
    {"id": "S3", "name": "Flowing", "conditions": ["window.__3D_STATE__.maxVelocity > 0.5"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.damBroken === false"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 200", "tier": "L2"},
        {"expr": "window.__3D_STATE__.damBroken === false", "tier": "L2"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Running')", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "d"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.damBroken === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-dam').textContent.includes('Broken')", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.maxVelocity > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particlesInBounds >= 195", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particleCount === 200", "tier": "L1"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-viscosity').value = 0.5; document.getElementById('slider-viscosity').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.viscosity === 0.5", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.damBroken === false", "tier": "L2"},
        {"expr": "window.__3D_STATE__.particleCount === 200", "tier": "L1"},
        {"expr": "document.getElementById('hud-dam').textContent.includes('Intact')", "tier": "L2"}
      ]}
    }
  ]
}
