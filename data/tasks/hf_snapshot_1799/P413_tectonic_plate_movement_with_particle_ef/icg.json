  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.mode === 'convergent'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.elapsedTime === 0",
        "Math.abs(window.__3D_STATE__.leftPlateX - (-11)) < 0.5",
        "Math.abs(window.__3D_STATE__.rightPlateX - 11) < 0.5"
      ]
    },
    {
      "id": "S1",
      "name": "ConvergentPlaying",
      "conditions": [
        "window.__3D_STATE__.mode === 'convergent'",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "ConvergentCollision",
      "conditions": [
        "window.__3D_STATE__.mode === 'convergent'",
        "window.__3D_STATE__.collisionOccurred === true",
        "window.__3D_STATE__.plateSeparation <= 0.6"
      ]
    },
    {
      "id": "S3",
      "name": "MountainForming",
      "conditions": [
        "window.__3D_STATE__.mode === 'convergent'",
        "window.__3D_STATE__.collisionOccurred === true",
        "window.__3D_STATE__.mountainHeight > 0.5"
      ]
    },
    {
      "id": "S4",
      "name": "DivergentMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'divergent'",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S5",
      "name": "DivergentMagmaVisible",
      "conditions": [
        "window.__3D_STATE__.mode === 'divergent'",
        "window.__3D_STATE__.magmaWidth > 1.0",
        "window.__3D_STATE__.plateSeparation > 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "TransformMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'transform'",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S7",
      "name": "TransformSliding",
      "conditions": [
        "window.__3D_STATE__.mode === 'transform'",
        "Math.abs(window.__3D_STATE__.leftPlateZ) > 1.0 || Math.abs(window.__3D_STATE__.rightPlateZ) > 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.mountainHeight === 0 || window.__3D_STATE__.mountainHeight < 0.1",
        "Math.abs(window.__3D_STATE__.leftPlateX - (-11)) < 0.5"
      ]
    }
  ],
