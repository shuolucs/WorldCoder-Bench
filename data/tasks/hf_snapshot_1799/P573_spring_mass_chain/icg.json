{
  "task_id": "P573_spring_mass_chain",
  "affordances": [
    {"id": "A1", "name": "MassNode", "type": "3d_object", "semantic": "Sphere representing a point mass in the chain, colored by displacement", "locator_hints": ["sphere", "mass", "node"]},
    {"id": "A2", "name": "SpringLine", "type": "3d_object", "semantic": "Line segment connecting adjacent masses, colored by compression/extension", "locator_hints": ["line", "spring", "segment"]},
    {"id": "A3", "name": "HUD", "type": "dom_element", "semantic": "Top-left overlay showing wave speed, energy, mode, and frame count", "locator_hints": ["hud", "overlay"]},
    {"id": "A4", "name": "SliderStiffness", "type": "dom_element", "semantic": "Slider controlling spring stiffness k", "locator_hints": ["slider-stiffness"]},
    {"id": "A5", "name": "SliderMassCount", "type": "dom_element", "semantic": "Slider controlling number of masses N", "locator_hints": ["slider-masscount"]},
    {"id": "A6", "name": "SliderDamping", "type": "dom_element", "semantic": "Slider controlling damping coefficient", "locator_hints": ["slider-damping"]},
    {"id": "A7", "name": "SliderBoundary", "type": "dom_element", "semantic": "Slider toggling fixed/free boundary conditions", "locator_hints": ["slider-boundary"]}
  ],
  "states": [
    {"id": "S0", "name": "initial_idle", "conditions": ["window.__3D_STATE__.mode === 'idle'", "window.__3D_STATE__.maxDisplacement < 0.01"]},
    {"id": "S1", "name": "wave_propagating", "conditions": ["window.__3D_STATE__.maxDisplacement > 0.1", "window.__3D_STATE__.totalEnergy > 0"]},
    {"id": "S2", "name": "stiffness_changed", "conditions": ["window.__3D_STATE__.stiffness !== 40"]},
    {"id": "S3", "name": "boundary_free", "conditions": ["window.__3D_STATE__.boundaryCondition === 'free'"]},
    {"id": "S4", "name": "driven_mode", "conditions": ["window.__3D_STATE__.mode === 'driven'"]}
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
          {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"},
          {"expr": "window.__3D_STATE__.massCount >= 5 && window.__3D_STATE__.massCount <= 50", "tier": "L1"},
          {"expr": "Array.isArray(window.__3D_STATE__.masses) && window.__3D_STATE__.masses.length === window.__3D_STATE__.massCount", "tier": "L1"},
          {"expr": "typeof window.__3D_STATE__.isValid === 'boolean' && window.__3D_STATE__.isValid === true", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.mode === 'pluck'", "tier": "L1"},
          {"expr": "window.__3D_STATE__.maxDisplacement > 0.5", "tier": "L1"},
          {"expr": "window.__3D_STATE__.totalEnergy > 0", "tier": "L1"},
          {"expr": "(function(){ const m = window.__3D_STATE__.masses; return m.some(p => Math.abs(p.y) > 0.1); })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.totalEnergy < before.totalEnergy", "tier": "L1"},
          {"expr": "window.__3D_STATE__.totalEnergy > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount + 30", "tier": "L0"},
          {"expr": "(function(){ const c = window.__3D_STATE__.waveSpeed; return typeof c === 'number' && isFinite(c) && c > 0; })()", "tier": "L1"},
          {"expr": "(function(){ const m = window.__3D_STATE__.masses; return m.every(p => isFinite(p.y) && isFinite(p.vy) && Math.abs(p.y) < 10); })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-stiffness').value = 120; document.getElementById('slider-stiffness').dispatchEvent(new Event('input')); return true;"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.stiffness === 120 || Math.abs(window.__3D_STATE__.stiffness - 120) < 1", "tier": "L2"},
          {"expr": "window.__3D_STATE__.waveSpeed > before.waveSpeed", "tier": "L1"},
          {"expr": "(function(){ const k = window.__3D_STATE__.stiffness; const c = window.__3D_STATE__.waveSpeed; return c > 0 && Math.abs(c - Math.sqrt(k) * 0.8) / c < 0.3; })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-boundary').value = 1; document.getElementById('slider-boundary').dispatchEvent(new Event('input')); return true;"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.boundaryCondition === 'free'", "tier": "L2"},
          {"expr": "window.__3D_STATE__.massCount === before.massCount", "tier": "L1"},
          {"expr": "(function(){ const m = window.__3D_STATE__.masses; return m.every(p => isFinite(p.y) && isFinite(p.vy)); })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {"type": "keyboard", "key": "Enter"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.mode === 'driven'", "tier": "L1"},
          {"expr": "window.__3D_STATE__.driveFrequency > 0", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.maxDisplacement > 0.3", "tier": "L1"},
          {"expr": "window.__3D_STATE__.totalEnergy > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount + 50", "tier": "L0"},
          {"expr": "(function(){ const m = window.__3D_STATE__.masses; return m.every(p => isFinite(p.y) && isFinite(p.vy) && Math.abs(p.y) < 20); })()", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    }
  ]
}
