      ]
    },
    {
      "id": "A7",
      "name": "EnergyLabel",
      "type": "dom_element",
      "semantic": "HUD label showing average energy value",
      "locator_hints": [
        "Average Energy"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.barCount === 64",
        "window.__3D_STATE__.particleCount === 2000",
        "window.__3D_STATE__.isRotating === true",
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.layout === 'circle'",
        "window.__3D_STATE__.sensitivity === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.averageEnergy > 0",
        "!isNaN(window.__3D_STATE__.maxBarHeight)"
      ]
    },
    {
      "id": "S2",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.isRotating === false"
      ]
    },
    {
      "id": "S3",
      "name": "RotationResumed",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ]
    },
    {
      "id": "S4",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ParticlesShown",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "LayoutLine",
      "conditions": [
        "window.__3D_STATE__.layout === 'line'"
      ]
    },
    {
      "id": "S7",
      "name": "LayoutGrid",
      "conditions": [
        "window.__3D_STATE__.layout === 'grid'"
      ]
    },
    {
      "id": "S8",
      "name": "SensitivityChanged",
      "conditions": [
        "window.__3D_STATE__.sensitivity !== 1.0"
      ]
    }
  ],
