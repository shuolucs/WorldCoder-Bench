      ]
    },
    {
      "id": "A11",
      "name": "PlayerCountIndicator",
      "type": "dom_element",
      "semantic": "Shows number of simulated players online",
      "locator_hints": [
        "#player-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'matte_black'",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.wireframeMode === false",
        "window.__3D_STATE__.materialChangeCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.backdropVisible === true",
        "window.__3D_STATE__.headphoneGroupExists === true"
      ]
    },
    {
      "id": "S2",
      "name": "Material_Brushed_Silver",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'brushed_silver'",
        "window.__3D_STATE__.materialChangeCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "Material_Rose_Gold",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'rose_gold'",
        "window.__3D_STATE__.materialChangeCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotate_Disabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S5",
      "name": "Wireframe_Enabled",
      "conditions": [
        "window.__3D_STATE__.wireframeMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "Material_Ocean_Blue_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'ocean_blue'"
      ]
    },
    {
      "id": "S7",
      "name": "Material_Back_To_Matte_Black",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'matte_black'"
      ]
    }
  ],
  "transitions": [
