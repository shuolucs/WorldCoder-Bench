  "states": [
    {
      "id": "S0",
      "name": "Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelReady_Defaults",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.ior === 1.5",
        "window.__3D_STATE__.fresnelPower === 5.0",
        "window.__3D_STATE__.roughness === 0.3"
      ]
    },
    {
      "id": "S2",
      "name": "GlassPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Glass'",
        "Math.abs(window.__3D_STATE__.ior - 1.52) < 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "DiamondPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Diamond'",
        "Math.abs(window.__3D_STATE__.ior - 2.42) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "CustomIOR",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Custom'"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S6",
      "name": "GroundVisible",
      "conditions": [
        "window.__3D_STATE__.groundVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "MetalPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Metal'",
        "Math.abs(window.__3D_STATE__.metalness - 1.0) < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.ior === 1.5",
        "window.__3D_STATE__.fresnelPower === 5.0",
        "window.__3D_STATE__.roughness === 0.3",
        "window.__3D_STATE__.metalness === 0.0"
      ]
    },
    {
      "id": "S9",
      "name": "WaterPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Water'",
        "Math.abs(window.__3D_STATE__.ior - 1.33) < 0.01"
      ]
    }
