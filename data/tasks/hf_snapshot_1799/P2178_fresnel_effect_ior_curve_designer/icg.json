{
  "task_id": "P2178_fresnel_effect_ior_curve_designer",
  "affordances": [
    {
      "id": "A1",
      "name": "FerrariModel",
      "type": "3d_object",
      "semantic": "Loaded ferrari.glb model with custom Fresnel ShaderMaterial applied to all meshes",
      "locator_hints": [
        "window.__3D_STATE__.modelLoaded",
        "window.__3D_STATE__.meshCount > 0"
      ]
    },
    {
      "id": "A2",
      "name": "IORSlider",
      "type": "dom_element",
      "semantic": "Slider controlling Index of Refraction from 1.0 to 3.0",
      "locator_hints": [
        "input[type='range']",
        "IOR slider"
      ]
    },
    {
      "id": "A3",
      "name": "FresnelPowerSlider",
      "type": "dom_element",
      "semantic": "Slider controlling Fresnel exponent power from 0.5 to 10.0",
      "locator_hints": [
        "input[type='range']",
        "Fresnel Power slider"
      ]
    },
    {
      "id": "A4",
      "name": "RoughnessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling surface roughness 0-1",
      "locator_hints": [
        "input[type='range']",
        "Roughness slider"
      ]
    },
    {
      "id": "A5",
      "name": "MetalnessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling metalness 0-1",
      "locator_hints": [
        "input[type='range']",
        "Metalness slider"
      ]
    },
    {
      "id": "A6",
      "name": "PresetDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select material presets (Glass, Water, Diamond, Metal, Plastic, Custom)",
      "locator_hints": [
        "select",
        "Presets dropdown"
      ]
    },
    {
      "id": "A7",
      "name": "CurveCanvas",
