        "window.__3D_STATE__.curveCanvasExists"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "button",
        "Reset"
      ]
    },
    {
      "id": "A9",
      "name": "GroundPlane",
      "type": "3d_object",
