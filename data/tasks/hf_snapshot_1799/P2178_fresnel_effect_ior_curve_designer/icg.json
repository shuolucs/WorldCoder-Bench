            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.f0 === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.f0 - Math.pow((1.5 - 1)/(1.5 + 1), 2)) < 0.001",
            "tier": "L2"
