{
  "task_id": "P300_procedural_network_topology_graph",
  "affordances": [
    {
      "id": "A1",
      "name": "NetworkNodes",
      "type": "3d_object",
      "semantic": "20 sphere nodes representing network devices in 3D space",
      "locator_hints": [
        "SphereGeometry meshes",
        "children of scene with userData.nodeIndex"
      ]
    },
    {
      "id": "A2",
      "name": "NetworkEdges",
      "type": "3d_object",
      "semantic": "Line segments connecting nodes",
      "locator_hints": [
        "LineSegments or Line objects in scene"
      ]
    },
    {
      "id": "A3",
      "name": "ToggleLayoutButton",
      "type": "dom_element",
      "semantic": "Button to toggle between sphere and flat layout",
      "locator_hints": [
        "#toggleLayout"
      ]
    },
    {
      "id": "A4",
      "name": "FilterRouterButton",
      "type": "dom_element",
      "semantic": "Button to toggle router visibility",
      "locator_hints": [
        "#filterRouter"
      ]
    },
    {
      "id": "A5",
      "name": "FilterServerButton",
      "type": "dom_element",
      "semantic": "Button to toggle server visibility",
      "locator_hints": [
        "#filterServer"
      ]
    },
    {
      "id": "A6",
      "name": "FilterClientButton",
      "type": "dom_element",
      "semantic": "Button to toggle client visibility",
      "locator_hints": [
        "#filterClient"
      ]
    },
    {
      "id": "A7",
      "name": "PulseButton",
      "type": "dom_element",
      "semantic": "Button to send pulse through router ring",
      "locator_hints": [
        "#pulseBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUDInfo",
      "type": "dom_element",
      "semantic": "HUD showing visible count and selected node",
      "locator_hints": [
        "#hudInfo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 20",
        "window.__3D_STATE__.edgeCount > 20",
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.layoutMode === 'sphere'",
        "window.__3D_STATE__.visibleNodeCount === 20"
      ]
    },
    {
      "id": "S1",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex >= 0",
        "window.__3D_STATE__.selectedEdgeCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "NodeDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.selectedEdgeCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "FlatLayout",
      "conditions": [
        "window.__3D_STATE__.layoutMode === 'flat'"
      ]
    },
    {
      "id": "S4",
      "name": "SphereLayoutRestored",
      "conditions": [
        "window.__3D_STATE__.layoutMode === 'sphere'"
      ]
    },
    {
      "id": "S5",
      "name": "RoutersHidden",
      "conditions": [
        "window.__3D_STATE__.routerVisible === false",
        "window.__3D_STATE__.visibleNodeCount === 14"
      ]
    },
    {
      "id": "S6",
      "name": "RoutersRestored",
      "conditions": [
        "window.__3D_STATE__.routerVisible === true",
        "window.__3D_STATE__.visibleNodeCount === 20"
      ]
    },
    {
      "id": "S7",
      "name": "PulseActive",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "PulseComplete",
      "conditions": [
        "window.__3D_STATE__.pulseActive === false",
        "window.__3D_STATE__.pulseProgress >= 5.9 || window.__3D_STATE__.pulseProgress === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nodeCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hoveredNodeIndex !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedNodeIndex !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.routerVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const nodes = window.__3D_STATE__.nodesArray; const scene = document.querySelector('canvas'); const event = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); scene.dispatchEvent(event); /* fallback: directly select node 0 */ if(window.__selectNode) window.__selectNode(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nodeCount !== before.nodeCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number' && !isNaN(window.__3D_STATE__.nodeCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeCount === 'number' && !isNaN(window.__3D_STATE__.edgeCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.nodesArray)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
