  "states": [
    {
      "id": "S0",
      "name": "Initial_Scattered",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 0",
        "window.__3D_STATE__.progressPercent === 0",
        "window.__3D_STATE__.referenceModelLoaded === true",
        "window.__3D_STATE__.totalPartsCount === 15"
      ]
    },
    {
      "id": "S1",
      "name": "Fuselage_Mounted",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 1",
        "window.__3D_STATE__.fuselageAssembled === true",
        "window.__3D_STATE__.progressPercent >= 16 && window.__3D_STATE__.progressPercent <= 17"
      ]
    },
    {
      "id": "S2",
      "name": "Arms_Attached",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 2",
        "window.__3D_STATE__.armsAssembled === true",
        "window.__3D_STATE__.progressPercent >= 33 && window.__3D_STATE__.progressPercent <= 34"
      ]
    },
    {
      "id": "S3",
      "name": "Motors_Installed",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 3",
        "window.__3D_STATE__.motorsAssembled === true",
        "window.__3D_STATE__.progressPercent === 50"
      ]
    },
    {
      "id": "S4",
      "name": "Propellers_Attached",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 4",
        "window.__3D_STATE__.propellersAssembled === true",
        "window.__3D_STATE__.progressPercent >= 66 && window.__3D_STATE__.progressPercent <= 67"
      ]
    },
    {
      "id": "S5",
      "name": "Battery_Inserted",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 5",
        "window.__3D_STATE__.batteryAssembled === true",
        "window.__3D_STATE__.progressPercent >= 83 && window.__3D_STATE__.progressPercent <= 84"
      ]
    },
    {
      "id": "S6",
      "name": "Fully_Assembled",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 6",
        "window.__3D_STATE__.cameraAssembled === true",
        "window.__3D_STATE__.progressPercent === 100",
        "window.__3D_STATE__.assembledPartsCount === 15"
      ]
    },
    {
      "id": "S7",
      "name": "Propellers_Spinning",
      "conditions": [
        "window.__3D_STATE__.propellersSpinning === true",
        "window.__3D_STATE__.assemblyStep === 6"
      ]
    },
    {
      "id": "S8",
      "name": "Explode_View_Active",
      "conditions": [
        "window.__3D_STATE__.explodeView === true"
      ]
    },
    {
      "id": "S9",
      "name": "Part_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedPart !== null"
      ]
    },
    {
      "id": "S10",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.assemblyStep === 0",
        "window.__3D_STATE__.progressPercent === 0",
        "window.__3D_STATE__.propellersSpinning === false",
        "window.__3D_STATE__.assembledPartsCount === 0"
      ]
    }
  ],
