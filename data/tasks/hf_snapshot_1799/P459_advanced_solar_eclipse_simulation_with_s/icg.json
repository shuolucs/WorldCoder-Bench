{
  "task_id": "P459_advanced_solar_eclipse_simulation_with_s",
  "affordances": [
    {
      "id": "A1",
      "name": "Sun",
      "type": "3d_object",
      "semantic": "Glowing yellow sphere representing the Sun at (-20,0,0)",
      "locator_hints": [
        "position.x === -20"
      ]
    },
    {
      "id": "A2",
      "name": "Moon",
      "type": "3d_object",
      "semantic": "Dark gray sphere orbiting on elliptical path between Sun and Earth",
      "locator_hints": [
        "radius 0.8",
        "color 0x555555"
      ]
    },
    {
      "id": "A3",
      "name": "Earth",
      "type": "3d_object",
      "semantic": "Blue-green sphere at (20,0,0)",
      "locator_hints": [
        "position.x === 20"
      ]
    },
    {
      "id": "A4",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "GLTF model loaded as space observatory above Earth",
      "locator_hints": [
        "position near (20, 3, 0)",
        "scale 1.5"
      ]
    },
    {
      "id": "A5",
      "name": "CaptureButton",
      "type": "dom_element",
      "semantic": "Button to capture eclipse for scoring",
      "locator_hints": [
        "textContent includes 'Capture'"
      ]
    },
    {
      "id": "A6",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current score",
      "locator_hints": [
        "top-left",
        "textContent includes 'Score'"
      ]
    },
    {
      "id": "A7",
      "name": "IntensityBar",
      "type": "dom_element",
      "semantic": "Eclipse intensity display with colored bar",
      "locator_hints": [
        "top-right",
        "textContent includes 'Intensity'"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Toggleable panel with solar eclipse facts",
      "locator_hints": [
        "hidden by default",
        "eclipse facts"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.capturesTotal === 0",
        "window.__3D_STATE__.lastCaptureResult === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0",
        "window.__3D_STATE__.speedMultiplier >= 0.5",
        "window.__3D_STATE__.speedMultiplier <= 3.0"
      ]
    },
    {
      "id": "S3",
      "name": "EclipseActive",
      "conditions": [
        "window.__3D_STATE__.eclipseIntensity > 0.3"
      ]
    },
    {
      "id": "S4",
      "name": "CapturedDuringEclipse",
      "conditions": [
        "window.__3D_STATE__.capturesTotal > 0",
        "window.__3D_STATE__.capturesSuccessful > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S5",
      "name": "MissedCapture",
      "conditions": [
        "window.__3D_STATE__.capturesTotal > 0",
        "window.__3D_STATE__.lastCaptureResult === 'missed'",
        "window.__3D_STATE__.score < 0"
      ]
    },
    {
      "id": "S6",
      "name": "InfoPanelOpen",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.capturesTotal === 0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.lastCaptureResult === 'none'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.isPaused = false; const evt1 = new KeyboardEvent('keydown', {key: ' '}); document.dispatchEvent(evt1); setTimeout(() => { const evt2 = new KeyboardEvent('keydown', {key: 'c'}); document.dispatchEvent(evt2); }, 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "function waitForEclipse() { return new Promise(resolve => { const check = setInterval(() => { if (window.__3D_STATE__.eclipseIntensity > 0.3) { clearInterval(check); resolve(); } }, 50); setTimeout(() => { clearInterval(check); resolve(); }, 15000); }); } waitForEclipse();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "function captureAtEclipse() { return new Promise(resolve => { const check = setInterval(() => { if (window.__3D_STATE__.eclipseIntensity >= 0.6) { const evt = new KeyboardEvent('keydown', {key: 'c'}); document.dispatchEvent(evt); clearInterval(check); resolve(); } }, 50); setTimeout(() => { const evt = new KeyboardEvent('keydown', {key: 'c'}); document.dispatchEvent(evt); clearInterval(check); resolve(); }, 10000); }); } captureAtEclipse();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const scene = window.__3D_STATE__; const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(); const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const helmetScreenX = rect.width * 0.75; const helmetScreenY = rect.height * 0.35; const clickEvt = new MouseEvent('click', {clientX: rect.left + helmetScreenX, clientY: rect.top + helmetScreenY, bubbles: true}); canvas.dispatchEvent(clickEvt);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S7",
      "severity": "P0",
