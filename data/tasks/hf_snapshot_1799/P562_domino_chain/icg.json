{
  "task_id": "P562_domino_chain",
  "affordances": [
    {"id": "A1", "name": "Dominoes", "type": "3d_object", "semantic": "Box dominoes standing in formation", "locator_hints": ["box meshes"]},
    {"id": "A2", "name": "Floor", "type": "3d_object", "semantic": "Textured floor plane", "locator_hints": ["plane mesh with texture"]},
    {"id": "A3", "name": "SpacingSlider", "type": "dom_element", "semantic": "Domino spacing control", "locator_hints": ["#slider-spacing"]},
    {"id": "A4", "name": "CountSlider", "type": "dom_element", "semantic": "Domino count control", "locator_hints": ["#slider-count"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Standing", "conditions": ["window.__3D_STATE__.toppledCount === 0"]},
    {"id": "S1", "name": "Toppling", "conditions": ["window.__3D_STATE__.toppledCount > 0 && !window.__3D_STATE__.chainComplete"]},
    {"id": "S2", "name": "ChainDone", "conditions": ["window.__3D_STATE__.chainComplete === true"]},
    {"id": "S3", "name": "LayoutChanged", "conditions": ["window.__3D_STATE__.layout !== 'Line'"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.toppledCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.dominoCount >= 10", "tier": "L1"},
        {"expr": "window.__3D_STATE__.toppledCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.dominoesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.toppledCount > 0 || window.__3D_STATE__.maxAngle > 5", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 8000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.toppledCount > 5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.waveSpeed > 0 || window.__3D_STATE__.toppledCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.dominoesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.toppledCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.dominoesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "2"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layout === 'Curve'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.toppledCount === 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-spacing').value = 0.8; document.getElementById('slider-spacing').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.spacing >= 0.7", "tier": "L2"}
      ]}
    }
  ]
}
