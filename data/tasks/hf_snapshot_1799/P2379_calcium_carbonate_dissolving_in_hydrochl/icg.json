          },
          {
            "expr": "window.__3D_STATE__.totalCaCO3Mass < 5.0 && window.__3D_STATE__.totalCaCO3Mass >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hclConcentration < 2.0 && window.__3D_STATE__.hclConcentration > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.reactionRate - 0.05 * window.__3D_STATE__.hclConcentration * window.__3D_STATE__.totalCaCO3Mass) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
