  "states": [
    {
      "id": "S0",
      "name": "Initialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.hclConcentration === 2.0",
        "window.__3D_STATE__.chunksRemaining === 5",
        "window.__3D_STATE__.totalCO2Produced === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ReactionRunning",
      "conditions": [
        "window.__3D_STATE__.reactionRate > 0",
        "window.__3D_STATE__.activeBubbleCount > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "ConcentrationChanged",
      "conditions": [
        "window.__3D_STATE__.hclConcentration !== 2.0",
        "window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S4",
      "name": "ChunkAdded",
      "conditions": [
        "window.__3D_STATE__.chunksRemaining >= 6"
      ]
    },
    {
      "id": "S5",
      "name": "UndoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S6",
      "name": "RedoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0",
        "window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S7",
      "name": "PartiallyDissolved",
      "conditions": [
        "window.__3D_STATE__.dissolvedChunks >= 1",
        "window.__3D_STATE__.totalCO2Produced > 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.hclConcentration === 'number' && !isNaN(window.__3D_STATE__.hclConcentration)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hclConcentration > 0 && window.__3D_STATE__.hclConcentration <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCaCO3Mass > 0 && window.__3D_STATE__.totalCaCO3Mass <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.chunkMasses) && window.__3D_STATE__.chunkMasses.length === 5",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
