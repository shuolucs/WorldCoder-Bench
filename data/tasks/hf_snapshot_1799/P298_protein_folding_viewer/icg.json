{
  "task_id": "P298_protein_folding_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinModel",
      "type": "3d_object",
      "semantic": "The horse.glb model representing a protein structure",
      "locator_hints": [
        "loaded via GLTFLoader",
        "centered at origin"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing mode, folding status, temperature",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A3",
      "name": "ModeLabel",
      "type": "dom_element",
      "semantic": "Displays current visualization mode name",
      "locator_hints": [
        "#mode-label"
      ]
    },
    {
      "id": "A4",
      "name": "FoldingLabel",
      "type": "dom_element",
      "semantic": "Displays folding animation status",
      "locator_hints": [
        "#folding-label"
      ]
    },
    {
      "id": "A5",
      "name": "TempLabel",
      "type": "dom_element",
      "semantic": "Displays current temperature value",
      "locator_hints": [
        "#temp-label"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the entire view",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A7",
      "name": "AtomLabel",
      "type": "dom_element",
      "semantic": "Displays fixed atom count 4532",
      "locator_hints": [
        "#atom-label"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.modelLoaded === undefined"
      ]
    },
    {
      "id": "S1",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentMode === 0",
        "window.__3D_STATE__.foldingActive === false",
        "window.__3D_STATE__.temperatureMode === false"
      ]
    },
    {
      "id": "S2",
      "name": "SurfaceMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 1",
        "window.__3D_STATE__.modeName === 'Surface'"
      ]
    },
    {
      "id": "S3",
      "name": "RibbonMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 2",
        "window.__3D_STATE__.modeName === 'Ribbon'"
      ]
    },
    {
      "id": "S4",
      "name": "FoldingActive",
      "conditions": [
        "window.__3D_STATE__.foldingActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "FoldingPaused",
      "conditions": [
        "window.__3D_STATE__.foldingActive === false"
      ]
    },
    {
      "id": "S6",
      "name": "TemperatureOn",
      "conditions": [
        "window.__3D_STATE__.temperatureMode === true",
        "window.__3D_STATE__.temperatureValue >= 0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.currentMode === 0",
        "window.__3D_STATE__.foldingActive === false",
        "window.__3D_STATE__.temperatureMode === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modeName === 'Backbone'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingActive === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modeName === 'Surface'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('mode-label') !== null",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modeName === 'Ribbon'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelScale)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingActive === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelScale)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScale >= 0.75 && window.__3D_STATE__.modelScale <= 1.25",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingActive === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.modelRotationY) > 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelScale >= 0.78 && window.__3D_STATE__.modelScale <= 1.22",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatureMode === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.temperatureValue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperatureValue >= 0.0 && window.__3D_STATE__.temperatureValue <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperatureValue)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatureMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureValue > 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureValue <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('temp-label') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modeName === 'Backbone'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureMode === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureValue === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}