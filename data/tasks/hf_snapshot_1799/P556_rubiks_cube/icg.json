{
  "task_id": "P556_rubiks_cube",
  "affordances": [
    {"id": "A1", "name": "Cubies", "type": "3d_object", "semantic": "27 small colored cubes forming the Rubik's cube", "locator_hints": ["box meshes with colored faces"]},
    {"id": "A2", "name": "EdgeLines", "type": "3d_object", "semantic": "Black edge lines on each cubie", "locator_hints": ["LineSegments"]},
    {"id": "A3", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Solved", "conditions": ["window.__3D_STATE__.isSolved === true"]},
    {"id": "S1", "name": "Scrambled", "conditions": ["window.__3D_STATE__.status === 'Scrambled'"]},
    {"id": "S2", "name": "MoveMade", "conditions": ["window.__3D_STATE__.moveCount > 0"]},
    {"id": "S3", "name": "Undone", "conditions": ["window.__3D_STATE__.moveCount < before.moveCount || window.__3D_STATE__.lastMove.includes('undo')"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.isSolved === true && window.__3D_STATE__.moveCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.isSolved === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cubeValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const fc = s.faceColors; return fc && fc.U && fc.D && fc.R && fc.L && fc.F && fc.B; })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Scrambled' || window.__3D_STATE__.scrambleMoves > 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.cubeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 7000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isAnimating === false", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isSolved === false", "tier": "L1"},
        {"expr": "window.__3D_STATE__.scrambleMoves >= 15", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cubeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "u"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.moveCount >= 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.lastMove.includes('U') || window.__3D_STATE__.lastMove.includes('u')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "z"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.cubeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "x"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isSolved === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cubeValid === true", "tier": "L0"},
        {"expr": "document.getElementById('hud-status').textContent.includes('Solved')", "tier": "L2"}
      ]}
    }
  ]
}
