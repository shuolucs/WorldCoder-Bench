{
  "task_id": "P1880_stereoisomer_mirror_plane_3d_comparator",
  "affordances": [
    {
      "id": "A1",
      "name": "LeftMolecule",
      "type": "3d_object",
      "semantic": "Left-side original chiral molecule group with central carbon and 4 substituents",
      "locator_hints": [
        "leftMolecule group",
        "centered near x=-2.5"
      ]
    },
    {
      "id": "A2",
      "name": "RightMolecule",
      "type": "3d_object",
      "semantic": "Right-side mirror-image enantiomer molecule group",
      "locator_hints": [
        "rightMolecule group",
        "centered near x=+2.5"
      ]
    },
    {
      "id": "A3",
      "name": "MirrorPlane",
      "type": "3d_object",
      "semantic": "Semi-transparent vertical mirror plane at x=0",
      "locator_hints": [
        "thin box at x=0",
        "blue transparent plane"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleRotationButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume auto-rotation",
      "locator_hints": [
        "button containing 'Pause Rotation' or 'Resume Rotation'"
      ]
    },
    {
      "id": "A5",
      "name": "SuperimposeButton",
      "type": "dom_element",
      "semantic": "Button to superimpose right molecule onto left",
      "locator_hints": [
        "button containing 'Superimpose'"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset molecules to separated positions",
      "locator_hints": [
        "button containing 'Reset'"
      ]
    },
    {
      "id": "A7",
      "name": "HighlightMismatchButton",
      "type": "dom_element",
      "semantic": "Button to highlight mismatched atom pairs when superimposed",
      "locator_hints": [
        "button containing 'Highlight Mismatch'"
      ]
    },
    {
      "id": "A8",
      "name": "ModeHUD",
      "type": "dom_element",
      "semantic": "HUD overlay showing current mode (Separated/Superimposed)",
      "locator_hints": [
        "top center text overlay",
        "div showing mode"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialSeparated",
      "conditions": [
        "window.__3D_STATE__.rotationActive === true",
        "window.__3D_STATE__.superimposed === false",
        "window.__3D_STATE__.mode === 'separated'",
        "window.__3D_STATE__.rightMoleculeX > 2.0"
      ]
    },
    {
      "id": "S1",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.rotationActive === false",
        "window.__3D_STATE__.superimposed === false"
      ]
    },
    {
      "id": "S2",
      "name": "Superimposed",
      "conditions": [
        "window.__3D_STATE__.superimposed === true",
        "window.__3D_STATE__.mode === 'superimposed'",
        "Math.abs(window.__3D_STATE__.rightMoleculeX - (-2.5)) < 0.3"
      ]
    },
    {
      "id": "S3",
      "name": "MismatchHighlighted",
      "conditions": [
        "window.__3D_STATE__.superimposed === true",
        "window.__3D_STATE__.mismatchHighlighted === true"
      ]
    },
    {
      "id": "S4",
      "name": "PairSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPairIndex >= 0",
        "window.__3D_STATE__.selectedPairIndex <= 3"
      ]
    },
    {
      "id": "S5",
      "name": "ResetAfterSuperimpose",
      "conditions": [
        "window.__3D_STATE__.superimposed === false",
        "window.__3D_STATE__.mode === 'separated'",
        "window.__3D_STATE__.rightMoleculeX > 2.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationActive === 'boolean' && window.__3D_STATE__.rotationActive === true",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.atomCount === 'number' && window.__3D_STATE__.atomCount === 10",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.bondCount === 'number' && window.__3D_STATE__.bondCount === 8",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftRotationY === 'number' && !isNaN(window.__3D_STATE__.leftRotationY) && Math.abs(window.__3D_STATE__.leftRotationY) > 0.1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mirrorPlaneVisible === true && window.__3D_STATE__.mode === 'separated'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
