            "expr": "window.__3D_STATE__.rotationActive === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftRotationY === 'number' && !isNaN(window.__3D_STATE__.leftRotationY)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rightRotationY === 'number' && !isNaN(window.__3D_STATE__.rightRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.superimposed === false",
            "tier": "L2"
