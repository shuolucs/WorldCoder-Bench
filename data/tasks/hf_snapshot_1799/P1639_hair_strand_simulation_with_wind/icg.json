      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorTheme === 'red'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frozen === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandCount === 40",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorTheme === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['red', 'blonde', 'brown'].includes(window.__3D_STATE__.colorTheme)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S1",
      "severity": "P0",
      "action": {
