            "expr": "typeof window.__3D_STATE__.impulseAppliedCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tipPositions.every(p => Number.isFinite(p.x) && Number.isFinite(p.y) && Number.isFinite(p.z))",
            "tier": "L2"
          },
