        "#windStrength"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for click interactions",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.strandCount === 40",
        "window.__3D_STATE__.windEnabled === false",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.frozen === false",
        "window.__3D_STATE__.colorTheme === 'brown'"
      ]
    },
    {
      "id": "S1",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.avgTipDeflection >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "Wind_Enabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true",
        "window.__3D_STATE__.windForce.x > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Wind_Strength_Changed",
      "conditions": [
        "window.__3D_STATE__.windStrength !== 1.0",
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "Gravity_Disabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false",
        "window.__3D_STATE__.gravity.y === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Simulation_Frozen",
      "conditions": [
        "window.__3D_STATE__.frozen === true",
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "Color_Changed",
      "conditions": [
        "window.__3D_STATE__.colorTheme !== 'brown'"
      ]
    },
    {
      "id": "S7",
      "name": "Impulse_Applied",
      "conditions": [
        "window.__3D_STATE__.impulseAppliedCount > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Strands_Reset",
      "conditions": [
        "window.__3D_STATE__.avgTipDeflection < 0.05"
      ]
    },
    {
      "id": "S9",
      "name": "Wind_High_Deflection",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true",
        "window.__3D_STATE__.avgTipDeflection > 0.2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.strandCount === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodesPerStrand === 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentsPerStrand === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.avgTipDeflection) && !Number.isNaN(window.__3D_STATE__.avgTipDeflection)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#windToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windForce.x > 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.windForce.x) && Number.isFinite(window.__3D_STATE__.windForce.y) && Number.isFinite(window.__3D_STATE__.windForce.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windForce.x - 2.5 * window.__3D_STATE__.windStrength) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windStrength === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avgTipDeflection > 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTipDeflection > window.__3D_STATE__.avgTipDeflection",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tipPositions.length === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tipPositions.every(p => Number.isFinite(p.x) && Number.isFinite(p.y) && Number.isFinite(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTipDeflection < 3 * window.__3D_STATE__.strandRestLength",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S9",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('windStrength').value = '2.5'; document.getElementById('windStrength').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windStrength - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windForce.x - 2.5 * 2.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windForce.x > 4.0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.windForce.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravity.x === 0 && window.__3D_STATE__.gravity.y === 0 && window.__3D_STATE__.gravity.z === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tipPositions.every(p => Number.isFinite(p.y))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frozen === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "(function() { var fc = window.__3D_STATE__.frameCount; return typeof fc === 'number' && fc > 0; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
