            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rootPositions.every(p => Number.isFinite(p.x) && Number.isFinite(p.y) && Number.isFinite(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandRestLength === 1.8",
            "tier": "L2"
          },
          {
