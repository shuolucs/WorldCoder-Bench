{
  "task_id": "P461_fractal_tree_generator",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalTree",
      "type": "3d_object",
      "semantic": "The fractal tree group containing all branches and leaves",
      "locator_hints": [
        "window.__3D_STATE__.treeGroup",
        "scene.children group"
      ]
    },
    {
      "id": "A2",
      "name": "DepthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling recursion depth",
      "locator_hints": [
        "#slider-depth"
      ]
    },
    {
      "id": "A3",
      "name": "AngleSlider",
      "type": "dom_element",
      "semantic": "Slider controlling branching angle",
      "locator_hints": [
        "#slider-angle"
      ]
    },
    {
      "id": "A4",
      "name": "RegenerateButton",
      "type": "dom_element",
      "semantic": "Button to rebuild tree with current parameters",
      "locator_hints": [
        "#btn-regenerate"
      ]
    },
    {
      "id": "A5",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Button to randomize all parameters",
      "locator_hints": [
        "#btn-randomize"
      ]
    },
    {
      "id": "A6",
      "name": "WindButton",
      "type": "dom_element",
      "semantic": "Button to toggle wind animation",
      "locator_hints": [
        "#btn-wind"
      ]
    },
    {
      "id": "A7",
      "name": "LeavesButton",
      "type": "dom_element",
      "semantic": "Button to toggle leaf visibility",
      "locator_hints": [
        "#btn-leaves"
      ]
    },
    {
      "id": "A8",
      "name": "StatsDisplay",
      "type": "dom_element",
      "semantic": "Display showing branch/leaf counts",
      "locator_hints": [
        "#stats"
      ]
    },
    {
      "id": "A9",
      "name": "LengthDecaySlider",
      "type": "dom_element",
      "semantic": "Slider controlling length decay",
      "locator_hints": [
        "#slider-lengthDecay"
      ]
    },
    {
      "id": "A10",
      "name": "BranchesSlider",
      "type": "dom_element",
      "semantic": "Slider controlling branches per node",
      "locator_hints": [
        "#slider-branches"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialTreeGenerated",
      "conditions": [
        "window.__3D_STATE__.isGenerated === true",
        "window.__3D_STATE__.depth === 6",
        "window.__3D_STATE__.angle === 30",
        "window.__3D_STATE__.branches === 2",
        "window.__3D_STATE__.windEnabled === false",
        "window.__3D_STATE__.leavesVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "DepthIncreased",
      "conditions": [
        "window.__3D_STATE__.depth === 7",
        "window.__3D_STATE__.totalBranches === 127",
        "window.__3D_STATE__.totalLeaves === 128"
      ]
    },
    {
      "id": "S2",
      "name": "DepthDecreased",
      "conditions": [
        "window.__3D_STATE__.depth === 6",
        "window.__3D_STATE__.totalBranches === 63",
        "window.__3D_STATE__.totalLeaves === 64"
      ]
    },
    {
      "id": "S3",
      "name": "AngleChanged",
      "conditions": [
        "window.__3D_STATE__.angle === 45",
        "window.__3D_STATE__.isGenerated === true"
      ]
    },
    {
      "id": "S4",
      "name": "WindEnabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "WindAnimating",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true",
        "window.__3D_STATE__.animationTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "LeavesHidden",
      "conditions": [
        "window.__3D_STATE__.leavesVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "LeavesRestored",
      "conditions": [
        "window.__3D_STATE__.leavesVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "TripleBranching",
      "conditions": [
        "window.__3D_STATE__.branches === 3",
        "window.__3D_STATE__.depth === 6",
        "window.__3D_STATE__.totalLeaves === 729"
      ]
    },
    {
      "id": "S9",
      "name": "Randomized",
      "conditions": [
        "window.__3D_STATE__.isGenerated === true",
        "window.__3D_STATE__.totalBranches > 0",
        "window.__3D_STATE__.totalLeaves > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "="
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
