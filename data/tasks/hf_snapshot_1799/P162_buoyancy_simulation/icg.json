{
  "task_id": "P162_buoyancy_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainStemModel",
      "type": "3d_object",
      "semantic": "The loaded BrainStem GLB model that floats or sinks in the tank",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "WaterTank",
      "type": "3d_object",
      "semantic": "Transparent blue box representing the water tank",
      "locator_hints": [
        "MeshPhysicalMaterial with transmission"
      ]
    },
    {
      "id": "A3",
      "name": "WaterSurface",
      "type": "3d_object",
      "semantic": "Plane at waterLevel representing water surface",
      "locator_hints": [
        "Plane at y=1.0"
      ]
    },
    {
      "id": "A4",
      "name": "IncreaseDensityBtn",
      "type": "dom_element",
      "semantic": "Button to increase object density by 50",
      "locator_hints": [
        "#btn-increase-density"
      ]
    },
    {
      "id": "A5",
      "name": "DecreaseDensityBtn",
      "type": "dom_element",
      "semantic": "Button to decrease object density by 50",
      "locator_hints": [
        "#btn-decrease-density"
      ]
    },
    {
      "id": "A6",
      "name": "IncreaseFluidBtn",
      "type": "dom_element",
      "semantic": "Button to increase fluid density by 100",
      "locator_hints": [
        "#btn-increase-fluid"
      ]
    },
    {
      "id": "A7",
      "name": "DecreaseFluidBtn",
      "type": "dom_element",
      "semantic": "Button to decrease fluid density by 100",
      "locator_hints": [
        "#btn-decrease-fluid"
      ]
    },
    {
      "id": "A8",
      "name": "DropBtn",
      "type": "dom_element",
      "semantic": "Button to drop object from top",
      "locator_hints": [
        "#btn-drop"
      ]
    },
    {
      "id": "A9",
      "name": "ResetBtn",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "HUD display showing simulation values",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_ModelLoading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded_InitialDrop",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.objectDensity === 800",
        "window.__3D_STATE__.fluidDensity === 1000"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectFloatingEquilibrium",
      "conditions": [
        "window.__3D_STATE__.simState === 'floating'",
        "Math.abs(window.__3D_STATE__.velocityY) < 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "DensityIncreasedStillFloating",
      "conditions": [
        "window.__3D_STATE__.objectDensity === 850",
        "window.__3D_STATE__.simState === 'floating' || window.__3D_STATE__.simState === 'sinking'"
      ]
    },
    {
      "id": "S4",
      "name": "ObjectMadeHeavy_Sinking",
      "conditions": [
        "window.__3D_STATE__.objectDensity >= 1050",
        "window.__3D_STATE__.netForce < 0"
      ]
    },
    {
      "id": "S5",
      "name": "ObjectResting_AtBottom",
      "conditions": [
        "window.__3D_STATE__.simState === 'resting'",
        "window.__3D_STATE__.objectY <= -1.9"
      ]
    },
    {
      "id": "S6",
      "name": "DroppedFromTop",
      "conditions": [
        "window.__3D_STATE__.objectY >= 2.9",
        "window.__3D_STATE__.velocityY === 0"
      ]
    },
    {
      "id": "S7",
      "name": "FluidDensityIncreased",
      "conditions": [
        "window.__3D_STATE__.fluidDensity >= 1200"
      ]
    },
    {
      "id": "S8",
      "name": "ObjectFloatingHigher",
      "conditions": [
        "window.__3D_STATE__.simState === 'floating'",
        "window.__3D_STATE__.submergedFraction < 0.9"
      ]
    },
    {
      "id": "S9",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.objectDensity === 800",
        "window.__3D_STATE__.fluidDensity === 1000",
        "window.__3D_STATE__.objectY >= 1.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterLevel === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectVolume === 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.objectY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simState === 'floating'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityY) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectY < window.__3D_STATE__.waterLevel",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.submergedFraction > 0.5 && window.__3D_STATE__.submergedFraction < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.buoyantForce - window.__3D_STATE__.weight) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-increase-density"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.weight - (850 * 0.5 * 9.81)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.netForce)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.velocityY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){document.getElementById('btn-increase-density').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weight > window.__3D_STATE__.buoyantForce",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netForce < 0 || window.__3D_STATE__.simState === 'sinking' || window.__3D_STATE__.simState === 'resting'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.objectY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simState === 'resting'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectY <= -1.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectY >= -2.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.submergedFraction >= 0.99",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityY) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-drop"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectY >= 2.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityY === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simState === 'falling' || window.__3D_STATE__.objectY >= 2.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-increase-fluid').click(); document.getElementById('btn-increase-fluid').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dampingFactor === 0.95",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.buoyantForce)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.timeElapsed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simState === 'floating'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.submergedFraction > 0.7 && window.__3D_STATE__.submergedFraction < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityY) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.buoyantForce - window.__3D_STATE__.weight) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectY > -2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.velocityY === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectY >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectVolume === 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simState === 'floating'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityY) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.submergedFraction > 0.6 && window.__3D_STATE__.submergedFraction < 0.95",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.netForce) < 1.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}