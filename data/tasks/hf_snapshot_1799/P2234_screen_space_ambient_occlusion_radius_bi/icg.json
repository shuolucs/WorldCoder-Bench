        "#controlPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Split_Default",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.mode === 'split'",
        "window.__3D_STATE__.passA_kernelRadius === 8",
        "window.__3D_STATE__.passB_kernelRadius === 32",
        "window.__3D_STATE__.outputMode === 'Default'",
        "window.__3D_STATE__.swapCount === 0",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Unified_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'unified'"
      ]
    },
    {
      "id": "S2",
      "name": "Back_To_Split",
      "conditions": [
        "window.__3D_STATE__.mode === 'split'"
      ]
    },
    {
      "id": "S3",
      "name": "Presets_Swapped",
      "conditions": [
        "window.__3D_STATE__.swapCount === 1",
        "window.__3D_STATE__.passA_kernelRadius === 32",
        "window.__3D_STATE__.passB_kernelRadius === 8"
      ]
    },
    {
      "id": "S4",
      "name": "SliderA_Adjusted",
      "conditions": [
        "window.__3D_STATE__.passA_kernelRadius === 20"
      ]
    },
    {
      "id": "S5",
      "name": "SSAO_Only_Output",
      "conditions": [
        "window.__3D_STATE__.outputMode === 'SSAO Only'",
        "window.__3D_STATE__.outputModeIndex === 1"
      ]
    },
    {
      "id": "S6",
      "name": "Depth_Output",
      "conditions": [
        "window.__3D_STATE__.outputMode === 'Depth'",
        "window.__3D_STATE__.outputModeIndex === 2"
      ]
    },
    {
      "id": "S7",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.passA_kernelRadius === 8",
        "window.__3D_STATE__.passB_kernelRadius === 32",
        "window.__3D_STATE__.mode === 'split'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'split'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius === 8 && window.__3D_STATE__.passA_minDistance === 0.005 && window.__3D_STATE__.passA_maxDistance === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_kernelRadius === 32 && window.__3D_STATE__.passB_minDistance === 0.02 && window.__3D_STATE__.passB_maxDistance === 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleMode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'unified'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "document.querySelector('#modeLabel').textContent.toLowerCase().includes('unified')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleMode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'split'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#modeLabel').textContent.toLowerCase().includes('split')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_kernelRadius === 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#swapPresets"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.swapCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius === 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_kernelRadius === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_minDistance === 0.02 && window.__3D_STATE__.passA_maxDistance === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_minDistance === 0.005 && window.__3D_STATE__.passB_maxDistance === 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#radiusSliderA').value = 20; document.querySelector('#radiusSliderA').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius >= 1 && window.__3D_STATE__.passA_kernelRadius <= 64",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#radiusSliderA').value === '20'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_kernelRadius === 8",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.passA_kernelRadius)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.outputMode === 'SSAO Only'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputModeIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#outputLabel').textContent.includes('SSAO')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.outputMode === 'Depth'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputModeIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#outputLabel').textContent.includes('Depth')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.outputModeIndex === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetParams"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_kernelRadius === 8 && window.__3D_STATE__.passA_minDistance === 0.005 && window.__3D_STATE__.passA_maxDistance === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passB_kernelRadius === 32 && window.__3D_STATE__.passB_minDistance === 0.02 && window.__3D_STATE__.passB_maxDistance === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'split'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#radiusSliderA').value === '8' && document.querySelector('#radiusSliderB').value === '32'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passA_maxDistance > window.__3D_STATE__.passA_minDistance && window.__3D_STATE__.passB_maxDistance > window.__3D_STATE__.passB_minDistance",
            "tier": "L2"
          }
        ]
