{
  "task_id": "P549_3d_print_slicer",
  "affordances": [
    {"id": "A1", "name": "Model", "type": "3d_object", "semantic": "Loaded Duck.glb model", "locator_hints": ["GLTF scene"]},
    {"id": "A2", "name": "SlicePlane", "type": "3d_object", "semantic": "Horizontal cutting plane", "locator_hints": ["plane mesh blue transparent"]},
    {"id": "A3", "name": "CrossSection", "type": "3d_object", "semantic": "Red cross-section at slice height", "locator_hints": ["clipped mesh red"]},
    {"id": "A4", "name": "HeightSlider", "type": "dom_element", "semantic": "Slice height control", "locator_hints": ["#slider-height"]},
    {"id": "A5", "name": "LayerHeightSlider", "type": "dom_element", "semantic": "Layer height control", "locator_hints": ["#slider-layer-height"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Loading", "conditions": ["window.__3D_STATE__.modelLoaded === false"]},
    {"id": "S1", "name": "SliceMode", "conditions": ["window.__3D_STATE__.modelLoaded === true", "window.__3D_STATE__.isSliceMode === true"]},
    {"id": "S2", "name": "HeightChanged", "conditions": ["window.__3D_STATE__.sliceHeight !== before.sliceHeight"]},
    {"id": "S3", "name": "Animating", "conditions": ["window.__3D_STATE__.isAnimating === true"]},
    {"id": "S4", "name": "SolidMode", "conditions": ["window.__3D_STATE__.isSliceMode === false"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.totalLayers > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.sliceValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "const s = document.getElementById('slider-height'); if(s){ s.value = parseFloat(s.max) * 0.8; s.dispatchEvent(new Event('input')); } return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.sliceHeight > window.__3D_STATE__.modelMinY", "tier": "L1"},
        {"expr": "window.__3D_STATE__.layerNumber > 1", "tier": "L1"},
        {"expr": "document.getElementById('hud-layer') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "a"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isAnimating === true", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isAnimating === false", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isSliceMode === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-mode').textContent.includes('Solid')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-layer-height').value = 0.1; document.getElementById('slider-layer-height').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layerHeight <= 0.15", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalLayers > before.totalLayers", "tier": "L1"}
      ]}
    }
  ]
}
