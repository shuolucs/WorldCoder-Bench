{
  "task_id": "P1915_thermal_heat_map_material_with_temperatu",
  "affordances": [
    {
      "id": "A1",
      "name": "ThermalSurface",
      "type": "3d_object",
      "semantic": "The main 64x64 subdivided plane with thermal heat map shader material",
      "locator_hints": [
        "PlaneGeometry mesh",
        "ShaderMaterial with temperature DataTexture"
      ]
    },
    {
      "id": "A2",
      "name": "DiffusionSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling diffusion coefficient",
      "locator_hints": [
        "#diffusionSlider",
        "input[type=range]"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset to initial single-source state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to clear all sources and zero temperatures",
      "locator_hints": [
        "#clearBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ColorSchemeSelect",
      "type": "dom_element",
      "semantic": "Dropdown to switch between thermal, grayscale, plasma color schemes",
      "locator_hints": [
        "#colorScheme",
        "select"
      ]
    },
    {
      "id": "A6",
      "name": "SimStatusLabel",
      "type": "dom_element",
      "semantic": "Label showing Running or Paused status",
      "locator_hints": [
        "#simStatus"
      ]
    },
    {
      "id": "A7",
      "name": "AvgTempLabel",
      "type": "dom_element",
      "semantic": "Label showing average temperature",
      "locator_hints": [
        "#avgTemp"
      ]
    },
    {
      "id": "A8",
      "name": "TotalEnergyLabel",
      "type": "dom_element",
      "semantic": "Label showing total thermal energy",
      "locator_hints": [
        "#totalEnergy"
      ]
    },
    {
      "id": "A9",
      "name": "SourceCountLabel",
      "type": "dom_element",
      "semantic": "Label showing number of active heat sources",
      "locator_hints": [
        "#sourceCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.sourceCount === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.colorScheme === 'thermal'",
        "window.__3D_STATE__.diffusionCoeff === 0.05",
        "window.__3D_STATE__.gridSize === 64"
      ]
    },
    {
      "id": "S1",
      "name": "DiffusionRunning",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.frameCount > 10"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "SourceAdded",
      "conditions": [
        "window.__3D_STATE__.sourceCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "DiffusionAdjusted",
      "conditions": [
        "window.__3D_STATE__.diffusionCoeff !== 0.05"
      ]
    },
    {
      "id": "S5",
      "name": "ColorSchemeChanged",
      "conditions": [
        "window.__3D_STATE__.colorScheme !== 'thermal'"
      ]
    },
    {
      "id": "S6",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.sourceCount === 0",
        "window.__3D_STATE__.totalEnergy < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToInitial",
      "conditions": [
        "window.__3D_STATE__.sourceCount === 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.temperature !== 'undefined' && window.__3D_STATE__.temperature.length === 4096",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridSize === 64 && window.__3D_STATE__.meshVertexCount === (64+1)*(64+1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDisplacement === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 1.0 && window.__3D_STATE__.minTemp >= 0.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T2_pre_energy = window.__3D_STATE__.totalEnergy; window.__T2_pre_frame = window.__3D_STATE__.frameCount;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sourceCount === 1 && window.__3D_STATE__.sources[0].u === 0.5 && window.__3D_STATE__.sources[0].v === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[0].intensity === 1.0 && window.__3D_STATE__.sources[0].radius === 0.25",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avgTemperature - (window.__3D_STATE__.totalEnergy / 4096)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0 && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgTemperature) && window.__3D_STATE__.avgTemperature >= 0 && window.__3D_STATE__.avgTemperature <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus') !== null && document.getElementById('simStatus').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.minTemp >= 0.0 && window.__3D_STATE__.maxTemp <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T4_paused_energy = window.__3D_STATE__.totalEnergy; window.__T4_paused_frame = window.__3D_STATE__.frameCount;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - window.__T4_paused_energy) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorScheme === 'thermal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.diffusionCoeff === 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus') !== null && document.getElementById('simStatus').textContent.toLowerCase().includes('running')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > window.__T4_paused_frame",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.diffusionCoeff - 0.06) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.diffusionCoeff >= 0.0 && window.__3D_STATE__.diffusionCoeff <= 0.2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('diffusionSlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('diffusionSlider').value) - window.__3D_STATE__.diffusionCoeff) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.diffusionCoeff)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.diffusionCoeff - 0.05) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.diffusionCoeff >= 0.0 && window.__3D_STATE__.diffusionCoeff <= 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('diffusionSlider').value) - window.__3D_STATE__.diffusionCoeff) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('colorScheme').value = 'grayscale'; document.getElementById('colorScheme').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorScheme === 'grayscale'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('colorScheme').value === 'grayscale'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 1.0 && window.__3D_STATE__.minTemp >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('colorScheme').value = 'plasma'; document.getElementById('colorScheme').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorScheme === 'plasma'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('colorScheme').value === 'plasma'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#clearBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sourceCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemperature < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('sourceCount') !== null && document.getElementById('sourceCount').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sourceCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avgTemperature - (window.__3D_STATE__.totalEnergy / 4096)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sourceCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[0].u === 0.5 && window.__3D_STATE__.sources[0].v === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[0].intensity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp > 0.5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}