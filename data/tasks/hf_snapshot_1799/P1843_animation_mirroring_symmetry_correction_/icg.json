{
  "task_id": "P1843_animation_mirroring_symmetry_correction_",
  "affordances": [
    {
      "id": "A1",
      "name": "OriginalArmature",
      "type": "3d_object",
      "semantic": "Left stick-figure armature showing original animation pose",
      "locator_hints": [
        "positioned at x=-2.5"
      ]
    },
    {
      "id": "A2",
      "name": "MirrorArmature",
      "type": "3d_object",
      "semantic": "Right stick-figure armature showing mirrored pose with symmetry errors",
      "locator_hints": [
        "positioned at x=2.5"
      ]
    },
    {
      "id": "A3",
      "name": "JointSelector",
      "type": "3d_object",
      "semantic": "Glowing torus ring indicating selected joint on mirror armature",
      "locator_hints": [
        "TorusGeometry around selected joint"
      ]
    },
    {
      "id": "A4",
      "name": "DeviationLines",
      "type": "3d_object",
      "semantic": "Lines connecting corresponding joints colored by deviation",
      "locator_hints": [
        "LineSegments between armatures"
      ]
    },
    {
      "id": "A5",
      "name": "PrevPoseBtn",
      "type": "dom_element",
      "semantic": "Button to go to previous pose",
      "locator_hints": [
        "#prevPoseBtn"
      ]
    },
    {
      "id": "A6",
      "name": "NextPoseBtn",
      "type": "dom_element",
      "semantic": "Button to go to next pose",
      "locator_hints": [
        "#nextPoseBtn"
      ]
    },
    {
      "id": "A7",
      "name": "AutoCorrectBtn",
      "type": "dom_element",
      "semantic": "Button to auto-correct all mirror errors to zero",
      "locator_hints": [
        "#autoCorrectBtn"
      ]
    },
    {
      "id": "A8",
      "name": "UndoBtn",
      "type": "dom_element",
      "semantic": "Button to undo last auto-correct",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A9",
      "name": "RedoBtn",
      "type": "dom_element",
      "semantic": "Button to redo last undone correction",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A10",
      "name": "ResetErrorsBtn",
      "type": "dom_element",
      "semantic": "Button to regenerate random errors",
      "locator_hints": [
        "#resetErrorsBtn"
      ]
    },
    {
      "id": "A11",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing pose, score, joint info",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A12",
      "name": "SymmetryScoreDisplay",
      "type": "dom_element",
      "semantic": "Displays current symmetry score percentage",
      "locator_hints": [
        "#symmetryScore"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initialized_Idle_Pose0",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.currentPoseIndex === 0",
        "window.__3D_STATE__.poseCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "Pose1_Active",
      "conditions": [
        "window.__3D_STATE__.currentPoseIndex === 1",
        "window.__3D_STATE__.poseName === 'Walk A'"
      ]
    },
    {
      "id": "S2",
      "name": "Joint_Selected_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.selectedJointIndex >= 0",
        "window.__3D_STATE__.selectedJointName !== ''"
      ]
    },
    {
      "id": "S3",
      "name": "Manual_Correction_Applied",
      "conditions": [
        "window.__3D_STATE__.totalCorrectionsApplied > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Heatmap_Active",
      "conditions": [
        "window.__3D_STATE__.heatmapActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "Auto_Correct_Complete",
      "conditions": [
        "window.__3D_STATE__.autoCorrectComplete === true",
        "window.__3D_STATE__.allJointsGreen === true"
      ]
    },
    {
      "id": "S6",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.allJointsGreen === true"
      ]
    },
    {
      "id": "S8",
      "name": "Errors_Reset",
      "conditions": [
        "window.__3D_STATE__.autoCorrectComplete === false",
        "window.__3D_STATE__.undoStackSize === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Pose3_ArmsUp",
      "conditions": [
        "window.__3D_STATE__.currentPoseIndex === 3",
        "window.__3D_STATE__.poseName === 'Arms Up'"
      ]
    },
    {
      "id": "S10",
      "name": "Heatmap_Deactivated",
      "conditions": [
        "window.__3D_STATE__.heatmapActive === false"
      ]
    },
    {
      "id": "S11",
      "name": "Full_Cycle_Pose0_Return",
      "conditions": [
        "window.__3D_STATE__.currentPoseIndex === 0",
        "window.__3D_STATE__.poseName === 'Idle'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.symmetryScore === 'number' && window.__3D_STATE__.symmetryScore >= 0 && window.__3D_STATE__.symmetryScore <= 100",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.jointDeviations) && window.__3D_STATE__.jointDeviations.length === 8",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.mirrorErrors) && window.__3D_STATE__.mirrorErrors.length === 8",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 0 && window.__3D_STATE__.poseCount === 4",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.jointNames) && window.__3D_STATE__.jointNames.length === 8 && window.__3D_STATE__.jointNames.every(n => typeof n === 'string' && n.length > 0)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#nextPoseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseName === 'Walk A'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore >= 0 && window.__3D_STATE__.symmetryScore <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointDeviations.every(d => typeof d === 'number' && !isNaN(d) && d >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDeviation >= 0 && window.__3D_STATE__.maxDeviation <= Math.PI",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointColors.every(c => c === 'green' || c === 'yellow' || c === 'red')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "j"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJointIndex >= 0 && window.__3D_STATE__.selectedJointIndex <= 7",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedJointName === 'string' && window.__3D_STATE__.selectedJointName.length > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedJointDeviation === 'number' && !isNaN(window.__3D_STATE__.selectedJointDeviation)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointDeviation >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedJointDeviation - window.__3D_STATE__.jointDeviations[window.__3D_STATE__.selectedJointIndex]) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "k"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalCorrectionsApplied >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.symmetryScore === 'number' && !isNaN(window.__3D_STATE__.symmetryScore)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.every(e => typeof e === 'number' && !isNaN(e))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meanDeviation >= 0 && window.__3D_STATE__.meanDeviation <= Math.PI",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.meanDeviation - window.__3D_STATE__.jointDeviations.reduce((a,b)=>a+b,0)/8) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatmapActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointDeviations.every(d => !isNaN(d) && d >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore >= 0 && window.__3D_STATE__.symmetryScore <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#autoCorrectBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoCorrectComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allJointsGreen === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.symmetryScore - 100) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.every(e => Math.abs(e) < 0.001)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDeviation < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#undoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoCorrectComplete === false || window.__3D_STATE__.allJointsGreen === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore < 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.some(e => Math.abs(e) > 0.001)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDeviation > 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#redoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allJointsGreen === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.symmetryScore - 100) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.every(e => Math.abs(e) < 0.001)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDeviation < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetErrorsBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoCorrectComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.some(e => Math.abs(e) > 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#nextPoseBtn').click(); setTimeout(() => document.querySelector('#nextPoseBtn').click(), 200);",
        "delay_after_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseName === 'Arms Up'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointDeviations.every(d => typeof d === 'number' && !isNaN(d) && d >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore >= 0 && window.__3D_STATE__.symmetryScore <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.every(e => typeof e === 'number' && !isNaN(e) && Math.abs(e) <= Math.PI)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatmapActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointDeviations.every(d => !isNaN(d))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.meanDeviation === 'number' && !isNaN(window.__3D_STATE__.meanDeviation)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#nextPoseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPoseIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseName === 'Idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.symmetryScore >= 0 && window.__3D_STATE__.symmetryScore <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointDeviations.every(d => typeof d === 'number' && !isNaN(d) && d >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mirrorErrors.length === 8",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}