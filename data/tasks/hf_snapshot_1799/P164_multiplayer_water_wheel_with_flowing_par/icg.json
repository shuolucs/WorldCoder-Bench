  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.flowRate === 5",
        "window.__3D_STATE__.brakeOn === false",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.wheelAngularVelocity === 0",
        "window.__3D_STATE__.totalCollisions === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ParticlesFlowing",
      "conditions": [
        "window.__3D_STATE__.activeParticles > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "WheelSpinning",
      "conditions": [
        "window.__3D_STATE__.wheelAngularVelocity > 0.1",
        "window.__3D_STATE__.totalCollisions > 0"
      ]
    },
    {
      "id": "S3",
      "name": "FlowIncreased",
      "conditions": [
        "window.__3D_STATE__.flowRate > 5"
      ]
    },
    {
      "id": "S4",
      "name": "BrakeApplied",
      "conditions": [
        "window.__3D_STATE__.brakeOn === true",
        "window.__3D_STATE__.dampingFactor === 0.90"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.wheelAngularVelocity === 0",
        "window.__3D_STATE__.flowRate === 5",
        "window.__3D_STATE__.brakeOn === false",
        "window.__3D_STATE__.totalCollisions === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Spacebar !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.R !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.wheelAngularVelocity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpawnInterval === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
