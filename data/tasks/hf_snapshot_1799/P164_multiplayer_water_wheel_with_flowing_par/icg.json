            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.flowRate === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpawnInterval === 12.5 || Math.abs(window.__3D_STATE__.particleSpawnInterval - 12.5) < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flowRate >= 1 && window.__3D_STATE__.flowRate <= 10",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('flowRateDisplay') !== null",
            "tier": "L0"
