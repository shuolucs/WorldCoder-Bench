  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.morphMode === 0",
        "window.__3D_STATE__.themeIndex === 0",
        "window.__3D_STATE__.selectedGeometry === -1",
        "window.__3D_STATE__.fishVisible === true",
        "window.__3D_STATE__.hiddenCount === 0",
        "window.__3D_STATE__.platformExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "MorphPulse",
      "conditions": [
        "window.__3D_STATE__.morphMode === 1",
        "window.__3D_STATE__.morphModeName === 'pulse'"
      ]
    },
    {
      "id": "S2",
      "name": "MorphSpin",
      "conditions": [
        "window.__3D_STATE__.morphMode === 2",
        "window.__3D_STATE__.morphModeName === 'spin'"
      ]
    },
    {
      "id": "S3",
      "name": "ThemeBlue",
      "conditions": [
        "window.__3D_STATE__.themeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "ThemeOrange",
      "conditions": [
        "window.__3D_STATE__.themeIndex === 2"
      ]
    },
    {
      "id": "S5",
      "name": "GeometrySelected",
      "conditions": [
        "window.__3D_STATE__.selectedGeometry >= 0 && window.__3D_STATE__.selectedGeometry <= 4"
      ]
    },
    {
      "id": "S6",
      "name": "GeometryHidden",
      "conditions": [
        "window.__3D_STATE__.hiddenCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "FishHidden",
      "conditions": [
        "window.__3D_STATE__.fishVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "FishJumping",
      "conditions": [
        "window.__3D_STATE__.fishJumping === true"
      ]
    },
    {
      "id": "S9",
      "name": "CameraRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraAngleDeg) > 10"
      ]
    },
    {
      "id": "S10",
      "name": "AllRestored",
      "conditions": [
        "window.__3D_STATE__.hiddenCount === 0",
        "window.__3D_STATE__.geometryVisible.every(v => v === true)"
      ]
    }
  ],
