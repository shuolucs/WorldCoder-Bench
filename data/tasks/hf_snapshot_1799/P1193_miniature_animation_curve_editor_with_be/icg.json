        "shows Playing, Selected, P1, P2, Preview t"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.selectedHandle === null",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.playing === false"
      ]
    },
    {
      "id": "S2",
      "name": "HandleP1Selected",
      "conditions": [
        "window.__3D_STATE__.selectedHandle === 'P1'"
      ]
    },
    {
      "id": "S3",
      "name": "HandleP1Moved",
      "conditions": [
        "window.__3D_STATE__.p1.x !== window.__3D_STATE__.p1Default.x || window.__3D_STATE__.p1.z !== window.__3D_STATE__.p1Default.z"
      ]
    },
    {
      "id": "S4",
      "name": "HandleP2Selected",
      "conditions": [
        "window.__3D_STATE__.selectedHandle === 'P2'"
      ]
    },
    {
      "id": "S5",
      "name": "HandleP2Moved",
      "conditions": [
        "window.__3D_STATE__.p2.x !== window.__3D_STATE__.p2Default.x || window.__3D_STATE__.p2.z !== window.__3D_STATE__.p2Default.z"
      ]
    },
    {
      "id": "S6",
      "name": "HandlesReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.p1.x - window.__3D_STATE__.p1Default.x) < 0.01",
        "Math.abs(window.__3D_STATE__.p1.z - window.__3D_STATE__.p1Default.z) < 0.01",
        "Math.abs(window.__3D_STATE__.p2.x - window.__3D_STATE__.p2Default.x) < 0.01",
        "Math.abs(window.__3D_STATE__.p2.z - window.__3D_STATE__.p2Default.z) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "AnimationResumed",
      "conditions": [
        "window.__3D_STATE__.playing === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.p1 === 'object' && typeof window.__3D_STATE__.p1.x === 'number' && !isNaN(window.__3D_STATE__.p1.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.p2 === 'object' && typeof window.__3D_STATE__.p2.x === 'number' && !isNaN(window.__3D_STATE__.p2.x)",
