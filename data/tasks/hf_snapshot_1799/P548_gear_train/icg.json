{
  "task_id": "P548_gear_train",
  "affordances": [
    {"id": "A1", "name": "Gears", "type": "3d_object", "semantic": "5 involute gears with teeth", "locator_hints": ["extruded geometry meshes"]},
    {"id": "A2", "name": "ContactPoints", "type": "3d_object", "semantic": "Yellow spheres at meshing points", "locator_hints": ["small yellow spheres"]},
    {"id": "A3", "name": "VelocityArrows", "type": "3d_object", "semantic": "Angular velocity arrow helpers", "locator_hints": ["ArrowHelper"]},
    {"id": "A4", "name": "InputSpeedSlider", "type": "dom_element", "semantic": "Input speed control", "locator_hints": ["#slider-input-speed"]},
    {"id": "A5", "name": "FrictionSlider", "type": "dom_element", "semantic": "Friction control", "locator_hints": ["#slider-friction"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false", "window.__3D_STATE__.inputSpeed === 2"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.gearAngles[0] > 0"]},
    {"id": "S2", "name": "SpeedChanged", "conditions": ["window.__3D_STATE__.inputSpeed !== 2"]},
    {"id": "S3", "name": "Paused", "conditions": ["window.__3D_STATE__.isPaused === true"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.gearAngles[0] === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.totalTeeth === 92", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gearsValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.outputSpeed !== 0 || window.__3D_STATE__.frameCount > 10", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(Array.isArray(v)) return v.every(x => isFinite(x) && !isNaN(x)); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.gearAngles[0] > before.gearAngles[0]", "tier": "L1"},
        {"expr": "window.__3D_STATE__.meshingCorrect === true", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Math.abs(s.gearRatio - (12/24 * 16/32 * 32/8)) < 0.5 || Math.abs(s.gearRatio) > 0; })()", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-input-speed').value = 6; document.getElementById('slider-input-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.inputSpeed >= 5", "tier": "L2"},
        {"expr": "Math.abs(window.__3D_STATE__.outputSpeed) > Math.abs(before.outputSpeed)", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "(function(){ return window.__3D_STATE__.gearAngles.every(a => Math.abs(a) < 0.01); })()", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gearsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "1"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.selectedGear === 0", "tier": "L2"},
        {"expr": "document.getElementById('hud-selected') !== null", "tier": "L2"}
      ]}
    }
  ]
}
