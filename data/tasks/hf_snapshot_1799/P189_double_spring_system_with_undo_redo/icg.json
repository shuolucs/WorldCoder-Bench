      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "Math.abs(window.__3D_STATE__.massA_pos.y - 3.5) < 0.1",
        "Math.abs(window.__3D_STATE__.massB_pos.y - 2.0) < 0.1",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S8",
      "name": "DragModeActive",
      "conditions": [
        "window.__3D_STATE__.dragMode === true",
        "window.__3D_STATE__.simRunning === false"
