{
  "task_id": "P320_procedural_geographic_flight_routes",
  "affordances": [
    {
      "id": "A1",
      "name": "Globe",
      "type": "3d_object",
      "semantic": "Earth-like wireframe globe sphere at origin",
      "locator_hints": [
        "sphere at origin with radius 5"
      ]
    },
    {
      "id": "A2",
      "name": "FlightRoutes",
      "type": "3d_object",
      "semantic": "5 colored arc tubes representing flight paths between cities",
      "locator_hints": [
        "TubeGeometry arcs above globe surface"
      ]
    },
    {
      "id": "A3",
      "name": "Planes",
      "type": "3d_object",
      "semantic": "5 white cone meshes animating along route arcs",
      "locator_hints": [
        "small white cones moving along curves"
      ]
    },
    {
      "id": "A4",
      "name": "CityMarkers",
      "type": "3d_object",
      "semantic": "5 gold sphere markers at city positions on globe",
      "locator_hints": [
        "gold spheres on globe surface"
      ]
    },
    {
      "id": "A5",
      "name": "LandmarkCamera",
      "type": "3d_object",
      "semantic": "AntiqueCamera.glb model placed at Paris on globe",
      "locator_hints": [
        "GLTF model near lat=48.8 lon=2.3"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing route/plane/speed/rotation info",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedButton",
      "type": "dom_element",
      "semantic": "Button to cycle plane speed levels",
      "locator_hints": [
        "button#speedBtn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.routeCount === 5",
        "window.__3D_STATE__.rotationEnabled === false",
        "window.__3D_STATE__.speedLevel === 'normal'",
        "window.__3D_STATE__.highlightedRoute === -1",
        "window.__3D_STATE__.selectedCity === ''"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.planeProgress.every(p => p >= 0 && p <= 1)"
      ]
    },
    {
      "id": "S2",
      "name": "RotationEnabled",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "RotationDisabled",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "RouteHighlighted",
      "conditions": [
        "window.__3D_STATE__.highlightedRoute >= 0 && window.__3D_STATE__.highlightedRoute <= 4"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedFast",
      "conditions": [
        "window.__3D_STATE__.speedLevel === 'fast'",
        "window.__3D_STATE__.speedValue === 0.006"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedSlow",
      "conditions": [
        "window.__3D_STATE__.speedLevel === 'slow'",
        "window.__3D_STATE__.speedValue === 0.001"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedNormalAgain",
      "conditions": [
        "window.__3D_STATE__.speedLevel === 'normal'",
        "window.__3D_STATE__.speedValue === 0.002"
      ]
    },
    {
      "id": "S8",
      "name": "LandmarkLoaded",
      "conditions": [
        "window.__3D_STATE__.landmarkLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('on')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('off')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('fast')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedBtn') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('slow')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#speedBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('normal')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}