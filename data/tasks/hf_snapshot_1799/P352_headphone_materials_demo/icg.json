        "PointLight in scene"
      ]
    },
    {
      "id": "A8",
      "name": "HUDBar",
      "type": "dom_element",
      "semantic": "Bottom bar showing material info",
      "locator_hints": [
        "bottom HUD element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedInitial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.materialIndex === 0",
        "window.__3D_STATE__.currentMaterial === 'Matte Black'"
      ]
    },
    {
      "id": "S1",
      "name": "BrushedAluminumSelected",
      "conditions": [
        "window.__3D_STATE__.materialIndex === 1",
        "window.__3D_STATE__.currentMaterial === 'Brushed Aluminum'"
      ]
    },
    {
      "id": "S2",
      "name": "RoseGoldSelected",
      "conditions": [
        "window.__3D_STATE__.materialIndex === 2",
        "window.__3D_STATE__.currentMaterial === 'Rose Gold'"
      ]
    },
    {
      "id": "S3",
      "name": "CarbonFiberSelected",
      "conditions": [
        "window.__3D_STATE__.materialIndex === 3",
        "window.__3D_STATE__.currentMaterial === 'Carbon Fiber'"
      ]
    },
    {
      "id": "S4",
      "name": "TranslucentWhiteSelected",
      "conditions": [
        "window.__3D_STATE__.materialIndex === 4",
        "window.__3D_STATE__.currentMaterial === 'Translucent White'"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S6",
      "name": "ExplodedView",
      "conditions": [
        "window.__3D_STATE__.exploded === true",
        "window.__3D_STATE__.explodeProgress > 0.9"
      ]
    },
    {
      "id": "S7",
      "name": "PointLightOff",
      "conditions": [
        "window.__3D_STATE__.pointLightOn === false"
      ]
    },
    {
      "id": "S8",
      "name": "CameraReset",
      "conditions": [
        "window.__3D_STATE__.autoRotateSpeed === 2.0",
        "Math.abs(window.__3D_STATE__.cameraDistance - 4.0) < 0.5"
      ]
    },
    {
      "id": "S9",
      "name": "SliderAdjusted",
      "conditions": [
        "window.__3D_STATE__.autoRotateSpeed !== 2.0"
      ]
    }
  ],
