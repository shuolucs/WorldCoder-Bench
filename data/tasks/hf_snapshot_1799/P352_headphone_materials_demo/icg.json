      ]
    },
    {
      "id": "A5",
      "name": "ExplodeButton",
      "type": "dom_element",
      "semantic": "Button to toggle explode view",
      "locator_hints": [
        "button text contains 'Explode'"
      ]
    },
    {
      "id": "A6",
      "name": "ScreenshotButton",
      "type": "dom_element",
      "semantic": "Button to take screenshot",
