{
  "task_id": "P2732_crowd_evacuation_panic_stampede_simulati",
  "affordances": [
    {
      "id": "A1",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to begin evacuation simulation",
      "locator_hints": [
        "#btn-start"
      ]
    },
    {
      "id": "A2",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume simulation",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A3",
      "name": "SecondaryPanicButton",
      "type": "dom_element",
      "semantic": "Button to trigger secondary panic wave",
      "locator_hints": [
        "#btn-secondary-panic"
      ]
    },
    {
      "id": "A4",
      "name": "UndoPanicButton",
      "type": "dom_element",
      "semantic": "Button to undo last panic trigger",
      "locator_hints": [
        "#btn-undo-panic"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "AgentPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected agent details",
      "locator_hints": [
        "#agent-panel"
      ]
    },
    {
      "id": "A7",
      "name": "CarObstacles",
      "type": "3d_object",
      "semantic": "4 parked car obstacles loaded from ClearCoatCarPaint.glb",
      "locator_hints": [
        "car",
        "obstacle"
      ]
    },
    {
      "id": "A8",
      "name": "ExitLamps",
      "type": "3d_object",
      "semantic": "2 emergency lamp beacons loaded from AnisotropyBarnLamp.glb",
      "locator_hints": [
        "lamp",
        "exit"
      ]
    },
    {
      "id": "A9",
      "name": "AgentSpheres",
      "type": "3d_object",
      "semantic": "40 agent spheres representing crowd members",
      "locator_hints": [
        "agent",
        "sphere"
      ]
    },
    {
      "id": "A10",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas for raycasting",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.totalAgents === 40",
        "window.__3D_STATE__.evacuatedCount === 0",
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.carObstacleCount === 4",
        "window.__3D_STATE__.exitLampCount === 2"
      ]
    },
    {
      "id": "S1",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.simulationPaused === false",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.simulationPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Agents_Evacuating",
      "conditions": [
        "window.__3D_STATE__.evacuatedCount > 0",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "Secondary_Panic_Active",
      "conditions": [
        "window.__3D_STATE__.secondaryPanicTriggered === true",
        "window.__3D_STATE__.maxPanic === 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "Panic_Undone",
      "conditions": [
        "window.__3D_STATE__.undoAvailable === false",
        "window.__3D_STATE__.maxPanic < 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "Camera_Toggled",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'orthographic'"
      ]
    },
    {
      "id": "S7",
      "name": "Agent_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedAgentId !== null"
      ]
    },
    {
      "id": "S8",
      "name": "Stampede_Occurring",
      "conditions": [
        "window.__3D_STATE__.fallenCount > 0",
        "window.__3D_STATE__.totalHealthLost > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Simulation_Reset",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.evacuatedCount === 0",
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === 40",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.carObstacleCount === 4",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.exitLampCount === 2",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averagePanic > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => !isNaN(a.x) && !isNaN(a.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => Math.abs(a.x) <= 40 && Math.abs(a.z) <= 40)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.speed <= 5.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.panicLevel >= 0 && a.panicLevel <= 1.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.evacuatedCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCount < 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.isEvacuated).length === window.__3D_STATE__.evacuatedCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.health >= 0 && a.health <= 1.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-secondary-panic"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.secondaryPanicTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxPanic === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoAvailable === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panicSnapshot !== null",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.panicSnapshot)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.panicLevel === 1.0).length >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-undo-panic"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoAvailable === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxPanic < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.panicLevel >= 0 && a.panicLevel <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.panicLevel === 1.0).length === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraMode === 'orthographic'",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedAgentId = window.__3D_STATE__.agents.find(a => !a.isEvacuated && !a.isFallen)?.id ?? 0; document.getElementById('agent-panel').style.display = 'block';"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAgentId !== null",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedAgentId === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agents.some(a => a.id === window.__3D_STATE__.selectedAgentId)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === 40",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.agents.filter(a => !a.isEvacuated && !a.isFallen).slice(0, 6).forEach(a => { a.panicLevel = 1.0; a.speed = 5.0; }); setTimeout(() => {}, 5000);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalHealthLost > 0 || window.__3D_STATE__.fallenCount > 0 || window.__3D_STATE__.agents.some(a => a.health < 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.health >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.isFallen).every(a => a.speed === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => !isNaN(a.x) && !isNaN(a.z) && !isNaN(a.health))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.evacuatedCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === 40",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activeCount === 40",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.evacuatedCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.health === 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAgents === window.__3D_STATE__.evacuatedCount + window.__3D_STATE__.fallenCount + window.__3D_STATE__.activeCount",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}