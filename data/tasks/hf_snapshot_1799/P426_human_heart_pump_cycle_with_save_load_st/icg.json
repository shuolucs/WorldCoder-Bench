  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.phaseName === 'DIASTOLE_RIGHT'"
      ]
    },
    {
      "id": "S1",
      "name": "ParrotLoaded",
      "conditions": [
        "window.__3D_STATE__.parrotLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "Phase1Advanced",
