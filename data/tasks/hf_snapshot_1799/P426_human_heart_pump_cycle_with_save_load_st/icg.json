        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'SYSTOLE_RIGHT'",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "Phase2Advanced",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'LUNG_TRANSIT'"
      ]
    },
    {
      "id": "S4",
      "name": "Phase3Advanced",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'SYSTOLE_LEFT'"
      ]
    },
    {
      "id": "S5",
      "name": "PlayingState",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S7",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S9",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.currentPhase >= 0",
        "window.__3D_STATE__.currentPhase <= 3"
      ]
    }
  ],
