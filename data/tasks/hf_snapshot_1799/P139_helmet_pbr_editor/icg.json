{
  "task_id": "P139_helmet_pbr_editor",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "GLB 模型 DamagedHelmet.glb",
      "locator_hints": [
        "damagedhelmet"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "材质编辑器就绪"
    },
    {
      "id": "S2",
      "name": "param_changed",
      "description": "材质参数被修改"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.roughness >= 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roughness !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.metalness !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.normalScale !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.roughness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.metalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roughness >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roughness !== before.roughness || window.__3D_STATE__.metalness !== before.metalness",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const s=document.getElementById(\"roughness\"); if(s){s.value=\"0.1\"; s.dispatchEvent(new Event(\"input\"));} })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.roughness < 0.3"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roughness !== before.roughness || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.roughness === 'number' && !isNaN(window.__3D_STATE__.roughness)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.metalness === 'number' && !isNaN(window.__3D_STATE__.metalness)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roughness < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const s=document.getElementById(\"metalness\"); if(s){s.value=\"0.9\"; s.dispatchEvent(new Event(\"input\"));} })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.metalness > 0.7"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roughness !== before.roughness || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.roughness === 'number' && !isNaN(window.__3D_STATE__.roughness)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.metalness === 'number' && !isNaN(window.__3D_STATE__.metalness)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.metalness > 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}