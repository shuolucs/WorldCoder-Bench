    {
      "id": "S2",
      "name": "CompressionActive",
      "conditions": [
        "window.__3D_STATE__.isCompressing === true",
        "window.__3D_STATE__.displacedParticleCount > 0",
        "window.__3D_STATE__.elasticPE > 0"
      ]
    },
    {
      "id": "S3",
      "name": "PostCompressionRecovery",
      "conditions": [
        "window.__3D_STATE__.isCompressing === false",
        "window.__3D_STATE__.kineticEnergy > 0",
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "PalpationMode",
      "conditions": [
        "window.__3D_STATE__.toolMode === 'palpation'",
        "window.__3D_STATE__.compressionForce <= 2"
      ]
    },
    {
      "id": "S5",
      "name": "IncisionMode",
      "conditions": [
        "window.__3D_STATE__.toolMode === 'incision'"
      ]
    },
    {
      "id": "S6",
      "name": "SpringsSevered",
      "conditions": [
        "window.__3D_STATE__.severedSpringCount > 0",
        "window.__3D_STATE__.activeSpringCount < window.__3D_STATE__.springCount"
      ]
    },
    {
      "id": "S7",
      "name": "ForceAdjusted",
      "conditions": [
        "window.__3D_STATE__.compressionForce !== 5.0"
      ]
    },
    {
      "id": "S8",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 0",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "RedoApplied",
