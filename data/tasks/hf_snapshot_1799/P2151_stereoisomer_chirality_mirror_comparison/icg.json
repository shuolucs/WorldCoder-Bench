      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.leftRotationY - (Math.PI / 12)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightRotationY === 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.leftRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chiralityCorrect === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMolecule === 'Glyceraldehyde'",
            "tier": "L2"
          }
        ]
      }
    },
