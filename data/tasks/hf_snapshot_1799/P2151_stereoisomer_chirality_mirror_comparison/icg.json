      ]
    },
    {
      "id": "A11",
      "name": "AngleDisplay",
      "type": "dom_element",
      "semantic": "Display showing measured bond angle",
      "locator_hints": [
        "#angleDisplay"
      ]
    },
    {
      "id": "A12",
      "name": "SoldierModel",
      "type": "3d_object",
      "semantic": "Decorative soldier.glb lab assistant model",
      "locator_hints": [
        "soldier",
        "position.x=10"
      ]
    },
    {
      "id": "A13",
      "name": "ChiralityLabels",
      "type": "dom_element",
      "semantic": "Labels showing R/S designation for each molecule",
      "locator_hints": [
        "#chiralityLabels"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentMolecule === 'Alanine'",
        "window.__3D_STATE__.leftRotationY === 0",
        "window.__3D_STATE__.rightRotationY === 0",
        "window.__3D_STATE__.isSuperimposed === false",
        "window.__3D_STATE__.mirrorVisible === true",
        "window.__3D_STATE__.swapCount === 0",
        "window.__3D_STATE__.leftChirality === 'R'",
        "window.__3D_STATE__.rightChirality === 'S'",
        "window.__3D_STATE__.measurementMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "SoldierLoadedAndSceneReady",
      "conditions": [
        "window.__3D_STATE__.soldierLoaded === true",
        "window.__3D_STATE__.moleculeCount === 4",
        "window.__3D_STATE__.atomCountPerMolecule === 5"
      ]
    },
    {
      "id": "S2",
      "name": "MoleculeChanged",
      "conditions": [
        "window.__3D_STATE__.currentMolecule !== 'Alanine'",
        "window.__3D_STATE__.chiralityCorrect === true"
      ]
    },
    {
      "id": "S3",
      "name": "LeftMoleculeRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.leftRotationY) > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "RightMoleculeRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.rightRotationY) > 0.01"
      ]
    },
    {
      "id": "S5",
      "name": "Superimposed",
      "conditions": [
        "window.__3D_STATE__.isSuperimposed === true",
        "window.__3D_STATE__.overlapScore < 30"
      ]
    },
    {
      "id": "S6",
      "name": "PositionsReset",
      "conditions": [
        "window.__3D_STATE__.isSuperimposed === false"
      ]
    },
    {
      "id": "S7",
      "name": "SubstituentSelected",
      "conditions": [
        "window.__3D_STATE__.selectedSubstituent !== null",
        "window.__3D_STATE__.selectedSubstituent.priority >= 1",
        "window.__3D_STATE__.selectedSubstituent.priority <= 4"
      ]
    },
    {
      "id": "S8",
      "name": "MirrorHidden",
      "conditions": [
        "window.__3D_STATE__.mirrorVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "SubstituentsSwapped",
      "conditions": [
        "window.__3D_STATE__.swapCount === 1",
        "window.__3D_STATE__.leftChirality === 'S'"
      ]
    },
    {
      "id": "S10",
      "name": "SwapUndone",
      "conditions": [
        "window.__3D_STATE__.swapCount === 0",
        "window.__3D_STATE__.leftChirality === 'R'"
      ]
    },
    {
      "id": "S11",
      "name": "MeasurementModeActive",
      "conditions": [
        "window.__3D_STATE__.measurementMode === true"
      ]
    },
    {
      "id": "S12",
      "name": "AngleMeasured",
      "conditions": [
        "window.__3D_STATE__.measuredAngle > 100",
        "window.__3D_STATE__.measuredAngle < 120"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soldierLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculeCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCountPerMolecule === 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tetrahedralAngle - 109.47) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chiralityCorrect === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('moleculeSelect').value = 'Glyceraldehyde'; document.getElementById('moleculeSelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMolecule === 'Glyceraldehyde'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chiralityCorrect === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftChirality === 'R'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightChirality === 'S'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.swapCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
