{
  "task_id": "P2151_stereoisomer_chirality_mirror_comparison",
  "affordances": [
    {
      "id": "A1",
      "name": "MoleculeSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select one of 4 chiral molecules",
      "locator_hints": [
        "#moleculeSelect",
        "select"
      ]
    },
    {
      "id": "A2",
      "name": "LeftMolecule",
      "type": "3d_object",
      "semantic": "R-enantiomer molecule group on the left side of the mirror",
      "locator_hints": [
        "position.x < 0",
        "R-enantiomer"
      ]
    },
    {
      "id": "A3",
      "name": "RightMolecule",
      "type": "3d_object",
      "semantic": "S-enantiomer molecule group on the right side of the mirror",
      "locator_hints": [
        "position.x > 0",
        "S-enantiomer"
      ]
    },
    {
      "id": "A4",
      "name": "MirrorPlane",
      "type": "3d_object",
      "semantic": "Translucent vertical mirror plane at x=0",
      "locator_hints": [
        "PlaneGeometry",
        "x=0"
      ]
    },
    {
      "id": "A5",
      "name": "SuperimposeBtn",
      "type": "dom_element",
      "semantic": "Button to superimpose both enantiomers for comparison",
      "locator_hints": [
        "#superimposeBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetPositionsBtn",
      "type": "dom_element",
      "semantic": "Button to reset molecules to original positions",
      "locator_hints": [
        "#resetPositionsBtn"
      ]
    },
    {
      "id": "A7",
      "name": "MirrorToggleBtn",
      "type": "dom_element",
      "semantic": "Button to toggle mirror plane visibility",
      "locator_hints": [
        "#mirrorToggleBtn"
      ]
    },
    {
      "id": "A8",
