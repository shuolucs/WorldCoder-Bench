  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.player1Score === 0",
        "window.__3D_STATE__.player2Score === 0",
        "window.__3D_STATE__.fishRemaining === 6",
        "window.__3D_STATE__.gameActive === true"
      ]
    },
    {
      "id": "S1",
      "name": "Player1Moved",
      "conditions": [
        "window.__3D_STATE__.player1BoatX !== -8 || window.__3D_STATE__.player1BoatZ !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "Player1Casting",
      "conditions": [
        "window.__3D_STATE__.player1Casting === true"
      ]
    },
    {
      "id": "S3",
      "name": "Player1CaughtFish",
      "conditions": [
        "window.__3D_STATE__.player1Score >= 1",
        "window.__3D_STATE__.fishRemaining <= 5"
      ]
    },
    {
      "id": "S4",
      "name": "Player2Moved",
      "conditions": [
        "window.__3D_STATE__.player2BoatX !== 8 || window.__3D_STATE__.player2BoatZ !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.player1Score === 0",
        "window.__3D_STATE__.player2Score === 0",
        "window.__3D_STATE__.fishRemaining === 6"
      ]
    }
  ],
