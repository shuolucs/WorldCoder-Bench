{
  "task_id": "P389_ring_designer_with_gems_with_dynamic_dif",
  "affordances": [
    {
      "id": "A1",
      "name": "Ring",
      "type": "3d_object",
      "semantic": "The main ring torus that auto-rotates",
      "locator_hints": [
        "torus at origin",
        "gold metallic ring"
      ]
    },
    {
      "id": "A2",
      "name": "Gems",
      "type": "3d_object",
      "semantic": "Icosahedron gems placed on the ring",
      "locator_hints": [
        "small gems on ring surface"
      ]
    },
    {
      "id": "A3",
      "name": "SoldierModel",
      "type": "3d_object",
      "semantic": "Soldier GLB model for scale reference",
      "locator_hints": [
        "small figure at (2.5, -1, 0)"
      ]
    },
    {
      "id": "A4",
      "name": "AddGemButton",
      "type": "dom_element",
      "semantic": "Button to add a gem",
      "locator_hints": [
        "#btn-add-gem"
      ]
    },
    {
      "id": "A5",
      "name": "RemoveGemButton",
      "type": "dom_element",
      "semantic": "Button to remove a gem",
      "locator_hints": [
        "#btn-remove-gem"
      ]
    },
    {
      "id": "A6",
      "name": "DifficultyButton",
      "type": "dom_element",
      "semantic": "Button to cycle difficulty",
      "locator_hints": [
        "#btn-difficulty"
      ]
    },
    {
      "id": "A7",
      "name": "GoldButton",
      "type": "dom_element",
      "semantic": "Button to set gold material",
      "locator_hints": [
        "#btn-gold"
      ]
    },
    {
      "id": "A8",
      "name": "SilverButton",
      "type": "dom_element",
      "semantic": "Button to set silver material",
      "locator_hints": [
        "#btn-silver"
      ]
    },
    {
      "id": "A9",
      "name": "RoseGoldButton",
      "type": "dom_element",
      "semantic": "Button to set rose gold material",
      "locator_hints": [
        "#btn-rosegold"
      ]
    },
    {
      "id": "A10",
      "name": "PriceDisplay",
      "type": "dom_element",
      "semantic": "Shows calculated price",
      "locator_hints": [
        "#price-display"
      ]
    },
    {
      "id": "A11",
      "name": "DifficultyDisplay",
      "type": "dom_element",
      "semantic": "Shows current difficulty",
      "locator_hints": [
        "#difficulty-display"
      ]
    },
    {
      "id": "A12",
      "name": "GemCountDisplay",
      "type": "dom_element",
      "semantic": "Shows current gem count",
      "locator_hints": [
        "#gem-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.gemCount === 1",
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.ringMaterial === 'gold'",
        "window.__3D_STATE__.price === 600",
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S1",
      "name": "MultipleGems",
      "conditions": [
        "window.__3D_STATE__.gemCount === 3",
        "window.__3D_STATE__.price === 800"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyMedium",
      "conditions": [
        "window.__3D_STATE__.difficulty === 2",
        "window.__3D_STATE__.gemCount === 3",
        "window.__3D_STATE__.price === 1250"
      ]
    },
    {
      "id": "S3",
      "name": "SilverMaterial",
      "conditions": [
        "window.__3D_STATE__.ringMaterial === 'silver'",
        "window.__3D_STATE__.price === 1050"
      ]
    },
    {
      "id": "S4",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S5",
      "name": "GemRemoved",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.ringMaterial === 'silver'"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyExpert",
      "conditions": [
        "window.__3D_STATE__.difficulty === 4",
        "window.__3D_STATE__.gemCount === 2"
      ]
    },
    {
      "id": "S7",
      "name": "RoseGoldExpert",
      "conditions": [
        "window.__3D_STATE__.ringMaterial === 'rosegold'",
        "window.__3D_STATE__.difficulty === 4",
        "window.__3D_STATE__.gemCount === 2",
        "window.__3D_STATE__.price === 2050"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-add-gem",
        "repeat": 2
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gem-count').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-difficulty"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('difficulty-display').textContent.toLowerCase().includes('medium') || document.getElementById('difficulty-display').textContent.includes('2')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('price-display').textContent.includes('1250')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-silver"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('price-display').textContent.includes('1050')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-remove-gem"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gem-count').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-difficulty",
        "repeat": 2
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('difficulty-display').textContent.toLowerCase().includes('expert') || document.getElementById('difficulty-display').textContent.includes('4')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-rosegold"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('price-display').textContent.includes('2050')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}