      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.roundNumber === 1",
        "window.__3D_STATE__.matchOver === false"
      ]
    },
    {
      "id": "S1",
      "name": "MatchActive",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.matchOver === false",
        "window.__3D_STATE__.p1Health > 0",
        "window.__3D_STATE__.p2Health > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerAttacking",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.p1Attacking === true"
      ]
    },
    {
      "id": "S3",
      "name": "P2DamagedByAttack",
      "conditions": [
        "window.__3D_STATE__.p2Health < 100",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S4",
      "name": "ParticlesActive",
      "conditions": [
        "window.__3D_STATE__.activeParticles > 0"
      ]
    },
    {
      "id": "S5",
      "name": "MatchOverPlayerWins",
      "conditions": [
