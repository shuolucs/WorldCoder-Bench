  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.gameState === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.fishRemaining === 5",
        "window.__3D_STATE__.castCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Line_Cast",
      "conditions": [
        "window.__3D_STATE__.gameState === 'cast'",
        "window.__3D_STATE__.lineAttached === true",
        "window.__3D_STATE__.castCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Fish_Biting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'biting'",
        "window.__3D_STATE__.bobberY < 0"
      ]
    },
    {
      "id": "S3",
      "name": "Fish_Hooked",
      "conditions": [
        "window.__3D_STATE__.gameState === 'hooked' || window.__3D_STATE__.gameState === 'reeling'"
      ]
    },
    {
      "id": "S4",
      "name": "Fish_Caught",
      "conditions": [
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.fishRemaining <= 4",
        "window.__3D_STATE__.gameState === 'idle'"
      ]
    },
    {
      "id": "S5",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.fishRemaining === 5",
        "window.__3D_STATE__.gameState === 'idle'"
      ]
    }
  ],
