    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#saveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedState !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedState.unzipProgress === 20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedState.rotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "localStorage.getItem('dna_save_state') !== null",
            "tier": "L0"
          }
        ]
