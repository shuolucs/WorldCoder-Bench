      "locator_hints": [
        "#rezipBtn"
      ]
    },
    {
      "id": "A4",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state to localStorage",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A5",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load saved state from localStorage",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling rotation speed multiplier",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A7",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD showing base pair count, unzip progress, rotation",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A8",
      "name": "SaveStatus",
      "type": "dom_element",
      "semantic": "Status text showing save/load confirmation",
      "locator_hints": [
        "#saveStatus"
      ]
    },
    {
      "id": "A9",
      "name": "CollisionWorldModel",
      "type": "3d_object",
      "semantic": "Loaded GLB model as decorative platform",
      "locator_hints": [
        "collision-world.glb",
        "modelLoaded"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.basePairCount === 20",
        "window.__3D_STATE__.unzipProgress === 0",
        "window.__3D_STATE__.isUnzipping === false",
        "window.__3D_STATE__.isRezipping === false"
      ]
    },
    {
      "id": "S1",
      "name": "Unzipping_In_Progress",
      "conditions": [
        "window.__3D_STATE__.isUnzipping === true",
        "window.__3D_STATE__.unzipProgress > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Fully_Unzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 20",
        "window.__3D_STATE__.isUnzipping === false"
      ]
    },
    {
      "id": "S3",
      "name": "Rezipping_In_Progress",
      "conditions": [
        "window.__3D_STATE__.isRezipping === true",
        "window.__3D_STATE__.unzipProgress < 20"
      ]
    },
    {
      "id": "S4",
      "name": "Fully_Rezipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 0",
        "window.__3D_STATE__.isRezipping === false"
      ]
    },
    {
      "id": "S5",
      "name": "State_Saved",
      "conditions": [
        "window.__3D_STATE__.savedState !== null"
      ]
    },
    {
      "id": "S6",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.savedState !== null"
      ]
    },
    {
      "id": "S7",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed !== 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#unzipBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 7000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
