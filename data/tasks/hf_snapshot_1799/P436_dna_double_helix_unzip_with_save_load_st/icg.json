{
  "task_id": "P436_dna_double_helix_unzip_with_save_load_st",
  "affordances": [
    {
      "id": "A1",
      "name": "DNAHelixGroup",
      "type": "3d_object",
      "semantic": "The parent group containing all DNA base pair geometry",
      "locator_hints": [
        "dnaGroup",
        "scene.children containing helix"
      ]
    },
    {
      "id": "A2",
      "name": "UnzipButton",
      "type": "dom_element",
      "semantic": "Button to start unzipping the DNA from top",
      "locator_hints": [
        "#unzipBtn"
      ]
    },
    {
      "id": "A3",
      "name": "RezipButton",
      "type": "dom_element",
