      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.aircraftStates) && window.__3D_STATE__.aircraftStates.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.aircraftStates[0].callsign === 'ION-01' && window.__3D_STATE__.aircraftStates[1].callsign === 'ION-02'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDepartures + window.__3D_STATE__.totalAircraftInScene === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conflictCount === 0 && window.__3D_STATE__.runwayOccupant === null",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.aircraftStates[0].position.x - (-350)) < 5 && Math.abs(window.__3D_STATE__.aircraftStates[0].position.z - (-80)) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
