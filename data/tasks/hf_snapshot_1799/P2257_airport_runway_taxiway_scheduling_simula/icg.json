  "states": [
    {
      "id": "S0",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.totalDepartures === 0",
        "window.__3D_STATE__.conflictCount === 0",
        "window.__3D_STATE__.totalAircraftInScene === 4",
        "window.__3D_STATE__.runwayOccupant === null",
        "window.__3D_STATE__.aircraftStates.every(a => a.status === 'idle')"
      ]
    },
    {
      "id": "S1",
      "name": "AircraftSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAircraftIndex !== null",
        "typeof window.__3D_STATE__.selectedAircraftIndex === 'number'"
      ]
    },
    {
      "id": "S2",
      "name": "SingleAircraftTaxiing",
      "conditions": [
        "window.__3D_STATE__.aircraftStates.some(a => a.status === 'taxiing')",
        "window.__3D_STATE__.conflictCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "AircraftHoldingAtIntersection",
      "conditions": [
        "window.__3D_STATE__.aircraftStates.some(a => a.status === 'holding')"
      ]
    },
    {
      "id": "S4",
      "name": "AircraftOnRunway",
      "conditions": [
        "window.__3D_STATE__.runwayOccupant !== null",
        "window.__3D_STATE__.aircraftStates.some(a => a.status === 'takeoff_roll')"
      ]
    },
    {
      "id": "S5",
      "name": "OneDeparted",
      "conditions": [
        "window.__3D_STATE__.totalDepartures >= 1",
        "window.__3D_STATE__.totalAircraftInScene <= 3"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "AutoScheduled",
      "conditions": [
        "window.__3D_STATE__.schedulingQueue.length >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.totalDepartures === 0",
        "window.__3D_STATE__.totalAircraftInScene === 4"
      ]
    }
  ],
  "transitions": [
