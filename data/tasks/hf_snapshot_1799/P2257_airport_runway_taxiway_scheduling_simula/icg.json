      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new PointerEvent('pointerdown', {clientX: rect.left + rect.width * 0.15, clientY: rect.top + rect.height * 0.6, bubbles: true}); canvas.dispatchEvent(evt);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAircraftIndex !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedAircraftIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedAircraftIndex >= 0 && window.__3D_STATE__.selectedAircraftIndex <= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.aircraftStates.every(a => a.status === 'idle')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('aircraft-info') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
