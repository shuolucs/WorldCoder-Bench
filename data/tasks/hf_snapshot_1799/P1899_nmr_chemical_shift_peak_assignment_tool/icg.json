{
  "task_id": "P1899_nmr_chemical_shift_peak_assignment_tool",
  "affordances": [
    {
      "id": "A1",
      "name": "MolecularModel",
      "type": "3d_object",
      "semantic": "3D ball-and-stick model of ethanol with 9 atoms and 8 bonds",
      "locator_hints": [
        "atoms are spheres with userData.label",
        "bonds are cylinders",
        "centered around x=-3"
      ]
    },
    {
      "id": "A2",
      "name": "SpectrumPlane",
      "type": "3d_object",
      "semantic": "Flat plane displaying the NMR spectrum with three Gaussian peaks",
      "locator_hints": [
        "PlaneGeometry at x=3.5",
        "CanvasTexture with spectrum"
      ]
    },
    {
      "id": "A3",
      "name": "ToggleAssignModeButton",
      "type": "dom_element",
      "semantic": "Button to switch between view and assign modes",
      "locator_hints": [
        "button with text 'Toggle Assign Mode'"
      ]
    },
    {
      "id": "A4",
      "name": "ClearAssignmentsButton",
      "type": "dom_element",
      "semantic": "Button to remove all peak assignments and lines",
      "locator_hints": [
        "button with text 'Clear Assignments'"
      ]
    },
    {
      "id": "A5",
      "name": "ValidateButton",
      "type": "dom_element",
      "semantic": "Button to validate correctness of assignments and compute score",
      "locator_hints": [
        "button with text 'Validate'"
      ]
    },
    {
      "id": "A6",
      "name": "IntegrationPanel",
      "type": "dom_element",
      "semantic": "Panel showing hydrogen integration ratios for assigned peaks",
      "locator_hints": [
        "#integration-panel"
      ]
    },
    {
      "id": "A7",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "DOM element showing validation score 0-3",
      "locator_hints": [
        "#score-display"
      ]
    },
    {
      "id": "A8",
      "name": "AssignmentLines",
      "type": "3d_object",
      "semantic": "Colored 3D lines connecting atoms to their assigned spectrum peaks",
      "locator_hints": [
        "Line geometries in scene"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialViewMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'view'",
        "window.__3D_STATE__.atomCount === 9",
        "window.__3D_STATE__.bondCount === 8",
        "window.__3D_STATE__.spectrumRendered === true",
        "window.__3D_STATE__.assignments.length === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AssignModeActive",
      "conditions": [
        "window.__3D_STATE__.mode === 'assign'",
        "window.__3D_STATE__.selectedAtom === null"
      ]
    },
    {
      "id": "S2",
      "name": "AtomSelected",
      "conditions": [
        "window.__3D_STATE__.mode === 'assign'",
        "window.__3D_STATE__.selectedAtom !== null"
      ]
    },
    {
      "id": "S3",
      "name": "OneAssignmentMade",
      "conditions": [
        "window.__3D_STATE__.assignments.length === 1",
        "window.__3D_STATE__.assignmentLines === 1"
      ]
    },
    {
      "id": "S4",
      "name": "AllAssignmentsMade",
      "conditions": [
        "window.__3D_STATE__.assignments.length === 3",
        "window.__3D_STATE__.assignmentLines === 3"
      ]
    },
    {
      "id": "S5",
      "name": "ValidationComplete",
      "conditions": [
        "window.__3D_STATE__.validated === true",
        "window.__3D_STATE__.score !== null"
      ]
    },
    {
      "id": "S6",
      "name": "AssignmentsCleared",
      "conditions": [
        "window.__3D_STATE__.assignments.length === 0",
        "window.__3D_STATE__.assignmentLines === 0",
        "window.__3D_STATE__.score === null"
      ]
    },
    {
      "id": "S7",
      "name": "BackToViewMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'view'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spectrumRendered === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peaks) && window.__3D_STATE__.peaks.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peaks[0].center_ppm === 1.2 && window.__3D_STATE__.peaks[1].center_ppm === 3.7 && window.__3D_STATE__.peaks[2].center_ppm === 2.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.peakPositions) && window.__3D_STATE__.peakPositions.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peakPositions.some(p => p.id === 'A' && p.ppm === 1.2)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakPositions.some(p => p.id === 'B' && p.ppm === 3.7)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakPositions.some(p => p.id === 'C' && p.ppm === 2.6)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.integrationRatios.methyl === 3 && window.__3D_STATE__.integrationRatios.methylene === 2 && window.__3D_STATE__.integrationRatios.hydroxyl === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Toggle Assign Mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'assign'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignmentLines === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const scene = document.querySelector('canvas'); const evt = new MouseEvent('click', { clientX: Math.round(window.innerWidth * 0.25), clientY: Math.round(window.innerHeight * 0.5), bubbles: true }); scene.dispatchEvent(evt); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'assign'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedAtom === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedAtom.group === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['methyl','methylene','hydroxyl'].includes(window.__3D_STATE__.selectedAtom.group)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const s = window.__3D_STATE__; s.selectedAtom = { label: 'C1', group: 'methyl', element: 'C' }; const canvas = document.querySelector('canvas'); const evt = new MouseEvent('click', { clientX: Math.round(window.innerWidth * 0.75), clientY: Math.round(window.innerHeight * 0.5), bubbles: true }); canvas.dispatchEvent(evt); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assignments.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignmentLines >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments[0] !== undefined && typeof window.__3D_STATE__.assignments[0].atomGroup === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments[0] !== undefined && typeof window.__3D_STATE__.assignments[0].peakId === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments[0] !== undefined && typeof window.__3D_STATE__.assignments[0].ppm === 'number' && !isNaN(window.__3D_STATE__.assignments[0].ppm)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const s = window.__3D_STATE__; const assigned = s.assignments.map(a => a.atomGroup); const groups = ['methyl','methylene','hydroxyl']; const peakMap = { methyl: 'A', methylene: 'B', hydroxyl: 'C' }; const ppmMap = { methyl: 1.2, methylene: 3.7, hydroxyl: 2.6 }; groups.forEach(g => { if (!assigned.includes(g)) { s.selectedAtom = { label: g === 'methyl' ? 'H1a' : g === 'methylene' ? 'H2a' : 'OH', group: g, element: 'H' }; if (typeof window.__assignPeak === 'function') { window.__assignPeak(g, peakMap[g], ppmMap[g]); } else { s.assignments.push({ atomGroup: g, peakId: peakMap[g], ppm: ppmMap[g] }); s.peaks.find(p => p.id === peakMap[g]).assignedGroup = g; s.assignmentLines = s.assignments.length; } } }); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assignments.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignmentLines === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments.some(a => a.atomGroup === 'methyl' && a.peakId === 'A')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments.some(a => a.atomGroup === 'methylene' && a.peakId === 'B')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments.some(a => a.atomGroup === 'hydroxyl' && a.peakId === 'C')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks.every(p => p.assignedGroup !== null)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Validate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.validated === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0 && window.__3D_STATE__.score <= 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.score)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Clear Assignments"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.assignments.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignmentLines === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peaks.every(p => p.assignedGroup === null)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validated === false || window.__3D_STATE__.score === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Toggle Assign Mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'view'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignments.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assignmentLines === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'view'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spectrumRendered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.integrationRatios.methyl + window.__3D_STATE__.integrationRatios.methylene + window.__3D_STATE__.integrationRatios.hydroxyl === 6",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}