{
  "task_id": "P199_avalanche_simulation_on_terrain_with_und",
  "affordances": [
    {
      "id": "A1",
      "name": "Terrain",
      "type": "3d_object",
      "semantic": "Mountainous terrain mesh with sine-wave displacement",
      "locator_hints": [
        "PlaneGeometry with displaced vertices",
        "mesh with green-to-white gradient"
      ]
    },
    {
      "id": "A2",
      "name": "SnowParticles",
      "type": "3d_object",
      "semantic": "Array of white sphere particles representing avalanche snow",
      "locator_hints": [
        "white SphereGeometry radius 0.3",
        "clustered at terrain peak initially"
      ]
    },
    {
      "id": "A3",
      "name": "FishModel",
      "type": "3d_object",
      "semantic": "Barramundi fish GLB model in valley pond area",
      "locator_hints": [
        "loaded via GLTFLoader",
        "position near (-10, 0, -10)"
      ]
    },
    {
      "id": "A4",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the avalanche simulation",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A5",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause the simulation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last simulation state",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A8",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone simulation state",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.particleCount === 50",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationAdvanced",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime >= 2.0",
        "window.__3D_STATE__.undoStackSize >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.lastAction === 'pause'"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.redoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesAdded",
      "conditions": [
        "window.__3D_STATE__.particleCount === 60",
        "window.__3D_STATE__.lastAction === 'addParticles'"
      ]
    },
    {
      "id": "S7",
      "name": "AfterExplosion",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'explosion'"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.particleCount === 50",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S9",
      "name": "LongRunSettled",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime >= 5.0",
        "window.__3D_STATE__.particlesAtRest > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
