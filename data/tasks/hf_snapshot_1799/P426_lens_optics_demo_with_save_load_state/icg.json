  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.lanternLoaded === true",
        "window.__3D_STATE__.lanternX === -8",
        "window.__3D_STATE__.screenX === 6",
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.lensType === 'converging'"
      ]
    },
    {
      "id": "S1",
      "name": "InitialOpticsComputed",
      "conditions": [
        "window.__3D_STATE__.objectDistance === 8",
        "Math.abs(window.__3D_STATE__.imageDistance - 4.8) < 0.1",
        "window.__3D_STATE__.imageType === 'Real'",
        "window.__3D_STATE__.rayCount === 3"
      ]
    },
    {
      "id": "S2",
      "name": "LanternMoved",
      "conditions": [
        "window.__3D_STATE__.lanternX !== -8",
        "window.__3D_STATE__.lanternX >= -12",
        "window.__3D_STATE__.lanternX <= -2"
      ]
    },
    {
      "id": "S3",
      "name": "ScreenMoved",
      "conditions": [
        "window.__3D_STATE__.screenX !== 6"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedState !== null"
      ]
    },
    {
      "id": "S5",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.savedState !== null"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.lanternX === -8",
        "window.__3D_STATE__.screenX === 6"
      ]
    },
    {
      "id": "S7",
      "name": "DivergingLens",
      "conditions": [
        "window.__3D_STATE__.lensType === 'diverging'",
        "window.__3D_STATE__.focalLength === -3"
      ]
    },
    {
      "id": "S8",
      "name": "VirtualImageState",
      "conditions": [
        "window.__3D_STATE__.imageType === 'Virtual'",
        "window.__3D_STATE__.imageDistance < 0"
      ]
    },
    {
      "id": "S9",
      "name": "ImageFocusedOnScreen",
      "conditions": [
        "window.__3D_STATE__.isImageOnScreen === true"
      ]
    }
  ],
