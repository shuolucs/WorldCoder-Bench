  "affordances": [
    {
      "id": "A1",
      "name": "DragonModel",
      "type": "3d_object",
      "semantic": "The loaded DragonAttenuation.glb model at origin, semi-transparent with wireframe overlay",
      "locator_hints": [
        "GLTFLoader loaded model",
        "centered at origin"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "2000 particles rendered as THREE.Points with additive blending",
      "locator_hints": [
        "THREE.Points",
        "BufferGeometry with 2000 vertices"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing mode, theme, counts, and stats",
      "locator_hints": [
        "#hud",
        "div with id hud"
      ]
    },
    {
      "id": "A4",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "The Three.js WebGL canvas for click interactions",
      "locator_hints": [
        "canvas",
        "renderer.domElement"
      ]
    },
    {
      "id": "A5",
      "name": "BurstParticles",
      "type": "3d_object",
      "semantic": "Temporary particles spawned on mouse click that fade over 2 seconds",
      "locator_hints": [
        "temporary particles",
        "burst particles"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Default",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentMode === 0",
        "window.__3D_STATE__.currentTheme === 0",
        "window.__3D_STATE__.particleCount === 2000"
      ]
    },
    {
      "id": "S2",
      "name": "Mode_Explode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 1",
        "window.__3D_STATE__.currentModeName === 'EXPLODE'"
      ]
    },
    {
      "id": "S3",
      "name": "Mode_Attract",
      "conditions": [
        "window.__3D_STATE__.currentMode === 2",
        "window.__3D_STATE__.currentModeName === 'ATTRACT'"
      ]
    },
    {
      "id": "S4",
      "name": "Mode_Wave",
      "conditions": [
        "window.__3D_STATE__.currentMode === 3",
        "window.__3D_STATE__.currentModeName === 'WAVE'"
      ]
    },
    {
      "id": "S5",
      "name": "Theme_Fire",
      "conditions": [
        "window.__3D_STATE__.currentTheme === 1",
        "window.__3D_STATE__.currentThemeName === 'FIRE'"
      ]
    },
    {
      "id": "S6",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S8",
      "name": "Size_Increased",
      "conditions": [
        "window.__3D_STATE__.sizeMultiplier === 1.25"
      ]
    },
    {
      "id": "S9",
      "name": "Dragon_Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.dragonRotationSpeed !== 0.5"
      ]
    },
    {
      "id": "S10",
      "name": "Burst_Triggered",
      "conditions": [
        "window.__3D_STATE__.burstCount >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.currentMode === 0",
        "window.__3D_STATE__.currentTheme === 0",
        "window.__3D_STATE__.sizeMultiplier === 1.0"
      ]
    }
  ],
