{
  "task_id": "P2179_tonemapping_operator_comparison_dashboar",
  "affordances": [
    {
      "id": "A1",
      "name": "FerrariModel",
      "type": "3d_object",
      "semantic": "The loaded ferrari.glb 3D car model centered in the scene",
      "locator_hints": [
        "GLTF loaded model",
        "child of scene or model group"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Reflective ground plane beneath the car",
      "locator_hints": [
        "MeshStandardMaterial plane at model base"
      ]
    },
    {
      "id": "A3",
      "name": "NextTonemapButton",
      "type": "dom_element",
      "semantic": "Button to cycle to next tonemapping operator",
      "locator_hints": [
        "#btn-next-tonemap"
      ]
    },
    {
      "id": "A4",
      "name": "PrevTonemapButton",
      "type": "dom_element",
      "semantic": "Button to cycle to previous tonemapping operator",
      "locator_hints": [
        "#btn-prev-tonemap"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset tonemapping and exposure to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleRotateButton",
      "type": "dom_element",
      "semantic": "Button to toggle auto-rotation of the model",
      "locator_hints": [
        "#btn-toggle-rotate"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Overlay panel showing current tonemapping and exposure info",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A8",
      "name": "HUDTonemapping",
      "type": "dom_element",
      "semantic": "Span displaying current tonemapping operator name",
      "locator_hints": [
        "#hud-tonemapping"
      ]
    },
    {
      "id": "A9",
      "name": "HUDExposure",
      "type": "dom_element",
      "semantic": "Span displaying current exposure value",
      "locator_hints": [
        "#hud-exposure"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedInitialState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.tonemappingMode === 0",
        "window.__3D_STATE__.exposure === 1.0",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
      "name": "TonemappingCycledOnce",
      "conditions": [
        "window.__3D_STATE__.tonemappingMode === 1",
        "window.__3D_STATE__.tonemappingName === 'Linear'"
      ]
    },
    {
      "id": "S2",
      "name": "TonemappingAtACES",
      "conditions": [
        "window.__3D_STATE__.tonemappingMode === 4",
        "window.__3D_STATE__.tonemappingName === 'ACESFilmic'"
      ]
    },
    {
      "id": "S3",
      "name": "ExposureIncreased",
      "conditions": [
        "window.__3D_STATE__.exposure === 1.3"
      ]
    },
    {
      "id": "S4",
      "name": "ExposureDecreased",
      "conditions": [
        "window.__3D_STATE__.exposure === 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateEnabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S6",
      "name": "RotationAccumulated",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.modelRotationY > 0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.tonemappingMode === 0",
        "window.__3D_STATE__.tonemappingName === 'None'",
        "window.__3D_STATE__.exposure === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingName === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposure === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next-tonemap"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tonemappingMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingName === 'Linear'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererToneMapping === 1",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-tonemapping').textContent.includes('Linear')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposure === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.querySelector('#btn-next-tonemap').click(); await new Promise(r=>setTimeout(r,100));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tonemappingMode === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingName === 'ACESFilmic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererToneMapping === 4",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-tonemapping').textContent.includes('ACES')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.exposure === 1.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposure >= 0.1 && window.__3D_STATE__.exposure <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.exposure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.exposure)",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-exposure').textContent.includes('1.3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.exposure === 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-exposure').textContent.includes('1.0')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingMode === 4",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.exposure)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-rotate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelRotationY > 0.3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraPosition.x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tonemappingMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tonemappingName === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposure === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererToneMapping === 0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-tonemapping').textContent.includes('None')",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud-exposure').textContent.includes('1.0')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}