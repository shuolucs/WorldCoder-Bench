        "window.__3D_STATE__.selectedJointColor === '#ffff00'"
      ]
    },
    {
      "id": "S2",
      "name": "FK_Angle_Adjusted",
      "conditions": [
        "window.__3D_STATE__.upperAngleFK !== 0",
        "Math.abs(window.__3D_STATE__.chainLength - 3.0) < 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "Blend_Partial",
      "conditions": [
