{
  "task_id": "P336_multiplayer_stock_market_landscape",
  "affordances": [
    {
      "id": "A1",
      "name": "StockTowers",
      "type": "3d_object",
      "semantic": "Five 3D bar towers representing stock prices",
      "locator_hints": [
        "BoxGeometry towers at x=-20,-10,0,10,20"
      ]
    },
    {
      "id": "A2",
      "name": "PlayerAvatars",
      "type": "3d_object",
      "semantic": "Four colored spheres representing simulated players",
      "locator_hints": [
        "Sphere meshes orbiting the towers"
      ]
    },
    {
      "id": "A3",
      "name": "HUDTicker",
      "type": "dom_element",
      "semantic": "Market ticker showing stock prices and market cap",
      "locator_hints": [
        "#hud-ticker"
      ]
    },
    {
      "id": "A4",
      "name": "HUDDetail",
      "type": "dom_element",
      "semantic": "Selected stock detail panel",
      "locator_hints": [
        "#hud-detail"
      ]
    },
    {
      "id": "A5",
      "name": "HUDLeaderboard",
      "type": "dom_element",
      "semantic": "Player leaderboard sorted by portfolio value",
      "locator_hints": [
        "#hud-leaderboard"
      ]
    },
    {
      "id": "A6",
      "name": "TrailsButton",
      "type": "dom_element",
      "semantic": "Toggle player trails button",
      "locator_hints": [
        "#btn-trails"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedButton",
      "type": "dom_element",
      "semantic": "Speed up simulation button",
      "locator_hints": [
        "#btn-speed"
      ]
    },
    {
      "id": "A8",
      "name": "GridFloor",
      "type": "3d_object",
      "semantic": "Ground grid plane",
      "locator_hints": [
        "GridHelper 100x100"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.stockPrices.length === 5",
        "window.__3D_STATE__.playerValues.length === 4",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.tickCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "MarketTicked",
      "conditions": [
        "window.__3D_STATE__.tickCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "StockSelected",
      "conditions": [
        "window.__3D_STATE__.selectedStock >= 0 && window.__3D_STATE__.selectedStock <= 4"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "TrailsEnabled",
      "conditions": [
        "window.__3D_STATE__.trailsEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.tickInterval <= 1000"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.stockPrices[0] === 100"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Bottom !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-detail') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-detail').textContent.includes('GOOG')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var savedTick = window.__3D_STATE__.tickCount; window.__savedTick = savedTick; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'p'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btn-trails"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('btn-trails') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btn-speed"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-detail').textContent.includes('MSFT')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S2",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
