  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.stockPrices.AAPL === 150",
        "window.__3D_STATE__.lanternCount === 4",
        "window.__3D_STATE__.cameraMode === 'orbit'"
      ]
    },
    {
      "id": "S1",
      "name": "AfterTicks",
      "conditions": [
        "window.__3D_STATE__.tickCount >= 3"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "StockSelected",
      "conditions": [
        "window.__3D_STATE__.selectedStock !== null"
      ]
    },
    {
      "id": "S4",
      "name": "TooltipShown",
      "conditions": [
        "window.__3D_STATE__.tooltipVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "TopDownView",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'topdown'"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.tickInterval === 1000"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.stockPrices.AAPL === 150",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.tickCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "StockDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedStock === null"
      ]
    }
  ],
