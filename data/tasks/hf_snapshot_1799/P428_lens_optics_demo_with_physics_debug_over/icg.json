{
  "task_id": "P428_lens_optics_demo_with_physics_debug_over",
  "affordances": [
    {
      "id": "A1",
      "name": "ObjectArrow",
      "type": "3d_object",
      "semantic": "Draggable red arrow representing the optical object",
      "locator_hints": [
        "red arrow mesh at negative x on optical axis"
      ]
    },
    {
      "id": "A2",
      "name": "Lens",
      "type": "3d_object",
      "semantic": "Thin lens at origin, toggleable between convex and concave",
      "locator_hints": [
        "cyan or magenta double-arc shape at x=0"
      ]
    },
    {
      "id": "A3",
      "name": "ImageArrow",
      "type": "3d_object",
      "semantic": "Green arrow showing computed image position and size",
      "locator_hints": [
        "green arrow mesh, position computed from thin lens equation"
      ]
    },
    {
      "id": "A4",
      "name": "DebugPanel",
      "type": "dom_element",
      "semantic": "Physics debug overlay showing optical parameters",
      "locator_hints": [
        "#debug-panel",
        "top-right corner overlay"
      ]
    },
    {
      "id": "A5",
      "name": "PrincipalRays",
      "type": "3d_object",
      "semantic": "Three principal ray lines drawn from object tip through lens to image",
      "locator_hints": [
        "yellow, orange, white lines"
      ]
    },
    {
      "id": "A6",
      "name": "FocalPoints",
      "type": "3d_object",
      "semantic": "Yellow dots at focal points on optical axis",
      "locator_hints": [
        "small yellow spheres at x=±f"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.objectX === -200",
        "window.__3D_STATE__.focalLength === 100",
        "window.__3D_STATE__.lensType === 'convex'",
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "InitialPhysicsVerified",
      "conditions": [
        "window.__3D_STATE__.objectDistance === 200",
        "window.__3D_STATE__.imageDistance === 200",
        "window.__3D_STATE__.magnification === -1.00 || window.__3D_STATE__.magnification === -1",
        "window.__3D_STATE__.imageType === 'real'",
        "window.__3D_STATE__.imageOrientation === 'inverted'"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectAtF",
      "conditions": [
        "Math.abs(window.__3D_STATE__.objectDistance - window.__3D_STATE__.focalLength) < 1",
        "Math.abs(window.__3D_STATE__.imageDistance) > 5000"
      ]
    },
    {
      "id": "S3",
      "name": "ObjectInsideF",
      "conditions": [
        "window.__3D_STATE__.objectDistance < Math.abs(window.__3D_STATE__.focalLength)",
        "window.__3D_STATE__.imageType === 'virtual'",
        "window.__3D_STATE__.imageOrientation === 'upright'"
      ]
    },
    {
      "id": "S4",
      "name": "FocalLengthChanged",
      "conditions": [
        "window.__3D_STATE__.focalLength === 150",
        "window.__3D_STATE__.isValid === true"
      ]
    },
    {
      "id": "S5",
      "name": "ConcaveLens",
      "conditions": [
        "window.__3D_STATE__.lensType === 'concave'",
        "window.__3D_STATE__.focalLength < 0",
        "window.__3D_STATE__.imageType === 'virtual'",
        "window.__3D_STATE__.imageOrientation === 'upright'"
      ]
    },
    {
      "id": "S6",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "DebugRestored",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.objectX === -200",
        "window.__3D_STATE__.focalLength === 100",
        "window.__3D_STATE__.lensType === 'convex'",
        "window.__3D_STATE__.debugVisible === true",
        "window.__3D_STATE__.imageDistance === 200"
      ]
    },
    {
      "id": "S9",
      "name": "SnapToHalfF",
      "conditions": [
        "Math.abs(window.__3D_STATE__.objectDistance - Math.abs(window.__3D_STATE__.focalLength) / 2) < 2",
        "window.__3D_STATE__.imageType === 'virtual'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectX !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectDistance !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.imageDistance !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.imageX !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.debugVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rayCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
