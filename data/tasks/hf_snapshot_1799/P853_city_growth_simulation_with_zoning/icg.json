{
  "task_id": "P853_city_growth_simulation_with_zoning",
  "affordances": [
    {
      "id": "A1",
      "name": "GridTiles",
      "type": "3d_object",
      "semantic": "10x10 grid of flat tiles representing city land parcels",
      "locator_hints": [
        "flat boxes on XZ plane",
        "gray colored initially"
      ]
    },
    {
      "id": "A2",
      "name": "Buildings",
      "type": "3d_object",
      "semantic": "Box meshes that grow on zoned tiles each tick",
      "locator_hints": [
        "taller boxes sitting on tiles",
        "colored by zone type"
      ]
    },
    {
      "id": "A3",
      "name": "ResidentialButton",
      "type": "dom_element",
      "semantic": "Button to select residential zoning tool",
      "locator_hints": [
        "#btn-residential"
      ]
    },
    {
      "id": "A4",
      "name": "CommercialButton",
      "type": "dom_element",
      "semantic": "Button to select commercial zoning tool",
      "locator_hints": [
        "#btn-commercial"
      ]
    },
    {
      "id": "A5",
      "name": "IndustrialButton",
      "type": "dom_element",
      "semantic": "Button to select industrial zoning tool",
      "locator_hints": [
        "#btn-industrial"
      ]
    },
    {
      "id": "A6",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to select clear zoning tool",
      "locator_hints": [
        "#btn-clear"
      ]
    },
    {
      "id": "A7",
      "name": "SimulateButton",
      "type": "dom_element",
      "semantic": "Button to advance simulation by one tick",
      "locator_hints": [
        "#btn-simulate"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing population, funds, and tick count",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.totalZoned === 0",
        "window.__3D_STATE__.totalBuildings === 0",
        "window.__3D_STATE__.currentTool === 'Residential'"
      ]
    },
    {
      "id": "S1",
      "name": "ToolSwitchedToCommercial",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'Commercial'"
      ]
    },
    {
      "id": "S2",
      "name": "ResidentialTileZoned",
      "conditions": [
        "window.__3D_STATE__.totalZoned >= 1",
        "window.__3D_STATE__.zoneCounts.residential >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "MultipleZonesPlaced",
      "conditions": [
        "window.__3D_STATE__.totalZoned >= 2",
        "window.__3D_STATE__.zoneCounts.residential >= 1",
        "window.__3D_STATE__.zoneCounts.commercial >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "FirstTickSimulated",
      "conditions": [
        "window.__3D_STATE__.tickCount === 1",
        "window.__3D_STATE__.totalBuildings >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "SecondTickSimulated",
      "conditions": [
        "window.__3D_STATE__.tickCount === 2"
      ]
    },
    {
      "id": "S6",
      "name": "TileCleared",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'Clear'"
      ]
    },
    {
      "id": "S7",
      "name": "IndustrialZoneAdded",
      "conditions": [
        "window.__3D_STATE__.zoneCounts.industrial >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gridSize === 10",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.tileData) && window.__3D_STATE__.tileData.length === 100",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 0 && window.__3D_STATE__.totalZoned === 0 && window.__3D_STATE__.totalBuildings === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.population === 0 && window.__3D_STATE__.funds === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxHeights === 'object' && window.__3D_STATE__.maxHeights.Residential === 4 && window.__3D_STATE__.maxHeights.Commercial === 7 && window.__3D_STATE__.maxHeights.Industrial === 3",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-commercial"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'Commercial'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTool === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneCounts.residential === 0 && window.__3D_STATE__.zoneCounts.commercial === 0 && window.__3D_STATE__.zoneCounts.industrial === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-residential').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.45; const y = rect.top + rect.height * 0.55; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'Residential'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneCounts.residential >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned === window.__3D_STATE__.zoneCounts.residential + window.__3D_STATE__.zoneCounts.commercial + window.__3D_STATE__.zoneCounts.industrial",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastClickedTile !== null && typeof window.__3D_STATE__.lastClickedTile.row === 'number'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-commercial').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.55; const y = rect.top + rect.height * 0.45; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'Commercial'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneCounts.commercial >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneCounts.residential >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned === window.__3D_STATE__.zoneCounts.residential + window.__3D_STATE__.zoneCounts.commercial + window.__3D_STATE__.zoneCounts.industrial",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-simulate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBuildings >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBuildings <= window.__3D_STATE__.totalZoned",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.population === window.__3D_STATE__.zoneCounts.residential * 10 || window.__3D_STATE__.tileData.filter(t => t.zone === 'Residential' && t.buildingHeight > 0).reduce((s,t) => s + t.buildingHeight * 10, 0) === window.__3D_STATE__.population",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.funds >= 0 && !isNaN(window.__3D_STATE__.funds)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileData.every(t => t.buildingHeight >= 0 && !isNaN(t.buildingHeight))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-simulate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileData.filter(t => t.zone === 'Residential').every(t => t.buildingHeight <= 4)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileData.filter(t => t.zone === 'Commercial').every(t => t.buildingHeight <= 7)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileData.filter(t => t.zone === 'Industrial').every(t => t.buildingHeight <= 3)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileData.filter(t => t.buildingHeight > 0).length === window.__3D_STATE__.totalBuildings",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-clear').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.45; const y = rect.top + rect.height * 0.55; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'Clear'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned === window.__3D_STATE__.zoneCounts.residential + window.__3D_STATE__.zoneCounts.commercial + window.__3D_STATE__.zoneCounts.industrial",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBuildings <= window.__3D_STATE__.totalZoned",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.population >= 0 && !isNaN(window.__3D_STATE__.population)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.funds >= 0 && !isNaN(window.__3D_STATE__.funds)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-industrial').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.5; const y = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'Industrial'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneCounts.industrial >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalZoned === window.__3D_STATE__.zoneCounts.residential + window.__3D_STATE__.zoneCounts.commercial + window.__3D_STATE__.zoneCounts.industrial",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBuildings <= window.__3D_STATE__.totalZoned",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud') !== null && document.querySelector('#hud').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}