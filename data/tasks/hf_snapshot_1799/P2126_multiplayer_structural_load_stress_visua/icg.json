{
  "task_id": "P2126_multiplayer_structural_load_stress_visua",
  "affordances": [
    {
      "id": "A1",
      "name": "BridgeDeck",
      "type": "3d_object",
      "semantic": "Clickable bridge deck surface for placing load points",
      "locator_hints": [
        "flat box at y=2 spanning x=-15 to x=15"
      ]
    },
    {
      "id": "A2",
      "name": "RobotDrone",
      "type": "3d_object",
      "semantic": "Loaded robot.glb model acting as inspection drone",
      "locator_hints": [
        "GLTF model on top of bridge"
      ]
    },
    {
      "id": "A3",
      "name": "StructuralMembers",
      "type": "3d_object",
      "semantic": "Array of truss members that change color based on stress",
      "locator_hints": [
        "BoxGeometry segments forming bridge truss"
      ]
    },
    {
      "id": "A4",
      "name": "PlayerSelect",
      "type": "dom_element",
      "semantic": "Dropdown to switch active player",
      "locator_hints": [
        "select#playerSelect"
      ]
    },
    {
      "id": "A5",
      "name": "ResetAllButton",
      "type": "dom_element",
      "semantic": "Button to reset all loads and stress",
      "locator_hints": [
        "button#resetAll"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleDeformationButton",
      "type": "dom_element",
      "semantic": "Button to toggle visual deformation",
      "locator_hints": [
        "button#toggleDeformation"
      ]
    },
    {
      "id": "A7",
      "name": "GlobalMultiplierSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling global force multiplier",
      "locator_hints": [
        "input#globalMultiplier"
      ]
    },
    {
      "id": "A8",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing integrity, status, load info",
      "locator_hints": [
        "div#hudPanel"
      ]
    },
    {
      "id": "A9",
      "name": "LoadPointArrows",
      "type": "3d_object",
      "semantic": "Cone geometry arrows representing placed load points",
      "locator_hints": [
        "ConeGeometry meshes on bridge deck"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.memberCount > 0",
        "window.__3D_STATE__.loadPoints.length === 0",
        "window.__3D_STATE__.structuralIntegrity === 100"
      ]
    },
    {
      "id": "S1",
      "name": "FirstLoadPlaced",
      "conditions": [
        "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length === 1",
        "window.__3D_STATE__.totalLoad > 0",
        "window.__3D_STATE__.structuralIntegrity < 100"
      ]
    },
    {
      "id": "S2",
      "name": "ForceIncreased",
      "conditions": [
        "window.__3D_STATE__.loadPoints.some(lp => lp.force > 20)",
        "window.__3D_STATE__.totalLoad > 20"
      ]
    },
    {
      "id": "S3",
      "name": "PlayerSwitched",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 'Player2'"
      ]
    },
    {
      "id": "S4",
      "name": "MultiPlayerLoads",
      "conditions": [
        "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "MultiplierAdjusted",
      "conditions": [
        "window.__3D_STATE__.globalMultiplier !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "DroneMovedToStress",
      "conditions": [
        "window.__3D_STATE__.droneAtHighStress === true"
      ]
    },
    {
      "id": "S7",
      "name": "LoadDeleted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'delete'"
      ]
    },
    {
      "id": "S8",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 0",
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S9",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "DeformationToggled",
      "conditions": [
        "window.__3D_STATE__.deformationVisible === false"
      ]
    },
    {
      "id": "S11",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length === 0",
        "window.__3D_STATE__.structuralIntegrity === 100"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.members === 'object' && window.__3D_STATE__.memberCount > 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'SAFE'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.reactionForces) && window.__3D_STATE__.reactionForces.length === 4",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "BridgeDeck",
        "position_hint": "center of bridge deck near x=0, z=0"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadPoints[0].playerId === 'Player1'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.loadPoints[0].force - 20) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 0 && !isNaN(window.__3D_STATE__.totalLoad)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.stress > 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadPoints.some(lp => lp.active && Math.abs(lp.force - 35) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < 100 && !isNaN(window.__3D_STATE__.structuralIntegrity)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionForces.every(rf => rf >= 0 && !isNaN(rf))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "select#playerSelect",
        "value": "Player2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePlayer === 'Player2'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('playerSelect').value === 'Player2'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('activePlayerDisplay').textContent.includes('Player2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active && lp.playerId === 'Player1').length === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "BridgeDeck",
        "position_hint": "right side of bridge near x=10, z=0"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadPoints.some(lp => lp.active && lp.playerId === 'Player2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.filter(m => m.stressRatio > 0.01).length > 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('globalMultiplier').value = '2.5'; document.getElementById('globalMultiplier').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.globalMultiplier - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < (window.__3D_STATE__._prevIntegrity || 100)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('multiplierValue').textContent.includes('2.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.stressRatio > 0.3)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.droneAtHighStress === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.robotPosition === 'object' && !isNaN(window.__3D_STATE__.robotPosition.x)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.robotPosition.y > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPosition.x >= -15 && window.__3D_STATE__.robotPosition.x <= 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.stress > 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'delete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active && lp.playerId === 'Player2').length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad < (window.__3D_STATE__._prevTotalLoad || 999)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active && lp.playerId === 'Player2').length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > (window.__3D_STATE__._postDeleteLoad || 0)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active && lp.playerId === 'Player2').length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad < 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalReactionForce - window.__3D_STATE__.totalLoad) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.structuralIntegrity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "button#toggleDeformation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.deformationVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => !isNaN(m.stress))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.stressRatio > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity >= 0 && window.__3D_STATE__.structuralIntegrity <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "button#resetAll"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadPoints.filter(lp => lp.active).length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'SAFE'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.membersOverLimit === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalReactionForce === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}