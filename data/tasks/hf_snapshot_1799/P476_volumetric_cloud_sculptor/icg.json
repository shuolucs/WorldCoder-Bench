{
  "task_id": "P476_volumetric_cloud_sculptor",
  "affordances": [
    {
      "id": "A1",
      "name": "CloudParticles",
      "type": "3d_object",
      "semantic": "Semi-transparent sphere particles forming cloud clusters",
      "locator_hints": [
        "scene children with type Group",
        "mesh objects with transparent material"
      ]
    },
    {
      "id": "A2",
      "name": "ToolButtons",
      "type": "dom_element",
      "semantic": "Bottom toolbar buttons for selecting sculpting tools",
      "locator_hints": [
        "button elements with tool names",
        "bottom toolbar"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset clouds to initial state",
      "locator_hints": [
        "button with text Reset"
      ]
    },
    {
      "id": "A4",
      "name": "AnimateToggle",
      "type": "dom_element",
      "semantic": "Toggle button for cloud animation",
      "locator_hints": [
        "button with text Animate"
      ]
    },
    {
      "id": "A5",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing tool info, particle count, wind",
      "locator_hints": [
        "top-left positioned div",
        "HUD panel"
      ]
    },
    {
      "id": "A6",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for click interactions",
      "locator_hints": [
        "canvas element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentTool === 1",
        "window.__3D_STATE__.toolName === 'add'",
        "window.__3D_STATE__.particleCount === 30",
        "window.__3D_STATE__.animateEnabled === false",
        "window.__3D_STATE__.windMagnitude === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ToolSwitchedToErase",
      "conditions": [
        "window.__3D_STATE__.currentTool === 2",
        "window.__3D_STATE__.toolName === 'erase'"
      ]
    },
    {
      "id": "S2",
      "name": "ParticlesAdded",
      "conditions": [
        "window.__3D_STATE__.particleCount > 30",
        "window.__3D_STATE__.lastAction === 'added_particles'",
        "window.__3D_STATE__.lastActionParticlesDelta > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ParticlesErased",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'erased_particles'",
        "window.__3D_STATE__.lastActionParticlesDelta < 0"
      ]
    },
    {
      "id": "S4",
      "name": "PaintToolActive",
      "conditions": [
        "window.__3D_STATE__.currentTool === 4",
        "window.__3D_STATE__.toolName === 'paint'"
      ]
    },
    {
      "id": "S5",
      "name": "TintColorChanged",
      "conditions": [
        "window.__3D_STATE__.tintColorIndex > 0",
        "window.__3D_STATE__.tintColorHex !== '#ffffff'"
      ]
    },
    {
      "id": "S6",
      "name": "WindApplied",
      "conditions": [
        "window.__3D_STATE__.currentTool === 5",
        "window.__3D_STATE__.windMagnitude > 0"
      ]
    },
    {
      "id": "S7",
      "name": "AnimationEnabled",
      "conditions": [
        "window.__3D_STATE__.animateEnabled === true",
        "window.__3D_STATE__.lastAction === 'toggled_animation'"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.particleCount === 30",
        "window.__3D_STATE__.lastAction === 'reset'",
        "window.__3D_STATE__.windMagnitude === 0"
      ]
    },
    {
      "id": "S9",
      "name": "DensityToolUsed",
      "conditions": [
        "window.__3D_STATE__.currentTool === 3",
        "window.__3D_STATE__.toolName === 'density'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialParticleCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTool === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windMagnitude === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount <= 38",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'added_particles'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionParticlesDelta >= 5 && window.__3D_STATE__.lastActionParticlesDelta <= 8",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toolName === 'erase'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'erased_particles'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionParticlesDelta < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toolName === 'paint'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintColorIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintColorHex === '#ffffff'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tintColorIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintColorHex === '#ff8844'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTool === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toolName === 'paint'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toolName === 'wind'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windMagnitude >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windMagnitude <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.windVector.x) && !isNaN(window.__3D_STATE__.windVector.y) && !isNaN(window.__3D_STATE__.windVector.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Animate"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animateEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggled_animation'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windMagnitude === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windVector.x === 0 && window.__3D_STATE__.windVector.y === 0 && window.__3D_STATE__.windVector.z === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudGroups >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.toolName === 'density'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity === 1.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}