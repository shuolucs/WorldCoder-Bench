{
  "task_id": "P195_domino_chain_reaction_with_varied_spacin",
  "affordances": [
    {
      "id": "A1",
      "name": "PushButton",
      "type": "dom_element",
      "semantic": "Button to push the first domino and start the chain reaction",
      "locator_hints": [
        "#pushButton"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all dominoes to upright position",
      "locator_hints": [
        "#resetButton"
      ]
    },
    {
      "id": "A3",
      "name": "DifficultySelect",
      "type": "dom_element",
      "semantic": "Dropdown to select difficulty (easy/medium/hard)",
      "locator_hints": [
        "#difficultySelect"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing fallen count, chain status, and time",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A5",
      "name": "Dominoes",
      "type": "3d_object",
      "semantic": "Array of 15 domino box objects arranged in a curved path",
      "locator_hints": [
        "domino mesh objects in scene"
      ]
    },
    {
      "id": "A6",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane that dominoes stand on",
      "locator_hints": [
        "ground plane mesh"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Hard",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.dominoCount === 15",
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.firstDominoPushed === false"
      ]
    },
    {
      "id": "S1",
      "name": "ChainStarted",
      "conditions": [
        "window.__3D_STATE__.firstDominoPushed === true",
        "window.__3D_STATE__.chainActive === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PartialFall",
      "conditions": [
        "window.__3D_STATE__.fallenCount > 0",
        "window.__3D_STATE__.fallenCount < window.__3D_STATE__.dominoCount",
        "window.__3D_STATE__.chainActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "ChainComplete_Hard",
      "conditions": [
        "window.__3D_STATE__.chainComplete === true",
        "window.__3D_STATE__.fallenCount === 15",
        "window.__3D_STATE__.chainActive === false"
      ]
    },
    {
      "id": "S4",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.firstDominoPushed === false",
        "window.__3D_STATE__.chainActive === false",
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyEasy",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.dominoCount === 5",
        "window.__3D_STATE__.fallenCount === 0"
      ]
    },
    {
      "id": "S6",
      "name": "ChainComplete_Easy",
      "conditions": [
        "window.__3D_STATE__.chainComplete === true",
        "window.__3D_STATE__.fallenCount === 5",
        "window.__3D_STATE__.difficulty === 'easy'"
      ]
    },
    {
      "id": "S7",
      "name": "DifficultyMedium",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'medium'",
        "window.__3D_STATE__.dominoCount === 10"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pushButton"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.firstDominoPushed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[0] > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[0] >= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastFallenIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 12000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastFallenIndex === 14",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetButton"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firstDominoPushed === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.every(a => a === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('difficultySelect').value = 'easy'; document.getElementById('difficultySelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 'easy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firstDominoPushed === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
