      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('resetButton').click(); document.getElementById('difficultySelect').value = 'medium'; document.getElementById('difficultySelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 'medium'",
