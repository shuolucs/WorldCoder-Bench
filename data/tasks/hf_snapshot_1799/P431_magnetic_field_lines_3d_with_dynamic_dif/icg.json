      ]
    },
    {
      "id": "A10",
      "name": "TestCharges",
      "type": "3d_object",
      "semantic": "Small orange spheres that follow field lines when sim runs",
      "locator_hints": [
        "small sphere meshes",
        "orange colored spheres"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.numDipoles === 2",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.selectedDipoleIndex === -1",
        "window.__3D_STATE__.testChargeCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "DipoleSelected",
      "conditions": [
        "window.__3D_STATE__.selectedDipoleIndex >= 0",
        "window.__3D_STATE__.selectedDipoleIndex <= 1"
      ]
    },
    {
      "id": "S2",
      "name": "DipoleMoved",
      "conditions": [
        "window.__3D_STATE__.selectedDipoleIndex >= 0",
        "Math.abs(window.__3D_STATE__.dipolePositions[window.__3D_STATE__.selectedDipoleIndex].x - (-3)) >= 0.5 || Math.abs(window.__3D_STATE__.dipolePositions[window.__3D_STATE__.selectedDipoleIndex].z) >= 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "DipoleRotated",
      "conditions": [
        "window.__3D_STATE__.selectedDipoleIndex >= 0",
        "window.__3D_STATE__.dipoleRotations[window.__3D_STATE__.selectedDipoleIndex] !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyLevel2",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.numDipoles === 2",
        "window.__3D_STATE__.testChargeCount === 2"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyLevel3",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.numDipoles === 3",
        "window.__3D_STATE__.testChargeCount === 3"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyLevel4WithHeatmap",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 4",
        "window.__3D_STATE__.numDipoles === 3",
        "window.__3D_STATE__.heatmapVisible === true",
        "window.__3D_STATE__.testChargeCount === 4"
      ]
    },
    {
      "id": "S7",
      "name": "DifficultyLevel5Full",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.numDipoles === 4",
        "window.__3D_STATE__.heatmapVisible === true",
        "window.__3D_STATE__.animatedFlow === true",
        "window.__3D_STATE__.testChargeCount === 5"
      ]
    },
    {
      "id": "S8",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.numDipoles === 2",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.testChargeCount === 0",
        "Math.abs(window.__3D_STATE__.dipolePositions[0].x - (-3)) < 0.01"
      ]
    }
  ],
  "transitions": [
