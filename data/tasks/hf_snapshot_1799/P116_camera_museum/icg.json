{
  "task_id": "P116_camera_museum",
  "affordances": [
    {
      "id": "A1",
      "name": "CameraModel",
      "type": "3d_object",
      "semantic": "古董相机 GLB 模型",
      "locator_hints": [
        "camera",
        "model",
        "antique"
      ]
    },
    {
      "id": "A2",
      "name": "Pedestal",
      "type": "3d_object",
      "semantic": "展台底座",
      "locator_hints": [
        "pedestal",
        "cylinder"
      ]
    },
    {
      "id": "A3",
      "name": "InfoMarker",
      "type": "3d_object",
      "semantic": "信息标记点（5个）",
      "locator_hints": [
        "marker",
        "sprite",
        "info"
      ]
    },
    {
      "id": "A4",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "右侧信息面板",
      "locator_hints": [
        "infoPanel"
      ]
    },
    {
      "id": "A5",
      "name": "XRayToggle",
      "type": "dom_element",
      "semantic": "X射线切换按钮",
      "locator_hints": [
        "xrayToggle"
      ]
    },
    {
      "id": "A6",
      "name": "HUD_SelectedCard",
      "type": "dom_element",
      "semantic": "选中卡片编号",
      "locator_hints": [
        "selectedCard"
      ]
    },
    {
      "id": "A7",
      "name": "HUD_XrayState",
      "type": "dom_element",
      "semantic": "X射线状态",
      "locator_hints": [
        "xrayState"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "default_view",
      "description": "模型加载完成，默认视角"
    },
    {
      "id": "S2",
      "name": "card_selected",
      "description": "选中了一张信息卡片"
    },
    {
      "id": "S3",
      "name": "xray_on",
      "description": "X射线模式开启"
    },
    {
      "id": "S4",
      "name": "xray_off",
      "description": "X射线模式关闭"
    },
    {
      "id": "S5",
      "name": "card_closed",
      "description": "信息面板关闭"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "模型加载完成",
        "无卡片选中",
        "X射线关闭"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCard === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.xrayActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.infoPanelVisible === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S3",
      "action": {
        "type": "click",
        "selector": "#xrayToggle"
      },
      "postconditions": [
        "X射线模式开启"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.xrayActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "click",
        "selector": "#xrayToggle"
      },
      "postconditions": [
        "X射线模式关闭"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.xrayActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const markers = document.querySelectorAll('[data-card]'); if(markers.length > 0) { markers[0].click(); return; } const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', { clientX: rect.left + rect.width * 0.45, clientY: rect.top + rect.height * 0.4, bubbles: true }); canvas.dispatchEvent(evt); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "信息卡片被选中",
        "信息面板显示"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCard >= 1 && window.__3D_STATE__.selectedCard <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.infoPanelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S5",
      "action": {
        "type": "eval",
        "code": "(function(){ const markers = document.querySelectorAll('[data-card]'); if(markers.length > 0) { markers[0].click(); return; } const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', { clientX: rect.left + rect.width * 0.45, clientY: rect.top + rect.height * 0.4, bubbles: true }); canvas.dispatchEvent(evt); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "再次点击同一标记关闭面板或切换卡片"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCard !== before.selectedCard || window.__3D_STATE__.infoPanelVisible !== before.infoPanelVisible",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "any",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "HUD 与状态同步"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.cameraAngle)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}