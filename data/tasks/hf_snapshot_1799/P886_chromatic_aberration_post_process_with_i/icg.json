          },
          {
            "expr": "window.__3D_STATE__.enabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sliderValue === 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderUniformIntensity - 0.005) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#toggle-btn').textContent.includes('ON')",
