        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.enabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intensity - 0.002) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sliderValue === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.presetActive === 'low'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderUniformIntensity - 0.002) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#intensity-label').textContent.includes('0.002')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
