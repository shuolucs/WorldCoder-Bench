            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#intensity-label').textContent.includes('0.000')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
