        "type": "script",
        "code": "window.__pre_pause_frame = window.__3D_STATE__.frameCount; window.__pre_pause_rotations = [...window.__3D_STATE__.objectRotations]; document.querySelector('#pause-btn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
