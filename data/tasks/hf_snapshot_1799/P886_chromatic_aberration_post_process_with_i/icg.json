  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.005",
        "window.__3D_STATE__.enabled === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.objectCount === 5",
        "window.__3D_STATE__.sliderValue === 5"
      ]
    },
    {
      "id": "S1",
      "name": "EffectDisabled",
      "conditions": [
        "window.__3D_STATE__.enabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "PresetLowActive",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.002",
        "window.__3D_STATE__.presetActive === 'low'"
      ]
    },
    {
      "id": "S3",
      "name": "PresetHighActive",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.040",
        "window.__3D_STATE__.presetActive === 'high'"
      ]
    },
    {
      "id": "S4",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "IntensityIncremented",
      "conditions": [
        "window.__3D_STATE__.intensity > 0.040"
      ]
    },
    {
      "id": "S6",
      "name": "IntensityAtMax",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.05"
      ]
    },
    {
      "id": "S7",
      "name": "IntensityAtZero",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefault",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.005",
        "window.__3D_STATE__.enabled === true"
      ]
    },
    {
      "id": "S9",
      "name": "PresetMediumActive",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.015",
        "window.__3D_STATE__.presetActive === 'medium'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.enabled === true && window.__3D_STATE__.intensity === 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectRotations) && window.__3D_STATE__.objectRotations.length === 5",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderUniformIntensity === 'number' && Math.abs(window.__3D_STATE__.shaderUniformIntensity - 0.005) < 0.0001",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggle-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.enabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#toggle-btn').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderUniformIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.intensity === 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#toggle-btn').click(); document.querySelector('#preset-low').click();"
