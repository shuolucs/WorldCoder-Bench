          },
          {
            "expr": "window.__3D_STATE__.presetActive === 'high'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sliderValue === 40",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderUniformIntensity - 0.040) < 0.0001",
