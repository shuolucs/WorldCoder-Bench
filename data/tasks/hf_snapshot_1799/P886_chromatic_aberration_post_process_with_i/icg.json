            "expr": "window.__3D_STATE__.presetActive === null",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderUniformIntensity - window.__3D_STATE__.intensity) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
