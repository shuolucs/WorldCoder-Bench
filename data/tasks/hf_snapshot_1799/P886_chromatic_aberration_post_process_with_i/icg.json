          },
          {
            "expr": "!(window.__3D_STATE__.intensity > 0.05)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity <= 0.05 && window.__3D_STATE__.intensity >= 0.0",
            "tier": "L2"
          }
        ]
