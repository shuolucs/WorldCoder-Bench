            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectRotations[0] - window.__pre_pause_rotations[0]) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectRotations[2] - window.__pre_pause_rotations[2]) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
