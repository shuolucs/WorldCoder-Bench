{
  "task_id": "P110_anatomy_explorer",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainStem",
      "type": "3d_object",
      "semantic": "GLB 模型 BrainStem.glb",
      "locator_hints": [
        "brainstem"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "模型加载完成，所有部件可见"
    },
    {
      "id": "S2",
      "name": "part_selected",
      "description": "点击选中某部件"
    },
    {
      "id": "S3",
      "name": "part_hidden",
      "description": "隐藏某部件"
    },
    {
      "id": "S4",
      "name": "opacity_changed",
      "description": "透明度被调整"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.totalParts > 0",
        "window.__3D_STATE__.visibleParts > 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParts !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.visibleParts !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedPart !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalParts === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.visibleParts === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParts >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParts > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleParts > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "document.querySelector(\"canvas\").click()",
        "wait_ms": 500
      },
      "postconditions": [
        "typeof window.__3D_STATE__.selectedPart === \"string\""
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalParts !== before.totalParts || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalParts === 'number' && !isNaN(window.__3D_STATE__.totalParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.visibleParts === 'number' && !isNaN(window.__3D_STATE__.visibleParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParts >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedPart === \"string\"",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ const btns = document.querySelectorAll(\"#partsList button\"); if(btns.length>0) btns[0].click(); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.visibleParts < window.__3D_STATE__.totalParts"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalParts !== before.totalParts || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalParts === 'number' && !isNaN(window.__3D_STATE__.totalParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.visibleParts === 'number' && !isNaN(window.__3D_STATE__.visibleParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParts >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleParts < window.__3D_STATE__.totalParts",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ const s=document.getElementById(\"opacitySlider\"); if(s){s.value=\"0.5\"; s.dispatchEvent(new Event(\"input\"));} })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.opacity < 0.8"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalParts !== before.totalParts || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalParts === 'number' && !isNaN(window.__3D_STATE__.totalParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.visibleParts === 'number' && !isNaN(window.__3D_STATE__.visibleParts)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParts >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.opacity < 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && window.__3D_STATE__.cameraDistance < 100",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}