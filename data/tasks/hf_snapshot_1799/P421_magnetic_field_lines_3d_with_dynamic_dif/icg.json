  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.dipoleCount === 2",
        "window.__3D_STATE__.fieldLineCount === 16",
        "window.__3D_STATE__.quizActive === false",
        "window.__3D_STATE__.selectedDipoleIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "DifficultyLevel2",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.dipoleCount === 2",
        "window.__3D_STATE__.fieldLineCount === 24"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyLevel3",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.dipoleCount === 3",
        "window.__3D_STATE__.fieldLineCount === 30"
      ]
    },
    {
      "id": "S3",
      "name": "DifficultyLevel5",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.dipoleCount === 4",
        "window.__3D_STATE__.fieldLineCount === 56"
      ]
    },
    {
      "id": "S4",
      "name": "DipoleSelected",
      "conditions": [
        "window.__3D_STATE__.selectedDipoleIndex >= 0",
        "window.__3D_STATE__.selectedDipoleIndex < window.__3D_STATE__.dipoleCount"
      ]
    },
    {
      "id": "S5",
      "name": "DipoleRotated",
      "conditions": [
        "window.__3D_STATE__.dipoleRotations[window.__3D_STATE__.selectedDipoleIndex] !== 0"
      ]
    },
    {
      "id": "S6",
      "name": "QuizModeActive",
      "conditions": [
        "window.__3D_STATE__.quizActive === true",
        "window.__3D_STATE__.fieldLineCount === 0"
      ]
    },
    {
      "id": "S7",
      "name": "QuizAnswered",
      "conditions": [
        "window.__3D_STATE__.quizzesTaken >= 1",
        "!isNaN(window.__3D_STATE__.lastQuizAngularError)",
        "window.__3D_STATE__.lastQuizAngularError >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "BackToLevel1",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.quizActive === false",
        "window.__3D_STATE__.fieldLineCount === 16"
      ]
    },
    {
      "id": "S9",
      "name": "FieldPhysicsValid",
      "conditions": [
        "!isNaN(window.__3D_STATE__.fieldMagnitudeAtOrigin)",
        "window.__3D_STATE__.fieldMagnitudeAtOrigin > 0",
        "isFinite(window.__3D_STATE__.fieldMagnitudeAtOrigin)"
      ]
    }
  ],
