{
  "task_id": "P286_social_network_clusters",
  "affordances": [
    {
      "id": "A1",
      "name": "NetworkNodes",
      "type": "3d_object",
      "semantic": "24 sphere nodes in 3 colored clusters",
      "locator_hints": [
        "SphereGeometry meshes",
        "children of scene or group"
      ]
    },
    {
      "id": "A2",
      "name": "NetworkEdges",
      "type": "3d_object",
      "semantic": "Line segments connecting nodes",
      "locator_hints": [
        "Line or LineSegments objects"
      ]
    },
    {
      "id": "A3",
      "name": "HUDOverlay",
      "type": "dom_element",
      "semantic": "Top-left info panel showing stats",
      "locator_hints": [
        "div overlay",
        "position absolute top left"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleLabelsBtn",
      "type": "dom_element",
      "semantic": "Button to toggle node labels",
      "locator_hints": [
        "#toggleLabelsBtn"
      ]
    },
    {
      "id": "A5",
      "name": "NodeLabels",
      "type": "3d_object",
      "semantic": "Text labels floating above nodes",
      "locator_hints": [
        "Sprite or CSS2DObject"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialRunning",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 24",
        "window.__3D_STATE__.clusterCount === 3",
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.visibleClusters.length === 3"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId !== null",
        "window.__3D_STATE__.selectedCluster !== null"
      ]
    },
    {
      "id": "S3",
      "name": "ClusterHidden",
      "conditions": [
        "window.__3D_STATE__.visibleClusters.length < 3"
      ]
    },
    {
      "id": "S4",
      "name": "LabelsToggled",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationResumed",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S6",
      "name": "AllClustersRestored",
      "conditions": [
        "window.__3D_STATE__.visibleClusters.length === 3"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
