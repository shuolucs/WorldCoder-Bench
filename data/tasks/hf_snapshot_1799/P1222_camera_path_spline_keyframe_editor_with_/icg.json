{
  "task_id": "P1222_camera_path_spline_keyframe_editor_with_",
  "affordances": [
    {
      "id": "A1",
      "name": "EasyButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Easy",
      "locator_hints": [
        "#btn-easy"
      ]
    },
    {
      "id": "A2",
      "name": "MediumButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Medium",
      "locator_hints": [
        "#btn-medium"
      ]
    },
    {
      "id": "A3",
      "name": "HardButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Hard",
      "locator_hints": [
        "#btn-hard"
      ]
    },
    {
      "id": "A4",
      "name": "AddKeyframeButton",
      "type": "dom_element",
      "semantic": "Button to add a new keyframe to the path",
      "locator_hints": [
        "#btn-add-kf"
      ]
    },
    {
      "id": "A5",
      "name": "PlayButton",
      "type": "dom_element",
      "semantic": "Button to start camera path preview playback",
      "locator_hints": [
        "#btn-play"
      ]
    },
    {
      "id": "A6",
      "name": "StopButton",
      "type": "dom_element",
      "semantic": "Button to stop playback and return to editor view",
      "locator_hints": [
        "#btn-stop"
      ]
    },
    {
      "id": "A7",
      "name": "KeyframeMarkers",
      "type": "3d_object",
      "semantic": "Orange spheres representing keyframe positions in 3D",
      "locator_hints": [
        "mesh with orange material",
        "sphere geometry radius 0.4"
      ]
    },
    {
      "id": "A8",
      "name": "SplineCurve",
      "type": "3d_object",
      "semantic": "Yellow line representing the CatmullRom spline path",
      "locator_hints": [
        "Line object",
        "yellow material"
      ]
    },
    {
      "id": "A9",
      "name": "KeyframeListEntries",
      "type": "dom_element",
      "semantic": "Scrollable list of keyframe entries with select/delete buttons",
      "locator_hints": [
        ".kf-select",
        ".kf-delete"
      ]
    },
    {
      "id": "A10",
      "name": "ProgressBar",
      "type": "dom_element",
      "semantic": "Horizontal bar showing playback progress",
      "locator_hints": [
        "#progress-bar"
      ]
    },
    {
      "id": "A11",
      "name": "PlaybackTimeDisplay",
      "type": "dom_element",
      "semantic": "Text showing current playback time",
      "locator_hints": [
        "#playback-time"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 2",
        "window.__3D_STATE__.difficulty === 'Easy'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.selectedKeyframeIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "KeyframeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedKeyframeIndex >= 0",
        "window.__3D_STATE__.selectedKeyframeIndex < window.__3D_STATE__.keyframeCount"
      ]
    },
    {
      "id": "S2",
      "name": "KeyframeAdded",
      "conditions": [
        "window.__3D_STATE__.keyframeCount === 3",
        "window.__3D_STATE__.lastAction === 'added_keyframe'"
      ]
    },
    {
      "id": "S3",
      "name": "KeyframeMoved",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'moved_keyframe'",
        "window.__3D_STATE__.selectedKeyframeIndex >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "EaseTypeChanged",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'changed_ease'"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyChangedMedium",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'Medium'",
        "window.__3D_STATE__.maxKeyframes === 8"
      ]
    },
    {
      "id": "S6",
      "name": "PlaybackActive",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.playbackTime >= 0"
      ]
    },
    {
      "id": "S7",
      "name": "PlaybackStopped",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.lastAction === 'stopped_playback'"
      ]
    },
    {
      "id": "S8",
      "name": "KeyframeDeleted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'deleted_keyframe'"
      ]
    },
    {
      "id": "S9",
      "name": "DifficultyChangedHard",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'Hard'",
        "window.__3D_STATE__.maxKeyframes === 12"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.keyframes) && window.__3D_STATE__.keyframes.length === 2",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[0].position.x === 0 && window.__3D_STATE__.keyframes[0].position.y === 10 && window.__3D_STATE__.keyframes[0].position.z === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[1].timestamp === 3 && window.__3D_STATE__.keyframes[0].timestamp === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splinePointCount >= 50 && window.__3D_STATE__.splineCurveLength > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 'Easy' && window.__3D_STATE__.maxKeyframes === 5 && window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": ".kf-select",
        "index": 0
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.keyframes[0] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[0].position !== undefined && typeof window.__3D_STATE__.keyframes[0].position.x === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[0].easeType === 'linear' || window.__3D_STATE__.keyframes[0].easeType === 'easeIn' || window.__3D_STATE__.keyframes[0].easeType === 'easeOut' || window.__3D_STATE__.keyframes[0].easeType === 'easeInOut'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.keyframes[0].position.x) && !isNaN(window.__3D_STATE__.keyframes[0].position.y) && !isNaN(window.__3D_STATE__.keyframes[0].position.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-kf"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.keyframeCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'added_keyframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[2].timestamp > window.__3D_STATE__.keyframes[1].timestamp",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineCurveLength > 0 && !isNaN(window.__3D_STATE__.splineCurveLength)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[2].position.y >= 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var prevX = window.__3D_STATE__.keyframes[0].position.x; window.__prevX = prevX; document.querySelectorAll('.kf-select')[0].click(); setTimeout(function(){ document.dispatchEvent(new KeyboardEvent('keydown', {key:'ArrowRight'})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'moved_keyframe'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.keyframes[0].position.x - (window.__prevX + 0.5)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.keyframes[0].position.y) && window.__3D_STATE__.keyframes[0].position.y >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineCurveLength > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__prevEase = window.__3D_STATE__.keyframes[window.__3D_STATE__.selectedKeyframeIndex].easeType; document.dispatchEvent(new KeyboardEvent('keydown', {key:'e'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'changed_ease'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes[window.__3D_STATE__.selectedKeyframeIndex].easeType !== window.__prevEase",
            "tier": "L2"
          },
          {
            "expr": "['linear','easeIn','easeOut','easeInOut'].indexOf(window.__3D_STATE__.keyframes[window.__3D_STATE__.selectedKeyframeIndex].easeType) !== -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.keyframes[window.__3D_STATE__.selectedKeyframeIndex].easeType === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-medium"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 'Medium'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxKeyframes === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'changed_difficulty'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount <= 8",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.validationErrors)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'started_playback'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackDuration > 0 && !isNaN(window.__3D_STATE__.playbackDuration)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime <= window.__3D_STATE__.playbackDuration",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-stop"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'stopped_playback'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackTime === 0 || window.__3D_STATE__.playbackTime <= window.__3D_STATE__.playbackDuration",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineCurveLength > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__prevCount = window.__3D_STATE__.keyframeCount; window.__prevSplineLen = window.__3D_STATE__.splineCurveLength; document.querySelectorAll('.kf-delete')[2].click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.keyframeCount === window.__prevCount - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'deleted_keyframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes.length === window.__3D_STATE__.keyframeCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.splineCurveLength !== window.__prevSplineLen",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframes.every(function(kf){ return kf.position.y >= 0.5; })",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-hard"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 'Hard'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxKeyframes === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'changed_difficulty'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keyframeCount <= 12",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.validationErrors)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.keyframes.every(function(kf, i){ return i === 0 || kf.timestamp > window.__3D_STATE__.keyframes[i-1].timestamp; })",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}