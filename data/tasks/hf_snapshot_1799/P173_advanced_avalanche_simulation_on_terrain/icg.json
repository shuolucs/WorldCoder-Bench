{
  "task_id": "P173_advanced_avalanche_simulation_on_terrain",
  "affordances": [
    {
      "id": "A1",
      "name": "Ferrari",
      "type": "3d_object",
      "semantic": "Player-controlled car at the base of the slope loaded from ferrari.glb",
      "locator_hints": [
        "GLTFLoader model",
        "window.__3D_STATE__.ferrariX"
      ]
    },
    {
      "id": "A2",
      "name": "Boulders",
      "type": "3d_object",
      "semantic": "Spherical rocks that roll down the slope as avalanche debris",
      "locator_hints": [
        "SphereGeometry",
        "window.__3D_STATE__.bouldersActive"
      ]
    },
    {
      "id": "A3",
      "name": "Terrain",
      "type": "3d_object",
      "semantic": "Snowy mountain slope made from displaced PlaneGeometry",
      "locator_hints": [
        "PlaneGeometry(80,80)"
      ]
    },
    {
      "id": "A4",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the avalanche simulation",
      "locator_hints": [
        "#start-btn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing score, lives, and status",
      "locator_hints": [
        "#hud",
        "#score-display",
        "#lives-display",
        "#status-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.ferrarLoaded === true",
        "window.__3D_STATE__.simulationStarted === false"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === true",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S3",
      "name": "Ferrari_Moved",
      "conditions": [
        "window.__3D_STATE__.ferrariX !== 0",
        "window.__3D_STATE__.ferrariX >= -15 && window.__3D_STATE__.ferrariX <= 15"
      ]
    },
    {
      "id": "S4",
      "name": "Boulders_Spawning",
      "conditions": [
        "window.__3D_STATE__.bouldersSpawned > 0",
        "window.__3D_STATE__.bouldersActive > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Simulation_Reset",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.bouldersSpawned === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStarted !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lives !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gameOver !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lives === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationStarted === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ferrarLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStarted === false",
            "tier": "L2"
