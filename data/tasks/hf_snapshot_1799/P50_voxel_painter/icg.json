{
  "task_id": "P50_voxel_painter",
  "affordances": [
    {
      "id": "A1",
      "name": "VoxelGrid",
      "type": "3d_object",
      "semantic": "16x16x16 体素空间与地面",
      "locator_hints": [
        "voxel",
        "grid",
        "ground",
        "plane"
      ]
    },
    {
      "id": "A2",
      "name": "Palette",
      "type": "dom_element",
      "semantic": "8 色颜色面板",
      "locator_hints": [
        "palette",
        "color"
      ]
    },
    {
      "id": "A3",
      "name": "LayerSlider",
      "type": "dom_element",
      "semantic": "层可见性滑块",
      "locator_hints": [
        "layerSlider"
      ]
    },
    {
      "id": "A4",
      "name": "UndoBtn",
      "type": "dom_element",
      "semantic": "撤销按钮",
      "locator_hints": [
        "undoBtn"
      ]
    },
    {
      "id": "A5",
      "name": "RedoBtn",
      "type": "dom_element",
      "semantic": "重做按钮",
      "locator_hints": [
        "redoBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ClearBtn",
      "type": "dom_element",
      "semantic": "清空按钮",
      "locator_hints": [
        "clearBtn"
      ]
    },
    {
      "id": "A7",
      "name": "VoxelCountDisplay",
      "type": "dom_element",
      "semantic": "体素数量显示",
      "locator_hints": [
        "voxelCount"
      ]
    },
    {
      "id": "A8",
      "name": "RaycasterPlacement",
      "type": "interaction",
      "semantic": "射线放置/删除交互",
      "locator_hints": [
        "click",
        "raycaster",
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "空场景，只有地面"
    },
    {
      "id": "S1",
      "name": "empty_verified",
      "description": "初始状态验证通过"
    },
    {
      "id": "S2",
      "name": "voxel_placed",
      "description": "放置了一个体素"
    },
    {
      "id": "S3",
      "name": "voxel_removed",
      "description": "通过 shift+click 删除体素"
    },
    {
      "id": "S4",
      "name": "color_changed",
      "description": "切换了颜色"
    },
    {
      "id": "S5",
      "name": "layer_filtered",
      "description": "层滑块过滤"
    },
    {
      "id": "S6",
      "name": "undone",
      "description": "撤销了操作"
    },
    {
      "id": "S7",
      "name": "redone",
      "description": "重做了操作"
    },
    {
      "id": "S8",
      "name": "cleared",
      "description": "清空所有体素"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "voxelCount=0（初始空场景）"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.voxelCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColor === '#ff0000' || window.__3D_STATE__.currentColor === '#FF0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerVisible === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridOccupancy && window.__3D_STATE__.gridOccupancy.length === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridOccupancy.every(function(c){ return c === 0; })",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ var canvas = document.querySelector('canvas'); if(!canvas) return; var rect = canvas.getBoundingClientRect(); var cx = rect.left + rect.width * 0.5; var cy = rect.top + rect.height * 0.6; canvas.dispatchEvent(new MouseEvent('pointerdown', {clientX:cx,clientY:cy,bubbles:true})); canvas.dispatchEvent(new MouseEvent('pointerup', {clientX:cx,clientY:cy,bubbles:true})); canvas.dispatchEvent(new MouseEvent('click', {clientX:cx,clientY:cy,bubbles:true})); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "voxelCount 增加到 1"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.voxelCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridOccupancy[0] === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voxelCount > before.voxelCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > before.undoStackSize",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ var canvas = document.querySelector('canvas'); if(!canvas) return; var rect = canvas.getBoundingClientRect(); var cx = rect.left + rect.width * 0.5; var cy = rect.top + rect.height * 0.6; canvas.dispatchEvent(new MouseEvent('pointerdown', {clientX:cx,clientY:cy,shiftKey:true,bubbles:true})); canvas.dispatchEvent(new MouseEvent('pointerup', {clientX:cx,clientY:cy,shiftKey:true,bubbles:true})); canvas.dispatchEvent(new MouseEvent('click', {clientX:cx,clientY:cy,shiftKey:true,bubbles:true})); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "voxelCount 减少到 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.voxelCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridOccupancy.every(function(c){ return c === 0; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voxelCount < before.voxelCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ var palette = document.getElementById('palette'); if(!palette) return; var btns = palette.querySelectorAll('button, [data-color], div[style]'); if(btns.length >= 3) btns[2].click(); })()",
        "wait_ms": 300
      },
      "postconditions": [
        "currentColor 已改变"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentColor !== '#ff0000' && window.__3D_STATE__.currentColor !== '#FF0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentColor !== before.currentColor",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "eval",
        "code": "(function(){ var el = document.getElementById('layerSlider'); if(el){ el.value='8'; el.dispatchEvent(new Event('input',{bubbles:true})); el.dispatchEvent(new Event('change',{bubbles:true})); } })()",
        "wait_ms": 300
      },
      "postconditions": [
        "layerVisible 变为 8"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerVisible === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerVisible !== before.layerVisible",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "dom_click",
        "selector": "#undoBtn"
      },
      "postconditions": [
        "撤销操作执行"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 300,
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackSize < before.undoStackSize",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voxelCount >= before.voxelCount",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var changed=false; var keys=Object.keys(window.__3D_STATE__); for(var i=0;i<keys.length;i++){ var k=keys[i]; if(JSON.stringify(window.__3D_STATE__[k])!==JSON.stringify(before[k])){ changed=true; break; }} return changed; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "dom_click",
        "selector": "#redoBtn"
      },
      "postconditions": [
        "重做操作执行"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 300,
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize < before.redoStackSize",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > before.undoStackSize - 1",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var changed=false; var keys=Object.keys(window.__3D_STATE__); for(var i=0;i<keys.length;i++){ var k=keys[i]; if(JSON.stringify(window.__3D_STATE__[k])!==JSON.stringify(before[k])){ changed=true; break; }} return changed; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "action": {
        "type": "dom_click",
        "selector": "#clearBtn"
      },
      "postconditions": [
        "清空所有体素"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.voxelCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridOccupancy.every(function(c){ return c === 0; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voxelCount !== before.voxelCount || before.voxelCount === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}