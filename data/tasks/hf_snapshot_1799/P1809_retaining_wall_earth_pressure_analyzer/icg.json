  "states": [
    {
      "id": "S0",
      "name": "InitialDefaultState",
      "conditions": [
        "window.__3D_STATE__.wallHeight === 5.0",
        "window.__3D_STATE__.frictionAngle === 30",
        "window.__3D_STATE__.cohesion === 0",
        "window.__3D_STATE__.unitWeight === 18",
        "window.__3D_STATE__.theory === 'Rankine'",
        "window.__3D_STATE__.pressureDiagramVisible === true",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "WallHeightIncreased",
      "conditions": [
        "window.__3D_STATE__.wallHeight === 5.5"
      ]
    },
    {
      "id": "S2",
      "name": "FrictionAngleDecreased",
      "conditions": [
        "window.__3D_STATE__.frictionAngle === 29",
        "window.__3D_STATE__.wallHeight === 5.5"
      ]
    },
    {
      "id": "S3",
      "name": "TheoryChangedToCoulomb",
      "conditions": [
        "window.__3D_STATE__.theory === 'Coulomb'"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneToRankine",
      "conditions": [
        "window.__3D_STATE__.theory === 'Rankine'",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoneBackToCoulomb",
      "conditions": [
        "window.__3D_STATE__.theory === 'Coulomb'"
      ]
    },
    {
      "id": "S6",
      "name": "PressureDiagramHidden",
      "conditions": [
        "window.__3D_STATE__.pressureDiagramVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "PressureDiagramRestored",
      "conditions": [
        "window.__3D_STATE__.pressureDiagramVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "WaterTableLowered",
      "conditions": [
        "window.__3D_STATE__.waterTableDepth < window.__3D_STATE__.wallHeight"
      ]
    },
    {
      "id": "S9",
      "name": "CohesionApplied",
      "conditions": [
        "window.__3D_STATE__.cohesion > 0"
      ]
    },
    {
      "id": "S10",
      "name": "DataExported",
      "conditions": [
