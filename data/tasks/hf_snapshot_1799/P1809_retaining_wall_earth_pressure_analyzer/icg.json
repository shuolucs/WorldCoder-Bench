      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.wallHeight === 5.0",
        "window.__3D_STATE__.frictionAngle === 30",
        "window.__3D_STATE__.cohesion === 0",
        "window.__3D_STATE__.theory === 'Rankine'"
      ]
