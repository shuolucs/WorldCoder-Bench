            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Ka === 'number' && !isNaN(window.__3D_STATE__.Ka)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Kp === 'number' && !isNaN(window.__3D_STATE__.Kp)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.Ka - Math.pow(Math.tan((45 - 15) * Math.PI / 180), 2)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Ka > 0 && window.__3D_STATE__.Ka < 1",
            "tier": "L2"
          },
