    {
      "id": "A10",
      "name": "BlurStrengthLabel",
      "type": "dom_element",
      "semantic": "Label displaying current blur strength value",
      "locator_hints": [
        "#blur-strength-label"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Scene_Ready",
      "conditions": [
        "window.__3D_STATE__.michelleLoaded === true",
        "window.__3D_STATE__.blurEnabled === true",
        "window.__3D_STATE__.blurStrength === 1.0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Blur_Disabled",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "Blur_Re_Enabled",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "Blur_Strength_Changed",
      "conditions": [
        "window.__3D_STATE__.blurStrength === 2.5"
      ]
    },
    {
      "id": "S5",
      "name": "Speed_Fast",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S8",
      "name": "Speed_Extreme",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 4.0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.blurEnabled === true",
        "window.__3D_STATE__.blurStrength === 1.0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.michelleLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurSamples === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blur-toggle').checked === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sphereVelocityMagnitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sphereVelocityMagnitude)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#blur-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blur-toggle').checked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocityMagnitude >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cubeVelocityMagnitude >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('blur-strength-slider').value = 2.5; document.getElementById('blur-strength-slider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blur-strength-slider').value === '2.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blur-strength-label').textContent.includes('2.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.torusVelocityMagnitude)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speed-select').value = '2.0'; document.getElementById('speed-select').dispatchEvent(new Event('change', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mixerTimeScale - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speed-select').value === '2.0'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0 && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pause-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pause-btn').textContent.trim() === 'Resume'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.spherePosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.spherePosition.x === 'number' && !isNaN(window.__3D_STATE__.spherePosition.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cubePosition.y === 'number' && window.__3D_STATE__.cubePosition.y >= 0.3 && window.__3D_STATE__.cubePosition.y <= 3.1",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pause-btn').textContent.trim() === 'Pause'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blurStrength === 2.5",
            "tier": "L2"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.spherePosition.x ** 2 + window.__3D_STATE__.spherePosition.z ** 2) < 4.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let fc0 = window.__3D_STATE__.frameCount; document.getElementById('speed-select').value = '4.0'; document.getElementById('speed-select').dispatchEvent(new Event('change', {bubbles:true})); window.__test_fc_before_extreme = fc0;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 4.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mixerTimeScale - 4.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > window.__test_fc_before_extreme",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusPosition.z >= -4.1 && window.__3D_STATE__.torusPosition.z <= 4.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusPosition.x > 1.5 && window.__3D_STATE__.torusPosition.x < 2.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blurEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blurStrength - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blur-strength-slider').value === '1'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speed-select').value === '1.0'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}