            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v > 0 && v <= 1.0 && !isNaN(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => !isNaN(n.activation) && n.activation >= 0 && n.activation <= 1)",
            "tier": "L2"
