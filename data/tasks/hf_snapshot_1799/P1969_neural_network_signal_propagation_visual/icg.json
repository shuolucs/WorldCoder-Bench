{
  "task_id": "P1969_neural_network_signal_propagation_visual",
  "affordances": [
    {
      "id": "A1",
      "name": "NeuralNetwork",
      "type": "3d_object",
      "semantic": "The full neural network graph of 19 neurons and 78 connections",
      "locator_hints": [
        "scene.children containing neuron meshes and connection lines"
      ]
    },
    {
      "id": "A2",
      "name": "InputNeurons",
      "type": "3d_object",
      "semantic": "4 input layer neurons that can be clicked to toggle activation",
      "locator_hints": [
        "neurons with layerIndex===0"
      ]
    },
    {
      "id": "A3",
      "name": "OutputNeurons",
      "type": "3d_object",
      "semantic": "3 output layer neurons showing final activations",
      "locator_hints": [
        "neurons with layerIndex===3"
      ]
    },
    {
      "id": "A4",
      "name": "ConnectionLines",
      "type": "3d_object",
      "semantic": "78 lines connecting neurons between adjacent layers",
      "locator_hints": [
        "Line or LineSegments objects in scene"
      ]
    },
    {
      "id": "A5",
      "name": "PropagateButton",
      "type": "dom_element",
      "semantic": "Button to trigger forward propagation",
      "locator_hints": [
        "#btn-propagate"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all activations",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling propagation delay per layer",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.propagationState === 'idle'",
        "window.__3D_STATE__.neuronCount === 19",
        "window.__3D_STATE__.weightCount === 78",
        "window.__3D_STATE__.totalEnergy === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Input_Activated",
      "conditions": [
        "window.__3D_STATE__.inputActivations.some(v => v === 1.0)",
        "window.__3D_STATE__.propagationState === 'idle'"
      ]
    },
    {
      "id": "S2",
      "name": "Propagating",
      "conditions": [
        "window.__3D_STATE__.propagationState === 'propagating'",
        "window.__3D_STATE__.activeLayerIndex >= 0"
      ]
    },
    {
      "id": "S3",
      "name": "Propagation_Complete",
      "conditions": [
        "window.__3D_STATE__.propagationState === 'complete'",
        "window.__3D_STATE__.outputActivations.every(v => v >= 0 && v <= 1)"
      ]
    },
    {
      "id": "S4",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.propagationState === 'idle'",
        "window.__3D_STATE__.totalEnergy === 0",
        "window.__3D_STATE__.neurons.every(n => n.activation === 0)"
      ]
    },
    {
      "id": "S5",
      "name": "Weights_Randomized",
      "conditions": [
        "window.__3D_STATE__.weightsRandomizedCount > 0",
        "window.__3D_STATE__.weights.every(w => w >= -1 && w <= 1)"
      ]
    },
    {
      "id": "S6",
      "name": "LearningRate_Adjusted",
      "conditions": [
        "window.__3D_STATE__.learningRate !== 0.5",
        "window.__3D_STATE__.learningRate >= 0.01",
        "window.__3D_STATE__.learningRate <= 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "Speed_Adjusted",
      "conditions": [
        "window.__3D_STATE__.propagationSpeed !== 800"
      ]
    },
    {
      "id": "S8",
      "name": "Second_Propagation_Complete",
      "conditions": [
        "window.__3D_STATE__.propagationCount >= 2",
        "window.__3D_STATE__.propagationState === 'complete'"
      ]
    },
    {
      "id": "S9",
      "name": "Multi_Input_Propagated",
      "conditions": [
        "window.__3D_STATE__.inputActivations.filter(v => v === 1.0).length >= 2",
        "window.__3D_STATE__.propagationState === 'complete'"
      ]
    },
    {
      "id": "S10",
      "name": "Full_Reset_After_Chain",
      "conditions": [
        "window.__3D_STATE__.totalEnergy === 0",
        "window.__3D_STATE__.propagationState === 'idle'",
        "window.__3D_STATE__.inputActivations.every(v => v === 0)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.neuronCount === 19",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weightCount === 78",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerSizes) && JSON.stringify(window.__3D_STATE__.layerSizes) === '[4,6,6,3]'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.length === 19 && window.__3D_STATE__.neurons.every(n => typeof n.activation === 'number' && !isNaN(n.activation))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const inputNeurons = window.__3D_STATE__.neurons.filter(n => n.layerIndex === 0); const meshes = scene.children.filter(c => c.isMesh && c.geometry && c.geometry.type === 'SphereGeometry'); if(meshes.length > 0) { const evt = new MouseEvent('click', {clientX: window.innerWidth/2 - 150, clientY: window.innerHeight/2}); renderer.domElement.dispatchEvent(evt); } window.__3D_STATE__.inputActivations[0] = 1.0; window.__3D_STATE__.neurons.find(n => n.layerIndex===0 && n.neuronIndex===0).activation = 1.0;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.inputActivations[0] === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.filter(n => n.layerIndex === 0 && n.activation === 1.0).length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy >= 0 && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "afterWait_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v > 0 && v <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0 && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.filter(n => n.layerIndex > 0).some(n => n.activation > 0)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - window.__3D_STATE__.neurons.reduce((s,n) => s + n.activation, 0)) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.activation === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.inputActivations.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastResetTimestamp > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weightsRandomizedCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weights.length === 78",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weights.every(w => w >= -1 && w <= 1 && !isNaN(w))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weights.some(w => w > 0) && window.__3D_STATE__.weights.some(w => w < 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "repeat": 10
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.learningRate > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.learningRate <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.learningRate - 0.6) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.learningRate === 'number' && !isNaN(window.__3D_STATE__.learningRate)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-lr') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('slider-speed'); if(slider) { slider.value = 400; slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationSpeed === 400 || window.__3D_STATE__.propagationSpeed === '400'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('slider-speed') !== null",
            "tier": "L0"
          },
          {
            "expr": "Number(document.getElementById('slider-speed').value) === 400",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-speed') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.inputActivations[0] = 1.0; window.__3D_STATE__.inputActivations[2] = 1.0; window.__3D_STATE__.neurons.filter(n=>n.layerIndex===0).forEach(n => { if(n.neuronIndex===0||n.neuronIndex===2) n.activation=1.0; }); const btn = document.getElementById('btn-propagate'); if(btn) btn.click();",
        "afterWait_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.inputActivations.filter(v => v === 1.0).length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v > 0 && v <= 1.0 && !isNaN(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - window.__3D_STATE__.neurons.reduce((s,n) => s + n.activation, 0)) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown",
        "repeat": 20,
        "afterWait_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.learningRate < 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.learningRate >= 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.learningRate === 'number' && !isNaN(window.__3D_STATE__.learningRate)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.propagationState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "afterWait_ms": 3500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.propagationCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v > 0 && v <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.filter(n => n.layerIndex === 1).every(n => n.activation >= 0 && n.activation <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.filter(n => n.layerIndex === 2).every(n => n.activation >= 0 && n.activation <= 1)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - window.__3D_STATE__.neurons.reduce((s,n) => s + n.activation, 0)) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S3",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset",
        "afterWait_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.inputActivations.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outputActivations.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.activation === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeLayerIndex === -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.inputActivations.forEach((v,i,a) => { a[i] = 1.0; }); window.__3D_STATE__.neurons.filter(n=>n.layerIndex===0).forEach(n => n.activation=1.0); document.getElementById('btn-propagate').click();",
        "afterWait_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationState === 'complete'",
