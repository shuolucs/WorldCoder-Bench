      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S7",
      "name": "AdibaticMode",
      "conditions": [
        "window.__3D_STATE__.isothermalLock === false",
