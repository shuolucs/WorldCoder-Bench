  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.moleculeCount === 50",
        "window.__3D_STATE__.moles === 1.0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.isothermalLock === true",
        "window.__3D_STATE__.mode === 'isothermal'",
        "window.__3D_STATE__.resetCount === 0",
        "Math.abs(window.__3D_STATE__.pistonHeight - 4.0) < 0.1"
      ]
    },
    {
      "id": "S1",
      "name": "TemperatureIncreased",
      "conditions": [
        "window.__3D_STATE__.temperature === 500",
        "window.__3D_STATE__.pvnrtRatio > 0.95 && window.__3D_STATE__.pvnrtRatio < 1.05"
      ]
    },
    {
      "id": "S2",
      "name": "MoleculesAdded",
      "conditions": [
        "window.__3D_STATE__.moleculeCount === 60",
        "Math.abs(window.__3D_STATE__.moles - 1.2) < 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "MoleculesRemoved",
      "conditions": [
        "window.__3D_STATE__.moleculeCount === 50",
        "Math.abs(window.__3D_STATE__.moles - 1.0) < 0.01"
