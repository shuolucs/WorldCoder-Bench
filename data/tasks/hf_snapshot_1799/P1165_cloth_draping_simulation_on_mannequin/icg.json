{
  "task_id": "P1165_cloth_draping_simulation_on_mannequin",
  "affordances": [
    {
      "id": "A1",
      "name": "ClothMesh",
      "type": "3d_object",
      "semantic": "The cloth plane mesh rendered from particle positions",
      "locator_hints": [
        "scene.children mesh with 20x20 segments",
        "PlaneGeometry with DoubleSide material"
      ]
    },
    {
      "id": "A2",
      "name": "Mannequin",
      "type": "3d_object",
      "semantic": "The mannequin torso and head group",
      "locator_hints": [
        "Group containing cylinder and sphere meshes",
        "skin-toned MeshStandardMaterial"
      ]
    },
    {
      "id": "A3",
      "name": "DropClothButton",
      "type": "dom_element",
      "semantic": "Button to release the cloth from pinned state",
      "locator_hints": [
        "#dropClothBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset cloth to initial position",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleWindButton",
      "type": "dom_element",
      "semantic": "Button to toggle wind force on/off",
      "locator_hints": [
        "#toggleWindBtn"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A7",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "Internal particle array driving cloth simulation",
      "locator_hints": [
        "window.__3D_STATE__.particleCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Pinned",
      "conditions": [
        "window.__3D_STATE__.clothDropped === false",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.pinnedCount > 0",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "Cloth_Dropped",
      "conditions": [
        "window.__3D_STATE__.clothDropped === true",
        "window.__3D_STATE__.pinnedCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Cloth_Draped",
      "conditions": [
        "window.__3D_STATE__.clothDropped === true",
        "window.__3D_STATE__.clothMinY < 1.0",
        "window.__3D_STATE__.collisionCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Wind_Active",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Gravity_Disabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "Stiffness_Increased",
      "conditions": [
        "window.__3D_STATE__.structuralStiffness > 0.8"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.clothDropped === false",
        "window.__3D_STATE__.pinnedCount > 0",
        "window.__3D_STATE__.clothCenterY > 3.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount >= 400",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.springCount === 'number' && window.__3D_STATE__.springCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.clothDropped === false && window.__3D_STATE__.pinnedCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clothCenterY > 3.0 && window.__3D_STATE__.clothMaxY <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mannequinHeight === 1.8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#dropClothBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.clothDropped === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pinnedCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.clothCenterY === 'number' && !isNaN(window.__3D_STATE__.clothCenterY)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.energyKinetic === 'number' && !isNaN(window.__3D_STATE__.energyKinetic)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.clothCenterY < 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clothMinY >= -0.5 && window.__3D_STATE__.clothMinY < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.collisionCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageParticleSpeed >= 0 && !isNaN(window.__3D_STATE__.averageParticleSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clothMaxY < 3.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleWindBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windForce === 'object' && window.__3D_STATE__.windForce !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windForce.x > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleWindBtn').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energyKinetic === 'number' && window.__3D_STATE__.energyKinetic >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleWindBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windForce.x === 0 && window.__3D_STATE__.windForce.z === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleWindBtn').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.timestamp === 'number' && window.__3D_STATE__.timestamp > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "(() => { window.__testFrameBefore = window.__3D_STATE__.frameCount; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('Paused')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.clothCenterY === 'number' && !isNaN(window.__3D_STATE__.clothCenterY)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.structuralStiffness === 'number' && window.__3D_STATE__.structuralStiffness === 0.8",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('Running')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.averageParticleSpeed === 'number' && !isNaN(window.__3D_STATE__.averageParticleSpeed)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.structuralStiffness >= 0.85 && window.__3D_STATE__.structuralStiffness <= 0.95",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('0.9') || document.getElementById('hud').textContent.includes('0.90')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralStiffness <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.springCount === 'number' && window.__3D_STATE__.springCount > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.clothMinY) && !isNaN(window.__3D_STATE__.clothMaxY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.clothCenterY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 400",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.energyKinetic === 'number' && window.__3D_STATE__.energyKinetic >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.clothDropped === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pinnedCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clothCenterY > 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clothMaxY >= 3.0 && window.__3D_STATE__.clothMaxY <= 4.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true || window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}