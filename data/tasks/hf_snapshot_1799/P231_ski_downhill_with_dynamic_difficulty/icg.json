  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning_Diff1",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.difficultyLevel === 1"
      ]
    },
    {
      "id": "S2",
      "name": "SkierMovedLeft",
      "conditions": [
        "window.__3D_STATE__.skierX < -1",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S3",
      "name": "SkierMovedRight",
      "conditions": [
        "window.__3D_STATE__.skierX > 1",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 2",
        "window.__3D_STATE__.currentSpeed >= 17"
      ]
    },
    {
      "id": "S5",
      "name": "FishCollected",
      "conditions": [
        "window.__3D_STATE__.fishCollected >= 1",
        "window.__3D_STATE__.isInvincible === true"
      ]
    },
    {
      "id": "S6",
      "name": "InvincibilityExpired",
      "conditions": [
        "window.__3D_STATE__.fishCollected >= 1",
        "window.__3D_STATE__.isInvincible === false"
      ]
    },
    {
      "id": "S7",
      "name": "HitObstacle",
      "conditions": [
        "window.__3D_STATE__.lives < 3",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S8",
      "name": "HighDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 4",
        "window.__3D_STATE__.currentSpeed >= 21"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.lives === 0"
      ]
    }
