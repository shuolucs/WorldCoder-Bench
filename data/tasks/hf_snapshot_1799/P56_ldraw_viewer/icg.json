    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "totalSteps=15，visibleBricks 与 totalBricks 合理"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSteps === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentStep >= 1 && window.__3D_STATE__.currentStep <= 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleBricks >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBricks >= window.__3D_STATE__.visibleBricks",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.explodeMode === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('stepSlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('explodeToggle') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ var el=document.getElementById('stepSlider'); if(el){ el.value='8'; el.dispatchEvent(new Event('input',{bubbles:true})); el.dispatchEvent(new Event('change',{bubbles:true})); } else if(window.__STATEPROBE_setStep__) window.__STATEPROBE_setStep__(8); })()",
        "wait_ms": 400
      },
      "postconditions": [
        "currentStep 为 8"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentStep === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSteps === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleBricks >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentStep !== before.currentStep",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleBricks !== before.visibleBricks || before.currentStep === 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ var cb=document.getElementById('explodeToggle'); if(cb){ cb.checked=true; cb.dispatchEvent(new Event('change',{bubbles:true})); } else if(window.__STATEPROBE_setExplode__) window.__STATEPROBE_setExplode__(true); })()",
        "wait_ms": 300
