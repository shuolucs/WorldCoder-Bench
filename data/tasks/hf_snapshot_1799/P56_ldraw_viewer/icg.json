            "expr": "window.__3D_STATE__.explodeMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentStep === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodeMode !== before.explodeMode",
            "tier": "L2"
          }
        ]
      }
    },
