  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.spinRate === 5.0",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Precessing",
      "conditions": [
        "window.__3D_STATE__.precessionAngle > 0",
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpinIncreased",
      "conditions": [
        "window.__3D_STATE__.spinRate === 6.0"
      ]
    },
    {
      "id": "S4",
      "name": "GravityOff",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false",
        "window.__3D_STATE__.precessionRate === 0"
      ]
    },
    {
      "id": "S5",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "NutationActive",
      "conditions": [
        "window.__3D_STATE__.nutationActive === true",
        "window.__3D_STATE__.spinRate < 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.spinRate === 5.0",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
