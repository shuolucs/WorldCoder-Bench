      ]
    },
    {
      "id": "S2",
      "name": "ACES_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 3",
        "window.__3D_STATE__.modeName === 'ACES'"
      ]
    },
    {
      "id": "S3",
      "name": "Cineon_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 4",
        "window.__3D_STATE__.modeName === 'Cineon'"
      ]
    },
    {
      "id": "S4",
      "name": "Exposure_Increased",
      "conditions": [
        "window.__3D_STATE__.exposure > 1.0"
