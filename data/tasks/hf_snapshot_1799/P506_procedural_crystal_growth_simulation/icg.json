      ]
    },
    {
      "id": "A8",
      "name": "GKey",
      "type": "dom_element",
      "semantic": "G key to toggle glow",
      "locator_hints": [
        "keydown event, code KeyG"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_NoCrystals",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "SeedPlanted_Growing",
      "conditions": [
        "window.__3D_STATE__.crystalCount >= 1",
        "window.__3D_STATE__.clusterCount >= 1",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.crystalCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "PaletteChanged",
      "conditions": [
        "window.__3D_STATE__.paletteMode !== 'vibrant'"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "GlowEnabled",
      "conditions": [
        "window.__3D_STATE__.glowEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.clusterCount === 0"
      ]
    }
  ],
