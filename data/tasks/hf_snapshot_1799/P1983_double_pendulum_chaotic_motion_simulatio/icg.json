      "semantic": "Label showing current speed multiplier",
      "locator_hints": [
        "#speedLabel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.theta1 === Math.PI / 2",
        "window.__3D_STATE__.theta2 === Math.PI / 2",
        "window.__3D_STATE__.omega1 === 0",
        "window.__3D_STATE__.omega2 === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.simulationTime > 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.frameCount > 10"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "TrailCleared",
      "conditions": [
        "window.__3D_STATE__.trailPointCount === 0"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "Math.abs(window.__3D_STATE__.theta1 - Math.PI / 2) < 0.001",
        "Math.abs(window.__3D_STATE__.theta2 - Math.PI / 2) < 0.001",
        "window.__3D_STATE__.omega1 === 0",
        "window.__3D_STATE__.omega2 === 0",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta1 === 'number' && !isNaN(window.__3D_STATE__.theta1)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta2 === 'number' && !isNaN(window.__3D_STATE__.theta2)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trailPointCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - window.__3D_STATE__.initialEnergy) / Math.abs(window.__3D_STATE__.initialEnergy) < 0.02",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 100
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.bob1X ** 2 + window.__3D_STATE__.bob1Y ** 2) - window.__3D_STATE__.L1) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt((window.__3D_STATE__.bob2X - window.__3D_STATE__.bob1X) ** 2 + (window.__3D_STATE__.bob2Y - window.__3D_STATE__.bob1Y) ** 2) - window.__3D_STATE__.L2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.omega1) && !isNaN(window.__3D_STATE__.omega2)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.kineticEnergy) && window.__3D_STATE__.kineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.potentialEnergy === 'number' && !isNaN(window.__3D_STATE__.potentialEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number' && window.__3D_STATE__.simulationTime > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta1 === 'number' && !isNaN(window.__3D_STATE__.theta1)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta2 === 'number' && !isNaN(window.__3D_STATE__.theta2)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.initialEnergy === 'number' && !isNaN(window.__3D_STATE__.initialEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = '2.0'; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2.0 || Math.abs(window.__3D_STATE__.speedMultiplier - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedSlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('speedLabel') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('speedLabel').textContent.includes('2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
