  "states": [
    {
      "id": "S0",
      "name": "PreStart",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.matchActive === false",
        "window.__3D_STATE__.round === 1"
      ]
    },
    {
      "id": "S1",
      "name": "MatchActive",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.matchActive === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "P1Moving",
      "conditions": [
        "window.__3D_STATE__.matchActive === true",
        "Math.abs(window.__3D_STATE__.p1.vx) + Math.abs(window.__3D_STATE__.p1.vz) > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "P1Charging",
      "conditions": [
        "window.__3D_STATE__.p1.charging === true",
        "window.__3D_STATE__.p1.stamina < 100"
      ]
    },
    {
      "id": "S4",
      "name": "Collision",
      "conditions": [
        "window.__3D_STATE__.lastCollisionSpeed > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S6",
      "name": "P2Moving",
      "conditions": [
        "window.__3D_STATE__.matchActive === true",
        "Math.abs(window.__3D_STATE__.p2.vx) + Math.abs(window.__3D_STATE__.p2.vz) > 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "HealthDamaged",
      "conditions": [
        "window.__3D_STATE__.p1.health < 100 || window.__3D_STATE__.p2.health < 100"
      ]
    },
    {
      "id": "S8",
      "name": "RoundOver",
      "conditions": [
        "window.__3D_STATE__.matchActive === false",
        "window.__3D_STATE__.winner !== null"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.matchActive === true",
        "window.__3D_STATE__.p1.health === 100",
        "window.__3D_STATE__.p2.health === 100"
      ]
    }
  ],
