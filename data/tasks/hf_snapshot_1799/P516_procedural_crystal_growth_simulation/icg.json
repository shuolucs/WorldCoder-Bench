  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.crystalCount >= 3",
        "window.__3D_STATE__.growthActive === true",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.glowMode === false",
        "window.__3D_STATE__.totalHarvested === 0",
        "window.__3D_STATE__.seedsPlanted === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GrowthPaused",
      "conditions": [
        "window.__3D_STATE__.growthActive === false"
      ]
    },
    {
      "id": "S2",
      "name": "GrowthResumed",
      "conditions": [
        "window.__3D_STATE__.growthActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1.5"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "CrystalPlanted",
      "conditions": [
        "window.__3D_STATE__.seedsPlanted >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "CrystallizeBurst",
      "conditions": [
        "window.__3D_STATE__.tallestCrystalHeight > 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "GlowModeOn",
      "conditions": [
        "window.__3D_STATE__.glowMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "GlowModeOff",
      "conditions": [
        "window.__3D_STATE__.glowMode === false"
      ]
    },
    {
      "id": "S9",
      "name": "AfterHarvest",
      "conditions": [
        "window.__3D_STATE__.totalHarvested >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.crystalCount >= 3",
        "window.__3D_STATE__.totalHarvested === 0",
        "window.__3D_STATE__.seedsPlanted === 0"
      ]
    }
  ],
