  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentTurn === \"white\"",
        "window.__3D_STATE__.moveCount === 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTurn !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.moveCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.capturedCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.moveCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.capturedCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.moveCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTurn === \"white\"",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moveCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.moveCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "document.querySelector(\"canvas\").dispatchEvent(new MouseEvent(\"click\",{clientX:400,clientY:400,bubbles:true}))",
        "wait_ms": 500
      },
      "postconditions": [
        "typeof window.__3D_STATE__.selectedPiece === \"string\""
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.moveCount !== before.moveCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.moveCount === 'number' && !isNaN(window.__3D_STATE__.moveCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.capturedCount === 'number' && !isNaN(window.__3D_STATE__.capturedCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.boardState)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.moveCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedPiece === \"string\"",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}