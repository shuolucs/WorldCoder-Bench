{
  "task_id": "P145_avalanche_simulation_on_terrain",
  "affordances": [
    {
      "id": "A1",
      "name": "Terrain",
      "type": "3d_object",
      "semantic": "Mountain slope terrain mesh with heightmap",
      "locator_hints": [
        "PlaneGeometry mesh with brown material"
      ]
    },
    {
      "id": "A2",
      "name": "BrainStemModel",
      "type": "3d_object",
      "semantic": "GLTF model acting as obstacle in avalanche path",
      "locator_hints": [
        "position near (15, 0, 0)",
        "scaled to (3,3,3)"
      ]
    },
    {
      "id": "A3",
      "name": "AvalancheParticles",
      "type": "3d_object",
      "semantic": "200 snow sphere particles for avalanche simulation",
      "locator_hints": [
        "white/snow colored spheres",
        "radius 0.3"
      ]
    },
    {
      "id": "A4",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to trigger the avalanche",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range input controlling simulation speed",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particlesActive === 0",
        "window.__3D_STATE__.avalancheTriggered === false",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "AvalancheTriggered",
      "conditions": [
        "window.__3D_STATE__.avalancheTriggered === true",
        "window.__3D_STATE__.particlesActive > 0",
        "window.__3D_STATE__.wavesReleased >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "AllWavesReleased",
      "conditions": [
        "window.__3D_STATE__.wavesReleased === 4",
        "window.__3D_STATE__.particlesReleased === 200"
      ]
    },
    {
      "id": "S3",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "GravityReEnabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "WindEnabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedModified",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S7",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.particlesActive === 0",
        "window.__3D_STATE__.avalancheTriggered === false",
        "window.__3D_STATE__.simTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avalancheTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wavesReleased >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesReleased >= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wavesReleased === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesReleased === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleSpeed >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avalancheTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avalancheTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particlesActive === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avalancheTriggered === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wavesReleased === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesReleased === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avalancheTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wavesReleased >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesHitObstacle >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}