    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.mode === 'bars'",
        "window.__3D_STATE__.colorScheme === 'rainbow'",
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.historyLength === 1"
      ]
    },
    {
      "id": "S9",
      "name": "MultiUndoState",
      "conditions": [
        "window.__3D_STATE__.undoCount >= 3"
      ]
    }
  ],
