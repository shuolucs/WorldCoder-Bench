  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'bars'",
        "window.__3D_STATE__.colorScheme === 'rainbow'",
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.barCount === 64",
        "window.__3D_STATE__.historyIndex === 0",
        "window.__3D_STATE__.historyLength === 1"
      ]
    },
    {
      "id": "S1",
      "name": "WaveMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'wave'",
        "window.__3D_STATE__.modeChangeCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "ThermalColor",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'thermal'"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.playing === false"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.undoCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "RingMode",
      "conditions": [
