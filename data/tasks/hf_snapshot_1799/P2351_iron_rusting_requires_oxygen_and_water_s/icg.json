  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.oxygenOn === false",
        "window.__3D_STATE__.waterOn === false",
        "window.__3D_STATE__.reactionState === 'idle'",
        "window.__3D_STATE__.sampleA.rustPercent === 0",
        "window.__3D_STATE__.sampleB.rustPercent === 0",
        "window.__3D_STATE__.sampleC.rustPercent === 0"
      ]
    },
    {
      "id": "S1",
      "name": "OxygenAdded",
      "conditions": [
        "window.__3D_STATE__.oxygenOn === true",
        "window.__3D_STATE__.waterOn === false",
        "window.__3D_STATE__.sampleA.hasOxygen === true",
        "window.__3D_STATE__.sampleC.hasOxygen === true"
      ]
    },
    {
      "id": "S2",
      "name": "BothReagentsAdded",
      "conditions": [
        "window.__3D_STATE__.oxygenOn === true",
        "window.__3D_STATE__.waterOn === true",
        "window.__3D_STATE__.sampleC.hasOxygen === true",
        "window.__3D_STATE__.sampleC.hasWater === true"
      ]
    },
    {
      "id": "S3",
      "name": "ReactionRunning",
      "conditions": [
        "window.__3D_STATE__.reactionState === 'running'",
        "window.__3D_STATE__.oxygenOn === true",
        "window.__3D_STATE__.waterOn === true"
      ]
    },
    {
      "id": "S4",
      "name": "RustProgressing",
      "conditions": [
        "window.__3D_STATE__.sampleC.rustPercent > 0",
        "window.__3D_STATE__.sampleC.rustPercent < 100",
        "window.__3D_STATE__.sampleA.rustPercent === 0",
        "window.__3D_STATE__.sampleB.rustPercent === 0"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2",
        "window.__3D_STATE__.reactionState === 'running'"
      ]
    },
    {
      "id": "S6",
      "name": "RustComplete",
      "conditions": [
        "window.__3D_STATE__.sampleC.rustPercent === 100",
        "window.__3D_STATE__.reactionState === 'complete'"
      ]
    },
    {
      "id": "S7",
      "name": "AnalysisShown",
      "conditions": [
        "window.__3D_STATE__.analysisVisible === true",
        "window.__3D_STATE__.sampleA.rustPercent === 0",
        "window.__3D_STATE__.sampleB.rustPercent === 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.oxygenOn === false",
        "window.__3D_STATE__.waterOn === false",
        "window.__3D_STATE__.reactionState === 'idle'",
        "window.__3D_STATE__.sampleC.rustPercent === 0",
        "window.__3D_STATE__.timeElapsed === 0"
      ]
    },
    {
      "id": "S9",
      "name": "WaterOnlyReactionAttempt",
      "conditions": [
        "window.__3D_STATE__.oxygenOn === false",
        "window.__3D_STATE__.waterOn === true",
        "window.__3D_STATE__.reactionState === 'running'"
      ]
    }
