    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "Math.abs(window.__3D_STATE__.bodyPosition.x) < 0.1",
        "Math.abs(window.__3D_STATE__.bodyPosition.z) < 0.1",
