{
  "task_id": "P1913_matcap_material_gallery_with_real_time_s",
  "affordances": [
    {
      "id": "A1",
      "name": "ShowcaseObjects",
      "type": "3d_object",
      "semantic": "Five 3D showcase objects on pedestals displaying matcap materials",
      "locator_hints": [
        "window.__3D_STATE__.showcaseObjectCount === 5",
        "window.__3D_STATE__.objectNames"
      ]
    },
    {
      "id": "A2",
      "name": "WireframeHighlight",
      "type": "3d_object",
      "semantic": "Cyan wireframe outline around the currently selected object",
      "locator_hints": [
        "window.__3D_STATE__.wireframeVisible"
      ]
    },
    {
      "id": "A3",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing selection, matcap, rotation, swaps",
      "locator_hints": [
        "#hud-panel",
        "#hud-selected",
        "#hud-matcap"
      ]
    },
    {
      "id": "A4",
      "name": "SwatchButtons",
      "type": "dom_element",
      "semantic": "Six matcap color swatch buttons for direct material assignment",
      "locator_hints": [
        "#swatch-0",
        "#swatch-1",
        "#swatch-2",
        "#swatch-3",
        "#swatch-4",
        "#swatch-5"
      ]
    },
    {
      "id": "A5",
      "name": "UndoRedoButtons",
      "type": "dom_element",
      "semantic": "Undo and Redo buttons for material history navigation",
      "locator_hints": [
        "#btn-undo",
        "#btn-redo"
      ]
    },
    {
      "id": "A6",
      "name": "ComparisonLabel",
      "type": "dom_element",
      "semantic": "Label shown when comparison mode is active",
      "locator_hints": [
        "#comparison-label"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialGallery",
      "conditions": [
        "window.__3D_STATE__.selectedIndex === 0",
        "JSON.stringify(window.__3D_STATE__.matcapAssignments) === '[0,1,2,3,4]'",
        "window.__3D_STATE__.comparisonMode === false",
        "window.__3D_STATE__.totalSwaps === 0",
        "window.__3D_STATE__.historyLength >= 1"
      ]
    },
    {
      "id": "S1",
      "name": "SelectionChanged",
      "conditions": [
        "window.__3D_STATE__.selectedIndex !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "MatcapSwappedViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.totalSwaps >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "MatcapSwappedViaSwatch",
      "conditions": [
        "window.__3D_STATE__.totalSwaps >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "RotationToggled",
      "conditions": [
        "window.__3D_STATE__.rotationStates.some(r => r === true)"
      ]
    },
    {
      "id": "S5",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.historyPointer < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S6",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.historyPointer > 0 || window.__3D_STATE__.totalSwaps >= 2"
      ]
    },
    {
      "id": "S7",
      "name": "ComparisonModeActive",
      "conditions": [
        "window.__3D_STATE__.comparisonMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "ComparisonModeExited",
      "conditions": [
        "window.__3D_STATE__.comparisonMode === false",
        "window.__3D_STATE__.comparisonSavedAssignments === null"
      ]
    },
    {
      "id": "S9",
      "name": "MultiSwapChained",
      "conditions": [
        "window.__3D_STATE__.totalSwaps >= 4"
      ]
    },
    {
      "id": "S10",
      "name": "UndoAfterChain",
      "conditions": [
        "window.__3D_STATE__.historyPointer < window.__3D_STATE__.historyLength - 1"
      ]
    },
    {
      "id": "S11",
      "name": "FinalVerified",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.showcaseObjectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapCount === 6",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.matcapAssignments) && window.__3D_STATE__.matcapAssignments.length === 5",
            "tier": "L0"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.matcapAssignments) === '[0,1,2,3,4]'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedIndex === 0 && window.__3D_STATE__.wireframeVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisible === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedObjectWorldPos.x - (-2)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectNames[window.__3D_STATE__.selectedIndex] === 'Box'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSwaps === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapNames[window.__3D_STATE__.matcapAssignments[1]] === 'Ice'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 0 && window.__3D_STATE__.matcapAssignments[2] === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#swatch-5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSwaps === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapNames[5] === 'Obsidian'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationStates[1] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationStates[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationStates[2] === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectRotationsY[1] === 'number' && !isNaN(window.__3D_STATE__.objectRotationsY[1])",
            "tier": "L0"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.objectRotationsY[1])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyPointer === window.__3D_STATE__.historyLength - 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSwaps === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapNames[window.__3D_STATE__.matcapAssignments[1]] === 'Ice'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapNames[window.__3D_STATE__.matcapAssignments[1]] === 'Obsidian'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyPointer === window.__3D_STATE__.historyLength - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.matcapAssignments) === '[0,5,2,3,4]'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.comparisonMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 5 && window.__3D_STATE__.matcapAssignments[1] === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[2] === 5 && window.__3D_STATE__.matcapAssignments[3] === 5 && window.__3D_STATE__.matcapAssignments[4] === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.comparisonSavedAssignments) && window.__3D_STATE__.comparisonSavedAssignments.length === 5",
            "tier": "L0"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.comparisonSavedAssignments) === '[0,5,2,3,4]'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.comparisonMode === false",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.matcapAssignments) === '[0,5,2,3,4]'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.comparisonSavedAssignments === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 0 && window.__3D_STATE__.matcapAssignments[2] === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[3] === 3 && window.__3D_STATE__.matcapAssignments[4] === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight'})); setTimeout(()=>{document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'})); setTimeout(()=>{document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));},200);},200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSwaps >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[2] === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 0 && window.__3D_STATE__.matcapAssignments[1] === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'z'})); setTimeout(()=>{ document.dispatchEvent(new KeyboardEvent('keydown',{key:'z'})); },200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.matcapAssignments[2] === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyPointer < window.__3D_STATE__.historyLength - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[0] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments[1] === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapNames[window.__3D_STATE__.matcapAssignments[2]] === 'Ice'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.matcapAssignments.every(v => typeof v === 'number' && v >= 0 && v <= 5 && !isNaN(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectRotationsY.every(v => Number.isFinite(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationStates.every(v => typeof v === 'boolean')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object' && Number.isFinite(window.__3D_STATE__.cameraPosition.x)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}