{
  "task_id": "P209_avalanche_simulation_on_terrain_with_und",
  "affordances": [
    {
      "id": "A1",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the avalanche simulation",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A3",
      "name": "AvalancheParticles",
      "type": "3d_object",
      "semantic": "200 white sphere particles representing snow/debris",
      "locator_hints": [
        "sphere meshes in scene"
      ]
    },
    {
      "id": "A4",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "Horse GLB model acting as obstacle on slope",
      "locator_hints": [
        "loaded GLTF model"
      ]
    },
    {
      "id": "A5",
      "name": "Terrain",
      "type": "3d_object",
      "semantic": "Mountainous slope terrain mesh",
      "locator_hints": [
        "PlaneGeometry with vertex displacement"
      ]
    },
    {
      "id": "A6",
      "name": "UndoKey",
      "type": "dom_element",
      "semantic": "Press U key to undo to previous snapshot",
      "locator_hints": [
        "keyboard U"
      ]
    },
    {
      "id": "A7",
      "name": "RedoKey",
      "type": "dom_element",
      "semantic": "Press R key to redo to next snapshot",
      "locator_hints": [
        "keyboard R"
      ]
    },
    {
      "id": "A8",
      "name": "PauseKey",
      "type": "dom_element",
      "semantic": "Press P key to pause/resume simulation",
      "locator_hints": [
        "keyboard P"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === false",
        "window.__3D_STATE__.activeParticles === 0",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.totalSnapshots === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HorseLoaded",
      "conditions": [
        "window.__3D_STATE__.horseLoaded === true",
        "window.__3D_STATE__.simulationStarted === false"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.activeParticles > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SnapshotsTaken",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === true",
        "window.__3D_STATE__.totalSnapshots > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === true",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.undoCount > 0",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S6",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.simulationStarted === false",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.totalSnapshots === 0",
        "window.__3D_STATE__.activeParticles === 0"
      ]
    }
  ],
