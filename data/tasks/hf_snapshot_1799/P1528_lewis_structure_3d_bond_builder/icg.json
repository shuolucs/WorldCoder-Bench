        "code": "document.querySelector('button').click(); /* click C button */ setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', {clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true}); canvas.dispatchEvent(evt); }, 200);"
