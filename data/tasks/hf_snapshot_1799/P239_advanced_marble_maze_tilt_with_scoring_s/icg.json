  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.dragonLoaded === true",
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GameStarted",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.lives === 3"
      ]
    },
    {
      "id": "S2",
      "name": "BoardTilted",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "Math.abs(window.__3D_STATE__.boardTiltX) > 0.01 || Math.abs(window.__3D_STATE__.boardTiltZ) > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "MarbleMoving",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "Math.abs(window.__3D_STATE__.marbleVelocity.x) > 0.01 || Math.abs(window.__3D_STATE__.marbleVelocity.z) > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "GemCollected",
      "conditions": [
        "window.__3D_STATE__.gemsCollected >= 1",
        "window.__3D_STATE__.score >= 100"
      ]
    },
    {
      "id": "S5",
      "name": "HazardHit",
      "conditions": [
        "window.__3D_STATE__.hazardHits >= 1",
        "window.__3D_STATE__.lives < 3"
      ]
    },
    {
      "id": "S6",
      "name": "MarbleRespawned",
      "conditions": [
        "window.__3D_STATE__.isInvincible === true",
        "Math.abs(window.__3D_STATE__.marblePosition.x - (-6)) < 0.5",
        "Math.abs(window.__3D_STATE__.marblePosition.z - (-6)) < 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "AllGemsCollected",
      "conditions": [
        "window.__3D_STATE__.gemsCollected === 5",
        "window.__3D_STATE__.gemsRemaining === 0",
        "window.__3D_STATE__.score === 500"
      ]
    },
    {
      "id": "S8",
      "name": "GameWon",
      "conditions": [
        "window.__3D_STATE__.gameWon === true",
        "window.__3D_STATE__.score === 500"
      ]
    },
    {
      "id": "S9",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.gemsCollected === 0"
      ]
    }
  ],
