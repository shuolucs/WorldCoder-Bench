      ]
    },
    {
      "id": "S3",
      "name": "Casting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'casting' || window.__3D_STATE__.gameState === 'waiting'"
      ]
    },
    {
      "id": "S4",
      "name": "Waiting_In_Water",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.hookY <= 0.0"
      ]
    },
    {
      "id": "S5",
      "name": "Fish_Biting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'biting'"
      ]
    },
    {
      "id": "S6",
      "name": "Fish_Caught",
      "conditions": [
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.fishRemaining <= 4",
        "window.__3D_STATE__.gameState === 'idle'"
      ]
    },
    {
      "id": "S7",
