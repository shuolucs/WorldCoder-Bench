  "states": [
    {
      "id": "S0",
      "name": "InitialAiming",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.ballLaunched === false",
        "window.__3D_STATE__.throwCount === 0",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "BallAimedRight",
      "conditions": [
        "window.__3D_STATE__.ballX > 0",
        "window.__3D_STATE__.gamePhase === 'aiming'"
      ]
    },
    {
      "id": "S2",
      "name": "BallRolling",
      "conditions": [
        "window.__3D_STATE__.ballLaunched === true",
        "window.__3D_STATE__.gamePhase === 'rolling'"
      ]
    },
    {
      "id": "S3",
      "name": "FirstThrowComplete",
      "conditions": [
        "window.__3D_STATE__.throwCount === 1",
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.undoStackSize === 1"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.throwCount === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.throwCount === 1",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.undoStackSize === 1"
      ]
    },
    {
      "id": "S6",
      "name": "SecondThrowComplete",
      "conditions": [
        "window.__3D_STATE__.throwCount === 2",
        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "UndoAfterSecondThrow",
      "conditions": [
        "window.__3D_STATE__.throwCount === 1",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    }
  ],
