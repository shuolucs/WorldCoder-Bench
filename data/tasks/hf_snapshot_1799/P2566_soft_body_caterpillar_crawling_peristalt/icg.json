{
  "task_id": "P2566_soft_body_caterpillar_crawling_peristalt",
  "affordances": [
    {
      "id": "A1",
      "name": "CaterpillarBody",
      "type": "3d_object",
      "semantic": "Array of 8 spherical segments forming the caterpillar body",
      "locator_hints": [
        "segments array in __3D_STATE__",
        "SphereGeometry meshes in scene"
      ]
    },
    {
      "id": "A2",
      "name": "HeadSegment",
      "type": "3d_object",
      "semantic": "The front-most segment (index 0) with antennae, slightly larger",
      "locator_hints": [
        "segments[0]",
        "darker green sphere with cylinder antennae"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Flat ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh",
        "green-brown colored"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing simulation status, wave speed, head position, distance",
      "locator_hints": [
        "div#hud",
        "document.getElementById('hud')"
      ]
    },
    {
      "id": "A5",
      "name": "SpaceKey",
      "type": "dom_element",
      "semantic": "Spacebar toggles pause/resume",
      "locator_hints": [
        "keydown event, code=Space"
      ]
    },
    {
      "id": "A6",
      "name": "ArrowUpKey",
      "type": "dom_element",
      "semantic": "Arrow Up increases wave speed",
      "locator_hints": [
        "keydown event, code=ArrowUp"
      ]
    },
    {
      "id": "A7",
      "name": "ArrowDownKey",
      "type": "dom_element",
      "semantic": "Arrow Down decreases wave speed",
      "locator_hints": [
        "keydown event, code=ArrowDown"
      ]
    },
    {
      "id": "A8",
      "name": "ResetKey",
      "type": "dom_element",
      "semantic": "R key resets caterpillar to origin",
      "locator_hints": [
        "keydown event, code=KeyR"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.waveSpeed === 3.0",
        "window.__3D_STATE__.segmentCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.waveSpeed > 3.0",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.waveSpeed < 3.0",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "CaterpillarMoving",
      "conditions": [
        "window.__3D_STATE__.distanceTraveled > 0.1",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S5",
      "name": "SegmentSelected",
      "conditions": [
        "window.__3D_STATE__.selectedSegment !== null"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.waveSpeed === 3.0",
        "Math.abs(window.__3D_STATE__.headPosition.z) < 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 8",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.segments) && window.__3D_STATE__.segments.length === 8",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.headPosition === 'object' && typeof window.__3D_STATE__.headPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.paused === true && window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.toLowerCase().includes('running')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distanceTraveled > 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => !isNaN(s.vx) && !isNaN(s.vy) && !isNaN(s.vz))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => s.y >= 0.3 && s.y < 2.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.some(s => s.gripping === true) || window.__3D_STATE__.segments.some(s => s.gripping === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => Math.sqrt(s.vx*s.vx + s.vy*s.vy + s.vz*s.vz) <= 10.1)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.waveSpeed === 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.springEnergies === 'number' && !isNaN(window.__3D_STATE__.springEnergies)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('3.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveSpeed <= 8.0 && window.__3D_STATE__.waveSpeed >= 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown',code:'ArrowDown',bubbles:true}));document.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowDown',code:'ArrowDown',bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.waveSpeed === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveSpeed < 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('2.0') || document.getElementById('hud').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true && window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('paused')",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S1",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationTime === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.waveSpeed === 3.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.headPosition.x) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.headPosition.z) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distanceTraveled < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segments.every(s => Math.abs(s.vx) < 0.1 && Math.abs(s.vz) < 0.1)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}