  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.lanternLoaded === true",
        "window.__3D_STATE__.clickCount === 0",
        "window.__3D_STATE__.glowEnabled === false",
        "window.__3D_STATE__.colorScheme === 'deep_blue'"
      ]
    },
    {
      "id": "S1",
      "name": "OceanClicked",
      "conditions": [
        "window.__3D_STATE__.clickCount >= 1",
        "window.__3D_STATE__.totalParticles >= 520"
      ]
    },
    {
      "id": "S2",
      "name": "GlowEnabled",
      "conditions": [
        "window.__3D_STATE__.glowEnabled === true",
        "window.__3D_STATE__.ambientIntensity >= 0.55"
      ]
    },
    {
      "id": "S3",
      "name": "LanternMoved",
      "conditions": [
        "window.__3D_STATE__.lanternMoveCount >= 1",
        "window.__3D_STATE__.lanternPosition.x !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'emerald'"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S6",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.stateLoaded === true"
      ]
    },
    {
      "id": "S7",
      "name": "GlowDisabled",
      "conditions": [
        "window.__3D_STATE__.glowEnabled === false",
        "window.__3D_STATE__.ambientIntensity <= 0.35"
      ]
    }
  ],
