        "#playPauseBtn"
      ]
    },
    {
      "id": "A2",
      "name": "StepButton",
      "type": "dom_element",
      "semantic": "Button to advance one phase when paused",
      "locator_hints": [
        "#stepBtn"
      ]
    },
    {
      "id": "A3",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling animation speed multiplier",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A4",
      "name": "LeftVentricle",
      "type": "3d_object",
      "semantic": "Red sphere representing the left ventricle",
      "locator_hints": [
        "leftVentricle",
        "Left Ventricle"
      ]
    },
    {
      "id": "A5",
      "name": "RightAtrium",
      "type": "3d_object",
      "semantic": "Blue sphere representing the right atrium",
      "locator_hints": [
        "rightAtrium",
        "Right Atrium"
      ]
    },
    {
      "id": "A6",
      "name": "Aorta",
      "type": "3d_object",
      "semantic": "Red cylinder representing the aorta",
      "locator_hints": [
        "aorta",
        "Aorta"
      ]
    },
    {
      "id": "A7",
      "name": "DragonModel",
      "type": "3d_object",
      "semantic": "Loaded GLB model used as anatomical reference sculpture",
      "locator_hints": [
        "DragonAttenuation"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel displaying selected chamber information",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing phase, cycle count, BPM",
      "locator_hints": [
        "phase",
        "cycle",
        "bpm"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPausedDiastole",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.phaseName === 'Diastole'"
      ]
    },
    {
      "id": "S1",
      "name": "PlayingDiastole",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentPhase === 0"
      ]
    },
    {
      "id": "S2",
      "name": "AtrialSystoleActive",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Atrial Systole'"
      ]
    },
    {
      "id": "S3",
      "name": "VentricularSystoleActive",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Ventricular Systole'"
      ]
    },
    {
      "id": "S4",
      "name": "PausedAtPhase2",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentPhase === 2"
      ]
    },
    {
      "id": "S5",
      "name": "SteppedToPhase3",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'Isovolumetric Relaxation'"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedAdjusted",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0",
        "window.__3D_STATE__.bpm === 144"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToPhase0",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.phaseName === 'Diastole'"
      ]
    },
    {
      "id": "S8",
      "name": "ChamberSelected",
      "conditions": [
        "window.__3D_STATE__.selectedChamber !== null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
