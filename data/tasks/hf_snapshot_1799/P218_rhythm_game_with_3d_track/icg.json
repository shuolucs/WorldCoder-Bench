  "states": [
    {
      "id": "S0",
      "name": "Initial_Waiting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.totalNotes === 14"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Started",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.elapsedTime >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "First_Note_Visible",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.activeNotes >= 1",
        "window.__3D_STATE__.notesSpawned >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "First_Hit_Registered",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.totalHits >= 1",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Combo_Building",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.combo >= 3",
        "window.__3D_STATE__.totalHits >= 3"
      ]
    },
    {
      "id": "S5",
      "name": "Miss_Occurred",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.totalMisses >= 1",
        "window.__3D_STATE__.combo === 0"
      ]
    },
    {
      "id": "S6",
      "name": "Combo_Rebuilt",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.combo >= 2",
        "window.__3D_STATE__.totalMisses >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Multiplier_Active",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.multiplier >= 2",
        "window.__3D_STATE__.combo >= 10"
      ]
    },
    {
      "id": "S8",
      "name": "Late_Game",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.notesSpawned >= 10"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Finished",
      "conditions": [
        "window.__3D_STATE__.gameState === 'finished'",
        "window.__3D_STATE__.totalHits + window.__3D_STATE__.totalMisses === 14"
      ]
    }
  ],
