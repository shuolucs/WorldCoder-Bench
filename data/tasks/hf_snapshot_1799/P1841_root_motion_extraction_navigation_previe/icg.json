            "expr": "window.__3D_STATE__.pathProgress > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalExtractedDistance > 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rootBoneLocalZ) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterWorldPos.x) && !isNaN(window.__3D_STATE__.characterWorldPos.z)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.extractedDeltaThisFrame === 'number' && !isNaN(window.__3D_STATE__.extractedDeltaThisFrame)",
            "tier": "L0"
          }
        ]
      }
    },
