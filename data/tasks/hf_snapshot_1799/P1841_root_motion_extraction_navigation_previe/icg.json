        "ground",
        "grid helper"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentAnimation === 'idle'",
        "window.__3D_STATE__.extractionEnabled === true",
        "window.__3D_STATE__.pathProgress === 0",
        "window.__3D_STATE__.waypointCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "Playing_Walking",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentAnimation === 'walkCycle'"
      ]
    },
    {
      "id": "S2",
      "name": "Playing_Progressed",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.pathProgress > 0",
        "window.__3D_STATE__.totalExtractedDistance > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused_MidPath",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.pathProgress > 0",
        "window.__3D_STATE__.pathProgress < 1"
      ]
    },
    {
      "id": "S4",
      "name": "Extraction_Disabled",
      "conditions": [
        "window.__3D_STATE__.extractionEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "Extraction_ReEnabled",
      "conditions": [
        "window.__3D_STATE__.extractionEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Waypoint_Added",
      "conditions": [
        "window.__3D_STATE__.waypointCount === 4"
      ]
    },
    {
      "id": "S7",
      "name": "Waypoint_Removed",
      "conditions": [
        "window.__3D_STATE__.waypointCount === 3"
      ]
    },
    {
      "id": "S8",
      "name": "Speed_Doubled",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.pathProgress === 0",
        "window.__3D_STATE__.totalExtractedDistance === 0",
        "window.__3D_STATE__.currentAnimation === 'idle'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentAnimation === 'walkCycle'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pathProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.extractionEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount !== undefined && window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
