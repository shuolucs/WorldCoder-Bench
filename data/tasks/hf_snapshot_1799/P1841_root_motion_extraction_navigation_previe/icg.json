  "affordances": [
    {
      "id": "A1",
      "name": "CharacterGroup",
      "type": "3d_object",
      "semantic": "The character's world-space transform group that receives extracted root motion",
      "locator_hints": [
        "characterGroup",
        "scene.getObjectByName('characterGroup')"
      ]
    },
    {
      "id": "A2",
      "name": "RootBone",
      "type": "3d_object",
      "semantic": "The root/hip bone of the procedural skeleton whose local Z is pinned during extraction",
