{
  "task_id": "P1133_miniature_acoustic_ray_tracing_room_anal",
  "affordances": [
    {
      "id": "A1",
      "name": "SoundSource",
      "type": "3d_object",
      "semantic": "Orange sphere representing the acoustic source point",
      "locator_hints": [
        "orange sphere",
        "radius 0.15",
        "source"
      ]
    },
    {
      "id": "A2",
      "name": "Receiver",
      "type": "3d_object",
      "semantic": "Purple sphere representing the listener/receiver",
      "locator_hints": [
        "purple sphere",
        "radius 0.12",
        "receiver"
      ]
    },
    {
      "id": "A3",
      "name": "TraceRaysButton",
      "type": "dom_element",
      "semantic": "Button that triggers acoustic ray tracing computation",
      "locator_hints": [
        "button",
        "Trace Rays"
      ]
    },
    {
      "id": "A4",
      "name": "ClearRaysButton",
      "type": "dom_element",
      "semantic": "Button that clears all ray visualizations",
      "locator_hints": [
        "button",
        "Clear Rays"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleWallsButton",
      "type": "dom_element",
      "semantic": "Button that toggles wall transparency",
      "locator_hints": [
        "button",
        "Toggle Walls"
      ]
    },
    {
      "id": "A6",
      "name": "RoomPresetDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select room preset configuration",
      "locator_hints": [
        "select",
        "dropdown",
        "Room Preset"
      ]
    },
    {
      "id": "A7",
      "name": "AnalysisPanel",
      "type": "dom_element",
      "semantic": "Panel displaying acoustic analysis results",
      "locator_hints": [
        "top-right",
        "panel",
        "RT60"
      ]
    },
    {
      "id": "A8",
      "name": "RoomGeometry",
      "type": "3d_object",
      "semantic": "The cutaway room box with semi-transparent walls",
      "locator_hints": [
        "box",
        "walls",
        "room"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 0",
        "window.__3D_STATE__.maxBounces === 3",
        "window.__3D_STATE__.roomPreset === 'Default'",
        "window.__3D_STATE__.wallOpacity === 0.4"
      ]
    },
    {
      "id": "S1",
      "name": "RaysTraced",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 12",
        "window.__3D_STATE__.raySegments.length > 0"
      ]
    },
    {
      "id": "S2",
      "name": "RaysCleared",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 0",
        "window.__3D_STATE__.raySegments.length === 0",
        "window.__3D_STATE__.raysClearedCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "WallsToggled",
      "conditions": [
        "window.__3D_STATE__.wallOpacity === 0.8"
      ]
    },
    {
      "id": "S4",
      "name": "BouncesChanged",
      "conditions": [
        "window.__3D_STATE__.maxBounces === 1"
      ]
    },
    {
      "id": "S5",
      "name": "RaysTracedWithOneBounce",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 12",
        "window.__3D_STATE__.maxBounces === 1"
      ]
    },
    {
      "id": "S6",
      "name": "PresetChanged",
      "conditions": [
        "window.__3D_STATE__.roomPreset === 'Concert Hall'"
      ]
    },
    {
      "id": "S7",
      "name": "ConcertHallTraced",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 12",
        "window.__3D_STATE__.roomPreset === 'Concert Hall'"
      ]
    },
    {
      "id": "S8",
      "name": "PositionsReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.sourcePosition.x - (-1)) < 0.05",
        "Math.abs(window.__3D_STATE__.receiverPosition.x - 1.5) < 0.05"
      ]
    },
    {
      "id": "S9",
      "name": "StudioPreset",
      "conditions": [
        "window.__3D_STATE__.roomPreset === 'Studio'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Trace Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.raysTraced === 12",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.raySegments === 'object' && Array.isArray(window.__3D_STATE__.raySegments)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.raySegments.length >= 12 && window.__3D_STATE__.raySegments.length <= 48",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rt60Estimate > 0 && window.__3D_STATE__.rt60Estimate < 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageEnergyAtReceiver >= 0 && window.__3D_STATE__.averageEnergyAtReceiver <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.raysReachingReceiver === 'number' && window.__3D_STATE__.raysReachingReceiver >= 0 && window.__3D_STATE__.raysReachingReceiver <= 12",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Clear Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.raysTraced === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.raySegments) && window.__3D_STATE__.raySegments.length === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.raysClearedCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raysReachingReceiver === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageEnergyAtReceiver === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Toggle Walls"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wallOpacity === 0.8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.wallOpacity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wallOpacity !== 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomPreset === 'Default'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxBounces === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxBounces === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxBounces !== 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raysTraced === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Trace Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.raysTraced === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxBounces === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raySegments.length >= 12 && window.__3D_STATE__.raySegments.length <= 24",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raySegments.every(s => s.bounceIndex <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raySegments.every(s => s.startEnergy >= 0 && s.startEnergy <= 1.0 && s.endEnergy >= 0 && s.endEnergy <= 1.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('select').value = 'Concert Hall'; document.querySelector('select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roomPreset === 'Concert Hall'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomVolume === 480",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficients.floor === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficients.ceiling === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficients.left_wall === 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Trace Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.raysTraced === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomPreset === 'Concert Hall'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rt60Estimate > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rt60Estimate - (0.161 * 480 / window.__3D_STATE__.totalAbsorption)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAbsorption > 0 && !isNaN(window.__3D_STATE__.totalAbsorption)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.sourcePosition.x - (-1)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sourcePosition.y - 1) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sourcePosition.z - 0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.receiverPosition.x - 1.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.receiverPosition.y - 1) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.receiverPosition.z - (-0.5)) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('select').value = 'Studio'; document.querySelector('select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roomPreset === 'Studio'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomVolume === 22.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficients.floor === 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficients.back_wall === 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAbsorption > 0 && !isNaN(window.__3D_STATE__.totalAbsorption)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.maxBounces = 3; document.querySelector('button').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.raysTraced === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomPreset === 'Studio'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rt60Estimate < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raySegments.every(s => !isNaN(s.startEnergy) && !isNaN(s.endEnergy))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageEnergyAtReceiver >= 0 && window.__3D_STATE__.averageEnergyAtReceiver <= 1.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}