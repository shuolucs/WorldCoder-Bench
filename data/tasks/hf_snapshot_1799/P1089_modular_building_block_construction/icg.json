  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Grid",
      "conditions": [
        "window.__3D_STATE__.blockCount === 0",
        "window.__3D_STATE__.activeColorIndex === 0",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.maxHeight === 0",
        "window.__3D_STATE__.rotation === 0"
      ]
    },
    {
      "id": "S1",
      "name": "First_Block_Placed",
      "conditions": [
        "window.__3D_STATE__.blockCount === 1",
        "window.__3D_STATE__.maxHeight === 1",
        "window.__3D_STATE__.lastAction === 'place'"
      ]
    },
    {
      "id": "S2",
      "name": "Stacked_Blocks",
      "conditions": [
        "window.__3D_STATE__.blockCount >= 2",
        "window.__3D_STATE__.maxHeight >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "Color_Changed",
      "conditions": [
        "window.__3D_STATE__.activeColorIndex !== 0",
        "window.__3D_STATE__.lastAction === 'colorChange'"
      ]
    },
    {
      "id": "S4",
      "name": "Block_Deleted_Collapsed",
      "conditions": [
        "window.__3D_STATE__.floatingBlocks === 0",
        "window.__3D_STATE__.lastAction === 'delete'"
      ]
    },
    {
      "id": "S5",
      "name": "Rotation_Applied",
      "conditions": [
        "window.__3D_STATE__.rotation === 90",
        "window.__3D_STATE__.lastAction === 'rotate'"
      ]
    },
    {
      "id": "S6",
      "name": "Gravity_Disabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false",
        "window.__3D_STATE__.lastAction === 'gravityToggle'"
      ]
    },
    {
      "id": "S7",
      "name": "Undo_Performed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S8",
      "name": "Multi_Block_Structure",
      "conditions": [
        "window.__3D_STATE__.blockCount >= 3",
        "window.__3D_STATE__.totalVolume === window.__3D_STATE__.blockCount"
      ]
    },
    {
      "id": "S9",
      "name": "Camera_Target_Adjusted",
      "conditions": [
        "window.__3D_STATE__.cameraTargetY >= 1"
      ]
    }
