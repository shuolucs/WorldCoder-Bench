  "states": [
    {
      "id": "S0",
      "name": "InitialGalvanic",
      "conditions": [
        "window.__3D_STATE__.voltage === 0",
        "window.__3D_STATE__.mode === 'galvanic'",
        "window.__3D_STATE__.cuMass === 100",
        "window.__3D_STATE__.znMass === 100",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isDepleted === false"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.flowRate > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "VoltageAdjustedGalvanic",
      "conditions": [
        "window.__3D_STATE__.voltage !== 0",
        "window.__3D_STATE__.voltage < 1.10",
        "window.__3D_STATE__.mode === 'galvanic'"
      ]
    },
    {
      "id": "S3",
      "name": "ElectrolyticMode",
      "conditions": [
        "window.__3D_STATE__.voltage >= 1.10",
        "window.__3D_STATE__.mode === 'electrolytic'"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Boosted",
      "conditions": [
        "window.__3D_STATE__.isBoosted === true",
        "window.__3D_STATE__.particleSpeedMultiplier === 2.0"
      ]
    },
    {
      "id": "S6",
      "name": "MassChanged",
      "conditions": [
        "window.__3D_STATE__.cuMass !== 100 || window.__3D_STATE__.znMass !== 100",
        "window.__3D_STATE__.totalMass === 200"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.voltage === 0",
        "window.__3D_STATE__.cuMass === 100",
        "window.__3D_STATE__.znMass === 100",
        "window.__3D_STATE__.mode === 'galvanic'"
      ]
    },
    {
      "id": "S8",
      "name": "NegativeVoltageGalvanic",
      "conditions": [
        "window.__3D_STATE__.voltage < 0",
        "window.__3D_STATE__.mode === 'galvanic'",
        "window.__3D_STATE__.flowRate > 0"
      ]
    },
    {
      "id": "S9",
      "name": "BoostExpired",
      "conditions": [
        "window.__3D_STATE__.isBoosted === false",
        "window.__3D_STATE__.particleSpeedMultiplier === 1.0",
        "window.__3D_STATE__.boostTimeRemaining === 0"
      ]
    }
  ],
