{
  "task_id": "P542_heightmap_terrain",
  "affordances": [
    {"id": "A1", "name": "Terrain", "type": "3d_object", "semantic": "Heightmap terrain mesh with vertex colors and texture", "locator_hints": ["plane geometry mesh"]},
    {"id": "A2", "name": "Balls", "type": "3d_object", "semantic": "Rolling physics balls", "locator_hints": ["sphere meshes"]},
    {"id": "A3", "name": "GravitySlider", "type": "dom_element", "semantic": "Gravity control", "locator_hints": ["#slider-gravity"]},
    {"id": "A4", "name": "FrictionSlider", "type": "dom_element", "semantic": "Friction control", "locator_hints": ["#slider-friction"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.ballCount === 0", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "BallsSpawned", "conditions": ["window.__3D_STATE__.ballCount > 0"]},
    {"id": "S2", "name": "BallsFalling", "conditions": ["window.__3D_STATE__.totalKE > 0.1"]},
    {"id": "S3", "name": "MultipleBalls", "conditions": ["window.__3D_STATE__.ballCount >= 5"]},
    {"id": "S4", "name": "Cleared", "conditions": ["window.__3D_STATE__.ballCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.terrainSeed !== undefined", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballCount === 0", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "b"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ballCount === 1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgBallY < before.avgBallY || window.__3D_STATE__.allBallsAboveTerrain === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "for(let i=0;i<4;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'b'}));} return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ballCount >= 3", "tier": "L2"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-gravity').value = 20; document.getElementById('slider-gravity').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.gravity >= 18", "tier": "L2"},
        {"expr": "window.__3D_STATE__.allBallsAboveTerrain === true", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "c"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ballCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalKE === 0 || window.__3D_STATE__.totalKE < 0.001", "tier": "L1"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.terrainSeed !== before.terrainSeed", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballCount === 0", "tier": "L2"}
      ]}
    }
  ]
}
