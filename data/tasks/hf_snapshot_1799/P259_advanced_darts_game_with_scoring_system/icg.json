  "states": [
    {
      "id": "S0",
      "name": "GameInitialized",
      "conditions": [
        "window.__3D_STATE__.score === 501",
        "window.__3D_STATE__.round === 1",
        "window.__3D_STATE__.dartsLeft === 3",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S1",
      "name": "PowerLocked",
      "conditions": [
        "window.__3D_STATE__.powerLocked === true",
        "window.__3D_STATE__.powerValue >= 0",
        "window.__3D_STATE__.powerValue <= 100"
      ]
    },
    {
      "id": "S2",
      "name": "DartInFlight",
      "conditions": [
        "window.__3D_STATE__.throwInProgress === true",
        "window.__3D_STATE__.dartsLeft < 3"
      ]
    },
    {
      "id": "S3",
      "name": "DartLanded",
      "conditions": [
        "window.__3D_STATE__.throwInProgress === false",
        "window.__3D_STATE__.dartsOnBoard >= 1",
        "window.__3D_STATE__.dartsThrown >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "SecondDartReady",
      "conditions": [
        "window.__3D_STATE__.dartsLeft === 2",
        "window.__3D_STATE__.throwInProgress === false",
        "window.__3D_STATE__.powerLocked === false"
      ]
    },
    {
      "id": "S5",
      "name": "AllDartsThrown",
      "conditions": [
        "window.__3D_STATE__.dartsLeft === 0",
        "window.__3D_STATE__.dartsOnBoard === 3"
      ]
    },
    {
      "id": "S6",
      "name": "BoardCleared",
      "conditions": [
        "window.__3D_STATE__.dartsOnBoard === 0",
        "window.__3D_STATE__.dartsLeft === 3",
        "window.__3D_STATE__.round >= 2"
      ]
    },
    {
      "id": "S7",
      "name": "BustOccurred",
      "conditions": [
        "window.__3D_STATE__.isBust === true"
      ]
    },
    {
      "id": "S8",
      "name": "FoxCelebrating",
      "conditions": [
        "window.__3D_STATE__.foxCelebrating === true"
      ]
    },
    {
      "id": "S9",
      "name": "FoxShaking",
      "conditions": [
        "window.__3D_STATE__.foxShaking === true"
      ]
    },
    {
      "id": "S10",
      "name": "WindChanged",
      "conditions": [
        "window.__3D_STATE__.windStrength >= 0",
        "window.__3D_STATE__.windStrength <= 5",
        "typeof window.__3D_STATE__.windDirection === 'string'"
      ]
    },
    {
      "id": "S11",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.score === 501",
        "window.__3D_STATE__.round === 1",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.dartsOnBoard === 0"
      ]
    }
  ],
