  "affordances": [
    {
      "id": "A1",
      "name": "IKChain",
      "type": "3d_object",
      "semantic": "The articulated chain of cylindrical segments connected by joints",
      "locator_hints": [
        "group containing cylinder meshes",
        "children of chain group"
      ]
    },
    {
      "id": "A2",
      "name": "Target",
      "type": "3d_object",
      "semantic": "The glowing red target sphere the IK chain reaches toward",
      "locator_hints": [
        "sphere mesh with emissive red material",
        "wireframe icosahedron"
      ]
    },
    {
      "id": "A3",
      "name": "Joints",
      "type": "3d_object",
      "semantic": "Small spheres at each joint position along the chain",
      "locator_hints": [
