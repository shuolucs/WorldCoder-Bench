      "locator_hints": [
        "button containing 'Remove Segment'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 5",
        "window.__3D_STATE__.segmentLength === 2.0",
        "window.__3D_STATE__.chainReach === 10.0",
        "window.__3D_STATE__.isOrbiting === false",
        "window.__3D_STATE__.basePosition.x === 0 && window.__3D_STATE__.basePosition.y === 0 && window.__3D_STATE__.basePosition.z === 0"
      ]
    },
    {
      "id": "S1",
      "name": "TargetMovedRight",
      "conditions": [
        "window.__3D_STATE__.targetPosition.x > 3.0",
        "window.__3D_STATE__.isOrbiting === false"
      ]
    },
    {
      "id": "S2",
      "name": "TargetMovedUp",
      "conditions": [
        "window.__3D_STATE__.targetPosition.y > 4.0"
      ]
    },
    {
      "id": "S3",
      "name": "TargetReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.targetPosition.x - 3.0) < 0.01",
        "Math.abs(window.__3D_STATE__.targetPosition.y - 4.0) < 0.01",
        "Math.abs(window.__3D_STATE__.targetPosition.z - 0.0) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "SegmentAdded",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 6",
        "window.__3D_STATE__.chainReach === 12.0"
      ]
    },
    {
      "id": "S5",
      "name": "SegmentRemoved",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 5",
        "window.__3D_STATE__.chainReach === 10.0"
      ]
    },
    {
      "id": "S6",
      "name": "OrbitActive",
      "conditions": [
        "window.__3D_STATE__.isOrbiting === true"
      ]
    },
    {
      "id": "S7",
      "name": "OrbitStopped",
      "conditions": [
        "window.__3D_STATE__.isOrbiting === false",
        "window.__3D_STATE__.orbitAngle > 0"
      ]
    },
    {
      "id": "S8",
      "name": "TargetMovedZ",
      "conditions": [
        "Math.abs(window.__3D_STATE__.targetPosition.z) > 0.2"
      ]
    },
    {
      "id": "S9",
      "name": "MultipleSegmentsAdded",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 8",
        "window.__3D_STATE__.chainReach === 16.0"
      ]
    }
