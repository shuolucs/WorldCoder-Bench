      ]
    },
    {
      "id": "A4",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD panel showing chain stats and controls",
      "locator_hints": [
        "div with position absolute top-left"
      ]
    },
    {
      "id": "A5",
      "name": "AddSegmentButton",
      "type": "dom_element",
      "semantic": "Button to add a segment to the IK chain",
