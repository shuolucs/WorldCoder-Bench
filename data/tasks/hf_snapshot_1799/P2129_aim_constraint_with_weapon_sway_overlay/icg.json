        "window.__3D_STATE__.boneNames.length > 0"
      ]
    },
    {
      "id": "S1",
      "name": "AimDisabled",
      "conditions": [
        "window.__3D_STATE__.aimEnabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "AimReEnabled",
      "conditions": [
        "window.__3D_STATE__.aimEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "WeightCycled",
      "conditions": [
        "window.__3D_STATE__.aimWeight === 0.25"
      ]
    },
    {
      "id": "S4",
      "name": "TargetAtPreset1",
      "conditions": [
        "Math.abs(window.__3D_STATE__.aimTargetPosition.x - 1.0) < 0.1"
      ]
    },
    {
      "id": "S5",
      "name": "TargetAtPreset2",
      "conditions": [
        "Math.abs(window.__3D_STATE__.aimTargetPosition.x - (-1.5)) < 0.1"
      ]
    },
    {
      "id": "S6",
      "name": "SwayDisabled",
      "conditions": [
        "window.__3D_STATE__.swayEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "SwayReEnabled",
      "conditions": [
        "window.__3D_STATE__.swayEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "ADSActive",
      "conditions": [
        "window.__3D_STATE__.adsMode === true"
      ]
    },
    {
      "id": "S9",
      "name": "ADSDeactivated",
      "conditions": [
        "window.__3D_STATE__.adsMode === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.boneNames === 'object' && Array.isArray(window.__3D_STATE__.boneNames) && window.__3D_STATE__.boneNames.length > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.headBoneName === 'string' && window.__3D_STATE__.headBoneName.length > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.handBoneName === 'string' && window.__3D_STATE__.handBoneName.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.weaponAttached === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.aimEnabled === true && window.__3D_STATE__.swayEnabled === true && window.__3D_STATE__.adsMode === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.aimEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('aim-status') !== null && document.getElementById('aim-status').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.headDeflectionAngle >= 0 && window.__3D_STATE__.headDeflectionAngle <= 60",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.headQuaternion === 'object' && window.__3D_STATE__.headQuaternion !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.headQuaternion.x**2 + window.__3D_STATE__.headQuaternion.y**2 + window.__3D_STATE__.headQuaternion.z**2 + window.__3D_STATE__.headQuaternion.w**2) - 1.0) < 0.002",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
