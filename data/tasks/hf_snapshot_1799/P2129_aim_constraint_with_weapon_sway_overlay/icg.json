            "tier": "L2"
          },
          {
            "expr": "document.getElementById('aim-weight') !== null && document.getElementById('aim-weight').textContent.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.aimWeight !== 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.aimWeight === 'number' && !isNaN(window.__3D_STATE__.aimWeight)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.aimWeight >= 0 && window.__3D_STATE__.aimWeight <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
