          {
            "expr": "document.getElementById('aim-status') !== null && document.getElementById('aim-status').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.aimWeight >= 0 && window.__3D_STATE__.aimWeight <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.aimTargetPosition === 'object' && !isNaN(window.__3D_STATE__.aimTargetPosition.x)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
