          },
          {
            "expr": "window.__3D_STATE__.swayPitch === 0 || Math.abs(window.__3D_STATE__.swayPitch) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.weaponWorldPosition === 'object' && !isNaN(window.__3D_STATE__.weaponWorldPosition.x)",
            "tier": "L0"
