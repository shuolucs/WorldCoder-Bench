            "expr": "Math.abs(window.__3D_STATE__.depthVarianceScore + window.__3D_STATE__.symmetryScore + window.__3D_STATE__.rhythmScore + window.__3D_STATE__.coverageScore - window.__3D_STATE__.totalScore) < 0.01",
            "tier": "L2"
