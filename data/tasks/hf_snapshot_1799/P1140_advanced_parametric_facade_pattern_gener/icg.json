  "states": [
    {
      "id": "S0",
      "name": "InitialWavePattern",
      "conditions": [
        "window.__3D_STATE__.patternMode === 'wave'",
        "window.__3D_STATE__.columns === 8",
        "window.__3D_STATE__.rows === 5",
        "window.__3D_STATE__.totalPanels === 40",
        "window.__3D_STATE__.frequency === 2.0",
        "window.__3D_STATE__.extrusionScale === 1.0",
        "window.__3D_STATE__.totalScore >= 0 && window.__3D_STATE__.totalScore <= 100"
      ]
    },
    {
      "id": "S1",
      "name": "DiamondPatternActive",
      "conditions": [
        "window.__3D_STATE__.patternMode === 'diamond'",
