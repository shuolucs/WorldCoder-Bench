      ]
    },
    {
      "id": "S2",
      "name": "SpiralPatternActive",
      "conditions": [
        "window.__3D_STATE__.patternMode === 'spiral'"
      ]
    },
    {
      "id": "S3",
      "name": "FrequencyAdjusted",
      "conditions": [
        "window.__3D_STATE__.frequency !== 2.0"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S5",
      "name": "RedoneState",
      "conditions": [
