      ]
    },
    {
      "id": "S3",
      "name": "DipoleRotated",
      "conditions": [
        "window.__3D_STATE__.dipoles[0].momentX === 1",
        "window.__3D_STATE__.dipoles[0].momentY === 0",
        "window.__3D_STATE__.undoStackSize === 2"
