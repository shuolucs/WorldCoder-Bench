        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S6",
      "name": "RedoSecondDipole",
      "conditions": [
        "window.__3D_STATE__.dipoleCount === 2",
        "window.__3D_STATE__.undoStackSize === 3",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "SecondDipoleSelectedAndRemoved",
      "conditions": [
        "window.__3D_STATE__.dipoleCount === 1",
        "window.__3D_STATE__.undoStackSize === 4",
        "window.__3D_STATE__.lastAction === 'remove'"
      ]
    },
    {
      "id": "S8",
      "name": "UndoRemoval",
      "conditions": [
        "window.__3D_STATE__.dipoleCount === 2",
        "window.__3D_STATE__.undoStackSize === 3",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S9",
      "name": "UndoAllActions",
      "conditions": [
        "window.__3D_STATE__.dipoleCount === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.fieldLineCount === 0"
      ]
    }
