  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.dipoleCount === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "FirstDipolePlaced",
      "conditions": [
        "window.__3D_STATE__.dipoleCount === 1",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.fieldLineCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "FirstDipoleSelected",
