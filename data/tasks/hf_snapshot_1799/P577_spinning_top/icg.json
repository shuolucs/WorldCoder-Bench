    {"id": "A1", "name": "SpinningTop", "type": "3d_object", "semantic": "Cone-shaped spinning top with stem, exhibiting precession and nutation", "locator_hints": ["top", "cone", "spinning", "group"]},
    {"id": "A2", "name": "Table", "type": "3d_object", "semantic": "Wooden table surface textured with hardwood2_diffuse.jpg", "locator_hints": ["table", "surface", "floor", "wood"]},
