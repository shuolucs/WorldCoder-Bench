          },
          {
            "expr": "window.__3D_STATE__.particleCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSpeed > 0 && !isNaN(window.__3D_STATE__.avgSpeed)",
            "tier": "L2"
          },
