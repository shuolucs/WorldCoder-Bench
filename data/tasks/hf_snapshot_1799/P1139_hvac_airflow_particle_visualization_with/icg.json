  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.recycledCount === 0",
        "window.__3D_STATE__.elapsedFrames === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ParticlesEmitting",
      "conditions": [
        "window.__3D_STATE__.particleCount > 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedFrames > 30"
      ]
    },
    {
      "id": "S2",
      "name": "DebugOverlayActive",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true",
        "window.__3D_STATE__.particleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "HighEmissionRate",
      "conditions": [
        "window.__3D_STATE__.emissionRate >= 25",
        "window.__3D_STATE__.particleCount > 50"
      ]
    },
    {
      "id": "S5",
      "name": "HighTemperatureSupply",
      "conditions": [
        "window.__3D_STATE__.supplyTemperature >= 28"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesRecycling",
      "conditions": [
        "window.__3D_STATE__.recycledCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "HighFanPower",
      "conditions": [
        "window.__3D_STATE__.fanPower >= 2.5"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.particleCount === 0",
        "window.__3D_STATE__.recycledCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.particleCount > 0"
      ]
    }
  ],
