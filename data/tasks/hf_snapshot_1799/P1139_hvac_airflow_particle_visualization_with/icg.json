      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particlePositions === 'object' && Array.isArray(window.__3D_STATE__.particlePositions)",
