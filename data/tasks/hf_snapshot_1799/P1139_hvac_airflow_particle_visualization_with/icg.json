        "code": "let slider = document.querySelectorAll('input[type=range]')[0]; slider.value = 28; slider.dispatchEvent(new Event('input', {bubbles:true})); let pauseBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/resume/i)); if(pauseBtn) pauseBtn.click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.emissionRate >= 25",
            "tier": "L2"
