{
  "task_id": "P585_friction_ramp",
  "affordances": [
    {"id": "A1", "name": "Ramp", "type": "3d_object", "semantic": "Inclined ramp with wood texture and side rails", "locator_hints": ["rotated box mesh with hardwood texture"]},
    {"id": "A2", "name": "ToyCar", "type": "3d_object", "semantic": "ToyCar GLB model sliding on ramp", "locator_hints": ["GLTF model ToyCar"]},
    {"id": "A3", "name": "Duck", "type": "3d_object", "semantic": "Duck GLB model sliding on ramp", "locator_hints": ["GLTF model Duck"]},
    {"id": "A4", "name": "ForceArrows", "type": "3d_object", "semantic": "Colored force vector arrows on objects", "locator_hints": ["arrow helpers green red blue"]},
    {"id": "A5", "name": "AngleSlider", "type": "dom_element", "semantic": "Ramp angle control", "locator_hints": ["#slider-angle"]},
    {"id": "A6", "name": "FrictionSlider", "type": "dom_element", "semantic": "Friction multiplier control", "locator_hints": ["#slider-friction"]},
    {"id": "A7", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.frameCount > 0", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Sliding", "conditions": ["window.__3D_STATE__.carStatus === 'Sliding' || window.__3D_STATE__.duckStatus === 'Sliding'"]},
    {"id": "S2", "name": "AngleChanged", "conditions": ["window.__3D_STATE__.rampAngle !== 30"]},
    {"id": "S3", "name": "FrictionChanged", "conditions": ["window.__3D_STATE__.frictionMultiplier !== 0.30"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.carPosition < 0.1", "window.__3D_STATE__.duckPosition < 0.1"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"},
        {"expr": "window.__3D_STATE__.rampAngle >= 10 && window.__3D_STATE__.rampAngle <= 60", "tier": "L2"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-angle').value = 50; document.getElementById('slider-angle').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.rampAngle >= 45", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "g"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.carStatus === 'Sliding' || window.__3D_STATE__.duckStatus === 'Sliding'", "tier": "L1"},
        {"expr": "window.__3D_STATE__.carSpeed >= 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S1", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.carSpeed > 0 || window.__3D_STATE__.carPosition > 0.5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.carSpeed >= window.__3D_STATE__.duckSpeed || window.__3D_STATE__.carPosition >= window.__3D_STATE__.duckPosition", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S1", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.carPosition < 0.5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.duckPosition < 0.5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-friction').value = 0.80; document.getElementById('slider-friction').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.frictionMultiplier >= 0.70", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.forceArrowsVisible !== before.forceArrowsVisible", "tier": "L2"}
      ]}
    }
  ]
}
