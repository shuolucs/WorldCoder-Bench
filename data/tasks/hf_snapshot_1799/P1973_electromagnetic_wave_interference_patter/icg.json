    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.wavelength === 2.0",
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.phaseOffset === 0",
        "window.__3D_STATE__.amplitude === 1.0",
        "window.__3D_STATE__.sourceMode === 'dual'",
        "window.__3D_STATE__.colorScheme === 'RedBlue'",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.s1Position.x === -3 && window.__3D_STATE__.s1Position.z === 0",
        "window.__3D_STATE__.s2Position.x === 3 && window.__3D_STATE__.s2Position.z === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S2",
      "name": "WavelengthIncreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.wavelength - 2.1) < 0.001"
      ]
    },
    {
      "id": "S3",
      "name": "PhaseOffsetChanged",
      "conditions": [
        "Math.abs(window.__3D_STATE__.phaseOffset - Math.PI/12) < 0.001"
      ]
