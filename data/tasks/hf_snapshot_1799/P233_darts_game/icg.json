  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.dartsRemaining === 5",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.isThrowInProgress === false"
      ]
    },
    {
