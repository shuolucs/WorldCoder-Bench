      ]
    },
    {
      "id": "S3",
      "name": "ThrowInProgress",
      "conditions": [
        "window.__3D_STATE__.isThrowInProgress === true"
      ]
    },
    {
      "id": "S4",
      "name": "FirstDartLanded",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 1",
        "window.__3D_STATE__.dartsRemaining === 4",
        "window.__3D_STATE__.isThrowInProgress === false"
      ]
    },
    {
      "id": "S5",
      "name": "PowerAdjusted",
      "conditions": [
        "window.__3D_STATE__.power !== 7"
      ]
    },
    {
      "id": "S6",
      "name": "MultipleDartsThrown",
      "conditions": [
        "window.__3D_STATE__.dartsThrown >= 3",
        "window.__3D_STATE__.dartsRemaining <= 2"
      ]
    },
    {
      "id": "S7",
      "name": "AllDartsThrown",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 5",
        "window.__3D_STATE__.dartsRemaining === 0",
        "window.__3D_STATE__.gameOver === true"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.dartsRemaining === 5",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.gameOver === false"
      ]
    }
  ],
