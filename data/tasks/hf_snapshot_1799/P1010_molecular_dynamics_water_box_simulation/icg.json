{
  "task_id": "P1010_molecular_dynamics_water_box_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "SimulationBox",
      "type": "3d_object",
      "semantic": "Wireframe cube bounding the simulation volume",
      "locator_hints": [
        "EdgesGeometry wireframe",
        "side length 20"
      ]
    },
    {
      "id": "A2",
      "name": "WaterMolecules",
      "type": "3d_object",
      "semantic": "27 water molecules each with 1 oxygen and 2 hydrogen spheres",
      "locator_hints": [
        "red spheres for O",
        "white spheres for H",
        "gray cylinder bonds"
      ]
    },
    {
      "id": "A3",
      "name": "PlayPauseButton",
