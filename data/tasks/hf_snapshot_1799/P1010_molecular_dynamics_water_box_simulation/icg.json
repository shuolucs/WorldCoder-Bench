            "expr": "window.__3D_STATE__.stepCount > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTemperature > 0 && !isNaN(window.__3D_STATE__.currentTemperature)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.molecules.every(m => m.position.x >= -10 && m.position.x <= 10 && m.position.y >= -10 && m.position.y <= 10 && m.position.z >= -10 && m.position.z <= 10)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.molecules.every(m => !isNaN(m.speed) && m.speed >= 0 && isFinite(m.speed))",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.energyHistory) && window.__3D_STATE__.energyHistory.length > 0 && window.__3D_STATE__.energyHistory.every(e => !isNaN(e) && isFinite(e))",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-steps') !== null && parseInt(document.getElementById('hud-steps').textContent.replace(/[^0-9]/g,'')) > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
