  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.moleculeCount === 27",
        "window.__3D_STATE__.colorMode === 'element'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.stepCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationAdvanced",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.stepCount > 50"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationPausedMidway",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.stepCount > 50"
      ]
    },
    {
      "id": "S4",
      "name": "BondsHidden",
      "conditions": [
        "window.__3D_STATE__.bondsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "PeriodicGhostsOn",
      "conditions": [
        "window.__3D_STATE__.periodicGhostsVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "VelocityColorMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'velocity'"
      ]
    },
