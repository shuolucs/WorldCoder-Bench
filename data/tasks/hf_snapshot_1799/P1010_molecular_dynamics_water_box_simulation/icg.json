        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.moleculeCount === 27",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 81",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boxSize === 20",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.molecules) && window.__3D_STATE__.molecules.length === 27",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bondsVisible === true && window.__3D_STATE__.colorMode === 'element'",
            "tier": "L2"
