        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S9",
      "name": "TimestepChanged",
      "conditions": [
        "window.__3D_STATE__.dt === 0.008"
      ]
    }
  ],
  "transitions": [
