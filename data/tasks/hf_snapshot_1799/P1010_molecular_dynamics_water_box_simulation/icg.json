            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.potentialEnergy === 'number' && !isNaN(window.__3D_STATE__.potentialEnergy)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          }
        ]
