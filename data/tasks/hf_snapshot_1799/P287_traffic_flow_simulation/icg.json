  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.vehicleCount === 8",
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.totalWraps === 0",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationTime > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedDoubled",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedQuadrupled",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 4"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "LightCycleCompleted",
      "conditions": [
        "window.__3D_STATE__.lightCycleCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "WrapsOccurred",
      "conditions": [
        "window.__3D_STATE__.totalWraps > 0"
      ]
    },
    {
      "id": "S8",
      "name": "SlowedDown",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2"
      ]
    },
    {
      "id": "S9",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.simulationTime < 0.5",
        "window.__3D_STATE__.totalWraps === 0"
      ]
    }
  ],
