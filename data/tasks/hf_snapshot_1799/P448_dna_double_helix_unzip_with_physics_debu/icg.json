        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.activePhysicsBodies === 0"
      ]
    },
    {
      "id": "S9",
      "name": "DebugOverlayHiddenAgain",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    }
  ],
