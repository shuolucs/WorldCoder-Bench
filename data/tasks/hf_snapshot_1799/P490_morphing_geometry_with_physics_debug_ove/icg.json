{
  "task_id": "P490_morphing_geometry_with_physics_debug_ove",
  "affordances": [
    {
      "id": "A1",
      "name": "MorphObject",
      "type": "3d_object",
      "semantic": "Central morphing geometry with spring physics",
      "locator_hints": [
        "mesh at approximately y=2",
        "MeshPhongMaterial with color 0x00ffaa"
      ]
    },
    {
      "id": "A2",
      "name": "DebugPanel",
      "type": "dom_element",
      "semantic": "Physics debug overlay panel on right side",
      "locator_hints": [
        "div with position fixed/absolute on right",
        "300px wide panel"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry 20x20 at y=0"
      ]
    },
    {
      "id": "A4",
      "name": "GridHelper",
      "type": "3d_object",
      "semantic": "Grid overlay on ground",
      "locator_hints": [
        "GridHelper with 20 divisions"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentShape === 'sphere'",
        "window.__3D_STATE__.morphProgress === 1.0",
        "window.__3D_STATE__.wireframe === false",
        "window.__3D_STATE__.physicsFrozen === false",
        "window.__3D_STATE__.rotationSpeed === 0.5"
      ]
    },
    {
      "id": "S1",
      "name": "ShapeMorphedToBox",
      "conditions": [
        "window.__3D_STATE__.currentShape === 'box'",
        "window.__3D_STATE__.morphProgress === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "BounceApplied",
      "conditions": [
        "window.__3D_STATE__.velocityY > 0",
        "window.__3D_STATE__.positionY >= 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S4",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "RotationCycled",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed === 0.0"
      ]
    },
    {
      "id": "S6",
      "name": "PhysicsFrozen",
      "conditions": [
        "window.__3D_STATE__.physicsFrozen === true"
      ]
    },
    {
      "id": "S7",
      "name": "SettledAtEquilibrium",
      "conditions": [
        "Math.abs(window.__3D_STATE__.positionY - 2.0) < 0.05",
        "Math.abs(window.__3D_STATE__.velocityY) < 0.05"
      ]
    },
    {
      "id": "S8",
      "name": "MorphedToTorus",
      "conditions": [
        "window.__3D_STATE__.currentShape === 'torus'",
        "window.__3D_STATE__.morphProgress === 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "EnergyDissipated",
      "conditions": [
        "window.__3D_STATE__.totalEnergy < 0.01"
      ]
    }
  ],
