{
  "task_id": "P166_heat_conduction_visualization",
  "affordances": [
    {
      "id": "A1",
      "name": "MetalBar",
      "type": "3d_object",
      "semantic": "Array of 20 box segments representing the 1D metal bar",
      "locator_hints": [
        "BoxGeometry segments along X-axis"
      ]
    },
    {
      "id": "A2",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay displaying simulation status, alpha, temperatures, step count",
      "locator_hints": [
        "top-left monospace text overlay"
      ]
    },
    {
      "id": "A3",
      "name": "Title",
      "type": "dom_element",
      "semantic": "Title text at top of page",
      "locator_hints": [
        "h2 element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.segmentCount === 20",
        "window.__3D_STATE__.step === 0",
        "window.__3D_STATE__.avgTemp === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HeatSource_Activated",
      "conditions": [
        "window.__3D_STATE__.heatSourceOn === true",
        "window.__3D_STATE__.temperatures[0] === 100"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.step > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Heat_Propagating",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.temperatures[1] > 0",
        "window.__3D_STATE__.maxTemp >= 99"
      ]
    },
    {
      "id": "S4",
      "name": "Alpha_Changed",
      "conditions": [
        "window.__3D_STATE__.alpha !== 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "Cold_Sink_Toggled_Off",
      "conditions": [
        "window.__3D_STATE__.coldSinkOn === false"
      ]
    },
    {
      "id": "S6",
      "name": "Manual_Heat_Injected",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.maxTemp >= 80"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.step === 0",
        "window.__3D_STATE__.avgTemp === 0",
        "window.__3D_STATE__.heatSourceOn === false"
      ]
    }
  ],
