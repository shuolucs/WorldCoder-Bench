  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.atomCount === 0",
        "window.__3D_STATE__.bondCount === 0",
        "window.__3D_STATE__.netDipoleMagnitude === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Water_Loaded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 3",
        "window.__3D_STATE__.bondCount === 2",
        "window.__3D_STATE__.currentPreset === 'Water (H2O)'",
        "window.__3D_STATE__.polarityClass === 'Polar'"
      ]
    },
    {
      "id": "S2",
      "name": "CO2_Loaded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 3",
        "window.__3D_STATE__.bondCount === 2",
        "window.__3D_STATE__.currentPreset === 'Carbon Dioxide (CO2)'",
        "window.__3D_STATE__.polarityClass === 'Nonpolar'"
      ]
    },
    {
      "id": "S3",
      "name": "NH3_Loaded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 4",
        "window.__3D_STATE__.bondCount === 3",
        "window.__3D_STATE__.currentPreset === 'Ammonia (NH3)'"
      ]
    },
    {
      "id": "S4",
      "name": "HF_Loaded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 2",
        "window.__3D_STATE__.bondCount === 1",
        "window.__3D_STATE__.currentPreset === 'Hydrogen Fluoride (HF)'",
        "window.__3D_STATE__.polarityClass === 'Highly Polar'"
      ]
    },
    {
      "id": "S5",
      "name": "Cleared",
      "conditions": [
        "window.__3D_STATE__.atomCount === 0",
        "window.__3D_STATE__.bondCount === 0",
        "window.__3D_STATE__.netDipoleMagnitude === 0"
      ]
    },
    {
      "id": "S6",
      "name": "Dipoles_Hidden",
      "conditions": [
        "window.__3D_STATE__.dipolesVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Dipoles_Visible",
      "conditions": [
        "window.__3D_STATE__.dipolesVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "LabProp_Hidden",
      "conditions": [
        "window.__3D_STATE__.labPropVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "Custom_Atom_Added",
      "conditions": [
        "window.__3D_STATE__.atomCount >= 1",
        "window.__3D_STATE__.currentPreset === 'custom'"
      ]
    },
    {
      "id": "S10",
      "name": "Atom_Deleted",
      "conditions": [
        "window.__3D_STATE__.atomCount >= 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnWater"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.atoms !== 'undefined' && Array.isArray(window.__3D_STATE__.atoms)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.filter(a => a.element === 'O').length === 1 && window.__3D_STATE__.atoms.filter(a => a.element === 'H').length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude > 0.5 && window.__3D_STATE__.netDipoleMagnitude < 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polarityClass === 'Polar'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnCO2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.filter(a => a.element === 'C').length === 1 && window.__3D_STATE__.atoms.filter(a => a.element === 'O').length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polarityClass === 'Nonpolar'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.netDipole.x) < 0.01 && Math.abs(window.__3D_STATE__.netDipole.y) < 0.01 && Math.abs(window.__3D_STATE__.netDipole.z) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnNH3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.filter(a => a.element === 'N').length === 1 && window.__3D_STATE__.atoms.filter(a => a.element === 'H').length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds.every(b => Math.abs(b.dipoleMagnitude - 0.84) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude > 0.3 && !isNaN(window.__3D_STATE__.netDipoleMagnitude)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnHF"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds[0].dipoleMagnitude === 1.78 || Math.abs(window.__3D_STATE__.bonds[0].dipoleMagnitude - 1.78) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.netDipoleMagnitude - 1.78) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polarityClass === 'Highly Polar'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'Hydrogen Fluoride (HF)'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnClearAll"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipole.x === 0 && window.__3D_STATE__.netDipole.y === 0 && window.__3D_STATE__.netDipole.z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('elementSelect').value = 'O'; document.getElementById('elementSelect').dispatchEvent(new Event('change')); document.getElementById('btnAddAtom').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[0].element === 'O'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].electronegativity - 3.44) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPreset === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.atoms[0].x) && !isNaN(window.__3D_STATE__.atoms[0].y) && !isNaN(window.__3D_STATE__.atoms[0].z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Delete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.length === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S10",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btnWater').click(); await new Promise(r => setTimeout(r, 200)); document.getElementById('btnToggleDipoles').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dipolesVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude > 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dipolesVisible === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnToggleDipoles"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dipolesVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds.every(b => !isNaN(b.dipoleMagnitude) && b.dipoleMagnitude >= 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btnToggleProp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.labPropVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.labPropVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dipolesVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.netDipoleMagnitude > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}