  "states": [
    {
      "id": "S0",
      "name": "InitialReady",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.projectileStatus === 'ready'",
        "window.__3D_STATE__.launchAngle === 45",
        "window.__3D_STATE__.launchSpeed === 20"
      ]
    },
    {
      "id": "S1",
      "name": "AngleAdjusted",
      "conditions": [
        "window.__3D_STATE__.launchAngle !== 45",
        "window.__3D_STATE__.projectileStatus === 'ready'"
      ]
    },
    {
      "id": "S2",
      "name": "ProjectileInFlight",
      "conditions": [
        "window.__3D_STATE__.projectileStatus === 'in_flight'",
        "window.__3D_STATE__.projectilePosition.y > 0",
        "window.__3D_STATE__.timeInFlight > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ProjectileLanded",
      "conditions": [
        "window.__3D_STATE__.projectileStatus === 'landed'",
        "window.__3D_STATE__.landingPosition !== null",
        "window.__3D_STATE__.distanceToTarget !== null"
      ]
    },
    {
      "id": "S4",
      "name": "MediumDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'medium'",
        "window.__3D_STATE__.dragCoefficient === 0.3"
      ]
    },
    {
      "id": "S5",
      "name": "HardDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.dragCoefficient === 0.6"
      ]
    },
    {
      "id": "S6",
      "name": "HardFlightActive",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.projectileStatus === 'in_flight'"
      ]
    },
    {
      "id": "S7",
      "name": "HardLanded",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.projectileStatus === 'landed'"
      ]
    },
    {
      "id": "S8",
      "name": "ResetAfterLanding",
      "conditions": [
        "window.__3D_STATE__.projectileStatus === 'ready'",
        "window.__3D_STATE__.shotsFired >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "PowerAdjusted",
      "conditions": [
        "window.__3D_STATE__.launchSpeed !== 20",
        "window.__3D_STATE__.projectileStatus === 'ready'"
      ]
    }
  ],
