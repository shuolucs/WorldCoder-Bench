  "states": [
    {
      "id": "S0",
      "name": "InitialPlaying",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.animationTime >= 0",
        "window.__3D_STATE__.playbackSpeed === 1.0",
        "window.__3D_STATE__.overlayMode === false",
        "window.__3D_STATE__.focusTarget === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.animationTime > 0.5",
        "window.__3D_STATE__.mediumMSE >= 0",
        "window.__3D_STATE__.highMSE >= window.__3D_STATE__.mediumMSE"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.animationTime === 0",
        "window.__3D_STATE__.mediumCumulativeMSE === 0",
        "window.__3D_STATE__.highCumulativeMSE === 0"
      ]
    },
    {
      "id": "S5",
      "name": "FocusedOnHigh",
      "conditions": [
        "window.__3D_STATE__.focusTarget === 'high'"
      ]
    },
    {
      "id": "S6",
      "name": "OverlayActive",
      "conditions": [
        "window.__3D_STATE__.overlayMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "FrameStepped",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.animationTime > 0"
      ]
    },
    {
      "id": "S8",
      "name": "FocusedOnOriginal",
      "conditions": [
        "window.__3D_STATE__.focusTarget === 'original'"
      ]
    },
    {
      "id": "S9",
      "name": "HighSpeedRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.playbackSpeed >= 2.0"
      ]
    },
    {
      "id": "S10",
      "name": "PostResetPlaying",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    }
  ],
