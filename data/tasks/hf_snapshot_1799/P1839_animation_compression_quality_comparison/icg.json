      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mediumMSE >= 0 && !isNaN(window.__3D_STATE__.mediumMSE)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.highMSE >= 0 && !isNaN(window.__3D_STATE__.highMSE)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.highMSE >= window.__3D_STATE__.mediumMSE - 1e-9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount >= 4 && window.__3D_STATE__.jointCount <= 20",
            "tier": "L2"
          }
        ]
      }
    },
