  "states": [
    {
      "id": "S0",
      "name": "Idle",
      "conditions": [
        "window.__3D_STATE__.phase === 'idle'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.timeRemaining === 60"
      ]
    },
    {
      "id": "S1",
      "name": "GameStarted",
      "conditions": [
        "window.__3D_STATE__.phase === 'playing'",
        "window.__3D_STATE__.timeRemaining <= 60",
        "window.__3D_STATE__.difficultyTier === 1"
      ]
    },
    {
      "id": "S2",
      "name": "MolesSpawning",
      "conditions": [
        "window.__3D_STATE__.phase === 'playing'",
        "window.__3D_STATE__.totalMolesSpawned > 0",
        "window.__3D_STATE__.molesUp >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "FirstHit",
      "conditions": [
        "window.__3D_STATE__.hitCount >= 1",
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.lastHitIndex >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "ComboActive",
      "conditions": [
        "window.__3D_STATE__.combo >= 3",
        "window.__3D_STATE__.hitCount >= 3"
      ]
    },
    {
      "id": "S5",
      "name": "MissRecorded",
      "conditions": [
        "window.__3D_STATE__.missCount >= 1",
        "window.__3D_STATE__.combo === 0"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyTier2",
      "conditions": [
        "window.__3D_STATE__.difficultyTier === 2",
        "window.__3D_STATE__.timeRemaining <= 40"
      ]
    },
    {
      "id": "S7",
      "name": "DifficultyTier3",
      "conditions": [
        "window.__3D_STATE__.difficultyTier === 3",
        "window.__3D_STATE__.timeRemaining <= 20"
      ]
    },
    {
      "id": "S8",
      "name": "GameEnded",
      "conditions": [
        "window.__3D_STATE__.phase === 'ended'",
        "window.__3D_STATE__.timeRemaining === 0",
        "window.__3D_STATE__.gameOverShown === true"
      ]
    }
  ],
