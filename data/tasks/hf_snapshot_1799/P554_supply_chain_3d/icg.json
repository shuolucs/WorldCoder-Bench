{
  "task_id": "P554_supply_chain_3d",
  "affordances": [
    {"id": "A1", "name": "Factories", "type": "3d_object", "semantic": "3 factory nodes with GLB trucks", "locator_hints": ["GLTF CesiumMilkTruck models"]},
    {"id": "A2", "name": "Warehouses", "type": "3d_object", "semantic": "4 warehouse box nodes", "locator_hints": ["box meshes with WaterBottle"]},
    {"id": "A3", "name": "FlowTubes", "type": "3d_object", "semantic": "Tube connections between nodes", "locator_hints": ["tube geometry meshes"]},
    {"id": "A4", "name": "FlowParticles", "type": "3d_object", "semantic": "Glowing spheres traveling along tubes", "locator_hints": ["small emissive spheres"]},
    {"id": "A5", "name": "FlowSlider", "type": "dom_element", "semantic": "Selected flow rate control", "locator_hints": ["#slider-flow"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Loaded", "conditions": ["window.__3D_STATE__.modelsLoaded >= 1"]},
    {"id": "S2", "name": "Flowing", "conditions": ["window.__3D_STATE__.activeParticles > 0"]},
    {"id": "S3", "name": "FlowChanged", "conditions": ["window.__3D_STATE__.totalThroughput !== before.totalThroughput"]},
    {"id": "S4", "name": "Randomized", "conditions": ["window.__3D_STATE__.frameCount > 60"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded >= 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.totalThroughput > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.activeParticles >= 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalThroughput > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.flowRates.length > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "b"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bottleneckCount >= 0", "tier": "L1"},
        {"expr": "document.getElementById('hud-bottlenecks') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Paused')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-flow').value = 8; document.getElementById('slider-flow').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.nodesValid === true", "tier": "L0"}
      ]}
    }
  ]
}
