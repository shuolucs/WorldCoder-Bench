  "states": [
    {
      "id": "S0",
      "name": "Initial_AllOnShelf",
      "conditions": [
        "window.__3D_STATE__.objectsInWater === 0",
        "window.__3D_STATE__.waterLevel === 2.0",
        "window.__3D_STATE__.selectedObject === null",
        "window.__3D_STATE__.densityViewOn === false"
      ]
    },
    {
      "id": "S1",
      "name": "WoodCubeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedObject === 'wood_cube'",
        "window.__3D_STATE__.objectsInWater === 0"
      ]
    },
    {
      "id": "S2",
      "name": "WoodCubeDropped_Settling",
      "conditions": [
        "window.__3D_STATE__.woodCubeInWater === true",
        "window.__3D_STATE__.simRunning === true"
      ]
    },
    {
      "id": "S3",
      "name": "WoodCubeFloating",
      "conditions": [
        "window.__3D_STATE__.woodCubeInWater === true",
        "window.__3D_STATE__.objectsInWater === 1",
        "window.__3D_STATE__.simRunning === false"
      ]
    },
    {
      "id": "S4",
      "name": "SteelSphereSelected",
      "conditions": [
        "window.__3D_STATE__.selectedObject === 'steel_sphere'"
      ]
    },
    {
      "id": "S5",
      "name": "SteelSphereSunk",
      "conditions": [
        "window.__3D_STATE__.steelSphereInWater === true",
        "window.__3D_STATE__.objectsInWater === 2",
        "window.__3D_STATE__.simRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "RubberDuckFloating_AllInWater",
      "conditions": [
        "window.__3D_STATE__.rubberDuckInWater === true",
        "window.__3D_STATE__.objectsInWater === 3",
        "window.__3D_STATE__.simRunning === false"
      ]
    },
    {
      "id": "S7",
      "name": "DensityViewActive",
      "conditions": [
        "window.__3D_STATE__.densityViewOn === true"
      ]
    },
    {
      "id": "S8",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.objectsInWater === 0",
        "window.__3D_STATE__.waterLevel === 2.0",
        "window.__3D_STATE__.selectedObject === null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "WoodCube",
        "description": "Click on the wooden cube on the shelf to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedObject === 'wood_cube'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.woodCubeInWater === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.woodCubeY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d",
        "description": "Press D to drop the wooden cube into the tank, then wait for it to settle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.woodCubeInWater === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.woodCubeY > 1.0 && window.__3D_STATE__.woodCubeY < 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterLevel > 2.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.waterLevelRise)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "SteelSphere",
        "description": "Click on the steel sphere on the shelf to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedObject === 'steel_sphere'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.steelSphereInWater === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d",
        "description": "Press D to drop the steel sphere, wait for it to sink to the bottom"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.steelSphereInWater === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.steelSphereY < -1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.steelSphereY >= -2.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterLevel > 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Click rubber duck then press D */ const e1 = new MouseEvent('click', {clientX: window.innerWidth/2 - 250, clientY: window.innerHeight/2 + 50, bubbles: true}); document.querySelector('canvas').dispatchEvent(e1); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'd'})); }, 300);",
        "description": "Select rubber duck and drop it into the tank, wait for settling"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rubberDuckInWater === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rubberDuckY > 1.2 && window.__3D_STATE__.rubberDuckY < 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rubberDuckY > window.__3D_STATE__.woodCubeY",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterLevelRise > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
