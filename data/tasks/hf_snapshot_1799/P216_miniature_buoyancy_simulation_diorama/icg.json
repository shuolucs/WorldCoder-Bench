        "description": "Click the Toggle Density View button to show density labels"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.densityViewOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectsInWater === 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.waterLevel)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S7",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "click_dom",
