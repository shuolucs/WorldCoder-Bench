{
  "task_id": "P349_kitchen_cabinet_planner",
  "affordances": [
    {
      "id": "A1",
      "name": "BaseCabinetButton",
      "type": "dom_element",
      "semantic": "Button to select base cabinet type",
      "locator_hints": [
        "#btn-base"
      ]
    },
    {
      "id": "A2",
      "name": "TallCabinetButton",
      "type": "dom_element",
      "semantic": "Button to select tall cabinet type",
      "locator_hints": [
        "#btn-tall"
      ]
    },
    {
      "id": "A3",
      "name": "WallCabinetButton",
      "type": "dom_element",
      "semantic": "Button to select wall cabinet type",
      "locator_hints": [
        "#btn-wall"
      ]
    },
    {
      "id": "A4",
      "name": "PlaceButton",
      "type": "dom_element",
      "semantic": "Button to place cabinet at cursor",
      "locator_hints": [
        "#btn-place"
      ]
    },
    {
      "id": "A5",
      "name": "DeleteButton",
      "type": "dom_element",
      "semantic": "Button to delete selected cabinet",
      "locator_hints": [
        "#btn-delete"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all cabinets",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "ColorPicker",
      "type": "dom_element",
      "semantic": "Color picker to change cabinet color",
      "locator_hints": [
        "#color-picker"
      ]
    },
    {
      "id": "A8",
      "name": "CostDisplay",
      "type": "dom_element",
      "semantic": "Display showing total cost",
      "locator_hints": [
        "#cost-display"
      ]
    },
    {
      "id": "A9",
      "name": "CabinetCountDisplay",
      "type": "dom_element",
      "semantic": "Display showing cabinet count",
      "locator_hints": [
        "#cabinet-count"
      ]
    },
    {
      "id": "A10",
      "name": "PreviewBox",
      "type": "3d_object",
      "semantic": "Semi-transparent preview of cabinet placement",
      "locator_hints": [
        "preview",
        "ghost"
      ]
    },
    {
      "id": "A11",
      "name": "PlacedCabinets",
      "type": "3d_object",
      "semantic": "Placed cabinet meshes in the scene",
      "locator_hints": [
        "cabinet mesh"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.totalCost === 0",
        "window.__3D_STATE__.selectedType === 'base'"
      ]
    },
    {
      "id": "S1",
      "name": "FirstBasePlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 1",
        "window.__3D_STATE__.totalCost === 150"
      ]
    },
    {
      "id": "S2",
      "name": "TallTypeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'tall'"
      ]
    },
    {
      "id": "S3",
      "name": "TallCabinetPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 2",
        "window.__3D_STATE__.totalCost === 470"
      ]
    },
    {
      "id": "S4",
      "name": "CursorMoved",
      "conditions": [
        "window.__3D_STATE__.cursorX !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "WallCabinetPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 3",
        "window.__3D_STATE__.totalCost === 565"
      ]
    },
    {
      "id": "S6",
      "name": "CabinetSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCabinetId !== null"
      ]
    },
    {
      "id": "S7",
      "name": "CabinetDeleted",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 2",
        "window.__3D_STATE__.lastDeletedType !== null"
      ]
    },
    {
      "id": "S8",
      "name": "OverlapRejected",
      "conditions": [
        "window.__3D_STATE__.overlapRejected === true"
      ]
    },
    {
      "id": "S9",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.totalCost === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-place"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-tall"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-place"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-wall').click(); setTimeout(() => { for(let i=0;i<6;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight'}));} setTimeout(() => document.getElementById('btn-place').click(), 100); }, 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var c = window.__3D_STATE__.cabinets[0]; if(c && c.id) { window.__3D_STATE__.selectedCabinetId = c.id; /* simulate click selection */ var evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(evt); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-delete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-base').click(); setTimeout(() => { var existing = window.__3D_STATE__.cabinets[0]; if(existing) { var steps = Math.round(existing.x / 0.3); if(steps > 0) { for(let i=0;i<steps;i++) document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight'})); } else if(steps < 0) { for(let i=0;i<Math.abs(steps);i++) document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowLeft'})); } setTimeout(() => document.getElementById('btn-place').click(), 100); } }, 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('cost-display').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}