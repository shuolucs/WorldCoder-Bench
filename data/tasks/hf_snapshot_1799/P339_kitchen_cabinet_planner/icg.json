  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 5",
        "window.__3D_STATE__.selectedCabinet === null",
        "window.__3D_STATE__.totalBaseUnits === 3",
        "window.__3D_STATE__.totalWallUnits === 2",
        "window.__3D_STATE__.helmetVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "CabinetSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCabinet !== null",
        "typeof window.__3D_STATE__.selectedCabinet === 'string'"
      ]
    },
    {
      "id": "S2",
      "name": "DoorOpened",
      "conditions": [
        "window.__3D_STATE__.doorStates[window.__3D_STATE__.selectedCabinet] === 'open'"
      ]
    },
    {
      "id": "S3",
      "name": "CabinetMoved",
      "conditions": [
        "window.__3D_STATE__.cabinetPositions['baseCabinet1'] !== undefined",
        "!isNaN(window.__3D_STATE__.cabinetPositions['baseCabinet1'].x)"
      ]
    },
    {
      "id": "S4",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.cabinetColors[window.__3D_STATE__.selectedCabinet] !== '#8B6914' && window.__3D_STATE__.cabinetColors[window.__3D_STATE__.selectedCabinet] !== '#8b6914'"
      ]
    },
    {
      "id": "S5",
      "name": "CabinetResized",
      "conditions": [
        "window.__3D_STATE__.cabinetWidths[window.__3D_STATE__.selectedCabinet] !== 2"
      ]
    },
    {
      "id": "S6",
      "name": "HelmetHidden",
      "conditions": [
        "window.__3D_STATE__.helmetVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "CabinetAdded",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 6",
        "window.__3D_STATE__.totalBaseUnits === 4"
      ]
    },
    {
      "id": "S8",
      "name": "CabinetDeleted",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 5",
        "window.__3D_STATE__.selectedCabinet === null"
      ]
    },
    {
      "id": "S9",
      "name": "CabinetRotated",
      "conditions": [
        "window.__3D_STATE__.lastAction !== null && window.__3D_STATE__.lastAction.includes('rotate')"
      ]
    }
  ],
