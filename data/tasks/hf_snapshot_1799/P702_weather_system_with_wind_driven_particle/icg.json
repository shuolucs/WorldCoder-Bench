  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.weatherMode === 'rain'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.targetParticleCount === 500"
      ]
    },
    {
      "id": "S1",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.targetParticleCount === 750"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyMax",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.targetParticleCount === 2000"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S5",
      "name": "GustActive",
      "conditions": [
        "window.__3D_STATE__.isGustActive === true",
        "window.__3D_STATE__.gustMultiplier > 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "SnowMode",
      "conditions": [
        "window.__3D_STATE__.weatherMode === 'snow'"
      ]
    },
    {
      "id": "S7",
      "name": "HailMode",
      "conditions": [
        "window.__3D_STATE__.weatherMode === 'hail'"
      ]
    },
    {
      "id": "S8",
      "name": "WindDirectionChanged",
      "conditions": [
        "window.__3D_STATE__.windDirectionDegrees >= 0 && window.__3D_STATE__.windDirectionDegrees <= 360"
      ]
    },
    {
      "id": "S9",
      "name": "UndoDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === window.__3D_STATE__.previousDifficultyLevel"
      ]
    },
    {
      "id": "S10",
      "name": "TurbulenceToggled",
      "conditions": [
        "window.__3D_STATE__.turbulenceEnabled === true"
      ]
    },
    {
      "id": "S11",
      "name": "DifficultyDecremented",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && !isNaN(window.__3D_STATE__.particleCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.windSpeed === 'number' && !isNaN(window.__3D_STATE__.windSpeed)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.difficultyLevel === 'number' && window.__3D_STATE__.difficultyLevel === 1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.weatherMode === 'rain'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0 && !isNaN(window.__3D_STATE__.simulationTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-diff-up"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficultyLevel === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetParticleCount === 750",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousDifficultyLevel === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.difficultyHistory) && window.__3D_STATE__.difficultyHistory.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed <= 10",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficultyLevel === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetParticleCount === 2000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousDifficultyLevel === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbulenceEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windEnergy - 0.5 * window.__3D_STATE__.windSpeed * window.__3D_STATE__.windSpeed) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageParticleVelocityY)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageParticleVelocityX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const timeBefore = window.__3D_STATE__.simulationTime; window.__pausedTime = timeBefore; document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime >= window.__pausedTime",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficultyLevel === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isGustActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gustMultiplier >= 1.5 && window.__3D_STATE__.gustMultiplier <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastGustTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windEnergy - 0.5 * window.__3D_STATE__.windSpeed * window.__3D_STATE__.windSpeed) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weatherMode === 'snow'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficultyLevel === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.averageParticleVelocityY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticlesSpawned >= window.__3D_STATE__.particleCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.weatherMode === 'hail'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageParticleVelocityY < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.windDirection)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection >= 0 && window.__3D_STATE__.windDirection <= 2 * Math.PI",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('wind-direction-slider'); if(slider) { slider.value = 180; slider.dispatchEvent(new Event('input')); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windDirectionDegrees - 180) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windDirection - Math.PI) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weatherMode === 'hail'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windEnergy - 0.5 * window.__3D_STATE__.windSpeed * window.__3D_STATE__.windSpeed) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageParticleVelocityX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficultyLevel === window.__3D_STATE__.previousDifficultyLevel || window.__3D_STATE__.difficultyLevel < 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.difficultyHistory)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.targetParticleCount < 2000",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windDirectionDegrees >= 0 && window.__3D_STATE__.windDirectionDegrees <= 360",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.turbulenceEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fps) && window.__3D_STATE__.fps > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticlesSpawned >= window.__3D_STATE__.particlesRecycled",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-diff-down"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficultyLevel < window.__3D_STATE__.difficultyHistory[window.__3D_STATE__.difficultyHistory.length - 1] || window.__3D_STATE__.difficultyLevel >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetParticleCount <= 2000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windEnergy - 0.5 * window.__3D_STATE__.windSpeed * window.__3D_STATE__.windSpeed) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.weatherMode === 'hail'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.frameCount) && window.__3D_STATE__.frameCount > 100",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}