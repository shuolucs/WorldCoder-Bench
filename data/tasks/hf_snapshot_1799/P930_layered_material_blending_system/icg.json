      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const rows = document.querySelectorAll('.layer-row'); if(rows[2]) rows[2].click(); setTimeout(()=>{ document.dispatchEvent(new KeyboardEvent('keydown',{key:'n',bubbles:true})); },200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLayerIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[2].blendMode === 'multiply'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.finalColor === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.finalColor.r !== undefined && window.__3D_STATE__.finalColor.g !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
