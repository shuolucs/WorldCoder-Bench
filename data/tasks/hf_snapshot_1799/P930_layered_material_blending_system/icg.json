{
  "task_id": "P930_layered_material_blending_system",
  "affordances": [
    {
      "id": "A1",
      "name": "MainSphere",
      "type": "3d_object",
      "semantic": "Central sphere displaying blended layered material",
      "locator_hints": [
        "sphere at origin",
        "radius 1.2"
      ]
    },
    {
      "id": "A2",
      "name": "MaterialPanel",
