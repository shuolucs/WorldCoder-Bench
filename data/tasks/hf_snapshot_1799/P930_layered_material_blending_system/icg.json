        ".btn-remove"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialSingleLayer",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.layers[0].type === 'diffuse'",
        "window.__3D_STATE__.weightSum === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "TwoLayers",
      "conditions": [
        "window.__3D_STATE__.layerCount === 2",
        "window.__3D_STATE__.layers[1].type === 'metallic'"
      ]
    },
    {
      "id": "S2",
      "name": "TwoLayersWeightAdjusted",
      "conditions": [
        "window.__3D_STATE__.layerCount === 2",
        "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001"
      ]
    },
    {
      "id": "S3",
      "name": "LayerDisabledViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.layers[1].enabled === false",
        "window.__3D_STATE__.enabledCount === 1"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneToTwoEnabled",
      "conditions": [
        "window.__3D_STATE__.layers[1].enabled === true",
        "window.__3D_STATE__.enabledCount === 2",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "ThreeLayers",
      "conditions": [
        "window.__3D_STATE__.layerCount === 3"
      ]
    },
    {
      "id": "S6",
      "name": "BlendModeCycled",
      "conditions": [
        "window.__3D_STATE__.selectedLayerIndex >= 0"
      ]
    },
    {
      "id": "S7",
      "name": "LayerReordered",
      "conditions": [
        "window.__3D_STATE__.layerCount === 3"
      ]
    },
    {
      "id": "S8",
      "name": "FourLayers",
      "conditions": [
        "window.__3D_STATE__.layerCount === 4"
      ]
    },
    {
      "id": "S9",
      "name": "LayerRemoved",
      "conditions": [
        "window.__3D_STATE__.layerCount === 3"
      ]
    },
    {
      "id": "S10",
      "name": "RedoneAfterUndo",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "ResetToDefault",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.layers[0].type === 'diffuse'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-layer"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[1].type === 'metallic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[1].color === 0xffaa33 || window.__3D_STATE__.layers[1].color === '#ffaa33'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.layers[1].weight - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.finalColor.r) && !isNaN(window.__3D_STATE__.finalColor.g) && !isNaN(window.__3D_STATE__.finalColor.b)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelectorAll('.weight-slider')[1]; if(slider){const nativeSet=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; nativeSet.call(slider,'80'); slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedWeights.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedWeights[1] > window.__3D_STATE__.normalizedWeights[0]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalMetalness > 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalRoughness >= 0.0 && window.__3D_STATE__.finalRoughness <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[1].enabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.enabledCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.normalizedWeights[0] - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.normalizedWeights[1] === 0 || window.__3D_STATE__.normalizedWeights[1] === undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[1].enabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.enabledCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalMetalness > 0.0",
            "tier": "L2"
          }
        ]
      }
    },
