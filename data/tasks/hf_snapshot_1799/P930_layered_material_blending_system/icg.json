        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "document.querySelectorAll('.layer-row').length === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.finalRoughness) && !isNaN(window.__3D_STATE__.finalMetalness)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'u',bubbles:true})); setTimeout(()=>{ document.dispatchEvent(new KeyboardEvent('keydown',{key:'r',bubbles:true})); },300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.weightSum - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blendHistory) && window.__3D_STATE__.blendHistory.length >= 1",
