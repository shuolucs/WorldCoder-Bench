      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Load",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.gameState === 'aiming'",
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Aiming_Rotated",
      "conditions": [
        "window.__3D_STATE__.gameState === 'aiming'",
        "window.__3D_STATE__.aimAngle !== 0",
        "window.__3D_STATE__.ballStopped === true"
      ]
    },
    {
      "id": "S2",
      "name": "Charging_Power",
      "conditions": [
        "window.__3D_STATE__.isCharging === true",
        "window.__3D_STATE__.power > 0",
        "window.__3D_STATE__.gameState === 'charging'"
      ]
    },
    {
      "id": "S3",
      "name": "Ball_Rolling",
      "conditions": [
        "window.__3D_STATE__.gameState === 'rolling'",
        "window.__3D_STATE__.ballSpeed > 0.005",
        "window.__3D_STATE__.isCharging === false"
      ]
    },
    {
      "id": "S4",
      "name": "Ball_Stopped_After_Shot",
      "conditions": [
        "window.__3D_STATE__.ballStopped === true",
        "window.__3D_STATE__.strokeCount >= 1",
        "window.__3D_STATE__.gameState === 'aiming'"
      ]
    },
    {
      "id": "S5",
      "name": "Ball_Sunk",
      "conditions": [
        "window.__3D_STATE__.ballSunk === true",
        "window.__3D_STATE__.score >= 1",
        "window.__3D_STATE__.gameState === 'sunk'"
      ]
    },
    {
      "id": "S6",
      "name": "Ball_Reset_To_Tee",
      "conditions": [
        "window.__3D_STATE__.ballPosition.z > 7.5",
        "window.__3D_STATE__.ballStopped === true",
        "window.__3D_STATE__.gameState === 'aiming'"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Fully_Reset",
      "conditions": [
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.ballSunk === false",
        "window.__3D_STATE__.gameState === 'aiming'"
      ]
    },
    {
      "id": "S8",
      "name": "Wall_Bounce_Occurred",
      "conditions": [
        "window.__3D_STATE__.wallBounceCount >= 1",
        "window.__3D_STATE__.gameState === 'rolling'"
      ]
    },
    {
      "id": "S9",
      "name": "Half_Power_Charged",
      "conditions": [
        "window.__3D_STATE__.power >= 0.4",
        "window.__3D_STATE__.power <= 0.6",
        "window.__3D_STATE__.isCharging === true"
      ]
    }
  ],
