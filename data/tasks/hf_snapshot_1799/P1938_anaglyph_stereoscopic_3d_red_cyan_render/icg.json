{
  "task_id": "P1938_anaglyph_stereoscopic_3d_red_cyan_render",
  "affordances": [
    {
      "id": "A1",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Displays stereo parameters and rendering mode",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A2",
      "name": "SubtleButton",
      "type": "dom_element",
      "semantic": "Sets subtle depth preset",
      "locator_hints": [
        "#btn-subtle"
      ]
    },
    {
      "id": "A3",
      "name": "NormalButton",
      "type": "dom_element",
      "semantic": "Sets normal depth preset",
      "locator_hints": [
        "#btn-normal"
      ]
    },
    {
      "id": "A4",
      "name": "ExtremeButton",
      "type": "dom_element",
      "semantic": "Sets extreme depth preset",
      "locator_hints": [
        "#btn-extreme"
      ]
    },
    {
      "id": "A5",
      "name": "TorusKnot",
      "type": "3d_object",
      "semantic": "Red torus knot that bobs vertically",
      "locator_hints": [
        "torusKnot",
        "objectRotations[0]"
      ]
    },
    {
      "id": "A6",
      "name": "SceneObjects",
      "type": "3d_object",
      "semantic": "All 5 rotating geometric objects",
      "locator_hints": [
        "objectCount",
        "objectRotations"
      ]
    },
    {
      "id": "A7",
      "name": "ConvergencePlane",
      "type": "3d_object",
      "semantic": "Semi-transparent plane at focal distance",
      "locator_hints": [
        "convergencePlaneVisible"
      ]
    },
    {
      "id": "A8",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "Orbiting perspective camera",
      "locator_hints": [
        "cameraAngleDeg",
        "cameraPosition"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialAnaglyphState",
      "conditions": [
        "window.__3D_STATE__.anaglyphEnabled === true",
        "window.__3D_STATE__.eyeSeparation === 0.064",
        "window.__3D_STATE__.focalLength === 15",
        "window.__3D_STATE__.rotationSpeed === 0.01",
        "window.__3D_STATE__.cameraAngleDeg === 0",
        "window.__3D_STATE__.activePreset === 'normal'"
      ]
    },
    {
      "id": "S1",
      "name": "IncreasedEyeSeparation",
      "conditions": [
        "window.__3D_STATE__.eyeSeparation > 0.064",
        "window.__3D_STATE__.activePreset === 'custom'"
      ]
    },
    {
      "id": "S2",
      "name": "MonoRenderingMode",
      "conditions": [
        "window.__3D_STATE__.anaglyphEnabled === false",
        "window.__3D_STATE__.effectType === 'mono'"
      ]
    },
    {
      "id": "S3",
      "name": "ExtremePresetActive",
      "conditions": [
        "window.__3D_STATE__.eyeSeparation === 0.150",
        "window.__3D_STATE__.focalLength === 8",
        "window.__3D_STATE__.activePreset === 'extreme'"
      ]
    },
    {
      "id": "S4",
      "name": "CameraOrbited",
      "conditions": [
        "window.__3D_STATE__.cameraAngleDeg !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "ConvergencePlaneShown",
      "conditions": [
        "window.__3D_STATE__.convergencePlaneVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "RotationSpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed > 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "SubtlePresetActive",
      "conditions": [
        "window.__3D_STATE__.eyeSeparation === 0.032",
        "window.__3D_STATE__.focalLength === 20",
        "window.__3D_STATE__.activePreset === 'subtle'"
      ]
    },
    {
      "id": "S8",
      "name": "FocalLengthDecreased",
      "conditions": [
        "window.__3D_STATE__.focalLength < 15"
      ]
    },
    {
      "id": "S9",
      "name": "NormalPresetRestored",
      "conditions": [
        "window.__3D_STATE__.eyeSeparation === 0.064",
        "window.__3D_STATE__.focalLength === 15",
        "window.__3D_STATE__.activePreset === 'normal'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 6",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectRotations) && window.__3D_STATE__.objectRotations.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.anaglyphEnabled === true && window.__3D_STATE__.effectType === 'anaglyph'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rendererSize === 'object' && window.__3D_STATE__.rendererSize.width > 0 && window.__3D_STATE__.rendererSize.height > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "]"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.eyeSeparation - 0.072) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eyeSeparation > 0.064",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eyeSeparation <= 0.200",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.eyeSeparation)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.anaglyphEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.effectType === 'mono'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object' && !isNaN(window.__3D_STATE__.cameraPosition.x)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-panel') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-extreme"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.eyeSeparation - 0.150) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'extreme'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eyeSeparation >= 0.008 && window.__3D_STATE__.eyeSeparation <= 0.200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength >= 5 && window.__3D_STATE__.focalLength <= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraAngleDeg - (-15)) < 1 || Math.abs(window.__3D_STATE__.cameraAngleDeg - 345) < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraAngleDeg !== 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraPosition.x) && !isNaN(window.__3D_STATE__.cameraPosition.y) && !isNaN(window.__3D_STATE__.cameraPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.cameraPosition.x**2 + window.__3D_STATE__.cameraPosition.z**2) - 8) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.convergencePlaneVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.focalLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.focalLength === 8",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.torusKnotY)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torusKnotY - 1.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rotationSpeed - 0.015) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationSpeed <= 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectRotations.every(r => typeof r === 'number' && !isNaN(r))",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rotationSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-subtle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.eyeSeparation - 0.032) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'subtle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eyeSeparation < 0.064",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-subtle') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "-"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.focalLength === 19",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.focalLength)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-normal"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.eyeSeparation - 0.064) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focalLength === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'normal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anaglyphEnabled === false || window.__3D_STATE__.anaglyphEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectRotations.every(r => typeof r === 'number' && !isNaN(r))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}