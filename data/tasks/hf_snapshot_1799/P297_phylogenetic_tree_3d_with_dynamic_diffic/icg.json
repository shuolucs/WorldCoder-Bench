{
  "task_id": "P297_phylogenetic_tree_3d_with_dynamic_diffic",
  "affordances": [
    {
      "id": "A1",
      "name": "TreeNodes",
      "type": "3d_object",
      "semantic": "Spherical nodes representing species or ancestors in the phylogenetic tree",
      "locator_hints": [
        "sphere meshes in the scene",
        "objects with userData.nodeType"
      ]
    },
    {
      "id": "A2",
      "name": "TreeBranches",
      "type": "3d_object",
      "semantic": "Cylinder connections between parent and child nodes",
      "locator_hints": [
        "cylinder geometries connecting nodes"
      ]
    },
    {
      "id": "A3",
      "name": "NodeLabels",
      "type": "3d_object",
      "semantic": "Sprite-based text labels on each node",
      "locator_hints": [
        "sprite objects near nodes"
      ]
    },
    {
      "id": "A4",
      "name": "EasyButton",
      "type": "dom_element",
      "semantic": "Button to switch to Easy difficulty (Level 1)",
      "locator_hints": [
        "button with text 'Easy'",
        "green-bordered button"
      ]
    },
    {
      "id": "A5",
      "name": "MediumButton",
      "type": "dom_element",
      "semantic": "Button to switch to Medium difficulty (Level 2)",
      "locator_hints": [
        "button with text 'Medium'",
        "orange-bordered button"
      ]
    },
    {
      "id": "A6",
      "name": "HardButton",
      "type": "dom_element",
      "semantic": "Button to switch to Hard difficulty (Level 3)",
      "locator_hints": [
        "button with text 'Hard'",
        "red-bordered button"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing difficulty, node count, selected node",
      "locator_hints": [
        "top-left overlay text"
      ]
    },
    {
      "id": "A8",
      "name": "Tooltip",
      "type": "dom_element",
      "semantic": "Hover tooltip showing node details",
      "locator_hints": [
        "floating div near cursor on hover"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEasyTree",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.treeDepth === 3",
        "window.__3D_STATE__.totalNodes >= 5 && window.__3D_STATE__.totalNodes <= 15",
        "window.__3D_STATE__.labelsVisible === true",
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.selectedNodeName === null"
      ]
    },
    {
      "id": "S1",
      "name": "MediumDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.treeDepth === 4",
        "window.__3D_STATE__.totalNodes >= 12 && window.__3D_STATE__.totalNodes <= 40"
      ]
    },
    {
      "id": "S2",
      "name": "HardDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.treeDepth === 5",
        "window.__3D_STATE__.totalNodes >= 25 && window.__3D_STATE__.totalNodes <= 80"
      ]
    },
    {
      "id": "S3",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeName !== null",
        "typeof window.__3D_STATE__.selectedNodeName === 'string'"
      ]
    },
    {
      "id": "S4",
      "name": "LabelsHidden",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S6",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 0) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 5) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 20) < 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
