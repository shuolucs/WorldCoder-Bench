  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.elementsLoaded === true",
        "window.__3D_STATE__.elementCount === 36",
        "window.__3D_STATE__.viewMode === 'flat'",
        "window.__3D_STATE__.activeFilter === 'all'",
        "window.__3D_STATE__.selectedElement === null"
      ]
    },
    {
      "id": "S1",
      "name": "Element_Hovered",
      "conditions": [
        "window.__3D_STATE__.hoveredElement !== null"
      ]
    },
    {
      "id": "S2",
      "name": "Element_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedElement !== null",
        "window.__3D_STATE__.selectedElementZ > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Category_Filtered",
      "conditions": [
        "window.__3D_STATE__.activeFilter !== 'all'",
        "window.__3D_STATE__.filterVisibleCount < 36"
      ]
    },
    {
      "id": "S4",
      "name": "Filter_Reset",
      "conditions": [
        "window.__3D_STATE__.activeFilter === 'all'",
        "window.__3D_STATE__.filterVisibleCount === 36"
      ]
    },
    {
      "id": "S5",
      "name": "Spiral_View",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'spiral'",
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S6",
      "name": "Flat_View_Restored",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'flat'",
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S7",
      "name": "Camera_Reset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 5) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 25) < 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "Arrow_Key_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedElement !== null"
      ]
    }
  ],
