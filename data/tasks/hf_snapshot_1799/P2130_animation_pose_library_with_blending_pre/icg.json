{
  "task_id": "P2130_animation_pose_library_with_blending_pre",
  "affordances": [
    {
      "id": "A1",
      "name": "StorkModel",
      "type": "3d_object",
      "semantic": "The loaded stork GLB model at the origin",
      "locator_hints": [
        "scene.children with type SkinnedMesh or Group",
        "model at position (0,0,0)"
      ]
    },
    {
      "id": "A2",
      "name": "CaptureButton",
      "type": "dom_element",
      "semantic": "Button to capture current pose to library",
      "locator_hints": [
        "#btn-capture"
      ]
    },
    {
      "id": "A3",
      "name": "ClearAllButton",
      "type": "dom_element",
      "semantic": "Button to clear all saved poses",
      "locator_hints": [
        "#btn-clear"
      ]
    },
    {
      "id": "A4",
      "name": "BlendSlider",
      "type": "dom_element",
      "semantic": "Slider controlling blend weight between Pose A and Pose B",
      "locator_hints": [
        "#slider-blend"
      ]
    },
    {
      "id": "A5",
      "name": "PlayPreviewButton",
      "type": "dom_element",
      "semantic": "Button to auto-animate blend from 0 to 1",
      "locator_hints": [
        "#btn-play-preview"
      ]
    },
    {
      "id": "A6",
      "name": "ResetBlendButton",
      "type": "dom_element",
      "semantic": "Button to reset blend weight to 0",
      "locator_hints": [
        "#btn-reset-blend"
      ]
    },
    {
      "id": "A7",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle animation playback",
      "locator_hints": [
        "#btn-playpause"
      ]
    },
    {
      "id": "A8",
      "name": "TimelineScrubber",
      "type": "dom_element",
      "semantic": "Slider to scrub through animation timeline",
      "locator_hints": [
        "#slider-timeline"
      ]
    },
    {
      "id": "A9",
      "name": "BlendWeightLabel",
      "type": "dom_element",
      "semantic": "Numeric display of current blend weight",
      "locator_hints": [
        "#label-blend-weight"
      ]
    },
    {
      "id": "A10",
      "name": "PoseLibraryPanel",
      "type": "dom_element",
      "semantic": "Panel listing all saved poses with selection buttons",
      "locator_hints": [
        "div containing pose list",
        "top-left panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_NoPoses",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.poseCount === 0",
        "window.__3D_STATE__.blendWeight === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationScrubbed",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentTime > 0",
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "FirstPoseCaptured",
      "conditions": [
        "window.__3D_STATE__.poseCount === 1",
        "window.__3D_STATE__.poses.length === 1"
      ]
    },
    {
      "id": "S3",
      "name": "SecondPoseCaptured",
      "conditions": [
        "window.__3D_STATE__.poseCount === 2",
        "window.__3D_STATE__.poses.length === 2"
      ]
    },
    {
      "id": "S4",
      "name": "BothPosesSelected",
      "conditions": [
        "window.__3D_STATE__.poseA !== null",
        "window.__3D_STATE__.poseB !== null"
      ]
    },
    {
      "id": "S5",
      "name": "BlendWeightAdjusted",
      "conditions": [
        "window.__3D_STATE__.blendWeight > 0",
        "window.__3D_STATE__.blendWeight <= 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "BlendPreviewPlaying",
      "conditions": [
        "window.__3D_STATE__.isBlendPreviewPlaying === true"
      ]
    },
    {
      "id": "S7",
      "name": "BlendPreviewComplete",
      "conditions": [
        "window.__3D_STATE__.isBlendPreviewPlaying === false",
        "window.__3D_STATE__.blendWeight >= 0.99"
      ]
    },
    {
      "id": "S8",
      "name": "BlendReset",
      "conditions": [
        "window.__3D_STATE__.blendWeight === 0",
        "window.__3D_STATE__.isBlendPreviewPlaying === false"
      ]
    },
    {
      "id": "S9",
      "name": "AllPosesCleared",
      "conditions": [
        "window.__3D_STATE__.poseCount === 0",
        "window.__3D_STATE__.poseA === null",
        "window.__3D_STATE__.poseB === null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.clipCount === 'number' && window.__3D_STATE__.clipCount >= 1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.clipDuration === 'number' && window.__3D_STATE__.clipDuration > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poseCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let sl = document.getElementById('slider-timeline'); if(sl) { sl.value = sl.max * 0.4; sl.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number' && window.__3D_STATE__.currentTime > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime <= window.__3D_STATE__.clipDuration",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'scrub'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - window.__3D_STATE__.clipDuration * 0.4) < window.__3D_STATE__.clipDuration * 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelPosition.x === 0 && window.__3D_STATE__.modelPosition.z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-capture"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.poseCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.poses) && window.__3D_STATE__.poses.length === 1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.poses[0].id === 'string'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.poses[0].time === 'number' && window.__3D_STATE__.poses[0].time > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'capture_pose'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let sl = document.getElementById('slider-timeline'); if(sl) { sl.value = sl.max * 0.85; sl.dispatchEvent(new Event('input', {bubbles:true})); } setTimeout(() => { let btn = document.getElementById('btn-capture'); if(btn) btn.click(); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.poseCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poses.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poses[0].time !== window.__3D_STATE__.poses[1].time",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.poses[1].id === 'string' && window.__3D_STATE__.poses[1].id !== window.__3D_STATE__.poses[0].id",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poses[1].time > window.__3D_STATE__.poses[0].time",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '1', code: 'Digit1', bubbles: true})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: '2', code: 'Digit2', shiftKey: true, bubbles: true})); }, 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.poseA !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poseB !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poseA !== window.__3D_STATE__.poseB",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseA === window.__3D_STATE__.poses[0].id",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseB === window.__3D_STATE__.poses[1].id",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let sl = document.getElementById('slider-blend'); if(sl) { sl.value = '0.50'; sl.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendWeight - 0.5) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight >= 0 && window.__3D_STATE__.blendWeight <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'blend_changed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseA !== null && window.__3D_STATE__.poseB !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('label-blend-weight') !== null && document.getElementById('label-blend-weight').textContent.includes('0.50')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-play-preview"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isBlendPreviewPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.blendPreviewProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blendPreviewProgress >= 0 && window.__3D_STATE__.blendPreviewProgress <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'play_preview'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelPosition.x === 0 && window.__3D_STATE__.modelPosition.z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isBlendPreviewPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight >= 0.99",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendPreviewProgress >= 0.99",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.blendWeight)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset-blend"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blendWeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlendPreviewPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset_blend'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('label-blend-weight') !== null && (document.getElementById('label-blend-weight').textContent.includes('0.00') || document.getElementById('label-blend-weight').textContent.includes('0'))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseA !== null && window.__3D_STATE__.poseB !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-clear"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.poseCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.poses) && window.__3D_STATE__.poses.length === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poseA === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poseB === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'clear_all'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}