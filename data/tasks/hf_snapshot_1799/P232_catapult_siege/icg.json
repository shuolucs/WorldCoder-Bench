{
  "task_id": "P232_catapult_siege",
  "affordances": [
    {
      "id": "A1",
      "name": "Catapult",
      "type": "3d_object",
      "semantic": "The catapult assembly at x=-10 that launches projectiles",
      "locator_hints": [
        "position.x === -10"
      ]
    },
    {
      "id": "A2",
      "name": "Projectile",
      "type": "3d_object",
      "semantic": "BoxAnimated.glb model used as the projectile",
      "locator_hints": [
        "BoxAnimated.glb loaded mesh",
        "scaled to 0.5"
      ]
    },
    {
      "id": "A3",
      "name": "CastleWall",
      "type": "3d_object",
      "semantic": "Grid of 12 destructible gray blocks at x=10",
      "locator_hints": [
        "position.x near 10",
        "gray boxes"
      ]
    },
    {
      "id": "A4",
      "name": "PowerSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling launch power",
      "locator_hints": [
        "#powerSlider"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the game",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing score, ammo, angle, blocks",
      "locator_hints": [
        "#hud",
        "#scoreDisplay",
        "#ammoDisplay"
      ]
    },
    {
      "id": "A7",
      "name": "GameOverMsg",
      "type": "dom_element",
      "semantic": "Game over message shown when ammo depleted",
      "locator_hints": [
        "#gameOverMsg"
      ]
    },
    {
      "id": "A8",
      "name": "VictoryMsg",
      "type": "dom_element",
      "semantic": "Victory message shown when all blocks destroyed",
      "locator_hints": [
        "#victoryMsg"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.ammo === 5",
        "window.__3D_STATE__.angle === 45",
        "window.__3D_STATE__.blocksRemaining === 12",
        "window.__3D_STATE__.launchCount === 0",
        "window.__3D_STATE__.projectileActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "AngleAdjusted",
      "conditions": [
        "window.__3D_STATE__.angle !== 45",
        "window.__3D_STATE__.projectileActive === false"
      ]
    },
    {
      "id": "S2",
      "name": "PowerAdjusted",
      "conditions": [
        "window.__3D_STATE__.power !== 15",
        "window.__3D_STATE__.projectileActive === false"
      ]
    },
    {
      "id": "S3",
      "name": "ProjectileInFlight",
      "conditions": [
        "window.__3D_STATE__.projectileActive === true",
        "window.__3D_STATE__.launchCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "ProjectileLanded",
      "conditions": [
        "window.__3D_STATE__.projectileActive === false",
        "window.__3D_STATE__.launchCount >= 1",
        "window.__3D_STATE__.ammo < 5"
      ]
    },
    {
      "id": "S5",
      "name": "BlocksDestroyed",
      "conditions": [
        "window.__3D_STATE__.blocksRemaining < 12",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S6",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.ammo === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Victory",
      "conditions": [
        "window.__3D_STATE__.victory === true",
        "window.__3D_STATE__.blocksRemaining === 0"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.ammo === 5",
        "window.__3D_STATE__.blocksRemaining === 12",
        "window.__3D_STATE__.launchCount === 0"
      ]
    }
  ],
