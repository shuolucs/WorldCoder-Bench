      ]
    },
    {
      "id": "S2",
      "name": "Afternoon_Set",
      "conditions": [
        "window.__3D_STATE__.currentHour === 15.0",
        "window.__3D_STATE__.sunAzimuthDeg > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Animating",
      "conditions": [
        "window.__3D_STATE__.isAnimating === true"
      ]
    },
    {
      "id": "S4",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.currentHour === 6.0",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S5",
      "name": "Building_Selected",
      "conditions": [
