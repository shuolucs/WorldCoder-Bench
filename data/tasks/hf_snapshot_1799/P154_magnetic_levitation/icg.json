      ]
    },
    {
      "id": "S4",
      "name": "MagnetDecreased",
      "conditions": [
        "window.__3D_STATE__.magnetStrength < 40"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "ZeroGravity",
      "conditions": [
