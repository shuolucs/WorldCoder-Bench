      "conditions": [
        "window.__3D_STATE__.turnNumber === 2",
        "window.__3D_STATE__.activePlayer === 2"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo_BackToS0",
      "conditions": [
        "window.__3D_STATE__.turnNumber === 1",
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedo_BackToS2",
      "conditions": [
        "window.__3D_STATE__.turnNumber === 2",
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S5",
      "name": "P2ChargedLeft",
      "conditions": [
        "window.__3D_STATE__.turnNumber === 3",
        "window.__3D_STATE__.activePlayer === 1"
      ]
    },
    {
      "id": "S6",
      "name": "MultipleMovesPlayed",
      "conditions": [
        "window.__3D_STATE__.turnNumber >= 4",
        "window.__3D_STATE__.historySize >= 4"
      ]
    },
    {
      "id": "S7",
      "name": "MultiUndoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoSize >= 2"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.player1X === -2",
        "window.__3D_STATE__.player1Z === 0",
        "window.__3D_STATE__.player2X === 2",
        "window.__3D_STATE__.player2Z === 0",
        "window.__3D_STATE__.turnNumber === 1",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S9",
      "name": "PostResetCharge",
      "conditions": [
        "window.__3D_STATE__.turnNumber === 2",
        "window.__3D_STATE__.historySize >= 2"
      ]
    }
  ],
