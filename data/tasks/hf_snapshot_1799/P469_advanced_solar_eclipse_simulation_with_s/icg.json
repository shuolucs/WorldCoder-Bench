  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.moonAngle === 0",
        "window.__3D_STATE__.moonSpeed === 0.01",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.eclipseCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.moonAngle > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.moonSpeed > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.frameCount > 50"
      ]
    },
    {
      "id": "S5",
      "name": "FishHidden",
      "conditions": [
        "window.__3D_STATE__.fishVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "FishRestored",
      "conditions": [
        "window.__3D_STATE__.fishVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "TopDownCamera",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'topdown'"
      ]
    },
    {
      "id": "S8",
      "name": "PerspectiveCamera",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'perspective'"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.moonAngle === 0",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.moonSpeed === 0.01"
      ]
    }
  ],
