{
  "task_id": "P1266_mesh_decimation_viewer_with_quality_slid",
  "affordances": [
    {
      "id": "A1",
      "name": "DecimatedMesh",
      "type": "3d_object",
      "semantic": "The icosahedron mesh that gets decimated based on quality slider",
      "locator_hints": [
        "IcosahedronGeometry",
        "main mesh in scene"
      ]
    },
    {
      "id": "A2",
      "name": "QualitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling decimation quality from 0 to 100",
      "locator_hints": [
        "#qualitySlider"
      ]
    },
    {
      "id": "A3",
      "name": "QualityLabel",
      "type": "dom_element",
      "semantic": "Label showing current quality percentage",
      "locator_hints": [
        "#qualityLabel"
      ]
    },
    {
      "id": "A4",
      "name": "WireframeButton",
      "type": "dom_element",
      "semantic": "Toggle button for wireframe rendering",
      "locator_hints": [
        "#wireframeBtn"
      ]
    },
    {
      "id": "A5",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Undo last quality change",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A6",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Redo last undone quality change",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset quality to 100% and clear history",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A8",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing mesh statistics",
      "locator_hints": [
        "#statsPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialFullQuality",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 100",
        "window.__3D_STATE__.reductionRatio === 1",
        "window.__3D_STATE__.decimationApplied === false",
        "window.__3D_STATE__.wireframeEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "DecimatedTo50",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 50",
        "window.__3D_STATE__.decimationApplied === true",
        "window.__3D_STATE__.reductionRatio > 0.45 && window.__3D_STATE__.reductionRatio < 0.55"
      ]
    },
    {
      "id": "S2",
      "name": "DecimatedTo20",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 20",
        "window.__3D_STATE__.decimationApplied === true",
        "window.__3D_STATE__.reductionRatio > 0.15 && window.__3D_STATE__.reductionRatio < 0.25"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndoTo50",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 50",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedoTo20",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 20",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeOff",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "DecimatedTo10",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 10",
        "window.__3D_STATE__.decimationApplied === true"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 100",
        "window.__3D_STATE__.undoStackSize <= 1",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterKeyboardUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.originalFaceCount === 'number' && window.__3D_STATE__.originalFaceCount > 1000",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentFaceCount === 'number' && window.__3D_STATE__.currentFaceCount === window.__3D_STATE__.originalFaceCount",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentQuality === 100 && window.__3D_STATE__.reductionRatio === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRotating === true && window.__3D_STATE__.meshPositionY === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === false && window.__3D_STATE__.decimationApplied === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('qualitySlider'); const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSetter.call(slider, '50'); slider.dispatchEvent(new Event('input', {bubbles:true})); slider.dispatchEvent(new Event('change', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaceCount < window.__3D_STATE__.originalFaceCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaceCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.reductionRatio - (window.__3D_STATE__.currentFaceCount / window.__3D_STATE__.originalFaceCount)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.decimationApplied === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('qualitySlider'); const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSetter.call(slider, '20'); slider.dispatchEvent(new Event('input', {bubbles:true})); slider.dispatchEvent(new Event('change', {bubbles:true}));"
