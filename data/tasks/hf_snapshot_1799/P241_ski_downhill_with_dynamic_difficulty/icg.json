{
  "task_id": "P241_ski_downhill_with_dynamic_difficulty",
  "affordances": [
    {
      "id": "A1",
      "name": "Skier",
      "type": "3d_object",
      "semantic": "Player-controlled skier that moves left/right on the slope",
      "locator_hints": [
        "red capsule or cone shape",
        "skierExists === true"
      ]
    },
    {
      "id": "A2",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the game from waiting state",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A3",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle pause during gameplay",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A4",
      "name": "RestartButton",
      "type": "dom_element",
      "semantic": "Button to restart after game over",
      "locator_hints": [
        "#restartBtn"
      ]
    },
    {
      "id": "A5",
      "name": "Obstacles",
      "type": "3d_object",
      "semantic": "Trees and rocks that the skier must avoid",
      "locator_hints": [
        "green cones",
        "gray spheres"
      ]
    },
    {
      "id": "A6",
      "name": "AntiqueCamera",
      "type": "3d_object",
      "semantic": "Collectible camera bonus items loaded from AntiqueCamera.glb",
      "locator_hints": [
        "rotating glb model",
        "cameraModelLoaded === true"
      ]
    },
    {
      "id": "A7",
      "name": "ScoreHUD",
      "type": "dom_element",
      "semantic": "Score display at top-left",
      "locator_hints": [
        "Score:",
        "top-left text"
      ]
    },
    {
      "id": "A8",
      "name": "LivesHUD",
      "type": "dom_element",
      "semantic": "Lives display at top-right",
      "locator_hints": [
        "Lives:",
        "heart emojis"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "WaitingState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.difficultyLevel === 1"
      ]
    },
    {
      "id": "S1",
      "name": "PlayingState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.lives > 0",
        "window.__3D_STATE__.skierExists === true"
      ]
    },
    {
      "id": "S2",
      "name": "PausedState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'paused'"
      ]
    },
    {
      "id": "S3",
      "name": "PlayingWithHigherDifficulty",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.difficultyLevel >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "PlayingAfterMove",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.skierX !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "GameOverState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'",
        "window.__3D_STATE__.lives === 0"
      ]
    },
    {
      "id": "S6",
      "name": "RestartedState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting' || window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.score === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score !== before.score || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number' && !isNaN(window.__3D_STATE__.score)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lives === 'number' && !isNaN(window.__3D_STATE__.lives)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
