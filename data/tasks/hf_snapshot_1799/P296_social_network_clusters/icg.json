  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalNodes === 21",
        "window.__3D_STATE__.clusterAVisible === true",
        "window.__3D_STATE__.clusterBVisible === true",
        "window.__3D_STATE__.clusterCVisible === true",
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.visibleNodeCount === 21"
      ]
    },
    {
      "id": "S1",
      "name": "ClusterAHidden",
      "conditions": [
        "window.__3D_STATE__.clusterAVisible === false",
        "window.__3D_STATE__.clusterBVisible === true",
        "window.__3D_STATE__.clusterCVisible === true",
        "window.__3D_STATE__.visibleNodeCount === 13"
      ]
    },
    {
      "id": "S2",
      "name": "ClusterAAndBHidden",
      "conditions": [
        "window.__3D_STATE__.clusterAVisible === false",
        "window.__3D_STATE__.clusterBVisible === false",
        "window.__3D_STATE__.clusterCVisible === true",
        "window.__3D_STATE__.visibleNodeCount === 7"
      ]
    },
    {
      "id": "S3",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.clusterAVisible === true",
        "window.__3D_STATE__.clusterBVisible === true",
        "window.__3D_STATE__.clusterCVisible === true",
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.visibleNodeCount === 21"
      ]
    },
    {
      "id": "S4",
      "name": "ClusterARestoredAfterToggle",
      "conditions": [
        "window.__3D_STATE__.clusterAVisible === true",
        "window.__3D_STATE__.visibleNodeCount === 21"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
