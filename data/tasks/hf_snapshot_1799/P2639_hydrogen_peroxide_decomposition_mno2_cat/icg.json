  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.catalystAdded === false",
        "window.__3D_STATE__.reactionStarted === false"
      ]
    },
    {
      "id": "S1",
      "name": "CatalystDropped",
      "conditions": [
        "window.__3D_STATE__.catalystAdded === true",
        "window.__3D_STATE__.reactionStarted === false"
      ]
    },
    {
      "id": "S2",
      "name": "ReactionActive",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === true",
        "window.__3D_STATE__.reactionProgress > 0",
        "window.__3D_STATE__.reactionProgress < 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "ReactionMidpoint",
      "conditions": [
        "window.__3D_STATE__.reactionProgress >= 0.4",
        "window.__3D_STATE__.reactionProgress < 0.8"
      ]
    },
    {
      "id": "S4",
      "name": "ReactionComplete",
      "conditions": [
        "window.__3D_STATE__.reactionProgress >= 1.0",
        "window.__3D_STATE__.h2o2Concentration <= 0.02"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "RefilledH2O2",
      "conditions": [
        "window.__3D_STATE__.h2o2Concentration > 0.9",
        "window.__3D_STATE__.catalystAdded === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.catalystAdded === false",
        "window.__3D_STATE__.reactionProgress === 0",
        "window.__3D_STATE__.h2o2Concentration === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.h2o2Concentration === 'number' && !isNaN(window.__3D_STATE__.h2o2Concentration)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.h2o2Concentration === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.o2Produced === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 25.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystPosition !== undefined && typeof window.__3D_STATE__.catalystPosition.x === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const s = window.__3D_STATE__; if (s._dropCatalyst) { s._dropCatalyst(); } else { s.catalystAdded = true; s.catalystPosition = {x: -1.5, y: 0.5, z: 0}; } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.catalystAdded === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.catalystPosition.x - (-1.5)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystPosition.y > 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.h2o2Concentration === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionProgress === 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
