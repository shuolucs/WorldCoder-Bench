        "window.__3D_STATE__.phase === 'INTERPHASE'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.chromosomeCount === 8",
        "window.__3D_STATE__.daughterCellCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase_Active",
      "conditions": [
        "window.__3D_STATE__.phase === 'PROPHASE'",
        "window.__3D_STATE__.phaseIndex === 1"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase_Active",
      "conditions": [
        "window.__3D_STATE__.phase === 'METAPHASE'",
        "window.__3D_STATE__.phaseIndex === 2"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase_Active",
      "conditions": [
        "window.__3D_STATE__.phase === 'ANAPHASE'",
        "window.__3D_STATE__.phaseIndex === 3",
        "window.__3D_STATE__.chromosomeCount === 16"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase_Active",
      "conditions": [
        "window.__3D_STATE__.phase === 'TELOPHASE'",
        "window.__3D_STATE__.phaseIndex === 4"
