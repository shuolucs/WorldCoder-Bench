      "name": "Undo_To_Telophase",
      "conditions": [
        "window.__3D_STATE__.phase === 'TELOPHASE'",
        "window.__3D_STATE__.redoStack.length > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Redo_To_Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.phase === 'CYTOKINESIS'",
        "window.__3D_STATE__.phaseIndex === 5"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_To_Interphase",
      "conditions": [
        "window.__3D_STATE__.phase === 'INTERPHASE'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.chromosomeCount === 8"
      ]
    },
    {
      "id": "S10",
      "name": "AutoPlay_Enabled",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S11",
      "name": "Speed_Modified",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    }
