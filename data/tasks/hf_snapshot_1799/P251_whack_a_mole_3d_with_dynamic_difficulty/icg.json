  "states": [
    {
      "id": "S0",
      "name": "AssetsLoaded",
      "conditions": [
        "window.__3D_STATE__.ferrarisLoaded === true",
        "window.__3D_STATE__.gameState === 'idle'"
      ]
    },
    {
      "id": "S1",
      "name": "GameStarted",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.timeRemaining <= 30"
      ]
    },
    {
      "id": "S2",
      "name": "FirstMoleAppears",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.activeMoles >= 1",
        "window.__3D_STATE__.molesSpawned >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "FirstWhackScored",
      "conditions": [
        "window.__3D_STATE__.totalWhacks >= 1",
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.combo >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "ComboBuilding",
      "conditions": [
        "window.__3D_STATE__.totalWhacks >= 3",
        "window.__3D_STATE__.combo >= 3",
        "window.__3D_STATE__.score >= 30"
      ]
    },
    {
      "id": "S5",
      "name": "MissRegistered",
      "conditions": [
        "window.__3D_STATE__.missCount >= 1",
        "window.__3D_STATE__.combo === 0"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 2",
        "window.__3D_STATE__.totalWhacks >= 5"
      ]
    },
    {
      "id": "S7",
      "name": "HighDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 3",
        "window.__3D_STATE__.totalWhacks >= 10"
      ]
    },
    {
      "id": "S8",
      "name": "DifficultyParametersUpdated",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 3",
        "window.__3D_STATE__.moleVisibleDuration <= 1.4",
        "window.__3D_STATE__.maxSimultaneousMoles >= 3"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'",
        "window.__3D_STATE__.timeRemaining === 0"
      ]
    }
  ],
