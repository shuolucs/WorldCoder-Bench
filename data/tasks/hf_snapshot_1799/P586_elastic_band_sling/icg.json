{
  "task_id": "P586_elastic_band_sling",
  "affordances": [
    {"id": "A1", "name": "Slingshot", "type": "3d_object", "semantic": "Y-shaped fork with elastic bands", "locator_hints": ["cylinder meshes + tube geometry red"]},
    {"id": "A2", "name": "Projectile", "type": "3d_object", "semantic": "Avocado GLB as projectile", "locator_hints": ["GLTF model Avocado"]},
    {"id": "A3", "name": "Targets", "type": "3d_object", "semantic": "5 Duck GLB targets at various distances", "locator_hints": ["GLTF model Duck instances"]},
    {"id": "A4", "name": "TrajectoryTrail", "type": "3d_object", "semantic": "Fading trail line behind projectile", "locator_hints": ["line geometry orange"]},
    {"id": "A5", "name": "StiffnessSlider", "type": "dom_element", "semantic": "Elastic stiffness control", "locator_hints": ["#slider-stiffness"]},
    {"id": "A6", "name": "BandLengthSlider", "type": "dom_element", "semantic": "Band rest length control", "locator_hints": ["#slider-band-length"]},
    {"id": "A7", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.status === 'Ready'", "window.__3D_STATE__.shots === 0"]},
    {"id": "S1", "name": "Flying", "conditions": ["window.__3D_STATE__.status === 'Flying'"]},
    {"id": "S2", "name": "Landed", "conditions": ["window.__3D_STATE__.status === 'Landed'"]},
    {"id": "S3", "name": "StiffnessChanged", "conditions": ["window.__3D_STATE__.stiffness !== 80"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.score === 0", "window.__3D_STATE__.targetsRemaining === 5"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.targetsRemaining === 5", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "const s = window.__3D_STATE__; if(s && s.projectilePosition) { window.__3D_STATE__.__testLaunch = true; const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width/2; const cy = rect.top + rect.height * 0.45; canvas.dispatchEvent(new MouseEvent('mousedown', {clientX: cx, clientY: cy, bubbles: true})); setTimeout(()=>{ canvas.dispatchEvent(new MouseEvent('mousemove', {clientX: cx, clientY: cy + 150, bubbles: true})); }, 200); setTimeout(()=>{ canvas.dispatchEvent(new MouseEvent('mouseup', {clientX: cx, clientY: cy + 150, bubbles: true})); }, 500); } return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Flying' || window.__3D_STATE__.status === 'Landed' || window.__3D_STATE__.shots > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Landed' || window.__3D_STATE__.projectilePosition.y < 1.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-stiffness').value = 160; document.getElementById('slider-stiffness').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.stiffness >= 140", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "n"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Ready' || window.__3D_STATE__.status === 'Aiming'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.score === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.targetsRemaining === 5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-band-length').value = 0.80; document.getElementById('slider-band-length').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bandRestLength >= 0.70", "tier": "L2"}
      ]}
    }
  ]
}
