      "semantic": "Gray ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialClearState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.tintLevel === 0",
        "window.__3D_STATE__.uvOn === false",
        "window.__3D_STATE__.locked === false",
        "window.__3D_STATE__.cycleRunning === false"
      ]
    },
    {
      "id": "S1",
      "name": "UVOnDarkening",
      "conditions": [
        "window.__3D_STATE__.uvOn === true",
        "window.__3D_STATE__.tintLevel > 0",
        "window.__3D_STATE__.uvLightIntensity === 2.0"
      ]
    },
    {
      "id": "S2",
      "name": "PartiallyDarkened",
      "conditions": [
        "window.__3D_STATE__.tintLevel >= 0.2",
        "window.__3D_STATE__.tintLevel <= 0.6"
      ]
    },
    {
      "id": "S3",
      "name": "UVOffClearing",
      "conditions": [
        "window.__3D_STATE__.uvOn === false",
        "window.__3D_STATE__.uvLightIntensity === 0"
      ]
    },
    {
      "id": "S4",
      "name": "OutdoorPresetApplied",
      "conditions": [
        "window.__3D_STATE__.tintLevel === 0.85",
        "window.__3D_STATE__.uvOn === true",
        "window.__3D_STATE__.presetApplied === 'outdoor'"
      ]
    },
    {
      "id": "S5",
      "name": "IndoorPresetApplied",
      "conditions": [
        "window.__3D_STATE__.tintLevel === 0.05",
        "window.__3D_STATE__.uvOn === false",
        "window.__3D_STATE__.presetApplied === 'indoor'"
      ]
    },
    {
      "id": "S6",
      "name": "TintLocked",
      "conditions": [
        "window.__3D_STATE__.locked === true"
      ]
    },
    {
      "id": "S7",
      "name": "TintUnlocked",
      "conditions": [
        "window.__3D_STATE__.locked === false"
      ]
    },
    {
      "id": "S8",
      "name": "CycleRunning",
      "conditions": [
        "window.__3D_STATE__.cycleRunning === true"
      ]
    },
    {
      "id": "S9",
      "name": "CycleCompleted",
      "conditions": [
        "window.__3D_STATE__.cycleRunning === false",
        "window.__3D_STATE__.cyclesCompleted === 3"
      ]
    },
    {
      "id": "S10",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.redoStackDepth > 0"
      ]
    },
    {
      "id": "S11",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.undoStackDepth > 0"
      ]
    },
    {
      "id": "S12",
      "name": "FullyReset",
      "conditions": [
        "window.__3D_STATE__.tintLevel === 0",
        "window.__3D_STATE__.uvOn === false",
        "window.__3D_STATE__.presetApplied === 'reset'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#uv-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.uvOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.uvOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvLightIntensity === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.backgroundColor === 0x2a1a4e",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tintLevel > 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmission - (0.9 - 0.8 * window.__3D_STATE__.tintLevel)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - (0.05 + 0.25 * window.__3D_STATE__.tintLevel)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel === window.__3D_STATE__.tintLevel && !isNaN(window.__3D_STATE__.tintLevel)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.uvOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvLightIntensity === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.backgroundColor === 0x1a1a2e",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tintLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel >= 0 && window.__3D_STATE__.tintLevel <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#preset-outdoor"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.tintLevel - 0.85) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.presetApplied === 'outdoor'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmission - (0.9 - 0.8 * 0.85)) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - (0.05 + 0.25 * 0.85)) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvLightIntensity === 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#preset-indoor"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.tintLevel - 0.05) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.presetApplied === 'indoor'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmission - (0.9 - 0.8 * 0.05)) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvLightIntensity === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#tint-lock"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.locked === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.locked === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel >= 0 && window.__3D_STATE__.tintLevel <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const before = window.__3D_STATE__.tintLevel; document.getElementById('uv-toggle').click(); window.__test_tintBefore = before;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.locked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvOn === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tintLevel - window.__test_tintBefore) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel >= 0 && window.__3D_STATE__.tintLevel <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.tintLevel)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.locked === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tintLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.darkeningRate === 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clearingRate === 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S12",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#preset-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tintLevel === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.presetApplied === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.transmission - 0.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.roughness - 0.05) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S12",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#cycle-test"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cycleRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cyclesCompleted >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cycleRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cyclesCompleted === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 20000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cycleRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cyclesCompleted === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel >= 0 && window.__3D_STATE__.tintLevel <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.tintLevel)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackDepth >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__test_preUndoTint = window.__3D_STATE__.tintLevel; window.__test_preUndoDepth = window.__3D_STATE__.undoStackDepth; document.getElementById('undo-btn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackDepth === window.__test_preUndoDepth - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackDepth >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tintLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tintLevel >= 0 && window.__3D_STATE__.tintLevel <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.transmission)",
            "tier": "L2"
          }
        ]
      }
    }
