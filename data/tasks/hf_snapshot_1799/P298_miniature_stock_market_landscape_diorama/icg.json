      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.mascotLoaded === true",
        "window.__3D_STATE__.marketMode === 'stable'",
        "window.__3D_STATE__.selectedStock === -1",
        "Math.abs(window.__3D_STATE__.totalMarketCap - 22.5) < 0.01"
      ]
    },
    {
      "id": "S1",
      "name": "Stock_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedStock >= 0 && window.__3D_STATE__.selectedStock <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "Bull_Market_Active",
      "conditions": [
        "window.__3D_STATE__.marketMode === 'bull'",
        "window.__3D_STATE__.totalMarketCap > 22.5"
      ]
    },
    {
      "id": "S3",
      "name": "Bear_Market_Active",
      "conditions": [
        "window.__3D_STATE__.marketMode === 'bear'",
        "window.__3D_STATE__.totalMarketCap < 22.5"
      ]
    },
    {
      "id": "S4",
      "name": "Market_Reset",
      "conditions": [
        "window.__3D_STATE__.marketMode === 'stable'",
        "Math.abs(window.__3D_STATE__.totalMarketCap - 22.5) < 0.01"
      ]
    },
    {
      "id": "S5",
      "name": "Stock_Boosted",
      "conditions": [
        "window.__3D_STATE__.selectedStock >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "Bull_Via_Button",
      "conditions": [
        "window.__3D_STATE__.marketMode === 'bull'"
      ]
    },
    {
      "id": "S7",
      "name": "Bear_After_Bull",
      "conditions": [
        "window.__3D_STATE__.marketMode === 'bear'",
        "window.__3D_STATE__.timeStep >= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__.stockHeights) !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const clickX = rect.left + rect.width * 0.25; const clickY = rect.top + rect.height * 0.6; canvas.dispatchEvent(new MouseEvent('click', {clientX: clickX, clientY: clickY, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
