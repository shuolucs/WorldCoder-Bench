      "name": "ProgressBar",
      "type": "dom_element",
      "semantic": "Visual progress bar for phase completion",
      "locator_hints": [
        "id='progressBar'"
      ]
    },
    {
      "id": "A10",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Description panel for current phase",
      "locator_hints": [
        "id='infoPanel'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'Interphase'",
        "window.__3D_STATE__.progressPercent === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Prophase'",
        "window.__3D_STATE__.centrosomeCount === 2"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Metaphase'",
        "window.__3D_STATE__.spindleFibersVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'Anaphase'",
        "window.__3D_STATE__.chromosomeCount === 8"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseName === 'Telophase'",
        "window.__3D_STATE__.nucleusCount === 2"
      ]
    },
    {
      "id": "S5",
      "name": "Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 5",
        "window.__3D_STATE__.phaseName === 'Cytokinesis'",
        "window.__3D_STATE__.daughterCellsFormed === true"
      ]
    },
    {
      "id": "S6",
      "name": "ResetToInterphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'Interphase'",
        "window.__3D_STATE__.daughterCellsFormed === false"
      ]
    },
    {
      "id": "S7",
      "name": "AutoPlayActive",
      "conditions": [
        "window.__3D_STATE__.autoPlayActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "AutoPlayComplete",
      "conditions": [
        "window.__3D_STATE__.autoPlayActive === false",
        "window.__3D_STATE__.currentPhase === 5"
      ]
    }
  ],
  "transitions": [
