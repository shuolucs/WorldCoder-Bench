  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.round === 1",
        "window.__3D_STATE__.difficultyLevel === 1"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gamePaused === false",
        "window.__3D_STATE__.playerInRing === true",
        "window.__3D_STATE__.aiInRing === true"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerMoving",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.playerSpeed > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "StaminaDepleted",
      "conditions": [
        "window.__3D_STATE__.playerStamina < 80"
      ]
    },
    {
      "id": "S4",
      "name": "CollisionState",
      "conditions": [
        "window.__3D_STATE__.collisionOccurring === true"
      ]
    },
    {
      "id": "S5",
      "name": "RoundEndPlayerWin",
      "conditions": [
        "window.__3D_STATE__.lastRoundWinner === 'player'",
        "window.__3D_STATE__.gamePaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "RoundEndAIWin",
      "conditions": [
        "window.__3D_STATE__.lastRoundWinner === 'ai'",
        "window.__3D_STATE__.gamePaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 2"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.round === 1",
        "window.__3D_STATE__.playerWins === 0",
        "window.__3D_STATE__.aiWins === 0"
      ]
    },
    {
      "id": "S9",
      "name": "MultipleRoundsPlayed",
      "conditions": [
        "window.__3D_STATE__.round >= 3"
      ]
    }
  ],
