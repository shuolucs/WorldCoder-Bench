{
  "task_id": "P515_abstract_particle_art_with_particle_effe",
  "affordances": [
    {
      "id": "A1",
      "name": "DuckModel",
      "type": "3d_object",
      "semantic": "Central duck model loaded from Duck.glb that emits particles",
      "locator_hints": [
        "window.__duck__",
        "scene.getObjectByName('Duck')",
        "GLTFLoader result"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "THREE.Points with 2000 particles forming artistic patterns",
      "locator_hints": [
        "THREE.Points in scene",
        "BufferGeometry with position attribute"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing mode, particle count, burst count, color scheme, pause state",
      "locator_hints": [
        "document.getElementById('hud')"
      ]
    },
    {
      "id": "A4",
      "name": "ModeDisplay",
      "type": "dom_element",
      "semantic": "Current emission mode label",
      "locator_hints": [
        "document.getElementById('mode-display')"
      ]
    },
    {
      "id": "A5",
      "name": "ParticleCountDisplay",
      "type": "dom_element",
      "semantic": "Live particle count readout",
      "locator_hints": [
        "document.getElementById('particle-count')"
      ]
    },
    {
      "id": "A6",
      "name": "BurstCountDisplay",
      "type": "dom_element",
      "semantic": "Number of burst clicks performed",
      "locator_hints": [
        "document.getElementById('burst-count')"
      ]
    },
    {
      "id": "A7",
      "name": "PauseStateDisplay",
      "type": "dom_element",
      "semantic": "Shows PAUSED or PLAYING",
      "locator_hints": [
        "document.getElementById('pause-state')"
      ]
    },
    {
      "id": "A8",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for click interactions",
      "locator_hints": [
        "document.querySelector('canvas')"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.duckLoaded === false",
        "window.__3D_STATE__.mode === 'fountain'",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "Duck_Loaded_Particles_Active",
      "conditions": [
        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.particleCount > 0",
        "window.__3D_STATE__.mode === 'fountain'"
      ]
    },
    {
      "id": "S2",
      "name": "Vortex_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'vortex'",
        "window.__3D_STATE__.duckLoaded === true"
      ]
    },
    {
      "id": "S3",
      "name": "Explosion_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'explosion'",
        "window.__3D_STATE__.duckLoaded === true"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed_After_Pause",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "After_Burst",
      "conditions": [
        "window.__3D_STATE__.burstCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Color_Scheme_1",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 1"
      ]
    },
    {
      "id": "S8",
      "name": "HUD_Hidden",
      "conditions": [
        "window.__3D_STATE__.hudVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.mode === 'fountain'",
        "window.__3D_STATE__.burstCount === 0",
        "window.__3D_STATE__.colorScheme === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('mode-display') !== null && document.getElementById('mode-display').textContent.toLowerCase().includes('vortex')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('mode-display') !== null && document.getElementById('mode-display').textContent.toLowerCase().includes('explosion')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('pause-state') !== null && document.getElementById('pause-state').textContent.includes('PAUSED')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('pause-state') !== null && document.getElementById('pause-state').textContent.includes('PLAYING')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('burst-count') !== null && parseInt(document.getElementById('burst-count').textContent.replace(/[^0-9]/g,'')) >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('color-scheme') !== null && document.getElementById('color-scheme').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud') !== null && (document.getElementById('hud').style.display === 'none' || document.getElementById('hud').style.visibility === 'hidden' || document.getElementById('hud').style.opacity === '0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
