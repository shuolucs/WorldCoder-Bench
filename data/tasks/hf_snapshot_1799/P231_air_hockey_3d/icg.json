{
  "task_id": "P231_air_hockey_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "Puck",
      "type": "3d_object",
      "semantic": "Red flat cylinder that slides on the table",
      "locator_hints": [
        "red cylinder",
        "radius 0.4"
      ]
    },
    {
      "id": "A2",
      "name": "PlayerPaddle",
      "type": "3d_object",
      "semantic": "Green paddle controlled by mouse",
      "locator_hints": [
        "green cylinder",
        "radius 0.6",
        "player half"
      ]
    },
    {
      "id": "A3",
      "name": "AIPaddle",
      "type": "3d_object",
      "semantic": "Yellow paddle controlled by AI",
      "locator_hints": [
        "yellow cylinder",
        "radius 0.6",
        "AI half"
      ]
    },
    {
      "id": "A4",
      "name": "Table",
      "type": "3d_object",
      "semantic": "Dark blue air hockey table",
      "locator_hints": [
        "dark blue box",
        "10x16"
      ]
    },
    {
      "id": "A5",
      "name": "DragonTrophy",
      "type": "3d_object",
      "semantic": "Loaded GLB dragon model rotating above table",
      "locator_hints": [
        "DragonAttenuation.glb",
        "hovering",
        "rotating"
      ]
    },
    {
      "id": "A6",
      "name": "ScoreHUD",
      "type": "dom_element",
      "semantic": "HUD showing player and AI scores",
      "locator_hints": [
        "top center",
        "Player:",
        "AI:"
      ]
    },
    {
      "id": "A7",
      "name": "NewGameButton",
      "type": "dom_element",
      "semantic": "Button to reset the game",
      "locator_hints": [
        "New Game",
        "top-right"
      ]
    },
    {
      "id": "A8",
      "name": "PuckSpeedDebug",
      "type": "dom_element",
      "semantic": "Debug display of puck speed",
      "locator_hints": [
        "bottom-left",
        "speed"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.playerScore === 0",
        "window.__3D_STATE__.aiScore === 0",
        "window.__3D_STATE__.puckSpeed < 0.01",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S1",
      "name": "DragonLoaded",
      "conditions": [
        "window.__3D_STATE__.dragonLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "PuckLaunched",
      "conditions": [
        "window.__3D_STATE__.puckSpeed > 0.01",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S3",
      "name": "PuckMovingWithFriction",
      "conditions": [
        "window.__3D_STATE__.puckSpeed > 0",
        "window.__3D_STATE__.puckSpeed <= 0.3"
      ]
    },
    {
      "id": "S4",
      "name": "PuckBouncedOffWall",
      "conditions": [
        "window.__3D_STATE__.puckSpeed > 0",
        "Math.abs(window.__3D_STATE__.puckX) <= 4.7"
      ]
    },
    {
      "id": "S5",
      "name": "PlayerScored",
      "conditions": [
        "window.__3D_STATE__.playerScore >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "GoalPauseActive",
      "conditions": [
        "window.__3D_STATE__.goalPause === true"
      ]
    },
    {
      "id": "S7",
      "name": "AfterGoalReset",
      "conditions": [
        "window.__3D_STATE__.goalPause === false",
        "window.__3D_STATE__.puckSpeed < 0.01",
        "Math.abs(window.__3D_STATE__.puckX) < 0.5",
        "Math.abs(window.__3D_STATE__.puckZ) < 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.playerScore === 0",
        "window.__3D_STATE__.aiScore === 0",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.puckSpeed < 0.01"
      ]
    },
    {
      "id": "S9",
      "name": "DragonRotating",
      "conditions": [
        "window.__3D_STATE__.dragonLoaded === true",
        "window.__3D_STATE__.dragonRotationY > 0"
      ]
    },
    {
      "id": "S10",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "(window.__3D_STATE__.winner === 'player' || window.__3D_STATE__.winner === 'ai')"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
