      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.segmentCount > 1"
      ]
    },
    {
      "id": "S2",
      "name": "Generation_2",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.segmentCount > window.__3D_STATE__._prevSegmentCount"
      ]
    },
    {
      "id": "S3",
      "name": "Generation_Max",
      "conditions": [
        "window.__3D_STATE__.generation === 4"
      ]
    },
    {
      "id": "S4",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.segmentCount <= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Summer_Season",
      "conditions": [
        "window.__3D_STATE__.season === 'Summer'",
        "window.__3D_STATE__.seasonIndex === 1"
      ]
    },
    {
      "id": "S6",
      "name": "Winter_Season",
      "conditions": [
        "window.__3D_STATE__.season === 'Winter'",
        "window.__3D_STATE__.seasonIndex === 3"
      ]
    },
    {
      "id": "S7",
      "name": "Fireflies_Hidden",
