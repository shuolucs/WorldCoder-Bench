  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.season === 'Spring'",
        "window.__3D_STATE__.firefliesVisible === true"
      ]
    },
    {
      "id": "S1",
