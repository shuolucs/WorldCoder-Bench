      "type": "dom_element",
      "semantic": "Range slider to adjust quantum dot diameter of selected cuvette",
      "locator_hints": [
        "#sizeSlider"
      ]
    },
    {
      "id": "A4",
      "name": "TempSlider",
      "type": "dom_element",
      "semantic": "Range slider to adjust temperature in Kelvin",
      "locator_hints": [
        "#tempSlider"
      ]
    },
    {
      "id": "A5",
      "name": "ConcSlider",
      "type": "dom_element",
      "semantic": "Range slider to adjust solution concentration/opacity",
      "locator_hints": [
        "#concSlider"
      ]
    },
    {
      "id": "A6",
      "name": "Spectrometer",
      "type": "dom_element",
      "semantic": "Panel displaying spectral data for selected cuvette",
      "locator_hints": [
        "#spectrometer"
      ]
    },
    {
      "id": "A7",
      "name": "ShoeModel",
      "type": "3d_object",
      "semantic": "Loaded GLB shoe model on shelf as lab decoration",
      "locator_hints": [
        "MaterialsVariantsShoe.glb mesh on shelf"
      ]
    },
    {
      "id": "A8",
      "name": "LabBench",
      "type": "3d_object",
      "semantic": "Dark gray lab bench surface holding cuvettes",
      "locator_hints": [
        "box mesh at y=0.5"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Lab_Loaded",
      "conditions": [
        "window.__3D_STATE__.uvLampOn === true",
        "window.__3D_STATE__.selectedCuvette === -1",
        "window.__3D_STATE__.dotDiameters.length === 5",
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.cuvetteMeshes === 5"
      ]
    },
    {
      "id": "S1",
      "name": "UV_Lamp_Off",
      "conditions": [
        "window.__3D_STATE__.uvLampOn === false"
      ]
    },
    {
      "id": "S2",
      "name": "UV_Lamp_On",
      "conditions": [
        "window.__3D_STATE__.uvLampOn === true"
      ]
    },
    {
      "id": "S3",
      "name": "Cuvette_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedCuvette >= 0 && window.__3D_STATE__.selectedCuvette <= 4"
      ]
    },
    {
      "id": "S4",
      "name": "Size_Adjusted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'size_changed'"
      ]
    },
    {
      "id": "S5",
      "name": "Temperature_Changed",
      "conditions": [
        "window.__3D_STATE__.temperature !== 300"
      ]
    },
    {
      "id": "S6",
      "name": "Concentration_Changed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'concentration_changed'"
      ]
    },
    {
      "id": "S7",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount > 0",
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.selectedCuvette === -1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cuvetteMeshes === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.dotDiameters) && window.__3D_STATE__.dotDiameters.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.emissionWavelengths) && window.__3D_STATE__.emissionWavelengths.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dotDiameters[0] === 2.0 && window.__3D_STATE__.dotDiameters[4] === 8.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[0] < window.__3D_STATE__.emissionWavelengths[4]",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleUV"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.uvLampOn === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.uvLampOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'uv_toggled'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor !== undefined && !isNaN(window.__3D_STATE__.intensityFactor)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleUV"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.uvLampOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'uv_toggled'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.emissionColors) && window.__3D_STATE__.emissionColors.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.emissionColors.every(c => typeof c === 'string' && c.startsWith('#'))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCuvette === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCuvette === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dotDiameters[1] === 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] >= 500 && window.__3D_STATE__.emissionWavelengths[1] <= 540",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'cuvette_selected'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#sizeSlider').value = '2.0'; document.querySelector('#sizeSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dotDiameters[1] === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] >= 450 && window.__3D_STATE__.emissionWavelengths[1] <= 490",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] < window.__3D_STATE__.emissionWavelengths[2]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'size_changed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] <= window.__3D_STATE__.emissionWavelengths[0] + 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#sizeSlider').value = '9.0'; document.querySelector('#sizeSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dotDiameters[1] === 9.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] >= 630 && window.__3D_STATE__.emissionWavelengths[1] <= 780",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.emissionWavelengths[1] > window.__3D_STATE__.emissionWavelengths[4]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'size_changed'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.emissionWavelengths[1])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#tempSlider').value = '77'; document.querySelector('#tempSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 77",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor > 1.5 && window.__3D_STATE__.intensityFactor <= 1.6",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensityFactor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.intensityFactor)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor === Math.max(0, 1.0 - (77 - 300) / 400) || Math.abs(window.__3D_STATE__.intensityFactor - 1.5575) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#tempSlider').value = '500'; document.querySelector('#tempSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor >= 0 && window.__3D_STATE__.intensityFactor <= 0.55",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intensityFactor - 0.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#concSlider').value = '0.3'; document.querySelector('#concSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.concentration === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cuvetteOpacities[window.__3D_STATE__.selectedCuvette] <= 0.35",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.cuvetteOpacities) && window.__3D_STATE__.cuvetteOpacities.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'concentration_changed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cuvetteOpacities[window.__3D_STATE__.selectedCuvette] > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dotDiameters[0] === 2.0 && window.__3D_STATE__.dotDiameters[1] === 3.0 && window.__3D_STATE__.dotDiameters[2] === 4.5 && window.__3D_STATE__.dotDiameters[3] === 6.0 && window.__3D_STATE__.dotDiameters[4] === 8.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.concentration === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCuvette === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensityFactor === 1.0 || Math.abs(window.__3D_STATE__.intensityFactor - 1.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}