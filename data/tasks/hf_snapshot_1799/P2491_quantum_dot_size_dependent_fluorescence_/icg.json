{
  "task_id": "P2491_quantum_dot_size_dependent_fluorescence_",
  "affordances": [
    {
      "id": "A1",
      "name": "UVLampToggle",
      "type": "dom_element",
      "semantic": "Button to toggle UV lamp on/off for fluorescence excitation",
      "locator_hints": [
        "#toggleUV"
      ]
    },
    {
      "id": "A2",
      "name": "Cuvettes",
      "type": "3d_object",
      "semantic": "Array of 5 cuvettes containing quantum dot solutions on the lab bench",
      "locator_hints": [
        "cuvette mesh objects at x=-2,-1,0,1,2"
      ]
    },
    {
      "id": "A3",
