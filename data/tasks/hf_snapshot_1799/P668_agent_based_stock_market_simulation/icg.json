{
  "task_id": "P668_agent_based_stock_market_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "TradingFloor",
      "type": "3d_object",
      "semantic": "Circular floor where agents move and trade",
      "locator_hints": [
        "cylinder geometry",
        "radius 20"
      ]
    },
    {
      "id": "A2",
      "name": "Agents",
      "type": "3d_object",
      "semantic": "Sphere agents representing traders",
      "locator_hints": [
        "sphere radius 0.4",
        "30 initial agents"
      ]
    },
    {
      "id": "A3",
      "name": "CandlestickChart",
      "type": "3d_object",
      "semantic": "3D price chart in background",
      "locator_hints": [
        "box geometries",
        "green/red colors"
      ]
    },
    {
      "id": "A4",
      "name": "PriceDisplay",
      "type": "dom_element",
      "semantic": "Shows current stock price",
      "locator_hints": [
        "data-testid='price-display'"
      ]
    },
    {
      "id": "A5",
      "name": "VolumeDisplay",
      "type": "dom_element",
      "semantic": "Shows total volume traded",
      "locator_hints": [
        "data-testid='volume-display'"
      ]
    },
    {
      "id": "A6",
      "name": "AddBullButton",
      "type": "dom_element",
      "semantic": "Button to add 5 bull agents",
      "locator_hints": [
        "data-testid='btn-add-bull'"
      ]
    },
    {
      "id": "A7",
      "name": "AddBearButton",
      "type": "dom_element",
      "semantic": "Button to add 5 bear agents",
      "locator_hints": [
        "data-testid='btn-add-bear'"
      ]
    },
    {
      "id": "A8",
      "name": "MarketHaltButton",
      "type": "dom_element",
      "semantic": "Button to halt trading for 5 seconds",
      "locator_hints": [
        "data-testid='btn-market-halt'"
      ]
    },
    {
      "id": "A9",
      "name": "SelectedAgentPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected agent details",
      "locator_hints": [
        "data-testid='selected-agent-panel'"
      ]
    },
    {
      "id": "A10",
      "name": "TickDisplay",
      "type": "dom_element",
      "semantic": "Shows simulation tick count",
      "locator_hints": [
        "data-testid='tick-display'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.price === 100",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.agentCount === 30",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.totalVolume === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.tickCount > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "BullNewsInjected",
      "conditions": [
        "window.__3D_STATE__.lastNewsEvent === 'bull'",
        "window.__3D_STATE__.avgSentiment > 0"
      ]
    },
    {
      "id": "S4",
      "name": "BearNewsInjected",
      "conditions": [
        "window.__3D_STATE__.lastNewsEvent === 'bear'"
      ]
    },
    {
      "id": "S5",
      "name": "AgentsAdded",
      "conditions": [
        "window.__3D_STATE__.agentCount > 30"
      ]
    },
    {
      "id": "S6",
      "name": "MarketHalted",
      "conditions": [
        "window.__3D_STATE__.marketHalted === true"
      ]
    },
    {
      "id": "S7",
      "name": "FastForward",
      "conditions": [
        "window.__3D_STATE__.fastForward === true"
      ]
    },
    {
      "id": "S8",
      "name": "AgentSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAgentId !== null"
      ]
    },
    {
      "id": "S9",
      "name": "PostReset",
      "conditions": [
        "window.__3D_STATE__.price === 100",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.totalVolume === 0"
      ]
    },
    {
      "id": "S10",
      "name": "ConservationVerified",
      "conditions": [
        "window.__3D_STATE__.conservationValid === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.price === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.price >= 10 && window.__3D_STATE__.price <= 500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.price)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.priceHistory) && window.__3D_STATE__.priceHistory.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentCount === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalCash === 'number' && !isNaN(window.__3D_STATE__.totalCash)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalShares === 'number' && !isNaN(window.__3D_STATE__.totalShares)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalShares === window.__3D_STATE__.agentCount * 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.avgSentiment) <= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.volatility === 'number' && !isNaN(window.__3D_STATE__.volatility)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "P"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.price >= 10 && window.__3D_STATE__.price <= 500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalVolume)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "P"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.price)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "B"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastNewsEvent === 'bull'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSentiment > -0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSentiment <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgSentiment)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.price >= 10 && window.__3D_STATE__.price <= 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "S"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastNewsEvent === 'bear'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSentiment >= -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSentiment <= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgSentiment)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "[data-testid='btn-add-bull']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.agentCount === 35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bullCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bearCount === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neutralCount === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalShares === 35 * 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "[data-testid='btn-add-bear']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.agentCount === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bearCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bullCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalShares === 40 * 50",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalCash)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S1",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "[data-testid='btn-market-halt']"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.marketHalted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalVolume === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.price)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S1",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "F"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fastForward === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.volatility)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.price >= 10 && window.__3D_STATE__.price <= 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "F"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fastForward === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S1",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "R"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.price === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVolume === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agentCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastNewsEvent === null",
            "tier": "L2"
          }
        ]
      }
    }
