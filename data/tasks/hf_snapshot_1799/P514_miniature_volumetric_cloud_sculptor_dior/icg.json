{
  "task_id": "P514_miniature_volumetric_cloud_sculptor_dior",
  "affordances": [
    {
      "id": "A1",
      "name": "GlassDome",
      "type": "3d_object",
      "semantic": "Transparent glass dome enclosing the diorama",
      "locator_hints": [
        "MeshPhysicalMaterial with transmission",
        "sphere geometry radius ~2.4"
      ]
    },
    {
      "id": "A2",
      "name": "CloudPuffs",
      "type": "3d_object",
      "semantic": "Sculpt-able volumetric cloud groups",
      "locator_hints": [
        "groups of semi-transparent icosahedron spheres",
        "positioned y > 0.6"
      ]
    },
    {
      "id": "A3",
      "name": "BasePlatform",
      "type": "3d_object",
      "semantic": "Circular wooden base platform",
      "locator_hints": [
        "cylinder geometry",
        "brown material"
      ]
    },
    {
      "id": "A4",
      "name": "ToolDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current tool name",
      "locator_hints": [
        "#tool-display"
      ]
    },
    {
      "id": "A5",
      "name": "CloudCountDisplay",
      "type": "dom_element",
      "semantic": "HUD showing cloud count",
      "locator_hints": [
        "#cloud-count"
      ]
    },
    {
      "id": "A6",
      "name": "AddButton",
      "type": "dom_element",
      "semantic": "Button to switch to Add tool",
      "locator_hints": [
        "#btn-add"
      ]
    },
    {
      "id": "A7",
      "name": "RemoveButton",
      "type": "dom_element",
      "semantic": "Button to switch to Remove tool",
      "locator_hints": [
        "#btn-remove"
      ]
    },
    {
      "id": "A8",
      "name": "PaintButton",
      "type": "dom_element",
      "semantic": "Button to switch to Paint tool",
      "locator_hints": [
        "#btn-paint"
      ]
    },
    {
      "id": "A9",
      "name": "DriftToggle",
      "type": "dom_element",
      "semantic": "Checkbox to toggle cloud drift animation",
      "locator_hints": [
        "#toggle-drift"
      ]
    },
    {
      "id": "A10",
      "name": "DomeOpacitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling glass dome opacity",
      "locator_hints": [
        "#dome-opacity-slider"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'add'",
        "window.__3D_STATE__.cloudCount === 5",
        "window.__3D_STATE__.driftEnabled === true",
        "window.__3D_STATE__.lastActionType === 'none'",
        "window.__3D_STATE__.domeOpacity >= 0.14 && window.__3D_STATE__.domeOpacity <= 0.16"
      ]
    },
    {
      "id": "S1",
      "name": "RemoveToolSelected",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'remove'"
      ]
    },
    {
      "id": "S2",
      "name": "CloudAdded",
      "conditions": [
        "window.__3D_STATE__.lastActionType === 'cloud_added'",
        "window.__3D_STATE__.cloudCount > 5"
      ]
    },
    {
      "id": "S3",
      "name": "CloudRemoved",
      "conditions": [
        "window.__3D_STATE__.lastActionType === 'cloud_removed'",
        "window.__3D_STATE__.totalCloudsRemoved > 0"
      ]
    },
    {
      "id": "S4",
      "name": "PaintToolActive",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'paint'"
      ]
    },
    {
      "id": "S5",
      "name": "CloudPainted",
      "conditions": [
        "window.__3D_STATE__.lastActionType === 'cloud_painted'",
        "window.__3D_STATE__.lastPaintColor !== null"
      ]
    },
    {
      "id": "S6",
      "name": "DriftDisabled",
      "conditions": [
        "window.__3D_STATE__.driftEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "DomeOpacityChanged",
      "conditions": [
        "window.__3D_STATE__.domeOpacity > 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleEdits",
      "conditions": [
        "window.__3D_STATE__.totalCloudsAdded >= 2",
        "window.__3D_STATE__.totalCloudsRemoved >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'add'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.driftEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sunAngle === 'number' && !isNaN(window.__3D_STATE__.sunAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.domeOpacity >= 0 && window.__3D_STATE__.domeOpacity <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.5,
          "y": 0.35
        },
        "description": "Click in upper area of dome to add a cloud with add tool active"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount >= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionType === 'cloud_added'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCloudsAdded >= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('cloud-count').textContent.includes(String(window.__3D_STATE__.cloudCount))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2",
        "description": "Press '2' to switch to remove tool"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'remove'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tool-display').textContent.toLowerCase().includes('remove')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.driftEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.5,
          "y": 0.35
        },
        "description": "Click on a cloud to remove it with remove tool"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalCloudsRemoved >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionType === 'cloud_removed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('cloud-count').textContent.includes(String(window.__3D_STATE__.cloudCount))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-paint",
        "description": "Click paint button to switch to paint tool"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'paint'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tool-display').textContent.toLowerCase().includes('paint')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.48,
          "y": 0.33
        },
        "description": "Click on a cloud to paint it (cycle color)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastActionType === 'cloud_painted'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastPaintColor !== null && typeof window.__3D_STATE__.lastPaintColor === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTool === 'paint'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#toggle-drift",
        "description": "Uncheck the drift toggle to disable cloud bobbing"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.driftEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggle-drift').checked === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sunAngle === 'number' && window.__3D_STATE__.sunAngle >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('dome-opacity-slider').value = 75; document.getElementById('dome-opacity-slider').dispatchEvent(new Event('input'));",
        "description": "Set dome opacity slider to 75%"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.domeOpacity >= 0.7 && window.__3D_STATE__.domeOpacity <= 0.8",
            "tier": "L2"
          },
          {
            "expr": "Number(document.getElementById('dome-opacity-slider').value) === 75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.driftEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}