      "conditions": [
        "window.__3D_STATE__.modelsLoaded === 2",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.pendulumA.angle <= -29 && window.__3D_STATE__.pendulumA.angle >= -31",
