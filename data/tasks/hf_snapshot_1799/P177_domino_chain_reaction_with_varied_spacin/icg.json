{
  "task_id": "P177_domino_chain_reaction_with_varied_spacin",
  "affordances": [
    {
      "id": "A1",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to push the first domino and start chain reaction",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the entire scene",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A3",
      "name": "DominoChain",
      "type": "3d_object",
      "semantic": "Array of 12 domino boxes arranged in a curved path with varied spacing",
      "locator_hints": [
        "domino",
        "BoxGeometry"
      ]
    },
    {
      "id": "A4",
      "name": "AvocadoTrophy",
      "type": "3d_object",
      "semantic": "Avocado GLB model on gold pedestal at end of chain",
      "locator_hints": [
        "Avocado.glb",
        "avocado"
      ]
    },
    {
      "id": "A5",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "Particle effects for domino hits and celebration",
      "locator_hints": [
        "Points",
        "particles"
      ]
    },
    {
      "id": "A6",
      "name": "DominoCountHUD",
      "type": "dom_element",
      "semantic": "HUD showing dominoes fallen count",
      "locator_hints": [
        "#dominoCount"
      ]
    },
    {
      "id": "A7",
      "name": "ChainStatusHUD",
      "type": "dom_element",
      "semantic": "HUD showing chain complete message",
      "locator_hints": [
        "#chainStatus"
      ]
    },
    {
      "id": "A8",
      "name": "SpeedDisplayHUD",
      "type": "dom_element",
      "semantic": "HUD showing current speed mode",
      "locator_hints": [
        "#speedDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.dominoesFallen === 0",
        "window.__3D_STATE__.chainStarted === false",
        "window.__3D_STATE__.chainComplete === false",
        "window.__3D_STATE__.avocadoLoaded === true",
        "window.__3D_STATE__.isReset === true"
      ]
    },
    {
      "id": "S1",
      "name": "ChainStarted",
      "conditions": [
        "window.__3D_STATE__.chainStarted === true",
        "window.__3D_STATE__.dominoesFallen >= 1",
        "window.__3D_STATE__.isReset === false"
      ]
    },
    {
      "id": "S2",
      "name": "MidChain",
      "conditions": [
        "window.__3D_STATE__.dominoesFallen >= 6",
        "window.__3D_STATE__.dominoesFallen < 12",
        "window.__3D_STATE__.chainComplete === false"
      ]
    },
    {
      "id": "S3",
      "name": "ChainComplete",
      "conditions": [
        "window.__3D_STATE__.dominoesFallen === 12",
        "window.__3D_STATE__.chainComplete === true",
        "window.__3D_STATE__.avocadoSpinning === true",
        "window.__3D_STATE__.particlesActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "SlowMotionActive",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 0.25"
      ]
    },
    {
      "id": "S5",
      "name": "TopDownCamera",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'topdown'"
      ]
    },
    {
      "id": "S6",
      "name": "ResetAfterChain",
      "conditions": [
        "window.__3D_STATE__.dominoesFallen === 0",
        "window.__3D_STATE__.chainStarted === false",
        "window.__3D_STATE__.avocadoSpinning === false",
        "window.__3D_STATE__.isReset === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avocadoLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoesFallen === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.length === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.every(r => Math.abs(r) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainStarted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isReset === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[0] > 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoesFallen >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dominoesFallen >= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[0] >= 1.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations[5] >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticlesSpawned >= 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dominoesFallen === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoSpinning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.every(r => r >= 1.4)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dominoesFallen === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainStarted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avocadoSpinning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoRotations.every(r => Math.abs(r) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S0",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraMode === 'topdown'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoesFallen === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainStarted === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraMode === 'default'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoesFallen === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 0.25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedDisplay').textContent.includes('Slow')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}