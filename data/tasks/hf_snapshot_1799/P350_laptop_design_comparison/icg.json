        "#specs-panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === null",
        "window.__3D_STATE__.laptopA_screenAngle === 110",
        "window.__3D_STATE__.laptopB_screenAngle === 110",
        "window.__3D_STATE__.compareMode === false",
        "window.__3D_STATE__.specsVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "LaptopASelected",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'A'"
      ]
    },
    {
      "id": "S2",
      "name": "LaptopAScreenAdjusted",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'A'",
        "window.__3D_STATE__.laptopA_screenAngle === 120"
      ]
    },
    {
      "id": "S3",
      "name": "LaptopARotated",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'A'",
        "window.__3D_STATE__.laptopA_yRotation === 15"
      ]
    },
    {
      "id": "S4",
      "name": "CompareModeActive",
      "conditions": [
        "window.__3D_STATE__.compareMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "PositionsReset",
      "conditions": [
        "window.__3D_STATE__.compareMode === false"
      ]
    },
    {
      "id": "S6",
      "name": "SpecsVisible",
      "conditions": [
        "window.__3D_STATE__.specsVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.laptopA_colorIndex === 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "LaptopA",
        "position_hint": {
          "x": -2,
          "y": 1,
          "z": 0
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.laptopA_screenAngle !== before.laptopA_screenAngle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.laptopA_screenAngle === 'number' && !isNaN(window.__3D_STATE__.laptopA_screenAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.laptopB_screenAngle === 'number' && !isNaN(window.__3D_STATE__.laptopB_screenAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.compareMode === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.specsVisible === 'boolean'",
            "tier": "L0"
