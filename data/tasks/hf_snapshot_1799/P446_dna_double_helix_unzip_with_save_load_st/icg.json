  "states": [
    {
      "id": "S0",
      "name": "Initial_AllZipped",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 0",
        "window.__3D_STATE__.totalPairs === 20",
        "window.__3D_STATE__.saveState === 'Ready'",
        "window.__3D_STATE__.rotationSpeed === 0.01"
      ]
    },
    {
      "id": "S1",
      "name": "OneUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 1",
        "window.__3D_STATE__.pairStates[19] === false"
      ]
    },
    {
      "id": "S2",
      "name": "ThreeUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 3"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.saveState === 'Saved'",
        "window.__3D_STATE__.hasSaveData === true"
      ]
    },
    {
      "id": "S5",
      "name": "ResetToZero",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 0"
      ]
    },
    {
      "id": "S6",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.saveState === 'Loaded'"
      ]
    },
    {
      "id": "S7",
      "name": "PartialRezip",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 2"
      ]
    },
    {
      "id": "S8",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed < 0.01"
      ]
    },
    {
      "id": "S9",
      "name": "AllUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipCount === 20"
      ]
    }
  ],
