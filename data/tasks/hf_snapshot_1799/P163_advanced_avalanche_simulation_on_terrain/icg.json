{
  "task_id": "P163_advanced_avalanche_simulation_on_terrain",
  "affordances": [
    {
      "id": "A1",
      "name": "Terrain",
      "type": "3d_object",
      "semantic": "Procedural snowy mountain terrain tilted at 25 degrees",
      "locator_hints": [
        "PlaneGeometry tilted terrain",
        "white/grey mesh"
      ]
    },
    {
      "id": "A2",
      "name": "StorkModel",
      "type": "3d_object",
      "semantic": "GLTF stork model as rescue target on terrain",
      "locator_hints": [
        "stork.glb loaded model",
        "position near (0,5,0)"
      ]
    },
    {
      "id": "A3",
      "name": "SnowBoulders",
      "type": "3d_object",
      "semantic": "20 white spheres representing avalanche particles",
      "locator_hints": [
        "SphereGeometry white material",
        "positioned at terrain top"
      ]
    },
    {
      "id": "A4",
      "name": "Barriers",
      "type": "3d_object",
