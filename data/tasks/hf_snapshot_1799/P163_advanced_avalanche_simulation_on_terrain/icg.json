      "locator_hints": [
        "BoxGeometry brown material",
        "size 8x3x1"
      ]
    },
    {
      "id": "A5",
      "name": "SafeZone",
      "type": "3d_object",
      "semantic": "Green transparent plane at terrain bottom",
      "locator_hints": [
        "green semi-transparent plane",
        "position (0,-8,20)"
      ]
    },
