      "semantic": "HUD showing remaining barrier tokens",
      "locator_hints": [
        "#barrier-token-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.status === 'READY'",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.bouldersRemaining === 20"
      ]
    },
    {
      "id": "S1",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.status === 'RUNNING'",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.status === 'PAUSED'",
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S3",
      "name": "Shield_Activated",
      "conditions": [
        "window.__3D_STATE__.shieldActive === true",
        "window.__3D_STATE__.shieldHP === 3"
      ]
    },
    {
      "id": "S4",
      "name": "Boulders_Moving",
      "conditions": [
        "window.__3D_STATE__.averageBoulderSpeed > 0",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Barrier_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedBarrierIndex >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "Barrier_Spawned",
      "conditions": [
        "window.__3D_STATE__.barrierCount > 3"
      ]
    },
    {
      "id": "S7",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.status === 'READY'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    },
    {
      "id": "S8",
      "name": "Physics_Active",
      "conditions": [
        "window.__3D_STATE__.gravityAccel > 4.0",
        "window.__3D_STATE__.gravityAccel < 4.3"
      ]
    },
    {
      "id": "S9",
      "name": "Stork_Loaded",
      "conditions": [
        "window.__3D_STATE__.storkModelLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          }
        ]
