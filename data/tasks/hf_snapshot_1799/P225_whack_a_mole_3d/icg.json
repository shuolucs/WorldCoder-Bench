  "states": [
    {
      "id": "S0",
      "name": "Initial_Waiting",
      "conditions": [
        "window.__3D_STATE__.phase === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.gameStarted === false"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.phase === 'waiting'"
      ]
    },
    {
      "id": "S2",
      "name": "Game_Started",
      "conditions": [
        "window.__3D_STATE__.phase === 'playing'",
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.timeLeft === 30"
      ]
    },
    {
      "id": "S3",
      "name": "Moles_Popping",
      "conditions": [
        "window.__3D_STATE__.phase === 'playing'",
        "window.__3D_STATE__.activeMoles >= 1",
        "window.__3D_STATE__.totalPops >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "First_Whack",
      "conditions": [
        "window.__3D_STATE__.molesWhacked >= 1",
        "window.__3D_STATE__.score >= 10"
      ]
    },
    {
      "id": "S5",
      "name": "Combo_Active",
      "conditions": [
        "window.__3D_STATE__.currentCombo >= 2",
        "window.__3D_STATE__.score >= 30"
      ]
    },
    {
      "id": "S6",
      "name": "Miss_Occurred",
      "conditions": [
        "window.__3D_STATE__.misses >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Combo_Reset",
      "conditions": [
        "window.__3D_STATE__.misses >= 1",
        "window.__3D_STATE__.currentCombo === 0"
      ]
    },
    {
      "id": "S8",
      "name": "Mid_Game",
      "conditions": [
        "window.__3D_STATE__.phase === 'playing'",
        "window.__3D_STATE__.timeLeft <= 20",
        "window.__3D_STATE__.totalPops >= 5"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.phase === 'gameover'",
        "window.__3D_STATE__.timeLeft === 0"
      ]
    }
