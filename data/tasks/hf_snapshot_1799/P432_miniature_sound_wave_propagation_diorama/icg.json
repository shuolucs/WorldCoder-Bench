      ]
    },
    {
      "id": "A8",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Controls emission interval",
      "locator_hints": [
        "#slider-freq"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Clears all waves and resets state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "MediumToggle",
      "type": "dom_element",
      "semantic": "Cycles through Air/Water/Steel medium",
      "locator_hints": [
        "#btn-medium"
      ]
    },
    {
      "id": "A11",
      "name": "HUDInfo",
      "type": "dom_element",
      "semantic": "Top-left information panel",
      "locator_hints": [
        "#hud-info"
      ]
    },
    {
      "id": "A12",
      "name": "ProbeLabel",
      "type": "dom_element",
      "semantic": "Displays probe distance and delay",
      "locator_hints": [
        "#hud-probe"
      ]
    },
    {
      "id": "A13",
      "name": "DioramaBase",
      "type": "3d_object",
      "semantic": "Wooden base platform for the diorama",
      "locator_hints": [
        "box 30x0.5x20",
        "y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.activeWaveCount === 0",
        "window.__3D_STATE__.totalWavesEmitted === 0",
        "window.__3D_STATE__.medium === 'Air'",
        "window.__3D_STATE__.waveSpeed === 3.0"
      ]
    },
    {
      "id": "S1",
      "name": "Emitting_Waves",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.activeWaveCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Waves_With_Particles_Oscillating",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.oscillatingParticleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.waveSpeed !== 3.0",
        "window.__3D_STATE__.effectiveSpeed === window.__3D_STATE__.waveSpeed * window.__3D_STATE__.mediumMultiplier"
      ]
    },
    {
      "id": "S4",
      "name": "Medium_Water",
      "conditions": [
        "window.__3D_STATE__.medium === 'Water'",
        "window.__3D_STATE__.mediumMultiplier === 0.4"
      ]
    },
    {
      "id": "S5",
      "name": "Medium_Steel",
      "conditions": [
        "window.__3D_STATE__.medium === 'Steel'",
        "window.__3D_STATE__.mediumMultiplier === 1.8"
      ]
    },
    {
      "id": "S6",
      "name": "Diffraction_Enabled",
      "conditions": [
        "window.__3D_STATE__.diffractionEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reflection_Enabled",
      "conditions": [
        "window.__3D_STATE__.reflectionEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "Muted",
      "conditions": [
        "window.__3D_STATE__.muted === true"
      ]
    },
    {
      "id": "S9",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.activeWaveCount === 0",
        "window.__3D_STATE__.oscillatingParticleCount === 0"
      ]
    },
    {
      "id": "S10",
      "name": "Probe_Placed",
      "conditions": [
        "window.__3D_STATE__.probePosition !== null",
        "window.__3D_STATE__.probeDistance !== null",
        "window.__3D_STATE__.probeDelay !== null"
      ]
    },
    {
      "id": "S11",
      "name": "Frequency_Changed",
      "conditions": [
        "window.__3D_STATE__.emissionInterval !== 0.5"
      ]
    },
    {
      "id": "S12",
      "name": "Reflecting_Waves_Active",
      "conditions": [
        "window.__3D_STATE__.reflectionEnabled === true",
        "window.__3D_STATE__.reflectedWaveCount > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('btn-play').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Diffraction !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Reflection !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Muted !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-speed').value = '6'; document.getElementById('slider-speed').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
