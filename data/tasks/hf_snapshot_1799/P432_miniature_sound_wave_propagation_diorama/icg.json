{
  "task_id": "P432_miniature_sound_wave_propagation_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "Speaker",
      "type": "3d_object",
      "semantic": "Sound wave emitter at left side of diorama",
      "locator_hints": [
        "position.x ≈ -10",
        "dark colored box+cone shape"
      ]
    },
    {
      "id": "A2",
      "name": "WaveRings",
      "type": "3d_object",
      "semantic": "Concentric expanding torus rings representing sound waves",
      "locator_hints": [
        "torus geometry",
        "y ≈ 1.5"
      ]
    },
    {
      "id": "A3",
      "name": "MediumParticles",
      "type": "3d_object",
      "semantic": "200 small spheres that oscillate when wavefronts pass",
      "locator_hints": [
        "radius 0.08",
        "scattered on diorama surface"
      ]
    },
    {
      "id": "A4",
      "name": "WallObstacle",
      "type": "3d_object",
      "semantic": "Rectangular barrier at center of diorama",
      "locator_hints": [
        "position (0, 1.5, 0)",
        "box geometry"
      ]
    },
    {
      "id": "A5",
      "name": "CylinderObstacle",
      "type": "3d_object",
      "semantic": "Cylindrical obstacle at (4, 1.5, 3)",
      "locator_hints": [
        "cylinder geometry",
        "radius 1.5"
      ]
    },
    {
      "id": "A6",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggles wave emission on/off",
      "locator_hints": [
        "#btn-play"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Controls wave expansion speed",
      "locator_hints": [
