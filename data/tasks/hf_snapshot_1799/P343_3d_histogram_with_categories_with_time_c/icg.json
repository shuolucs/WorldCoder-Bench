  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 0",
        "window.__3D_STATE__.currentMonth === 'Jan'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.totalVisibleBars === 5"
      ]
    },
    {
      "id": "S1",
      "name": "NextTimeStep",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 1",
        "window.__3D_STATE__.currentMonth === 'Feb'"
      ]
    },
    {
      "id": "S2",
      "name": "ThirdTimeStep",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 2",
        "window.__3D_STATE__.currentMonth === 'Mar'"
      ]
    },
    {
      "id": "S3",
      "name": "PlayingState",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "PausedAfterPlay",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTimeStep >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "CategoryHidden",
      "conditions": [
        "window.__3D_STATE__.visibleCategories[2] === false",
        "window.__3D_STATE__.totalVisibleBars === 4"
      ]
    },
    {
      "id": "S6",
      "name": "CategoryRestored",
      "conditions": [
        "window.__3D_STATE__.visibleCategories[2] === true",
        "window.__3D_STATE__.totalVisibleBars === 5"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentMonth === 'Jan'"
      ]
    },
    {
      "id": "S8",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.animationSpeed === 2000"
      ]
    },
    {
      "id": "S9",
      "name": "LastTimeStep",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 5",
        "window.__3D_STATE__.currentMonth === 'Jun'"
      ]
    }
  ],
