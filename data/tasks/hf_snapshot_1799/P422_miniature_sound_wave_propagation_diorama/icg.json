{
  "task_id": "P422_miniature_sound_wave_propagation_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "Speaker",
      "type": "3d_object",
      "semantic": "Sound wave source on left side of diorama",
      "locator_hints": [
        "position near x=-8",
        "dark gray box with cone"
      ]
    },
    {
      "id": "A2",
      "name": "WaveParticles",
      "type": "3d_object",
      "semantic": "Grid of 800 small spheres representing sound wave propagation",
      "locator_hints": [
        "40x20 grid of spheres",
        "y around 1.0"
      ]
    },
    {
      "id": "A3",
      "name": "ZoneBIndicator",
      "type": "3d_object",
      "semantic": "Translucent green box showing dense medium zone",
      "locator_hints": [
        "x between -2 and 2",
        "green transparent material"
      ]
    },
    {
      "id": "A4",
      "name": "Obstacle",
      "type": "3d_object",
      "semantic": "Vertical wall creating sound shadow",
      "locator_hints": [
        "position x=5",
        "brown box"
      ]
    },
    {
      "id": "A5",
      "name": "Receiver",
      "type": "3d_object",
      "semantic": "Microphone at x=7 measuring received amplitude",
      "locator_hints": [
        "dark red cylinder",
        "position x=7"
      ]
    },
    {
      "id": "A6",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Slider to control wave frequency",
      "locator_hints": [
        "input[type=range]",
        "label contains 'Frequency'"
      ]
    },
    {
      "id": "A7",
      "name": "AmplitudeSlider",
      "type": "dom_element",
      "semantic": "Slider to control wave amplitude",
      "locator_hints": [
        "input[type=range]",
        "label contains 'Amplitude'"
      ]
    },
    {
      "id": "A8",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation play/pause",
      "locator_hints": [
        "button",
        "text contains 'Play' or 'Pause'"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to defaults",
      "locator_hints": [
        "button",
        "text contains 'Reset'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false || window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.amplitude === 0.5",
        "window.__3D_STATE__.particleCount === 800"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.time > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "FrequencyChanged",
      "conditions": [
        "window.__3D_STATE__.frequency !== 1.0",
        "Math.abs(window.__3D_STATE__.waveSpeed - window.__3D_STATE__.frequency * window.__3D_STATE__.wavelength) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "AmplitudeChanged",
      "conditions": [
        "window.__3D_STATE__.amplitude !== 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "HighFrequency",
      "conditions": [
        "window.__3D_STATE__.frequency === 2.5"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.frequency === 1.0",
        "window.__3D_STATE__.amplitude === 0.5",
        "window.__3D_STATE__.time === 0"
      ]
    },
    {
      "id": "S7",
      "name": "LowAmplitude",
      "conditions": [
        "window.__3D_STATE__.amplitude === 0.2"
      ]
    },
    {
      "id": "S8",
      "name": "WavePropagating",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.time > 2.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "description": "Click Play/Pause button to start simulation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "description": "Press Space to pause simulation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "description": "Press Up arrow to increase frequency by 0.1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<14;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));document.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowUp'}));}",
        "description": "Press Up arrow 14 more times to reach frequency 2.5 Hz"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "description": "Press Left arrow to decrease amplitude by 0.05"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset simulation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<6;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowLeft'}));document.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowLeft'}));}",
        "description": "Press Left arrow 6 times to reduce amplitude to 0.2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:' '}));document.dispatchEvent(new KeyboardEvent('keyup',{key:' '}));",
        "description": "Press Space to resume, then wait for propagation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:last-of-type",
        "description": "Click Reset button to return to initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));document.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowDown'}));document.dispatchEvent(new KeyboardEvent('keydown',{key:' '}));document.dispatchEvent(new KeyboardEvent('keyup',{key:' '}));",
        "description": "Decrease frequency to 0.9 and start playing"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}