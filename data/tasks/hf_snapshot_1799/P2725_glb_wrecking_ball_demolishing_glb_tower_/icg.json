          {
            "expr": "typeof window.__3D_STATE__.debugVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraMode === 'topdown'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.slowMotion === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballReleased === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballReleased === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.destroyedCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L1"
          },
          {
