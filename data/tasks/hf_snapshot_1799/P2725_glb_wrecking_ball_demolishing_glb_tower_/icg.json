            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.towerKE === 0 || window.__3D_STATE__.towerKE < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.centerOfMassY - window.__3D_STATE__.initialCenterOfMassY) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballReleased === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.destroyedCount === 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.x)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.towerBlocks.every(b => !isNaN(b.position.x) && !isNaN(b.position.y) && !isNaN(b.position.z))",
