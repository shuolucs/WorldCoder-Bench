      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the entire scene",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "SlowMoButton",
      "type": "dom_element",
      "semantic": "Button to toggle slow motion physics",
      "locator_hints": [
        "#slowMoBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud",
        "#destroyedCount",
        "#ballKE",
        "#towerKE",
        "#comY",
        "#simTime",
        "#modeLabel"
      ]
    },
    {
      "id": "A9",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Static ground plane for physics collisions",
      "locator_hints": [
        "100x100 plane",
        "dark olive color"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.physicsInitialized === true",
        "window.__3D_STATE__.groundExists === true",
        "window.__3D_STATE__.totalBlocks === 20",
        "window.__3D_STATE__.ballReleased === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelsLoaded",
      "conditions": [
        "window.__3D_STATE__.plantsLoaded === true",
        "window.__3D_STATE__.towerModelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "BallReleased",
      "conditions": [
        "window.__3D_STATE__.ballReleased === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "BallSwinging",
      "conditions": [
        "window.__3D_STATE__.ballReleased === true",
        "window.__3D_STATE__.ballKE > 0.1"
      ]
    },
    {
      "id": "S4",
      "name": "ImpactOccurred",
      "conditions": [
        "window.__3D_STATE__.towerKE > 0.5",
        "window.__3D_STATE__.destroyedCount >= 0"
      ]
    },
    {
      "id": "S5",
      "name": "TowerCollapsing",
      "conditions": [
        "window.__3D_STATE__.centerOfMassY < window.__3D_STATE__.initialCenterOfMassY",
        "window.__3D_STATE__.destroyedCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "SlowMotionActive",
      "conditions": [
        "window.__3D_STATE__.slowMotion === true"
      ]
    },
    {
      "id": "S7",
      "name": "CameraTopDown",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'topdown'"
      ]
    },
    {
      "id": "S8",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.ballReleased === false",
        "window.__3D_STATE__.destroyedCount === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.plantsLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.plantsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.towerModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBlocks === 20",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.towerBlocks) && window.__3D_STATE__.towerBlocks.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialCenterOfMassY > 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#releaseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballReleased === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.x)",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.y)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.y > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballKE > 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballKE)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.x > -15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ballVelocity.x) + Math.abs(window.__3D_STATE__.ballVelocity.y) > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.towerKE > 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.towerKE)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.towerBlocks.some(b => Math.abs(b.velocity.x) + Math.abs(b.velocity.y) + Math.abs(b.velocity.z) > 0.1)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.centerOfMassY === 'number' && !isNaN(window.__3D_STATE__.centerOfMassY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.destroyedCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.centerOfMassY < window.__3D_STATE__.initialCenterOfMassY",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.destroyedCount <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.towerBlocks.filter(b => b.fallen === true).length === window.__3D_STATE__.destroyedCount",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('destroyedCount').textContent.includes(String(window.__3D_STATE__.destroyedCount))",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#slowMoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.slowMotion === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.slowMotion === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('modeLabel').textContent.toLowerCase().includes('slow')",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ballReleased === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
