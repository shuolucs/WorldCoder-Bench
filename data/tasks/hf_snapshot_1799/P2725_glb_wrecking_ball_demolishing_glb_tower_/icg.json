      "name": "WreckingBall",
      "type": "3d_object",
      "semantic": "Heavy sphere on a pendulum chain that swings into the tower",
      "locator_hints": [
        "sphere radius 1.5",
        "dark gray metallic",
        "ballPosition in __3D_STATE__"
      ]
    },
    {
      "id": "A2",
      "name": "TowerBlocks",
      "type": "3d_object",
      "semantic": "20 physics-enabled box bodies forming a 5-layer tower structure",
      "locator_hints": [
