        "semi-transparent red debug boxes"
      ]
    },
    {
      "id": "A3",
      "name": "TowerModel",
      "type": "3d_object",
      "semantic": "DirectionalLight.glb loaded as the visual tower representation",
      "locator_hints": [
        "GLB at origin",
        "scaled (3,3,3)"
      ]
    },
    {
      "id": "A4",
      "name": "Plants",
      "type": "3d_object",
      "semantic": "Three instances of DiffuseTransmissionPlant.glb as decorative vegetation",
      "locator_hints": [
        "positions (-8,0,5), (-10,0,-3), (6,0,8)",
        "scaled (2,2,2)"
      ]
    },
    {
      "id": "A5",
      "name": "ReleaseButton",
      "type": "dom_element",
      "semantic": "Button to release the wrecking ball",
      "locator_hints": [
