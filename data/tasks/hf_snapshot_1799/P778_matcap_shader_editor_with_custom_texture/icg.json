        "#timeDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.activePreset === 0",
        "window.__3D_STATE__.timeSpeed === 1.0",
        "window.__3D_STATE__.distortionAmount === 0.03",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.meshCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFramesElapsed",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PresetChanged",
      "conditions": [
        "window.__3D_STATE__.activePreset !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "TimeSpeedChanged",
      "conditions": [
        "window.__3D_STATE__.timeSpeed !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "DistortionChanged",
      "conditions": [
        "window.__3D_STATE__.distortionAmount !== 0.03"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S7",
      "name": "TintColorChanged",
      "conditions": [
        "window.__3D_STATE__.tintColor !== '#ffffff'"
      ]
    },
    {
      "id": "S8",
      "name": "MultiplePresetsVisited",
      "conditions": [
        "window.__3D_STATE__.activePreset === 3"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.activePreset === 0",
        "window.__3D_STATE__.timeSpeed === 1.0",
        "window.__3D_STATE__.distortionAmount === 0.03",
        "window.__3D_STATE__.isPaused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && !isNaN(window.__3D_STATE__.elapsedTime) && isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.meshNames) && window.__3D_STATE__.meshNames.length === 3 && window.__3D_STATE__.meshNames[0] === 'TorusKnot' && window.__3D_STATE__.meshNames[1] === 'Sphere' && window.__3D_STATE__.meshNames[2] === 'Icosahedron'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnPreset2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('presetLabel').textContent.includes('Lava')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentDistortionUniform === 'number' && Math.abs(window.__3D_STATE__.currentDistortionUniform - 0.03) < 0.001",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTimeSpeedUniform === 'number' && Math.abs(window.__3D_STATE__.currentTimeSpeedUniform - 1.0) < 0.01",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('sliderTimeSpeed'); const nativeSet = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSet.call(s, '3.5'); s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.timeSpeed - 3.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTimeSpeedUniform - 3.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('timeSpeedLabel').textContent.includes('3.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeSpeed >= 0 && window.__3D_STATE__.timeSpeed <= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('sliderDistortion'); const nativeSet = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSet.call(s, '0.1'); s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.distortionAmount - 0.1) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentDistortionUniform - 0.1) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('distortionLabel').textContent.includes('0.100')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distortionAmount >= 0 && window.__3D_STATE__.distortionAmount <= 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnPause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btnPause').textContent.trim() === 'Resume'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime) && isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T6_frozenTime = window.__3D_STATE__.elapsedTime; await new Promise(r => setTimeout(r, 800)); window.__T6_afterPauseTime = window.__3D_STATE__.elapsedTime; document.getElementById('btnPause').click(); await new Promise(r => setTimeout(r, 600));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__T6_afterPauseTime - window.__T6_frozenTime) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > window.__T6_afterPauseTime",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btnPause').textContent.trim() === 'Pause'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const ci = document.getElementById('colorTint'); const nativeSet = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSet.call(ci, '#ff0066'); ci.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tintColor === '#ff0066'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tintColor === 'string' && window.__3D_STATE__.tintColor.startsWith('#')",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnPreset3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('presetLabel').textContent.includes('Jade')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintColor === '#ff0066'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.distortionAmount - 0.1) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btnReset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.timeSpeed - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.distortionAmount - 0.03) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tintColor === '#ffffff'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allMaterialsSync === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('presetLabel').textContent.includes('Gold')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T10_timeBefore = window.__3D_STATE__.elapsedTime; await new Promise(r => setTimeout(r, 1000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > window.__T10_timeBefore",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime - window.__T10_timeBefore > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime - window.__T10_timeBefore < 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime) && isFinite(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraZ > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}