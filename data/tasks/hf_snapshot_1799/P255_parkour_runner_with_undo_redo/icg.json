{
  "task_id": "P255_parkour_runner_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "Player",
      "type": "3d_object",
      "semantic": "The parkour runner capsule that the user controls",
      "locator_hints": [
        "red cylinder+sphere group",
        "player mesh"
      ]
    },
    {
      "id": "A2",
      "name": "Platforms",
      "type": "3d_object",
      "semantic": "Array of 8 floating box platforms forming the parkour course",
      "locator_hints": [
        "brown box geometries",
        "platform meshes"
      ]
    },
    {
      "id": "A3",
      "name": "GoalTrophy",
      "type": "3d_object",
      "semantic": "The ABeautifulGame.glb model placed on the final platform",
      "locator_hints": [
        "loaded GLTF model on platform 8"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the entire game state",
      "locator_hints": [
        "#resetBtn",
        "button labeled Reset Game"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing platform, time, falls, undo/redo info",
      "locator_hints": [
        "top-left platform text",
        "bottom-left undo/redo text"
      ]
    },
    {
      "id": "A6",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Large green ground plane below the platforms",
      "locator_hints": [
        "green plane mesh",
        "ground"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 0",
        "window.__3D_STATE__.fallCount === 0",
        "window.__3D_STATE__.goalReached === false",
        "window.__3D_STATE__.isGrounded === true"
      ]
    },
    {
      "id": "S1",
      "name": "PlayerJumped",
      "conditions": [
        "window.__3D_STATE__.isGrounded === false",
        "window.__3D_STATE__.playerVelocity.y > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerOnPlatform2",
      "conditions": [
        "window.__3D_STATE__.currentPlatform >= 1",
        "window.__3D_STATE__.isGrounded === true"
      ]
    },
    {
      "id": "S3",
      "name": "PlayerFell",
      "conditions": [
        "window.__3D_STATE__.fallCount >= 1",
        "window.__3D_STATE__.currentPlatform === 0"
      ]
    },
    {
      "id": "S4",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "GoalReached",
      "conditions": [
        "window.__3D_STATE__.goalReached === true",
        "window.__3D_STATE__.currentPlatform === 7"
      ]
    },
    {
      "id": "S7",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 0",
        "window.__3D_STATE__.fallCount === 0",
        "window.__3D_STATE__.elapsedTime < 0.5",
        "window.__3D_STATE__.goalReached === false"
      ]
    }
  ],
