    {
      "id": "A8",
      "name": "PivotButton",
      "type": "dom_element",
      "semantic": "Button to attempt pivot move",
      "locator_hints": [
        "#btn-pivot"
      ]
    },
    {
      "id": "A9",
      "name": "MonomerSpheres",
      "type": "3d_object",
      "semantic": "Individual monomer spheres that can be clicked",
      "locator_hints": [
        "sphere meshes in chain group"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.chainLength === 1",
        "window.__3D_STATE__.stepsAttempted === 0",
        "window.__3D_STATE__.isTrapped === false",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S1",
      "name": "SingleGrowth",
      "conditions": [
        "window.__3D_STATE__.chainLength >= 2",
        "window.__3D_STATE__.stepsAttempted >= 1",
        "window.__3D_STATE__.stepsAccepted >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "MultipleGrowth",
      "conditions": [
        "window.__3D_STATE__.chainLength >= 5",
        "window.__3D_STATE__.stepsAccepted >= 4"
      ]
    },
    {
      "id": "S3",
      "name": "ContinuousRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.chainLength > 5"
      ]
    },
    {
      "id": "S5",
      "name": "AfterPivot",
      "conditions": [
        "window.__3D_STATE__.lastPivotAccepted !== null"
      ]
    },
    {
      "id": "S6",
      "name": "MonomerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedMonomerIndex !== null"
      ]
    },
    {
      "id": "S7",
      "name": "ChainReset",
      "conditions": [
        "window.__3D_STATE__.chainLength === 1",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S8",
      "name": "LongChain",
      "conditions": [
        "window.__3D_STATE__.chainLength >= 15"
      ]
    },
    {
      "id": "S9",
      "name": "EnergyVerified",
      "conditions": [
        "window.__3D_STATE__.totalEnergy <= 0 || window.__3D_STATE__.chainLength < 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chainLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chainLength === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepsAttempted >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepsAccepted === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.occupiedSites === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.endToEndDistance === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<10;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'g'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepsAttempted >= 11",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.acceptanceRatio > 0 && window.__3D_STATE__.acceptanceRatio <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.length === window.__3D_STATE__.chainLength",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.occupiedSites === window.__3D_STATE__.chainLength",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chainLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chainLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.endToEndDistance)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.radiusOfGyration)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainLength > 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.endToEndDistance >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radiusOfGyration > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.every(p => p.x >= 0 && p.x <= 10 && p.y >= 0 && p.y <= 10 && p.z >= 0 && p.z <= 10)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastPivotAccepted === true || window.__3D_STATE__.lastPivotAccepted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainLength === window.__3D_STATE__.occupiedSites",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.length === window.__3D_STATE__.chainLength",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.radiusOfGyration)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.every(p => Number.isInteger(p.x) && Number.isInteger(p.y) && Number.isInteger(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<30;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'g'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainLength >= 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.endToEndDistance <= window.__3D_STATE__.chainLength - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radiusOfGyration > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radiusOfGyration < window.__3D_STATE__.boundarySize",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.endToEndDistance - Math.sqrt(Math.pow(window.__3D_STATE__.monomerPositions[window.__3D_STATE__.chainLength-1].x - window.__3D_STATE__.monomerPositions[0].x, 2) + Math.pow(window.__3D_STATE__.monomerPositions[window.__3D_STATE__.chainLength-1].y - window.__3D_STATE__.monomerPositions[0].y, 2) + Math.pow(window.__3D_STATE__.monomerPositions[window.__3D_STATE__.chainLength-1].z - window.__3D_STATE__.monomerPositions[0].z, 2))) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* verify energy consistency */"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy <= 0 || window.__3D_STATE__.chainLength < 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.epsilon === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kT === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S9",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "x"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainLength === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions[0].x === 5 && window.__3D_STATE__.monomerPositions[0].y === 5 && window.__3D_STATE__.monomerPositions[0].z === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.occupiedSites === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isTrapped === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<12;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'g'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainLength >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.acceptanceRatio === window.__3D_STATE__.stepsAccepted / window.__3D_STATE__.stepsAttempted",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.monomerPositions.every(p => Number.isInteger(p.x) && Number.isInteger(p.y) && Number.isInteger(p.z))",
            "tier": "L2"
          },
          {
            "expr": "new Set(window.__3D_STATE__.monomerPositions.map(p => p.x+','+p.y+','+p.z)).size === window.__3D_STATE__.chainLength",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boundarySize === 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S2",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedMonomerIndex = 0;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedMonomerIndex !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedMonomerIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedMonomerIndex < window.__3D_STATE__.chainLength",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.monomerPositions[window.__3D_STATE__.selectedMonomerIndex] === 'object'",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}