      ]
    },
    {
      "id": "S10",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.windSpeed === 3.0",
        "window.__3D_STATE__.colorTheme === 'fire'",
        "window.__3D_STATE__.emberMode === false",
        "window.__3D_STATE__.paused === false"
      ]
    }
