{
  "task_id": "P1868_rammed_earth_layer_compaction_visualizer",
  "affordances": [
    {
      "id": "A1",
      "name": "PourButton",
      "type": "dom_element",
      "semantic": "Button to pour a new loose earth layer into the formwork",
      "locator_hints": [
        "#btn-pour"
      ]
    },
    {
      "id": "A2",
      "name": "CompactButton",
      "type": "dom_element",
      "semantic": "Button to perform one rammer strike on the current top layer",
      "locator_hints": [
        "#btn-compact"
      ]
    },
    {
      "id": "A3",
      "name": "RemoveFormworkButton",
      "type": "dom_element",
      "semantic": "Button to remove formwork panels after 4+ compacted layers",
      "locator_hints": [
        "#btn-remove-formwork"
      ]
    },
    {
      "id": "A4",
      "name": "RammerTool",
      "type": "3d_object",
      "semantic": "Cylindrical rammer tool that animates during compaction",
      "locator_hints": [
        "rammer",
        "cylinder above wall"
      ]
    },
    {
      "id": "A5",
      "name": "FormworkPanels",
      "type": "3d_object",
      "semantic": "Two transparent panels forming the wall mold",
      "locator_hints": [
        "formwork",
        "transparent panels"
      ]
    },
    {
      "id": "A6",
      "name": "EarthLayers",
      "type": "3d_object",
      "semantic": "Box meshes representing poured/compacted earth layers",
      "locator_hints": [
        "layer",
        "earth",
        "soil box"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing wall statistics",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A8",
      "name": "LayerCountDisplay",
      "type": "dom_element",
      "semantic": "Span showing current layer count",
      "locator_hints": [
        "#hud-layer-count"
      ]
    },
    {
      "id": "A9",
      "name": "WallHeightDisplay",
      "type": "dom_element",
      "semantic": "Span showing total wall height",
      "locator_hints": [
        "#hud-wall-height"
      ]
    },
    {
      "id": "A10",
      "name": "AvgDensityDisplay",
      "type": "dom_element",
      "semantic": "Span showing average wall density",
      "locator_hints": [
        "#hud-avg-density"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEmpty",
      "conditions": [
        "window.__3D_STATE__.layerCount === 0",
        "window.__3D_STATE__.totalWallHeight === 0",
        "window.__3D_STATE__.formworkRemoved === false"
      ]
    },
    {
      "id": "S1",
      "name": "FirstLayerPoured",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.currentStrikes === 0",
        "window.__3D_STATE__.layers[0].isCompacted === false"
      ]
    },
    {
      "id": "S2",
      "name": "FirstLayerPartiallyCompacted",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.currentStrikes > 0",
        "window.__3D_STATE__.currentStrikes < 3"
      ]
    },
    {
      "id": "S3",
      "name": "FirstLayerFullyCompacted",
      "conditions": [
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.currentStrikes === 3",
        "window.__3D_STATE__.layers[0].isCompacted === true"
      ]
    },
    {
      "id": "S4",
      "name": "FourLayersCompacted",
      "conditions": [
        "window.__3D_STATE__.layerCount === 4",
        "window.__3D_STATE__.layers.filter(l => l.isCompacted).length === 4"
      ]
    },
    {
      "id": "S5",
      "name": "LayerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLayerIndex !== null",
        "window.__3D_STATE__.selectedLayerIndex >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "FormworkRemoved",
      "conditions": [
        "window.__3D_STATE__.formworkRemoved === true"
      ]
    },
    {
      "id": "S7",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.layerCount === 0",
        "window.__3D_STATE__.formworkRemoved === false",
        "window.__3D_STATE__.totalWallHeight === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pour"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.layers[0] === 'object' && window.__3D_STATE__.layers[0] !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].looseHeight === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].isCompacted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].moisture >= 8 && window.__3D_STATE__.layers[0].moisture <= 16",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.layers[0].moisture) && !isNaN(window.__3D_STATE__.layers[0].density)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-compact"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentStrikes === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].strikes === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].isCompacted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].compactedHeight === undefined || window.__3D_STATE__.layers[0].compactedHeight < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rammerY === 'number' && !isNaN(window.__3D_STATE__.rammerY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-compact').click(); await new Promise(r => setTimeout(r, 600)); document.getElementById('btn-compact').click(); await new Promise(r => setTimeout(r, 600));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentStrikes === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].isCompacted === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.layers[0].compactedHeight - 0.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalWallHeight - 0.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].density > 1600",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageDensity > 0 && !isNaN(window.__3D_STATE__.averageDensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for (let i = 0; i < 3; i++) { document.getElementById('btn-pour').click(); await new Promise(r => setTimeout(r, 300)); for (let s = 0; s < 3; s++) { document.getElementById('btn-compact').click(); await new Promise(r => setTimeout(r, 600)); } }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.filter(l => l.isCompacted).length === 4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalWallHeight - window.__3D_STATE__.layers.reduce((s, l) => s + (l.isCompacted ? l.compactedHeight : 0), 0)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every(l => !isNaN(l.density) && l.density > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every(l => l.moisture >= 8 && l.moisture <= 16)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "/* Verify density formula correctness for all layers */ void(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers.every(l => { const eff = 1.0 - Math.abs(l.moisture - 12) / 12; const expectedDensity = (1600 / 0.6) * eff; return Math.abs(l.density - expectedDensity) < 1.0; })",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.averageDensity - (window.__3D_STATE__.layers.reduce((s, l) => s + l.density, 0) / window.__3D_STATE__.layers.length)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every((l, i) => i === 0 || l.yPosition > window.__3D_STATE__.layers[i-1].yPosition)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compactionRatio === 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxLayers === 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "/* Simulate raycaster click on the first layer mesh. We use script to set selection directly if raycasting is complex. */ const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight * 0.75, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt); await new Promise(r => setTimeout(r, 500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLayerIndex !== null && window.__3D_STATE__.selectedLayerIndex !== -1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedLayerIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedLayerIndex >= 0 && window.__3D_STATE__.selectedLayerIndex < window.__3D_STATE__.layerCount",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-selected-info') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-selected-info').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-remove-formwork"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formworkRemoved === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWallHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-remove-formwork').disabled === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalWallHeight)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "/* Verify HUD DOM sync with 3D state */ void(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-layer-count') !== null",
            "tier": "L0"
          },
          {
            "expr": "parseInt(document.getElementById('hud-layer-count').textContent) === window.__3D_STATE__.layerCount",
            "tier": "L2"
          },
          {
            "expr": "parseFloat(document.getElementById('hud-wall-height').textContent) > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('hud-wall-height').textContent) - window.__3D_STATE__.totalWallHeight) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "parseFloat(document.getElementById('hud-avg-density').textContent) > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWallHeight === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formworkRemoved === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedLayerIndex === null || window.__3D_STATE__.selectedLayerIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layers) && window.__3D_STATE__.layers.length === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.averageDensity === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "/* Verify buttons are in correct enable/disable state after reset */ void(0);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('btn-pour').disabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-compact').disabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-remove-formwork').disabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentStrikes === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimating === false",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}