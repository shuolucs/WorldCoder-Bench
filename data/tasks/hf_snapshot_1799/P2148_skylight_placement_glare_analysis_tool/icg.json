{
  "task_id": "P2148_skylight_placement_glare_analysis_tool",
  "affordances": [
    {
      "id": "A1",
      "name": "Room",
      "type": "3d_object",
      "semantic": "Architectural room box with interior visible walls",
      "locator_hints": [
        "BoxGeometry room",
        "BackSide material"
      ]
    },
    {
      "id": "A2",
      "name": "DuckModel",
      "type": "3d_object",
      "semantic": "Duck.glb loaded as occupant proxy on the floor",
      "locator_hints": [
        "GLTF loaded duck",
        "position (0,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "Desk",
      "type": "3d_object",
      "semantic": "Brown desk box in the room",
      "locator_hints": [
        "box at (-2, 0.4, -1)"
      ]
    },
    {
      "id": "A4",
      "name": "Skylight",
      "type": "3d_object",
      "semantic": "Semi-transparent ceiling plane with attached SpotLight",
      "locator_hints": [
        "PlaneGeometry at y=3.99",
        "light blue transparent"
      ]
    },
    {
      "id": "A5",
      "name": "GlareSamplePoints",
      "type": "3d_object",
      "semantic": "12x8 grid of colored ring indicators on the floor",
      "locator_hints": [
        "RingGeometry at y=0.01",
        "green/yellow/red"
      ]
    },
    {
      "id": "A6",
      "name": "AddSkylightBtn",
      "type": "dom_element",
      "semantic": "Button to add a skylight",
      "locator_hints": [
        "#addSkylightBtn"
      ]
    },
    {
      "id": "A7",
      "name": "RemoveSkylightBtn",
      "type": "dom_element",
      "semantic": "Button to remove last skylight",
      "locator_hints": [
        "#removeSkylightBtn"
      ]
    },
    {
      "id": "A8",
      "name": "AnalyzeBtn",
      "type": "dom_element",
      "semantic": "Button to run glare analysis",
      "locator_hints": [
        "#analyzeBtn"
      ]
    },
    {
      "id": "A9",
      "name": "SelectNextBtn",
      "type": "dom_element",
      "semantic": "Button to cycle skylight selection",
      "locator_hints": [
        "#selectNextBtn"
      ]
    },
    {
      "id": "A10",
      "name": "SunSlider",
      "type": "dom_element",
      "semantic": "Slider controlling sun elevation 0-180",
      "locator_hints": [
        "#sunSlider"
      ]
    },
    {
      "id": "A11",
      "name": "GlareScoreDisplay",
      "type": "dom_element",
      "semantic": "Shows computed glare percentage",
      "locator_hints": [
        "#glareScore"
      ]
    },
    {
      "id": "A12",
      "name": "CoverageScoreDisplay",
      "type": "dom_element",
      "semantic": "Shows computed light coverage percentage",
      "locator_hints": [
        "#coverageScore"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Room",
      "conditions": [
        "window.__3D_STATE__.skylightCount === 0",
        "window.__3D_STATE__.roomVisible === true",
        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.analysisRun === false"
      ]
    },
    {
      "id": "S1",
      "name": "One_Skylight_Placed",
      "conditions": [
        "window.__3D_STATE__.skylightCount === 1",
        "window.__3D_STATE__.selectedSkylightIndex === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Two_Skylights_Placed",
      "conditions": [
        "window.__3D_STATE__.skylightCount === 2"
      ]
    },
    {
      "id": "S3",
      "name": "Skylight_Moved",
      "conditions": [
        "window.__3D_STATE__.skylightCount >= 1",
        "window.__3D_STATE__.skylightPositions[0].x !== -2.5 || window.__3D_STATE__.skylightPositions[0].z !== -2"
      ]
    },
    {
      "id": "S4",
      "name": "Sun_Changed",
      "conditions": [
        "window.__3D_STATE__.sunElevation !== 90"
      ]
    },
    {
      "id": "S5",
      "name": "Glare_Analyzed",
      "conditions": [
        "window.__3D_STATE__.analysisRun === true",
        "window.__3D_STATE__.totalSamplePoints === 96"
      ]
    },
    {
      "id": "S6",
      "name": "Skylight_Removed",
      "conditions": [
        "window.__3D_STATE__.skylightCount === 1"
      ]
    },
    {
      "id": "S7",
      "name": "Selection_Cycled",
      "conditions": [
        "window.__3D_STATE__.selectedSkylightIndex >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "Low_Sun_Analysis",
      "conditions": [
        "window.__3D_STATE__.sunElevation < 15",
        "window.__3D_STATE__.analysisRun === true"
      ]
    },
    {
      "id": "S9",
      "name": "Four_Skylights_Max",
      "conditions": [
        "window.__3D_STATE__.skylightCount === 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roomVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.duckPosition !== undefined && typeof window.__3D_STATE__.duckPosition.x === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightCount === 0 && window.__3D_STATE__.selectedSkylightIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunElevation === 90 && window.__3D_STATE__.analysisRun === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addSkylightBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skylightCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSkylightIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.skylightPositions) && window.__3D_STATE__.skylightPositions.length === 1",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightPositions[0].x - (-2.5)) < 0.01 && Math.abs(window.__3D_STATE__.skylightPositions[0].z - (-2)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightIntensity > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightIntensity - Math.max(0, Math.sin(90 * Math.PI / 180)) * 3.0) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addSkylightBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skylightCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions.length === 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightPositions[1].x - 2.5) < 0.01 && Math.abs(window.__3D_STATE__.skylightPositions[1].z - (-2)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions[0].x !== window.__3D_STATE__.skylightPositions[1].x",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('skylightCount') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skylightPositions.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex].x >= -5.5 && window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex].x <= 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex].z >= -3.5 && window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex].z <= 3.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.skylightPositions[window.__3D_STATE__.selectedSkylightIndex].x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sunSlider').value = 45; document.getElementById('sunSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunElevation === 45",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightIntensity - Math.max(0, Math.sin(45 * Math.PI / 180)) * 3.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightIntensity > 0 && window.__3D_STATE__.skylightIntensity < 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.skylightIntensity)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('sunLabel') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#analyzeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.analysisRun === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSamplePoints === 96",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redPoints + window.__3D_STATE__.yellowPoints + window.__3D_STATE__.greenPoints === 96",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.glareScore - (window.__3D_STATE__.redPoints / 96 * 100)) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.coverageScore - ((window.__3D_STATE__.yellowPoints + window.__3D_STATE__.redPoints) / 96 * 100)) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glareScore >= 0 && window.__3D_STATE__.glareScore <= 100 && window.__3D_STATE__.coverageScore >= 0 && window.__3D_STATE__.coverageScore <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#removeSkylightBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skylightCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions.length === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.skylightPositions[1] === 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSkylightIndex <= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightCount < 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sunSlider').value = 10; document.getElementById('sunSlider').dispatchEvent(new Event('input')); setTimeout(() => document.getElementById('analyzeBtn').click(), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunElevation <= 14 || window.__3D_STATE__.sunElevation === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redPoints === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.yellowPoints === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glareScore === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coverageScore === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightIntensity - Math.max(0, Math.sin(10 * Math.PI / 180)) * 3.0) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sunSlider').value = 90; document.getElementById('sunSlider').dispatchEvent(new Event('input')); for(let i = window.__3D_STATE__.skylightCount; i < 4; i++) { document.getElementById('addSkylightBtn').click(); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skylightCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunElevation === 90",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.skylightIntensity - 3.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skylightPositions.every(function(p) { return p.x >= -5.5 && p.x <= 5.5 && p.z >= -3.5 && p.z <= 3.5; })",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#analyzeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.analysisRun === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSamplePoints === 96",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redPoints + window.__3D_STATE__.yellowPoints + window.__3D_STATE__.greenPoints === 96",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coverageScore > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redPoints > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.glareScore) && !isNaN(window.__3D_STATE__.coverageScore)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}