  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.ballThrown === false",
        "window.__3D_STATE__.currentFrame === 1",
        "window.__3D_STATE__.currentThrow === 1",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "Ball_Aimed",
      "conditions": [
        "window.__3D_STATE__.ballPosition.x !== 0",
        "window.__3D_STATE__.ballThrown === false"
      ]
    },
    {
      "id": "S2",
      "name": "Power_Adjusted",
      "conditions": [
        "window.__3D_STATE__.throwPower !== 15",
        "window.__3D_STATE__.ballThrown === false"
      ]
    },
    {
      "id": "S3",
      "name": "Ball_In_Motion",
      "conditions": [
        "window.__3D_STATE__.ballThrown === true",
        "window.__3D_STATE__.ballPosition.z < 4"
      ]
    },
    {
      "id": "S4",
      "name": "Slow_Motion_Active",
      "conditions": [
        "window.__3D_STATE__.timeScale < 1.0",
        "window.__3D_STATE__.timeScale > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Pins_Knocked",
      "conditions": [
        "window.__3D_STATE__.pinsDown > 0",
        "window.__3D_STATE__.ballThrown === true"
      ]
    },
    {
      "id": "S7",
      "name": "Strike_Achieved",
      "conditions": [
        "window.__3D_STATE__.pinsDown === 10",
        "window.__3D_STATE__.isStrike === true"
      ]
    },
    {
      "id": "S8",
      "name": "Second_Throw_Ready",
      "conditions": [
        "window.__3D_STATE__.currentThrow === 2",
        "window.__3D_STATE__.ballThrown === false"
      ]
    },
    {
      "id": "S9",
      "name": "Frame_Complete",
      "conditions": [
        "window.__3D_STATE__.currentFrame >= 2 || window.__3D_STATE__.isStrike === true || window.__3D_STATE__.currentThrow === 1"
      ]
    },
    {
      "id": "S10",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true"
      ]
    }
  ],
