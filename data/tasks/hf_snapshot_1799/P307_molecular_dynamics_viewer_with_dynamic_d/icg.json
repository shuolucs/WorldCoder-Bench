  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.atomCount === 30",
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.wallCollisions === 0"
      ]
    },
    {
      "id": "S1",
      "name": "DuckLoadedAndSimRunning",
      "conditions": [
        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.avgSpeed > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationAdvanced",
      "conditions": [
        "window.__3D_STATE__.wallCollisions > 0",
        "window.__3D_STATE__.simTime > 0.5",
        "window.__3D_STATE__.totalKineticEnergy > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.frameCount > 30"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyLevel2",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.repulsionEnabled === false"
      ]
    },
    {
      "id": "S6",
