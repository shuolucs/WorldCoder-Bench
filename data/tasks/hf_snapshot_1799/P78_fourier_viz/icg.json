{
  "task_id": "P78_fourier_viz",
  "affordances": [
    {
      "id": "A1",
      "name": "WebGLCanvas",
      "type": "3d_object",
      "semantic": "Three.js 渲染画布",
      "locator_hints": [
        "canvas",
        "webgl"
      ]
    },
    {
      "id": "A2",
      "name": "WaveformSelect",
      "type": "dom_element",
      "semantic": "波形选择器",
      "locator_hints": [
        "waveform"
      ]
    },
    {
      "id": "A3",
      "name": "NTermsSlider",
      "type": "dom_element",
      "semantic": "谐波项数滑块",
      "locator_hints": [
        "nTerms"
      ]
    },
    {
      "id": "A4",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "速度滑块",
      "locator_hints": [
        "speed"
      ]
    },
    {
      "id": "A5",
      "name": "ErrorDisplay",
      "type": "dom_element",
      "semantic": "误差显示",
      "locator_hints": [
        "errorDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "CoefficientChart",
      "type": "dom_element",
      "semantic": "傅里叶系数柱状图面板",
      "locator_hints": [
        "chart",
        "coefficients"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loaded",
      "description": "初始加载，1 项傅里叶近似"
    },
    {
      "id": "S1",
      "name": "high_terms",
      "description": "增加到 20 项，误差下降"
    },
    {
      "id": "S2",
      "name": "waveform_changed",
      "description": "切换波形类型"
    },
    {
      "id": "S3",
      "name": "speed_changed",
      "description": "调整速度"
    },
    {
      "id": "S4",
      "name": "math_verified",
      "description": "数学正确性验证"
    },
    {
      "id": "S5",
      "name": "trace_growing",
      "description": "轨迹点持续增长"
    },
    {
      "id": "S6",
      "name": "circles_match",
      "description": "圆数量匹配项数"
    },
    {
      "id": "S7",
      "name": "stable",
      "description": "长期稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "初始化：nTerms=1，waveform 有效，error 存在且为正数"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nTerms >= 1",
            "tier": "L2"
          },
          {
            "expr": "['square','sawtooth','triangle','custom'].includes(window.__3D_STATE__.waveform)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.error === 'number' && window.__3D_STATE__.error > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number' && isFinite(window.__3D_STATE__.simTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_input",
        "selector": "#nTerms",
        "value": "20"
      },
      "postconditions": [
        "nTerms 更新为 20，error 比初始值显著降低"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.nTerms === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.error < before.error",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_input",
        "selector": "#waveform",
        "value": "sawtooth"
      },
      "postconditions": [
        "波形切换为 sawtooth，circles 数组重新计算"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.waveform === 'sawtooth'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.circles) && window.__3D_STATE__.circles.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.circles[0].radius > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_input",
        "selector": "#speed",
        "value": "3.0"
      },
      "postconditions": [
        "速度已更新"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.speed - 3.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_input",
        "selector": "#nTerms",
        "value": "1"
      },
      "postconditions": [
        "数学正确性：N=1 的误差大于 N=20 的误差"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.nTerms === 1",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const errN1 = window.__3D_STATE__.error; return errN1 > 0.01; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "dom_input",
        "selector": "#nTerms",
        "value": "10"
      },
      "postconditions": [
        "nTerms=10，轨迹点数随时间增长"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 3000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.nTerms === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tracePointCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tracePointCount > before.tracePointCount || window.__3D_STATE__.tracePointCount >= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "circles 数组长度等于 nTerms"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.circles)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.circles.length === window.__3D_STATE__.nTerms",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.circles.every(c => typeof c.radius === 'number' && typeof c.frequency === 'number' && isFinite(c.radius) && isFinite(c.frequency))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60 秒稳定性：simTime 持续递增，error 有限，无 NaN"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > before.simTime",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.error)",
            "tier": "L2"
          },
          {
            "expr": "!Number.isNaN(window.__3D_STATE__.nTerms)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.simTime)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}