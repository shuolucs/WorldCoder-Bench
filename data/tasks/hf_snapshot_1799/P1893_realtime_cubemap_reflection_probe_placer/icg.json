{
  "task_id": "P1893_realtime_cubemap_reflection_probe_placer",
  "affordances": [
    {
      "id": "A1",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Clickable ground plane for placing reflection probes",
      "locator_hints": [
        "ground",
        "plane",
        "floor"
      ]
    },
    {
      "id": "A2",
      "name": "ReflectionProbe",
      "type": "3d_object",
      "semantic": "Reflective sphere representing a cubemap probe, clickable to select",
      "locator_hints": [
        "probe",
        "small reflective sphere",
        "radius 0.5"
      ]
    },
    {
      "id": "A3",
      "name": "TestSphere",
      "type": "3d_object",
      "semantic": "Highly reflective test sphere that receives envMap from nearest probe",
      "locator_hints": [
        "test sphere",
        "metalness 1.0",
        "radius 1.0"
      ]
    },
    {
      "id": "A4",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing probe stats and FPS",
      "locator_hints": [
        "div",
        "top-left",
        "HUD"
      ]
    },
    {
      "id": "A5",
      "name": "ClearAllButton",
      "type": "dom_element",
      "semantic": "Button to remove all probes from the scene",
      "locator_hints": [
        "button",
        "Clear All"
      ]
    },
    {
      "id": "A6",
      "name": "KeyboardControls",
      "type": "dom_element",
      "semantic": "Keyboard inputs for R, Delete, +, -, [, ], T",
      "locator_hints": [
        "keydown",
        "document"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.probeCount === 0",
        "window.__3D_STATE__.selectedProbeId === null",
        "Array.isArray(window.__3D_STATE__.testSpheres) && window.__3D_STATE__.testSpheres.length === 3"
      ]
    },
    {
      "id": "S1",
      "name": "OneProbe_Placed",
      "conditions": [
        "window.__3D_STATE__.probeCount === 1",
        "window.__3D_STATE__.probes[0].id === 1",
        "window.__3D_STATE__.lastAction === 'probe_placed'"
      ]
    },
    {
      "id": "S2",
      "name": "Probe_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedProbeId !== null",
        "window.__3D_STATE__.selectedProbeIntensity !== null",
        "window.__3D_STATE__.selectedProbeRadius !== null"
      ]
    },
    {
      "id": "S3",
      "name": "Intensity_Modified",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'intensity_changed'",
        "window.__3D_STATE__.selectedProbeIntensity !== null"
      ]
    },
    {
      "id": "S4",
      "name": "Radius_Modified",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'radius_changed'",
        "window.__3D_STATE__.selectedProbeRadius !== null"
      ]
    },
    {
      "id": "S5",
      "name": "Probe_Toggled_Inactive",
      "conditions": [
        "window.__3D_STATE__.selectedProbeActive === false",
        "window.__3D_STATE__.lastAction === 'toggled_active'"
      ]
    },
    {
      "id": "S6",
      "name": "MultipleProbes_Placed",
      "conditions": [
        "window.__3D_STATE__.probeCount >= 2"
      ]
    },
    {
      "id": "S7",
      "name": "Probe_Deleted",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'probe_deleted'"
      ]
    },
    {
      "id": "S8",
      "name": "All_Refreshed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'all_refreshed'",
        "window.__3D_STATE__.totalRefreshCount > 0"
      ]
    },
    {
      "id": "S9",
      "name": "All_Cleared",
      "conditions": [
        "window.__3D_STATE__.probeCount === 0",
        "window.__3D_STATE__.lastAction === 'all_cleared'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "GroundPlane",
        "position_hint": "click on ground near center, e.g. world position (2, 0, 3)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.probeCount === 'number' && window.__3D_STATE__.probeCount === 1",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.probes) && window.__3D_STATE__.probes.length === 1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.probes[0].position.y === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes[0].intensity === 1.0 && window.__3D_STATE__.probes[0].radius === 10.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes[0].active === true && window.__3D_STATE__.probes[0].id === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'probe_placed' && window.__3D_STATE__.totalRefreshCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "ReflectionProbe",
        "position_hint": "click on the placed probe sphere"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedProbeId === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedProbeIntensity === 'number' && window.__3D_STATE__.selectedProbeIntensity === 1.0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedProbeRadius === 'number' && window.__3D_STATE__.selectedProbeRadius === 10.0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'probe_selected'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "=",
        "description": "Press + (=) three times to increase intensity from 1.0 to 1.3",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'intensity_changed'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedProbeIntensity - 1.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.probes.find(p => p.id === window.__3D_STATE__.selectedProbeId).intensity - 1.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeIntensity <= 2.0 && window.__3D_STATE__.selectedProbeIntensity >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeId === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "]",
        "description": "Press ] twice to increase radius from 10.0 to 12.0",
        "repeat": 2
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'radius_changed'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.selectedProbeRadius - 12.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.probes.find(p => p.id === window.__3D_STATE__.selectedProbeId).radius - 12.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeRadius >= 1.0 && window.__3D_STATE__.selectedProbeRadius <= 20.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probeCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t",
        "description": "Press T to toggle the selected probe to inactive"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedProbeActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.find(p => p.id === window.__3D_STATE__.selectedProbeId).active === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggled_active'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.testSpheres.every(ts => ts.assignedProbeId === null || ts.assignedProbeId !== window.__3D_STATE__.selectedProbeId)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeId === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Re-activate probe first, then place a second probe by simulating ground click\nwindow.dispatchEvent(new KeyboardEvent('keydown', {key: 't'}));\n// We need to place a second probe via script injection\nif(window.__placeProbeAt) { window.__placeProbeAt(5, 1, 5); } else { /* fallback: the test will click canvas */ }",
        "description": "Toggle probe back to active, then place a second probe at (5,1,5)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.probeCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.every(p => typeof p.id === 'number' && !isNaN(p.position.x) && !isNaN(p.position.y) && !isNaN(p.position.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes[1] !== undefined && window.__3D_STATE__.probes[1].position.y === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.testSpheres.some(ts => ts.assignedProbeId !== null)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to refresh all active probes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'all_refreshed'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRefreshCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.every(p => typeof p.lastUpdateTime === 'number' && p.lastUpdateTime > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probeCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && !isNaN(window.__3D_STATE__.fps)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Select the second probe then delete it\nif(window.__3D_STATE__.probes.length >= 2) { const probeId = window.__3D_STATE__.probes[1].id; if(window.__selectProbe) window.__selectProbe(probeId); } setTimeout(() => { window.dispatchEvent(new KeyboardEvent('keydown', {key: 'Delete'})); }, 100);",
        "description": "Select second probe and press Delete to remove it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'probe_deleted'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probeCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes[0].id === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.testSpheres.every(ts => ts.assignedProbeId === null || ts.assignedProbeId === 1)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "ClearAllButton",
        "selector": "button"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.probeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probes.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'all_cleared'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeId === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.testSpheres.every(ts => ts.assignedProbeId === null)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeIntensity === null && window.__3D_STATE__.selectedProbeRadius === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 500,
        "description": "Wait and verify scene is fully reset to initial empty state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.probeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedProbeId === null",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.testSpheres) && window.__3D_STATE__.testSpheres.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.testSpheres.every(ts => ts.assignedProbeId === null)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}