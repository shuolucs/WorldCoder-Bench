{
  "task_id": "P498_l_system_plant_growth_with_save_load_sta",
  "affordances": [
    {
      "id": "A1",
      "name": "Plant",
      "type": "3d_object",
      "semantic": "The L-system generated plant growing from the ground",
      "locator_hints": [
        "Group at origin containing cylinder branches and sphere leaves"
      ]
    },
    {
      "id": "A2",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to grow the plant to the next generation",
      "locator_hints": [
        "#btn-grow"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the plant to generation 0",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A4",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save the current state",
      "locator_hints": [
        "#btn-save"
      ]
    },
    {
      "id": "A5",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load a previously saved state",
      "locator_hints": [
        "#btn-load"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "HUD displaying generation, branch count, leaf count",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A7",
      "name": "GenerationDisplay",
      "type": "dom_element",
      "semantic": "Text showing current generation number",
      "locator_hints": [
        "#gen-display"
      ]
    },
    {
      "id": "A8",
      "name": "BranchDisplay",
      "type": "dom_element",
      "semantic": "Text showing branch count",
      "locator_hints": [
        "#branch-display"
      ]
    },
    {
      "id": "A9",
      "name": "LeafDisplay",
      "type": "dom_element",
      "semantic": "Text showing leaf count",
      "locator_hints": [
        "#leaf-display"
      ]
    },
    {
      "id": "A10",
      "name": "SaveStatus",
      "type": "dom_element",
      "semantic": "Status text showing save confirmation",
      "locator_hints": [
        "#save-status"
      ]
    },
    {
      "id": "A11",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Green ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry 20x20 at y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Gen0",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.branchCount === 1",
        "window.__3D_STATE__.leafCount === 0",
        "window.__3D_STATE__.isAnimating === false",
        "window.__3D_STATE__.canGrow === true"
      ]
    },
    {
      "id": "S1",
      "name": "Gen1_Grown",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.branchCount > 1",
        "window.__3D_STATE__.leafCount === 0",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S2",
      "name": "Gen2_WithLeaves",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.leafCount > 0",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S3",
      "name": "Gen3_Complex",
      "conditions": [
        "window.__3D_STATE__.generation === 3",
        "window.__3D_STATE__.branchCount > window.__3D_STATE__.leafCount",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S4",
      "name": "State_Saved",
      "conditions": [
        "window.__3D_STATE__.savedData !== null",
        "window.__3D_STATE__.savedData.generation === window.__3D_STATE__.generation"
      ]
    },
    {
      "id": "S5",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.branchCount === 1",
        "window.__3D_STATE__.leafCount === 0"
      ]
    },
    {
      "id": "S6",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.generation === window.__3D_STATE__.savedData.generation",
        "window.__3D_STATE__.isAnimating === false"
      ]
    },
    {
      "id": "S7",
      "name": "Animating",
      "conditions": [
        "window.__3D_STATE__.isAnimating === true",
        "window.__3D_STATE__.canGrow === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-grow"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-grow').click(); await new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gen-display').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-save"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedData !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedData.generation === 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedData.cameraPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedData.cameraPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedData.timestamp === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gen-display').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-load"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gen-display').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedData !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('leaf-display').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}