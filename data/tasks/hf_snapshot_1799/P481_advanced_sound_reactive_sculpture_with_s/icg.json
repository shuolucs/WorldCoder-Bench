  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.beats === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.mode === 1",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.pillarCount === 64"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.avgFrequency >= 0 && window.__3D_STATE__.avgFrequency <= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Mode2Active",
      "conditions": [
        "window.__3D_STATE__.mode === 2"
      ]
    },
    {
      "id": "S3",
      "name": "Mode3Active",
      "conditions": [
        "window.__3D_STATE__.mode === 3"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "BeatsDetected",
      "conditions": [
        "window.__3D_STATE__.beats > 0"
      ]
    },
    {
      "id": "S7",
      "name": "ScoreIncreased",
      "conditions": [
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.beats === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.mode === 1"
      ]
    },
    {
      "id": "S9",
      "name": "Mode1Restored",
      "conditions": [
        "window.__3D_STATE__.mode === 1"
      ]
    }
  ],
  "transitions": [
