        "code": "const waitForBeat = () => new Promise(resolve => { const check = setInterval(() => { if(window.__3D_STATE__.inBeatWindow) { clearInterval(check); document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', keyCode: 32})); resolve(); }}, 16); setTimeout(() => { clearInterval(check); resolve(); }, 8000); }); await waitForBeat();"
      },
