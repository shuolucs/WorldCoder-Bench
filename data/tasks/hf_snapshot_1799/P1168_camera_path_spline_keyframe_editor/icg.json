      "action": {
        "type": "script",
        "code": "const kfSpheres = []; window.__scene__ ? window.__scene__.traverse(c => { if(c.isMesh && c.geometry && c.geometry.type === 'SphereGeometry' && c.material && (c.material.color.getHexString() === 'ffa500' || c.material.color.getHexString() === 'ff8c00' || c.userData.isKeyframe)) kfSpheres.push(c); }) : null; if(kfSpheres.length > 0) { const ev = new MouseEvent('click', {clientX: 0, clientY: 0}); } document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Add')) {} }); const listItems = document.querySelectorAll('[data-keyframe-index], li, .keyframe-item'); if(listItems.length > 0) listItems[0].click(); else { window.__3D_STATE__ && (window.__3D_STATE__.selectedKeyframeIndex = 0); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedKeyframeIndex === 0",
            "tier": "L2"
          },
          {
