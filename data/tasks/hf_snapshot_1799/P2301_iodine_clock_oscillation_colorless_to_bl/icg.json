{
  "task_id": "P2301_iodine_clock_oscillation_colorless_to_bl",
  "affordances": [
    {
      "id": "A1",
      "name": "Beaker",
      "type": "3d_object",
      "semantic": "Transparent cylindrical beaker containing the reaction liquid",
      "locator_hints": [
        "CylinderGeometry with transmission material",
        "center of scene"
      ]
    },
    {
      "id": "A2",
      "name": "Liquid",
      "type": "3d_object",
      "semantic": "Inner cylinder representing oscillating liquid whose color changes",
      "locator_hints": [
        "smaller cylinder inside beaker",
        "color-animated material"
      ]
    },
    {
      "id": "A3",
      "name": "StirBar",
      "type": "3d_object",
      "semantic": "Magnetic stir bar capsule rotating at bottom of beaker",
      "locator_hints": [
        "CapsuleGeometry",
        "rotating around Y axis"
      ]
    },
    {
      "id": "A4",
      "name": "StirPlate",
      "type": "3d_object",
      "semantic": "Stir plate beneath beaker with green LED indicator",
      "locator_hints": [
        "flat cylinder below beaker",
        "gray colored"
      ]
    },
    {
      "id": "A5",
      "name": "StartResetButton",
      "type": "dom_element",
      "semantic": "Button to start or reset the reaction",
      "locator_hints": [
        "button text 'Start Reaction' or 'Reset Reaction'"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleStirrerButton",
      "type": "dom_element",
      "semantic": "Button to toggle magnetic stirrer on/off",
      "locator_hints": [
        "button text 'Toggle Stirrer'"
      ]
    },
    {
      "id": "A7",
      "name": "TimerDisplay",
      "type": "dom_element",
      "semantic": "Digital timer showing elapsed time in MM:SS",
      "locator_hints": [
        "top-right corner DOM overlay"
      ]
    },
    {
      "id": "A8",
      "name": "TemperatureReadout",
      "type": "dom_element",
      "semantic": "DOM element showing current temperature in °C",
      "locator_hints": [
        "temperature display"
      ]
    },
    {
      "id": "A9",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Overlay panel toggled by clicking beaker showing phase, cycle, temp",
      "locator_hints": [
        "info overlay panel",
        "toggled by raycasting click on beaker"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === false",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.currentPhase === 'amber'",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.temperature === 25"
      ]
    },
    {
      "id": "S1",
      "name": "Reaction_Running_Amber",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === true",
        "window.__3D_STATE__.stirrerActive === true",
        "window.__3D_STATE__.currentPhase === 'amber'",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Reaction_Running_Blue",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === true",
        "window.__3D_STATE__.currentPhase === 'blue'",
        "window.__3D_STATE__.cycleCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "Reaction_Paused_StirrerOff",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === true",
        "window.__3D_STATE__.stirrerActive === false"
      ]
    },
    {
      "id": "S4",
      "name": "Temperature_Modified",
      "conditions": [
        "window.__3D_STATE__.temperature !== 25"
      ]
    },
    {
      "id": "S5",
      "name": "Info_Panel_Visible",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "Reaction_Reset",
      "conditions": [
        "window.__3D_STATE__.reactionStarted === false",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Start Reaction"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reactionStarted === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reactionStarted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPhase === 'amber'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stirrerActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cycleCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPhase === 'blue' || window.__3D_STATE__.currentPhase === 'transition_to_amber' || window.__3D_STATE__.currentPhase === 'amber'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 4.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.liquidColorHex === 'string' && window.__3D_STATE__.liquidColorHex.startsWith('#')",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stirBarRotation) && window.__3D_STATE__.stirBarRotation !== 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Toggle Stirrer"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stirrerActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionStarted === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.phaseTimer === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const frozenTime = window.__3D_STATE__.elapsedTime; window.__frozenTime = frozenTime; document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Toggle Stirrer')) b.click(); });"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stirrerActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionStarted === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stirBarRotation === 'number' && !isNaN(window.__3D_STATE__.stirBarRotation)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.oscillationPeriod > 0 && !isNaN(window.__3D_STATE__.oscillationPeriod)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "count": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 31",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 10 && window.__3D_STATE__.temperature <= 45",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.oscillationPeriod - 4.8) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oscillationPeriod > 0 && window.__3D_STATE__.oscillationPeriod < 10",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.oscillationPeriod === 'number' && !isNaN(window.__3D_STATE__.oscillationPeriod)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target": "Beaker",
        "position_hint": "center of scene"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.infoPanelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentPhase === 'string'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cycleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "['amber', 'blue', 'transition_to_blue', 'transition_to_amber'].includes(window.__3D_STATE__.currentPhase)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S1",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactionStarted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cycleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPhase === 'amber'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseTimer === 0 || window.__3D_STATE__.phaseTimer === undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown",
        "count": 5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.oscillationPeriod - 9.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionStarted === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}