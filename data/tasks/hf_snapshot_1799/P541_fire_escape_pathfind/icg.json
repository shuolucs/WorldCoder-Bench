{
  "task_id": "P541_fire_escape_pathfind",
  "affordances": [
    {"id": "A1", "name": "Environment", "type": "3d_object", "semantic": "Loaded collision-world.glb building", "locator_hints": ["GLTF scene"]},
    {"id": "A2", "name": "Agent", "type": "3d_object", "semantic": "Green sphere agent", "locator_hints": ["sphere mesh green"]},
    {"id": "A3", "name": "Fire", "type": "3d_object", "semantic": "Fire particles and red floor cells", "locator_hints": ["particle system", "red planes"]},
    {"id": "A4", "name": "Exit", "type": "3d_object", "semantic": "Green glowing exit ring", "locator_hints": ["torus mesh green"]},
    {"id": "A5", "name": "FireSpeedSlider", "type": "dom_element", "semantic": "Fire speed control", "locator_hints": ["#slider-fire-speed"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Idle", "conditions": ["window.__3D_STATE__.status === 'Idle'"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.status === 'Running'"]},
    {"id": "S2", "name": "FireSpreading", "conditions": ["window.__3D_STATE__.fireCellCount > 10"]},
    {"id": "S3", "name": "AgentMoving", "conditions": ["window.__3D_STATE__.distToExit < before.distToExit"]},
    {"id": "S4", "name": "Completed", "conditions": ["window.__3D_STATE__.status === 'Escaped' || window.__3D_STATE__.status === 'Dead'"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.status === 'Idle'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.health === 100", "tier": "L1"},
        {"expr": "window.__3D_STATE__.agentValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "g"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Running'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.pathLength > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.fireCellCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.distToExit < before.distToExit || window.__3D_STATE__.distToExit <= before.distToExit", "tier": "L1"},
        {"expr": "window.__3D_STATE__.agentValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-fire-speed').value = 0.8; document.getElementById('slider-fire-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.fireSpeed >= 0.7", "tier": "L2"},
        {"expr": "window.__3D_STATE__.agentValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Idle'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.health === 100", "tier": "L1"},
        {"expr": "window.__3D_STATE__.fireCellCount === 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S2", "to": "S2", "severity": "P1",
      "action": {"type": "wait", "duration_ms": 300},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "document.getElementById('hud-fire') !== null", "tier": "L2"},
        {"expr": "document.getElementById('hud-health') !== null", "tier": "L2"}
      ]}
    }
  ]
}
