{
  "task_id": "P532_rigid_body_stacking",
  "affordances": [
    {"id": "A1", "name": "BoxStack", "type": "3d_object", "semantic": "Stack of rigid body boxes", "locator_hints": ["box meshes in scene"]},
    {"id": "A2", "name": "Ground", "type": "3d_object", "semantic": "Ground plane", "locator_hints": ["plane mesh at y=0"]},
    {"id": "A3", "name": "RestitutionSlider", "type": "dom_element", "semantic": "Slider for restitution coefficient", "locator_hints": ["#slider-restitution"]},
    {"id": "A4", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial_Stacked", "conditions": ["window.__3D_STATE__.boxCount === 6", "window.__3D_STATE__.isPaused === true", "window.__3D_STATE__.isToppled === false"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S2", "name": "Toppling", "conditions": ["window.__3D_STATE__.totalKineticEnergy > 0.1"]},
    {"id": "S3", "name": "Settled", "conditions": ["window.__3D_STATE__.isToppled === true"]},
    {"id": "S4", "name": "BoxAdded", "conditions": ["window.__3D_STATE__.boxCount > 6"]},
    {"id": "S5", "name": "Reset", "conditions": ["window.__3D_STATE__.boxCount === 6", "window.__3D_STATE__.isToppled === false"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.boxCount === 6", "tier": "L2"},
        {"expr": "window.__3D_STATE__.maxHeight >= 10", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"},
        {"expr": "window.__3D_STATE__.boxesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Running')", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalKineticEnergy > before.totalKineticEnergy", "tier": "L1"},
        {"expr": "window.__3D_STATE__.boxesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isToppled === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.collisionCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.maxHeight < before.maxHeight", "tier": "L1"},
        {"expr": "document.getElementById('hud-toppled').textContent.includes('Yes')", "tier": "L2"},
        {"expr": "window.__3D_STATE__.boxesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "a"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.boxCount === before.boxCount + 1", "tier": "L1"},
        {"expr": "document.getElementById('hud-boxes').textContent.includes(String(window.__3D_STATE__.boxCount))", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S5", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.boxCount === 6", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isToppled === false", "tier": "L2"},
        {"expr": "window.__3D_STATE__.collisionCount === 0 || window.__3D_STATE__.collisionCount < before.collisionCount", "tier": "L1"}
      ]}
    },
    {
      "id": "T7", "from": "S5", "to": "S5", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-restitution').value = 0.8; document.getElementById('slider-restitution').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.restitution === 0.8", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()", "tier": "L0"}
      ]}
    }
  ]
}
