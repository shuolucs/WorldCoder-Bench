{
  "task_id": "P296_multiplayer_brain_connectivity_map",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "Central brain/neural hub model loaded from GLB",
      "locator_hints": [
        "helmet at origin",
        "GLTF model scaled 1.5"
      ]
    },
    {
      "id": "A2",
      "name": "ConnectivityNodes",
      "type": "3d_object",
      "semantic": "12 glowing spheres representing brain connectivity nodes",
      "locator_hints": [
        "spheres around helmet",
        "radius ~2.5 from center"
      ]
    },
    {
      "id": "A3",
      "name": "ConnectionLines",
      "type": "3d_object",
      "semantic": "Lines connecting nodes",
      "locator_hints": [
        "THREE.Line objects between nodes"
      ]
    },
    {
      "id": "A4",
      "name": "PlayerFilterButtons",
      "type": "dom_element",
      "semantic": "4 buttons to toggle player visibility",
      "locator_hints": [
        "buttons labeled P1-P4",
        "top-left position"
      ]
    },
    {
      "id": "A5",
      "name": "ConnectionCountHUD",
      "type": "dom_element",
      "semantic": "HUD showing total connection count",
      "locator_hints": [
        "top-right",
        "text contains 'Connections:'"
      ]
    },
    {
      "id": "A6",
      "name": "SelectedNodeHUD",
      "type": "dom_element",
      "semantic": "HUD showing selected node ID",
      "locator_hints": [
        "top-right below connections",
        "text contains 'Selected:'"
      ]
    },
    {
      "id": "A7",
      "name": "ModeDisplay",
      "type": "dom_element",
      "semantic": "Bottom-center mode text",
      "locator_hints": [
        "bottom-center",
        "'Normal' or 'Heatmap'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.nodeCount === 12",
        "window.__3D_STATE__.connectionCount === 12",
        "window.__3D_STATE__.selectedNodeId === null",
        "window.__3D_STATE__.autoRotating === false",
        "window.__3D_STATE__.heatmapMode === false",
        "window.__3D_STATE__.visibleNodeCount === 12"
      ]
    },
    {
      "id": "S1",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId !== null",
        "window.__3D_STATE__.selectedNodeId >= 0 && window.__3D_STATE__.selectedNodeId <= 11"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerFiltered",
      "conditions": [
        "window.__3D_STATE__.playerVisibility.some(v => v === false)",
        "window.__3D_STATE__.visibleNodeCount < 12"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.autoRotating === true"
      ]
    },
    {
      "id": "S4",
      "name": "HeatmapActive",
      "conditions": [
        "window.__3D_STATE__.heatmapMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "ConnectionModified",
      "conditions": [
        "window.__3D_STATE__.connectionCount !== 12"
      ]
    },
    {
      "id": "S6",
      "name": "PulseTriggered",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "NodeDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeId === null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(0, 0); raycaster.setFromCamera(mouse, window.__camera || document.querySelector('canvas').__scene_camera); /* Simulate click on first node */ const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:first-of-type",
        "description": "Click P1 filter button to hide Player 1 nodes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button:first-of-type",
        "description": "Click P1 filter button again to restore Player 1 nodes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to toggle auto-rotation of node network"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R again to stop auto-rotation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h",
        "description": "Press H to toggle heatmap mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "p",
        "description": "Press P to trigger pulse animation on connections and nodes"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}