{
  "task_id": "P530_elastic_beam_bending",
  "affordances": [
    {"id": "A1", "name": "BeamSegments", "type": "3d_object", "semantic": "20 connected box segments forming the cantilever beam", "locator_hints": ["scene children box meshes"]},
    {"id": "A2", "name": "ForceArrow", "type": "3d_object", "semantic": "Red arrow showing applied force at beam tip", "locator_hints": ["ArrowHelper in scene"]},
    {"id": "A3", "name": "TipMarker", "type": "3d_object", "semantic": "Green sphere at beam tip", "locator_hints": ["sphere mesh at beam end"]},
    {"id": "A4", "name": "ForceSlider", "type": "dom_element", "semantic": "Slider controlling applied force", "locator_hints": ["#slider-force"]},
    {"id": "A5", "name": "ESlider", "type": "dom_element", "semantic": "Slider controlling Young's modulus", "locator_hints": ["#slider-E"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel showing beam state", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.force === 10", "window.__3D_STATE__.youngModulus === 20000", "window.__3D_STATE__.segmentCount === 20"]},
    {"id": "S1", "name": "ForceIncreased", "conditions": ["window.__3D_STATE__.force > 10"]},
    {"id": "S2", "name": "EChanged", "conditions": ["window.__3D_STATE__.youngModulus !== 20000"]},
    {"id": "S3", "name": "MaxForce", "conditions": ["window.__3D_STATE__.force === 50"]},
    {"id": "S4", "name": "ResetState", "conditions": ["window.__3D_STATE__.isReset === true"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.segmentCount === 20", "tier": "L1"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.tipDeflection !== undefined && !isNaN(s.tipDeflection); })()", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-force').value = 30; document.getElementById('slider-force').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.force === 30", "tier": "L2"},
        {"expr": "window.__3D_STATE__.tipDeflection > before.tipDeflection", "tier": "L1"},
        {"expr": "document.getElementById('hud-force').textContent.includes('30')", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const F=30; const L=10; const E=20000; const I=0.00225; const expected = F*L*L*L/(3*E*I); return Math.abs(s.tipDeflection - expected)/expected < 0.1; })()", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-E').value = 50000; document.getElementById('slider-E').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.youngModulus === 50000", "tier": "L2"},
        {"expr": "window.__3D_STATE__.tipDeflection < before.tipDeflection", "tier": "L1"},
        {"expr": "document.getElementById('hud-E').textContent.includes('50000')", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-force').value = 50; document.getElementById('slider-force').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.force === 50", "tier": "L2"},
        {"expr": "window.__3D_STATE__.tipDeflection > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.maxStress > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.barsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.force === 10", "tier": "L2"},
        {"expr": "window.__3D_STATE__.youngModulus === 20000", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isReset === true", "tier": "L2"},
        {"expr": "window.__3D_STATE__.tipDeflection < before.tipDeflection", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "wait", "duration_ms": 300},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.tipPosition && typeof s.tipPosition.x === 'number' && typeof s.tipPosition.y === 'number'; })()", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()", "tier": "L0"}
      ]}
    }
  ]
}
