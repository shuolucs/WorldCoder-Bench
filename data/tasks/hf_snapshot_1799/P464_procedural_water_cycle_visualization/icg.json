{
  "task_id": "P464_procedural_water_cycle_visualization",
  "affordances": [
    {
      "id": "A1",
      "name": "WaterBody",
      "type": "3d_object",
      "semantic": "Blue lake surface where evaporation begins",
      "locator_hints": [
        "position.x ~ -5",
        "position.z ~ 5",
        "blue material"
      ]
    },
    {
      "id": "A2",
      "name": "Mountain",
      "type": "3d_object",
      "semantic": "Gray cone mountain in the background",
      "locator_hints": [
        "ConeGeometry",
        "position.x ~ 10"
      ]
    },
    {
      "id": "A3",
      "name": "NefertitiBust",
      "type": "3d_object",
      "semantic": "Loaded GLB model of Nefertiti bust",
      "locator_hints": [
        "position (8, 0, 8)",
        "scale 0.05"
      ]
    },
    {
      "id": "A4",
      "name": "WaterParticles",
      "type": "3d_object",
      "semantic": "Sphere particles representing water molecules",
      "locator_hints": [
        "radius 0.1",
        "50 particles"
      ]
    },
    {
      "id": "A5",
      "name": "NextPhaseButton",
      "type": "dom_element",
      "semantic": "Button to advance to next phase",
      "locator_hints": [
        "#btn-next"
      ]
    },
    {
      "id": "A6",
      "name": "PrevPhaseButton",
      "type": "dom_element",
      "semantic": "Button to go to previous phase",
      "locator_hints": [
        "#btn-prev"
      ]
    },
    {
      "id": "A7",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggle auto-advance play/pause",
      "locator_hints": [
        "#btn-playpause"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A9",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A10",
      "name": "PhaseHUD",
      "type": "dom_element",
      "semantic": "Displays current phase name",
      "locator_hints": [
        "#hud-phase"
      ]
    },
    {
      "id": "A11",
      "name": "CycleCountHUD",
      "type": "dom_element",
      "semantic": "Displays completed cycle count",
      "locator_hints": [
        "#hud-cycle-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEvaporation",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.cycleCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "CondensationPhase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Condensation'"
      ]
    },
    {
      "id": "S3",
      "name": "PrecipitationPhase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Precipitation'"
      ]
    },
    {
      "id": "S4",
      "name": "CollectionPhase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'Collection'"
      ]
    },
    {
      "id": "S5",
      "name": "InfiltrationPhase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseName === 'Infiltration'"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedModified",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "CycleCompleted",
      "conditions": [
        "window.__3D_STATE__.cycleCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.cycleCount === 0",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S9",
      "name": "DirectPhaseJump",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Evaporation'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nefertitiLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0 && window.__3D_STATE__.particleCount <= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-playpause').textContent.trim() === 'Play'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameInPhase === 'number' && !isNaN(window.__3D_STATE__.frameInPhase)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgParticleY === 'number' && !isNaN(window.__3D_STATE__.avgParticleY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Condensation'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-phase').textContent.includes('Condensation')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseHistory.includes(1)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Precipitation'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-phase').textContent.includes('Precipitation')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameInPhase >= 0 && window.__3D_STATE__.frameInPhase < 300",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Collection'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-phase').textContent.includes('Collection')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Infiltration'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-phase').textContent.includes('Infiltration')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.groundwaterParticles === 'number' && window.__3D_STATE__.groundwaterParticles >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-speed').value = 2.0; document.getElementById('slider-speed').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.speedMultiplier - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgParticleY === 'number' && !isNaN(window.__3D_STATE__.avgParticleY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Collection'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseHistory.includes(3)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameInPhase >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phaseName === 'Evaporation'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cycleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameInPhase === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-prev"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase === 4 || window.__3D_STATE__.currentPhase === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount >= 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgParticleY === 'number' && !isNaN(window.__3D_STATE__.avgParticleY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nefertitiLoaded === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}