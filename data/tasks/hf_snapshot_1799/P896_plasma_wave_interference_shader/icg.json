{
  "task_id": "P896_plasma_wave_interference_shader",
  "affordances": [
    {
      "id": "A1",
      "name": "PlasmaQuad",
      "type": "3d_object",
      "semantic": "Full-screen quad displaying the plasma wave interference shader",
      "locator_hints": [
        "scene.children mesh with PlaneGeometry"
      ]
    },
    {
      "id": "A2",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing current shader parameters",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A3",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "WebGL canvas for click interactions to reposition wave sources",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.shaderCompiled === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.selectedSource === 1",
        "window.__3D_STATE__.frequencies[0] === 8.0",
        "window.__3D_STATE__.amplitudes[0] === 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S2",
      "name": "Source2Selected",
      "conditions": [
        "window.__3D_STATE__.selectedSource === 2"
      ]
    },
    {
      "id": "S3",
      "name": "FrequencyModified",
      "conditions": [
        "window.__3D_STATE__.frequencies[1] !== 12.0"
      ]
    },
    {
      "id": "S4",
      "name": "SourceMoved",
      "conditions": [
        "window.__3D_STATE__.sources[1].x !== 0.7 || window.__3D_STATE__.sources[1].y !== 0.6"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "AmplitudeToggled",
      "conditions": [
        "window.__3D_STATE__.amplitudes[1] !== 0.8"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.frequencies[0] === 8.0",
        "window.__3D_STATE__.frequencies[1] === 12.0",
        "window.__3D_STATE__.frequencies[2] === 10.0",
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.time === 'number' && !isNaN(window.__3D_STATE__.time) && window.__3D_STATE__.time > 0",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.sources) && window.__3D_STATE__.sources.length === 3",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.frequencies) && window.__3D_STATE__.frequencies.length === 3 && window.__3D_STATE__.frequencies[0] === 8.0 && window.__3D_STATE__.frequencies[1] === 12.0 && window.__3D_STATE__.frequencies[2] === 10.0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "(() => { const t = window.__3D_STATE__.time; return typeof t === 'number' && !isNaN(t); })()",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('yes')",
            "tier": "L2"
          },
          {
            "expr": "(() => { const t1 = window.__3D_STATE__.time; return new Promise(r => setTimeout(() => r(Math.abs(window.__3D_STATE__.time - t1) < 0.001), 500)); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSource === 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frequencies[1] === 'number' && window.__3D_STATE__.frequencies[1] === 12.0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frequencies[1] === 13.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSource === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies[0] === 8.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frequencies[2] === 10.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('13')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x_ratio": 0.5,
        "y_ratio": 0.5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.sources[1].x - 0.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sources[1].y - 0.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[0].x === 0.3 && window.__3D_STATE__.sources[0].y === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[2].x === 0.5 && window.__3D_STATE__.sources[2].y === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSource === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speed === 1.25",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.speed === 'number' && !isNaN(window.__3D_STATE__.speed)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.speed >= 0.25 && window.__3D_STATE__.speed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('1.25')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.amplitudes[1] !== 0.8",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.amplitudeCycleIndex) && window.__3D_STATE__.amplitudeCycleIndex.length === 3",
            "tier": "L0"
          },
          {
            "expr": "[0.0, 0.3, 0.6, 0.8, 1.0].includes(window.__3D_STATE__.amplitudes[1])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitudes[0] === 1.0 && window.__3D_STATE__.amplitudes[2] === 0.6",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frequencies[0] === 8.0 && window.__3D_STATE__.frequencies[1] === 12.0 && window.__3D_STATE__.frequencies[2] === 10.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitudes[0] === 1.0 && window.__3D_STATE__.amplitudes[1] === 0.8 && window.__3D_STATE__.amplitudes[2] === 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sources[0].x - 0.3) < 0.01 && Math.abs(window.__3D_STATE__.sources[1].x - 0.7) < 0.01 && Math.abs(window.__3D_STATE__.sources[2].x - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time < 0.1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}