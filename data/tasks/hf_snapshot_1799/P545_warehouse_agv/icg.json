{
  "task_id": "P545_warehouse_agv",
  "affordances": [
    {"id": "A1", "name": "Warehouse", "type": "3d_object", "semantic": "Grid floor, shelving racks, stations", "locator_hints": ["floor plane", "box meshes"]},
    {"id": "A2", "name": "AGVs", "type": "3d_object", "semantic": "4 colored cylinder AGV robots", "locator_hints": ["cylinder meshes"]},
    {"id": "A3", "name": "CargoBoxes", "type": "3d_object", "semantic": "GLB cargo boxes at stations or on AGVs", "locator_hints": ["GLTF models"]},
    {"id": "A4", "name": "AGVSpeedSlider", "type": "dom_element", "semantic": "AGV speed control", "locator_hints": ["#slider-agv-speed"]},
    {"id": "A5", "name": "AGVCountSlider", "type": "dom_element", "semantic": "Active AGV count", "locator_hints": ["#slider-agv-count"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.activeAGVs >= 1", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "AGVsMoving", "conditions": ["window.__3D_STATE__.frameCount > 30"]},
    {"id": "S2", "name": "DeliveryMade", "conditions": ["window.__3D_STATE__.totalDeliveries > 0"]},
    {"id": "S3", "name": "SpeedChanged", "conditions": ["window.__3D_STATE__.agvSpeed !== 3"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.totalDeliveries === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.activeAGVs >= 1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.agvsValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 15000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalDeliveries >= 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.agvsValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.collisionsAvoided >= 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-agv-speed').value = 7; document.getElementById('slider-agv-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.agvSpeed >= 6", "tier": "L2"},
        {"expr": "document.getElementById('hud-agvs') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-agv-count').value = 2; document.getElementById('slider-agv-count').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.activeAGVs <= 2", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalDeliveries === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.agvsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Paused')", "tier": "L2"}
      ]}
    }
  ]
}
