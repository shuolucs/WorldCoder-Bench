{
  "task_id": "P343_car_paint_visualizer",
  "affordances": [
    {
      "id": "A1",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "The horse.glb model serving as the paint visualization target",
      "locator_hints": [
        "loaded GLTF model",
        "centered on ground plane"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Reflective circular ground plane beneath the model",
      "locator_hints": [
        "circular mesh at y=0"
      ]
    },
    {
      "id": "A3",
      "name": "PaintButton0",
      "type": "dom_element",
      "semantic": "Midnight Black paint selector button",
      "locator_hints": [
        "#paint-btn-0"
      ]
    },
    {
      "id": "A4",
      "name": "PaintButton1",
      "type": "dom_element",
      "semantic": "Racing Red paint selector button",
      "locator_hints": [
        "#paint-btn-1"
      ]
    },
    {
      "id": "A5",
      "name": "PaintButton3",
      "type": "dom_element",
      "semantic": "Electric Blue paint selector button",
      "locator_hints": [
        "#paint-btn-3"
      ]
    },
    {
      "id": "A6",
      "name": "PaintNameLabel",
      "type": "dom_element",
      "semantic": "Label showing current paint name",
      "locator_hints": [
        "#paint-name-label"
      ]
    },
    {
      "id": "A7",
      "name": "AutoRotateToggle",
      "type": "dom_element",
      "semantic": "Checkbox to toggle auto-rotation",
      "locator_hints": [
        "#auto-rotate-toggle"
      ]
    },
    {
      "id": "A8",
      "name": "RoughnessSlider",
      "type": "dom_element",
      "semantic": "Slider to override roughness value",
      "locator_hints": [
        "#roughness-slider"
      ]
    },
    {
      "id": "A9",
      "name": "PaintButton5",
      "type": "dom_element",
      "semantic": "Sunset Orange paint selector button",
      "locator_hints": [
        "#paint-btn-5"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_DefaultPaint",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentPaintIndex === 0",
        "window.__3D_STATE__.currentPaintName === 'Midnight Black'"
      ]
    },
    {
      "id": "S1",
      "name": "RacingRedSelected",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 1",
        "window.__3D_STATE__.currentPaintName === 'Racing Red'"
      ]
    },
    {
      "id": "S2",
      "name": "AutoRotateDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRotateReEnabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S4",
      "name": "RoughnessOverridden",
      "conditions": [
        "window.__3D_STATE__.materialRoughness >= 0.49 && window.__3D_STATE__.materialRoughness <= 0.51"
      ]
    },
    {
      "id": "S5",
      "name": "ElectricBlueViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 3",
        "window.__3D_STATE__.currentPaintName === 'Electric Blue'"
      ]
    },
    {
      "id": "S6",
      "name": "SunsetOrangeSelected",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 5",
        "window.__3D_STATE__.currentPaintName === 'Sunset Orange'"
      ]
    },
    {
      "id": "S7",
      "name": "BackToMidnightBlack",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 0",
        "window.__3D_STATE__.currentPaintName === 'Midnight Black'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor === '#0a0a0a'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.85 && window.__3D_STATE__.materialMetalness <= 0.95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paintButtonCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundPlaneExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#paint-btn-1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Racing Red'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor === '#cc0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.65 && window.__3D_STATE__.materialMetalness <= 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialClearcoat >= 0.85 && window.__3D_STATE__.materialClearcoat <= 0.95",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#auto-rotate-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#auto-rotate-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('roughness-slider').value = 50; document.getElementById('roughness-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roughnessSliderValue === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialRoughness >= 0.49 && window.__3D_STATE__.materialRoughness <= 0.51",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.65 && window.__3D_STATE__.materialMetalness <= 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Electric Blue'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor === '#0044cc'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.75 && window.__3D_STATE__.materialMetalness <= 0.85",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialClearcoat >= 0.95 && window.__3D_STATE__.materialClearcoat <= 1.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#paint-btn-5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Sunset Orange'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor === '#ff6600'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.65 && window.__3D_STATE__.materialMetalness <= 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialClearcoat >= 0.85 && window.__3D_STATE__.materialClearcoat <= 0.95",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Midnight Black'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor === '#0a0a0a'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0.85 && window.__3D_STATE__.materialMetalness <= 0.95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialRoughness >= 0.0 && window.__3D_STATE__.materialRoughness <= 1.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}