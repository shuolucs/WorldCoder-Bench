  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.animating === true",
        "window.__3D_STATE__.intensity === 0.7",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.curtainVisible === true",
        "window.__3D_STATE__.groundVisible === true",
        "window.__3D_STATE__.cameraZ === 8",
        "window.__3D_STATE__.starCount === 500"
      ]
    },
    {
      "id": "S1",
      "name": "IntensityIncreased",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.8"
      ]
    },
    {
