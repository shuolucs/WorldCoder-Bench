      ]
    },
    {
      "id": "S7",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1.25"
      ]
    },
    {
      "id": "S8",
      "name": "LayersAdded",
      "conditions": [
        "window.__3D_STATE__.layerCount === 2"
      ]
    },
    {
      "id": "S9",
      "name": "CameraMovedForward",
      "conditions": [
        "window.__3D_STATE__.cameraZ === 7.5"
      ]
    },
    {
      "id": "S10",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.intensity === 0.7",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.layerCount === 1",
        "window.__3D_STATE__.cameraZ === 8"
      ]
    }
  ],
