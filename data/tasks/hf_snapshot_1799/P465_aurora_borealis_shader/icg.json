      "conditions": [
        "window.__3D_STATE__.colorMode === 1"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.animating === true"
      ]
    },
    {
      "id": "S6",
      "name": "GroundHidden",
