{
  "task_id": "P500_procedural_city_builder_with_physics_deb",
  "affordances": [
    {
      "id": "A1",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "80x80 ground plane for city building grid",
      "locator_hints": [
        "mesh at y=0",
        "color #1a1a2e"
      ]
    },
    {
      "id": "A2",
      "name": "GhostPreview",
      "type": "3d_object",
      "semantic": "Semi-transparent building preview following mouse",
      "locator_hints": [
        "opacity 0.3",
        "snaps to grid cells"
      ]
    },
    {
      "id": "A3",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing building stats",
      "locator_hints": [
        "id='stats-panel'"
      ]
    },
    {
      "id": "A4",
      "name": "DebugPanel",
      "type": "dom_element",
      "semantic": "Top-right debug HUD showing physics info",
      "locator_hints": [
        "id='debug-panel'"
      ]
    },
    {
      "id": "A5",
      "name": "PlacedBuildings",
      "type": "3d_object",
      "semantic": "Buildings placed on the grid",
      "locator_hints": [
        "box or cylinder meshes on ground"
      ]
    },
    {
      "id": "A6",
      "name": "DebugWireframes",
      "type": "3d_object",
      "semantic": "Red wireframe bounding boxes for debug overlay",
      "locator_hints": [
        "color #ff0000",
        "wireframe"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_City",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 0",
        "window.__3D_STATE__.selectedTool === 'none'",
        "window.__3D_STATE__.totalMass === 0",
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.demolishMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "Residential_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedTool === 'residential'"
      ]
    },
    {
      "id": "S2",
      "name": "First_Building_Placed",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 1",
        "window.__3D_STATE__.lastPlacedId === 1",
        "window.__3D_STATE__.buildings.length === 1",
        "window.__3D_STATE__.buildings[0].type === 'residential'"
      ]
    },
    {
      "id": "S3",
      "name": "Building_Grounded",
      "conditions": [
        "window.__3D_STATE__.buildings.length >= 1",
        "window.__3D_STATE__.buildings[0].grounded === true"
      ]
    },
    {
      "id": "S4",
      "name": "Commercial_Added",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 2",
        "window.__3D_STATE__.buildings.some(b => b.type === 'commercial')"
      ]
    },
    {
      "id": "S5",
      "name": "Debug_Overlay_Active",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "Park_Added",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 3",
        "window.__3D_STATE__.buildings.some(b => b.type === 'park')"
      ]
    },
    {
      "id": "S7",
      "name": "Demolish_Mode_Active",
      "conditions": [
        "window.__3D_STATE__.demolishMode === true",
        "window.__3D_STATE__.selectedTool === 'demolish'"
      ]
    },
    {
      "id": "S8",
      "name": "Building_Demolished",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 2",
        "window.__3D_STATE__.lastDemolishedId > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Debug_Overlay_Disabled",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.buildingCount === 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.45,
          "y": 0.55
        },
        "description": "Click on a grid cell to place a residential building"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000,
        "description": "Wait for building to fall and come to rest via gravity and bouncing"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '2'})); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', {clientX: rect.left + rect.width * 0.55, clientY: rect.top + rect.height * 0.45}); canvas.dispatchEvent(evt); }, 200);",
        "description": "Select commercial tool and click to place a commercial building on a different cell"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
