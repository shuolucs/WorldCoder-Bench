        "bodyColor=#1a1a2e, materialType=glossy, screenContent=off"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bodyColor === '#1a1a2e'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialType === 'glossy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.screenContent === 'off'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraBump === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.environment === 'studio'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.annotationCount === 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.modelCenter.x) && isFinite(window.__3D_STATE__.modelCenter.y) && isFinite(window.__3D_STATE__.modelCenter.z)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.annotationCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ var container = document.getElementById('bodyColor'); if(!container) return; var btns = container.querySelectorAll('button, [data-color], option'); if(container.tagName === 'SELECT'){ container.selectedIndex = 2; container.dispatchEvent(new Event('change',{bubbles:true})); } else if(btns.length >= 3) { btns[2].click(); } })()",
        "wait_ms": 500
      },
      "postconditions": [
        "bodyColor 已改变"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bodyColor !== '#1a1a2e'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialType === 'glossy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.screenContent === 'off'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bodyColor !== before.bodyColor",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var changed=false; var keys=Object.keys(window.__3D_STATE__); for(var i=0;i<keys.length;i++){ var k=keys[i]; if(JSON.stringify(window.__3D_STATE__[k])!==JSON.stringify(before[k])){ changed=true; break; }} return changed; })()",
            "tier": "L2"
          }
        ]
      }
    },
