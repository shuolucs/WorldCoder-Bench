  "states": [
    {
      "id": "S0",
      "name": "Loading",
      "conditions": [
        "window.__3D_STATE__.foxLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "InitialRunning",
      "conditions": [
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.rotationSpeed === 0.3",
        "window.__3D_STATE__.colorTheme === 'rainbow'",
        "window.__3D_STATE__.mirrorMode === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed !== 0.3",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S4",
      "name": "ThemeChanged",
      "conditions": [
        "window.__3D_STATE__.colorTheme !== 'rainbow'"
      ]
    },
    {
      "id": "S5",
      "name": "BurstTriggered",
      "conditions": [
        "window.__3D_STATE__.burstCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "MirrorEnabled",
      "conditions": [
        "window.__3D_STATE__.mirrorMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.rotationSpeed === 0.3",
        "window.__3D_STATE__.colorTheme === 'rainbow'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.mirrorMode === false"
      ]
    }
  ],
