          },
          {
            "expr": "window.__3D_STATE__.solverIterations >= 1 && window.__3D_STATE__.solverIterations <= 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
