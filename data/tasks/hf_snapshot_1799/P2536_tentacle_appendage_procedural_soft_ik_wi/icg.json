          },
          {
            "expr": "window.__3D_STATE__.jointAngles.every(a => !isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tentacleTipPos.y !== undefined && !isNaN(window.__3D_STATE__.tentacleTipPos.y)",
            "tier": "L0"
