            "expr": "window.__3D_STATE__.lastSaveTimestamp !== null",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastSaveTimestamp === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastSaveTimestamp > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('save-count') !== null && parseInt(document.getElementById('save-count').textContent) >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
