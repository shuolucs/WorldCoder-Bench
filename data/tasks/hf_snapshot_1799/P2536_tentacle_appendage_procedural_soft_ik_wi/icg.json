          },
          {
            "expr": "window.__3D_STATE__.stiffness !== 8.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-stiffness') !== null",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.damping === 'number' && window.__3D_STATE__.damping > 0",
