  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.horseLoaded === true",
        "window.__3D_STATE__.segmentCount === 12"
      ]
    },
    {
      "id": "S1",
      "name": "InitialRestPose",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.stiffness === 8.0",
        "window.__3D_STATE__.savedStates === 0",
        "window.__3D_STATE__.reachDistance > 0"
      ]
    },
    {
      "id": "S2",
      "name": "IKTargetMoved",
      "conditions": [
        "window.__3D_STATE__.ikTargetPos.x !== 2 || window.__3D_STATE__.ikTargetPos.z !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "TentacleStretching",
      "conditions": [
        "window.__3D_STATE__.isStretching === true",
        "window.__3D_STATE__.maxStretchRatio > 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStates >= 1",
        "window.__3D_STATE__.lastSaveTimestamp !== null"
      ]
    },
    {
      "id": "S5",
      "name": "StiffnessChanged",
      "conditions": [
        "window.__3D_STATE__.stiffness !== 8.0"
      ]
    },
    {
      "id": "S6",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.lastLoadTimestamp !== null"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.stiffness === 8.0",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.savedStates === 0 || window.__3D_STATE__.savedStates >= 0"
      ]
    },
    {
      "id": "S9",
      "name": "MultipleSaveSlots",
      "conditions": [
        "window.__3D_STATE__.savedStates >= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 12",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointAngles === 'object' && window.__3D_STATE__.jointAngles.length === 12",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.volumeRatios === 'object' && window.__3D_STATE__.volumeRatios.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxReach >= 4.0 && window.__3D_STATE__.maxReach <= 5.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tentacleTipPos.y < window.__3D_STATE__.tentacleBasePos.y",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgVolumeRatio > 0.95 && window.__3D_STATE__.avgVolumeRatio < 1.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeRatios.every(v => v > 0.95 && v < 1.05)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reachDistance > 0 && window.__3D_STATE__.reachDistance <= window.__3D_STATE__.maxReach * 1.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.ikTargetPos && (function(){ const evt = new MouseEvent('mousedown', {clientX: 400, clientY: 300}); document.querySelector('canvas').dispatchEvent(evt); })(); window.__SET_IK_TARGET__({x: -2, y: 2, z: 1});"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ikTargetPos.x !== 2 || window.__3D_STATE__.ikTargetPos.y !== 3 || window.__3D_STATE__.ikTargetPos.z !== 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikTargetPos.x === 'number' && !isNaN(window.__3D_STATE__.ikTargetPos.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikTargetPos.y === 'number' && !isNaN(window.__3D_STATE__.ikTargetPos.y)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikTargetPos.z === 'number' && !isNaN(window.__3D_STATE__.ikTargetPos.z)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jointAngles.every(a => typeof a === 'number' && !isNaN(a) && Math.abs(a) <= Math.PI)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__SET_IK_TARGET__({x: 5, y: 4, z: 3});"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isStretching === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxStretchRatio > 1.0 && window.__3D_STATE__.maxStretchRatio <= 1.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reachDistance > window.__3D_STATE__.maxReach * 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgVolumeRatio > 0.95 && window.__3D_STATE__.avgVolumeRatio < 1.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentScales.every(s => typeof s.x === 'number' && typeof s.y === 'number' && typeof s.z === 'number')",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
