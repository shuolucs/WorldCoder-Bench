        "code": "window.__SET_IK_TARGET__({x: 0, y: 1, z: 2}); setTimeout(()=>{ document.getElementById('btn-save').click(); }, 500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedStates >= 2",
            "tier": "L2"
          },
