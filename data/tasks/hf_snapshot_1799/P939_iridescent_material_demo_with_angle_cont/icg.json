  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.iridescentStrength === 1.5",
        "window.__3D_STATE__.fresnelPower === 2.0",
        "window.__3D_STATE__.viewAngleOverride === -999",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.orbitPaused === false",
        "window.__3D_STATE__.sphereCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "StrengthIncreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.iridescentStrength - 1.6) < 1e-6"
      ]
    },
    {
      "id": "S2",
      "name": "FresnelDecreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.fresnelPower - 1.75) < 1e-6"
      ]
    },
    {
      "id": "S3",
      "name": "ViewAngleManual",
      "conditions": [
        "window.__3D_STATE__.viewAngleOverride !== -999",
        "Math.abs(window.__3D_STATE__.viewAngleOverride - 0.0) < 1e-6"
      ]
    },
    {
      "id": "S4",
      "name": "ViewAngleAdjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.viewAngleOverride - 0.15) < 1e-6"
      ]
    },
    {
      "id": "S5",
      "name": "DebugVisible",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "OrbitPaused",
      "conditions": [
        "window.__3D_STATE__.orbitPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "SnapshotCaptured",
      "conditions": [
        "window.__3D_STATE__.snapshotHues.length === 5"
      ]
    },
    {
      "id": "S8",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 0",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.iridescentStrength - 1.5) < 1e-6",
        "Math.abs(window.__3D_STATE__.fresnelPower - 2.0) < 1e-6",
        "window.__3D_STATE__.viewAngleOverride === -999",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "HuePhysicsVerified",
      "conditions": [
        "typeof window.__3D_STATE__.computedHueCentral === 'number'",
        "window.__3D_STATE__.computedHueCentral >= 0 && window.__3D_STATE__.computedHueCentral < 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "i"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.iridescentStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.iridescentStrength - 1.6) < 1e-6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.iridescentStrength >= 0.1 && window.__3D_STATE__.iridescentStrength <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.computedHueCentral)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
