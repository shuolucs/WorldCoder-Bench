          },
          {
            "expr": "window.__3D_STATE__.satellitePositions.length === 4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.satellitePositions[0].x**2 + window.__3D_STATE__.satellitePositions[0].z**2) - 2.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
