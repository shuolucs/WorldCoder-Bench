      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.fresnelPower === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fresnelPower - 1.75) < 1e-6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fresnelPower >= 0.5 && window.__3D_STATE__.fresnelPower <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fresnelPower)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewAngleOverride !== -999",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.viewAngleOverride - 0.0) < 1e-6",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.computedHueCentral === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.computedHueCentral - (((0.0 * 1.6 + 0.0) % 1) + 1) % 1) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'u'}));}"
