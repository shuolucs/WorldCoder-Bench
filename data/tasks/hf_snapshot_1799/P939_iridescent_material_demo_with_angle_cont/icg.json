        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0 || window.__3D_STATE__.redoStackSize < (function(){return window.__3D_STATE__._prevRedoSize || 999})()",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.iridescentStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.iridescentStrength >= 0.1 && window.__3D_STATE__.iridescentStrength <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fresnelPower)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fresnelPower >= 0.5 && window.__3D_STATE__.fresnelPower <= 5.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.iridescentStrength - 1.5) < 1e-6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fresnelPower - 2.0) < 1e-6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewAngleOverride === -999",
            "tier": "L2"
          },
          {
