      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.viewAngleOverride - 0.15) < 1e-4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewAngleOverride >= -1.0 && window.__3D_STATE__.viewAngleOverride <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.computedHueCentral === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.computedHueCentral >= 0 && window.__3D_STATE__.computedHueCentral < 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.viewAngleOverride)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
