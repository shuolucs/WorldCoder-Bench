          {
            "expr": "document.getElementById('debug-overlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debug-overlay').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameTime > 0 && window.__3D_STATE__.frameTime < 1000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
