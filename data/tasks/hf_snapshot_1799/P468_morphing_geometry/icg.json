  "states": [
    {
      "id": "S0",
      "name": "Initial_HelmetLoaded",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.displayMode === 0",
        "window.__3D_STATE__.currentShape === 0",
        "window.__3D_STATE__.helmetVisible === true",
        "window.__3D_STATE__.morphMeshVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "DisplayMode1_MorphVisible",
      "conditions": [
        "window.__3D_STATE__.displayMode === 1",
        "window.__3D_STATE__.helmetVisible === false",
        "window.__3D_STATE__.morphMeshVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "MorphedToTorus",
      "conditions": [
        "window.__3D_STATE__.currentShape === 1",
        "window.__3D_STATE__.currentShapeName === 'Torus'",
        "window.__3D_STATE__.morphProgress === 1.0",
        "window.__3D_STATE__.isMorphing === false"
      ]
    },
    {
      "id": "S3",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "DisplayMode2_BothVisible",
      "conditions": [
        "window.__3D_STATE__.displayMode === 2",
        "window.__3D_STATE__.helmetVisible === true",
        "window.__3D_STATE__.morphMeshVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.colorIndex === 1"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.displayMode === 0",
        "window.__3D_STATE__.currentShape === 0",
        "window.__3D_STATE__.wireframe === false",
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.colorIndex === 0"
      ]
    }
  ],
