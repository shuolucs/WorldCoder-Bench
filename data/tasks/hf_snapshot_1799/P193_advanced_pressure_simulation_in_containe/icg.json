{
  "task_id": "P193_advanced_pressure_simulation_in_containe",
  "affordances": [
    {
      "id": "A1",
      "name": "GasParticles",
      "type": "3d_object",
      "semantic": "20 small spheres representing gas molecules bouncing inside a container",
      "locator_hints": [
        "sphere meshes inside wireframe box"
      ]
    },
    {
      "id": "A2",
      "name": "Container",
      "type": "3d_object",
      "semantic": "Transparent 4x4x4 box that confines particles",
      "locator_hints": [
        "wireframe or semi-transparent box at origin"
      ]
    },
    {
      "id": "A3",
      "name": "HeatButton",
      "type": "dom_element",
      "semantic": "Button to increase temperature by 50K",
      "locator_hints": [
        "#heat-btn"
      ]
    },
    {
      "id": "A4",
      "name": "CoolButton",
      "type": "dom_element",
      "semantic": "Button to decrease temperature by 50K",
      "locator_hints": [
        "#cool-btn"
      ]
    },
    {
      "id": "A5",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle pause/resume of simulation",
      "locator_hints": [
        "#pause-btn"
      ]
    },
    {
      "id": "A6",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing current score",
      "locator_hints": [
        "#score-display"
      ]
    },
    {
      "id": "A7",
      "name": "TempDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing current temperature",
      "locator_hints": [
        "#temp-display"
      ]
    },
    {
      "id": "A8",
      "name": "PressureDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing computed pressure",
      "locator_hints": [
        "#pressure-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.particleCount === 20",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 1",
        "window.__3D_STATE__.collisionCount > 0",
        "window.__3D_STATE__.pressure > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Heated",
      "conditions": [
        "window.__3D_STATE__.temperature === 350"
      ]
    },
    {
      "id": "S3",
      "name": "Cooled",
      "conditions": [
        "window.__3D_STATE__.temperature === 300"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.collisionCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pressure > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pressure)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleSpeedAvg) && window.__3D_STATE__.particleSpeedAvg > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#heat-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 350",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.particleSpeedAvg)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('temp-display').textContent.includes('350')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#cool-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pressure)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('temp-display').textContent.includes('300')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pause-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pause-btn').textContent.trim() === 'Resume'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pause-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pause-btn').textContent.trim() === 'Pause'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetPressure >= 5 && window.__3D_STATE__.targetPressure <= 25",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pressure > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.collisionCount)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('score-display').textContent.includes(String(window.__3D_STATE__.score))",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('target-display').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}