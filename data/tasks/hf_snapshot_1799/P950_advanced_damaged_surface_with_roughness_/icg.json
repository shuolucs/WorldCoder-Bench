{
  "task_id": "P950_advanced_damaged_surface_with_roughness_",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedSurface",
      "type": "3d_object",
      "semantic": "The main plane surface with roughness variation map that receives damage clicks",
      "locator_hints": [
        "PlaneGeometry mesh",
        "rotated horizontal plane at origin"
      ]
    },
    {
      "id": "A2",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score and stats overlay in top-right corner",
      "locator_hints": [
        "div with monospace font",
        "top-right positioned overlay"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the surface to original state",
      "locator_hints": [
        "button labeled 'Reset Surface'",
        "bottom-center of screen"
      ]
    },
    {
      "id": "A4",
      "name": "RoughnessMap",
      "type": "3d_object",
      "semantic": "The procedural DataTexture applied as roughnessMap on the surface material",
      "locator_hints": [
        "DataTexture 256x256",
        "material.roughnessMap"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.surfaceExists === true",
        "window.__3D_STATE__.damageHits === 0",
        "window.__3D_STATE__.brushMode === 'medium'",
        "window.__3D_STATE__.metalness === 0.85"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstDamage",
      "conditions": [
        "window.__3D_STATE__.damageHits >= 1",
        "window.__3D_STATE__.isReset === false"
      ]
    },
    {
      "id": "S2",
      "name": "SmallBrushSelected",
      "conditions": [
        "window.__3D_STATE__.brushMode === 'small'"
      ]
    },
    {
      "id": "S3",
      "name": "LargeBrushSelected",
      "conditions": [
        "window.__3D_STATE__.brushMode === 'large'"
      ]
    },
    {
      "id": "S4",
      "name": "AfterMultipleDamage",
      "conditions": [
        "window.__3D_STATE__.damageHits >= 3",
        "window.__3D_STATE__.score > 30"
      ]
    },
    {
      "id": "S5",
      "name": "MetalnessToggled",
      "conditions": [
        "window.__3D_STATE__.metalness === 0.15"
      ]
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.damageHits === 0",
        "window.__3D_STATE__.isReset === true"
      ]
    },
    {
      "id": "S7",
      "name": "MetalnessRestoredPostReset",
      "conditions": [
        "window.__3D_STATE__.metalness === 0.85",
        "window.__3D_STATE__.damageHits === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.damageHits === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roughnessMapResolution === 256",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushMode === 'medium'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgRoughness) && window.__3D_STATE__.avgRoughness > 0.0 && window.__3D_STATE__.avgRoughness < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 350,
        "description": "Click on the surface to apply first damage hit"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.damageHits === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isReset === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 10 + Math.floor(window.__3D_STATE__.avgRoughness * 100)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRoughness >= 0.3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgRoughness)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1",
        "description": "Press '1' to switch to small brush mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.brushMode === 'small'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.brushMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.damageHits === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.metalness === 0.85",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3",
        "description": "Press '3' to switch to large brush mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.brushMode === 'large'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushMode !== 'small'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushMode !== 'medium'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const c = document.querySelector('canvas'); const rect = c.getBoundingClientRect(); const cx = rect.left + rect.width/2; const cy = rect.top + rect.height/2; for(let i=0;i<2;i++){c.dispatchEvent(new MouseEvent('click',{clientX:cx+i*30,clientY:cy,bubbles:true}));}",
        "description": "Apply 2 more damage clicks via script on the surface center area"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.damageHits >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isReset === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgRoughness > 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRoughness <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m",
        "description": "Press 'M' to toggle metalness from 0.85 to 0.15"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.metalness === 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baseRoughness === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.damageHits >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceExists === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.metalness === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "description": "Click the Reset Surface button to restore original state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.damageHits === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isReset === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === Math.floor(window.__3D_STATE__.avgRoughness * 100)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgRoughness > 0.0 && window.__3D_STATE__.avgRoughness < 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.maxRoughness) && window.__3D_STATE__.maxRoughness <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m",
        "description": "Press 'M' again to toggle metalness back to 0.85"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.metalness === 0.85",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.damageHits === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isReset === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baseRoughness === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roughnessMapResolution === 256",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}