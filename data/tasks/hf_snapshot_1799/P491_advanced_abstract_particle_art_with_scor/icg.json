  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.boxLoaded === true",
        "window.__3D_STATE__.particleCount === 500",
        "window.__3D_STATE__.activeAttractors === 5",
        "window.__3D_STATE__.score === 0 || window.__3D_STATE__.score >= 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "AfterColorCycle",
      "conditions": [
        "window.__3D_STATE__.colorIndex === 1",
        "window.__3D_STATE__.particleColorHex === 0xff00ff"
      ]
    },
    {
      "id": "S2",
      "name": "AfterPause",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.boxAnimationPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "AfterResume",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.boxAnimationPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "AfterExplosion",
      "conditions": [
        "window.__3D_STATE__.explosionCount >= 1",
        "window.__3D_STATE__.kineticEnergy > 0"
      ]
    },
    {
      "id": "S5",
      "name": "AttractorDeactivated",
      "conditions": [
        "window.__3D_STATE__.activeAttractors === 4",
        "window.__3D_STATE__.attractorStates.filter(s => s).length === 4"
      ]
    },
    {
      "id": "S6",
      "name": "AllAttractorsOff",
      "conditions": [
        "window.__3D_STATE__.activeAttractors === 0",
        "window.__3D_STATE__.allDeactivatedBonus >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.activeAttractors === 5",
        "window.__3D_STATE__.explosionCount === 0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleColorCycles",
      "conditions": [
        "window.__3D_STATE__.colorIndex === 3",
        "window.__3D_STATE__.particleColorHex === 0xffffff"
      ]
    },
    {
      "id": "S9",
      "name": "ScoreAccumulated",
      "conditions": [
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.frameCount > 60"
      ]
    }
  ],
