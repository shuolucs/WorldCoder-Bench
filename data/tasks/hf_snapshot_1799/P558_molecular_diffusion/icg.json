{
  "task_id": "P558_molecular_diffusion",
  "affordances": [
    {"id": "A1", "name": "ParticlesA", "type": "3d_object", "semantic": "30 red solute particles", "locator_hints": ["red sphere meshes"]},
    {"id": "A2", "name": "ParticlesB", "type": "3d_object", "semantic": "70 blue solvent particles", "locator_hints": ["blue sphere meshes"]},
    {"id": "A3", "name": "Container", "type": "3d_object", "semantic": "Wireframe simulation box", "locator_hints": ["wireframe box lines"]},
    {"id": "A4", "name": "Heatmap", "type": "3d_object", "semantic": "Floor density heatmap", "locator_hints": ["colored grid on floor"]},
    {"id": "A5", "name": "TempSlider", "type": "dom_element", "semantic": "Temperature control", "locator_hints": ["#slider-temperature"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.particleCount === 100", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Segregated", "conditions": ["window.__3D_STATE__.mixingIndex < 0.3"]},
    {"id": "S2", "name": "Diffusing", "conditions": ["window.__3D_STATE__.mixingIndex > 0.3"]},
    {"id": "S3", "name": "TempChanged", "conditions": ["window.__3D_STATE__.temperature !== 1.0"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.mixingIndex < 0.2"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 100", "tier": "L2"},
        {"expr": "window.__3D_STATE__.typeACount === 30", "tier": "L2"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 8000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.mixingIndex > before.mixingIndex || window.__3D_STATE__.mixingIndex > 0.2", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.totalKE > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-temperature').value = 4.0; document.getElementById('slider-temperature').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.temperature >= 3.5", "tier": "L2"},
        {"expr": "document.getElementById('hud-temp') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgSpeedA > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.avgSpeedB > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.particleCount === 100", "tier": "L2"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "h"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.heatmapEnabled !== before.heatmapEnabled", "tier": "L2"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.trailsEnabled !== before.trailsEnabled", "tier": "L2"}
      ]}
    }
  ]
}
