  "states": [
    {
      "id": "S0",
      "name": "ModelsLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.simStatus === 'Stopped'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.simStatus === 'Running'"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.simStatus === 'Stopped'",
        "window.__3D_STATE__.totalElectronsTransferred > 0"
      ]
    },
    {
      "id": "S3",
      "name": "ResistanceChanged",
      "conditions": [
        "window.__3D_STATE__.resistance !== 5"
      ]
    },
    {
      "id": "S4",
      "name": "ElectrodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedElectrode !== null"
      ]
    },
    {
      "id": "S5",
      "name": "MassTransferOccurred",
      "conditions": [
        "window.__3D_STATE__.znMass < 65.38",
        "window.__3D_STATE__.cuMass > 63.55"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.znMass === 65.38",
        "window.__3D_STATE__.cuMass === 63.55",
        "window.__3D_STATE__.totalElectronsTransferred === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Depleted",
      "conditions": [
        "window.__3D_STATE__.simStatus === 'Depleted'",
        "window.__3D_STATE__.cellVoltage === 0"
      ]
    }
  ],
