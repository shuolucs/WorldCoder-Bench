  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedDefaults",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.breathingEnabled === true",
        "window.__3D_STATE__.heartbeatEnabled === true",
        "window.__3D_STATE__.currentBPM === 72",
        "window.__3D_STATE__.breathRate === 0.25",
        "window.__3D_STATE__.animationRunning === true"
      ]
    },
    {
      "id": "S1",
      "name": "BreathingDisabled",
      "conditions": [
        "window.__3D_STATE__.breathingEnabled === false",
        "window.__3D_STATE__.heartbeatEnabled === true"
      ]
    },
    {
      "id": "S2",
      "name": "HeartbeatDisabled",
      "conditions": [
        "window.__3D_STATE__.heartbeatEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "BPMIncreased",
      "conditions": [
        "window.__3D_STATE__.currentBPM === 78"
      ]
    },
    {
      "id": "S4",
      "name": "BreathRateDecreased",
      "conditions": [
        "window.__3D_STATE__.breathRate === 0.20"
      ]
    },
    {
      "id": "S5",
      "name": "StressModeActive",
      "conditions": [
        "window.__3D_STATE__.currentBPM === 140",
        "window.__3D_STATE__.breathRate === 0.6"
      ]
    },
    {
      "id": "S6",
      "name": "UndoneStress",
      "conditions": [
        "window.__3D_STATE__.currentBPM !== 140 || window.__3D_STATE__.breathRate !== 0.6"
      ]
    },
    {
      "id": "S7",
      "name": "RedoneStress",
      "conditions": [
        "window.__3D_STATE__.currentBPM === 140",
        "window.__3D_STATE__.breathRate === 0.6"
      ]
    },
    {
      "id": "S8",
      "name": "SyncedBreathToHeart",
      "conditions": [
        "Math.abs(window.__3D_STATE__.breathRate - window.__3D_STATE__.currentBPM / 240) < 0.001"
      ]
    },
    {
      "id": "S9",
      "name": "AnimationProgressed",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 2.0"
      ]
    },
    {
      "id": "S10",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.currentBPM === 72",
        "window.__3D_STATE__.breathRate === 0.25",
        "window.__3D_STATE__.breathingEnabled === true",
        "window.__3D_STATE__.heartbeatEnabled === true"
      ]
    }
