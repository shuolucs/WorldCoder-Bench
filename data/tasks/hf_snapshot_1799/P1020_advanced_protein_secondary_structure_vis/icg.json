  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.residueCount === 60",
        "window.__3D_STATE__.totalStabilityScore === 61.8"
      ]
    },
    {
      "id": "S1",
      "name": "ResidueSelected",
      "conditions": [
        "window.__3D_STATE__.selectedResidue !== null",
        "window.__3D_STATE__.selectedResidueType !== null"
      ]
    },
    {
      "id": "S2",
      "name": "TypeCycled",
      "conditions": [
        "window.__3D_STATE__.typeCycleCount > 0",
        "window.__3D_STATE__.totalStabilityScore !== 61.8"
      ]
    },
    {
      "id": "S3",
      "name": "HydrogenBondsShown",
      "conditions": [
        "window.__3D_STATE__.hydrogenBondsVisible === true",
        "window.__3D_STATE__.hydrogenBondCount > 0"
      ]
    },
    {
      "id": "S4",
      "name": "BackboneHidden",
      "conditions": [
        "window.__3D_STATE__.backboneVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.animationActive === true",
        "window.__3D_STATE__.animationProgress < 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "AnimationComplete",
      "conditions": [
        "window.__3D_STATE__.animationActive === false",
        "window.__3D_STATE__.animationProgress === 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "HelixHighlighted",
      "conditions": [
        "window.__3D_STATE__.highlightMode === 1"
      ]
    },
    {
      "id": "S8",
      "name": "SheetHighlighted",
      "conditions": [
        "window.__3D_STATE__.highlightMode === 2"
      ]
    },
    {
      "id": "S9",
      "name": "AllHighlightReset",
      "conditions": [
        "window.__3D_STATE__.highlightMode === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 60",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.structureElements) && window.__3D_STATE__.structureElements.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalStabilityScore === 61.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedResidue === null && window.__3D_STATE__.hydrogenBondsVisible === false && window.__3D_STATE__.backboneVisible === true && window.__3D_STATE__.animationProgress === 1.0 && window.__3D_STATE__.highlightMode === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Verify structure element scoring breakdown */ true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.structureElements[0].type === 'helix' && window.__3D_STATE__.structureElements[0].residueCount === 12 && window.__3D_STATE__.structureElements[0].stabilityScore === 18.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements[1].type === 'coil' && window.__3D_STATE__.structureElements[1].residueCount === 8 && window.__3D_STATE__.structureElements[1].stabilityScore === 2.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements[2].type === 'sheet' && window.__3D_STATE__.structureElements[2].residueCount === 14 && window.__3D_STATE__.structureElements[2].stabilityScore === 16.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements[3].type === 'coil' && window.__3D_STATE__.structureElements[3].residueCount === 6 && window.__3D_STATE__.structureElements[3].stabilityScore === 1.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements[4].type === 'helix' && window.__3D_STATE__.structureElements[4].residueCount === 14 && window.__3D_STATE__.structureElements[4].stabilityScore === 21.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements[5].type === 'coil' && window.__3D_STATE__.structureElements[5].residueCount === 6 && window.__3D_STATE__.structureElements[5].stabilityScore === 1.8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate selecting residue 5 (in first alpha-helix) */ const evt = new MouseEvent('click', {clientX: 0, clientY: 0}); /* Use raycaster programmatically */ if(window.__selectResidue) { window.__selectResidue(5); } else { window.__3D_STATE__.selectedResidue = 5; window.__3D_STATE__.selectedResidueType = 'helix'; }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedResidue === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedResidueType === 'helix'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedResidue === 'number' && window.__3D_STATE__.selectedResidue >= 0 && window.__3D_STATE__.selectedResidue <= 59",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedResidueType === 'helix' || window.__3D_STATE__.selectedResidueType === 'sheet' || window.__3D_STATE__.selectedResidueType === 'coil'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('residue-info') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.typeCycleCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedResidueType === 'sheet'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStabilityScore !== 61.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalStabilityScore - (61.8 - 1.5 + 1.2)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structureElements.reduce((s,e) => s + e.stabilityScore, 0) === window.__3D_STATE__.totalStabilityScore",
            "tier": "L2"
          }
        ]
      }
    },
    {
