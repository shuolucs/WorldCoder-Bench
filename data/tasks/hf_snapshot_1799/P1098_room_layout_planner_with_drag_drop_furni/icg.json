            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions['sofa'].z - 0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].rotation === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions['table'].x - 3) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Select table and try to move it onto desk position causing collision */ if(window.__3D_STATE__._selectFurniture) window.__3D_STATE__._selectFurniture('table'); if(window.__3D_STATE__._moveFurniture) window.__3D_STATE__._moveFurniture('table', 3, -2);",
        "description": "Attempt to move table directly onto desk position to trigger collision"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.collisionOccurred === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedId === 'table'",
            "tier": "L2"
          },
          {
            "expr": "!(Math.abs(window.__3D_STATE__.furniturePositions['table'].x - 3) < 0.01 && Math.abs(window.__3D_STATE__.furniturePositions['table'].z - (-2)) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furnitureCount === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Try to move sofa outside room bounds */ if(window.__3D_STATE__._selectFurniture) window.__3D_STATE__._selectFurniture('sofa'); if(window.__3D_STATE__._moveFurniture) window.__3D_STATE__._moveFurniture('sofa', 6, 0);",
        "description": "Attempt to move sofa outside room bounds (x=6 exceeds maxX=5)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].x <= window.__3D_STATE__.roomBounds.maxX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].x >= window.__3D_STATE__.roomBounds.minX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].z >= window.__3D_STATE__.roomBounds.minZ",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].z <= window.__3D_STATE__.roomBounds.maxZ",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.furniturePositions['sofa'].x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 12; document.getElementById('timeSlider').dispatchEvent(new Event('input')); document.getElementById('resetBtn').click();",
        "description": "Reset time to noon and reset layout to return to initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeOfDay === 12",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightIntensity - 1.0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furnitureCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedId === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.areaUsagePercent > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deletedFurniture.length === 0",
            "tier": "L2"
