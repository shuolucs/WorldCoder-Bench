            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightColor.b >= window.__3D_STATE__.lightColor.r",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightColor === 'object'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
