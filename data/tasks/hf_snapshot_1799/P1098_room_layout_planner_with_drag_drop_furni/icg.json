          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].rotation % 90 === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedId === 'sofa'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.furniturePositions['sofa'].rotation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.furniturePositions['sofa'].rotation)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 6; document.getElementById('timeSlider').dispatchEvent(new Event('input'));",
        "description": "Set time slider to 6 (sunrise)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeOfDay === 6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightIntensity - 0.6) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightColor.r > window.__3D_STATE__.lightColor.b",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity > 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
