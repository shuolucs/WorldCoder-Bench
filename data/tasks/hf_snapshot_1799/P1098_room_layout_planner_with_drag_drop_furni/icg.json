  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.furnitureCount === 5",
        "window.__3D_STATE__.selectedId === null",
        "window.__3D_STATE__.timeOfDay === 12",
        "window.__3D_STATE__.deletedFurniture.length === 0"
      ]
    },
    {
      "id": "S1",
      "name": "FurnitureSelected",
      "conditions": [
        "window.__3D_STATE__.selectedId !== null"
      ]
    },
    {
      "id": "S2",
      "name": "FurnitureMoved",
      "conditions": [
        "window.__3D_STATE__.selectedId !== null",
        "window.__3D_STATE__.collisionOccurred === false"
      ]
    },
    {
      "id": "S3",
      "name": "FurnitureRotated",
      "conditions": [
        "window.__3D_STATE__.furniturePositions[window.__3D_STATE__.selectedId].rotation % 90 === 0"
      ]
    },
    {
      "id": "S4",
      "name": "TimeChanged",
      "conditions": [
        "window.__3D_STATE__.timeOfDay !== 12"
      ]
    },
    {
      "id": "S5",
      "name": "NightTime",
      "conditions": [
        "window.__3D_STATE__.timeOfDay >= 0 && window.__3D_STATE__.timeOfDay <= 5"
      ]
    },
    {
      "id": "S6",
      "name": "FurnitureDeleted",
      "conditions": [
        "window.__3D_STATE__.deletedFurniture.length > 0",
        "window.__3D_STATE__.furnitureCount < 5"
      ]
    },
    {
      "id": "S7",
      "name": "LayoutReset",
      "conditions": [
        "window.__3D_STATE__.furnitureCount === 5",
        "window.__3D_STATE__.furniturePositions['sofa'].x === 0",
        "window.__3D_STATE__.furniturePositions['sofa'].z === 0"
      ]
    },
    {
      "id": "S8",
      "name": "CollisionBlocked",
      "conditions": [
        "window.__3D_STATE__.collisionOccurred === true"
      ]
    },
    {
      "id": "S9",
      "name": "BoundsEnforced",
      "conditions": [
        "window.__3D_STATE__.furniturePositions['sofa'].x >= window.__3D_STATE__.roomBounds.minX",
        "window.__3D_STATE__.furniturePositions['sofa'].x <= window.__3D_STATE__.roomBounds.maxX"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A1",
        "description": "Click on the sofa to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedId === 'sofa'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedId === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.furnitureCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].x === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate dragging sofa to new position */ const state = window.__3D_STATE__; if(state._moveFurniture) { state._moveFurniture('sofa', 2, 1); }",
        "description": "Drag sofa to position (2, 1) on the floor plane"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions['sofa'].x - 2) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions['sofa'].z - 1) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.collisionOccurred === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].x > window.__3D_STATE__.roomBounds.minX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furniturePositions['sofa'].x < window.__3D_STATE__.roomBounds.maxX",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
