        "code": "(() => { const undoBtn = document.getElementById('btn-undo'); const depth = window.__3D_STATE__.undoDepth; for(let i = 0; i < depth; i++) { undoBtn.click(); } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoDepth >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
