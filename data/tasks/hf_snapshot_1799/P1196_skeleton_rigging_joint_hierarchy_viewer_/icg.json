      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const canvas = document.querySelector('canvas'); const evt = new MouseEvent('click', {clientX: 10, clientY: 10, bubbles: true}); canvas.dispatchEvent(evt); if(window.__deselectJoint) window.__deselectJoint(); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === null",
