          },
          {
            "expr": "window.__3D_STATE__.undoDepth >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint].x - 15) < 1.0 || window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint].x !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
