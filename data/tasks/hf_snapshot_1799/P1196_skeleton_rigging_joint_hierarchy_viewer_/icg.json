          },
          {
            "expr": "window.__3D_STATE__.redoDepth >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint].x) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          }
