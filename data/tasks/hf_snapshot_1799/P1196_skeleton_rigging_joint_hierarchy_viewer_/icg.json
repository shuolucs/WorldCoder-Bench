      "locator_hints": [
        "SkeletonHelper",
        "bone visualization"
      ]
    },
    {
      "id": "A2",
      "name": "JointSpheres",
      "type": "3d_object",
      "semantic": "Clickable spheres at each joint position, colored by depth",
