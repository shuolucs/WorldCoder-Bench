  "states": [
    {
      "id": "S0",
      "name": "InitialSceneLoaded",
      "conditions": [
        "window.__3D_STATE__.jointCount === 15",
        "window.__3D_STATE__.selectedJoint === null",
        "window.__3D_STATE__.undoDepth === 0",
        "window.__3D_STATE__.redoDepth === 0",
        "window.__3D_STATE__.playbackStatus === 'stopped'",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S1",
      "name": "JointSelected",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "window.__3D_STATE__.selectedJointScale === 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "JointRotatedViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.undoDepth >= 1",
        "window.__3D_STATE__.lastAction === 'rotate'"
      ]
    },
    {
      "id": "S3",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoDepth >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S5",
      "name": "WavePoseApplied",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'preset'",
        "Math.abs(window.__3D_STATE__.jointRotations['RightShoulder'].z - (-90)) < 0.5"
      ]
    },
    {
      "id": "S6",
      "name": "TPoseRestored",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'preset'",
        "Math.abs(window.__3D_STATE__.jointRotations['RightShoulder'].z) < 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "WalkPoseApplied",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'preset'",
        "Math.abs(window.__3D_STATE__.jointRotations['LeftHip'].x - (-30)) < 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "PlaybackActive",
      "conditions": [
        "window.__3D_STATE__.playbackStatus === 'playing'"
      ]
    },
    {
      "id": "S9",
      "name": "PlaybackStopped",
      "conditions": [
        "window.__3D_STATE__.playbackStatus === 'stopped'",
        "window.__3D_STATE__.lastAction === 'stop'"
      ]
    },
    {
      "id": "S10",
      "name": "MultiUndoChained",
      "conditions": [
        "window.__3D_STATE__.undoDepth === 0",
        "window.__3D_STATE__.redoDepth >= 2"
      ]
    },
    {
      "id": "S11",
      "name": "JointDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedJoint === null",
        "window.__3D_STATE__.lastAction === 'deselect'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.jointNames) && window.__3D_STATE__.jointNames.length === 15",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jointNames.includes('Root') || window.__3D_STATE__.jointNames.includes('Hip') || window.__3D_STATE__.jointNames.includes('root')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJoint === null && window.__3D_STATE__.undoDepth === 0 && window.__3D_STATE__.redoDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackStatus === 'stopped' && window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const joints = document.querySelectorAll('#joint-info') || []; const spheres = window.__3D_STATE__.jointNames; const targetJoint = 'RightShoulder'; const evt = new MouseEvent('click', {clientX: window.innerWidth/2 + 60, clientY: window.innerHeight/2 - 80, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt); if(window.__3D_STATE__.selectedJoint === null) { window.__selectJointByName && window.__selectJointByName(targetJoint); } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedJoint === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedJointScale === 1.5 || window.__3D_STATE__.selectedJointScale > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'select'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "x"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoDepth >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'rotate'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoDepth === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint].x - 15) < 1.0 || window.__3D_STATE__.jointRotations[window.__3D_STATE__.selectedJoint].x !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
