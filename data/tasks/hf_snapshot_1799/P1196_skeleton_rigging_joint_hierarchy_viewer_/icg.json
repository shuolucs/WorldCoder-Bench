            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          },
          {
            "expr": "!Object.values(window.__3D_STATE__.jointWorldPositions).some(p => isNaN(p.x) || isNaN(p.y) || isNaN(p.z))",
