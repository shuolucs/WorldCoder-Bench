          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointRotations['RightElbow'].z - (-45)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoDepth >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
