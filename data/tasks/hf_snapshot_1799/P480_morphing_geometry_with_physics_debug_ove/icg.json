      "conditions": [
        "window.__3D_STATE__.targetShapeIndex === 1",
        "window.__3D_STATE__.isMorphing === true",
        "window.__3D_STATE__.morphProgress > 0 && window.__3D_STATE__.morphProgress <= 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "BoxComplete",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 1",
        "window.__3D_STATE__.isMorphing === false",
        "window.__3D_STATE__.totalMorphCount >= 1"
      ]
    },
    {
      "id": "S3",
