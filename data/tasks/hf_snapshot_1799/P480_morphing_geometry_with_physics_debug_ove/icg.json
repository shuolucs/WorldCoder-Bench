      "conditions": [
        "window.__3D_STATE__.debugMode === 'wireframe'",
        "window.__3D_STATE__.currentShapeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "DebugFullOn",
      "conditions": [
        "window.__3D_STATE__.debugMode === 'full'"
      ]
    },
    {
      "id": "S5",
      "name": "MorphingToTorus",
      "conditions": [
