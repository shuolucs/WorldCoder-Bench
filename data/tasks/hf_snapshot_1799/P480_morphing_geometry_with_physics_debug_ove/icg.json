    {
      "id": "S0",
      "name": "InitialSphere",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 0",
        "window.__3D_STATE__.isMorphing === false",
        "window.__3D_STATE__.debugMode === 'off'",
        "window.__3D_STATE__.totalMorphCount === 0",
        "window.__3D_STATE__.morphProgress === 0"
      ]
    },
    {
      "id": "S1",
