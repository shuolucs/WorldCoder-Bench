{
  "task_id": "P398_multiplayer_laptop_design_comparison",
  "affordances": [
    {
      "id": "A1",
      "name": "PedestalA",
      "type": "3d_object",
      "semantic": "Left pedestal holding laptop design A",
      "locator_hints": [
        "position.x ≈ -2.5"
      ]
    },
    {
      "id": "A2",
      "name": "PedestalB",
      "type": "3d_object",
      "semantic": "Right pedestal holding laptop design B",
      "locator_hints": [
        "position.x ≈ 2.5"
      ]
    },
    {
      "id": "A3",
      "name": "AvocadoModel",
      "type": "3d_object",
      "semantic": "Decorative Avocado.glb mascot model",
      "locator_hints": [
        "position near (0, 0.5, -3)"
      ]
    },
    {
      "id": "A4",
      "name": "CycleDesignAButton",
      "type": "dom_element",
      "semantic": "Button to cycle laptop design on pedestal A",
      "locator_hints": [
        "#btnCycleA"
      ]
    },
    {
      "id": "A5",
      "name": "CycleDesignBButton",
      "type": "dom_element",
      "semantic": "Button to cycle laptop design on pedestal B",
      "locator_hints": [
        "#btnCycleB"
      ]
    },
    {
      "id": "A6",
      "name": "CompareButton",
      "type": "dom_element",
      "semantic": "Button to compare the two selected designs",
      "locator_hints": [
        "#btnCompare"
      ]
    },
    {
      "id": "A7",
      "name": "StatusText",
      "type": "dom_element",
      "semantic": "Text showing current design selections",
      "locator_hints": [
        "#statusText"
      ]
    },
    {
      "id": "A8",
      "name": "CompareResult",
      "type": "dom_element",
      "semantic": "Text showing comparison result",
      "locator_hints": [
        "#compareResult"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.designIndexA === 0",
        "window.__3D_STATE__.designIndexB === 1",
        "window.__3D_STATE__.comparisonDone === false"
      ]
    },
    {
      "id": "S1",
      "name": "DesignACycledOnce",
      "conditions": [
        "window.__3D_STATE__.designIndexA === 1",
        "window.__3D_STATE__.designNameA === 'Pro'"
      ]
    },
    {
      "id": "S2",
      "name": "DesignBCycledOnce",
      "conditions": [
        "window.__3D_STATE__.designIndexB === 2",
        "window.__3D_STATE__.designNameB === 'Ultra'"
      ]
    },
    {
      "id": "S3",
      "name": "ComparisonPerformed",
      "conditions": [
        "window.__3D_STATE__.comparisonDone === true",
        "window.__3D_STATE__.comparisonResult.length > 0"
      ]
    },
    {
      "id": "S4",
      "name": "SameDesignCompared",
      "conditions": [
        "window.__3D_STATE__.designIndexA === window.__3D_STATE__.designIndexB",
        "window.__3D_STATE__.comparisonResult === 'Same design selected!'"
      ]
    },
    {
      "id": "S5",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.designIndexA === 0",
        "window.__3D_STATE__.designIndexB === 1",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.designIndexA !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.designIndexB !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.designNameA !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.designNameB !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.designIndexA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.designIndexB === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.comparisonDone === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avocadoLoaded === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnCycleA"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.designIndexA !== before.designIndexA || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.designIndexA === 'number' && !isNaN(window.__3D_STATE__.designIndexA)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.designIndexB === 'number' && !isNaN(window.__3D_STATE__.designIndexB)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.comparisonDone === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avocadoLoaded === 'boolean'",
            "tier": "L0"
