  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 8",
        "window.__3D_STATE__.edgeCount === 9",
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.stateSaved === false",
        "window.__3D_STATE__.stateLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.mobileNodeLoaded === true",
        "window.__3D_STATE__.nodeCount === 8"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex >= 0",
        "window.__3D_STATE__.selectedNodeIndex < window.__3D_STATE__.nodeCount"
      ]
    },
    {
      "id": "S3",
      "name": "NodeDeactivated",
      "conditions": [
        "window.__3D_STATE__.nodesActive.includes(false)"
      ]
    },
    {
      "id": "S4",
      "name": "EdgeRemoved",
      "conditions": [
        "window.__3D_STATE__.edgeCount < 9"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.stateSaved === true",
        "typeof window.__3D_SAVED_STATE__ === 'string'"
      ]
    },
    {
      "id": "S6",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.stateLoaded === true"
      ]
    },
    {
      "id": "S7",
      "name": "StateReset",
      "conditions": [
        "window.__3D_STATE__.edgeCount === 9",
        "window.__3D_STATE__.nodesActive.every(a => a === true)",
        "window.__3D_STATE__.selectedNodeIndex === -1"
      ]
    }
  ],
