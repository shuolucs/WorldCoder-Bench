{
  "task_id": "P2177_shadow_penumbra_softness_gradient_editor",
  "affordances": [
    {
      "id": "A1",
      "name": "AvocadoModel",
      "type": "3d_object",
      "semantic": "Central avocado GLB model casting shadows",
      "locator_hints": [
        "loaded via GLTFLoader",
        "scaled by 30",
        "position (0, 0.5, 0)"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Horizontal ground plane receiving shadows",
      "locator_hints": [
        "PlaneGeometry 20x20",
        "y=0"
      ]
    },
    {
      "id": "A3",
      "name": "DirectionalLight",
      "type": "3d_object",
      "semantic": "Primary directional light with configurable shadow",
      "locator_hints": [
        "position (3,6,3)",
        "white color"
      ]
    },
    {
      "id": "A4",
      "name": "PointLight",
      "type": "3d_object",
      "semantic": "Secondary orange point light with shadow",
      "locator_hints": [
        "position (-3,4,-2)",
        "color #ff8844"
      ]
    },
    {
      "id": "A5",
      "name": "DirRadiusSlider",
      "type": "dom_element",
      "semantic": "Slider controlling directional shadow radius",
      "locator_hints": [
        "#dirRadiusSlider"
      ]
    },
    {
      "id": "A6",
      "name": "PointRadiusSlider",
      "type": "dom_element",
      "semantic": "Slider controlling point shadow radius",
      "locator_hints": [
        "#pointRadiusSlider"
      ]
    },
    {
      "id": "A7",
      "name": "ShadowMapSlider",
      "type": "dom_element",
      "semantic": "Slider controlling shadow map resolution exponent",
      "locator_hints": [
        "#shadowMapSlider"
      ]
    },
    {
      "id": "A8",
      "name": "DirIntensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling directional light intensity",
      "locator_hints": [
        "#dirIntensitySlider"
      ]
    },
    {
      "id": "A9",
      "name": "BiasSlider",
      "type": "dom_element",
      "semantic": "Slider controlling shadow bias",
      "locator_hints": [
        "#biasSlider"
      ]
    },
    {
      "id": "A10",
      "name": "TogglePointLightBtn",
      "type": "dom_element",
      "semantic": "Button toggling point light on/off",
      "locator_hints": [
        "#togglePointLight"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Default",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.dirShadowRadius === 4",
        "window.__3D_STATE__.pointShadowRadius === 2",
        "window.__3D_STATE__.shadowMapResolution === 2048",
        "window.__3D_STATE__.preset === 'default'"
      ]
    },
    {
      "id": "S1",
      "name": "DirRadius_Adjusted",
      "conditions": [
        "window.__3D_STATE__.dirShadowRadius === 10",
        "window.__3D_STATE__.preset === 'custom'"
      ]
    },
    {
      "id": "S2",
      "name": "Hard_Shadow_Preset",
      "conditions": [
        "window.__3D_STATE__.dirShadowRadius === 0",
        "window.__3D_STATE__.pointShadowRadius === 0",
        "window.__3D_STATE__.shadowMapResolution === 4096",
        "window.__3D_STATE__.preset === 'hard'"
      ]
    },
    {
      "id": "S3",
      "name": "Soft_Shadow_Preset",
      "conditions": [
        "window.__3D_STATE__.dirShadowRadius === 12",
        "window.__3D_STATE__.pointShadowRadius === 8",
        "window.__3D_STATE__.shadowMapResolution === 1024",
        "window.__3D_STATE__.preset === 'soft'"
      ]
    },
    {
      "id": "S4",
      "name": "PointLight_Disabled",
      "conditions": [
        "window.__3D_STATE__.pointLightEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "PointLight_ReEnabled",
      "conditions": [
        "window.__3D_STATE__.pointLightEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Bias_Adjusted",
      "conditions": [
        "window.__3D_STATE__.shadowBias === 0.005"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_To_Default",
      "conditions": [
        "window.__3D_STATE__.dirShadowRadius === 4",
        "window.__3D_STATE__.pointShadowRadius === 2",
        "window.__3D_STATE__.shadowMapResolution === 2048",
        "window.__3D_STATE__.preset === 'default'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundReceivesShadow === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelCastsShadow === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dirShadowRadius === 4 && window.__3D_STATE__.pointShadowRadius === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('dirRadiusSlider'); if(s){const nv=new Event('input',{bubbles:true}); s.value='10'; s.dispatchEvent(nv);}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dirShadowRadius === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.preset === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('dirRadiusSlider').value === '10'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('dirRadiusValue') !== null && document.getElementById('dirRadiusValue').textContent.includes('10')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dirShadowRadius >= 0 && !isNaN(window.__3D_STATE__.dirShadowRadius)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dirShadowRadius === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointShadowRadius === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapResolution === 4096",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.preset === 'hard'",
            "tier": "L2"
          },
          {
            "expr": "Math.log2(window.__3D_STATE__.shadowMapResolution) === 12",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('dirRadiusSlider').value === '0'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dirShadowRadius === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointShadowRadius === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapResolution === 1024",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.preset === 'soft'",
            "tier": "L2"
          },
          {
            "expr": "Math.log2(window.__3D_STATE__.shadowMapResolution) === 10",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pointRadiusSlider').value === '8'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#togglePointLight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pointLightEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('togglePointLight').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pointLightEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dirLightIntensity > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#togglePointLight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pointLightEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('togglePointLight').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pointLightEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pointShadowRadius >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('biasSlider'); if(s){const nv=new Event('input',{bubbles:true}); s.value='0.005'; s.dispatchEvent(nv);}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.shadowBias - 0.005) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowBias >= -0.01 && window.__3D_STATE__.shadowBias <= 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('biasSlider').value === '0.005'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.shadowBias)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.preset === 'custom'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dirShadowRadius === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointShadowRadius === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapResolution === 2048",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dirLightIntensity === 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shadowBias - (-0.001)) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.preset === 'default'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}