{
  "task_id": "P396_phone_case_designer_with_physics_debug_o",
  "affordances": [
    {
      "id": "A1",
      "name": "PhoneCaseModel",
      "type": "3d_object",
      "semantic": "The loaded GLB model representing the phone case prototype",
      "locator_hints": [
        "scene.children with type Group or loaded GLTF scene"
      ]
    },
    {
      "id": "A2",
      "name": "RedButton",
      "type": "dom_element",
      "semantic": "Button to change case color to red",
      "locator_hints": [
        "button with text 'Red'"
      ]
    },
    {
      "id": "A3",
      "name": "BlueButton",
      "type": "dom_element",
      "semantic": "Button to change case color to blue",
      "locator_hints": [
        "button with text 'Blue'"
      ]
    },
    {
      "id": "A4",
      "name": "GreenButton",
      "type": "dom_element",
      "semantic": "Button to change case color to green",
      "locator_hints": [
        "button with text 'Green'"
      ]
    },
    {
      "id": "A5",
      "name": "AutoRotateCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox to toggle auto-rotation of the model",
      "locator_hints": [
        "input[type=checkbox]",
        "label with 'Auto-Rotate'"
      ]
    },
    {
      "id": "A6",
      "name": "WireframeButton",
      "type": "dom_element",
      "semantic": "Button to toggle wireframe rendering",
      "locator_hints": [
        "button with text 'Toggle Wireframe'"
      ]
    },
    {
      "id": "A7",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug info panel in bottom-right",
      "locator_hints": [
        "div with 'Physics Debug' text"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentColor === 'white'",
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.wireframe === false"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChangedRed",
      "conditions": [
        "window.__3D_STATE__.currentColor === 'red'"
      ]
    },
    {
      "id": "S2",
      "name": "ColorChangedBlue",
      "conditions": [
        "window.__3D_STATE__.currentColor === 'blue'"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRotateEnabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S4",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeOff_AfterToggle",
      "conditions": [
        "window.__3D_STATE__.wireframe === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
