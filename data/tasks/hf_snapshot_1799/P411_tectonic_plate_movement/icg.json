{
  "task_id": "P411_tectonic_plate_movement",
  "affordances": [
    {
      "id": "A1",
      "name": "PlateA",
      "type": "3d_object",
      "semantic": "Oceanic tectonic plate (left, dark blue-gray)",
      "locator_hints": [
        "plateA",
        "left plate",
        "oceanic plate"
      ]
    },
    {
      "id": "A2",
      "name": "PlateB",
      "type": "3d_object",
      "semantic": "Continental tectonic plate (right, brown-tan)",
      "locator_hints": [
        "plateB",
        "right plate",
        "continental plate"
      ]
    },
    {
      "id": "A3",
      "name": "FoxMascot",
      "type": "3d_object",
      "semantic": "Fox.glb model as wildlife observer on Plate B",
      "locator_hints": [
        "fox",
        "Fox.glb",
        "mascot"
      ]
    },
    {
      "id": "A4",
      "name": "BoundarySelect",
      "type": "dom_element",
      "semantic": "Dropdown to select boundary type",
      "locator_hints": [
        "#boundaryType",
        "select"
      ]
    },
    {
      "id": "A5",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start simulation",
      "locator_hints": [
        "#startBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A8",
      "name": "StepButton",
      "type": "dom_element",
      "semantic": "Button to advance one discrete step",
      "locator_hints": [
        "#stepBtn"
      ]
    },
    {
      "id": "A9",
      "name": "InfoToggle",
      "type": "dom_element",
      "semantic": "Button to toggle info panel",
      "locator_hints": [
        "#infoToggle"
      ]
    },
    {
      "id": "A10",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Educational info panel",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A11",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display with measurements",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A12",
      "name": "MagmaLayer",
      "type": "3d_object",
      "semantic": "Animated magma layer below plates",
      "locator_hints": [
        "magma",
        "lava plane"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.boundaryType === 'convergent'",
        "window.__3D_STATE__.plateA_x === -11",
        "window.__3D_STATE__.plateB_x === 11"
      ]
    },
    {
      "id": "S1",
      "name": "Fox_Loaded",
      "conditions": [
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.foxPosition !== undefined",
        "!isNaN(window.__3D_STATE__.foxPosition.x)"
      ]
    },
    {
      "id": "S2",
      "name": "Convergent_Step1",
      "conditions": [
        "window.__3D_STATE__.boundaryType === 'convergent'",
        "window.__3D_STATE__.stepCount === 1",
        "window.__3D_STATE__.distance < 22"
      ]
    },
    {
      "id": "S3",
      "name": "Convergent_Collision",
      "conditions": [
        "window.__3D_STATE__.collisionDetected === true",
        "window.__3D_STATE__.boundaryType === 'convergent'"
      ]
    },
    {
      "id": "S4",
      "name": "Convergent_Mountain_Forming",
      "conditions": [
        "window.__3D_STATE__.plateB_y > 0",
        "window.__3D_STATE__.plateA_rotZ < 0 || window.__3D_STATE__.plateA_rotZ > 0",
        "window.__3D_STATE__.collisionDetected === true"
      ]
    },
    {
      "id": "S5",
      "name": "Reset_After_Convergent",
      "conditions": [
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.plateA_x === -11",
        "window.__3D_STATE__.plateB_x === 11",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "Divergent_Selected",
      "conditions": [
        "window.__3D_STATE__.boundaryType === 'divergent'",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Divergent_Ridge_Growing",
      "conditions": [
        "window.__3D_STATE__.boundaryType === 'divergent'",
        "window.__3D_STATE__.stepCount >= 2",
        "window.__3D_STATE__.ridgeHeight > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Transform_Selected",
      "conditions": [
        "window.__3D_STATE__.boundaryType === 'transform'",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Transform_Earthquake",
      "conditions": [
        "window.__3D_STATE__.boundaryType === 'transform'",
        "window.__3D_STATE__.earthquakeCount >= 1",
        "window.__3D_STATE__.stepCount >= 3"
      ]
    },
    {
      "id": "S10",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0"
      ]
    },
    {
      "id": "S11",
      "name": "Info_Panel_Visible",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S12",
      "name": "Info_Panel_Hidden",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#stepBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<20;i++){document.getElementById('stepBtn').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<5;i++){document.getElementById('stepBtn').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('boundaryType').value='divergent'; document.getElementById('boundaryType').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){document.getElementById('stepBtn').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('resetBtn').click(); document.getElementById('boundaryType').value='transform'; document.getElementById('boundaryType').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<6;i++){document.getElementById('stepBtn').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S11",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#infoToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('infoPanel').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoPanel').textContent.length > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S11",
      "to": "S12",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#infoToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('infoPanel').style.display === 'none' || document.getElementById('infoPanel').offsetHeight === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}