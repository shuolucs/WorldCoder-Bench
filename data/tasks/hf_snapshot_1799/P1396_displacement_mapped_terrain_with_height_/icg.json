  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.terrainExists === true",
        "window.__3D_STATE__.heightScale === 2.0",
        "window.__3D_STATE__.wireframe === false",
        "window.__3D_STATE__.historyLength === 1",
        "window.__3D_STATE__.historyIndex === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HeightScaleChanged",
      "conditions": [
        "window.__3D_STATE__.heightScale === 3.5",
        "window.__3D_STATE__.historyLength === 2",
        "window.__3D_STATE__.historyIndex === 1"
      ]
    },
    {
      "id": "S2",
      "name": "WireframeEnabled",
      "conditions": [
        "window.__3D_STATE__.wireframe === true",
        "window.__3D_STATE__.historyLength === 3",
        "window.__3D_STATE__.historyIndex === 2"
      ]
    },
    {
      "id": "S3",
      "name": "ColorChangedToBrown",
      "conditions": [
        "window.__3D_STATE__.colorHex === '#8f6a4a'",
        "window.__3D_STATE__.historyLength === 4",
        "window.__3D_STATE__.historyIndex === 3"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneOnce",
      "conditions": [
        "window.__3D_STATE__.colorHex === '#4a8f4a' || window.__3D_STATE__.wireframe === true",
        "window.__3D_STATE__.historyIndex === 2",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S5",
      "name": "UndoneTwice",
      "conditions": [
        "window.__3D_STATE__.historyIndex === 1",
        "window.__3D_STATE__.wireframe === false"
      ]
    },
    {
      "id": "S6",
      "name": "RedoneOnce",
      "conditions": [
        "window.__3D_STATE__.historyIndex === 2",
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S7",
      "name": "NewActionAfterUndo",
      "conditions": [
        "window.__3D_STATE__.historyIndex === 2",
        "window.__3D_STATE__.canRedo === false"
      ]
    },
    {
      "id": "S8",
      "name": "HeightScaleAtZero",
      "conditions": [
        "window.__3D_STATE__.heightScale === 0",
        "window.__3D_STATE__.historyIndex === 3"
      ]
    },
    {
      "id": "S9",
      "name": "FullUndoToStart",
      "conditions": [
        "window.__3D_STATE__.historyIndex === 0",
        "window.__3D_STATE__.canUndo === false"
      ]
    }
  ],
