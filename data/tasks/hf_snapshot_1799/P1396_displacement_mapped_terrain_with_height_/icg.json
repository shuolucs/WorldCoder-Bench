            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.terrainExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.terrainVertexCount === (256+1)*(256+1)",
            "tier": "L2"
          },
          {
