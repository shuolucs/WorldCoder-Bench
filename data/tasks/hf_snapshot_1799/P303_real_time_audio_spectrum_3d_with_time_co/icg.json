{
  "task_id": "P303_real_time_audio_spectrum_3d_with_time_co",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumBars",
      "type": "3d_object",
      "semantic": "8x8 grid of vertical bars representing audio frequency amplitudes",
      "locator_hints": [
        "64 BoxGeometry meshes in scene"
      ]
    },
    {
      "id": "A2",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle play/pause state",
      "locator_hints": [
        "#btn-playpause"
      ]
    },
    {
      "id": "A3",
      "name": "SlowerButton",
      "type": "dom_element",
      "semantic": "Button to decrease playback rate",
      "locator_hints": [
        "#btn-slower"
      ]
    },
    {
      "id": "A4",
      "name": "FasterButton",
      "type": "dom_element",
      "semantic": "Button to increase playback rate",
      "locator_hints": [
        "#btn-faster"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Range slider for time scrubbing",
      "locator_hints": [
        "#slider-time"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing time, rate, state, orbit",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A8",
      "name": "OrbitToggle",
      "type": "3d_object",
      "semantic": "Camera orbit mode toggled by O key",
      "locator_hints": [
        "keyboard 'O'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.playbackRate === 1.0",
        "window.__3D_STATE__.simTime >= 0",
        "window.__3D_STATE__.barCount === 64",
        "window.__3D_STATE__.orbitEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "Faster_Playback",
      "conditions": [
        "window.__3D_STATE__.playbackRate === 1.25",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S3",
      "name": "Slower_Playback",
      "conditions": [
        "window.__3D_STATE__.playbackRate === 0.75",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "Max_Speed",
      "conditions": [
        "window.__3D_STATE__.playbackRate === 3.0"
      ]
    },
    {
      "id": "S5",
      "name": "Orbit_On",
      "conditions": [
        "window.__3D_STATE__.orbitEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Time_Scrubbed",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simTime >= 49 && window.__3D_STATE__.simTime <= 51"
      ]
    },
    {
      "id": "S7",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.simTime < 1",
        "window.__3D_STATE__.playbackRate === 1.0",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-state').textContent.includes('PAUSED')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-playpause').click(); setTimeout(() => document.getElementById('btn-faster').click(), 200);",
        "delay_after_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-rate').textContent.includes('1.25')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-state').textContent.includes('PLAYING')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-slower').click(); document.getElementById('btn-slower').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-rate').textContent.includes('0.75')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-orbit').textContent.includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('slider-time'); var nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '50'); slider.dispatchEvent(new Event('input', { bubbles: true }));",
        "delay_after_ms": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-state').textContent.includes('PLAYING')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-rate').textContent.includes('1.00') || document.getElementById('hud-rate').textContent.includes('1.0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(var i=0; i<9; i++) { document.getElementById('btn-faster').click(); }",
        "delay_after_ms": 200
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-rate').textContent.includes('3.0')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}