{
  "task_id": "P2104_procedural_bird_flock_formation_animator",
  "affordances": [
    {
      "id": "A1",
      "name": "BoidFlock",
      "type": "3d_object",
      "semantic": "Group of 40 cone-shaped boid meshes representing birds",
      "locator_hints": [
        "scene children with cone geometry",
        "boid mesh array"
      ]
    },
    {
      "id": "A2",
      "name": "XbotLeader",
      "type": "3d_object",
      "semantic": "Loaded Xbot.glb model acting as flock leader marker",
      "locator_hints": [
        "GLTF loaded model",
        "Xbot mesh at leader position"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Translucent reference ground plane at y=0",
