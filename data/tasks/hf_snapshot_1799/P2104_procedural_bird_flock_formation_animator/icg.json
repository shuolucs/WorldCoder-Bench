  "states": [
    {
      "id": "S0",
      "name": "Initial_FreeFlock",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.formationMode === 'FREE_FLOCK'",
        "window.__3D_STATE__.boidCount === 40",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simSpeed === 1.0",
        "window.__3D_STATE__.trailsEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "VFormation_Active",
      "conditions": [
        "window.__3D_STATE__.formationMode === 'V_FORMATION'"
      ]
    },
    {
      "id": "S2",
      "name": "CircleFormation_Active",
      "conditions": [
        "window.__3D_STATE__.formationMode === 'CIRCLE_FORMATION'"
      ]
    },
    {
      "id": "S3",
      "name": "SphereFormation_Active",
      "conditions": [
        "window.__3D_STATE__.formationMode === 'SPHERE_FORMATION'"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed_After_Pause",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "LeaderMoved",
      "conditions": [
        "Math.abs(window.__3D_STATE__.leaderPosition.x) > 0.5 || Math.abs(window.__3D_STATE__.leaderPosition.z) > 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedModified",
      "conditions": [
        "window.__3D_STATE__.simSpeed !== 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "TrailsEnabled",
      "conditions": [
        "window.__3D_STATE__.trailsEnabled === true"
      ]
    },
    {
      "id": "S9",
      "name": "UndoneFormation",
      "conditions": [
        "window.__3D_STATE__.formationHistory.length >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.formationMode === 'FREE_FLOCK'",
        "Math.abs(window.__3D_STATE__.leaderPosition.x) < 1.0",
        "Math.abs(window.__3D_STATE__.leaderPosition.y - 25) < 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.xbotLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidCount === 40",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.boidPositions) && window.__3D_STATE__.boidPositions.length === 40",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boidPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z) && isFinite(p.x) && isFinite(p.y) && isFinite(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-v"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory[window.__3D_STATE__.formationHistory.length - 1] === 'FREE_FLOCK'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('V_FORMATION')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-circle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'CIRCLE_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory[window.__3D_STATE__.formationHistory.length - 1] === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('CIRCLE_FORMATION')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgSpeed === 'number' && !isNaN(window.__3D_STATE__.avgSpeed)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-undo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('V_FORMATION')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidCount === 40",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.centerOfMass === 'object' && !isNaN(window.__3D_STATE__.centerOfMass.x)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S9",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-paused').textContent.includes('PAUSED')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boidVelocities.every(v => !isNaN(v.x) && !isNaN(v.y) && !isNaN(v.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-paused').textContent.includes('RUNNING')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidPositions.every(p => Math.sqrt(p.x*p.x + (p.y-25)*(p.y-25) + p.z*p.z) < 60)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidVelocities.every(v => Math.sqrt(v.x*v.x + v.y*v.y + v.z*v.z) <= window.__3D_STATE__.maxSpeed + 0.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const st = window.__3D_STATE__; window.__preLeaderX = st.leaderPosition.x; window.__preLeaderZ = st.leaderPosition.z; for(let i=0;i<30;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight',bubbles:true}));} await new Promise(r=>setTimeout(r,600)); for(let i=0;i<30;i++){document.dispatchEvent(new KeyboardEvent('keyup',{key:'ArrowRight',bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leaderPosition.x > window.__preLeaderX + 0.1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.xbotPosition === 'object' && !isNaN(window.__3D_STATE__.xbotPosition.x)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leaderPosition.x - window.__3D_STATE__.xbotPosition.x) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leaderPosition.y - window.__3D_STATE__.xbotPosition.y) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-leader-pos') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'+',bubbles:true})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'+',bubbles:true})); await new Promise(r=>setTimeout(r,200)); document.dispatchEvent(new KeyboardEvent('keydown',{key:'+',bubbles:true})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'+',bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-sim-speed').textContent.includes('1.50')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed >= 0.25 && window.__3D_STATE__.simSpeed <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simSpeed) && isFinite(window.__3D_STATE__.simSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.trailsEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-trails').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidCount === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationMode === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-sphere"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'SPHERE_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationHistory[window.__3D_STATE__.formationHistory.length - 1] === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('SPHERE_FORMATION')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trailsEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S3",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'z',ctrlKey:true,bubbles:true})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'z',ctrlKey:true,bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'V_FORMATION'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('V_FORMATION')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidCount === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.centerOfMass !== undefined && !isNaN(window.__3D_STATE__.centerOfMass.x) && !isNaN(window.__3D_STATE__.centerOfMass.y) && !isNaN(window.__3D_STATE__.centerOfMass.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.sqrt(Math.pow(window.__3D_STATE__.centerOfMass.x,2)+Math.pow(window.__3D_STATE__.centerOfMass.y-25,2)+Math.pow(window.__3D_STATE__.centerOfMass.z,2)) < 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formationMode === 'FREE_FLOCK'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leaderPosition.x) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leaderPosition.y - 25) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leaderPosition.z) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-formation').textContent.includes('FREE_FLOCK')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boidPositions.every(p => Math.sqrt(p.x*p.x + (p.y-25)*(p.y-25) + p.z*p.z) < 20)",
