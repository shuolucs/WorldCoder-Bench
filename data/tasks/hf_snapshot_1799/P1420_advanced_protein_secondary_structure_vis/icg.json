    {
      "id": "S8",
      "name": "RamachandranToggled",
      "conditions": [
        "window.__3D_STATE__.ramachandranVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "Optimized",
      "conditions": [
        "window.__3D_STATE__.optimizeCount >= 1",
        "window.__3D_STATE__.lastAction === 'optimize'"
      ]
    },
    {
      "id": "S10",
      "name": "RamachandranHidden",
      "conditions": [
        "window.__3D_STATE__.ramachandranVisible === false"
      ]
    },
    {
      "id": "S11",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.helixCount === 10",
        "window.__3D_STATE__.sheetCount === 8",
        "window.__3D_STATE__.coilCount === 12",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    }
