{
  "task_id": "P1420_advanced_protein_secondary_structure_vis",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinBackbone",
      "type": "3d_object",
      "semantic": "The 3D tube/spline representing the protein backbone colored by secondary structure type",
      "locator_hints": [
        "backbone tube mesh",
        "spline geometry"
      ]
    },
    {
      "id": "A2",
      "name": "ResidueSpheres",
      "type": "3d_object",
      "semantic": "30 small spheres at Cα positions, clickable for selection",
      "locator_hints": [
        "sphere meshes",
        "Cα markers",
        "residue[i]"
      ]
    },
    {
      "id": "A3",
      "name": "HydrogenBonds",
      "type": "3d_object",
      "semantic": "Dashed cyan lines between helix residues i and i+4",
      "locator_hints": [
        "dashed line",
        "cyan lines",
        "H-bond indicators"
      ]
    },
    {
      "id": "A4",
