        "button containing 'Reset'"
      ]
    },
    {
      "id": "A7",
      "name": "RamachandranOverlay",
      "type": "dom_element",
      "semantic": "300x300 canvas overlay showing phi/psi scatter plot, toggled by R key",
      "locator_hints": [
        "canvas overlay",
        "Ramachandran plot",
        "top-right 300x300"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.selectedIndex === 0",
        "window.__3D_STATE__.residues.length === 30",
        "window.__3D_STATE__.helixCount === 10",
        "window.__3D_STATE__.sheetCount === 8",
        "window.__3D_STATE__.coilCount === 12",
        "window.__3D_STATE__.ramachandranVisible === false",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "ResidueNavigated",
      "conditions": [
        "window.__3D_STATE__.selectedIndex === 1",
        "window.__3D_STATE__.lastAction === 'select'"
      ]
    },
    {
      "id": "S2",
      "name": "NavigatedToHelixResidue",
      "conditions": [
        "window.__3D_STATE__.selectedIndex === 5",
        "window.__3D_STATE__.residues[5].type === 'helix'"
      ]
    },
    {
      "id": "S3",
      "name": "HelixConvertedToSheet",
      "conditions": [
        "window.__3D_STATE__.residues[5].type === 'sheet'",
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'toSheet'"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneConversion",
      "conditions": [
        "window.__3D_STATE__.residues[5].type === 'helix'",
        "window.__3D_STATE__.redoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S5",
      "name": "RedoneConversion",
      "conditions": [
        "window.__3D_STATE__.residues[5].type === 'sheet'",
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S6",
      "name": "SecondUndone",
      "conditions": [
        "window.__3D_STATE__.residues[5].type === 'helix'",
        "window.__3D_STATE__.lastAction === 'undo'"
