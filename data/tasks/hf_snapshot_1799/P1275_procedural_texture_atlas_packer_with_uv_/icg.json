            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasUsage === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTiles === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData[3].slot === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasCanvasValid === true",
