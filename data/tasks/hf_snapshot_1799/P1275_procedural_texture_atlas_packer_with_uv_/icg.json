          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add_tile'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData[0].type.toLowerCase().includes('noise')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasUsage === 6.25",
            "tier": "L2"
          }
        ]
      }
    },
    {
