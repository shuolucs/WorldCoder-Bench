  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Atlas",
      "conditions": [
        "window.__3D_STATE__.tileCount === 0",
        "window.__3D_STATE__.atlasUsage === 0",
        "window.__3D_STATE__.rotationEnabled === true",
        "window.__3D_STATE__.lastAction === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "One_Tile_Added",
      "conditions": [
        "window.__3D_STATE__.tileCount === 1",
        "window.__3D_STATE__.atlasUsage === 6.25"
      ]
    },
    {
      "id": "S2",
      "name": "Multiple_Tiles_Added",
      "conditions": [
        "window.__3D_STATE__.tileCount >= 3",
        "window.__3D_STATE__.atlasUsage >= 18.75"
      ]
    },
    {
      "id": "S3",
      "name": "Rotation_Toggled_Off",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "Rotation_Toggled_Back_On",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "UVs_Randomized",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'randomize_uvs'"
      ]
    },
    {
      "id": "S6",
      "name": "Atlas_Cleared",
      "conditions": [
        "window.__3D_STATE__.tileCount === 0",
        "window.__3D_STATE__.atlasUsage === 0",
        "window.__3D_STATE__.lastAction === 'clear_atlas'"
      ]
    },
    {
      "id": "S7",
      "name": "Tiles_After_Clear",
      "conditions": [
        "window.__3D_STATE__.tileCount >= 1",
        "window.__3D_STATE__.tilesData.length >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "Keyboard_Tile_Added",
      "conditions": [
        "window.__3D_STATE__.tileCount >= 2",
        "window.__3D_STATE__.lastAction === 'add_tile'"
      ]
    },
    {
      "id": "S9",
      "name": "Four_Tiles_Full_Row",
      "conditions": [
        "window.__3D_STATE__.tileCount === 4",
        "window.__3D_STATE__.atlasUsage === 25"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addTileBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.tileCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tileCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasUsage === 6.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData[0].slot === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tilesData[0].type === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('textureType').value = document.getElementById('textureType').options[1].value; document.getElementById('textureType').dispatchEvent(new Event('change')); document.getElementById('addTileBtn').click(); setTimeout(() => document.getElementById('addTileBtn').click(), 200);",
        "delay": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tileCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasUsage >= 18.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData.length >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData[1].slot === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData[2].slot === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add_tile'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_rotation'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.boxRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.boxRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tileCount >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const rotBefore = window.__3D_STATE__.boxRotationY; window.__testRotBefore = rotBefore; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'r'}));",
        "delay": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_rotation'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.boxRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boxRotationY !== window.__testRotBefore || window.__3D_STATE__.rotationEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__uvBefore = JSON.stringify(window.__3D_STATE__.uvAssignments); document.getElementById('assignRandomBtn').click();",
        "delay": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'randomize_uvs'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.uvAssignments)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.uvAssignments.length === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvAssignments.every(v => typeof v === 'number' && v >= 0 && v < window.__3D_STATE__.tileCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshFaceCount === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
