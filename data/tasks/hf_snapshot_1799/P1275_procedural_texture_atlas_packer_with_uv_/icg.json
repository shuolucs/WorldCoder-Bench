          {
            "expr": "window.__3D_STATE__.atlasUsage === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tilesData.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'clear_atlas'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uvAssignments.every(v => v === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atlasCanvasValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
