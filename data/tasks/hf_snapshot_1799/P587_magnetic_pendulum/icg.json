{
  "task_id": "P587_magnetic_pendulum",
  "affordances": [
    {"id": "A1", "name": "PendulumBob", "type": "3d_object", "semantic": "Metallic sphere bob hanging from pivot", "locator_hints": ["sphere mesh metallic"]},
    {"id": "A2", "name": "Magnets", "type": "3d_object", "semantic": "3 colored magnets in equilateral triangle", "locator_hints": ["cylinder meshes red green blue with emissive"]},
    {"id": "A3", "name": "Trail", "type": "3d_object", "semantic": "Color-coded trail line behind bob", "locator_hints": ["line geometry with vertex colors"]},
    {"id": "A4", "name": "FractalCanvas", "type": "dom_element", "semantic": "2D fractal initial condition map", "locator_hints": ["#fractal-canvas"]},
    {"id": "A5", "name": "MagnetSlider", "type": "dom_element", "semantic": "Magnet strength control", "locator_hints": ["#slider-magnet-strength"]},
    {"id": "A6", "name": "DampingSlider", "type": "dom_element", "semantic": "Damping control", "locator_hints": ["#slider-damping"]},
    {"id": "A7", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.frameCount > 0", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Swinging", "conditions": ["window.__3D_STATE__.bobSpeed > 0.01"]},
    {"id": "S2", "name": "Settled", "conditions": ["window.__3D_STATE__.bobSpeed < 0.05"]},
    {"id": "S3", "name": "MagnetChanged", "conditions": ["window.__3D_STATE__.magnetStrength !== 1.0"]},
    {"id": "S4", "name": "Randomized", "conditions": ["window.__3D_STATE__.bobSpeed > 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.nearestMagnet >= 1 && window.__3D_STATE__.nearestMagnet <= 3", "tier": "L1"},
        {"expr": "window.__3D_STATE__.bobPosition !== undefined && typeof window.__3D_STATE__.bobPosition.x === 'number'", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bobSpeed > 0 || window.__3D_STATE__.bobSpeed === 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.bobPosition.y < 5 && window.__3D_STATE__.bobPosition.y >= 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-magnet-strength').value = 3.5; document.getElementById('slider-magnet-strength').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.magnetStrength >= 3.0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-damping').value = 0.35; document.getElementById('slider-damping').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.damping >= 0.30", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "c"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.bobPosition.x !== before.bobPosition.x || window.__3D_STATE__.bobPosition.z !== before.bobPosition.z", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.trailVisible !== before.trailVisible", "tier": "L2"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "Math.abs(window.__3D_STATE__.bobPosition.x - 1.5) < 0.5", "tier": "L2"}
      ]}
    }
  ]
}
