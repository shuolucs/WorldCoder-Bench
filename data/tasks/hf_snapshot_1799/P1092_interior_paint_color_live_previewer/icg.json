            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object' && !isNaN(window.__3D_STATE__.cameraPosition.x)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const cp = document.getElementById('customColor'); if(cp) { const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(cp, '#8B2500'); cp.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.walls[0].color.toLowerCase() === '#8b2500'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[0].metalness === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[0].roughness >= 0.0 && window.__3D_STATE__.walls[0].roughness <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedWall === 'left'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#applyAllBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.applyAllCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[0].color.toLowerCase() === window.__3D_STATE__.walls[1].color.toLowerCase()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[1].color.toLowerCase() === window.__3D_STATE__.walls[2].color.toLowerCase()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === window.__3D_STATE__.walls[3].color.toLowerCase()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => w.metalness === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[0].color.toLowerCase() !== window.__3D_STATE__.walls[1].color.toLowerCase() || window.__3D_STATE__.walls[1].color.toLowerCase() !== window.__3D_STATE__.walls[2].color.toLowerCase()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => w.roughness >= 0.0 && w.roughness <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => w.metalness === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Escape"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedWall === null",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('selectedWallLabel').textContent.toLowerCase().includes('no')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => typeof w.color === 'string' && w.color.match(/^#[0-9a-fA-F]{6}$/))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightIntensity === 'number' && Math.abs(window.__3D_STATE__.lightIntensity - 1.2) < 0.1",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cameraPosition.y) && window.__3D_STATE__.cameraPosition.y > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const ub = document.getElementById('undoBtn'); if(ub) { ub.click(); ub.click(); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => w.metalness === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => w.roughness >= 0.0 && w.roughness <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.every(w => typeof w.color === 'string' && w.color.length === 7)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex >= -1",
            "tier": "L2"
          }
        ]
      }
