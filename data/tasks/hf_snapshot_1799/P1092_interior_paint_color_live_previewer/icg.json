  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.walls.length === 4",
        "window.__3D_STATE__.selectedWall === null",
        "window.__3D_STATE__.historyIndex === -1",
        "window.__3D_STATE__.historyLength === 0"
      ]
    },
    {
      "id": "S1",
      "name": "WallSelectedViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.selectedWall === 'back'"
      ]
    },
    {
      "id": "S2",
      "name": "ColorAppliedToBackWall",
      "conditions": [
        "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
        "window.__3D_STATE__.historyLength >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "FinishChangedToGloss",
      "conditions": [
        "window.__3D_STATE__.walls[2].roughness <= 0.1 + 0.01",
        "window.__3D_STATE__.historyLength >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "UndoneFinishChange",
      "conditions": [
        "Math.abs(window.__3D_STATE__.walls[2].roughness - 0.7) < 0.05",
        "window.__3D_STATE__.undoCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoneFinishChange",
      "conditions": [
        "window.__3D_STATE__.walls[2].roughness <= 0.1 + 0.01",
        "window.__3D_STATE__.redoCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "SecondWallSelected",
      "conditions": [
        "window.__3D_STATE__.selectedWall === 'left'"
      ]
    },
    {
      "id": "S7",
      "name": "CustomColorApplied",
      "conditions": [
        "window.__3D_STATE__.walls[0].color.toLowerCase() !== '#e8e0d4'"
      ]
    },
    {
      "id": "S8",
      "name": "ApplyAllExecuted",
      "conditions": [
        "window.__3D_STATE__.applyAllCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "UndoApplyAll",
      "conditions": [
        "window.__3D_STATE__.undoCount >= 2"
      ]
    },
    {
      "id": "S10",
      "name": "WallDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedWall === null"
      ]
    },
    {
      "id": "S11",
      "name": "MultiUndoComplete",
      "conditions": [
        "window.__3D_STATE__.undoCount >= 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedWall === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedWall === 'back'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls !== undefined && Array.isArray(window.__3D_STATE__.walls)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#e8e0d4'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('selectedWallLabel').textContent.toLowerCase().includes('back')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelectorAll('[data-color]').forEach(el => { if(el.getAttribute('data-color') === '#2C3E6B' || el.style.backgroundColor === 'rgb(44, 62, 107)') el.click(); }); if(window.__3D_STATE__.walls[2].color.toLowerCase() === '#e8e0d4') { const swatches = document.querySelectorAll('.swatch, [class*=swatch], [class*=color]'); if(swatches.length >= 3) swatches[2].click(); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].metalness === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedWall === 'back'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sel = document.getElementById('finishSelect'); if(sel) { sel.value = 'Gloss'; sel.dispatchEvent(new Event('change', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.walls[2].roughness <= 0.11",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].roughness >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'Gloss'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#undoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.walls[2].roughness - 0.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].metalness === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.walls[2].roughness <= 0.11",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[2].color.toLowerCase() === '#2c3e6b'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinish === 'Gloss' || window.__3D_STATE__.walls[2].roughness <= 0.11",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedWall === 'left'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.walls[0].color.toLowerCase() === '#e8e0d4'",
