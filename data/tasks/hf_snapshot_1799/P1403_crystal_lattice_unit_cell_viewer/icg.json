      ]
    },
    {
      "id": "S6",
      "name": "SlicePlaneActive",
      "conditions": [
        "window.__3D_STATE__.slicePlaneVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "SlicePlaneMoved",
      "conditions": [
        "window.__3D_STATE__.slicePlaneVisible === true",
        "Math.abs(window.__3D_STATE__.sliceY - 1.75) < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "SwitchedToDiamond",
      "conditions": [
        "window.__3D_STATE__.latticeType === 'Diamond'",
        "window.__3D_STATE__.effectiveAtoms === 8",
        "window.__3D_STATE__.latticeConstant === 4.0"
