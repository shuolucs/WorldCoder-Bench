  "states": [
    {
      "id": "S0",
      "name": "InitialBCC",
      "conditions": [
        "window.__3D_STATE__.latticeType === 'BCC'",
        "window.__3D_STATE__.atomCount === 9",
        "window.__3D_STATE__.effectiveAtoms === 2",
        "window.__3D_STATE__.autoRotating === true",
        "window.__3D_STATE__.expanded === false",
        "window.__3D_STATE__.slicePlaneVisible === false",
        "window.__3D_STATE__.selectedAtomIndex === -1",
        "window.__3D_STATE__.historyIndex === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SwitchedToFCC",
      "conditions": [
        "window.__3D_STATE__.latticeType === 'FCC'",
        "window.__3D_STATE__.atomCount === 14",
        "window.__3D_STATE__.effectiveAtoms === 4"
      ]
    },
    {
      "id": "S2",
      "name": "SwitchedToSC",
      "conditions": [
        "window.__3D_STATE__.latticeType === 'SC'",
        "window.__3D_STATE__.atomCount === 8",
        "window.__3D_STATE__.effectiveAtoms === 1"
      ]
    },
    {
