      ]
    },
    {
      "id": "S10",
      "name": "Collapsed",
      "conditions": [
        "window.__3D_STATE__.expanded === false",
        "Math.abs(window.__3D_STATE__.expansionFactor - 1.0) < 0.05"
      ]
    },
    {
      "id": "S11",
      "name": "AtomSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAtomIndex >= 0",
        "window.__3D_STATE__.selectedAtomType !== ''"
      ]
    }
  ],
