{
  "task_id": "P1995_coral_reef_bleaching_temperature_simulat",
  "affordances": [
    {
      "id": "A1",
      "name": "CoralReef",
      "type": "3d_object",
      "semantic": "Array of 12 coral objects on the ocean floor that change color based on temperature stress",
      "locator_hints": [
        "coral_0 through coral_11",
        "CylinderGeometry branches grouped per coral"
      ]
    },
    {
      "id": "A2",
      "name": "OceanFloor",
      "type": "3d_object",
      "semantic": "Sandy plane at y=0 serving as the seabed",
      "locator_hints": [
        "PlaneGeometry(30,30)",
        "color 0xc2a366"
      ]
    },
    {
      "id": "A3",
      "name": "BubbleParticles",
      "type": "3d_object",
      "semantic": "200 small spheres drifting upward simulating underwater bubbles",
      "locator_hints": [
        "radius 0.03",
        "blue-white spheres"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing temperature, status, and coral counts",
      "locator_hints": [
        "#hud",
        "#tempDisplay",
        "#simStatus",
        "#healthyCount",
        "#bleachingCount",
        "#deadCount"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial healthy state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume the bleaching simulation",
      "locator_hints": [
        "#toggleBtn"
      ]
    },
    {
      "id": "A7",
      "name": "CoralInfoPanel",
      "type": "dom_element",
      "semantic": "Bottom panel showing selected coral details",
      "locator_hints": [
        "#coralInfo"
      ]
    },
    {
      "id": "A8",
      "name": "TemperatureBar",
      "type": "dom_element",
      "semantic": "Horizontal gradient bar indicating current temperature",
      "locator_hints": [
        "#tempBar"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialHealthy",
      "conditions": [
        "window.__3D_STATE__.temperature === 26.0",
        "window.__3D_STATE__.corals.length === 12",
        "window.__3D_STATE__.corals.every(c => c.health === 1.0 && c.bleachLevel === 0.0 && c.isDead === false)",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S1",
      "name": "TemperatureRaised",
      "conditions": [
        "window.__3D_STATE__.temperature > 26.0"
      ]
    },
    {
      "id": "S2",
      "name": "BleachingActive",
      "conditions": [
        "window.__3D_STATE__.temperature > 29.0",
        "window.__3D_STATE__.totalBleachLevel > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SevereBleaching",
      "conditions": [
        "window.__3D_STATE__.temperature > 32.0",
        "window.__3D_STATE__.corals.some(c => c.health < 0.5)"
      ]
    },
    {
      "id": "S4",
      "name": "CoralsDying",
      "conditions": [
        "window.__3D_STATE__.deadCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "CoralSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCoralIndex !== null"
      ]
    },
    {
      "id": "S7",
      "name": "RecoveryPhase",
      "conditions": [
        "window.__3D_STATE__.temperature <= 29.0",
        "window.__3D_STATE__.totalBleachLevel > 0"
      ]
    },
    {
      "id": "S8",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.temperature === 26.0",
        "window.__3D_STATE__.corals.every(c => c.health === 1.0 && c.bleachLevel === 0.0 && c.isDead === false)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.corals) && window.__3D_STATE__.corals.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 26.0 && !isNaN(window.__3D_STATE__.temperature)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.every(c => c.health === 1.0 && c.bleachLevel === 0.0 && c.isDead === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.healthyCount === 12 && window.__3D_STATE__.deadCount === 0 && window.__3D_STATE__.bleachingCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "repeat": 6
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 29.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 20.0 && window.__3D_STATE__.temperature <= 35.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('tempDisplay') !== null && document.getElementById('tempDisplay').textContent.includes('29.0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let prev = window.__3D_STATE__.totalBleachLevel; window.__prevBleach = prev; for(let i=0;i<2;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));} await new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 30.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBleachLevel > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBleachLevel > (window.__prevBleach || 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.some(c => c.bleachLevel > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.every(c => !isNaN(c.bleachLevel) && c.bleachLevel >= 0 && c.bleachLevel <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalBleachLevel - window.__3D_STATE__.corals.reduce((s,c) => s + c.bleachLevel, 0)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<6;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));} await new Promise(r => setTimeout(r, 4000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 33.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.some(c => c.health < 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.every(c => !isNaN(c.health) && c.health >= 0.0 && c.health <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bleachingCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.healthyCount < 12",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preDeadCount = window.__3D_STATE__.deadCount; await new Promise(r => setTimeout(r, 6000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.deadCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.filter(c => c.isDead).length === window.__3D_STATE__.deadCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.filter(c => c.isDead).every(c => c.health === 0.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.healthyCount + window.__3D_STATE__.bleachingCount + window.__3D_STATE__.deadCount <= 12",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.deadCount === 'number' && Number.isInteger(window.__3D_STATE__.deadCount)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus') !== null && document.getElementById('simStatus').textContent.includes('Paused')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleBtn') !== null && document.getElementById('toggleBtn').textContent.includes('Resume')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__frozenBleach = window.__3D_STATE__.totalBleachLevel; window.__frozenDead = window.__3D_STATE__.deadCount; await new Promise(r => setTimeout(r, 1500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalBleachLevel - window.__frozenBleach) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deadCount === window.__frozenDead",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.every(c => !isNaN(c.health) && !isNaN(c.bleachLevel))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 200 || typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('toggleBtn').click(); for(let i=0;i<30;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));} await new Promise(r => setTimeout(r, 500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature <= 29.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 20.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus') !== null && document.getElementById('simStatus').textContent.includes('Running')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.filter(c => c.isDead).every(c => c.health === 0.0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preRecoveryBleach = window.__3D_STATE__.totalBleachLevel; window.__preRecoveryDeadCount = window.__3D_STATE__.deadCount; await new Promise(r => setTimeout(r, 3000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalBleachLevel <= window.__preRecoveryBleach",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deadCount === window.__preRecoveryDeadCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.filter(c => c.isDead).length === window.__preRecoveryDeadCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.filter(c => !c.isDead).every(c => c.health >= 0 && c.health <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalBleachLevel - window.__3D_STATE__.corals.reduce((s,c) => s + c.bleachLevel, 0)) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 26.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.length === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corals.every(c => c.health === 1.0 && c.bleachLevel === 0.0 && c.isDead === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.healthyCount === 12 && window.__3D_STATE__.deadCount === 0 && window.__3D_STATE__.bleachingCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalBleachLevel === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempDisplay').textContent.includes('26.0')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}