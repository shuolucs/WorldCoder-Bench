  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === null",
        "window.__3D_STATE__.laptopA_angle === 110",
        "window.__3D_STATE__.laptopB_angle === 110",
        "window.__3D_STATE__.comparisonActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "LaptopASelected",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'A'",
        "window.__3D_STATE__.laptopA_elevated === true"
      ]
    },
    {
      "id": "S2",
      "name": "LaptopAAngleIncreased",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'A'",
        "window.__3D_STATE__.laptopA_angle === 120"
      ]
    },
    {
      "id": "S3",
      "name": "LaptopBSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'B'",
        "window.__3D_STATE__.laptopB_elevated === true",
        "window.__3D_STATE__.laptopA_elevated === false"
      ]
    },
    {
      "id": "S4",
      "name": "LaptopBGoldTheme",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 'B'",
        "window.__3D_STATE__.laptopB_goldTheme === true"
      ]
    },
    {
      "id": "S5",
      "name": "ComparisonActive",
      "conditions": [
        "window.__3D_STATE__.comparisonActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "ComparisonDeactivated",
      "conditions": [
        "window.__3D_STATE__.comparisonActive === false"
      ]
    },
    {
      "id": "S7",
      "name": "LaptopBAngleDecreased",
      "conditions": [
        "window.__3D_STATE__.laptopB_angle === 100"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "LaptopA",
        "position_hint": "click on left laptop around x=-2.5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.laptopA_angle !== before.laptopA_angle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.laptopA_angle === 'number' && !isNaN(window.__3D_STATE__.laptopA_angle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.laptopB_angle === 'number' && !isNaN(window.__3D_STATE__.laptopB_angle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.laptopA_elevated === 'boolean'",
