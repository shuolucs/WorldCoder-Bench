        "code": "const td = window.__3D_STATE__.treeData; let targetId = null; for(let i=0;i<td.length;i++){if(!td[i].removed){targetId=td[i].id;break;}} if(targetId!==null){window.__3D_STATE__.selectedTreeId = targetId;} await new Promise(r=>setTimeout(r,500));"
