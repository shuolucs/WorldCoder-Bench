          {
            "expr": "window.__3D_STATE__.heightMap[30 * 60 + 30] >= 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.netVolume - (window.__3D_STATE__.cutVolume - window.__3D_STATE__.fillVolume)) < 0.01",
            "tier": "L2"
          }
        ]
