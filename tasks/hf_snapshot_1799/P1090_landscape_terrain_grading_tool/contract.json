    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-raise').click(); const state = window.__3D_STATE__; const cx = 30, cz = 30, r = 3; for(let iz = 0; iz < 60; iz++) { for(let ix = 0; ix < 60; ix++) { const dx = ix - cx, dz = iz - cz; if(Math.sqrt(dx*dx + dz*dz) <= r) { const idx = iz * 60 + ix; state.heightMap[idx] += 3.0; }}} if(typeof state._applyHeightMap === 'function') state._applyHeightMap(); else { const ev = new CustomEvent('terrain-modified'); window.dispatchEvent(ev); }"
      },
