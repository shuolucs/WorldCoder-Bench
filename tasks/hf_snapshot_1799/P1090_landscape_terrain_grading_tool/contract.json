        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxElevation > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.verticesModified > 0 || window.__3D_STATE__.maxElevation >= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cutVolume > 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.maxElevation) && Number.isFinite(window.__3D_STATE__.avgElevation)",
            "tier": "L2"
