        "type": "script",
        "code": "document.getElementById('btn-lower').click(); const state = window.__3D_STATE__; const cx = 10, cz = 10, r = 4; for(let iz = 0; iz < 60; iz++) { for(let ix = 0; ix < 60; ix++) { const dx = ix - cx, dz = iz - cz; if(Math.sqrt(dx*dx + dz*dz) <= r) { const idx = iz * 60 + ix; state.heightMap[idx] -= 4.0; }}} if(typeof state._applyHeightMap === 'function') state._applyHeightMap(); else { window.dispatchEvent(new CustomEvent('terrain-modified')); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.minElevation < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fillVolume > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTool === 'lower'",
            "tier": "L2"
          },
