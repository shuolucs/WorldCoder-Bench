            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.minElevation) && !isNaN(window.__3D_STATE__.fillVolume)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cutVolume >= 0 && window.__3D_STATE__.fillVolume >= 0",
            "tier": "L2"
          }
        ]
