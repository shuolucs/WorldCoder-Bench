  "affordances": [
    {
      "id": "A1",
      "name": "Runner",
      "type": "3d_object",
      "semantic": "The MosquitoInAmber GLB model acting as the parkour runner character",
      "locator_hints": [
        "GLB model loaded via GLTFLoader",
        "scaled to 0.5"
      ]
    },
    {
      "id": "A2",
      "name": "Platforms",
      "type": "3d_object",
      "semantic": "Array of 20 floating green box platforms forming the parkour course",
      "locator_hints": [
        "BoxGeometry(3, 0.5, 3)",
        "green material"
      ]
    },
    {
      "id": "A3",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last move",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A4",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone move",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset game to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay displaying platform, moves, undos, redos",
      "locator_hints": [
        "top-left DOM overlay div"
      ]
    },
    {
      "id": "A7",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "Follow camera tracking the runner",
      "locator_hints": [
        "PerspectiveCamera"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.modelLoaded === undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Ready_OnPlatform0",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentPlatform === 0",
        "window.__3D_STATE__.grounded === true",
        "window.__3D_STATE__.moveCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Jumping_FromPlatform0",
      "conditions": [
        "window.__3D_STATE__.grounded === false",
        "window.__3D_STATE__.velocityY > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Landed_OnPlatform1",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 1",
        "window.__3D_STATE__.grounded === true",
        "window.__3D_STATE__.moveCount === 1"
      ]
    },
    {
      "id": "S4",
      "name": "Landed_OnPlatform2",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 2",
        "window.__3D_STATE__.grounded === true",
        "window.__3D_STATE__.moveCount === 2"
      ]
    },
    {
      "id": "S5",
      "name": "After_Undo_BackToPlatform1",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 1",
        "window.__3D_STATE__.undoCount >= 1",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "After_Redo_BackToPlatform2",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 2",
        "window.__3D_STATE__.redoCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Landed_OnPlatform3",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 3",
        "window.__3D_STATE__.grounded === true",
        "window.__3D_STATE__.moveCount >= 3"
      ]
    },
    {
      "id": "S8",
      "name": "After_DoubleUndo_BackToPlatform1",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 1",
        "window.__3D_STATE__.undoCount >= 3"
      ]
    },
    {
      "id": "S9",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.currentPlatform === 0",
        "window.__3D_STATE__.moveCount === 0",
        "window.__3D_STATE__.undoCount === 0",
        "window.__3D_STATE__.redoCount === 0"
      ]
    }
  ],
