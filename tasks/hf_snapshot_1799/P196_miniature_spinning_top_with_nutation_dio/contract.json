  "affordances": [
    {
      "id": "A1",
      "name": "DuckSpinningTop",
      "type": "3d_object",
      "semantic": "The Duck.glb model acting as a spinning top on the table",
      "locator_hints": [
        "scene.children with gltf model",
        "duck model at origin"
      ]
    },
    {
      "id": "A2",
      "name": "TablePlatform",
      "type": "3d_object",
      "semantic": "Circular brown platform representing the table surface",
      "locator_hints": [
        "CircleGeometry or CylinderGeometry with brown color"
      ]
    },
    {
      "id": "A3",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Semi-transparent overlay showing physics readouts",
      "locator_hints": [
        "div with monospace font at top-left"
      ]
    },
    {
      "id": "A4",
      "name": "SlowMotionButton",
      "type": "dom_element",
      "semantic": "Button to toggle slow motion mode",
      "locator_hints": [
        "button with text 'Slow Motion'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.isSpinning === false",
        "window.__3D_STATE__.spinRate < 0.2"
      ]
    },
    {
      "id": "S1",
      "name": "Spinning_Started",
      "conditions": [
        "window.__3D_STATE__.isSpinning === true",
        "window.__3D_STATE__.spinRate >= 25"
      ]
    },
    {
      "id": "S2",
      "name": "Nutation_Active",
      "conditions": [
        "window.__3D_STATE__.isSpinning === true",
        "window.__3D_STATE__.nutationAngle > 0.05"
      ]
    },
    {
      "id": "S3",
      "name": "Boosted",
      "conditions": [
        "window.__3D_STATE__.boostCount >= 1",
        "window.__3D_STATE__.spinRate >= 35"
      ]
    },
    {
      "id": "S4",
      "name": "Friction_Disabled",
      "conditions": [
        "window.__3D_STATE__.frictionEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "Slow_Motion_Active",
      "conditions": [
        "window.__3D_STATE__.timeScale === 0.2"
      ]
    },
    {
      "id": "S6",
      "name": "Moon_Gravity",
      "conditions": [
        "window.__3D_STATE__.gravityLabel === 'Moon'",
        "Math.abs(window.__3D_STATE__.gravity - 1.62) < 0.1"
      ]
    },
    {
      "id": "S7",
      "name": "Jupiter_Gravity",
      "conditions": [
        "window.__3D_STATE__.gravityLabel === 'Jupiter'",
        "Math.abs(window.__3D_STATE__.gravity - 24.79) < 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "Tilt_Adjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.tiltSetting - 0.35) < 0.01"
      ]
    },
    {
      "id": "S9",
      "name": "Spinning_Decayed",
      "conditions": [
        "window.__3D_STATE__.spinRate < 5",
        "window.__3D_STATE__.spinRate > 0.5"
      ]
    },
    {
      "id": "S10",
      "name": "Fallen_Over",
      "conditions": [
        "window.__3D_STATE__.hasFallenOver === true"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.isSpinning === false",
        "window.__3D_STATE__.simTime < 0.1"
      ]
    }
  ],
