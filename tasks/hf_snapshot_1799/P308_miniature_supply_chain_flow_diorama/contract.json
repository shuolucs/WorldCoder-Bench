    {
      "id": "A9",
      "name": "Parcels",
      "type": "3d_object",
      "semantic": "Blue cubes traveling along supply chain paths",
      "locator_hints": [
        "blue small cubes on paths"
      ]
    },
    {
      "id": "A10",
      "name": "TableSurface",
      "type": "3d_object",
      "semantic": "Brown wooden table surface base",
      "locator_hints": [
        "large brown box at y=-0.25"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalSpawned === 0",
        "window.__3D_STATE__.totalDelivered === 0",
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.cameraPreset === 1"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.totalSpawned > 0"
      ]
    },
    {
      "id": "S2",
      "name": "ParcelsDelivering",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.totalDelivered > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2"
      ]
    },
    {
      "id": "S4",
      "name": "CameraTopDown",
      "conditions": [
        "window.__3D_STATE__.cameraPreset === 2"
      ]
    },
    {
      "id": "S5",
      "name": "BuildingSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBuilding !== null"
      ]
    },
    {
      "id": "S6",
      "name": "HeatmapActive",
      "conditions": [
        "window.__3D_STATE__.heatmapEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalSpawned === 0",
        "window.__3D_STATE__.totalInTransit === 0",
        "window.__3D_STATE__.totalDelivered === 0",
        "window.__3D_STATE__.parcelCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btn-speed"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.querySelector('#btn-speed').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
