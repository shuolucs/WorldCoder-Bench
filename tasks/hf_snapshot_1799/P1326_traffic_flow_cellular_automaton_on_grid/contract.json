          },
          {
            "expr": "window.__3D_STATE__.vehicleSpeeds.every(v => Number.isInteger(v) && v >= 0 && v <= 5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T7_preSteps = window.__3D_STATE__.stepCount; setTimeout(() => { window.__T7_midSteps = window.__3D_STATE__.stepCount; document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); }, 1500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount > window.__T7_preSteps",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastStepVehiclesMoved >= 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.laneAverageSpeeds) && window.__3D_STATE__.laneAverageSpeeds.every(s => !isNaN(s) && s >= 0 && s <= 5)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === window.__3D_STATE__.stepCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T8_prevSpeed = window.__3D_STATE__.speed; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speed === Math.min(window.__T8_prevSpeed + 2, 20)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speed >= 1 && window.__3D_STATE__.speed <= 20",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-speed') !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.speed === 'number' && Number.isInteger(window.__3D_STATE__.speed)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T9_prevProb = window.__3D_STATE__.randomizationProb; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'p'}));"
