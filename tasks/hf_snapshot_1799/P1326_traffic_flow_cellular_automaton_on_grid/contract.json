          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vehicleSpeeds.every(v => v >= 0 && v <= window.__3D_STATE__.vmax && Number.isInteger(v))",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageSpeed) && !isNaN(window.__3D_STATE__.totalMomentum)",
