      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-running') !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.speed === 'number' && window.__3D_STATE__.speed >= 1",
