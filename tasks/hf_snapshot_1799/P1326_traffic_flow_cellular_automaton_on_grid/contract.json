        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVehicles > 0 && !isNaN(window.__3D_STATE__.totalVehicles)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.density - (window.__3D_STATE__.totalVehicles / (window.__3D_STATE__.laneRows.length * window.__3D_STATE__.gridWidth))) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T11_prevVehicles = window.__3D_STATE__.totalVehicles; window.__T11_prevMomentum = window.__3D_STATE__.totalMomentum; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
