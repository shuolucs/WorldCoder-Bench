            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVehicles === window.__T11_prevVehicles",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vehicleSpeeds.length === window.__3D_STATE__.totalVehicles",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.laneVehicleCounts.reduce((a,b) => a+b, 0) === window.__3D_STATE__.totalVehicles",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T12_stepBefore = window.__3D_STATE__.stepCount; window.__T12_undoBefore = window.__3D_STATE__.undoStackSize; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'z', ctrlKey: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackSize === window.__T12_undoBefore - 1",
            "tier": "L2"
