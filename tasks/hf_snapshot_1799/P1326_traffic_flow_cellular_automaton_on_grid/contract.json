        "#hud-redo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalVehicles > 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AfterOneStep",
      "conditions": [
        "window.__3D_STATE__.stepCount === 1",
        "window.__3D_STATE__.undoStackSize === 1"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMultipleSteps",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 3",
        "window.__3D_STATE__.undoStackSize >= 3"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0 || window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S5",
      "name": "AutoPlayRunning",
      "conditions": [
        "window.__3D_STATE__.running === true"
      ]
    },
    {
      "id": "S6",
      "name": "AutoPlayPaused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.stepCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "CellSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCell !== null"
      ]
    },
    {
      "id": "S8",
      "name": "VehicleAdded",
      "conditions": [
        "window.__3D_STATE__.totalVehicles > 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S10",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed >= 1 && window.__3D_STATE__.speed <= 20"
      ]
    },
    {
      "id": "S11",
      "name": "ProbChanged",
      "conditions": [
        "window.__3D_STATE__.randomizationProb >= 0 && window.__3D_STATE__.randomizationProb <= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number' && window.__3D_STATE__.stepCount === 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalVehicles === 'number' && window.__3D_STATE__.totalVehicles > 0",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.laneRows) && window.__3D_STATE__.laneRows.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.vmax === 5 && window.__3D_STATE__.gridWidth === 40 && window.__3D_STATE__.gridHeight === 40",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageSpeed) && !isNaN(window.__3D_STATE__.density) && !isNaN(window.__3D_STATE__.flowRate)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vehicleSpeeds.every(v => v >= 0 && v <= window.__3D_STATE__.vmax && !isNaN(v) && Number.isInteger(v))",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.flowRate - (window.__3D_STATE__.density * window.__3D_STATE__.averageSpeed)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevVehicles = window.__3D_STATE__.totalVehicles; window.__T3_prevVehicles = prevVehicles; document.getElementById('btn-step').click(); setTimeout(() => document.getElementById('btn-step').click(), 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVehicles === window.__T3_prevVehicles",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.laneVehicleCounts.reduce((a,b) => a+b, 0) === window.__3D_STATE__.totalVehicles",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMomentum === window.__3D_STATE__.vehicleSpeeds.reduce((a,b) => a+b, 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T4_preUndoStep = window.__3D_STATE__.stepCount; window.__T4_preUndoVehicles = window.__3D_STATE__.totalVehicles; window.__T4_preUndoAvgSpeed = window.__3D_STATE__.averageSpeed; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'z', ctrlKey: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackSize === window.__T4_preUndoStep - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVehicles === window.__T4_preUndoVehicles",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.averageSpeed === 'number' && !isNaN(window.__3D_STATE__.averageSpeed)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.vehicleSpeeds.length === window.__3D_STATE__.totalVehicles",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_preRedoUndo = window.__3D_STATE__.undoStackSize; window.__T5_preRedoRedo = window.__3D_STATE__.redoStackSize; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'y', ctrlKey: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoStackSize === window.__T5_preRedoUndo + 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === window.__T5_preRedoRedo - 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVehicles > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.density) && window.__3D_STATE__.density > 0 && window.__3D_STATE__.density <= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.density - (window.__3D_STATE__.totalVehicles / (window.__3D_STATE__.laneRows.length * window.__3D_STATE__.gridWidth))) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
