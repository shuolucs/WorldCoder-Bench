        "button"
      ]
    },
    {
      "id": "A9",
      "name": "ColorButton",
      "type": "dom_element",
      "semantic": "Button to cycle color modes",
      "locator_hints": [
        "Color",
        "button"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Gen0",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.debugOverlayActive === false",
        "window.__3D_STATE__.windStrength === 0",
        "window.__3D_STATE__.colorMode === 'natural'"
      ]
    },
    {
      "id": "S1",
      "name": "Growing_Gen1",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.isGrowing === true"
      ]
    },
    {
      "id": "S2",
      "name": "Grown_Gen1",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.isGrowing === false",
        "window.__3D_STATE__.branchCount > 1"
      ]
    },
    {
      "id": "S3",
      "name": "Debug_Active",
      "conditions": [
        "window.__3D_STATE__.debugOverlayActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "Grown_Gen2",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.isGrowing === false"
      ]
    },
    {
      "id": "S5",
      "name": "Wind_Active",
      "conditions": [
        "window.__3D_STATE__.windActive === true",
        "window.__3D_STATE__.windStrength > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Color_Depth",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'depth'"
      ]
    },
    {
      "id": "S7",
      "name": "Color_Stress",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'stress'"
      ]
    },
    {
      "id": "S8",
      "name": "Grown_Gen3",
      "conditions": [
        "window.__3D_STATE__.generation === 3",
        "window.__3D_STATE__.isGrowing === false"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.branchCount <= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.branchCount !== before.branchCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.branchCount === 'number' && !isNaN(window.__3D_STATE__.branchCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leafCount === 'number' && !isNaN(window.__3D_STATE__.leafCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.branchCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leafCount >= 0",
            "tier": "L2"
