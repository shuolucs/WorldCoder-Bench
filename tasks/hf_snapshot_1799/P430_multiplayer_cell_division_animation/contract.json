      ]
    },
    {
      "id": "A10",
      "name": "ProgressBar",
      "type": "dom_element",
      "semantic": "Progress bar showing phase completion percentage",
      "locator_hints": [
        "#progress-bar"
      ]
    },
    {
      "id": "A11",
      "name": "DaughterCells",
      "type": "3d_object",
      "semantic": "Two daughter cells created after cytokinesis",
      "locator_hints": [
        "two spheres at x≈-2.5 and x≈2.5"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialInterphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'INTERPHASE'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.chromosomeCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "PlayingInterphase",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentPhase === 'INTERPHASE'"
      ]
    },
    {
      "id": "S2",
      "name": "ProphaseActive",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'PROPHASE'",
        "window.__3D_STATE__.phaseIndex === 1",
        "window.__3D_STATE__.chromosomeCount === 8"
      ]
    },
    {
      "id": "S3",
      "name": "MetaphaseActive",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'METAPHASE'",
        "window.__3D_STATE__.phaseIndex === 2"
      ]
    },
    {
      "id": "S4",
      "name": "AnaphaseActive",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'ANAPHASE'",
        "window.__3D_STATE__.phaseIndex === 3"
      ]
    },
    {
      "id": "S5",
      "name": "CytokinesisComplete",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'COMPLETE'",
        "window.__3D_STATE__.daughterCellsExist === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedAdjusted",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S7",
      "name": "Player1Moved",
      "conditions": [
        "window.__3D_STATE__.p1CellPosition !== null",
        "window.__3D_STATE__.p1CellPosition.x !== -2.5 || window.__3D_STATE__.p1CellPosition.z !== 0"
      ]
    },
    {
      "id": "S8",
      "name": "Player1DivisionTriggered",
      "conditions": [
        "window.__3D_STATE__.p1Score >= 1",
        "window.__3D_STATE__.totalCells >= 3"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 'INTERPHASE'",
        "window.__3D_STATE__.phaseIndex === 0",
        "window.__3D_STATE__.chromosomeCount === 4",
        "window.__3D_STATE__.daughterCellsExist === false",
        "window.__3D_STATE__.p1Score === 0",
        "window.__3D_STATE__.p2Score === 0"
      ]
    }
  ],
