{
  "task_id": "P430_multiplayer_cell_division_animation",
  "affordances": [
    {
      "id": "A1",
      "name": "ParentCell",
      "type": "3d_object",
      "semantic": "The main dividing cell sphere at the origin",
      "locator_hints": [
        "semi-transparent green sphere",
        "radius ~1.5 at origin"
      ]
    },
    {
      "id": "A2",
      "name": "Chromosomes",
      "type": "3d_object",
      "semantic": "Small red spheres representing chromosomes inside the cell",
      "locator_hints": [
