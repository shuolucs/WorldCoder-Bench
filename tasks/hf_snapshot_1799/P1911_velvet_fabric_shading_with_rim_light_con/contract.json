      "conditions": [
        "Math.abs(window.__3D_STATE__.rimPower - 6.0) < 0.2",
        "window.__3D_STATE__.activePreset === 'custom'"
      ]
    },
    {
      "id": "S2",
      "name": "RimIntensityAdjusted",
      "conditions": [
