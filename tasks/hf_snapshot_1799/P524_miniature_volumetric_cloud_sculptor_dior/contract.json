{
  "task_id": "P524_miniature_volumetric_cloud_sculptor_dior",
  "affordances": [
    {
      "id": "A1",
      "name": "GlassDome",
      "type": "3d_object",
      "semantic": "Transparent glass dome enclosing the diorama",
      "locator_hints": [
        "sphere with transmission material",
        "radius ~2.8"
      ]
    },
    {
      "id": "A2",
      "name": "IridescenceLamp",
      "type": "3d_object",
      "semantic": "GLTF lamp model at center of platform",
      "locator_hints": [
        "loaded from IridescenceLamp.glb",
        "position near origin"
      ]
    },
    {
      "id": "A3",
      "name": "CloudPuffs",
      "type": "3d_object",
      "semantic": "Volumetric cloud sphere puffs inside dome",
      "locator_hints": [
        "white transparent spheres",
        "y between 1.0 and 2.5"
      ]
    },
    {
      "id": "A4",
      "name": "SculptToggleButton",
      "type": "dom_element",
      "semantic": "Button to toggle sculpt mode",
      "locator_hints": [
        "#sculptToggle"
      ]
    },
    {
      "id": "A5",
      "name": "SizeSlider",
      "type": "dom_element",
      "semantic": "Slider controlling new cloud scale",
      "locator_hints": [
        "#sizeSlider"
      ]
    },
    {
      "id": "A6",
      "name": "DomeOpacitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling dome transmission",
      "locator_hints": [
        "#domeOpacity"
      ]
    },
    {
      "id": "A7",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/play cloud animation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Head-up display showing stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A9",
      "name": "Platform",
      "type": "3d_object",
      "semantic": "Circular wooden platform",
      "locator_hints": [
        "brown circle at y=0"
      ]
    },
    {
      "id": "A10",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Bottom panel with controls",
      "locator_hints": [
        "#controlPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.lampModelLoaded === true",
        "window.__3D_STATE__.domeExists === true",
        "window.__3D_STATE__.platformExists === true",
        "window.__3D_STATE__.cloudCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "SculptModeActivated",
      "conditions": [
        "window.__3D_STATE__.sculptMode === true"
      ]
    },
    {
      "id": "S2",
      "name": "CloudAdded",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 9",
        "window.__3D_STATE__.sculptMode === true"
      ]
    },
    {
      "id": "S3",
      "name": "CloudDeleted",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 8"
      ]
    },
    {
      "id": "S4",
      "name": "ColorCycledToPink",
      "conditions": [
        "window.__3D_STATE__.colorTintIndex === 1",
        "window.__3D_STATE__.colorTintName === 'pink'"
      ]
    },
    {
      "id": "S5",
      "name": "ColorCycledToBlue",
      "conditions": [
        "window.__3D_STATE__.colorTintIndex === 2",
        "window.__3D_STATE__.colorTintName === 'blue'"
      ]
    },
    {
      "id": "S6",
      "name": "LampBrightened",
      "conditions": [
        "window.__3D_STATE__.lampIntensity === 2.5",
        "window.__3D_STATE__.lampOn === true"
      ]
    },
    {
      "id": "S7",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.animationPaused === true"
      ]
    },
    {
      "id": "S8",
      "name": "SizeSliderAdjusted",
      "conditions": [
        "window.__3D_STATE__.newCloudScale === 0.8"
      ]
    },
    {
      "id": "S9",
      "name": "DomeOpacityChanged",
      "conditions": [
        "window.__3D_STATE__.domeTransmission === 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.domeExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.platformExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxClouds === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#sculptToggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sculptMode === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#sculptToggle').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampModelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount >= 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sculptMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount <= window.__3D_STATE__.maxClouds",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cloudCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === window.__3D_STATE__.lastDeletedCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sculptMode === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cloudCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorTintIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorTintName === 'pink'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud').textContent.includes('pink')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorTintIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorTintName === 'blue'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#hud').textContent.includes('blue')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampIntensity === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampOn === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.lampIntensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampIntensity > 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#pauseBtn').textContent.includes('Play')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampIntensity === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#sizeSlider').value = '0.8'; document.querySelector('#sizeSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.newCloudScale - 0.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.newCloudScale >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.newCloudScale <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.newCloudScale)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#domeOpacity').value = '0.5'; document.querySelector('#domeOpacity').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.domeTransmission - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.domeTransmission >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.domeTransmission <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.domeExists === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.domeTransmission)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}