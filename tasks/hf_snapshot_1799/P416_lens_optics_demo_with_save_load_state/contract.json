  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.avocadoLoaded === true",
        "window.__3D_STATE__.objectZ === -12",
        "window.__3D_STATE__.focalLength === 5"
      ]
    },
    {
