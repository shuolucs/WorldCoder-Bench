    {
      "id": "S7",
      "name": "ObjectMovedAfterSave",
      "conditions": [
        "window.__3D_STATE__.objectZ === -8"
      ]
    },
    {
      "id": "S8",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.objectZ === -11.5",
        "window.__3D_STATE__.focalLength === 5"
      ]
    },
    {
      "id": "S9",
      "name": "ObjectNearFocalPoint",
      "conditions": [
        "Math.abs(window.__3D_STATE__.objectZ + 5) < 0.5"
      ]
    },
    {
      "id": "S10",
      "name": "VirtualImageRegion",
      "conditions": [
        "window.__3D_STATE__.objectDistance < window.__3D_STATE__.focalLength"
      ]
    },
    {
      "id": "S11",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.objectZ === -12",
        "window.__3D_STATE__.focalLength === 5"
      ]
    }
