{
  "task_id": "P404_lens_optics_demo",
  "affordances": [
    {
      "id": "A1",
      "name": "ObjectArrow",
      "type": "3d_object",
      "semantic": "Red arrow representing the optical object, draggable along the X axis",
      "locator_hints": [
        "red arrow",
        "mesh at negative X"
      ]
    },
    {
      "id": "A2",
      "name": "ImageArrow",
      "type": "3d_object",
      "semantic": "Green arrow representing the formed image",
      "locator_hints": [
        "green arrow",
        "mesh at computed image X"
      ]
    },
    {
      "id": "A3",
      "name": "Lens",
      "type": "3d_object",
      "semantic": "Vertical line/shape at origin representing the thin lens",
      "locator_hints": [
        "blue vertical shape at x=0"
      ]
    },
    {
      "id": "A4",
      "name": "FocalLengthSlider",
      "type": "dom_element",
      "semantic": "Slider to adjust focal length from 1 to 6",
      "locator_hints": [
        "#focalLengthSlider"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleLensTypeButton",
      "type": "dom_element",
      "semantic": "Button to toggle between converging and diverging lens",
      "locator_hints": [
        "#toggleLensType"
      ]
    },
    {
      "id": "A6",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing do, di, m, and image type",
      "locator_hints": [
        "#infoPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.lensType === 'converging'",
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.objectDistance === 6",
        "window.__3D_STATE__.imageType === 'real'"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultPhysicsVerified",
      "conditions": [
        "Math.abs(window.__3D_STATE__.imageDistance - 6) < 0.5",
        "Math.abs(window.__3D_STATE__.magnification + 1) < 0.2"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectMovedClose",
      "conditions": [
        "window.__3D_STATE__.objectDistance < 3",
        "window.__3D_STATE__.imageType === 'virtual'"
      ]
    },
    {
      "id": "S3",
      "name": "FocalLengthChanged",
      "conditions": [
        "window.__3D_STATE__.focalLength !== 3",
        "window.__3D_STATE__.imageType === 'real' || window.__3D_STATE__.imageType === 'virtual'"
      ]
    },
    {
      "id": "S4",
      "name": "DivergingLens",
      "conditions": [
        "window.__3D_STATE__.lensType === 'diverging'",
        "window.__3D_STATE__.focalLength < 0",
        "window.__3D_STATE__.imageType === 'virtual'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectDistance !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.imageDistance !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.magnification !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.focalLength !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate dragging object to X=-2 (do=2, inside focal length f=3) */ const state = window.__3D_STATE__; if(typeof window.__setObjectX === 'function') { window.__setObjectX(-2); } else { const evt = new PointerEvent('pointerdown', {clientX: 200, clientY: 300}); document.querySelector('canvas').dispatchEvent(evt); setTimeout(() => { const move = new PointerEvent('pointermove', {clientX: 500, clientY: 300}); document.querySelector('canvas').dispatchEvent(move); setTimeout(() => { const up = new PointerEvent('pointerup', {clientX: 500, clientY: 300}); document.querySelector('canvas').dispatchEvent(up); }, 100); }, 100); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectDistance !== before.objectDistance || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number' && !isNaN(window.__3D_STATE__.objectDistance)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number' && !isNaN(window.__3D_STATE__.imageDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('focalLengthSlider'); if(slider) { slider.value = 5; slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectDistance !== before.objectDistance || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number' && !isNaN(window.__3D_STATE__.objectDistance)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number' && !isNaN(window.__3D_STATE__.imageDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S0",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleLensType"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectDistance !== before.objectDistance || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number' && !isNaN(window.__3D_STATE__.objectDistance)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number' && !isNaN(window.__3D_STATE__.imageDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleLensType"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectDistance !== before.objectDistance || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectDistance === 'number' && !isNaN(window.__3D_STATE__.objectDistance)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.imageDistance === 'number' && !isNaN(window.__3D_STATE__.imageDistance)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}