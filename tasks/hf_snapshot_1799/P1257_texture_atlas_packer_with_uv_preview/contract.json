      "locator_hints": [
        "#btnClearAll"
      ]
    },
    {
      "id": "A10",
      "name": "BtnToggleUV",
      "type": "dom_element",
      "semantic": "Button to toggle UV overlay visibility",
      "locator_hints": [
        "#btnToggleUV"
      ]
    },
    {
      "id": "A11",
      "name": "AtlasUsageLabel",
      "type": "dom_element",
      "semantic": "Span showing atlas usage percentage",
      "locator_hints": [
        "#atlasUsage"
      ]
    },
    {
      "id": "A12",
      "name": "RegionCountLabel",
      "type": "dom_element",
      "semantic": "Span showing region count",
      "locator_hints": [
        "#regionCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_Atlas",
      "conditions": [
        "window.__3D_STATE__.regionCount === 0",
        "window.__3D_STATE__.atlasUsage === 0",
        "window.__3D_STATE__.lastAction === 'init'",
        "window.__3D_STATE__.uvOverlayVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "One_Small_Region",
      "conditions": [
        "window.__3D_STATE__.regionCount === 1",
        "window.__3D_STATE__.regions[0].width === 64 && window.__3D_STATE__.regions[0].height === 64"
      ]
    },
    {
      "id": "S2",
      "name": "Two_Regions_Mixed",
      "conditions": [
        "window.__3D_STATE__.regionCount === 2"
      ]
    },
    {
      "id": "S3",
      "name": "Three_Regions_Shelf_Check",
      "conditions": [
        "window.__3D_STATE__.regionCount === 3"
      ]
    },
    {
      "id": "S4",
      "name": "Four_Regions_Multi_Shelf",
      "conditions": [
        "window.__3D_STATE__.regionCount === 4"
      ]
    },
    {
      "id": "S5",
      "name": "UV_Overlay_Hidden",
      "conditions": [
        "window.__3D_STATE__.uvOverlayVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "UV_Overlay_Restored",
      "conditions": [
        "window.__3D_STATE__.uvOverlayVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "After_Remove_Last",
      "conditions": [
        "window.__3D_STATE__.regionCount === 3",
        "window.__3D_STATE__.lastAction === 'remove_last'"
      ]
    },
    {
      "id": "S8",
      "name": "After_Keyboard_Add",
      "conditions": [
        "window.__3D_STATE__.regionCount === 4"
      ]
    },
    {
      "id": "S9",
      "name": "Heavy_Packing",
      "conditions": [
        "window.__3D_STATE__.regionCount >= 6"
      ]
    },
    {
      "id": "S10",
      "name": "After_Clear_All",
      "conditions": [
        "window.__3D_STATE__.regionCount === 0",
        "window.__3D_STATE__.lastAction === 'clear_all'"
      ]
    },
    {
      "id": "S11",
      "name": "Rebuilt_After_Clear",
      "conditions": [
        "window.__3D_STATE__.regionCount === 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnAddSmall"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.regions === 'object' && Array.isArray(window.__3D_STATE__.regions)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.regionCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.regions[0].x === 0 && window.__3D_STATE__.regions[0].y === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.regions[0].width === 64 && window.__3D_STATE__.regions[0].height === 64",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atlasUsage - (64*64/(512*512)*100)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add_small'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
