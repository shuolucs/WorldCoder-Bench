      "locator_hints": [
        "#btnAddLarge"
      ]
    },
    {
      "id": "A7",
      "name": "BtnAddTall",
      "type": "dom_element",
      "semantic": "Button to add 64x128 region",
      "locator_hints": [
        "#btnAddTall"
      ]
    },
    {
      "id": "A8",
