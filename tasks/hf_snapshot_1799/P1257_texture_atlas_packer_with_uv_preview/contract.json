          },
          {
            "expr": "window.__3D_STATE__.regions[1].width === 128 && window.__3D_STATE__.regions[1].height === 64",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.regions[1].x === 64 && window.__3D_STATE__.regions[1].y === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shelfX === 192",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atlasUsage - ((64*64 + 128*64)/(512*512)*100)) < 0.05",
