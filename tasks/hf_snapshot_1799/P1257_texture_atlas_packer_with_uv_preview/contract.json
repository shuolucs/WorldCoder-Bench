{
  "task_id": "P1257_texture_atlas_packer_with_uv_preview",
  "affordances": [
    {
      "id": "A1",
      "name": "AtlasCanvas",
      "type": "dom_element",
      "semantic": "2D canvas showing packed texture atlas regions",
      "locator_hints": [
        "#atlasCanvas"
      ]
    },
    {
      "id": "A2",
      "name": "3DCube",
      "type": "3d_object",
      "semantic": "Three.js cube with atlas texture applied",
      "locator_hints": [
        "scene.children mesh"
      ]
    },
    {
      "id": "A3",
      "name": "UVOverlay",
      "type": "3d_object",
      "semantic": "Green wireframe UV overlay on the cube",
      "locator_hints": [
