  "states": [
    {
      "id": "S0",
      "name": "Initial_SceneReady",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.levelsAdded === 0",
        "window.__3D_STATE__.arrowCount === 0",
        "window.__3D_STATE__.verificationResult === 'pending'"
      ]
    },
    {
      "id": "S1",
      "name": "ReactantsAdded",
      "conditions": [
        "window.__3D_STATE__.reactantsAdded === true",
        "window.__3D_STATE__.levelsAdded === 1"
      ]
    },
    {
      "id": "S2",
      "name": "IntermediateAdded",
      "conditions": [
        "window.__3D_STATE__.intermediateAdded === true",
        "window.__3D_STATE__.levelsAdded === 2"
      ]
    },
    {
      "id": "S3",
      "name": "ProductsAdded",
      "conditions": [
        "window.__3D_STATE__.productsAdded === true",
        "window.__3D_STATE__.levelsAdded === 3"
      ]
    },
    {
      "id": "S4",
      "name": "DirectPathShown",
      "conditions": [
        "window.__3D_STATE__.directPathShown === true",
        "window.__3D_STATE__.arrowCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "StepPathShown",
      "conditions": [
        "window.__3D_STATE__.stepPathShown === true",
        "window.__3D_STATE__.arrowCount === 3"
      ]
    },
    {
      "id": "S6",
      "name": "HessVerified",
      "conditions": [
        "window.__3D_STATE__.verified === true",
        "window.__3D_STATE__.verificationResult === 'pass'"
      ]
    },
    {
      "id": "S7",
      "name": "DiagramReset",
      "conditions": [
        "window.__3D_STATE__.levelsAdded === 0",
        "window.__3D_STATE__.arrowCount === 0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "LabToggled",
      "conditions": [
        "window.__3D_STATE__.labModelVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "BarDragged",
      "conditions": [
        "window.__3D_STATE__.isDragging === false",
        "window.__3D_STATE__.reactantY !== 6"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-reactants"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reactantsAdded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reactantsAdded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.levelsAdded === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.reactantY - 6) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaH1 === -393",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intermediateAdded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.levelsAdded === 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.intermediateY - 3.3) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaH2 === -110",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intermediateY < window.__3D_STATE__.reactantY",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-add-products"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.productsAdded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.levelsAdded === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.productY - (-1.65)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.productY < window.__3D_STATE__.intermediateY",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactantY > window.__3D_STATE__.intermediateY && window.__3D_STATE__.intermediateY > window.__3D_STATE__.productY",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.directPathShown === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.deltaH1 === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.deltaH1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaH1 === -393",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-show-steps"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepPathShown === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaH2 === -110",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaH3 === -283",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.hessSum)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-verify"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.verified === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.verificationResult === 'pass'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.hessSum - window.__3D_STATE__.deltaH1) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hessSum === -393",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hessError < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.levelsAdded === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.arrowCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactantsAdded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intermediateAdded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.productsAdded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-lab"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.labModelVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.labModelVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.labModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactantsAdded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.levelsAdded === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.directPathShown === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepPathShown === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.verificationResult === 'pending'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.reactantY = window.__3D_STATE__.reactantY; document.querySelector('#btn-verify').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.hessError === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.hessError)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.hessSum)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.deltaH1)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.deltaH2 + window.__3D_STATE__.deltaH3 - window.__3D_STATE__.hessSum) < 0.01",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}