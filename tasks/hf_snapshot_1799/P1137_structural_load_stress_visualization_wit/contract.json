    {
      "id": "A10",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane at y=0",
      "locator_hints": [
        "ground plane mesh"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.memberCount === 10",
        "window.__3D_STATE__.totalAppliedLoad === 0"
      ]
    },
    {
      "id": "S1",
      "name": "BeamSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBeamId !== null",
        "window.__3D_STATE__.lastAction === 'select'"
      ]
    },
    {
      "id": "S2",
      "name": "FirstLoadApplied",
      "conditions": [
        "window.__3D_STATE__.totalAppliedLoad > 0",
        "window.__3D_STATE__.loadApplicationCount === 1",
        "window.__3D_STATE__.stressedMemberCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SecondLoadApplied",
      "conditions": [
        "window.__3D_STATE__.loadApplicationCount === 2",
        "window.__3D_STATE__.totalAppliedLoad > window.__3D_STATE__.members[0].maxStress * 0"
      ]
    },
    {
      "id": "S4",
      "name": "DeformationToggled",
      "conditions": [
        "window.__3D_STATE__.deformationEnabled === false",
        "window.__3D_STATE__.lastAction === 'toggleDeform'"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.hasSavedState === true",
        "window.__3D_STATE__.lastAction === 'save'"
      ]
    },
    {
      "id": "S6",
      "name": "LoadsReset",
      "conditions": [
        "window.__3D_STATE__.totalAppliedLoad === 0",
        "window.__3D_STATE__.stressedMemberCount === 0",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S7",
      "name": "StateRestored",
      "conditions": [
        "window.__3D_STATE__.totalAppliedLoad > 0",
        "window.__3D_STATE__.lastAction === 'load'",
        "window.__3D_STATE__.stressedMemberCount > 0"
      ]
    },
    {
      "id": "S8",
      "name": "SaveCleared",
      "conditions": [
        "window.__3D_STATE__.hasSavedState === false",
        "window.__3D_STATE__.lastAction === 'clearSave'"
      ]
    },
    {
      "id": "S9",
      "name": "OverloadApplied",
      "conditions": [
        "window.__3D_STATE__.failedMemberCount > 0",
        "window.__3D_STATE__.maxStressValue >= 100"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.members === 'object' && Array.isArray(window.__3D_STATE__.members)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.memberCount === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => m.currentStress === 0 && m.failed === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.failedMemberCount === 0 && window.__3D_STATE__.stressedMemberCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const beams = window.__3D_STATE__.members.filter(m => m.type === 'beam'); const beamId = beams[0].id; const scene = document.__scene || document.querySelector('canvas').__scene; scene.traverse(c => { if(c.userData && c.userData.memberId === beamId) { c.dispatchEvent({type:'click'}); } }); /* fallback: simulate selection */ if(!window.__3D_STATE__.selectedBeamId) { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/3, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedBeamId === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBeamId !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.type === 'beam' && m.id === window.__3D_STATE__.selectedBeamId)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'select'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('loadSlider').value = 50; document.getElementById('loadSlider').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('applyLoadBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadApplicationCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.filter(m => m.type === 'beam' && m.currentStress === 50).length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.filter(m => m.type === 'column' && m.currentStress === 35).length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => !isNaN(m.currentStress) && m.currentStress >= 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('loadSlider').value = 30; document.getElementById('loadSlider').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('applyLoadBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadApplicationCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.filter(m => m.type === 'beam' && m.id === window.__3D_STATE__.selectedBeamId)[0].currentStress === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxStressValue >= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => m.currentStress <= m.maxStress || m.failed === true)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleDeformBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.deformationEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggleDeform'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadApplicationCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount >= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#saveStateBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hasSavedState === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'save'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_SAVED_STATE__ === 'string' || typeof window.__3D_SAVED_STATE__ === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deformationEnabled === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetLoadsBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.failedMemberCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxStressValue === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => m.currentStress === 0 && m.failed === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#loadStateBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'load'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deformationEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadApplicationCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.currentStress === 80)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#clearSaveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hasSavedState === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'clearSave'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_SAVED_STATE__ === null || window.__3D_SAVED_STATE__ === undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressedMemberCount >= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('loadSlider').value = 100; document.getElementById('loadSlider').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('applyLoadBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalAppliedLoad === 180",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.failedMemberCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxStressValue >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.failed === true && m.currentStress >= m.maxStress)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadApplicationCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => !isNaN(m.currentStress) && m.currentStress >= 0 && typeof m.stressRatio === 'number')",
