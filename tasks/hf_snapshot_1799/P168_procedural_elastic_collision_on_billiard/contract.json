          },
          {
            "expr": "window.__3D_STATE__.blueBall !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalKE === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.collisionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ballsStopped === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalKE >= 0",
            "tier": "L2"
