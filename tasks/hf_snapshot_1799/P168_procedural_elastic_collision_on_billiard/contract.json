        "loaded from soldier.glb",
        "position near (7, 0, 0)"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.status === 'ready'",
        "window.__3D_STATE__.ballsStopped === true",
        "window.__3D_STATE__.collisionCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Simulating_After_Shot",
      "conditions": [
        "window.__3D_STATE__.status === 'simulating'",
        "window.__3D_STATE__.cueBall.vx > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Collision_Occurred",
      "conditions": [
        "window.__3D_STATE__.collisionCount >= 1",
        "window.__3D_STATE__.status === 'simulating'"
      ]
    },
    {
      "id": "S3",
      "name": "Balls_Settled",
      "conditions": [
        "window.__3D_STATE__.ballsStopped === true",
        "window.__3D_STATE__.status === 'ready'"
      ]
    },
    {
      "id": "S4",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.cueBall.x === -3",
        "window.__3D_STATE__.cueBall.z === 0",
        "window.__3D_STATE__.collisionCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Status !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cueBall !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redBall !== undefined",
