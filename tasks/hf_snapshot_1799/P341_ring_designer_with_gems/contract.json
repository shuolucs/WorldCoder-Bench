  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.bandMaterial === 'gold'",
        "window.__3D_STATE__.gemCount === 0",
        "window.__3D_STATE__.selectedSlot === 0",
        "window.__3D_STATE__.ringScale === 1.0",
        "window.__3D_STATE__.totalPrice === 500",
        "window.__3D_STATE__.isRotating === false"
      ]
    },
    {
      "id": "S1",
      "name": "GemPlacedSlot0",
      "conditions": [
        "window.__3D_STATE__.gems[0].visible === true",
        "window.__3D_STATE__.gems[0].type === 'diamond'",
        "window.__3D_STATE__.gemCount === 1"
      ]
    },
    {
      "id": "S2",
      "name": "BandChangedToSilver",
      "conditions": [
        "window.__3D_STATE__.bandMaterial === 'silver'",
        "window.__3D_STATE__.bandColor === '#C0C0C0' || window.__3D_STATE__.bandColor === '#c0c0c0'"
      ]
    },
    {
      "id": "S3",
      "name": "SlotNavigated",
      "conditions": [
        "window.__3D_STATE__.selectedSlot === 1"
      ]
    },
    {
      "id": "S4",
      "name": "SecondGemPlaced",
      "conditions": [
        "window.__3D_STATE__.gems[1].visible === true",
        "window.__3D_STATE__.gemCount === 2"
      ]
    },
    {
      "id": "S5",
      "name": "GemTypeChangedToRuby",
      "conditions": [
        "window.__3D_STATE__.gemType === 'ruby'"
      ]
    },
    {
      "id": "S6",
      "name": "ThirdGemPlacedRuby",
      "conditions": [
        "window.__3D_STATE__.gemCount === 3"
      ]
    },
    {
      "id": "S7",
      "name": "RingScaled",
      "conditions": [
        "Math.abs(window.__3D_STATE__.ringScale - 1.5) < 0.05"
      ]
    },
    {
      "id": "S8",
      "name": "RotationEnabled",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ]
    },
    {
      "id": "S9",
      "name": "RotationProgressed",
      "conditions": [
        "window.__3D_STATE__.rotationAngle > 0.1",
        "!isNaN(window.__3D_STATE__.rotationAngle)"
      ]
    },
    {
      "id": "S10",
      "name": "GemRemoved",
      "conditions": [
        "window.__3D_STATE__.gemCount === 2"
      ]
    },
    {
      "id": "S11",
      "name": "AllGemsCleared",
      "conditions": [
        "window.__3D_STATE__.gemCount === 0"
      ]
    },
    {
      "id": "S12",
      "name": "Exported",
      "conditions": [
        "window.__3D_STATE__.exported === true"
      ]
    }
  ],
