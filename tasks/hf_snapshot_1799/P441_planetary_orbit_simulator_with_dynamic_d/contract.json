  "states": [
    {
      "id": "S0",
      "name": "Initial_Easy_Running",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.speedMultiplier === 0.5",
        "window.__3D_STATE__.trailsVisible === true",
        "window.__3D_STATE__.quizActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "Medium_Difficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'medium'",
