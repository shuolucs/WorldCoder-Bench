        "window.__3D_STATE__.trailsVisible === false"
      ]
    },
    {
      "id": "S2",
      "name": "Hard_Difficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'hard'",
        "window.__3D_STATE__.speedMultiplier === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused_By_Spacebar",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.quizActive === false"
      ]
    },
    {
      "id": "S4",
      "name": "Quiz_Active",
      "conditions": [
        "window.__3D_STATE__.quizActive === true",
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Quiz_Correct",
      "conditions": [
        "window.__3D_STATE__.quizResult === 'correct'",
        "window.__3D_STATE__.quizActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "Quiz_Wrong",
      "conditions": [
        "window.__3D_STATE__.quizResult === 'wrong'",
        "window.__3D_STATE__.quizActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed_After_Quiz",
      "conditions": [
        "window.__3D_STATE__.quizActive === false",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S8",
      "name": "Trails_Toggled",
      "conditions": [
        "window.__3D_STATE__.trailsVisible !== undefined"
      ]
    }
  ],
