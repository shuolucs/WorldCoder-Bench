  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "页面加载，体与平面未就绪"
    },
    {
      "id": "S1",
      "name": "init_ok",
      "description": "64³ 体与 slicePositions 合法"
    },
    {
      "id": "S2",
      "name": "axial_changed",
      "description": "轴位切片与 voxelValue 已更新"
    },
    {
      "id": "S3",
      "name": "wl_changed",
      "description": "窗宽窗位已改变"
    },
    {
      "id": "S4",
      "name": "colormap_changed",
      "description": "色图已切换"
    },
    {
      "id": "S5",
      "name": "volume_mode_on",
      "description": "体渲染模式开启"
    },
    {
      "id": "S6",
      "name": "sagittal_changed",
      "description": "矢状切片已调整"
    },
    {
      "id": "S7",
      "name": "measurement_ok",
      "description": "测距 distance>0 且 60s 稳定可在此状态验证"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "volumeSize=64",
        "切片索引在有效范围",
        "状态字段有限"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.volumeSize === 64",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.axial) && window.__3D_STATE__.slicePositions.axial >= 0 && window.__3D_STATE__.slicePositions.axial <= 63",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.coronal) && window.__3D_STATE__.slicePositions.coronal >= 0 && window.__3D_STATE__.slicePositions.coronal <= 63",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.sagittal) && window.__3D_STATE__.slicePositions.sagittal >= 0 && window.__3D_STATE__.slicePositions.sagittal <= 63",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.windowWidth) && window.__3D_STATE__.windowWidth >= 1 && window.__3D_STATE__.windowWidth <= 255",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.windowCenter) && window.__3D_STATE__.windowCenter >= 0 && window.__3D_STATE__.windowCenter <= 255",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colormap === 'string'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.volumeMode === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.voxelValue)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.measurementDistance) && window.__3D_STATE__.measurementDistance >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_input",
        "selector": "#axialSlice",
        "value": "40"
      },
      "postconditions": [
        "轴位索引更新",
        "voxelValue 相对变化"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.slicePositions.axial - 40) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voxelValue !== before.voxelValue",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.voxelValue)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_input",
        "selector": "#windowWidth",
        "value": "90"
      },
      "postconditions": [
        "窗宽改变并写入状态"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windowWidth - 90) < 2 || window.__3D_STATE__.windowWidth !== before.windowWidth",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.windowWidth)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowWidth >= 1 && window.__3D_STATE__.windowWidth <= 255",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ var s=document.getElementById('colormap'); if(!s)return; var opts=['hot','cool','grayscale']; for(var i=0;i<opts.length;i++){ if(s.value!==opts[i]){ s.value=opts[i]; s.dispatchEvent(new Event('change',{bubbles:true})); break; } } })()",
        "wait_ms": 400
      },
      "postconditions": [
        "colormap 字符串与之前不同"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colormap !== before.colormap",
            "tier": "L2"
          },
          {
            "expr": "['grayscale','hot','cool'].indexOf(window.__3D_STATE__.colormap) >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "eval",
        "code": "(function(){ var el=document.getElementById('volumeToggle'); if(!el)return; if(el.type==='checkbox'){ el.checked=!el.checked; } else { el.setAttribute('aria-checked', el.getAttribute('aria-checked')==='true'?'false':'true'); } el.dispatchEvent(new Event('change',{bubbles:true})); el.dispatchEvent(new Event('input',{bubbles:true})); })()",
        "wait_ms": 400
      },
      "postconditions": [
        "volumeMode 布尔值相对 before 翻转"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.volumeMode !== before.volumeMode",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.volumeMode === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "dom_input",
        "selector": "#sagittalSlice",
        "value": "22"
      },
      "postconditions": [
        "矢状 slicePositions.sagittal 接近 22"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.slicePositions.sagittal - 22) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeSize === 64",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "eval",
        "code": "(function(){ var c=document.querySelector('canvas'); if(!c)return; function clk(nx,ny){ var r=c.getBoundingClientRect(); var x=r.left+r.width*nx,y=r.top+r.height*ny; ['pointerdown','pointerup','click'].forEach(function(t){ c.dispatchEvent(new MouseEvent(t,{clientX:x,clientY:y,bubbles:true})); }); } clk(0.42,0.48); setTimeout(function(){ clk(0.58,0.52); }, 500); })()",
        "wait_ms": 1200
      },
      "postconditions": [
        "measurementDistance > 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.measurementDistance > 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.measurementDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60s 后核心状态仍一致且有限"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.volumeSize === 64",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.voxelValue)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.measurementDistance) && window.__3D_STATE__.measurementDistance > 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.axial)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.coronal)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.slicePositions.sagittal)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}