{
  "task_id": "P564_newton_cradle",
  "affordances": [
    {"id": "A1", "name": "Balls", "type": "3d_object", "semantic": "5 metallic pendulum balls", "locator_hints": ["sphere meshes metallic"]},
    {"id": "A2", "name": "Strings", "type": "3d_object", "semantic": "Pendulum strings from top bar", "locator_hints": ["line or thin cylinder"]},
    {"id": "A3", "name": "Frame", "type": "3d_object", "semantic": "Metal support frame", "locator_hints": ["box meshes metallic"]},
    {"id": "A4", "name": "PullCountSlider", "type": "dom_element", "semantic": "Pull count control", "locator_hints": ["#slider-pull-count"]},
    {"id": "A5", "name": "PullAngleSlider", "type": "dom_element", "semantic": "Pull angle control", "locator_hints": ["#slider-pull-angle"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Pulled", "conditions": ["window.__3D_STATE__.ballAngles[0] > 0.1"]},
    {"id": "S1", "name": "Swinging", "conditions": ["window.__3D_STATE__.totalCollisions > 0"]},
    {"id": "S2", "name": "Oscillating", "conditions": ["window.__3D_STATE__.totalCollisions > 5"]},
    {"id": "S3", "name": "TwoBalls", "conditions": ["window.__3D_STATE__.pullCount === 2"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.totalCollisions === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.ballAngles.length === 5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return [...s.ballAngles, ...s.ballOmegas].every(v => isFinite(v) && !isNaN(v)); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ballOmegas.some(w => Math.abs(w) > 0.1)", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalCollisions > 3", "tier": "L1"},
        {"expr": "window.__3D_STATE__.energyLossPercent < 10", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.totalCollisions === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.ballsValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-pull-count').value = 2; document.getElementById('slider-pull-count').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.pullCount === 2", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ballOmegas.some(w => Math.abs(w) > 0.1)", "tier": "L1"}
      ]}
    }
  ]
}
