  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 1",
        "window.__3D_STATE__.round === 1",
        "window.__3D_STATE__.actionsLeft === 3",
        "window.__3D_STATE__.players[0].budget === 1000",
        "window.__3D_STATE__.players[1].budget === 1000",
        "window.__3D_STATE__.players[0].population === 0",
        "window.__3D_STATE__.players[1].population === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "ZoneSelectedResidential",
      "conditions": [
        "window.__3D_STATE__.selectedZone === 'residential'"
      ]
    },
    {
      "id": "S2",
      "name": "P1PlacedFirstZone",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 1",
        "window.__3D_STATE__.actionsLeft === 2",
        "window.__3D_STATE__.players[0].budget === 950",
        "window.__3D_STATE__.players[0].zoneCount === 1"
      ]
    },
    {
      "id": "S3",
      "name": "P1PlacedMultipleZones",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 1",
        "window.__3D_STATE__.actionsLeft <= 1",
        "window.__3D_STATE__.players[0].zoneCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "P1UndoneLastPlacement",
      "conditions": [
        "window.__3D_STATE__.undoStack.length < window.__3D_STATE__.redoStack.length || window.__3D_STATE__.redoStack.length >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "P1RedoneAction",
      "conditions": [
        "window.__3D_STATE__.redoStack.length === 0"
      ]
    },
    {
      "id": "S6",
      "name": "P2Turn",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 2",
        "window.__3D_STATE__.actionsLeft === 3"
      ]
    },
    {
      "id": "S7",
      "name": "P2PlacedZones",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 2",
        "window.__3D_STATE__.players[1].zoneCount >= 1"
