  "affordances": [
    {
      "id": "A1",
      "name": "TentacleSystem",
      "type": "3d_object",
      "semantic": "Array of 6 procedurally animated tentacles with skinned mesh segments",
      "locator_hints": [
        "window.__3D_STATE__.tentacleCount === 6",
        "window.__3D_STATE__.segmentsPerTentacle === 12"
      ]
    },
    {
      "id": "A2",
      "name": "Obstacles",
      "type": "3d_object",
      "semantic": "Transparent red spheres that tentacles avoid via collision repulsion",
      "locator_hints": [
        "window.__3D_STATE__.obstacleCount >= 3"
      ]
    },
    {
      "id": "A3",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing tentacle params, collision stats, FPS",
      "locator_hints": [
        "document.querySelector('[id*=hud], [class*=hud], [id*=panel]')"
      ]
    },
    {
      "id": "A4",
      "name": "AddObstacleButton",
      "type": "dom_element",
