  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.tentacleCount === 6",
        "window.__3D_STATE__.segmentsPerTentacle === 12",
        "window.__3D_STATE__.selectedTentacle === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.obstaclesVisible === true",
        "window.__3D_STATE__.obstacleCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "TentacleSelected",
      "conditions": [
        "window.__3D_STATE__.selectedTentacle >= 0 && window.__3D_STATE__.selectedTentacle <= 5"
      ]
    },
    {
      "id": "S4",
      "name": "AmplitudeModified",
      "conditions": [
        "window.__3D_STATE__.tentacleParams[window.__3D_STATE__.selectedTentacle].amplitude !== 0.15"
      ]
    },
    {
      "id": "S5",
      "name": "FrequencyModified",
      "conditions": [
        "window.__3D_STATE__.tentacleParams[window.__3D_STATE__.selectedTentacle].frequency !== 1.5 + window.__3D_STATE__.selectedTentacle * 0.1"
      ]
    },
    {
      "id": "S6",
      "name": "ParametersReset",
      "conditions": [
        "window.__3D_STATE__.tentacleParams[0].amplitude === 0.15",
        "window.__3D_STATE__.tentacleParams[0].frequency >= 1.49 && window.__3D_STATE__.tentacleParams[0].frequency <= 1.51"
      ]
    },
    {
      "id": "S7",
      "name": "ObstaclesHidden",
      "conditions": [
        "window.__3D_STATE__.obstaclesVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "ObstacleAdded",
      "conditions": [
        "window.__3D_STATE__.obstacleCount === 4"
      ]
    },
    {
      "id": "S9",
      "name": "ObstacleRemoved",
      "conditions": [
