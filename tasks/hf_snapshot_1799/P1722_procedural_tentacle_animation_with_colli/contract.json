      ]
    },
    {
      "id": "S10",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 0) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 8) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 18) < 0.5"
