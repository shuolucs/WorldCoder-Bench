{
  "task_id": "P428_water_cycle_visualization_with_physics_d",
  "affordances": [
    {
      "id": "A1",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug overlay panel showing particle stats",
      "locator_hints": [
        "#debug-overlay"
      ]
    },
    {
      "id": "A2",
      "name": "WaterParticles",
      "type": "3d_object",
      "semantic": "Particle system representing water in various cycle phases",
      "locator_hints": [
        "particleCounts"
      ]
    },
    {
      "id": "A3",
      "name": "Sun",
      "type": "3d_object",
      "semantic": "Directional light representing the sun",
      "locator_hints": [
        "sunIntensity"
      ]
    },
    {
      "id": "A4",
      "name": "FoxModel",
      "type": "3d_object",
      "semantic": "Fox.glb model placed on the terrain near the lake",
      "locator_hints": [
        "foxLoaded",
        "foxPosition"
      ]
    },
    {
      "id": "A5",
      "name": "PhaseHUD",
      "type": "dom_element",
      "semantic": "Bottom bar showing phase distribution counts",
      "locator_hints": [
        "bottom bar",
        "Collection:"
      ]
    },
    {
      "id": "A6",
      "name": "TitleHUD",
      "type": "dom_element",
      "semantic": "Title text at top center",
      "locator_hints": [
        "Water Cycle Visualization"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.simulationPaused === false",
        "window.__3D_STATE__.sunIntensity === 1.2",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.cycleSpeed === 1",
        "window.__3D_STATE__.rainMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "DebugOverlayVisible",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "SunIntensityHigh",
      "conditions": [
        "window.__3D_STATE__.sunIntensity === 2.5"
      ]
    },
    {
      "id": "S3",
      "name": "RainModeActive",
      "conditions": [
        "window.__3D_STATE__.rainMode === true"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedMultiplied",
      "conditions": [
        "window.__3D_STATE__.cycleSpeed > 1"
      ]
    },
    {
      "id": "S6",
      "name": "FoxInteracted",
      "conditions": [
        "window.__3D_STATE__.foxClicked >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "FullCycleRunning",
      "conditions": [
        "window.__3D_STATE__.particleCounts.evaporation > 0 || window.__3D_STATE__.particleCounts.condensation > 0 || window.__3D_STATE__.particleCounts.precipitation > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 40 && window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === (window.__3D_STATE__.particleCounts.collection + window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleVelocity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debug-overlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debug-overlay').style.display !== 'none' && document.getElementById('debug-overlay').style.visibility !== 'hidden'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunIntensity === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === (window.__3D_STATE__.particleCounts.collection + window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sunIntensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCounts.evaporation > 0 || window.__3D_STATE__.particleCounts.condensation > 0 || window.__3D_STATE__.particleCounts.precipitation > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 40 && window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === (window.__3D_STATE__.particleCounts.collection + window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleVelocity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxPosition.x > -20 && window.__3D_STATE__.foxPosition.x < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S7",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === (window.__3D_STATE__.particleCounts.collection + window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleVelocity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 40",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); setTimeout(() => window.dispatchEvent(new KeyboardEvent('keydown', {key: '3'})), 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cycleSpeed === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === (window.__3D_STATE__.particleCounts.collection + window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleVelocity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "if(window.__3D_STATE__ && window.__3D_STATE__.foxClicked !== undefined) { window.dispatchEvent(new CustomEvent('foxClick')); } else { /* fallback: try raycasting click on fox */ const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(evt); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foxClicked >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxPosition.y >= 0 && window.__3D_STATE__.foxPosition.y < 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.foxPosition.x) && !isNaN(window.__3D_STATE__.foxPosition.z)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}