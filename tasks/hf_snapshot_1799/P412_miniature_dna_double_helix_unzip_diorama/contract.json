  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.lanternLoaded === true",
        "window.__3D_STATE__.unzipLevel === 0",
        "window.__3D_STATE__.lanternLightOn === true",
        "window.__3D_STATE__.labelsVisible === false",
        "window.__3D_STATE__.basePairsTotal === 20"
      ]
    },
    {
      "id": "S1",
      "name": "First_Pair_Unzipped",
      "conditions": [
        "window.__3D_STATE__.unzipLevel === 1",
        "window.__3D_STATE__.basePairVisible[0] === false"
      ]
    },
    {
      "id": "S2",
      "name": "Five_Pairs_Unzipped",
      "conditions": [
        "window.__3D_STATE__.unzipLevel === 5"
      ]
    },
    {
      "id": "S3",
      "name": "Helix_Rotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.helixRotationDeg) >= 15"
      ]
    },
    {
      "id": "S4",
      "name": "Lantern_Off",
      "conditions": [
        "window.__3D_STATE__.lanternLightOn === false"
      ]
    },
    {
      "id": "S5",
      "name": "Labels_Visible",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.animationSpeed !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "Fully_Unzipped",
      "conditions": [
        "window.__3D_STATE__.unzipLevel === 20"
      ]
    },
    {
      "id": "S8",
      "name": "Rezipped",
      "conditions": [
        "window.__3D_STATE__.unzipLevel === 0",
        "window.__3D_STATE__.basePairVisible[0] === true"
      ]
    },
    {
      "id": "S9",
      "name": "Lantern_Restored",
      "conditions": [
        "window.__3D_STATE__.lanternLightOn === true"
      ]
    }
  ],
