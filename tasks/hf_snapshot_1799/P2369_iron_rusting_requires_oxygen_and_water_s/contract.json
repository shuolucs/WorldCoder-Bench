        "white particles near iron sample"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Pristine",
      "conditions": [
        "window.__3D_STATE__.waterEnabled === false",
        "window.__3D_STATE__.oxygenEnabled === false",
        "window.__3D_STATE__.rustPercentage === 0",
        "window.__3D_STATE__.isRusting === false"
      ]
    },
    {
      "id": "S1",
      "name": "WaterOnly_NoRust",
      "conditions": [
        "window.__3D_STATE__.waterEnabled === true",
        "window.__3D_STATE__.oxygenEnabled === false",
        "window.__3D_STATE__.isRusting === false"
      ]
    },
    {
      "id": "S2",
      "name": "OxygenOnly_NoRust",
      "conditions": [
        "window.__3D_STATE__.waterEnabled === false",
        "window.__3D_STATE__.oxygenEnabled === true",
        "window.__3D_STATE__.isRusting === false"
      ]
    },
    {
      "id": "S3",
      "name": "BothActive_Rusting",
      "conditions": [
        "window.__3D_STATE__.waterEnabled === true",
        "window.__3D_STATE__.oxygenEnabled === true",
        "window.__3D_STATE__.isRusting === true"
      ]
    },
    {
      "id": "S4",
      "name": "PartiallyRusted_Paused",
      "conditions": [
        "window.__3D_STATE__.rustPercentage > 0",
        "window.__3D_STATE__.isRusting === false"
      ]
    },
    {
      "id": "S5",
      "name": "FullyRusted",
      "conditions": [
        "window.__3D_STATE__.rustPercentage >= 99.9",
        "window.__3D_STATE__.isRusting === false"
      ]
    },
    {
      "id": "S6",
      "name": "ResetAfterRust",
      "conditions": [
        "window.__3D_STATE__.rustPercentage === 0",
        "window.__3D_STATE__.experimentResetCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "InfoPopupVisible",
      "conditions": [
        "window.__3D_STATE__.infoPopupVisible === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-water"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waterEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterParticleCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.oxygenEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenParticleCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-oxygen"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.waterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenParticleCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rustPercentage >= 12.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage <= 20.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ironRoughness > 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ironMetalness < 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedRustingTime) && window.__3D_STATE__.elapsedRustingTime >= 2.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-oxygen"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenParticleCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.rustPercentage === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rustPercentage - window.__3D_STATE__._t6_snapshot) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustParticleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ironRoughness === 0.3 + 0.65 * (window.__3D_STATE__.rustPercentage / 100)",
            "tier": "L2"
          }
        ],
        "setup_script": "window.__3D_STATE__._t6_snapshot = window.__3D_STATE__.rustPercentage;"
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustParticleCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target_hint": "iron sample center",
        "position": {
          "x": 0.5,
          "y": 0.45
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.infoPopupVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ironRoughness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ironMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ironColor !== undefined && typeof window.__3D_STATE__.ironColor.r === 'number'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ironColor.r) && !isNaN(window.__3D_STATE__.ironColor.g) && !isNaN(window.__3D_STATE__.ironColor.b)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rustPercentage === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.experimentResetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ironRoughness - 0.3) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ironMetalness - 0.8) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-water').click(); document.querySelector('#btn-oxygen').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.waterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oxygenEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRusting === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rustPercentage < 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.experimentResetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          }
        ]
      }
    }
