{
  "task_id": "P219_bowling_game",
  "affordances": [
    {
      "id": "A1",
      "name": "BowlingBall",
      "type": "3d_object",
      "semantic": "The bowling ball sphere that the player aims and throws",
      "locator_hints": [
        "dark blue sphere",
        "radius 0.3",
        "starts at z=14"
      ]
    },
    {
      "id": "A2",
      "name": "BowlingPins",
      "type": "3d_object",
      "semantic": "10 bowling pins in triangular formation",
      "locator_hints": [
        "white cylinders",
        "positioned around z=-12 to z=-14"
      ]
    },
    {
      "id": "A3",
      "name": "Lane",
      "type": "3d_object",
      "semantic": "The bowling lane surface",
      "locator_hints": [
        "wood-colored plane",
        "width 3.6"
      ]
    },
    {
      "id": "A4",
      "name": "PowerMeter",
      "type": "dom_element",
      "semantic": "Vertical power meter bar for throw strength",
      "locator_hints": [
        "#power-meter-fill",
        "#power-meter-container"
      ]
    },
    {
      "id": "A5",
      "name": "HUDInfo",
      "type": "dom_element",
      "semantic": "Frame, throw, and score display",
      "locator_hints": [
        "#hud-info"
      ]
    },
    {
      "id": "A6",
      "name": "PhaseText",
      "type": "dom_element",
      "semantic": "Current phase instructions",
      "locator_hints": [
        "#phase-text"
      ]
    },
    {
      "id": "A7",
      "name": "ScoreMessage",
      "type": "dom_element",
      "semantic": "Post-throw scoring message",
      "locator_hints": [
        "#score-message"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialAiming",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.pinsStanding === 10",
        "window.__3D_STATE__.throwNumber === 1"
      ]
    },
    {
      "id": "S1",
      "name": "AimAdjusted",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.ballAimX !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "PowerCharging",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'power'"
      ]
    },
    {
      "id": "S3",
      "name": "PowerLocked",
      "conditions": [
        "window.__3D_STATE__.power > 0",
        "window.__3D_STATE__.gamePhase === 'rolling'"
      ]
    },
    {
      "id": "S4",
      "name": "BallRolling",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'rolling'",
        "window.__3D_STATE__.ballPosition.z < 14"
      ]
    },
    {
      "id": "S5",
      "name": "FirstThrowScored",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'scored'",
        "window.__3D_STATE__.throwNumber === 1"
      ]
    },
    {
      "id": "S6",
      "name": "SecondThrowAiming",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.throwNumber === 2"
      ]
    },
    {
      "id": "S7",
      "name": "SecondThrowScored",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'scored'",
        "window.__3D_STATE__.throwNumber === 2"
      ]
    },
    {
      "id": "S8",
      "name": "NewFrameReset",
      "conditions": [
        "window.__3D_STATE__.pinsStanding === 10",
        "window.__3D_STATE__.currentFrame >= 2",
        "window.__3D_STATE__.gamePhase === 'aiming'"
      ]
    },
    {
      "id": "S9",
      "name": "GutterBallScored",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'scored'",
        "window.__3D_STATE__.isGutterBall === true"
      ]
    }
  ],
