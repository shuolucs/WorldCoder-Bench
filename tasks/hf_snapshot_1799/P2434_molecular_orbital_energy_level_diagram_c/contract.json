  "states": [
    {
      "id": "S0",
      "name": "Initial_H2_Selected",
      "conditions": [
        "window.__3D_STATE__.moleculeType === 'H2'",
        "window.__3D_STATE__.electronPool === 2",
        "window.__3D_STATE__.totalElectrons === 2",
        "window.__3D_STATE__.mosConstructed === false",
        "window.__3D_STATE__.bondOrder === null"
      ]
    },
    {
      "id": "S1",
      "name": "MOs_Constructed",
      "conditions": [
        "window.__3D_STATE__.mosConstructed === true",
        "window.__3D_STATE__.connectorLinesCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Orbital_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedOrbital !== null"
      ]
    },
    {
      "id": "S3",
      "name": "Electron_Placed",
      "conditions": [
        "window.__3D_STATE__.electronPool < window.__3D_STATE__.totalElectrons"
      ]
    },
    {
      "id": "S4",
      "name": "Bond_Order_Calculated",
      "conditions": [
        "window.__3D_STATE__.bondOrder !== null",
        "window.__3D_STATE__.bondStability !== null"
      ]
    },
    {
      "id": "S5",
      "name": "Molecule_Changed_O2",
      "conditions": [
        "window.__3D_STATE__.moleculeType === 'O2'",
        "window.__3D_STATE__.totalElectrons === 16"
      ]
    },
    {
      "id": "S6",
      "name": "AutoFill_Complete",
      "conditions": [
        "window.__3D_STATE__.autoFillComplete === true",
        "window.__3D_STATE__.electronPool === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Bond_Order_O2_Calculated",
      "conditions": [
        "window.__3D_STATE__.bondOrder === 2",
        "window.__3D_STATE__.bondStability === 'Stable'"
      ]
    },
    {
      "id": "S8",
      "name": "Undo_Performed",
      "conditions": [
        "window.__3D_STATE__.historyIndex >= 0"
      ]
    },
    {
      "id": "S9",
      "name": "Redo_Performed",
      "conditions": [
        "window.__3D_STATE__.historyIndex >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "Molecule_Changed_He2",
      "conditions": [
        "window.__3D_STATE__.moleculeType === 'He2'",
        "window.__3D_STATE__.totalElectrons === 4"
      ]
    },
    {
      "id": "S11",
      "name": "He2_Unstable",
      "conditions": [
        "window.__3D_STATE__.bondOrder === 0",
        "window.__3D_STATE__.bondStability === 'Unstable'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Construct MOs"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mosConstructed === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mosConstructed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connectorLinesCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.orbitals['σ1s'] !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitals['σ1s'].type === 'bonding'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitals['σ*1s'].type === 'antibonding'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
