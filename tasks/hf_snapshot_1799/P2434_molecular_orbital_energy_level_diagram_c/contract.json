      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedOrbital === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedOrbital === 'σ1s'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitals['σ1s'] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.orbitals['σ1s'].maxElectrons === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronPool === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.orbitals['σ1s'].electrons === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronPool === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronPool + window.__3D_STATE__.orbitals['σ1s'].electrons <= window.__3D_STATE__.totalElectrons",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronPlacements.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronPlacements[window.__3D_STATE__.electronPlacements.length - 1].action === 'add'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('button').closest('body').querySelectorAll('button').forEach(b => { if(b.textContent.includes('Calculate Bond Order')) b.click(); });"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bondOrder === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.bondOrder)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondOrder === (window.__3D_STATE__.totalBondingElectrons - window.__3D_STATE__.totalAntibondingElectrons) / 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bondStability === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBondingElectrons + window.__3D_STATE__.totalAntibondingElectrons + window.__3D_STATE__.electronPool === window.__3D_STATE__.totalElectrons",
            "tier": "L2"
          }
        ]
