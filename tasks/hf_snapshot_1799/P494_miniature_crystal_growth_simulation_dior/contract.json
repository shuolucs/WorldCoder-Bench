{
  "task_id": "P494_miniature_crystal_growth_simulation_dior",
  "affordances": [
    {
      "id": "A1",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to trigger next crystal growth wave",
      "locator_hints": [
        "button:contains('Grow')",
        "#growBtn",
        "button with text 'Grow Crystals'"
      ]
    },
    {
      "id": "A2",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all crystals",
      "locator_hints": [
        "button:contains('Reset')",
        "#resetBtn",
        "button with text 'Reset'"
      ]
    },
    {
      "id": "A3",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider for growth speed multiplier",
      "locator_hints": [
        "input[type='range']",
        "#speedSlider"
      ]
    },
    {
      "id": "A4",
      "name": "Helmet",
      "type": "3d_object",
      "semantic": "DamagedHelmet.glb model on pedestal, clickable for glow toggle",
      "locator_hints": [
        "GLTF model at center",
        "object named Helmet or DamagedHelmet"
      ]
    },
    {
      "id": "A5",
      "name": "Crystals",
      "type": "3d_object",
      "semantic": "Growing crystal formations around pedestal",
      "locator_hints": [
        "crystal meshes",
        "cone-like geometries around pedestal"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Info panel showing crystal count, wave, speed",
      "locator_hints": [
        "top-left panel",
        "div with crystal count text"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Scene_Loaded",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.currentWave === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Wave1_Growing",
      "conditions": [
        "window.__3D_STATE__.currentWave === 1",
        "window.__3D_STATE__.crystalCount >= 5",
        "window.__3D_STATE__.crystalCount <= 8",
        "window.__3D_STATE__.isGrowing === true"
      ]
    },
    {
      "id": "S2",
      "name": "Wave1_Grown",
      "conditions": [
        "window.__3D_STATE__.currentWave === 1",
        "window.__3D_STATE__.isGrowing === false"
      ]
    },
    {
      "id": "S3",
      "name": "Wave2_Spawned",
      "conditions": [
        "window.__3D_STATE__.currentWave === 2",
        "window.__3D_STATE__.crystalCount >= 10"
      ]
    },
    {
      "id": "S4",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.growthSpeed >= 2.0"
      ]
    },
    {
      "id": "S5",
      "name": "Glow_Active",
      "conditions": [
        "window.__3D_STATE__.glowMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "Glow_Deactivated",
      "conditions": [
        "window.__3D_STATE__.glowMode === false"
      ]
    },
    {
      "id": "S7",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.currentWave === 0",
        "window.__3D_STATE__.averageCrystalHeight === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "GrowButton",
        "description": "Click 'Grow Crystals' to spawn wave 1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000,
        "description": "Wait for wave 1 crystals to finish growing to target heights"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g",
        "description": "Press 'G' key to trigger wave 2 growth"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range]').value = 2.5; document.querySelector('input[type=range]').dispatchEvent(new Event('input'));",
        "description": "Set speed slider to 2.5x"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target": "Helmet",
        "position": {
          "x": 0.5,
          "y": 0.4
        },
        "description": "Click on the helmet to activate glow mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target": "Helmet",
        "position": {
          "x": 0.5,
          "y": 0.4
        },
        "description": "Click helmet again to deactivate glow mode (toggle off)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "ResetButton",
        "description": "Click Reset to clear all crystals and return to initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g",
        "description": "Press 'G' after reset to verify crystals can grow again from scratch"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}