      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing fallen count, sim time, chain status",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A8",
      "name": "ControlBar",
      "type": "dom_element",
      "semantic": "Bottom-center control bar with buttons and slider",
      "locator_hints": [
        "#controlBar"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.dominoCount === 20",
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.chainComplete === false"
      ]
    },
    {
      "id": "S1",
      "name": "Simulation_Started",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.dominoAngles[0] > 0.087"
      ]
    },
    {
      "id": "S2",
      "name": "First_Group_Falling",
      "conditions": [
        "window.__3D_STATE__.fallenCount >= 3",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Mid_Chain_Propagation",
      "conditions": [
        "window.__3D_STATE__.fallenCount >= 10",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.simulationPaused === true",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S5",
      "name": "Simulation_Resumed",
      "conditions": [
        "window.__3D_STATE__.simulationPaused === false",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S6",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.timeScale !== 1.0",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S7",
      "name": "Chain_Complete",
      "conditions": [
        "window.__3D_STATE__.chainComplete === true",
        "window.__3D_STATE__.fallenCount === 20"
      ]
    },
    {
      "id": "S8",
      "name": "Domino_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedDomino >= 0",
        "window.__3D_STATE__.selectedDomino < 20"
      ]
    },
    {
      "id": "S9",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.fallenCount === 0",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.chainComplete === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dominoCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.every(a => Math.abs(a) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoSpacings.length === 19",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[0] > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes[0] >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "!window.__3D_STATE__.dominoAngles.some(a => isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[0] > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[1] > 0.087",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes[0] < window.__3D_STATE__.dominoFallTimes[1]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes[1] < window.__3D_STATE__.dominoFallTimes[2]",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.slice(0, 7).every(a => a > 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "!window.__3D_STATE__.dominoAngles.some(a => isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.every(a => a >= 0 && a <= 1.6)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount >= 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.5; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.timeScale - 2.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fallenCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastDominoAngle > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes.every(t => t >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes.every((t, i) => i === 0 || t > window.__3D_STATE__.dominoFallTimes[i-1])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fallenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainComplete === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles.every(a => Math.abs(a) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes.every(t => t === -1)",
            "tier": "L2"
          }
        ]
