      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedDomino === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoFallTimes[10] >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dominoAngles[10] > 0.087",
            "tier": "L2"
          }
        ]
      }
    }
  ]
