    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Octahedral|octahedral"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.geometry === 'octahedral'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.orbitalTargetPositions === 'object' && window.__3D_STATE__.orbitalTargetPositions.dxy !== undefined",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.orbitalTargetPositions.dxy - (-1.5)) < 0.01 && Math.abs(window.__3D_STATE__.orbitalTargetPositions.dxz - (-1.5)) < 0.01 && Math.abs(window.__3D_STATE__.orbitalTargetPositions.dyz - (-1.5)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.orbitalTargetPositions.dx2y2 - 2.0) < 0.01 && Math.abs(window.__3D_STATE__.orbitalTargetPositions.dz2 - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('+')){b.click()}})}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.electronCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalElectronCheck === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronDistribution.dxy === 1 && window.__3D_STATE__.electronDistribution.dxz === 1 && window.__3D_STATE__.electronDistribution.dyz === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronDistribution.dx2y2 === 0 && window.__3D_STATE__.electronDistribution.dz2 === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cfse - (3 * (-1.5))) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('+')&&!b.textContent.includes('Planar')){b.click()}})}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.electronCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinState === 'high'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalElectronCheck === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronDistribution.dxy + window.__3D_STATE__.electronDistribution.dxz + window.__3D_STATE__.electronDistribution.dyz >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electronDistribution.dx2y2 + window.__3D_STATE__.electronDistribution.dz2 >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cfse === 'number' && !isNaN(window.__3D_STATE__.cfse)",
            "tier": "L0"
          }
        ]
      }
    },
