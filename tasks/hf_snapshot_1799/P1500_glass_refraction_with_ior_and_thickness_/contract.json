  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.activeObject === 'torusknot'",
        "window.__3D_STATE__.torusknot.ior === 1.5",
        "window.__3D_STATE__.torusknot.thickness === 0.5",
        "window.__3D_STATE__.torusknot.roughness === 0.0",
        "window.__3D_STATE__.sphere.ior === 1.33",
        "window.__3D_STATE__.refTargetCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "IORModified",
      "conditions": [
        "window.__3D_STATE__.torusknot.ior !== 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "ThicknessModified",
      "conditions": [
        "window.__3D_STATE__.torusknot.thickness !== 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "SphereSelected",
      "conditions": [
        "window.__3D_STATE__.activeObject === 'sphere'"
      ]
    },
    {
      "id": "S4",
      "name": "SphereIORModified",
      "conditions": [
        "window.__3D_STATE__.activeObject === 'sphere'",
        "window.__3D_STATE__.sphere.ior !== 1.33"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeEnabled",
      "conditions": [
        "window.__3D_STATE__.sphere.wireframe === true"
      ]
    },
    {
      "id": "S6",
      "name": "ThicknessPresetCycled",
      "conditions": [
        "window.__3D_STATE__.thicknessPresetIndex !== 1"
      ]
    },
    {
      "id": "S7",
      "name": "RoughnessModified",
      "conditions": [
        "window.__3D_STATE__.torusknot.roughness > 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetApplied",
      "conditions": [
        "window.__3D_STATE__.torusknot.ior === 1.5",
        "window.__3D_STATE__.torusknot.thickness === 0.5",
        "window.__3D_STATE__.torusknot.roughness === 0.0"
      ]
    },
    {
      "id": "S9",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.torusknot === 'object' && typeof window.__3D_STATE__.sphere === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.torusknot.ior === 1.5 && window.__3D_STATE__.torusknot.thickness === 0.5 && window.__3D_STATE__.torusknot.roughness === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphere.ior === 1.33 && window.__3D_STATE__.sphere.thickness === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refTargetCount === 5 && window.__3D_STATE__.lightCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererToneMapping === 'ACESFilmic'",
            "tier": "L2"
          }
        ]
