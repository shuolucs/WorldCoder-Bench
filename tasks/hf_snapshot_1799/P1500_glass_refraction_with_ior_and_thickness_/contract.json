            "expr": "Math.abs(window.__3D_STATE__.torusknot.ior - 1.5) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torusknot.thickness - 0.5) < 0.02",
