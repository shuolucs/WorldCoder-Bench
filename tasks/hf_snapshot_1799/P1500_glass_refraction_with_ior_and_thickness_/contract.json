      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('iorSlider').value = '2.0'; document.getElementById('iorSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeObject === 'torusknot'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torusknot.ior - 2.0) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('iorValue').textContent.includes('2.0') || document.getElementById('iorValue').textContent.includes('2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusknot.ior >= 1.0 && window.__3D_STATE__.torusknot.ior <= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusknot.transmission === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
