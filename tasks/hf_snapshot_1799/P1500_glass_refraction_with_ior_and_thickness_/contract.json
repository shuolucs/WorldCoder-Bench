          },
          {
            "expr": "window.__3D_STATE__.torusknot.thickness > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('thicknessValue').textContent.includes('1.5')",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torusknot.ior - 2.0) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusknot.wireframe === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
