{
  "task_id": "P98_audio_visualizer",
  "affordances": [
    {
      "id": "A1",
      "name": "VizMesh",
      "type": "3d_object",
      "semantic": "柱状/球波/波形几何",
      "locator_hints": [
        "bars",
        "sphere",
        "wave"
      ]
    },
    {
      "id": "A2",
      "name": "VizMode",
      "type": "dom_element",
      "semantic": "可视化模式",
      "locator_hints": [
        "vizMode"
      ]
    },
    {
      "id": "A3",
      "name": "Sensitivity",
      "type": "dom_element",
      "semantic": "灵敏度",
      "locator_hints": [
        "sensitivity"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "bars_default",
      "description": "默认柱模式"
    },
    {
      "id": "S1",
      "name": "sphere_mode",
      "description": "球模式"
    },
    {
      "id": "S2",
      "name": "sens_high",
      "description": "高灵敏度"
    },
    {
      "id": "S3",
      "name": "wave_mode",
      "description": "波模式"
    },
    {
      "id": "S4",
      "name": "back_bars",
      "description": "回柱模式"
    },
    {
      "id": "S5",
      "name": "bins_ok",
      "description": "128 bin"
    },
    {
      "id": "S6",
      "name": "amplitude_ok",
      "description": "幅度统计"
    },
    {
      "id": "S7",
      "name": "beat_bool",
      "description": "节拍布尔"
    },
    {
      "id": "S8",
      "name": "stable",
      "description": "simTime 递增"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "binCount=128"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.binCount === 128",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.vizMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.sensitivity)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beatDetected === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.simTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_input",
        "selector": "#vizMode",
        "value": "sphere"
      },
      "postconditions": [
        "vizMode sphere"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.vizMode === 'sphere'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_input",
        "selector": "#sensitivity",
        "value": "2"
      },
      "postconditions": [
        "sensitivity 升高"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "window.__3D_STATE__.sensitivity > 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_input",
        "selector": "#vizMode",
        "value": "wave"
      },
      "postconditions": [
        "wave 模式"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.vizMode === 'wave'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_input",
        "selector": "#vizMode",
        "value": "bars"
      },
      "postconditions": [
        "bars 模式"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.vizMode === 'bars'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "binCount 不变"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.binCount === 128",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "max/avg 非负有限"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.maxAmplitude) && window.__3D_STATE__.maxAmplitude >= 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.avgAmplitude) && window.__3D_STATE__.avgAmplitude >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "simTime 推进"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}