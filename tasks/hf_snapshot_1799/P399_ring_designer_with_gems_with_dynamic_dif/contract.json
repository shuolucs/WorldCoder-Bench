  "states": [
    {
      "id": "S0",
      "name": "Initial_Default",
      "conditions": [
        "window.__3D_STATE__.ringMetal === 'gold'",
        "window.__3D_STATE__.gemColor === 'diamond'",
        "window.__3D_STATE__.gemCount === 5",
        "window.__3D_STATE__.gemSize === 0.1",
        "window.__3D_STATE__.isRotating === false",
        "window.__3D_STATE__.price === 1500"
      ]
    },
