        "window.__3D_STATE__.gemColor === 'ruby'"
      ]
    },
    {
      "id": "S3",
      "name": "Gem_Count_Three",
      "conditions": [
        "window.__3D_STATE__.gemCount === 3",
        "window.__3D_STATE__.price === 500 + 3 * 200 * (window.__3D_STATE__.gemSize / 0.1)"
      ]
    },
    {
      "id": "S4",
      "name": "Ring_Rotating",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ]
    },
    {
