{
  "task_id": "P282_brain_connectivity_map",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainModel",
      "type": "3d_object",
      "semantic": "Loaded LittlestTokyo.glb model used as brain scaffold",
      "locator_hints": [
        "GLB model at origin",
        "transparent mesh"
      ]
    },
    {
      "id": "A2",
      "name": "BrainNodes",
      "type": "3d_object",
      "semantic": "20 sphere nodes representing brain regions",
      "locator_hints": [
        "small colored spheres",
        "radius 0.15"
      ]
    },
    {
      "id": "A3",
      "name": "ConnectivityEdges",
      "type": "3d_object",
      "semantic": "30 line connections between nodes",
      "locator_hints": [
        "THREE.Line objects",
        "blended colors"
      ]
    },
    {
      "id": "A4",
      "name": "HUDOverlay",
      "type": "dom_element",
      "semantic": "Top-left status display",
      "locator_hints": [
        "div with node/edge counts"
      ]
    },
    {
      "id": "A5",
      "name": "InstructionsPanel",
      "type": "dom_element",
      "semantic": "Bottom instructions panel",
      "locator_hints": [
        "bottom div with key bindings"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "Scene_Ready",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.nodeCount === 20",
        "window.__3D_STATE__.edgeCount === 30",
        "window.__3D_STATE__.selectedNode === -1"
      ]
    },
    {
      "id": "S2",
      "name": "Rotating",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === true",
        "window.__3D_STATE__.currentRotationY > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Rotation_Paused",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "Node_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedNode >= 0",
        "window.__3D_STATE__.highlightedEdges > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Group_Filtered",
      "conditions": [
        "window.__3D_STATE__.activeGroup >= 0",
        "window.__3D_STATE__.visibleNodes < 20"
      ]
    },
    {
      "id": "S6",
      "name": "Weighted_Mode",
      "conditions": [
        "window.__3D_STATE__.connectionStrengthMode === 'weighted'"
      ]
    },
    {
      "id": "S7",
      "name": "Pulse_Active",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S8",
      "name": "Zoomed_In",
      "conditions": [
        "window.__3D_STATE__.zoomLevel > 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "Model_Hidden",
      "conditions": [
        "window.__3D_STATE__.modelOpacity === 0"
      ]
    },
    {
      "id": "S10",
      "name": "Node_Deselected",
      "conditions": [
        "window.__3D_STATE__.selectedNode === -1",
        "window.__3D_STATE__.highlightedEdges === 0"
      ]
    }
  ],
  "transitions": [
