{
  "task_id": "P365_car_paint_visualizer_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "DuckModel",
      "type": "3d_object",
      "semantic": "The loaded Duck.glb model acting as the car stand-in",
      "locator_hints": [
        "scene.children find mesh",
        "GLTFLoader result"
      ]
    },
    {
      "id": "A2",
      "name": "ColorSwatch0",
      "type": "dom_element",
      "semantic": "Ruby Red paint swatch button",
      "locator_hints": [
        "#swatch-0"
      ]
    },
    {
      "id": "A3",
      "name": "ColorSwatch1",
      "type": "dom_element",
      "semantic": "Ocean Blue paint swatch button",
      "locator_hints": [
        "#swatch-1"
      ]
    },
    {
      "id": "A4",
      "name": "ColorSwatch2",
      "type": "dom_element",
      "semantic": "Forest Green paint swatch button",
      "locator_hints": [
        "#swatch-2"
      ]
    },
    {
      "id": "A5",
      "name": "FinishButton0",
      "type": "dom_element",
      "semantic": "Glossy finish button",
      "locator_hints": [
        "#finish-0"
      ]
    },
    {
      "id": "A6",
      "name": "FinishButton1",
      "type": "dom_element",
      "semantic": "Matte finish button",
      "locator_hints": [
        "#finish-1"
      ]
    },
    {
      "id": "A7",
      "name": "FinishButton2",
      "type": "dom_element",
      "semantic": "Metallic finish button",
      "locator_hints": [
        "#finish-2"
      ]
    },
    {
      "id": "A8",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Time of day slider control",
      "locator_hints": [
        "#time-slider"
      ]
    },
    {
      "id": "A9",
      "name": "AutoRotateBtn",
      "type": "dom_element",
      "semantic": "Toggle button for auto-rotation",
      "locator_hints": [
        "#auto-rotate-btn"
      ]
    },
    {
      "id": "A10",
      "name": "TimeLabel",
      "type": "dom_element",
      "semantic": "Label showing current time of day",
      "locator_hints": [
        "#time-label"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedDefault",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentPaintIndex === 0",
        "window.__3D_STATE__.currentFinishIndex === 0",
        "window.__3D_STATE__.timeSliderValue === 50"
      ]
    },
    {
      "id": "S1",
      "name": "PaintChangedBlue",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 1",
        "window.__3D_STATE__.currentPaintName === 'Ocean Blue'"
      ]
    },
    {
      "id": "S2",
      "name": "FinishChangedMatte",
      "conditions": [
        "window.__3D_STATE__.currentFinishIndex === 1",
        "window.__3D_STATE__.currentFinishName === 'Matte'"
      ]
    },
    {
      "id": "S3",
      "name": "TimeSunrise",
      "conditions": [
        "window.__3D_STATE__.timeSliderValue <= 5",
        "window.__3D_STATE__.sunAngle < 0.2"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "PaintChangedGreen",
      "conditions": [
        "window.__3D_STATE__.currentPaintIndex === 2",
        "window.__3D_STATE__.currentPaintName === 'Forest Green'"
      ]
    },
    {
      "id": "S6",
      "name": "FinishChangedMetallic",
      "conditions": [
        "window.__3D_STATE__.currentFinishIndex === 2",
        "window.__3D_STATE__.currentFinishName === 'Metallic'"
      ]
    },
    {
      "id": "S7",
      "name": "TimeSunset",
      "conditions": [
        "window.__3D_STATE__.timeSliderValue >= 95",
        "window.__3D_STATE__.sunAngle > 2.9"
      ]
    },
    {
      "id": "S8",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Ruby Red'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinishName === 'Glossy'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sunAngle)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#swatch-1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Ocean Blue'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintColor === '#0055AA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialMetalness >= 0 && window.__3D_STATE__.materialMetalness <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#finish-1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentFinishIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinishName === 'Matte'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.materialRoughness - 0.8) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.materialMetalness - 0.2) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('time-slider').value = 0; document.getElementById('time-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeSliderValue <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunAngle < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunPositionY < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity <= 0.3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sunPositionY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintName === 'Forest Green'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintColor === '#228B22'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentFinishIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFinishName === 'Metallic'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.materialRoughness - 0.25) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.materialMetalness - 0.95) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPaintIndex === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('time-slider').value = 100; document.getElementById('time-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeSliderValue >= 95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunAngle > 2.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunPositionY < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity <= 0.3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sunIntensity)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}