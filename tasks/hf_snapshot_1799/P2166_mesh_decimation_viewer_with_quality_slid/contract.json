{
  "task_id": "P2166_mesh_decimation_viewer_with_quality_slid",
  "affordances": [
    {
      "id": "A1",
      "name": "SheenChairModel",
      "type": "3d_object",
      "semantic": "The loaded SheenChair GLB model displayed in the scene",
      "locator_hints": [
        "scene.children mesh",
        "GLTFLoader result"
      ]
    },
    {
      "id": "A2",
      "name": "QualitySlider",
      "type": "dom_element",
      "semantic": "Range slider controlling decimation quality from 5 to 100",
      "locator_hints": [
        "#quality-slider",
        "input[type=range]"
      ]
    },
    {
      "id": "A3",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last quality change",
      "locator_hints": [
        "#undo-btn"
      ]
    },
    {
      "id": "A4",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone quality change",
      "locator_hints": [
        "#redo-btn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset quality to 100%",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A6",
      "name": "WireframeButton",
      "type": "dom_element",
      "semantic": "Button to toggle wireframe rendering",
      "locator_hints": [
        "#wireframe-btn"
      ]
    },
    {
      "id": "A7",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing triangle count, vertex count, decimation ratio",
      "locator_hints": [
        "#info-panel"
      ]
    },
    {
      "id": "A8",
      "name": "TriCountDisplay",
      "type": "dom_element",
      "semantic": "Span showing current triangle count",
      "locator_hints": [
        "#tri-count"
      ]
    },
    {
      "id": "A9",
      "name": "DecimationPctDisplay",
      "type": "dom_element",
      "semantic": "Span showing decimation percentage",
      "locator_hints": [
        "#decimation-pct"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_FullQuality",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentQuality === 100",
        "window.__3D_STATE__.currentTriCount === window.__3D_STATE__.originalTriCount"
      ]
    },
    {
      "id": "S1",
      "name": "Decimated_50pct",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 50",
        "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount"
      ]
    },
    {
      "id": "S2",
      "name": "Decimated_25pct",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 25",
        "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount * 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo_BackTo50",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 50",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedo_BackTo25",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 25",
        "window.__3D_STATE__.canUndo === true"
      ]
    },
    {
      "id": "S5",
      "name": "AfterReset_FullQuality",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 100",
        "window.__3D_STATE__.currentTriCount === window.__3D_STATE__.originalTriCount"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeEnabled",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "Decimated_10pct",
      "conditions": [
        "window.__3D_STATE__.currentQuality === 10",
        "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount * 0.25"
      ]
    },
    {
      "id": "S8",
      "name": "AfterKeyboardUndo",
      "conditions": [
        "window.__3D_STATE__.undoCount >= 2",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S9",
      "name": "AfterKeyboardRedo",
      "conditions": [
        "window.__3D_STATE__.redoCount >= 1",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.originalTriCount === 'number' && window.__3D_STATE__.originalTriCount > 0 && !isNaN(window.__3D_STATE__.originalTriCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount === window.__3D_STATE__.originalTriCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentQuality === 100",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.historyStack) && window.__3D_STATE__.historyStack.length === 1 && window.__3D_STATE__.historyStack[0] === 100",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('quality-slider'); if(slider) { const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSetter.call(slider, '50'); slider.dispatchEvent(new Event('input', {bubbles:true})); slider.dispatchEvent(new Event('change', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount > 0 && !isNaN(window.__3D_STATE__.currentTriCount)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.decimationRatio - (window.__3D_STATE__.currentTriCount / window.__3D_STATE__.originalTriCount)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStack.length === 2 && window.__3D_STATE__.historyIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canUndo === true && window.__3D_STATE__.canRedo === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('quality-slider'); if(slider) { const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSetter.call(slider, '25'); slider.dispatchEvent(new Event('input', {bubbles:true})); slider.dispatchEvent(new Event('change', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount * 0.55",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.decimationRatio < 0.55 && window.__3D_STATE__.decimationRatio > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStack.length === 3 && window.__3D_STATE__.historyIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canUndo === true && window.__3D_STATE__.canRedo === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#undo-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canRedo === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canUndo === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#redo-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canRedo === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canUndo === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount === window.__3D_STATE__.originalTriCount",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.decimationRatio - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentVertCount === 'number' && window.__3D_STATE__.currentVertCount > 0 && !isNaN(window.__3D_STATE__.currentVertCount)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'wireframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentQuality === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount === window.__3D_STATE__.originalTriCount",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.meshCount === 'number' && window.__3D_STATE__.meshCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('quality-slider'); if(slider) { const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSetter.call(slider, '10'); slider.dispatchEvent(new Event('input', {bubbles:true})); slider.dispatchEvent(new Event('change', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentQuality === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount < window.__3D_STATE__.originalTriCount * 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTriCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.decimationRatio < 0.25 && window.__3D_STATE__.decimationRatio > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTriCount) && isFinite(window.__3D_STATE__.currentTriCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z",
        "ctrlKey": true
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canRedo === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentQuality === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyIndex < window.__3D_STATE__.historyStack.length - 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y",
        "ctrlKey": true
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentQuality === 10",
            "tier": "L2"
