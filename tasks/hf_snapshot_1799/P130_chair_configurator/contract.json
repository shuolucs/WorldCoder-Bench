{
  "task_id": "P130_chair_configurator",
  "affordances": [
    {
      "id": "A1",
      "name": "SheenChair",
      "type": "3d_object",
      "semantic": "GLB 模型 SheenChair.glb",
      "locator_hints": [
        "sheenchair"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "loading",
      "description": "模型加载中"
    },
    {
      "id": "S1",
      "name": "ready",
      "description": "椅子加载完成"
    },
    {
      "id": "S2",
      "name": "material_changed",
      "description": "材质被切换"
    },
    {
      "id": "S3",
      "name": "saved",
      "description": "配置已保存"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "typeof window.__3D_STATE__.materialType === \"string\""
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.materialType !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorHex !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.legStyle !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedConfigs === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.materialType === \"string\"",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const c = document.querySelector('canvas'); if(!c) return false; const gl = c.getContext('webgl2') || c.getContext('webgl'); return gl !== null; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ const b=document.getElementById(\"matFabric\"); if(b) b.click(); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.materialType !== undefined"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedConfigs !== before.savedConfigs || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedConfigs === 'number' && !isNaN(window.__3D_STATE__.savedConfigs)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ const b=document.getElementById(\"saveBtn\"); if(b) b.click(); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "window.__3D_STATE__.savedConfigs >= 0"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedConfigs !== before.savedConfigs || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedConfigs === 'number' && !isNaN(window.__3D_STATE__.savedConfigs)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedConfigs >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}