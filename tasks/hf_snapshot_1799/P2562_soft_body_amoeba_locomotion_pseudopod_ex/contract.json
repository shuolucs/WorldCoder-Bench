{
  "task_id": "P2562_soft_body_amoeba_locomotion_pseudopod_ex",
  "affordances": [
    {
      "id": "A1",
      "name": "AmoebaMesh",
      "type": "3d_object",
      "semantic": "The deformable soft-body amoeba mesh on the ground plane",
      "locator_hints": [
        "translucent green-blue mesh",
        "icosahedron-based geometry",
        "scene.children with opacity < 1"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Flat 40x40 ground plane the amoeba moves on",
      "locator_hints": [
        "PlaneGeometry 40x40",
        "y=0 surface"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing centroid, volume, pseudopod count, state, distance",
      "locator_hints": [
        "div positioned top-left",
        "contains centroid and volume text"
      ]
    },
    {
      "id": "A4",
      "name": "VolumeVizSphere",
      "type": "3d_object",
      "semantic": "Wireframe sphere toggled by V key showing current volume",
      "locator_hints": [
        "wireframe sphere at centroid",
        "toggled visibility"
      ]
    },
    {
      "id": "A5",
      "name": "TrailLine",
      "type": "3d_object",
      "semantic": "Fading line showing centroid path history",
      "locator_hints": [
        "Line or BufferGeometry trail",
        "toggled by T key"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialResting",
      "conditions": [
        "window.__3D_STATE__.particleCount > 0",
        "window.__3D_STATE__.activePseudopods === 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.totalDistanceTraveled === 0 || window.__3D_STATE__.totalDistanceTraveled < 0.1"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationSettled",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.volume > 0",
        "window.__3D_STATE__.groundContactCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PseudopodExtending",
      "conditions": [
        "window.__3D_STATE__.activePseudopods >= 1",
        "window.__3D_STATE__.pseudopods.length >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "PseudopodAnchored",
      "conditions": [
        "window.__3D_STATE__.pseudopods.some(p => p.phase === 'anchored' || p.phase === 'contracting')"
      ]
    },
    {
      "id": "S4",
      "name": "AmoebaMoved",
      "conditions": [
        "window.__3D_STATE__.totalDistanceTraveled > 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.frameCount > 60"
      ]
    },
    {
      "id": "S7",
      "name": "VolumeVizOn",
      "conditions": [
        "window.__3D_STATE__.volumeVizEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "TrailEnabled",
      "conditions": [
        "window.__3D_STATE__.trailEnabled === true"
      ]
    },
    {
      "id": "S9",
      "name": "PseudopodsRetracted",
      "conditions": [
        "window.__3D_STATE__.activePseudopods === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount > 40",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.springCount === 'number' && window.__3D_STATE__.springCount > 100",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.volume > 0 && !isNaN(window.__3D_STATE__.volume)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialVolume > 0 && !isNaN(window.__3D_STATE__.initialVolume)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundContactCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.centroid.y) < 3.0 && !isNaN(window.__3D_STATE__.centroid.x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "position": {
          "x": 0.65,
          "y": 0.65
        },
        "button": "left"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePseudopods >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pseudopods.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pseudopods[0].targetPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pseudopods[0].phase === 'extending' || window.__3D_STATE__.pseudopods[0].phase === 'anchored' || window.__3D_STATE__.pseudopods[0].phase === 'contracting'",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pseudopods[0].tipPosition.x)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pseudopods.some(p => p.phase === 'anchored' || p.phase === 'contracting')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pseudopods.some(p => p.anchoredParticleCount > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleSpeed >= 0 && !isNaN(window.__3D_STATE__.avgParticleSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kineticEnergy >= 0 && !isNaN(window.__3D_STATE__.kineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.volume - window.__3D_STATE__.initialVolume) / window.__3D_STATE__.initialVolume < 0.35",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalDistanceTraveled > 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalDistanceTraveled)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.centroidHistory.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.centroidHistory[0].x !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.springEnergy >= 0 && !isNaN(window.__3D_STATE__.springEnergy) && isFinite(window.__3D_STATE__.springEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
