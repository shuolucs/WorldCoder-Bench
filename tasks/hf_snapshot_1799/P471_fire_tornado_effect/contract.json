  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.width === 1.0",
        "window.__3D_STATE__.colorTheme === 'fire'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.embersVisible === true",
        "window.__3D_STATE__.isBursting === false",
        "window.__3D_STATE__.groundPlaneExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "IntensityChanged",
      "conditions": [
        "window.__3D_STATE__.intensity === 2.5"
      ]
    },
    {
      "id": "S2",
      "name": "WidthChanged",
      "conditions": [
        "window.__3D_STATE__.width === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "EmbersHidden",
      "conditions": [
        "window.__3D_STATE__.embersVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "ColorThemeBlue",
      "conditions": [
        "window.__3D_STATE__.colorTheme === 'blue'"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S7",
      "name": "BurstActive",
      "conditions": [
        "window.__3D_STATE__.isBursting === true"
      ]
    },
    {
      "id": "S8",
      "name": "BurstEnded",
      "conditions": [
        "window.__3D_STATE__.isBursting === false"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.intensity === 1.0",
        "window.__3D_STATE__.width === 1.0",
        "window.__3D_STATE__.colorTheme === 'fire'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.embersVisible === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('intensitySlider').value = 2.5; document.getElementById('intensitySlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('intensitySlider').value == '2.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('intensityDisplay') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
