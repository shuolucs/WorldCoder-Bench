      "action": {
        "type": "script",
        "code": "if(window.__3D_STATE__ && typeof window.__selectBasePair === 'function') { window.__selectBasePair(2); } else { /* fallback: simulate raycaster click on base pair 2 */ window.__3D_STATE__.selectedBasePair = 2; window.__3D_STATE__.selectedPairType = 'AT'; window.__3D_STATE__.selectedPairState = 'Unzipped'; }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('basePairInfo').textContent.includes('2')",
            "tier": "L2"
          }
