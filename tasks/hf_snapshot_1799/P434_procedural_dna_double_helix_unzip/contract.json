  "states": [
    {
      "id": "S0",
      "name": "FullyZipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 0",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.progressPercent === 0"
      ]
    },
    {
      "id": "S1",
      "name": "OneUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 1",
        "window.__3D_STATE__.basePairStates[0] === true"
      ]
    },
    {
      "id": "S2",
      "name": "ThreeUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 3"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed === 3"
      ]
    },
    {
      "id": "S4",
      "name": "MultiUnzipDone",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 6"
      ]
    },
    {
      "id": "S5",
      "name": "BasePairSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBasePair !== null"
      ]
    },
    {
      "id": "S6",
      "name": "AutoUnzipActive",
      "conditions": [
        "window.__3D_STATE__.autoUnzipActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "HalfUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress >= 10"
      ]
    },
    {
      "id": "S8",
      "name": "FullyUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 20",
        "window.__3D_STATE__.temperature === 95"
      ]
    },
    {
      "id": "S9",
      "name": "RezippedAll",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 0",
        "window.__3D_STATE__.temperature === 25"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#unzipBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('unzipBtn').click(); setTimeout(() => document.getElementById('unzipBtn').click(), 600);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
