{
  "task_id": "P2431_osmotic_pressure_membrane_semipermeable_",
  "affordances": [
    {
      "id": "A1",
      "name": "LeftChamber",
      "type": "3d_object",
      "semantic": "Transparent blue box holding solute (red) particles — high concentration side",
      "locator_hints": [
        "position.x ≈ -1.5",
        "blue-tinted transparent mesh"
      ]
    },
    {
      "id": "A2",
      "name": "RightChamber",
      "type": "3d_object",
      "semantic": "Transparent green box holding water (cyan) particles — solvent side",
      "locator_hints": [
        "position.x ≈ 1.5",
        "green-tinted transparent mesh"
      ]
    },
    {
      "id": "A3",
      "name": "SemipermeableMembrane",
      "type": "3d_object",
      "semantic": "Thin yellow plane at x=0 separating the two chambers",
      "locator_hints": [
        "position.x ≈ 0",
        "yellow plane mesh"
      ]
    },
    {
      "id": "A4",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "Decorative lab pressure gauge artifact loaded from GLB",
      "locator_hints": [
        "position (-3, 3.5, 0)",
        "GLTF loaded model"
      ]
    },
    {
      "id": "A5",
      "name": "StartStopButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation running state",
      "locator_hints": [
        "#startStopBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "AddSoluteButton",
      "type": "dom_element",
      "semantic": "Button to add 5 more solute particles to left chamber",
      "locator_hints": [
        "#addSoluteBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay displaying pressure, levels, counts, status",
      "locator_hints": [
        "#hud",
        "#pressureDisplay",
        "#statusDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "EquilibriumLine",
      "type": "3d_object",
      "semantic": "Dashed red line showing predicted equilibrium level, toggled by E key",
      "locator_hints": [
        "LineBasicMaterial",
        "red dashed line"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.helmetLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.equilibriumReached === false"
      ]
    },
    {
      "id": "S2",
      "name": "WaterTransferring",
      "conditions": [
        "window.__3D_STATE__.transferredCount > 0",
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S3",
      "name": "SoluteAdded",
      "conditions": [
        "window.__3D_STATE__.soluteCount > 40"
      ]
    },
    {
      "id": "S4",
      "name": "HighTempActive",
      "conditions": [
        "window.__3D_STATE__.highTempMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "EquilibriumLineShown",
      "conditions": [
        "window.__3D_STATE__.equilibriumLineVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationStopped",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.transferredCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.transferredCount === 0",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.osmoticPressure === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soluteCount === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.membraneIntact === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startStopBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.equilibriumReached === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transferredCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.osmoticPressure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.leftWaterLevel)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusDisplay').textContent.includes('Running')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.transferredCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.osmoticPressure === window.__3D_STATE__.transferredCount * 0.12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftWaterLevel > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightWaterLevel < 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.leftWaterLevel - 1.5) - window.__3D_STATE__.transferredCount * 0.05) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.membraneIntact === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#addSoluteBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.soluteCount === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particlePositions)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => p.x < 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highTempMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempDisplay').textContent.includes('High')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.transferredCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.osmoticPressure)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.equilibriumLineVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.highTempMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.osmoticPressure <= 3.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startStopBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transferredCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.osmoticPressure > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftWaterLevel > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightWaterLevel < 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusDisplay').textContent.includes('Idle') || document.getElementById('statusDisplay').textContent.includes('Stop')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.transferredCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.osmoticPressure === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftWaterLevel === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightWaterLevel === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soluteCount === 40",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}