      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stirrer_active === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stirrer_active === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stir_bar_angle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stir_bar_angle)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume_added === 0",
            "tier": "L2"
          }
        ]
      }
    },
