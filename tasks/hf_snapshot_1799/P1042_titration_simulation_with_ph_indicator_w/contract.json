  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.scene_initialized === true",
        "window.__3D_STATE__.volume_added === 0",
        "window.__3D_STATE__.ph < 2",
        "window.__3D_STATE__.difficulty === 'easy'",
        "window.__3D_STATE__.stopcock_open === false",
        "window.__3D_STATE__.stirrer_active === false"
      ]
    },
    {
      "id": "S1",
      "name": "StirrerActivated",
      "conditions": [
        "window.__3D_STATE__.stirrer_active === true",
        "window.__3D_STATE__.stir_bar_angle !== undefined"
      ]
    },
    {
      "id": "S2",
      "name": "StopcockOpened",
      "conditions": [
        "window.__3D_STATE__.stopcock_open === true"
      ]
    },
    {
      "id": "S3",
      "name": "TitrantDispensed",
      "conditions": [
        "window.__3D_STATE__.volume_added > 0",
        "window.__3D_STATE__.drops_dispensed > 0"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyChanged",
      "conditions": [
        "window.__3D_STATE__.difficulty === 'medium'",
        "window.__3D_STATE__.drop_size === 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "ManualDropAdded",
      "conditions": [
        "window.__3D_STATE__.volume_added > 0",
        "window.__3D_STATE__.stopcock_open === false"
      ]
    },
    {
      "id": "S6",
      "name": "NearEquivalence",
      "conditions": [
        "window.__3D_STATE__.volume_added >= 23.0",
        "window.__3D_STATE__.ph > 1.5"
      ]
    },
    {
      "id": "S7",
      "name": "AtEquivalence",
      "conditions": [
        "window.__3D_STATE__.equivalence_reached === true",
        "Math.abs(window.__3D_STATE__.ph - 7.0) < 1.5"
      ]
    },
    {
      "id": "S8",
      "name": "PastEquivalence",
      "conditions": [
        "window.__3D_STATE__.is_past_equivalence === true",
        "window.__3D_STATE__.ph > 7.0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.volume_added === 0",
        "window.__3D_STATE__.drops_dispensed === 0",
        "window.__3D_STATE__.ph < 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
