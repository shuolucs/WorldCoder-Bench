{
  "task_id": "P300_procedural_social_network_clusters",
  "affordances": [
    {
      "id": "A1",
      "name": "HubModel",
      "type": "3d_object",
      "semantic": "Central hub node loaded from PrimaryIonDrive.glb at origin",
      "locator_hints": [
        "GLB model at (0,0,0)",
        "scaled to (2,2,2)"
      ]
    },
    {
      "id": "A2",
      "name": "ClusterCenterNodes",
      "type": "3d_object",
      "semantic": "4 cluster center spheres at cardinal positions",
      "locator_hints": [
        "radius 1.2 spheres",
        "positions (±15,0,0) and (0,0,±15)"
      ]
    },
    {
      "id": "A3",
      "name": "PeripheralNodes",
      "type": "3d_object",
      "semantic": "24 peripheral node spheres arranged around cluster centers",
      "locator_hints": [
        "radius 0.5 spheres",
        "6 per cluster in circular arrangement"
      ]
    },
    {
      "id": "A4",
      "name": "Edges",
      "type": "3d_object",
      "semantic": "Line segments connecting nodes",
      "locator_hints": [
        "28 total edges",
        "white lines to hub, colored lines to cluster centers"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing stats",
      "locator_hints": [
        "id='hud'",
        "top-left corner"
      ]
    },
    {
      "id": "A6",
      "name": "AddNodeButton",
      "type": "dom_element",
      "semantic": "Button to add a node to selected cluster",
      "locator_hints": [
        "id='btn-add-node'"
      ]
    },
    {
      "id": "A7",
      "name": "RemoveNodeButton",
      "type": "dom_element",
      "semantic": "Button to remove a node from selected cluster",
      "locator_hints": [
        "id='btn-remove-node'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalNodes === 29",
        "window.__3D_STATE__.totalEdges === 28",
        "window.__3D_STATE__.selectedCluster === -1",
        "window.__3D_STATE__.forceSimActive === false",
        "window.__3D_STATE__.hudVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "HubLoaded",
      "conditions": [
        "window.__3D_STATE__.hubModelLoaded === true",
        "window.__3D_STATE__.hubPosition.x === 0",
        "window.__3D_STATE__.hubPosition.z === 0"
      ]
    },
    {
      "id": "S2",
      "name": "ClusterSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCluster >= 0",
        "window.__3D_STATE__.selectedCluster <= 3"
      ]
    },
    {
      "id": "S3",
      "name": "ForceSimOn",
      "conditions": [
        "window.__3D_STATE__.forceSimActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "NodeAdded",
      "conditions": [
        "window.__3D_STATE__.totalNodes === 30",
        "window.__3D_STATE__.totalEdges === 29"
      ]
    },
    {
      "id": "S5",
      "name": "NodeRemoved",
      "conditions": [
        "window.__3D_STATE__.totalNodes === 29",
        "window.__3D_STATE__.totalEdges === 28"
      ]
    },
    {
      "id": "S6",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 30) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 60) < 1"
      ]
    },
    {
      "id": "S7",
      "name": "HUDHidden",
      "conditions": [
        "window.__3D_STATE__.hudVisible === false"
      ]
    }
  ],
  "transitions": [
