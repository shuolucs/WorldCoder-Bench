{
  "task_id": "P79_geology_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "GeologyLayers",
      "type": "3d_object",
      "semantic": "五层地质体",
      "locator_hints": [
        "mesh",
        "layer",
        "extrude"
      ]
    },
    {
      "id": "A2",
      "name": "CutSlider",
      "type": "dom_element",
      "semantic": "剖切位置滑块",
      "locator_hints": [
        "cutPosition"
      ]
    },
    {
      "id": "A3",
      "name": "LayerInfo",
      "type": "dom_element",
      "semantic": "选中层信息",
      "locator_hints": [
        "layerInfo"
      ]
    },
    {
      "id": "A4",
      "name": "LayerVis0",
      "type": "dom_element",
      "semantic": "第0层可见性",
      "locator_hints": [
        "layerVis0"
      ]
    },
    {
      "id": "A5",
      "name": "LayerVis1",
      "type": "dom_element",
      "semantic": "第1层可见性",
      "locator_hints": [
        "layerVis1"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "五层全可见，默认剖切"
    },
    {
      "id": "S1",
      "name": "cut_moved",
      "description": "剖切位置改变"
    },
    {
      "id": "S2",
      "name": "layer_hidden",
      "description": "某层隐藏"
    },
    {
      "id": "S3",
      "name": "layer_shown",
      "description": "可见性数组仍长度5"
    },
    {
      "id": "S4",
      "name": "cut_extreme",
      "description": "剖切极端位置"
    },
    {
      "id": "S5",
      "name": "layers_meta",
      "description": "layers 元数据完整"
    },
    {
      "id": "S6",
      "name": "selected_optional",
      "description": "selectedLayer 可为 null"
    },
    {
      "id": "S7",
      "name": "stable",
      "description": "稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "layerCount===5"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layerVisibility) && window.__3D_STATE__.layerVisibility.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layers) && window.__3D_STATE__.layers.length === 5",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cutPosition === 'number' && isFinite(window.__3D_STATE__.cutPosition)",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.layerCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerVisibility.every(v => typeof v === 'boolean')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_input",
        "selector": "#cutPosition",
        "value": "0.75"
      },
      "postconditions": [
        "cutPosition 更新"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.cutPosition - 0.75) < 0.15 || window.__3D_STATE__.cutPosition > before.cutPosition",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cutPosition !== before.cutPosition",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cutPosition)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_click",
        "selector": "#layerVis0"
      },
      "postconditions": [
        "第0层可切换隐藏"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerVisibility.length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerVisibility.every(v => typeof v === 'boolean')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_click",
        "selector": "#layerVis1"
      },
      "postconditions": [
        "可见性数组有效"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerVisibility.every(v => typeof v === 'boolean')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every(l => typeof l.visible === 'boolean')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_input",
        "selector": "#cutPosition",
        "value": "0.1"
      },
      "postconditions": [
        "剖切位置变化"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.cutPosition)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cutPosition !== before.cutPosition",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "每层有 name/thickness"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers.every(l => typeof l.name === 'string' && l.name.length > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every(l => typeof l.thickness === 'number' && isFinite(l.thickness))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "selectedLayer 类型正确"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLayer === null || typeof window.__3D_STATE__.selectedLayer === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cutPosition)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60s layerCount 恒为 5"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.length === 5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cutPosition)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layerVisibility.every(v => typeof v === 'boolean')",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.layerCount)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}