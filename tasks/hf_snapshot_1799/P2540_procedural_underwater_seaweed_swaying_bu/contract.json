  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.strandCount === 5",
        "window.__3D_STATE__.currentStrength === 1.0",
        "window.__3D_STATE__.currentFrequency === 0.8",
        "window.__3D_STATE__.burstActive === false",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simTime > 0.5",
        "window.__3D_STATE__.nodesAreFinite === true"
      ]
    },
    {
      "id": "S2",
      "name": "CurrentStrengthChanged",
      "conditions": [
        "window.__3D_STATE__.currentStrength === 2.5"
      ]
    },
    {
      "id": "S3",
      "name": "CurrentFrequencyChanged",
      "conditions": [
        "window.__3D_STATE__.currentFrequency === 2.0"
      ]
    },
    {
      "id": "S4",
      "name": "BurstApplied",
      "conditions": [
        "window.__3D_STATE__.maxTipDisplacementX > 0.3"
      ]
    },
    {
      "id": "S5",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "ClickPushApplied",
      "conditions": [
        "window.__3D_STATE__.clickPushCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "StableSway",
      "conditions": [
        "window.__3D_STATE__.nodesAreFinite === true",
        "window.__3D_STATE__.simTime > 3.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.strandCount === 5",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.segmentsPerStrand === 8",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.strandTips) && window.__3D_STATE__.strandTips.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodesAreFinite === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.avgTipY > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandTips.every(t => t.y > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandBases.every(b => Math.abs(b.y) < 0.1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dragCoefficient === 0.04",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 50 && window.__3D_STATE__.particleCount <= 120",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider){const nativeInputValueSetter=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; nativeInputValueSetter.call(slider,'2.5'); slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentStrength === 2.5 || Math.abs(window.__3D_STATE__.currentStrength - 2.5) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentStrength > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodesAreFinite === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandCount === 5",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); const freqSlider = sliders.length > 1 ? sliders[1] : sliders[0]; if(freqSlider){const nativeInputValueSetter=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; nativeInputValueSetter.call(freqSlider,'2.0'); freqSlider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.currentFrequency - 2.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentFrequency === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentFrequency > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodesAreFinite === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
