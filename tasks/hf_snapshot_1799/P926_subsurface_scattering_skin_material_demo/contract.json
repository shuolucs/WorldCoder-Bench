{
  "task_id": "P926_subsurface_scattering_skin_material_demo",
  "affordances": [
    {
      "id": "A1",
      "name": "MainSphere",
      "type": "3d_object",
      "semantic": "Primary sphere representing skin surface with SSS shader material",
      "locator_hints": [
        "radius 1.0 sphere at origin"
      ]
    },
    {
      "id": "A2",
      "name": "SwatchSphere",
      "type": "3d_object",
      "semantic": "Smaller comparison sphere showing same SSS material",
      "locator_hints": [
        "radius 0.3 sphere at (2,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "OrbitingPointLight",
      "type": "3d_object",
      "semantic": "Point light orbiting the main sphere for SSS demonstration",
      "locator_hints": [
        "point light orbiting in XZ plane"
      ]
    },
    {
      "id": "A4",
      "name": "SSSIntensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling SSS intensity uniform",
      "locator_hints": [
        "#slider-sss-intensity"
      ]
    },
    {
      "id": "A5",
      "name": "SSSWidthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling SSS width uniform",
      "locator_hints": [
        "#slider-sss-width"
      ]
    },
    {
      "id": "A6",
      "name": "SpecularSlider",
      "type": "dom_element",
      "semantic": "Slider controlling specular intensity",
      "locator_hints": [
        "#slider-specular"
      ]
    },
    {
      "id": "A7",
      "name": "ShininessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling shininess",
      "locator_hints": [
        "#slider-shininess"
      ]
    },
    {
      "id": "A8",
      "name": "FresnelSlider",
      "type": "dom_element",
      "semantic": "Slider controlling fresnel strength",
      "locator_hints": [
        "#slider-fresnel"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all material parameters to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "ToggleLightButton",
      "type": "dom_element",
      "semantic": "Button to toggle point light on/off",
      "locator_hints": [
        "#btn-toggle-light"
      ]
    },
    {
      "id": "A11",
      "name": "SkinToneButton",
      "type": "dom_element",
      "semantic": "Button to cycle through skin tone presets",
      "locator_hints": [
        "#btn-skin-tone"
      ]
    },
    {
      "id": "A12",
      "name": "WireframeButton",
      "type": "dom_element",
      "semantic": "Button to toggle wireframe rendering",
      "locator_hints": [
        "#btn-wireframe"
      ]
    },
    {
      "id": "A13",
      "name": "RoughnessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling roughness parameter",
      "locator_hints": [
        "#slider-roughness"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sssIntensity === 0.8",
        "window.__3D_STATE__.skinToneIndex === 0",
        "window.__3D_STATE__.pointLightEnabled === true",
        "window.__3D_STATE__.wireframeEnabled === false",
        "window.__3D_STATE__.mainSphereExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "SSSDisabledViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.sssIntensity === 0"
      ]
    },
    {
      "id": "S2",
      "name": "SSSMaxViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.sssIntensity === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "PointLightToggled",
      "conditions": [
        "window.__3D_STATE__.pointLightEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "SkinToneCycled",
      "conditions": [
        "window.__3D_STATE__.skinToneIndex === 1"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeEnabled",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "SlidersAdjusted",
      "conditions": [
        "window.__3D_STATE__.sssWidth !== 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "SpecularAdjusted",
      "conditions": [
        "window.__3D_STATE__.specularIntensity !== 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.sssIntensity === 0.8",
        "window.__3D_STATE__.sssWidth === 0.5",
        "window.__3D_STATE__.skinToneIndex === 0",
        "window.__3D_STATE__.wireframeEnabled === false"
      ]
    },
    {
      "id": "S9",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.frameCount > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mainSphereExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.swatchSphereExists === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sssIntensity === 'number' && !isNaN(window.__3D_STATE__.sssIntensity)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sssIntensity === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sssIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sssWidth === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointLightEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sssIntensity === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sssIntensity > 1.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sssColor === 'object' && window.__3D_STATE__.sssColor.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sssColor[0]) && !isNaN(window.__3D_STATE__.sssColor[1]) && !isNaN(window.__3D_STATE__.sssColor[2])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pointLightEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pointLightPosition === 'object' && window.__3D_STATE__.pointLightPosition.length === 3",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pointLightPosition[0]) && !isNaN(window.__3D_STATE__.pointLightPosition[1]) && !isNaN(window.__3D_STATE__.pointLightPosition[2])",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.pointLightPosition[0]**2 + window.__3D_STATE__.pointLightPosition[2]**2) - 2.0) < 0.3 || !window.__3D_STATE__.pointLightEnabled",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sssIntensity === 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-skin-tone"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.skinToneIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.baseColor) && window.__3D_STATE__.baseColor.length === 3",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[0] - 0.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[1] - 0.45) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.baseColor[2] - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skinToneIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mainSphereExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.swatchSphereExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#slider-sss-width').value = 1.5; document.querySelector('#slider-sss-width').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.sssWidth - 1.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sssWidth >= 0.01 && window.__3D_STATE__.sssWidth <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sssWidth === 'number' && !isNaN(window.__3D_STATE__.sssWidth)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#slider-specular').value = 1.8; document.querySelector('#slider-specular').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.specularIntensity - 1.8) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.specularIntensity >= 0 && window.__3D_STATE__.specularIntensity <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sssWidth - 1.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shininess === 'number' && window.__3D_STATE__.shininess >= 1 && window.__3D_STATE__.shininess <= 256",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sssIntensity === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sssWidth === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.specularIntensity === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shininess === 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fresnelStrength === 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roughness === 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointLightEnabled === false || (Math.sqrt(window.__3D_STATE__.pointLightPosition[0]**2 + window.__3D_STATE__.pointLightPosition[2]**2) > 1.5 && Math.sqrt(window.__3D_STATE__.pointLightPosition[0]**2 + window.__3D_STATE__.pointLightPosition[2]**2) < 2.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 2.0 && window.__3D_STATE__.cameraDistance < 10.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skinToneIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}