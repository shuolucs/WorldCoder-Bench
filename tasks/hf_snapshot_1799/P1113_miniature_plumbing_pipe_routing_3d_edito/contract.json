      "action": {
        "type": "script",
        "code": "// Place a faucet fixture on a node that has a cold water pipe\nconst coldNode = window.__3D_STATE__.pipeSegments.find(s => s.pipeType === 'cold');\nif (coldNode && typeof window.__TEST_placeFixture === 'function') { window.__TEST_placeFixture(coldNode.startNode, 'faucet'); } else { const e = new MouseEvent('click', {clientX: 400, clientY: 300}); document.querySelector('canvas').dispatchEvent(e); }"
