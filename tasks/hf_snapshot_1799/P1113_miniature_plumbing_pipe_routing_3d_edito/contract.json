      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Right-click the last pipe segment to delete it\nconst lastPipe = window.__3D_STATE__.pipeSegments[window.__3D_STATE__.pipeSegments.length - 1];\nconst countBefore = window.__3D_STATE__.totalPipeCount;\nconst lengthBefore = window.__3D_STATE__.totalPipeLength;\nwindow.__TEST_BEFORE_DELETE = {count: countBefore, length: lengthBefore};\nif (typeof window.__TEST_deletePipe === 'function') { window.__TEST_deletePipe(lastPipe.id); } else { const e = new MouseEvent('contextmenu', {clientX: 480, clientY: 300}); document.querySelector('canvas').dispatchEvent(e); }"
      },
