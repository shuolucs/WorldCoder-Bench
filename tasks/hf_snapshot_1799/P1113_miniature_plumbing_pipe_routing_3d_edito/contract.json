      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Place two more connected pipes to form an L-shape, creating a joint\nif (typeof window.__TEST_placePipe === 'function') { window.__TEST_placePipe({x:1,y:0.3,z:0}, {x:2,y:0.3,z:0}); setTimeout(() => window.__TEST_placePipe({x:2,y:0.3,z:0}, {x:2,y:0.3,z:1}), 100); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalPipeCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalJointCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.joints.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.joints.some(j => j.connectionCount === 2 && j.jointType === 'elbow')",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalPipeLength - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeSegments.every(s => !isNaN(s.length) && s.length > 0)",
            "tier": "L2"
          }
        ]
      }
    },
