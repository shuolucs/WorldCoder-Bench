      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Place a pipe by simulating two node clicks: node (0,0) then node (1,0)\nconst state = window.__3D_STATE__;\nif (typeof window.__TEST_placePipe === 'function') { window.__TEST_placePipe({x:0,y:0.3,z:0}, {x:1,y:0.3,z:0}); } else { const e1 = new MouseEvent('click', {clientX: 400, clientY: 300}); document.querySelector('canvas').dispatchEvent(e1); setTimeout(() => { const e2 = new MouseEvent('click', {clientX: 440, clientY: 300}); document.querySelector('canvas').dispatchEvent(e2); }, 200); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.pipeSegments !== 'undefined' && Array.isArray(window.__3D_STATE__.pipeSegments)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPipeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeSegments.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeSegments[0].pipeType === 'cold'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pipeSegments[0].length - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'place_pipe'",
            "tier": "L2"
          }
        ]
      }
    },
    {
