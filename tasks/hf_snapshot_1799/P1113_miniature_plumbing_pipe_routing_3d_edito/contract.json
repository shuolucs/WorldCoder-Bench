        "type": "script",
        "code": "// Stop flow sim, undo all actions to return to empty state\nif (window.__3D_STATE__.flowSimActive) { window.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); }\nsetTimeout(() => { window.dispatchEvent(new KeyboardEvent('keydown', {key: 'l'})); setTimeout(() => { window.dispatchEvent(new KeyboardEvent('keydown', {key: 'l'})); }, 100); }, 100);\nsetTimeout(() => { const undoCount = window.__3D_STATE__.undoStackSize; for (let i = 0; i < undoCount + 5; i++) { window.dispatchEvent(new KeyboardEvent('keydown', {key: 'u'})); } window.dispatchEvent(new KeyboardEvent('keydown', {key: '1'})); }, 400);"
