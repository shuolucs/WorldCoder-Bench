        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframe === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-wireframe') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-wireframe').textContent.toLowerCase().includes('true') || document.getElementById('hud-wireframe').textContent.toLowerCase().includes('on')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTriangles > 0 && !isNaN(window.__3D_STATE__.totalTriangles)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 'medium'",
            "tier": "L2"
          }
        ]
      }
    },
    {
