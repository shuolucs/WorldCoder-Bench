  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.chunks) && window.__3D_STATE__.chunks.length === 16",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 'medium' && window.__3D_STATE__.heightMultiplier === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTriangles === window.__3D_STATE__.chunks.reduce((s,c) => s + c.triangleCount, 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chunks.every(c => c.triangleCount === 2 * c.segments * c.segments)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.totalTriangles)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
