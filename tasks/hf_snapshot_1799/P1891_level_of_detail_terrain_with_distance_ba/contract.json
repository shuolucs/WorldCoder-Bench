            "expr": "window.__3D_STATE__.difficulty === 'hard'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightMultiplier === 1.5",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.lodDistances) === JSON.stringify([40, 80, 140])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.geometryRebuilds >= 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chunks.every(c => [0,1,2,3].includes(c.lodLevel))",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-difficulty').textContent.toLowerCase().includes('hard')",
            "tier": "L2"
          }
