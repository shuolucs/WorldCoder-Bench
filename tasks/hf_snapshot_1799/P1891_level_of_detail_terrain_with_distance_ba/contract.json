            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chunks.every((c, i) => c.lodLevel === window.__frozenLodSnapshot[i])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chunks.length === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalTriangles === window.__3D_STATE__.chunks.reduce((s,c) => s + c.triangleCount, 0)",
            "tier": "L2"
          }
        ]
      }
    },
