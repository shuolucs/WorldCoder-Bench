        "#status-text"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.clawState === 'idle'",
        "window.__3D_STATE__.clawY === 3",
        "window.__3D_STATE__.prizesRemaining === 6",
        "window.__3D_STATE__.prizesCollected === 0",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Claw_Moved",
      "conditions": [
        "window.__3D_STATE__.clawState === 'idle'",
        "window.__3D_STATE__.clawX !== 0 || window.__3D_STATE__.clawZ !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "Claw_Descending",
      "conditions": [
        "window.__3D_STATE__.clawState === 'descending'",
        "window.__3D_STATE__.clawY < 3"
      ]
    },
    {
      "id": "S3",
      "name": "Claw_At_Bottom",
      "conditions": [
        "window.__3D_STATE__.clawState === 'closing'",
        "window.__3D_STATE__.clawY <= -3"
      ]
    },
    {
      "id": "S4",
      "name": "Claw_Ascending_With_Prize",
      "conditions": [
        "window.__3D_STATE__.clawState === 'ascending'",
        "window.__3D_STATE__.heldPrize !== null",
        "window.__3D_STATE__.clawOpen === false"
      ]
    },
    {
      "id": "S5",
      "name": "Claw_Ascending_Empty",
      "conditions": [
        "window.__3D_STATE__.clawState === 'ascending'",
        "window.__3D_STATE__.heldPrize === null"
      ]
    },
    {
      "id": "S6",
      "name": "Prize_Delivered",
      "conditions": [
        "window.__3D_STATE__.prizesCollected >= 1",
        "window.__3D_STATE__.score >= 10"
      ]
    },
    {
      "id": "S7",
      "name": "Drop_Count_Incremented",
      "conditions": [
        "window.__3D_STATE__.dropCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "Camera_Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.cameraModelLoaded === true"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.clawState === 'idle'",
        "window.__3D_STATE__.prizesRemaining === 6",
        "window.__3D_STATE__.prizesCollected === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.dropCount === 0"
      ]
    }
  ],
