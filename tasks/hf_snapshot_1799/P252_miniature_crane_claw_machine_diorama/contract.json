    {
      "id": "A1",
      "name": "ClawAssembly",
      "type": "3d_object",
      "semantic": "The crane claw that moves along rails and descends to grab prizes",
      "locator_hints": [
        "claw group at top of machine",
        "vertical arm with 3 fingers"
      ]
    },
    {
      "id": "A2",
      "name": "AntiqueCamera",
      "type": "3d_object",
      "semantic": "The rare prize loaded from AntiqueCamera.glb",
      "locator_hints": [
        "GLB model on machine floor",
        "position near (1, -3.5, 1)"
      ]
    },
    {
      "id": "A3",
      "name": "PrizeSpheres",
      "type": "3d_object",
