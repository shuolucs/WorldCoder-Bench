{
  "task_id": "P552_binary_star_system",
  "affordances": [
    {"id": "A1", "name": "StarA", "type": "3d_object", "semantic": "Orange giant star with corona and light", "locator_hints": ["emissive sphere orange"]},
    {"id": "A2", "name": "StarB", "type": "3d_object", "semantic": "Blue dwarf star with corona and light", "locator_hints": ["emissive sphere blue"]},
    {"id": "A3", "name": "OrbitalTrails", "type": "3d_object", "semantic": "Fading position trail lines", "locator_hints": ["line geometries"]},
    {"id": "A4", "name": "MassASlider", "type": "dom_element", "semantic": "Star A mass control", "locator_hints": ["#slider-mass-a"]},
    {"id": "A5", "name": "MassBSlider", "type": "dom_element", "semantic": "Star B mass control", "locator_hints": ["#slider-mass-b"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false", "window.__3D_STATE__.separation > 10"]},
    {"id": "S1", "name": "Orbiting", "conditions": ["window.__3D_STATE__.frameCount > 60"]},
    {"id": "S2", "name": "EnergyConserved", "conditions": ["window.__3D_STATE__.energyDrift < 1.0"]},
    {"id": "S3", "name": "MassChanged", "conditions": ["window.__3D_STATE__.massA !== 100"]},
    {"id": "S4", "name": "PlanetOn", "conditions": ["window.__3D_STATE__.planetEnabled === true"]},
    {"id": "S5", "name": "Reset", "conditions": ["window.__3D_STATE__.orbitCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.separation > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.totalEnergy !== 0", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.energyDrift < 5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.separation > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-mass-a').value = 150; document.getElementById('slider-mass-a').dispatchEvent(new Event('input')); document.dispatchEvent(new KeyboardEvent('keydown',{key:'r'})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.massA >= 140", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "p"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.planetEnabled === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-planet').textContent.includes('ON')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S4", "to": "S5", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.separation > 5", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S5", "to": "S5", "severity": "P1",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.trailsEnabled !== before.trailsEnabled", "tier": "L2"}
      ]}
    }
  ]
}
