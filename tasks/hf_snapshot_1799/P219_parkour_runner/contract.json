{
  "task_id": "P219_parkour_runner",
  "affordances": [
    {
      "id": "A1",
      "name": "MichelleModel",
      "type": "3d_object",
      "semantic": "The parkour runner character loaded from Michelle.glb",
      "locator_hints": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "A2",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the game",
      "locator_hints": [
        "#btn-start"
      ]
    },
    {
      "id": "A3",
      "name": "RestartButton",
      "type": "dom_element",
      "semantic": "Button to restart after game over",
      "locator_hints": [
        "#btn-restart"
      ]
    },
    {
      "id": "A4",
      "name": "ScoreHUD",
      "type": "dom_element",
      "semantic": "Score display in top-left",
      "locator_hints": [
        "#hud-score"
      ]
    },
    {
      "id": "A5",
      "name": "DistanceHUD",
      "type": "dom_element",
      "semantic": "Distance display in top-right",
      "locator_hints": [
        "#hud-distance"
      ]
    },
    {
      "id": "A6",
      "name": "GameOverOverlay",
      "type": "dom_element",
      "semantic": "Game over screen overlay",
      "locator_hints": [
        "#game-over-overlay"
      ]
    },
    {
      "id": "A7",
      "name": "Obstacles",
      "type": "3d_object",
      "semantic": "Barriers and beams the player must avoid",
      "locator_hints": [
        "window.__3D_STATE__.obstacleCount >= 20"
      ]
    },
    {
      "id": "A8",
      "name": "Coins",
      "type": "3d_object",
      "semantic": "Collectible yellow torus coins",
      "locator_hints": [
        "window.__3D_STATE__.coinCount === 30"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Paused",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "PlayerMovedLeft",
      "conditions": [
        "window.__3D_STATE__.currentLane === -3",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S3",
      "name": "PlayerMovedRight",
      "conditions": [
        "window.__3D_STATE__.currentLane === 3",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S4",
      "name": "PlayerJumping",
      "conditions": [
        "window.__3D_STATE__.isJumping === true",
        "window.__3D_STATE__.playerY > 0.1"
      ]
    },
    {
      "id": "S5",
      "name": "PlayerLanded",
      "conditions": [
        "window.__3D_STATE__.isJumping === false",
        "window.__3D_STATE__.playerY <= 0.05"
      ]
    },
    {
      "id": "S6",
      "name": "PlayerSliding",
      "conditions": [
        "window.__3D_STATE__.isSliding === true"
      ]
    },
    {
      "id": "S7",
      "name": "PlayerAdvanced",
      "conditions": [
        "window.__3D_STATE__.distance > 50",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S8",
      "name": "CoinCollected",
      "conditions": [
        "window.__3D_STATE__.coinsCollected > 0",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S10",
      "name": "GameRestarted",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.distance < 5",
        "window.__3D_STATE__.score === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gameStarted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gameOver === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerX === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentLane === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentLane === -3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playerX - (-3)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gameOver === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playerX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "repeat": 2
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentLane === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.playerX - 3) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gameOver === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerY >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isJumping === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityY > 0 || window.__3D_STATE__.playerY > 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.velocityY)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playerY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1200
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isJumping === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerY <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerY >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityY) < 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playerY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isSliding === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gameOver === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isJumping === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isSliding === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distance > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speed === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 100",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.distance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "// Move player to nearest coin lane and wait for collection\nconst state = window.__3D_STATE__;\n// Force a lane that likely has coins by cycling through lanes\ndocument.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowLeft'}));\ndocument.dispatchEvent(new KeyboardEvent('keyup', {key: 'ArrowLeft'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.coinsCollected >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === window.__3D_STATE__.coinsCollected",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.score)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Trigger game over by teleporting player into an obstacle\nwindow.__3D_STATE__._forceGameOver && window.__3D_STATE__._forceGameOver(); // if exposed\n// Otherwise wait for natural collision or set directly for testing\nif (!window.__3D_STATE__.gameOver) { /* Let natural gameplay proceed */ }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gameOver === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('game-over-overlay').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCollisionType === 'barrier' || window.__3D_STATE__.lastCollisionType === 'beam'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-restart"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gameStarted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gameOver === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coinsCollected === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distance < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentLane === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}