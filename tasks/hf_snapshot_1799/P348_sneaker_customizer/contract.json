{
  "task_id": "P348_sneaker_customizer",
  "affordances": [
    {
      "id": "A1",
      "name": "SneakerGroup",
      "type": "3d_object",
      "semantic": "The sneaker model composed of primitive parts that auto-rotates",
      "locator_hints": [
        "sneaker group at origin"
      ]
    },
    {
      "id": "A2",
      "name": "StorkMascot",
      "type": "3d_object",
      "semantic": "The loaded stork.glb mascot that bobs up and down",
      "locator_hints": [
        "stork.glb model at (2, ~0, -1)"
      ]
    },
    {
      "id": "A3",
      "name": "PartSelector",
      "type": "dom_element",
      "semantic": "Dropdown to choose which sneaker part to customize",
      "locator_hints": [
        "#partSelector"
      ]
    },
    {
      "id": "A4",
      "name": "ColorSwatches",
      "type": "dom_element",
      "semantic": "Five circular color buttons for applying colors",
      "locator_hints": [
        "#color0 through #color4"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all colors to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleRotationButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume sneaker rotation",
      "locator_hints": [
        "#toggleRotation"
      ]
    },
    {
      "id": "A7",
      "name": "ChangesCounter",
      "type": "dom_element",
      "semantic": "Display of total color changes made",
      "locator_hints": [
        "#changesCount"
      ]
    },
    {
      "id": "A8",
      "name": "CurrentColorDisplay",
      "type": "dom_element",
      "semantic": "Shows hex color of selected part",
      "locator_hints": [
        "#currentColor"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'sole'",
        "window.__3D_STATE__.isRotating === true",
        "window.__3D_STATE__.changesCount === 0",
        "window.__3D_STATE__.partColors.sole === '#222222'"
      ]
    },
    {
      "id": "S1",
      "name": "StorkLoaded",
      "conditions": [
        "window.__3D_STATE__.storkLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "PartChanged",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'upper'"
      ]
    },
    {
      "id": "S3",
      "name": "ColorAppliedToUpper",
      "conditions": [
        "window.__3D_STATE__.partColors.upper === '#3498db'",
        "window.__3D_STATE__.changesCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "SecondColorChange",
      "conditions": [
        "window.__3D_STATE__.partColors.swoosh === '#2ecc71'",
        "window.__3D_STATE__.changesCount >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.isRotating === false"
      ]
    },
    {
      "id": "S6",
      "name": "RotationResumed",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ]
    },
    {
      "id": "S7",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.partColors.upper === '#ffffff'",
        "window.__3D_STATE__.partColors.swoosh === '#ff4444'",
        "window.__3D_STATE__.changesCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPart !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.partColors !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isRotating !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rotationAngle !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.changesCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isRotating === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.changesCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('partSelector').value = 'upper'; document.getElementById('partSelector').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationAngle !== before.rotationAngle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number' && !isNaN(window.__3D_STATE__.rotationAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.changesCount === 'number' && !isNaN(window.__3D_STATE__.changesCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isRotating === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.changesCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
