            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "var frozenAngle = window.__3D_STATE__.rotationAngle; window.__testFrozen = frozenAngle; setTimeout(() => { window.__testAngleUnchanged = Math.abs(window.__3D_STATE__.rotationAngle - window.__testFrozen) < 0.01; document.getElementById('toggleRotation').click(); }, 500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationAngle !== before.rotationAngle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
