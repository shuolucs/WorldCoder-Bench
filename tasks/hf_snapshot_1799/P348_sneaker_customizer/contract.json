      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('partSelector').value = 'swoosh'; document.getElementById('partSelector').dispatchEvent(new Event('change')); setTimeout(() => document.getElementById('color4').click(), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationAngle !== before.rotationAngle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number' && !isNaN(window.__3D_STATE__.rotationAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.changesCount === 'number' && !isNaN(window.__3D_STATE__.changesCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isRotating === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.changesCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
