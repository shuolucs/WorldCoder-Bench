      "locator_hints": [
        "#timeDisplay"
      ]
    },
    {
      "id": "A5",
      "name": "PausedDisplay",
      "type": "dom_element",
      "semantic": "Shows paused state",
      "locator_hints": [
        "#pausedDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "GlitchButton",
      "type": "dom_element",
      "semantic": "Button to toggle glitch effect",
      "locator_hints": [
        "#glitchBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ColorButton",
      "type": "dom_element",
      "semantic": "Button to cycle hologram color",
      "locator_hints": [
        "#colorBtn"
      ]
    },
    {
      "id": "A8",
      "name": "GlitchDisplay",
      "type": "dom_element",
      "semantic": "Shows current glitch intensity",
      "locator_hints": [
        "#glitchDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.scanlineSpeed === 1.0",
        "window.__3D_STATE__.glitchIntensity === 0.0",
        "window.__3D_STATE__.colorIndex === 0",
        "window.__3D_STATE__.meshExists === true"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.scanlineSpeed > 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.scanlineSpeed < 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "GlitchActive",
      "conditions": [
        "window.__3D_STATE__.glitchIntensity === 0.3"
      ]
    },
    {
      "id": "S5",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorIndex > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.shaderTime === 0",
        "window.__3D_STATE__.scanlineSpeed === 1.0",
        "window.__3D_STATE__.glitchIntensity === 0.0",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderTime === 'number' && !isNaN(window.__3D_STATE__.shaderTime) && isFinite(window.__3D_STATE__.shaderTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineCount === 40.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.opacity === 0.7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('pausedDisplay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('pausedDisplay').textContent.toLowerCase().includes('true')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T3_frozenTime = window.__3D_STATE__.shaderTime; window.__T3_frozenRot = window.__3D_STATE__.rotationY;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shaderTime - window.__T3_frozenTime) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rotationY - window.__T3_frozenRot) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationY === 'number' && !isNaN(window.__3D_STATE__.rotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.scanlineSpeed === 1.25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedDisplay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('speedDisplay').textContent.includes('1.25')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineSpeed >= 0.0 && window.__3D_STATE__.scanlineSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#glitchBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.glitchIntensity === 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.glitchIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('glitchDisplay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('glitchDisplay').textContent.includes('0.3') || document.getElementById('glitchDisplay').textContent.includes('0.30')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#colorBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentColor === 'object' && window.__3D_STATE__.currentColor !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentColor.r - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentColor.g - 0.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentColor.b - 0.8) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shaderTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineSpeed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glitchIntensity === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedDisplay').textContent.includes('1.00') || document.getElementById('speedDisplay').textContent.includes('1.0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.scanlineSpeed === 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineSpeed >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedDisplay').textContent.includes('0.75')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shaderTime === 'number' && !isNaN(window.__3D_STATE__.shaderTime) && isFinite(window.__3D_STATE__.shaderTime)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}