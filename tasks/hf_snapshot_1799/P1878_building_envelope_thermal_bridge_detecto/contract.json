      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'risk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visualizationMode !== 'thermal'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modeColorMap === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.panels.filter(function(p){ return p.uValue >= 2.5; }).length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panels.filter(function(p){ return p.uValue < 0.5; }).length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('tempSlider'); if(slider){ var nativeSet = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSet.call(slider, '10'); slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.outdoorTemp === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaT === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.indoorTemp === 20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalHeatLoss === 'number' && !isNaN(window.__3D_STATE__.totalHeatLoss) && window.__3D_STATE__.totalHeatLoss > 0",
