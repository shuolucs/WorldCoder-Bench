      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.detectionActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'normal'",
            "tier": "L2"
