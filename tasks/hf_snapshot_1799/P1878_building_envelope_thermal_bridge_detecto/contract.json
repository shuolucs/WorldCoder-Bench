      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var prevLoss = window.__3D_STATE__.totalHeatLoss; window.__prevTotalHeatLoss = prevLoss; var slider = document.getElementById('tempSlider'); if(slider){ var nativeSet = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSet.call(slider, '-20'); slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.outdoorTemp === -20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.deltaT === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalHeatLoss > window.__prevTotalHeatLoss",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalHeatLoss / window.__prevTotalHeatLoss - 4.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.heatLossByFloor) && window.__3D_STATE__.heatLossByFloor.length === 3 && window.__3D_STATE__.heatLossByFloor.every(function(v){ return typeof v === 'number' && !isNaN(v) && v > 0; })",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
