  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalPanelCount === 'number' && window.__3D_STATE__.totalPanelCount > 0",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.panels) && window.__3D_STATE__.panels.length === window.__3D_STATE__.totalPanelCount",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalHeatLoss === 'number' && !isNaN(window.__3D_STATE__.totalHeatLoss) && window.__3D_STATE__.totalHeatLoss > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.thermalBridgePercentage === 'number' && window.__3D_STATE__.thermalBridgePercentage >= 0 && window.__3D_STATE__.thermalBridgePercentage <= 100",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.flaggedPanelCount === 'number' && window.__3D_STATE__.flaggedPanelCount > 0 && window.__3D_STATE__.flaggedPanelCount < window.__3D_STATE__.totalPanelCount",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
