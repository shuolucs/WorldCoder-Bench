            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panels.every(function(p){ return p.uValue > 1.0 ? p.flagged === true : p.flagged === false; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thermalBridgePercentage > 0 && window.__3D_STATE__.thermalBridgePercentage < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
