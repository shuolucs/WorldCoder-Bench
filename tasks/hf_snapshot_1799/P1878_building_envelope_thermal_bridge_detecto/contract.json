          },
          {
            "expr": "window.__3D_STATE__.detectionActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleFloor === 'all'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outdoorTemp === -20",
            "tier": "L2"
          },
          {
