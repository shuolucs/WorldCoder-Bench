          {
            "expr": "window.__3D_STATE__.panels.filter(function(p){ return p.visible === true; }).length === window.__3D_STATE__.totalPanelCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panels.filter(function(p){ return p.floor === 1 && p.visible === true; }).length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panels.filter(function(p){ return p.floor === 2 && p.visible === true; }).length > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalHeatLoss === 'number' && !isNaN(window.__3D_STATE__.totalHeatLoss)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#normalModeBtn"
      },
      "verifier": {
