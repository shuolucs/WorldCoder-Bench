      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visualizationMode === 'thermal'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modeColorMap === 'object' && window.__3D_STATE__.modeColorMap !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalHeatLoss === (function(){ var s = window.__3D_STATE__; return s.totalHeatLoss; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.panels.every(function(p){ return typeof p.zone === 'string' && typeof p.uValue === 'number'; })",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.heatLossByZone === 'object' && typeof window.__3D_STATE__.heatLossByZone.concrete_slab === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#riskModeBtn"
