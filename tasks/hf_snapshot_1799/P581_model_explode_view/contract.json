{
  "task_id": "P581_model_explode_view",
  "affordances": [
    {
      "id": "A1",
      "name": "ProductModel",
      "type": "3d_object",
      "semantic": "AntiqueCamera GLB model composed of multiple mesh parts",
      "locator_hints": ["AntiqueCamera", "camera", "model", "gltf"]
    },
    {
      "id": "A2",
      "name": "PartLabels",
      "type": "dom_element",
      "semantic": "CSS2D floating labels showing part names on hover/select",
      "locator_hints": ["label", "part-label", "CSS2D"]
    },
    {
      "id": "A3",
      "name": "SliderExplode",
      "type": "dom_element",
      "semantic": "Slider controlling the explode distance factor",
      "locator_hints": ["slider-explode", "explode"]
    },
    {
      "id": "A4",
      "name": "SliderOpacity",
      "type": "dom_element",
      "semantic": "Slider controlling opacity of non-selected parts",
      "locator_hints": ["slider-opacity", "opacity"]
    },
    {
      "id": "A5",
      "name": "BtnExplodeFull",
      "type": "dom_element",
      "semantic": "Button that animates full explosion",
      "locator_hints": ["btn-explode-full", "explode"]
    },
    {
      "id": "A6",
      "name": "BtnAssemble",
      "type": "dom_element",
      "semantic": "Button that animates assembly back to original positions",
      "locator_hints": ["btn-assemble", "assemble"]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Head-up display showing parts count, explode distance, selected count",
      "locator_hints": ["hud", "hud-parts", "hud-explode", "hud-selected"]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_assembled",
      "conditions": ["window.__3D_STATE__ !== undefined", "window.__3D_STATE__.explodeDistance === 0"]
    },
    {
      "id": "S1",
      "name": "exploded",
      "conditions": ["window.__3D_STATE__.explodeDistance > 0.5"]
    },
    {
      "id": "S2",
      "name": "opacity_changed",
      "conditions": ["window.__3D_STATE__.opacity < 1"]
    },
    {
      "id": "S3",
      "name": "reassembled",
      "conditions": ["window.__3D_STATE__.explodeDistance < 0.05"]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": { "type": "wait", "duration_ms": 3000 },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.partCount > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.explodeValid === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-explode').value = 2.0; document.getElementById('slider-explode').dispatchEvent(new Event('input')); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.explodeDistance >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodeValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const pp = window.__3D_STATE__.partsPositions; if(!pp || pp.length === 0) return false; return pp.every(p => isFinite(p.x) && isFinite(p.y) && isFinite(p.z)); })()",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const pp = window.__3D_STATE__.partsPositions; if(!pp || pp.length < 2) return false; let maxDist = 0; for(let i=0;i<pp.length;i++) for(let j=i+1;j<pp.length;j++){ const d = Math.sqrt((pp[i].x-pp[j].x)**2+(pp[i].y-pp[j].y)**2+(pp[i].z-pp[j].z)**2); if(d>maxDist) maxDist=d; } return maxDist > 1.0; })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-opacity').value = 0.4; document.getElementById('slider-opacity').dispatchEvent(new Event('input')); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.opacity <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodeValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-assemble').click(); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.explodeDistance < before.explodeDistance",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isAnimating === true || window.__3D_STATE__.explodeDistance < 0.1",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-explode-full').click(); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.explodeDistance > before.explodeDistance || window.__3D_STATE__.isAnimating === true",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.explodeValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-reset').click(); return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.explodeDistance < 0.05 || window.__3D_STATE__.isAnimating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodeValid === true",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
