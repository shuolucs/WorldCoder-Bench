          },
          {
            "expr": "window.__3D_STATE__.gravityVector.y === 9.81",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityVector.x === 0 && window.__3D_STATE__.gravityVector.z === 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.potentialEnergy === 'number' && !isNaN(window.__3D_STATE__.potentialEnergy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sphereCount === 3",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityMode === 'zero'",
