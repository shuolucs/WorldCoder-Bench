          },
          {
            "expr": "window.__3D_STATE__.spherePositions[1].y >= 8.5 && window.__3D_STATE__.spherePositions[1].y <= 9.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions[2].y >= 12.5 && window.__3D_STATE__.spherePositions[2].y <= 13.5",
