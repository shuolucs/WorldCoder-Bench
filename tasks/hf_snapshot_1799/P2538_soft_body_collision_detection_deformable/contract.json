            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.addedCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.length === 4",
            "tier": "L2"
          },
          {
