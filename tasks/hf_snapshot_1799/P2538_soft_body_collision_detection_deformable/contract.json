      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sphereCount === 3",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions[0].y >= 4.5 && window.__3D_STATE__.spherePositions[0].y <= 5.5",
