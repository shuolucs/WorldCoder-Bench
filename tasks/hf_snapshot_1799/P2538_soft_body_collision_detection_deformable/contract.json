      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Delete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.removedCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereCount === 3",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.selectedSphereIndex === -1",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereDeformations.length === 3",
            "tier": "L2"
          }
        ]
