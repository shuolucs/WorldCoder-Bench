      "locator_hints": [
        "wireframe",
        "debug arrows",
        "contact points"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Drop",
      "conditions": [
        "window.__3D_STATE__.sphereCount === 3",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.gravityMode === 'normal'",
        "window.__3D_STATE__.debugOverlay === false",
        "window.__3D_STATE__.simulationTime >= 0"
      ]
    },
    {
      "id": "S1",
      "name": "Spheres_Settled",
      "conditions": [
        "window.__3D_STATE__.sphereCount === 3",
        "window.__3D_STATE__.spherePositions.every(p => p.y >= 0)",
        "window.__3D_STATE__.kineticEnergy < 5.0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S4",
      "name": "Debug_On",
      "conditions": [
        "window.__3D_STATE__.debugOverlay === true"
      ]
    },
    {
      "id": "S5",
      "name": "Gravity_Reversed",
      "conditions": [
        "window.__3D_STATE__.gravityMode === 'reversed'",
        "window.__3D_STATE__.gravityVector.y === 9.81"
      ]
    },
    {
      "id": "S6",
      "name": "Gravity_Zero",
      "conditions": [
        "window.__3D_STATE__.gravityMode === 'zero'",
        "window.__3D_STATE__.gravityVector.y === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Force_Applied",
      "conditions": [
        "window.__3D_STATE__.sphereVelocities.some(v => v.y > 2.0)"
      ]
    },
    {
      "id": "S8",
      "name": "Sphere_Added",
      "conditions": [
        "window.__3D_STATE__.sphereCount === 4",
        "window.__3D_STATE__.addedCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "Sphere_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedSphereIndex >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "Sphere_Removed",
      "conditions": [
        "window.__3D_STATE__.removedCount >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.spherePositions[0].y >= 4.5",
        "window.__3D_STATE__.simulationTime < 0.5",
        "window.__3D_STATE__.totalCollisions === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sphereCount === 'number' && window.__3D_STATE__.sphereCount === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => typeof p.y === 'number' && !isNaN(p.y) && p.y >= -0.01)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions[0].y < 3.0 && window.__3D_STATE__.spherePositions[0].y >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kineticEnergy < 5.0 && window.__3D_STATE__.kineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCollisions > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number' && window.__3D_STATE__.simulationTime > 0",
            "tier": "L0"
          },
          {
            "expr": "(function(){ window.__pausedTime = window.__3D_STATE__.simulationTime; return true; })()",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereDeformations.every(d => typeof d === 'number' && d >= 0 && d <= 0.41)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityMode === 'normal'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.gravityVector.x === 0 && window.__3D_STATE__.gravityVector.z === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.gravityVector.y < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereCount === 3",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlay === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeCollisions === 'number' && window.__3D_STATE__.activeCollisions >= 0",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugPanel') !== null",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('debugPanel').innerText.length > 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
