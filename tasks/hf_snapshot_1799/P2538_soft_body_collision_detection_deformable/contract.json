        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSphereIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSphereIndex === 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.spherePositions[window.__3D_STATE__.selectedSphereIndex] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sphereCount === 4",
            "tier": "L1"
          }
