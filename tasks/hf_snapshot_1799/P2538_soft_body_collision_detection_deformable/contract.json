            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereDeformations.length === 4",
            "tier": "L2"
          }
        ]
