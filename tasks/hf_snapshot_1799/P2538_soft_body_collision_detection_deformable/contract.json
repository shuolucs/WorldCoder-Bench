          },
          {
            "expr": "window.__3D_STATE__.gravityVector.y === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.gravityVector.x === 0 && window.__3D_STATE__.gravityVector.z === 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.momentum === 'object' && typeof window.__3D_STATE__.momentum.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.momentum.x) && !isNaN(window.__3D_STATE__.momentum.y) && !isNaN(window.__3D_STATE__.momentum.z)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sphereVelocities.some(v => v.y > 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kineticEnergy > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.every(v => !isNaN(v.x) && !isNaN(v.y) && !isNaN(v.z))",
            "tier": "L2"
          },
          {
