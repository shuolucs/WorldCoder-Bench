  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.heightMultiplier === 5",
        "window.__3D_STATE__.colorScheme === 'rainbow'",
        "window.__3D_STATE__.simulationActive === true",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HeightIncreased",
      "conditions": [
        "window.__3D_STATE__.heightMultiplier === 6",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S2",
      "name": "HeightIncreasedTwice",
      "conditions": [
        "window.__3D_STATE__.heightMultiplier === 7",
        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S3",
      "name": "UndoneOnce",
      "conditions": [
        "window.__3D_STATE__.heightMultiplier === 6",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S4",
      "name": "RedoneOnce",
      "conditions": [
        "window.__3D_STATE__.heightMultiplier === 7",
        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S5",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'cool'",
        "window.__3D_STATE__.undoStackSize === 3",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationActive === false",
        "window.__3D_STATE__.undoStackSize === 4"
      ]
    },
    {
      "id": "S7",
      "name": "UndoToResumeSim",
      "conditions": [
        "window.__3D_STATE__.simulationActive === true",
        "window.__3D_STATE__.undoStackSize === 3",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    }
  ],
