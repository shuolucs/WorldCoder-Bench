{
  "task_id": "P536_ct_slice_viewer",
  "affordances": [
    {"id": "A1", "name": "AxialPlane", "type": "3d_object", "semantic": "Axial slice plane", "locator_hints": ["plane mesh for axial"]},
    {"id": "A2", "name": "CoronalPlane", "type": "3d_object", "semantic": "Coronal slice plane", "locator_hints": ["plane mesh for coronal"]},
    {"id": "A3", "name": "SagittalPlane", "type": "3d_object", "semantic": "Sagittal slice plane", "locator_hints": ["plane mesh for sagittal"]},
    {"id": "A4", "name": "AxialSlider", "type": "dom_element", "semantic": "Axial slice selector", "locator_hints": ["#slider-axial"]},
    {"id": "A5", "name": "WindowSlider", "type": "dom_element", "semantic": "Window width control", "locator_hints": ["#slider-window"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.axialSlice === 32", "window.__3D_STATE__.windowWidth === 200", "window.__3D_STATE__.windowLevel === 128"]},
    {"id": "S1", "name": "AxialChanged", "conditions": ["window.__3D_STATE__.axialSlice !== 32"]},
    {"id": "S2", "name": "WindowChanged", "conditions": ["window.__3D_STATE__.windowWidth !== 200"]},
    {"id": "S3", "name": "PlaneToggled", "conditions": ["window.__3D_STATE__.axialVisible === false || window.__3D_STATE__.coronalVisible === false || window.__3D_STATE__.sagittalVisible === false"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.isReset === true"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.volumeSize === 64", "tier": "L2"},
        {"expr": "window.__3D_STATE__.axialSlice === 32", "tier": "L2"},
        {"expr": "window.__3D_STATE__.voxelAtCrosshair >= 0 && window.__3D_STATE__.voxelAtCrosshair <= 255", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-axial').value = 10; document.getElementById('slider-axial').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.axialSlice === 10", "tier": "L2"},
        {"expr": "document.getElementById('hud-axial').textContent.includes('10')", "tier": "L2"},
        {"expr": "window.__3D_STATE__.voxelAtCrosshair >= 0 && window.__3D_STATE__.voxelAtCrosshair <= 255", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-window').value = 50; document.getElementById('slider-window').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.windowWidth === 50", "tier": "L2"},
        {"expr": "document.getElementById('hud-window').textContent.includes('50')", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('check-axial').checked = false; document.getElementById('check-axial').dispatchEvent(new Event('change')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.axialVisible === false", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.axialSlice === 32", "tier": "L2"},
        {"expr": "window.__3D_STATE__.windowWidth === 200", "tier": "L2"},
        {"expr": "window.__3D_STATE__.windowLevel === 128", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isReset === true", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "wait", "duration_ms": 300},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()", "tier": "L0"}
      ]}
    }
  ]
}
