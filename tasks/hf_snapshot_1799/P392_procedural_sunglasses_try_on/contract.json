{
  "task_id": "P392_procedural_sunglasses_try_on",
  "affordances": [
    {
      "id": "A1",
      "name": "SunglassesGroup",
      "type": "3d_object",
      "semantic": "Procedural sunglasses model composed of frames, lenses, and arms",
      "locator_hints": [
        "scene.getObjectByName('sunglassesGroup')",
        "window.__3D_STATE__.sunglassesPosition"
      ]
    },
    {
      "id": "A2",
      "name": "MannequinHead",
      "type": "3d_object",
      "semantic": "Procedural sphere-based mannequin head for try-on display",
      "locator_hints": [
        "scene.getObjectByName('mannequinHead')"
      ]
    },
    {
      "id": "A3",
      "name": "IridescenceLamp",
      "type": "3d_object",
      "semantic": "Loaded GLB lamp model used as decorative prop",
      "locator_hints": [
        "window.__3D_STATE__.modelLoaded"
      ]
    },
    {
      "id": "A4",
      "name": "TryOnButton",
      "type": "dom_element",
      "semantic": "Button to toggle sunglasses between floating and worn positions",
      "locator_hints": [
        "#tryOnBtn"
      ]
    },
    {
      "id": "A5",
      "name": "StyleButton",
      "type": "dom_element",
      "semantic": "Button to cycle through sunglasses style presets",
      "locator_hints": [
        "#styleBtn"
      ]
    },
    {
      "id": "A6",
      "name": "TintSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling lens tint opacity",
      "locator_hints": [
        "#tintSlider"
      ]
    },
    {
      "id": "A7",
      "name": "ScreenshotButton",
      "type": "dom_element",
      "semantic": "Button to toggle screenshot/presentation mode",
      "locator_hints": [
        "#screenshotBtn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.isWorn === false",
        "window.__3D_STATE__.currentStyleIndex === 0",
        "window.__3D_STATE__.isSpinning === false",
        "window.__3D_STATE__.screenshotMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "SunglassesWorn",
      "conditions": [
        "window.__3D_STATE__.isWorn === true",
        "window.__3D_STATE__.isSpinning === false"
      ]
    },
    {
      "id": "S2",
      "name": "StyleChanged",
      "conditions": [
        "window.__3D_STATE__.currentStyleIndex === 1"
      ]
    },
    {
      "id": "S3",
      "name": "TintAdjusted",
      "conditions": [
        "window.__3D_STATE__.lensOpacity >= 0.2",
        "window.__3D_STATE__.lensOpacity <= 0.9"
      ]
    },
    {
      "id": "S4",
      "name": "ScaledUp",
      "conditions": [
        "window.__3D_STATE__.sunglassesScale > 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "SpinningActive",
      "conditions": [
        "window.__3D_STATE__.isSpinning === true",
        "window.__3D_STATE__.isWorn === false"
      ]
    },
    {
      "id": "S6",
      "name": "ScreenshotModeActive",
      "conditions": [
        "window.__3D_STATE__.screenshotMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "SunglassesRemoved",
      "conditions": [
        "window.__3D_STATE__.isWorn === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#tryOnBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Lenses)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
