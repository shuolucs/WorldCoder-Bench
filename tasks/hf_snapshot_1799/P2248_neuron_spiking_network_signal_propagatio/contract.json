{
  "task_id": "P2248_neuron_spiking_network_signal_propagatio",
  "affordances": [
    {
      "id": "A1",
      "name": "NeuronNodes",
      "type": "3d_object",
      "semantic": "Array of 20 neuron spheres in 3D space with spiking dynamics",
      "locator_hints": [
        "IcosahedronGeometry spheres",
        "neurons array in __3D_STATE__"
      ]
    },
    {
      "id": "A2",
      "name": "AxonConnections",
      "type": "3d_object",
      "semantic": "Line segments connecting nearby neurons representing synaptic connections",
      "locator_hints": [
        "THREE.Line objects",
        "connections array"
      ]
    },
    {
      "id": "A3",
      "name": "IonDriveModel",
      "type": "3d_object",
      "semantic": "Loaded PrimaryIonDrive.glb model at center of network",
      "locator_hints": [
        "GLTFLoader result",
        "ionDriveModel in __3D_STATE__"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing simulation stats",
      "locator_hints": [
        "Total Spikes",
        "Tick Count",
        "Sim Speed"
      ]
    },
    {
      "id": "A5",
      "name": "StimulateRandomButton",
      "type": "dom_element",
      "semantic": "Button to stimulate a random neuron",
      "locator_hints": [
        "id='btn-stimulate-random'",
        "Stimulate Random"
      ]
    },
    {
      "id": "A6",
      "name": "NeuronBar",
      "type": "dom_element",
      "semantic": "Bottom bar of 20 colored rectangles showing neuron states",
      "locator_hints": [
        "id='neuron-bar'",
        "20 child divs"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.neuronCount === 20",
        "window.__3D_STATE__.totalSpikes === 0",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simSpeed === 1.0",
        "window.__3D_STATE__.manualStimulations === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AssetLoaded",
      "conditions": [
        "window.__3D_STATE__.ionDriveLoaded === true",
        "window.__3D_STATE__.ionDriveModel !== undefined"
      ]
    },
    {
      "id": "S2",
      "name": "NeuronStimulated",
      "conditions": [
        "window.__3D_STATE__.manualStimulations >= 1",
        "window.__3D_STATE__.firingNeuronIds.length >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "SignalPropagating",
      "conditions": [
        "window.__3D_STATE__.totalSpikes >= 1",
        "window.__3D_STATE__.tickCount > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.simSpeed === 1.5"
      ]
    },
    {
      "id": "S6",
      "name": "BurstFired",
      "conditions": [
        "window.__3D_STATE__.manualStimulations >= 5"
      ]
    },
    {
      "id": "S7",
      "name": "CascadeComplete",
      "conditions": [
        "window.__3D_STATE__.totalSpikes >= 5"
      ]
    },
    {
      "id": "S8",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.simSpeed === 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.totalSpikes === 0",
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.manualStimulations === 0",
        "window.__3D_STATE__.simSpeed === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ionDriveLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionDriveModel !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.neuronCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.neurons) && window.__3D_STATE__.neurons.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.connectionCount > 0 && window.__3D_STATE__.connectionCount <= 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.neurons[0].membranePotential = 0; window.__3D_STATE__.manualStimulations = (window.__3D_STATE__.manualStimulations || 0) + 1; window.__T2_preSpikes = window.__3D_STATE__.totalSpikes;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.neurons[0].membranePotential >= -70 && window.__3D_STATE__.neurons[0].membranePotential <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.manualStimulations >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgMembranePotential === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgMembranePotential)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgMembranePotential >= -70 && window.__3D_STATE__.avgMembranePotential <= 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSpikes >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpikes >= (window.__T2_preSpikes || 0)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.firingNeuronIds)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.membranePotential >= -70 && n.membranePotential <= 30)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__T4_tickSnap = window.__3D_STATE__.tickCount; true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpikes >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "post_actions": [
          {
            "type": "keyboard",
            "key": "ArrowUp"
          }
        ]
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount >= (window.__T4_tickSnap || 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed >= 0.5 && window.__3D_STATE__.simSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simSpeed === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T6_preSpikes = window.__3D_STATE__.totalSpikes; window.__T6_preStim = window.__3D_STATE__.manualStimulations;",
        "post_actions": [
          {
            "type": "keyboard",
            "key": "b"
          }
        ]
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.manualStimulations >= window.__T6_preStim + 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons[0].membranePotential >= -70 && window.__3D_STATE__.neurons[0].membranePotential <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons[5].membranePotential >= -70 && window.__3D_STATE__.neurons[5].membranePotential <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons[10].membranePotential >= -70 && window.__3D_STATE__.neurons[10].membranePotential <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons[15].membranePotential >= -70 && window.__3D_STATE__.neurons[15].membranePotential <= 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSpikes >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpikes > window.__T6_preSpikes",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => !isNaN(n.membranePotential))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.refractoryTimer >= 0)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeSignals === 'number' && window.__3D_STATE__.activeSignals >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpikes >= 5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('neuron-bar') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('neuron-bar').children.length === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-stimulate-random",
        "pre_actions": [
          {
            "type": "script",
            "code": "window.__T9_preStim = window.__3D_STATE__.manualStimulations; window.__T9_preSpikes = window.__3D_STATE__.totalSpikes;"
          }
        ]
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.manualStimulations === window.__T9_preStim + 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-stimulate-random') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalSpikes >= window.__T9_preSpikes",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.connections)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.connections.every(c => c.weight >= 0.5 && c.weight <= 1.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSpikes === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.manualStimulations === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simSpeed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.membranePotential === -70)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neurons.every(n => n.refractoryTimer === 0 && n.isFiring === false)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}