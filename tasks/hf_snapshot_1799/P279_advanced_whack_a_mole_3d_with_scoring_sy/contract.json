        "type": "script",
        "code": "(function() { const state = window.__3D_STATE__; const scene = state._scene || window.scene; if (!scene) return; const raycaster = new THREE.Raycaster(); const camera = state._camera || window.camera; const moles = state._moles || []; let targetMole = null; for (let m of moles) { if (m.position && m.position.y > 0) { targetMole = m; break; } } if (targetMole) { const dir = new THREE.Vector3(); dir.subVectors(targetMole.position, camera.position).normalize(); raycaster.set(camera.position, dir); const screenPos = targetMole.position.clone().project(camera); const x = (screenPos.x + 1) / 2 * window.innerWidth; const y = (-screenPos.y + 1) / 2 * window.innerHeight; const evt = new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt); } })()"
