      ]
    },
    {
      "id": "A5",
      "name": "GameOverOverlay",
      "type": "dom_element",
      "semantic": "Overlay shown when game ends",
      "locator_hints": [
        "#gameOverOverlay"
      ]
    },
    {
      "id": "A6",
      "name": "MoleModels",
      "type": "3d_object",
      "semantic": "MosquitoInAmber 3D models that pop up from holes",
      "locator_hints": [
        "GLTF loaded models at grid positions"
      ]
    },
    {
      "id": "A7",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Green ground plane beneath the holes",
      "locator_hints": [
        "MeshStandardMaterial with color 0x4a8c3f"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false",
        "window.__3D_STATE__.gameState === 'waiting'"
      ]
    },
    {
      "id": "S1",
      "name": "WaitingToStart",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S2",
      "name": "GamePlaying",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.timer > 0",
        "window.__3D_STATE__.timer <= 30"
      ]
    },
    {
      "id": "S3",
      "name": "MolesAppearing",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.activeMoles > 0"
      ]
    },
    {
      "id": "S4",
      "name": "MoleWhacked",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.whackCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.difficultyLevel === 2"
      ]
    },
    {
      "id": "S6",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'",
        "window.__3D_STATE__.timer === 0"
      ]
    },
    {
      "id": "S7",
      "name": "GameRestarted",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.totalRounds >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Raycasting !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gameState !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.whackCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.score === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.whackCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.whackCount >= 0",
            "tier": "L2"
          }
        ]
