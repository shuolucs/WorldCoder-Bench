        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount >= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMonomers >= 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chains[0].every(m => Math.abs(m.x) <= 15 && Math.abs(m.y) <= 15 && Math.abs(m.z) <= 15)",
