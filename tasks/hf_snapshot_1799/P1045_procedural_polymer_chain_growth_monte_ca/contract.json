  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.chainCount === 1",
        "window.__3D_STATE__.totalMonomers === 1",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.temperature === 1.0",
        "window.__3D_STATE__.activeChainIndex === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AfterSingleStep",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 1",
        "window.__3D_STATE__.isRunning === false"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMultipleSteps",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 10",
        "window.__3D_STATE__.totalMonomers >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "AutoStopped",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stepCount >= 20"
      ]
    },
    {
      "id": "S5",
      "name": "TemperatureChanged",
      "conditions": [
        "window.__3D_STATE__.temperature !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "NewChainAdded",
      "conditions": [
        "window.__3D_STATE__.chainCount >= 2",
        "window.__3D_STATE__.activeChainIndex >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "SecondChainGrown",
      "conditions": [
        "window.__3D_STATE__.chainCount >= 2",
        "window.__3D_STATE__.chains[window.__3D_STATE__.activeChainIndex].length >= 3"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.chainCount === 1",
        "window.__3D_STATE__.totalMonomers === 1",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "PostResetGrowth",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 5",
        "window.__3D_STATE__.totalMonomers >= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMonomers >= 1 && window.__3D_STATE__.totalMonomers <= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastAccepted === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<9;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'s'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMonomers >= 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.radiusOfGyration)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radiusOfGyration >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.endToEndDistance)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.endToEndDistance >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
