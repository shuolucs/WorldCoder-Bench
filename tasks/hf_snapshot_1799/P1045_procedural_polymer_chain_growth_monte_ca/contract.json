          },
          {
            "expr": "window.__3D_STATE__.chainCount === 2",
            "tier": "L2"
          },
          {
            "expr": "(()=>{const c=window.__3D_STATE__.chains[window.__3D_STATE__.activeChainIndex]; if(c.length<2) return true; const dx=c[1].x-c[0].x,dy=c[1].y-c[0].y,dz=c[1].z-c[0].z; const d=Math.sqrt(dx*dx+dy*dy+dz*dz); return Math.abs(d-1.5)<0.01;})()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rejectionCount >= 0 && typeof window.__3D_STATE__.rejectionCount === 'number'",
