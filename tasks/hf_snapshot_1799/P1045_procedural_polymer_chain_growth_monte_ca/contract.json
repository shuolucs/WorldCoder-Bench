          },
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperature > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          }
        ]
      }
