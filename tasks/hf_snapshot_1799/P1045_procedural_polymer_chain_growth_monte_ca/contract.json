          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stepCount >= 10",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.chains)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chains.length === window.__3D_STATE__.chainCount",
            "tier": "L2"
          }
        ]
