  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.massA_pos.y === 3",
        "window.__3D_STATE__.massB_pos.y === 0",
        "window.__3D_STATE__.k1 === 40",
        "window.__3D_STATE__.k2 === 30",
        "window.__3D_STATE__.gravityOn === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simTime > 0.4"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "GravityOff",
      "conditions": [
        "window.__3D_STATE__.gravityOn === false",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S4",
      "name": "Spring1Stiffened",
      "conditions": [
        "window.__3D_STATE__.k1 === 50"
      ]
    },
    {
      "id": "S5",
      "name": "Spring2Softened",
      "conditions": [
        "window.__3D_STATE__.k2 === 20"
      ]
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.massA_pos.y - 3) < 0.01",
        "Math.abs(window.__3D_STATE__.massB_pos.y - 0) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "ParticlesActive",
      "conditions": [
        "window.__3D_STATE__.particleCount > 0",
        "window.__3D_STATE__.particleCount <= 200"
      ]
    },
    {
      "id": "S8",
      "name": "EnergyStable",
      "conditions": [
        "!isNaN(window.__3D_STATE__.totalEnergy)",
        "isFinite(window.__3D_STATE__.totalEnergy)"
      ]
    },
    {
      "id": "S9",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.frameCount > 60"
      ]
    }
  ],
