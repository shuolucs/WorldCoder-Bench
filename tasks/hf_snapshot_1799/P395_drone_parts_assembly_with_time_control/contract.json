  "states": [
    {
      "id": "S0",
      "name": "Initial_Disassembled",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.partsCount === 0",
        "window.__3D_STATE__.propellersSpinning === false"
      ]
    },
    {
      "id": "S1",
      "name": "Body_Assembled",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.15",
        "window.__3D_STATE__.assembledParts.includes('body')"
      ]
    },
    {
      "id": "S2",
      "name": "Motors_Assembling",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.2 && window.__3D_STATE__.currentTime < 0.4",
        "window.__3D_STATE__.currentPart !== 'none'"
      ]
    },
    {
      "id": "S3",
      "name": "Motors_Assembled",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.4",
        "window.__3D_STATE__.partsCount >= 5"
      ]
    },
    {
      "id": "S4",
      "name": "Propellers_Assembled",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.6",
        "window.__3D_STATE__.assembledParts.includes('propellers')"
      ]
    },
    {
      "id": "S5",
      "name": "Battery_Assembled",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 0.8",
        "window.__3D_STATE__.assembledParts.includes('battery')"
      ]
    },
    {
      "id": "S6",
      "name": "Fully_Assembled",
      "conditions": [
        "window.__3D_STATE__.currentTime >= 1.0",
        "window.__3D_STATE__.partsCount === 7",
        "window.__3D_STATE__.propellersSpinning === true",
        "window.__3D_STATE__.currentPart === 'complete'"
      ]
    },
    {
      "id": "S7",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S8",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speed !== 1"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_State",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.partsCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 200; document.getElementById('timeSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
