      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 0",
        "window.__3D_STATE__.stageName === 'Interphase'",
        "window.__3D_STATE__.cellCount === 1",
        "window.__3D_STATE__.chromosomeCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 1",
        "window.__3D_STATE__.stageName === 'Prophase'"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 2",
        "window.__3D_STATE__.stageName === 'Metaphase'",
        "window.__3D_STATE__.spindleFibersVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 3",
        "window.__3D_STATE__.stageName === 'Anaphase'",
        "window.__3D_STATE__.chromosomeCount === 8"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 4",
        "window.__3D_STATE__.stageName === 'Telophase'"
      ]
    },
    {
      "id": "S5",
      "name": "Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.currentStage === 5",
        "window.__3D_STATE__.stageName === 'Cytokinesis'",
        "window.__3D_STATE__.cellCount === 2"
      ]
    },
    {
      "id": "S6",
      "name": "ResetToInterphase",
      "conditions": [
        "window.__3D_STATE__.currentStage === 0",
        "window.__3D_STATE__.stageName === 'Interphase'",
        "window.__3D_STATE__.cellCount === 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('stage-number').textContent.includes('2/6') || document.getElementById('stage-number').textContent.includes('2')",
