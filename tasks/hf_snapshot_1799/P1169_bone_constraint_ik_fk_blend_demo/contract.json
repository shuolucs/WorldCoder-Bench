{
  "task_id": "P1169_bone_constraint_ik_fk_blend_demo",
  "affordances": [
    {
      "id": "A1",
      "name": "BoneChain",
      "type": "3d_object",
      "semantic": "4-bone skeletal arm chain with colored cylinders and joint spheres",
      "locator_hints": [
        "bone cylinders",
        "joint spheres",
        "skeleton group"
      ]
    },
    {
      "id": "A2",
      "name": "IKTarget",
      "type": "3d_object",
      "semantic": "Magenta draggable sphere representing the IK target",
      "locator_hints": [
        "magenta sphere",
        "IK target mesh"
      ]
    },
    {
      "id": "A3",
      "name": "BlendSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling IK/FK blend factor from 0 to 100",
      "locator_hints": [
        "#blendSlider"
      ]
    },
    {
      "id": "A4",
      "name": "BlendValueLabel",
      "type": "dom_element",
      "semantic": "Label showing current blend percentage",
      "locator_hints": [
        "#blendValue"
      ]
    },
    {
      "id": "A5",
      "name": "ResetFKButton",
      "type": "dom_element",
      "semantic": "Button to reset all FK rotations to zero",
      "locator_hints": [
        "#resetFKBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetIKButton",
      "type": "dom_element",
      "semantic": "Button to reset IK target to default position",
      "locator_hints": [
        "#resetIKBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleVisButton",
      "type": "dom_element",
      "semantic": "Button to toggle bone chain visibility",
      "locator_hints": [
        "#toggleVisBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing bone selection, blend, positions, IK error",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.boneCount === 4",
        "window.__3D_STATE__.blendFactor === 1.0",
        "window.__3D_STATE__.selectedBone === 0",
        "window.__3D_STATE__.chainVisible === true",
        "window.__3D_STATE__.boneLength === 1.0",
        "window.__3D_STATE__.totalChainLength === 4.0"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFramesRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 5",
        "!isNaN(window.__3D_STATE__.ikError)"
      ]
    },
    {
      "id": "S2",
      "name": "BoneSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBone === 2"
      ]
    },
    {
      "id": "S3",
      "name": "FKRotationApplied",
      "conditions": [
        "Math.abs(window.__3D_STATE__.fkRotations[2]) > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "BlendSetToFK",
      "conditions": [
        "window.__3D_STATE__.blendFactor === 0.0"
      ]
    },
    {
      "id": "S5",
      "name": "BlendSetToMidpoint",
      "conditions": [
        "Math.abs(window.__3D_STATE__.blendFactor - 0.5) < 0.05"
      ]
    },
    {
      "id": "S6",
      "name": "FKReset",
      "conditions": [
        "window.__3D_STATE__.fkRotations.every(r => r === 0)"
      ]
    },
    {
      "id": "S7",
      "name": "IKTargetReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.ikTargetPosition.x - 2) < 0.1",
        "Math.abs(window.__3D_STATE__.ikTargetPosition.y - 2) < 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "ChainHidden",
      "conditions": [
        "window.__3D_STATE__.chainVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "ChainVisibleAgain",
      "conditions": [
        "window.__3D_STATE__.chainVisible === true"
      ]
    },
    {
      "id": "S10",
      "name": "FullIKConverged",
      "conditions": [
        "window.__3D_STATE__.blendFactor === 1.0",
        "window.__3D_STATE__.ikError < 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boneCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.fkRotations) && window.__3D_STATE__.fkRotations.length === 4",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.jointRotations) && window.__3D_STATE__.jointRotations.length === 4",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.endEffectorPosition.x) && !isNaN(window.__3D_STATE__.endEffectorPosition.y) && !isNaN(window.__3D_STATE__.endEffectorPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBone === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedBone === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBone >= 0 && window.__3D_STATE__.selectedBone <= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendFactor === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boneCount === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<6;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'q'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.fkRotations[2]) > 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkRotations[2]) >= 0.087 * 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations[0] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations[2] <= 2.618 && window.__3D_STATE__.fkRotations[2] >= -2.618",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fkRotations[2])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('blendSlider').value = 0; document.getElementById('blendSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blendFactor === 0.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.blendFactor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkRotations[2]) > 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointRotations[2] - window.__3D_STATE__.fkRotations[2]) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.endEffectorPosition.x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('blendSlider').value = 50; document.getElementById('blendSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendFactor - 0.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendFactor > 0.0 && window.__3D_STATE__.blendFactor < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointRotations[2] === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.jointRotations[0]) && !isNaN(window.__3D_STATE__.jointRotations[1]) && !isNaN(window.__3D_STATE__.jointRotations[2]) && !isNaN(window.__3D_STATE__.jointRotations[3])",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('blendSlider') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetFKBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fkRotations[0] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations[1] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations[2] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations[3] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkRotations.every(r => r === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetIKBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.ikTargetPosition.x - 2) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ikTargetPosition.y - 2) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ikTargetPosition.z - 0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikTargetPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.ikTargetPosition.x**2 + window.__3D_STATE__.ikTargetPosition.y**2 + window.__3D_STATE__.ikTargetPosition.z**2) <= 3.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleVisBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chainVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boneCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ikError)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleVisBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chainVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chainVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalChainLength === 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ikIterations === 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.endEffectorPosition.y)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('blendSlider').value = 100; document.getElementById('blendSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blendFactor === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ikError < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikError === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ikError) && isFinite(window.__3D_STATE__.ikError)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.endEffectorPosition !== undefined && typeof window.__3D_STATE__.endEffectorPosition.x === 'number'",
            "tier": "L2"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.endEffectorPosition.x**2 + window.__3D_STATE__.endEffectorPosition.y**2 + window.__3D_STATE__.endEffectorPosition.z**2) <= window.__3D_STATE__.totalChainLength + 0.1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}