        "code": "let beforeArea = window.__3D_STATE__.crossSectionArea; window.__beforeArea = beforeArea; let cp = window.__3D_STATE__.controlPoints; if(cp && cp[0]) { let canvas = document.querySelector('canvas'); let ev1 = new PointerEvent('pointerdown', {clientX: 200, clientY: 200, bubbles: true}); canvas.dispatchEvent(ev1); } if(window.__3D_STATE__.controlPoints[0]) { window.__3D_STATE__.controlPoints[0].x = -5.0; window.__3D_STATE__.controlPoints[1].x = 5.0; }"
