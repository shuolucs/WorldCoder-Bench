        "code": "let slider = document.querySelector('input[type=range]'); if(slider) { let nativeSet = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSet.call(slider, '60'); slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
