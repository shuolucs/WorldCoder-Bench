  "states": [
    {
      "id": "S0",
      "name": "InitialIBeamLoaded",
      "conditions": [
        "window.__3D_STATE__.meshGenerated === true",
        "window.__3D_STATE__.activePreset === 'I-Beam'",
        "window.__3D_STATE__.symmetryEnabled === true",
        "window.__3D_STATE__.extrusionDepth === 30",
        "window.__3D_STATE__.controlPoints.length === 8"
      ]
    },
    {
      "id": "S1",
      "name": "TProfileLoaded",
