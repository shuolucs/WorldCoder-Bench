        "window.__3D_STATE__.meshGenerated === true"
      ]
    },
    {
      "id": "S3",
      "name": "ExtrusionDepthChanged",
      "conditions": [
        "window.__3D_STATE__.extrusionDepth !== 30",
        "window.__3D_STATE__.meshGenerated === true"
      ]
    },
    {
      "id": "S4",
      "name": "ZoomedIn",
      "conditions": [
        "window.__3D_STATE__.cameraZoom > 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "GridHidden",
