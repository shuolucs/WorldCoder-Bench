{
  "task_id": "P1930_procedural_concrete_with_crack_propagati",
  "affordances": [
    {
      "id": "A1",
      "name": "ConcreteSlab",
      "type": "3d_object",
      "semantic": "Main concrete slab with procedural texture for crack simulation",
      "locator_hints": [
        "BoxGeometry 6x0.5x4 at origin",
        "window.__3D_STATE__.slabExists"
      ]
    },
    {
      "id": "A2",
      "name": "StressOverlay",
      "type": "3d_object",
      "semantic": "Semi-transparent stress field visualization plane above slab",
      "locator_hints": [
        "PlaneGeometry at y=0.3",
        "window.__3D_STATE__.stressPlaneExists"
      ]
    },
    {
      "id": "A3",
      "name": "CrackLines",
      "type": "3d_object",
      "semantic": "THREE.Line objects representing crack segments on slab surface",
      "locator_hints": [
        "window.__3D_STATE__.segmentCount"
      ]
    },
    {
      "id": "A4",
      "name": "PropagateButton",
      "type": "dom_element",
      "semantic": "Button to propagate cracks one step",
      "locator_hints": [
        "#btn-propagate"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud-seeds",
        "#hud-segments",
        "#hud-energy",
        "#hud-step"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.seedCount === 0",
        "window.__3D_STATE__.segmentCount === 0",
        "window.__3D_STATE__.stepCount === 0",
        "window.__3D_STATE__.autoPropagation === false"
      ]
    },
    {
      "id": "S1",
      "name": "CrackSeeded",
      "conditions": [
        "window.__3D_STATE__.seedCount >= 1",
        "window.__3D_STATE__.activeTips >= 1",
        "window.__3D_STATE__.totalEnergy >= 0.99"
      ]
    },
    {
      "id": "S2",
      "name": "Propagated",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 1",
        "window.__3D_STATE__.segmentCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "MultiPropagated",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 5",
        "window.__3D_STATE__.segmentCount >= 5"
      ]
    },
    {
      "id": "S4",
      "name": "Undone",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S5",
      "name": "StressToggled",
      "conditions": [
        "window.__3D_STATE__.stressOverlayVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "AutoPropOn",
      "conditions": [
        "window.__3D_STATE__.autoPropagation === true"
      ]
    },
    {
      "id": "S7",
      "name": "BumpCycled",
      "conditions": [
        "window.__3D_STATE__.bumpScale !== 0.02"
      ]
    },
    {
      "id": "S8",
      "name": "ResetDone",
      "conditions": [
        "window.__3D_STATE__.seedCount === 0",
        "window.__3D_STATE__.segmentCount === 0",
        "window.__3D_STATE__.stepCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "SecondSeedAfterReset",
      "conditions": [
        "window.__3D_STATE__.seedCount >= 1",
        "window.__3D_STATE__.segmentCount === 0"
      ]
    },
    {
      "id": "S10",
      "name": "DOMPropagated",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 1",
        "window.__3D_STATE__.segmentCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.slabExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressPlaneExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.seedCount === 0 && window.__3D_STATE__.segmentCount === 0 && window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoPropagation === false && window.__3D_STATE__.stressOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && !isNaN(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 350,
        "description": "Click on slab surface to seed a crack"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.seedCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTips === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'seed'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.crackTips) && window.__3D_STATE__.crackTips.length === 1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.crackTips[0].energy === 'number' && Math.abs(window.__3D_STATE__.crackTips[0].energy - 1.0) < 0.001",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "description": "Press spacebar to propagate one step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'propagate'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy <= 0.92 + 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crackTips.every(t => !isNaN(t.x) && !isNaN(t.z) && !isNaN(t.energy) && !isNaN(t.angle))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:' '}));}",
        "description": "Propagate 4 more steps via script to reach step 5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy < 0.92 * 0.92 * 0.92 * 0.92 * 1.0 + 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crackTips.every(t => t.x >= -3.01 && t.x <= 3.01 && t.z >= -2.01 && t.z <= 2.01)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalSegmentLength === 'number' && window.__3D_STATE__.totalSegmentLength > 0 && !isNaN(window.__3D_STATE__.totalSegmentLength)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u",
        "description": "Press U to undo last propagation step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount < (() => { return window.__3D_STATE__._prevSegCountBeforeUndo || Infinity })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0 && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "v",
        "description": "Press V to toggle stress overlay off"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stressOverlayVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_stress'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-stress') !== null && document.getElementById('hud-stress').textContent.trim() === 'OFF'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressPlaneExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a",
        "description": "Press A to enable auto-propagation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoPropagation === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_auto'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-auto') !== null && document.getElementById('hud-auto').textContent.trim() === 'ON'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number' && window.__3D_STATE__.stepCount >= 4",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'a'}));document.dispatchEvent(new KeyboardEvent('keydown',{key:'b'}));",
        "description": "Disable auto-prop then cycle bump scale"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoPropagation === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bumpScale !== 0.02",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bumpScale - 0.05) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'cycle_bump'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-bump') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset entire simulation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.seedCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTips === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset' && window.__3D_STATE__.undoStackSize === 0 && window.__3D_STATE__.branchCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 350,
        "y": 330,
        "description": "Click slab to seed a new crack after reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.seedCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTips === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crackTips.length === 1 && typeof window.__3D_STATE__.crackTips[0].id !== 'undefined'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-propagate",
        "description": "Click DOM propagate button"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'propagate'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy <= 0.921 && window.__3D_STATE__.totalEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-step') !== null && document.getElementById('hud-step').textContent.trim() === '1'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-segments') !== null && parseInt(document.getElementById('hud-segments').textContent) >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset",
        "description": "Click DOM reset button to verify DOM-triggered reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.seedCount === 0 && window.__3D_STATE__.segmentCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepCount === 0 && window.__3D_STATE__.activeTips === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-seeds').textContent.trim() === '0'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-energy').textContent.trim() === '0.0000'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}