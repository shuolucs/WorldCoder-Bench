  "states": [
    {
      "id": "S0",
      "name": "Initial_SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.selectedIndex === -1",
        "window.__3D_STATE__.selectedName === 'None'",
        "window.__3D_STATE__.tryOnActive === false",
        "window.__3D_STATE__.turntableAngleDeg === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SunglassesSelected",
      "conditions": [
        "window.__3D_STATE__.selectedIndex >= 0 && window.__3D_STATE__.selectedIndex <= 3",
        "window.__3D_STATE__.selectedName !== 'None'",
        "window.__3D_STATE__.tryOnActive === false"
      ]
    },
    {
      "id": "S2",
      "name": "TryOnActive",
      "conditions": [
        "window.__3D_STATE__.selectedIndex >= 0",
        "window.__3D_STATE__.tryOnActive === true",
        "window.__3D_STATE__.turntableRotating === true"
      ]
    },
    {
      "id": "S3",
      "name": "TurntableRotatedLeft",
      "conditions": [
        "window.__3D_STATE__.turntableAngleDeg >= 40 && window.__3D_STATE__.turntableAngleDeg <= 50"
      ]
    },
    {
      "id": "S4",
      "name": "TurntableRotatedRight",
      "conditions": [
        "window.__3D_STATE__.turntableAngleDeg >= 310 && window.__3D_STATE__.turntableAngleDeg <= 320"
      ]
    },
    {
      "id": "S5",
      "name": "LensTintChanged",
      "conditions": [
        "window.__3D_STATE__.selectedIndex >= 0",
        "window.__3D_STATE__.lensTintColor !== null"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.selectedIndex === -1",
        "window.__3D_STATE__.selectedName === 'None'",
        "window.__3D_STATE__.tryOnActive === false",
        "window.__3D_STATE__.turntableRotating === false"
      ]
    }
  ],
