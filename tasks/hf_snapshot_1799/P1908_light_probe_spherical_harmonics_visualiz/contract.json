  "states": [
    {
      "id": "S0",
      "name": "InitialIrradianceMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'irradiance'",
        "window.__3D_STATE__.activePreset === 'Outdoor'",
        "window.__3D_STATE__.selectedBand === 0",
        "window.__3D_STATE__.selectedCoefficient === 0",
        "window.__3D_STATE__.interpolating === false",
        "window.__3D_STATE__.sphereVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "BandsMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'bands'"
      ]
    },
    {
      "id": "S2",
      "name": "BandsCycled",
      "conditions": [
        "window.__3D_STATE__.mode === 'bands'",
        "window.__3D_STATE__.selectedBand === 1"
      ]
    },
    {
      "id": "S3",
      "name": "CoefficientsMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'coefficients'"
      ]
    },
    {
      "id": "S4",
      "name": "CoefficientCycled",
      "conditions": [
        "window.__3D_STATE__.mode === 'coefficients'",
        "window.__3D_STATE__.selectedCoefficient > 0"
      ]
    },
    {
      "id": "S5",
      "name": "IndoorPresetTransitioning",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Indoor'",
        "window.__3D_STATE__.interpolating === true || window.__3D_STATE__.interpolationProgress >= 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "IndoorPresetSettled",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Indoor'",
        "window.__3D_STATE__.interpolating === false",
        "window.__3D_STATE__.interpolationProgress >= 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "StudioPresetSettled",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Studio'",
        "window.__3D_STATE__.interpolating === false"
      ]
    },
    {
      "id": "S8",
      "name": "BackToIrradiance",
      "conditions": [
        "window.__3D_STATE__.mode === 'irradiance'"
      ]
    },
    {
      "id": "S9",
      "name": "OutdoorRestoredSettled",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Outdoor'",
        "window.__3D_STATE__.interpolating === false"
      ]
    }
  ],
