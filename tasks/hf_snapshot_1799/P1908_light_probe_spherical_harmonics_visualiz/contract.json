      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.mode === 'string' && window.__3D_STATE__.mode === 'irradiance'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.shCoefficients) && window.__3D_STATE__.shCoefficients.length === 9",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.every(c => typeof c.r === 'number' && typeof c.g === 'number' && typeof c.b === 'number' && isFinite(c.r) && isFinite(c.g) && isFinite(c.b))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.coefficientEnergy === 'number' && isFinite(window.__3D_STATE__.coefficientEnergy) && window.__3D_STATE__.coefficientEnergy > 0",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shCoefficients[0].r - 0.87) < 0.05 && Math.abs(window.__3D_STATE__.shCoefficients[0].g - 0.88) < 0.05",
            "tier": "L2"
