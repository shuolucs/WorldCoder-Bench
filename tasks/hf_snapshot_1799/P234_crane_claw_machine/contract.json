  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.clawState === 'idle'",
        "window.__3D_STATE__.coins === 3"
      ]
    },
    {
      "id": "S1",
      "name": "GameStarted",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.clawState === 'idle'",
        "window.__3D_STATE__.coins === 3"
      ]
    },
    {
      "id": "S2",
      "name": "ClawMovedRight",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.clawX > 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "ClawMovedDepth",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.clawZ !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "DropSequenceStarted",
      "conditions": [
        "window.__3D_STATE__.dropSequenceActive === true",
        "window.__3D_STATE__.clawState === 'descending'"
      ]
    },
    {
      "id": "S5",
      "name": "ClawAtBottom",
      "conditions": [
        "window.__3D_STATE__.clawY <= 2.0",
        "window.__3D_STATE__.clawState === 'grabbing' || window.__3D_STATE__.clawState === 'ascending'"
      ]
    },
    {
      "id": "S6",
      "name": "ClawAscending",
      "conditions": [
        "window.__3D_STATE__.clawState === 'ascending'",
        "window.__3D_STATE__.clawOpen === false"
      ]
    },
    {
      "id": "S7",
      "name": "ClawDelivering",
      "conditions": [
        "window.__3D_STATE__.clawState === 'delivering' || window.__3D_STATE__.clawState === 'releasing'"
      ]
    },
    {
      "id": "S8",
      "name": "DropComplete",
      "conditions": [
        "window.__3D_STATE__.dropSequenceActive === false",
        "window.__3D_STATE__.totalDrops >= 1",
        "window.__3D_STATE__.coins <= 2"
      ]
    },
    {
      "id": "S9",
      "name": "SecondDropStarted",
      "conditions": [
        "window.__3D_STATE__.dropSequenceActive === true",
        "window.__3D_STATE__.totalDrops >= 1"
      ]
    },
    {
      "id": "S10",
      "name": "ClawBoundsTest",
      "conditions": [
        "window.__3D_STATE__.clawX >= -4 && window.__3D_STATE__.clawX <= 4",
        "window.__3D_STATE__.clawZ >= -4 && window.__3D_STATE__.clawZ <= 4"
      ]
    },
    {
      "id": "S11",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.coins === 3",
        "window.__3D_STATE__.totalDrops === 0",
        "window.__3D_STATE__.lanternsRemaining === 5"
      ]
    },
    {
      "id": "S12",
      "name": "AllCoinsUsed",
      "conditions": [
        "window.__3D_STATE__.coins === 0"
      ]
    }
  ],
