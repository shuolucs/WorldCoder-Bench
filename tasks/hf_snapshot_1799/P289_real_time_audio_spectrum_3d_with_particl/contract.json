{
  "task_id": "P289_real_time_audio_spectrum_3d_with_particl",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumBars",
      "type": "3d_object",
      "semantic": "32 vertical bars representing audio frequency bands",
      "locator_hints": [
        "BoxGeometry bars along X-axis",
        "children of scene with bar mesh"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "Particle system emitting from bar tops",
      "locator_hints": [
        "Points object with BufferGeometry",
        "2000 particles"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing mode, gain, status",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A4",
      "name": "GainUpButton",
      "type": "dom_element",
      "semantic": "Button to increase gain multiplier",
      "locator_hints": [
        "button#gain-up"
      ]
    },
    {
      "id": "A5",
      "name": "GainDownButton",
      "type": "dom_element",
      "semantic": "Button to decrease gain multiplier",
      "locator_hints": [
        "button#gain-down"
      ]
    },
    {
      "id": "A6",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "Perspective camera with orbit controls",
      "locator_hints": [
        "PerspectiveCamera at (0,30,60)"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'bars'",
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.gain === 1.0",
        "window.__3D_STATE__.particlesEnabled === true",
        "window.__3D_STATE__.barCount === 32"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.maxBarHeight > 1",
        "window.__3D_STATE__.timeElapsed > 0.5"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.playing === false"
      ]
    },
    {
      "id": "S3",
      "name": "CircularMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'circular'"
      ]
    },
    {
      "id": "S4",
      "name": "WaveMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'wave'"
      ]
    },
    {
      "id": "S5",
      "name": "GainIncreased",
      "conditions": [
        "window.__3D_STATE__.gain === 1.25"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesDisabled",
      "conditions": [
        "window.__3D_STATE__.particlesEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraDistance - Math.sqrt(60*60+30*30)) < 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bars !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.circular !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wave !== undefined",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bars)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
