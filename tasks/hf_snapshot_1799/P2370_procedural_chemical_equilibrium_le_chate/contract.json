    {
      "id": "S0",
      "name": "InitialEquilibrium",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.isEquilibrium === true",
        "Math.abs(window.__3D_STATE__.Kc - 4.0) < 0.001",
        "Math.abs(window.__3D_STATE__.concentrationA - 1.0) < 0.05",
        "Math.abs(window.__3D_STATE__.concentrationB - 1.0) < 0.05",
        "Math.abs(window.__3D_STATE__.concentrationC - 4.0) < 0.05"
      ]
    },
    {
      "id": "S1",
