      "id": "A2",
      "name": "HotspotMaterial",
      "type": "3d_object",
      "semantic": "Yellow glowing hotspot sphere for Material feature",
      "locator_hints": [
        "position near (0.5, 1.0, 0.5)",
        "yellow color #ffdd00"
      ]
    },
    {
      "id": "A3",
      "name": "HotspotCompartments",
      "type": "3d_object",
      "semantic": "Cyan glowing hotspot sphere for Compartments feature",
      "locator_hints": [
        "position near (-0.5, 0.5, 0.5)",
        "cyan color #00ddff"
      ]
    },
    {
      "id": "A4",
      "name": "HotspotStraps",
      "type": "3d_object",
      "semantic": "Magenta glowing hotspot sphere for Straps feature",
      "locator_hints": [
        "position near (0, 1.5, -0.3)",
        "magenta color #ff00dd"
      ]
    },
    {
      "id": "A5",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Bottom info panel showing feature descriptions",
      "locator_hints": [
        "div#info-panel"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset camera and clear selection",
      "locator_hints": [
        "button#reset-btn"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleRotationButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume auto-rotation",
      "locator_hints": [
        "button#toggle-rotation-btn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.activeFeature === 'none'",
        "window.__3D_STATE__.autoRotating === true",
        "window.__3D_STATE__.hotspotCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "MaterialFeatureSelected",
      "conditions": [
        "window.__3D_STATE__.activeFeature === 'Material'",
        "window.__3D_STATE__.particlesActive === true || window.__3D_STATE__.particleCount >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.autoRotating === false"
      ]
    },
    {
      "id": "S3",
      "name": "RotationResumed",
      "conditions": [
        "window.__3D_STATE__.autoRotating === true"
      ]
    },
    {
      "id": "S4",
      "name": "CompartmentsFeatureSelected",
      "conditions": [
        "window.__3D_STATE__.activeFeature === 'Compartments'"
      ]
    },
    {
      "id": "S5",
      "name": "ViewReset",
      "conditions": [
        "window.__3D_STATE__.activeFeature === 'none'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Material !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Compartments !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Straps !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.autoRotating === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Compartments)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Straps)",
            "tier": "L0"
          }
