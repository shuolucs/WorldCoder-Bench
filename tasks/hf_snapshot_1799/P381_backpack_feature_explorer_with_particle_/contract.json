    {
      "id": "A1",
      "name": "BackpackModel",
      "type": "3d_object",
      "semantic": "The loaded GLB model representing the backpack product",
      "locator_hints": [
        "loaded via GLTFLoader from coffeemat.glb",
        "centered at origin"
      ]
    },
