            "expr": "window.__3D_STATE__.polarization !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.showB !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.wavelength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.frequency === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.showB === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.wavelength === 'number' && window.__3D_STATE__.wavelength >= 1 && window.__3D_STATE__.wavelength <= 10",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.frequency === 'number' && window.__3D_STATE__.frequency >= 0.5 && window.__3D_STATE__.frequency <= 5",
            "tier": "L0"
          },
          {
            "expr": "['linear','circular','elliptical'].includes(window.__3D_STATE__.polarization)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number' && isFinite(window.__3D_STATE__.simTime)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxAmplitudeE === 'number' && isFinite(window.__3D_STATE__.maxAmplitudeE)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxAmplitudeB === 'number' && isFinite(window.__3D_STATE__.maxAmplitudeB)",
            "tier": "L0"
          }
        ]
      }
