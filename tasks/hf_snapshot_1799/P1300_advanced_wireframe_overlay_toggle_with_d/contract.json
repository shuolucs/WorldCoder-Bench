{
  "task_id": "P1300_advanced_wireframe_overlay_toggle_with_d",
  "affordances": [
    {
      "id": "A1",
      "name": "SolidMeshes",
      "type": "3d_object",
      "semantic": "Five geometric objects arranged in a circle, clickable to toggle wireframe overlays",
      "locator_hints": [
        "scene.children with isMesh",
        "BoxGeometry, SphereGeometry, ConeGeometry, TorusGeometry, CylinderGeometry"
      ]
    },
    {
      "id": "A2",
      "name": "WireframeOverlays",
      "type": "3d_object",
      "semantic": "LineSegments wireframe overlays for each solid mesh, toggled by clicking or pressing W",
      "locator_hints": [
        "scene.children with isLineSegments",
        "EdgesGeometry based"
      ]
    },
    {
      "id": "A3",
      "name": "ToggleDepthButton",
      "type": "dom_element",
      "semantic": "Button to toggle depthTest on all wireframes",
      "locator_hints": [
        "#toggleDepthBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing current score",
      "locator_hints": [
        "#scoreDisplay"
      ]
    },
    {
      "id": "A5",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing wireframe count, depth test state, and wire color",
      "locator_hints": [
        "#infoPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.objectCount === 5",
        "window.__3D_STATE__.wireframeVisibleCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.depthTestEnabled === true",
        "window.__3D_STATE__.allWireframesOff === true"
      ]
    },
    {
      "id": "S1",
      "name": "OneWireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeVisibleCount === 1",
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.allWireframesOff === false",
        "window.__3D_STATE__.allWireframesOn === false"
      ]
    },
    {
      "id": "S2",
      "name": "AllWireframesOn",
      "conditions": [
        "window.__3D_STATE__.wireframeVisibleCount === 5",
        "window.__3D_STATE__.allWireframesOn === true",
        "window.__3D_STATE__.allWireframesOff === false"
      ]
    },
    {
      "id": "S3",
      "name": "DepthTestDisabled",
      "conditions": [
        "window.__3D_STATE__.depthTestEnabled === false",
        "window.__3D_STATE__.wireframeVisibleCount === 5"
      ]
    },
    {
      "id": "S4",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorIndex > 0",
        "window.__3D_STATE__.wireframeColors !== '#ffffff'"
      ]
    },
    {
      "id": "S5",
      "name": "DepthTestReEnabled",
      "conditions": [
        "window.__3D_STATE__.depthTestEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "AllWireframesOff",
      "conditions": [
        "window.__3D_STATE__.wireframeVisibleCount === 0",
        "window.__3D_STATE__.allWireframesOff === true"
      ]
    },
    {
      "id": "S7",
      "name": "PartialWireframes",
      "conditions": [
        "window.__3D_STATE__.wireframeVisibleCount > 0",
        "window.__3D_STATE__.wireframeVisibleCount < 5"
      ]
    },
    {
      "id": "S8",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.wireframeVisibleCount === 0",
        "window.__3D_STATE__.colorIndex === 0",
        "window.__3D_STATE__.depthTestEnabled === true",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOff === true && window.__3D_STATE__.colorIndex === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "first solid mesh (box)",
        "description": "Click on the box geometry to toggle its wireframe on"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOff === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastToggledIndex >= 0 && window.__3D_STATE__.lastToggledIndex <= 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.objectRotations === 'object' && window.__3D_STATE__.objectRotations.length === 5",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "description": "Press W to toggle all wireframes ON since not all are on"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOff === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d",
        "description": "Press D to toggle depth test OFF (x-ray mode)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && window.__3D_STATE__.cameraDistance > 0 && isFinite(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c",
        "description": "Press C to cycle wireframe color from white to red"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeColors === '#ff0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score > 53",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleDepthBtn",
        "description": "Click the Toggle Depth Test button to re-enable depth testing"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeColors === '#ff0000'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 58",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "description": "Press W to toggle all wireframes OFF since all are currently on"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOff === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 33",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "sphere mesh",
        "description": "Click on the sphere to toggle just its wireframe on, creating partial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount > 0 && window.__3D_STATE__.wireframeVisibleCount < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOff === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastToggledIndex >= 0 && window.__3D_STATE__.lastToggledIndex <= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectRotations.every(r => typeof r === 'number' && !isNaN(r))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset the entire scene to initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeColors === '#ffffff'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1 && window.__3D_STATE__.allWireframesOff === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "description": "After reset, press W to toggle all wireframes ON again to verify reset worked cleanly"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisibleCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allWireframesOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.depthTestEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeColors === '#ffffff'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}