{
  "task_id": "P504_miniature_morphing_geometry_diorama",
  "affordances": [
    {
      "id": "A1",
      "name": "MorphSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling morph progress 0-100",
      "locator_hints": [
        "#morphSlider"
      ]
    },
    {
      "id": "A2",
      "name": "SpinButton",
      "type": "dom_element",
      "semantic": "Button toggling orbital spin of morph objects",
      "locator_hints": [
        "#spinBtn"
      ]
    },
    {
      "id": "A3",
      "name": "FerrariModel",
      "type": "3d_object",
      "semantic": "Ferrari GLB model on diorama platform",
      "locator_hints": [
        "ferrariModel"
      ]
    },
    {
      "id": "A4",
      "name": "MorphObjects",
      "type": "3d_object",
      "semantic": "Four morphing geometry objects around the Ferrari",
      "locator_hints": [
        "MorphSphere",
        "MorphCube",
        "MorphCone",
        "MorphTorus"
      ]
    },
    {
      "id": "A5",
      "name": "DioramaPlatform",
      "type": "3d_object",
      "semantic": "Circular platform base of the diorama",
      "locator_hints": [
        "platform"
      ]
    },
    {
      "id": "A6",
      "name": "GlassDome",
      "type": "3d_object",
      "semantic": "Transparent dome in miniature mode",
      "locator_hints": [
        "dome"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Status display panel",
      "locator_hints": [
        "#hudPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.ferrariLoaded === true",
        "window.__3D_STATE__.morphProgress === 0",
        "window.__3D_STATE__.spinActive === false",
        "window.__3D_STATE__.miniatureMode === false",
        "window.__3D_STATE__.objectCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "MorphedHalfway",
      "conditions": [
        "window.__3D_STATE__.morphProgress === 50"
      ]
    },
    {
      "id": "S2",
      "name": "MorphedFull",
      "conditions": [
        "window.__3D_STATE__.morphProgress === 100"
      ]
    },
    {
      "id": "S3",
      "name": "SpinActive",
      "conditions": [
        "window.__3D_STATE__.spinActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "ColorCycled",
      "conditions": [
        "window.__3D_STATE__.colorPaletteIndex === 1"
      ]
    },
    {
      "id": "S5",
      "name": "PulseActive",
      "conditions": [
        "window.__3D_STATE__.pulseActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "MiniatureMode",
      "conditions": [
        "window.__3D_STATE__.miniatureMode === true",
        "window.__3D_STATE__.domeVisible === true",
        "Math.abs(window.__3D_STATE__.dioramaScale - 0.4) < 0.05"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.morphProgress === 0",
        "window.__3D_STATE__.spinActive === false",
        "window.__3D_STATE__.pulseActive === false",
        "window.__3D_STATE__.miniatureMode === false",
        "window.__3D_STATE__.colorPaletteIndex === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('morphSlider').value = 50; document.getElementById('morphSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.morphProgress !== before.morphProgress || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.morphProgress === 'number' && !isNaN(window.__3D_STATE__.morphProgress)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.spinAngle === 'number' && !isNaN(window.__3D_STATE__.spinAngle)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.morphObjectsPositions)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ferrariLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.spinActive === 'boolean'",
            "tier": "L0"
