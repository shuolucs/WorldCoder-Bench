  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.beakers.length === 4",
        "window.__3D_STATE__.playerCount === 1"
      ]
    },
    {
      "id": "S1",
      "name": "PlayerMovedToBeaker0",
      "conditions": [
        "window.__3D_STATE__.players[0].hoverBeakerIndex === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Beaker0Stirred",
      "conditions": [
        "window.__3D_STATE__.beakers[0].stirCount >= 1",
        "window.__3D_STATE__.beakers[0].period <= 1.5"
      ]
    },
    {
      "id": "S3",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.beakers[0].stirCount === 0",
        "window.__3D_STATE__.beakers[0].period === 3"
      ]
    },
    {
      "id": "S4",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.beakers[0].stirCount === 1",
        "window.__3D_STATE__.beakers[0].period === 1.5"
      ]
    },
    {
      "id": "S5",
      "name": "SecondPlayerAdded",
      "conditions": [
        "window.__3D_STATE__.playerCount === 2"
      ]
    },
    {
      "id": "S6",
      "name": "Player2Active",
      "conditions": [
        "window.__3D_STATE__.activePlayerIndex === 1"
      ]
    },
    {
      "id": "S7",
      "name": "Beaker3StirredByPlayer2",
      "conditions": [
        "window.__3D_STATE__.beakers[3].stirCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "AllSynced",
      "conditions": [
        "window.__3D_STATE__.allSynced === true"
      ]
    },
    {
      "id": "S9",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S10",
      "name": "SimulationResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S11",
      "name": "Beaker0ResetAfterSync",
      "conditions": [
        "window.__3D_STATE__.beakers[0].stirCount === 0"
      ]
    }
