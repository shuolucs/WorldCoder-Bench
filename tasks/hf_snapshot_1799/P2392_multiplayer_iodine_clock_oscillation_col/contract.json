            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beakers === 'object' && Array.isArray(window.__3D_STATE__.beakers) && window.__3D_STATE__.beakers.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].defaultPeriod === 3 && window.__3D_STATE__.beakers[1].defaultPeriod === 4 && window.__3D_STATE__.beakers[2].defaultPeriod === 5 && window.__3D_STATE__.beakers[3].defaultPeriod === 6",
