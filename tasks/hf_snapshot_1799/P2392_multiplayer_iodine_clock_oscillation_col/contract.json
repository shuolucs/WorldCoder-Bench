            "expr": "window.__3D_STATE__.playerCount === 1 && window.__3D_STATE__.activePlayerIndex === 0 && window.__3D_STATE__.undoStackSize === 0 && window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
