{
  "task_id": "P1822_skeleton_rigging_joint_hierarchy_viewer_",
  "affordances": [
    {
      "id": "A1",
      "name": "SkeletonJoints",
      "type": "3d_object",
      "semantic": "Sphere meshes representing each bone joint in the skeleton hierarchy",
      "locator_hints": [
        "spheres with radius ~0.06",
        "green (0x00ff88) default color"
      ]
    },
    {
      "id": "A2",
      "name": "BoneConnections",
      "type": "3d_object",
      "semantic": "Lines or cylinders connecting parent-child joints",
      "locator_hints": [
        "line segments or thin cylinders between joint spheres"
      ]
    },
    {
      "id": "A3",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle animation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A4",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling animation speed",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A5",
      "name": "AmplitudeSlider",
      "type": "dom_element",
      "semantic": "Slider controlling wave amplitude",
      "locator_hints": [
        "#slider-amplitude"
      ]
    },
    {
      "id": "A6",
      "name": "TimeScrubber",
      "type": "dom_element",
      "semantic": "Slider for scrubbing animation time when paused",
      "locator_hints": [
        "#slider-time"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all state to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A8",
      "name": "JointInfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected joint details",
      "locator_hints": [
        "#joint-info"
      ]
    },
    {
      "id": "A9",
      "name": "HierarchyTree",
      "type": "dom_element",
      "semantic": "DOM tree view of bone hierarchy",
      "locator_hints": [
        "#hierarchy-tree",
        ".tree-node"
      ]
    },
    {
      "id": "A10",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "Current animation time readout",
      "locator_hints": [
        "#time-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.selectedJoint === null",
        "window.__3D_STATE__.boneCount === 15"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "JointSelectedViaTree",
      "conditions": [
        "window.__3D_STATE__.selectedJoint !== null",
        "window.__3D_STATE__.selectedTreeNode === window.__3D_STATE__.selectedJoint"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 2.0"
      ]
    },
    {
      "id": "S4",
      "name": "AmplitudeChanged",
      "conditions": [
        "window.__3D_STATE__.amplitude !== 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "TimeScrubbed",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AnimationApplied",
      "conditions": [
        "window.__3D_STATE__.currentTime > 0",
        "window.__3D_STATE__.spineScaleY !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.speed === 2.0",
        "window.__3D_STATE__.amplitude === 0.5",
        "window.__3D_STATE__.selectedJoint === null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boneCount === 15",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointWorldPositions === 'object' && Object.keys(window.__3D_STATE__.jointWorldPositions).length === 15",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.hierarchyDepths === 'object' && window.__3D_STATE__.hierarchyDepths['Root'] === 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxDepth >= 3 && window.__3D_STATE__.maxDepth <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false && window.__3D_STATE__.currentTime === 0 && window.__3D_STATE__.selectedJoint === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTime) && isFinite(window.__3D_STATE__.currentTime)",
            "tier": "L2"
          },
          {
            "expr": "Object.values(window.__3D_STATE__.jointLocalRotations).every(r => !isNaN(r.x) && !isNaN(r.y) && !isNaN(r.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spineScaleY >= 0.95 && window.__3D_STATE__.spineScaleY <= 1.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('.tree-node[data-bone-name=\"LeftArm\"]').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'LeftArm'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedTreeNode === 'LeftArm'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointWorldPositions['LeftArm'] === 'object'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.jointWorldPositions['LeftArm'].x === 'number' && !isNaN(window.__3D_STATE__.jointWorldPositions['LeftArm'].x)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.hierarchyDepths['LeftArm'] >= 2 && window.__3D_STATE__.hierarchyDepths['LeftArm'] <= 4",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#joint-info').textContent.includes('LeftArm')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__before_time = window.__3D_STATE__.currentTime;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > window.__before_time",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime - window.__before_time > 0",
            "tier": "L2"
          },
          {
            "expr": "Object.values(window.__3D_STATE__.jointWorldPositions).every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointWorldPositions['Root'].y > 0.5 && window.__3D_STATE__.jointWorldPositions['Root'].y < 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.querySelector('#slider-speed'); let nv = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value'); nv.set.call(s, '4.0'); s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.speed - 4.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speed > 2.0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#slider-speed').value === '4'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let a = document.querySelector('#slider-amplitude'); let nv = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value'); nv.set.call(a, '1.2'); a.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 1.2) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitude > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spineScaleY >= 0.95 && window.__3D_STATE__.spineScaleY <= 1.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.jointLocalRotations['LeftShoulder'].z) <= 1.2 * (180/Math.PI) * 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-play-pause').click(); setTimeout(() => { let t = document.querySelector('#slider-time'); let nv = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value'); nv.set.call(t, '25.0'); t.dispatchEvent(new Event('input', {bubbles:true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - 25.0) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTime)",
            "tier": "L2"
          },
          {
            "expr": "Object.values(window.__3D_STATE__.jointLocalRotations).every(r => !isNaN(r.x) && !isNaN(r.y) && !isNaN(r.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__scrub_pos_before = JSON.parse(JSON.stringify(window.__3D_STATE__.jointWorldPositions['LeftHand'])); let t = document.querySelector('#slider-time'); let nv = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value'); nv.set.call(t, '50.0'); t.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - 50.0) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spineScaleY >= 0.95 && window.__3D_STATE__.spineScaleY <= 1.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointWorldPositions['LeftHand'].x !== window.__scrub_pos_before.x || window.__3D_STATE__.jointWorldPositions['LeftHand'].y !== window.__scrub_pos_before.y || window.__3D_STATE__.jointWorldPositions['LeftHand'].z !== window.__scrub_pos_before.z",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointWorldPositions['Head'].y > window.__3D_STATE__.jointWorldPositions['Root'].y",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('.tree-node[data-bone-name=\"RightHand\"]').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedJoint === 'RightHand'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedTreeNode === 'RightHand'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jointWorldPositions['RightHand'].x > 0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#joint-info').textContent.includes('RightHand')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hierarchyDepths['RightHand'] >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S2",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.speed - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedJoint === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedTreeNode === null",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}