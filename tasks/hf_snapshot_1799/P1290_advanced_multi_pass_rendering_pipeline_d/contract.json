{
  "task_id": "P1290_advanced_multi_pass_rendering_pipeline_d",
  "affordances": [
    {
      "id": "A1",
      "name": "PipelineDebuggerPanel",
      "type": "dom_element",
      "semantic": "Left-side panel showing all 5 render passes with toggle buttons, render times, and status indicators",
      "locator_hints": [
        "div on left side",
        "width ~280px"
      ]
    },
    {
      "id": "A2",
      "name": "PassToggleButtons",
      "type": "dom_element",
      "semantic": "5 toggle buttons to enable/disable each render pass",
      "locator_hints": [
        "buttons inside left panel",
        "labeled Enable/Disable"
      ]
    },
    {
      "id": "A3",
      "name": "SoloModeSelect",
      "type": "dom_element",
      "semantic": "Dropdown/select to choose solo pass viewing mode",
      "locator_hints": [
        "select element",
        "options include None, Geometry, Depth, etc."
      ]
    },
    {
      "id": "A4",
      "name": "BlendWeightSliders",
      "type": "dom_element",
      "semantic": "4 range sliders controlling blend weights for passes 1-4",
      "locator_hints": [
        "input[type=range]",
        "Blend Weights section"
      ]
    },
    {
      "id": "A5",
      "name": "ScorePanel",
      "type": "dom_element",
      "semantic": "Right-side panel showing score, interaction count, and scoring event log",
      "locator_hints": [
        "div on right side",
        "width ~200px"
      ]
    },
    {
      "id": "A6",
      "name": "ResetScoreButton",
      "type": "dom_element",
      "semantic": "Button to reset the score to 0",
      "locator_hints": [
        "button labeled Reset Score",
        "inside score panel"
      ]
    },
    {
      "id": "A7",
      "name": "SceneObjects",
      "type": "3d_object",
      "semantic": "5 rotating geometric objects: torus knot, sphere, box, cylinder, cone",
      "locator_hints": [
        "mesh objects in scene"
      ]
    },
    {
      "id": "A8",
      "name": "RenderCanvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas showing the multi-pass rendered output",
      "locator_hints": [
        "canvas element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.passCount === 5",
        "window.__3D_STATE__.activePassCount === 5",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.soloMode === 'None'",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.blendWeights[0] === 0 && window.__3D_STATE__.blendWeights[1] === 0 && window.__3D_STATE__.blendWeights[2] === 0 && window.__3D_STATE__.blendWeights[3] === 0"
      ]
    },
    {
      "id": "S1",
      "name": "PassToggledOff",
      "conditions": [
        "window.__3D_STATE__.passEnabled.filter(v => v === false).length >= 1",
        "window.__3D_STATE__.activePassCount < 5",
        "window.__3D_STATE__.score >= 10"
      ]
    },
    {
      "id": "S2",
      "name": "SoloModeActive",
      "conditions": [
        "window.__3D_STATE__.soloMode !== 'None'",
        "window.__3D_STATE__.soloModeIndex >= 0 && window.__3D_STATE__.soloModeIndex <= 4"
      ]
    },
    {
      "id": "S3",
      "name": "BlendWeightsAdjusted",
      "conditions": [
        "window.__3D_STATE__.blendWeights.some(w => w > 0)"
      ]
    },
    {
      "id": "S4",
      "name": "PipelinePaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "MultiplePassesDisabled",
      "conditions": [
        "window.__3D_STATE__.passEnabled.filter(v => v === false).length >= 2",
        "window.__3D_STATE__.activePassCount <= 3"
      ]
    },
    {
      "id": "S6",
      "name": "AllSoloModesVisited",
      "conditions": [
        "window.__3D_STATE__.soloModesVisited.length >= 5",
        "window.__3D_STATE__.allSolosBonusAwarded === true"
      ]
    },
    {
      "id": "S7",
      "name": "PipelineResetState",
      "conditions": [
        "window.__3D_STATE__.activePassCount === 5",
        "window.__3D_STATE__.blendWeights.every(w => w === 0)",
        "window.__3D_STATE__.passEnabled.every(v => v === true)"
      ]
    },
    {
      "id": "S8",
      "name": "HighScoreState",
      "conditions": [
        "window.__3D_STATE__.score >= 100",
        "window.__3D_STATE__.totalInteractions >= 5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.passCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.passEnabled) && window.__3D_STATE__.passEnabled.length === 5 && window.__3D_STATE__.passEnabled.every(v => v === true)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.passRenderTimes) && window.__3D_STATE__.passRenderTimes.length === 5 && window.__3D_STATE__.passRenderTimes.every(t => typeof t === 'number' && !isNaN(t) && t >= 0)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.score === 0 && window.__3D_STATE__.totalInteractions === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectRotations) && window.__3D_STATE__.objectRotations.length === 5 && window.__3D_STATE__.objectRotations.every(r => typeof r === 'number' && isFinite(r))",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.passEnabled[1] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePassCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passRenderTimes[1] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInteractions === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRenderTime === window.__3D_STATE__.passRenderTimes.reduce((a,b) => a+b, 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.passEnabled[3] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passEnabled[1] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePassCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passRenderTimes[3] === 0 && window.__3D_STATE__.passRenderTimes[1] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S5",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.soloMode !== 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soloModeIndex >= 0 && window.__3D_STATE__.soloModeIndex <= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soloModesVisited.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 35",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.soloMode === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectRotations.every(r => typeof r === 'number' && isFinite(r))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.soloMode !== 'None'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const before = window.__3D_STATE__.objectRotations.slice(); await new Promise(r => setTimeout(r, 500)); window.__testRotationFrozen = before.every((v, i) => Math.abs(v - window.__3D_STATE__.objectRotations[i]) < 0.001);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__testRotationFrozen === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectRotations.every(r => !isNaN(r) && isFinite(r))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passRenderTimes.every(t => !isNaN(t) && t !== Infinity && t !== -Infinity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.isPaused = false; const sliders = document.querySelectorAll('input[type=range]'); if(sliders.length >= 1) { const s = sliders[0]; const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(s, '0.5'); s.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blendWeights[0] === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeights.some(w => w > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeights.every(w => w >= 0 && w <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score > 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInteractions >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.passEnabled.every(v => v === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePassCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeights.every(w => w === 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passRenderTimes.every(t => typeof t === 'number' && t >= 0 && !isNaN(t))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRenderTime >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const modes = ['Geometry','Depth','Normal','Wireframe','Composite']; for(let i = 0; i < 6; i++) { document.dispatchEvent(new KeyboardEvent('keydown', {key: 's', bubbles: true})); await new Promise(r => setTimeout(r, 200)); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.soloModesVisited.length >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allSolosBonusAwarded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 100",
            "tier": "L2"
          },
          {
            "expr": "['Geometry','Depth','Normal','Wireframe','Composite'].every(m => window.__3D_STATE__.soloModesVisited.includes(m))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInteractions >= 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '1', bubbles: true})); await new Promise(r => setTimeout(r, 100)); document.dispatchEvent(new KeyboardEvent('keydown', {key: '3', bubbles: true})); await new Promise(r => setTimeout(r, 100)); document.dispatchEvent(new KeyboardEvent('keydown', {key: '5', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInteractions >= 11",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scoringEvents.length <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scoringEvents.every(e => typeof e.description === 'string' && typeof e.points === 'number')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePassCount === window.__3D_STATE__.passEnabled.filter(v => v === true).length",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score >= 0 && !isNaN(window.__3D_STATE__.score)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}