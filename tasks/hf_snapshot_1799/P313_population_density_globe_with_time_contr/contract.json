{
  "task_id": "P313_population_density_globe_with_time_contr",
  "affordances": [
    {
      "id": "A1",
      "name": "Globe",
      "type": "3d_object",
      "semantic": "Earth sphere with population density bars",
      "locator_hints": [
        "blue sphere at origin",
        "radius 5"
      ]
    },
    {
      "id": "A2",
      "name": "PopulationBars",
      "type": "3d_object",
      "semantic": "Extruded bars representing population density per country",
      "locator_hints": [
        "colored bars on globe surface"
      ]
    },
    {
      "id": "A3",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Range slider to select time period (1990/2010/2030)",
      "locator_hints": [
        "#timeSlider"
      ]
    },
    {
      "id": "A4",
      "name": "YearLabel",
      "type": "dom_element",
      "semantic": "Label showing current selected year",
      "locator_hints": [
        "#yearLabel"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleRotation",
      "type": "dom_element",
      "semantic": "Button to toggle auto-rotation",
      "locator_hints": [
        "#toggleRotation"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleBars",
      "type": "dom_element",
      "semantic": "Button to toggle bar visibility",
      "locator_hints": [
        "#toggleBars"
      ]
    },
    {
      "id": "A7",
      "name": "TotalPopulation",
      "type": "dom_element",
      "semantic": "Display showing total population sum",
      "locator_hints": [
        "#totalPopulation"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState_1990_AutoRotate",
      "conditions": [
        "window.__3D_STATE__.currentYear === 'year_1990'",
        "window.__3D_STATE__.autoRotation === true",
        "window.__3D_STATE__.barsVisible === true",
        "window.__3D_STATE__.barCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "Year2010Selected",
      "conditions": [
        "window.__3D_STATE__.currentYear === 'year_2010'",
        "window.__3D_STATE__.barsVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "Year2030Selected",
      "conditions": [
        "window.__3D_STATE__.currentYear === 'year_2030'"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRotationOff",
      "conditions": [
        "window.__3D_STATE__.autoRotation === false"
      ]
    },
    {
      "id": "S4",
      "name": "BarsHidden",
      "conditions": [
        "window.__3D_STATE__.barsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "BarsRestoredYear2030",
      "conditions": [
        "window.__3D_STATE__.barsVisible === true",
        "window.__3D_STATE__.currentYear === 'year_2030'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.1990 !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.2010 !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.2030 !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 1; document.getElementById('timeSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('yearLabel').textContent.includes('2010')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 2; document.getElementById('timeSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('yearLabel').textContent.includes('2030')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleRotation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBars"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBars"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}