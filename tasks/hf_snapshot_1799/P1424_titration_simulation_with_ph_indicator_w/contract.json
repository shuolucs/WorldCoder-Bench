          },
          {
            "expr": "window.__3D_STATE__.volumeAdded === window.__3D_STATE__.dropCount * 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.buretteLevel - (50 - window.__3D_STATE__.volumeAdded)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles >= 0 && !isNaN(window.__3D_STATE__.activeParticles)",
