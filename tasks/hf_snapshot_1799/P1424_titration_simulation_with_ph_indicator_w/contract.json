      "locator_hints": [
        "#btn-auto-titrate"
      ]
    },
    {
      "id": "A9",
      "name": "pHStripBar",
      "type": "dom_element",
      "semantic": "Vertical gradient bar on right showing current pH marker",
      "locator_hints": [
        "pH strip",
        "vertical bar right"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.pH >= 0.9 && window.__3D_STATE__.pH <= 1.1",
        "window.__3D_STATE__.volumeAdded === 0",
        "window.__3D_STATE__.stopcockOpen === false",
        "window.__3D_STATE__.dropCount === 0",
        "window.__3D_STATE__.indicatorState === 'colorless'",
        "window.__3D_STATE__.buretteLevel === 50"
      ]
    },
    {
      "id": "S1",
      "name": "StopcockOpened",
      "conditions": [
        "window.__3D_STATE__.stopcockOpen === true"
      ]
    },
    {
      "id": "S2",
      "name": "FirstDropAdded",
      "conditions": [
        "window.__3D_STATE__.dropCount === 1",
        "window.__3D_STATE__.volumeAdded === 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "MultipleDropsAdded",
      "conditions": [
        "window.__3D_STATE__.dropCount > 1",
        "window.__3D_STATE__.pH > 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "StirrerActive",
      "conditions": [
        "window.__3D_STATE__.stirrerOn === true"
      ]
    },
    {
      "id": "S5",
      "name": "DropRateAdjusted",
      "conditions": [
        "window.__3D_STATE__.dropRate !== 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "NearEquivalence",
      "conditions": [
        "window.__3D_STATE__.pH >= 3.0 && window.__3D_STATE__.pH <= 6.5"
      ]
    },
    {
      "id": "S7",
      "name": "EquivalenceReached",
      "conditions": [
        "window.__3D_STATE__.equivalenceReached === true",
        "window.__3D_STATE__.equivalenceBurstFired === true"
      ]
    },
    {
      "id": "S8",
      "name": "PastEquivalence",
      "conditions": [
        "window.__3D_STATE__.pH > 8.2",
        "window.__3D_STATE__.indicatorState !== 'colorless'"
      ]
    },
    {
      "id": "S9",
      "name": "AutoTitrateComplete",
      "conditions": [
        "window.__3D_STATE__.autoTitrating === false",
        "window.__3D_STATE__.equivalenceReached === true"
      ]
    },
    {
      "id": "S10",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.resetCount > 0",
        "window.__3D_STATE__.dropCount === 0",
        "window.__3D_STATE__.volumeAdded === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.pH === 'number' && !isNaN(window.__3D_STATE__.pH)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.volumeAdded === 'number' && window.__3D_STATE__.volumeAdded === 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.molesHClRemaining === 'number' && Math.abs(window.__3D_STATE__.molesHClRemaining - 0.005) < 1e-7",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stopcockOpen === false && window.__3D_STATE__.stirrerOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.buretteLevel === 50 && window.__3D_STATE__.dropCount === 0 && window.__3D_STATE__.indicatorState === 'colorless'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-single-drop"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dropCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.volumeAdded - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.buretteLevel - 49.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.molesNaOHAdded - 0.00005) < 1e-8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.molesHClRemaining - 0.00495) < 1e-7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVolume === 50 + window.__3D_STATE__.volumeAdded",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
