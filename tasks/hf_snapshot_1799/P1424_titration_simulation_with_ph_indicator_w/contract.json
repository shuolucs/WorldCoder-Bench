        "checks": [
          {
            "expr": "window.__3D_STATE__.stopcockOpen === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dropRate === 0.8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastDropTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dropCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
