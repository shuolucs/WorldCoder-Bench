      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var ferrari = window.__3D_STATE__._ferrariObject || document.querySelector('canvas'); if(ferrari && ferrari.dispatchEvent) { var rect = document.querySelector('canvas').getBoundingClientRect(); var cx = rect.left + rect.width * 0.85; var cy = rect.top + rect.height * 0.6; document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true})); } else { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth * 0.85, clientY: window.innerHeight * 0.6, bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ligandPresetIndex >= 0",
            "tier": "L2"
          },
          {
