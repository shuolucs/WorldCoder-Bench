            "expr": "window.__3D_STATE__.orbitalPositions.dx2y2 > window.__3D_STATE__.orbitalPositions.dz2 - 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.orbitalPositions.dxy < window.__3D_STATE__.orbitalPositions.dx2y2",
