        "type": "script",
        "code": "const state = window.__3D_STATE__; const dx = Math.abs(state.robotPosition.x - (-6)); const dz = Math.abs(state.robotPosition.z - (-6)); function pressKey(k){document.dispatchEvent(new KeyboardEvent('keydown',{key:k}));document.dispatchEvent(new KeyboardEvent('keyup',{key:k}));} async function navigate(){const targetX=-6;const targetZ=-6;while(state.robotPosition.x>targetX){pressKey('ArrowLeft');await new Promise(r=>setTimeout(r,400));}while(state.robotPosition.z>targetZ){pressKey('ArrowUp');await new Promise(r=>setTimeout(r,400));}} navigate();"
      },
