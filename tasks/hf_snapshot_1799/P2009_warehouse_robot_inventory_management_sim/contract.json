            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.z - (-6)) <= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.canPickup === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDistance >= 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.robotPosition.x) && !isNaN(window.__3D_STATE__.robotPosition.z)",
            "tier": "L2"
          }
        ]
