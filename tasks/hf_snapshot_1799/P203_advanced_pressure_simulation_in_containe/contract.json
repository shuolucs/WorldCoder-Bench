  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.pistonY === 4",
        "window.__3D_STATE__.particleCount === 100",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "FishLoaded",
      "conditions": [
        "window.__3D_STATE__.fishLoaded === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PistonCompressed",
      "conditions": [
        "window.__3D_STATE__.pistonY < 4",
        "window.__3D_STATE__.pressure > window.__3D_STATE__._prevPressure || window.__3D_STATE__.pressure > 0"
      ]
    },
    {
      "id": "S3",
      "name": "HighPressure",
      "conditions": [
        "window.__3D_STATE__.pressure > 5.0",
        "window.__3D_STATE__.score >= 10"
      ]
    },
    {
      "id": "S4",
      "name": "Heated",
      "conditions": [
        "window.__3D_STATE__.temperature > 300"
      ]
    },
    {
      "id": "S5",
      "name": "Cooled",
      "conditions": [
        "window.__3D_STATE__.temperature < 300"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesAdded",
      "conditions": [
        "window.__3D_STATE__.particleCount > 100"
      ]
    },
    {
      "id": "S7",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S8",
      "name": "ValveReleased",
      "conditions": [
        "window.__3D_STATE__.pistonY === 4"
      ]
    },
    {
      "id": "S9",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.pistonY === 4",
        "window.__3D_STATE__.particleCount === 100"
      ]
