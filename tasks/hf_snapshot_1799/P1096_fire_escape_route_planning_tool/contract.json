        "code": "document.getElementById('btn-floor-1').click(); setTimeout(() => { document.getElementById('btn-route-mode').click(); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const positions = [[0.6, 0.55], [0.55, 0.6], [0.5, 0.65], [0.15, 0.5]]; let delay = 0; positions.forEach(p => { setTimeout(() => { const evt = new MouseEvent('click', {clientX: rect.left + rect.width * p[0], clientY: rect.top + rect.height * p[1], bubbles: true}); canvas.dispatchEvent(evt); }, delay); delay += 200; }); }, 200); }, 200);",
