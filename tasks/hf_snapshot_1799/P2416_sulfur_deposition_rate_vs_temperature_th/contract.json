          },
          {
            "expr": "window.__3D_STATE__.temperatureK === 303.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rateConstant - 1e10 * Math.exp(-50000 / (8.314 * 303.15))) < 1e-6 * window.__3D_STATE__.rateConstant",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flameHeight > 0.2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rateConstant)",
            "tier": "L2"
          }
        ]
