  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.turbidity === 0",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.temperature === 25"
      ]
    },
    {
      "id": "S1",
      "name": "Reaction_Running_Default_Temp",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.turbidity >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "Turbidity_Accumulating",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.turbidity > 0",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Temperature_Raised",
      "conditions": [
        "window.__3D_STATE__.temperature > 25",
        "window.__3D_STATE__.rateConstant > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Debug_Visible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "Data_Point_Recorded",
      "conditions": [
        "window.__3D_STATE__.dataPoints.length > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Graph_Visible",
      "conditions": [
        "window.__3D_STATE__.graphVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Cross_Partially_Hidden",
      "conditions": [
        "window.__3D_STATE__.crossOpacity < 1.0",
        "window.__3D_STATE__.turbidity > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.undoStack.length > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStack.length === 0"
      ]
    },
    {
      "id": "S10",
      "name": "Experiment_Reset",
      "conditions": [
        "window.__3D_STATE__.turbidity === 0",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.crossOpacity === 1.0"
      ]
    },
    {
      "id": "S11",
      "name": "High_Temp_Fast_Reaction",
      "conditions": [
        "window.__3D_STATE__.temperature >= 60",
        "window.__3D_STATE__.isRunning === true"
      ]
    }
  ],
