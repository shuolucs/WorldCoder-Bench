        "text_match": "Start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rateConstant === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rateConstant)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rateConstant > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 25",
            "tier": "L2"
          }
        ]
