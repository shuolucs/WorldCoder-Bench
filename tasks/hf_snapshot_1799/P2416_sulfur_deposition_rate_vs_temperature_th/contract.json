            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.turbidity > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.turbidity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === Math.min(Math.floor(window.__3D_STATE__.turbidity / 2), 500)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dTurbidityPerSec === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dTurbidityPerSec > 0",
            "tier": "L2"
          }
        ]
