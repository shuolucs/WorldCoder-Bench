  "states": [
    {
      "id": "S0",
      "name": "Initial_Aiming",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.holeSunk === false"
      ]
    },
    {
      "id": "S1",
      "name": "Aim_Rotated",
      "conditions": [
        "window.__3D_STATE__.aimAngle !== 0",
        "window.__3D_STATE__.gamePhase === 'aiming'"
      ]
    },
    {
      "id": "S2",
      "name": "Charging_Power",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'charging'",
        "window.__3D_STATE__.power > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Ball_Rolling",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'rolling'",
        "window.__3D_STATE__.ballMoving === true",
        "window.__3D_STATE__.strokeCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "Ball_Stopped",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.strokeCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Ball_Reset_To_Tee",
      "conditions": [
        "Math.abs(window.__3D_STATE__.ballPosition.z - 4.5) < 0.5",
        "window.__3D_STATE__.ballMoving === false"
      ]
    },
    {
      "id": "S6",
      "name": "Hole_Sunk",
      "conditions": [
        "window.__3D_STATE__.holeSunk === true",
        "window.__3D_STATE__.gamePhase === 'sunk'"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Restarted",
      "conditions": [
        "window.__3D_STATE__.strokeCount === 0",
        "window.__3D_STATE__.holeSunk === false",
        "window.__3D_STATE__.gamePhase === 'aiming'"
      ]
    }
  ],
