      "conditions": [
        "window.__3D_STATE__.caseColor === '#3498db'",
        "window.__3D_STATE__.debugMode === false",
        "window.__3D_STATE__.pattern === 'solid'",
        "window.__3D_STATE__.spinning === false",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#e74c3c'"
      ]
    },
    {
      "id": "S2",
      "name": "DebugEnabled",
      "conditions": [
        "window.__3D_STATE__.debugMode === true",
        "window.__3D_STATE__.wireframe === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpinningActive",
      "conditions": [
        "window.__3D_STATE__.spinning === true"
      ]
    },
    {
      "id": "S4",
      "name": "PatternChanged",
      "conditions": [
        "window.__3D_STATE__.pattern === 'stripes'"
      ]
    },
    {
      "id": "S5",
      "name": "DebugDisabled",
      "conditions": [
        "window.__3D_STATE__.debugMode === false",
        "window.__3D_STATE__.wireframe === false"
      ]
    }
  ],
