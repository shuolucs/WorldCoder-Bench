  "states": [
    {
      "id": "S0",
      "name": "InitialNaClEquilibrium",
      "conditions": [
        "window.__3D_STATE__.compound === 'NaCl'",
        "Math.abs(window.__3D_STATE__.scaleFactor - 1.0) < 0.001",
        "window.__3D_STATE__.latticeEnergy < 0",
        "window.__3D_STATE__.latticeDims.x === 3 && window.__3D_STATE__.latticeDims.y === 3 && window.__3D_STATE__.latticeDims.z === 3"
      ]
    },
    {
      "id": "S1",
      "name": "LatticeCompressed",
      "conditions": [
        "window.__3D_STATE__.scaleFactor < 1.0",
        "window.__3D_STATE__.latticeEnergy > window.__3D_STATE__.equilibriumEnergy"
      ]
    },
    {
      "id": "S2",
      "name": "LatticeExpanded",
      "conditions": [
        "window.__3D_STATE__.scaleFactor > 1.0",
        "window.__3D_STATE__.latticeEnergy > window.__3D_STATE__.equilibriumEnergy"
      ]
    },
    {
      "id": "S3",
      "name": "ResetToEquilibrium",
      "conditions": [
        "Math.abs(window.__3D_STATE__.scaleFactor - 1.0) < 0.001",
        "Math.abs(window.__3D_STATE__.latticeEnergy - window.__3D_STATE__.equilibriumEnergy) < 0.5"
      ]
    },
    {
      "id": "S4",
      "name": "CompoundChangedToMgO",
      "conditions": [
        "window.__3D_STATE__.compound === 'MgO'",
        "window.__3D_STATE__.chargeProduct === 4"
      ]
    },
    {
      "id": "S5",
      "name": "GridToggled",
      "conditions": [
        "window.__3D_STATE__.gridVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "EnergyPlotShown",
      "conditions": [
        "window.__3D_STATE__.energyPlotVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "LatticeSizeIncreased",
      "conditions": [
        "window.__3D_STATE__.latticeDims.x === 4 && window.__3D_STATE__.latticeDims.y === 4 && window.__3D_STATE__.latticeDims.z === 4"
      ]
    },
    {
      "id": "S8",
      "name": "LatticeSizeDecreased",
      "conditions": [
        "window.__3D_STATE__.latticeDims.x === 3 && window.__3D_STATE__.latticeDims.y === 3 && window.__3D_STATE__.latticeDims.z === 3"
      ]
    },
    {
      "id": "S9",
      "name": "CompoundChangedToKCl",
      "conditions": [
        "window.__3D_STATE__.compound === 'KCl'",
        "window.__3D_STATE__.bornExponent === 9"
      ]
    },
    {
      "id": "S10",
      "name": "IonSelected",
      "conditions": [
        "window.__3D_STATE__.selectedIon !== null",
        "typeof window.__3D_STATE__.selectedIon.type === 'string'"
      ]
    },
    {
      "id": "S11",
      "name": "CaOCompressedChained",
      "conditions": [
        "window.__3D_STATE__.compound === 'CaO'",
        "window.__3D_STATE__.scaleFactor < 1.0",
        "window.__3D_STATE__.latticeEnergy > window.__3D_STATE__.equilibriumEnergy"
      ]
    }
