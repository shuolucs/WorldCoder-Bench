        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.atomPositions) && window.__3D_STATE__.atomPositions.length === 4",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bondLengths) && window.__3D_STATE__.bondLengths.length === 3",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.dihedralAngle === 'number' && !isNaN(window.__3D_STATE__.dihedralAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dihedralAngle >= -180 && window.__3D_STATE__.dihedralAngle <= 180",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
