  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "typeof window.__3D_STATE__ === 'object'",
        "window.__3D_STATE__.atomPositions.length === 4",
        "window.__3D_STATE__.measurementVisible === true",
        "window.__3D_STATE__.isDragging === false",
        "window.__3D_STATE__.animating === false",
        "window.__3D_STATE__.angleStepCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "EclipsedPreset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.dihedralAngle) < 10",
        "window.__3D_STATE__.conformationName === 'Eclipsed'"
      ]
    },
    {
      "id": "S2",
      "name": "GauchePreset",
      "conditions": [
        "window.__3D_STATE__.dihedralAngle > 50 && window.__3D_STATE__.dihedralAngle < 70",
        "window.__3D_STATE__.conformationName === 'Gauche+'"
      ]
    },
    {
      "id": "S3",
      "name": "AntiPreset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.dihedralAngle) > 170",
        "window.__3D_STATE__.conformationName === 'Anti'"
      ]
    },
    {
      "id": "S4",
      "name": "CustomPreset",
      "conditions": [
        "window.__3D_STATE__.dihedralAngle > -100 && window.__3D_STATE__.dihedralAngle < -80",
        "window.__3D_STATE__.conformationName === 'Custom'"
      ]
    },
    {
      "id": "S5",
      "name": "AngleIncremented",
      "conditions": [
        "window.__3D_STATE__.angleStepCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AngleDecremented",
      "conditions": [
        "window.__3D_STATE__.angleStepCount < 0"
      ]
    },
    {
      "id": "S7",
      "name": "MeasurementHidden",
      "conditions": [
        "window.__3D_STATE__.measurementVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "MeasurementRestored",
      "conditions": [
        "window.__3D_STATE__.measurementVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.angleStepCount === 0",
        "window.__3D_STATE__.measurementVisible === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
