  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "4 个关节角度存在且有限",
        "ikEnabled=true",
        "armLength ≈ 4.5",
        "effectorPos 与 targetPos 坐标有限",
        "reachable 是布尔值"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.jointAngles) && window.__3D_STATE__.jointAngles.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.jointAngles.every(function(a){ return isFinite(a) && !Number.isNaN(a); })",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.targetPos.x) && isFinite(window.__3D_STATE__.targetPos.y) && isFinite(window.__3D_STATE__.targetPos.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "正运动学验证：effectorPos 到原点距离 ≤ armLength（不能超过臂展）",
        "effectorPos 不在原点（臂不是折叠的零长度）",
        "effectorPos.y >= 0（机械臂不穿地面）"
      ],
      "severity": "P0",
      "_note": "严格 FK 几何检查：末端不能比臂长更远，不能穿地面，不能缩到原点",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ if(typeof window.__moveTarget==='function'){window.__moveTarget(1.5,2.0,1.0);} else { var s=window.__3D_STATE__; if(s&&s.targetPos){s.targetPos.x=1.5;s.targetPos.y=2.0;s.targetPos.z=1.0;}} })()",
        "wait_ms": 3000
      },
      "postconditions": [
        "IK 收敛：末端执行器距离目标 (1.5,2.0,1.0) < 0.5",
        "关节角度全部在 [-π, π] 范围"
      ],
      "severity": "P0",
      "_note": "关键 IK 精度检查：目标在可达范围内（距原点约 2.69），3s 内必须收敛到 0.5 以内",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.jointAngles.every(function(a){return a>=-Math.PI-0.01&&a<=Math.PI+0.01;})",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ if(typeof window.__moveTarget==='function'){window.__moveTarget(2.0,1.0,2.0);} else { var s=window.__3D_STATE__; if(s&&s.targetPos){s.targetPos.x=2.0;s.targetPos.y=1.0;s.targetPos.z=2.0;}} })()",
        "wait_ms": 3000
      },
      "postconditions": [
        "IK 再次收敛到新目标 (2.0,1.0,2.0)，距离 < 0.5",
        "effectorPos 相对之前有明显变化",
        "关节角度与 before 不同（至少 2 个角度变化 > 0.05）"
      ],
      "severity": "P0",
      "_note": "第二次 IK 目标切换：验证 IK 能持续追踪不同目标，而非只停在第一个位置",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(function(){ var a=window.__3D_STATE__.jointAngles; var b=before.jointAngles; if(!b) return true; var changed=0; for(var i=0;i<4;i++){if(Math.abs(a[i]-b[i])>0.05)changed++;} return changed>=2; })()",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
