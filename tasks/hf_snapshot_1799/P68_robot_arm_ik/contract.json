        "code": "(function(){ var el=document.getElementById('ikToggle'); if(el){el.checked=false; el.dispatchEvent(new Event('change',{bubbles:true})); el.dispatchEvent(new Event('input',{bubbles:true})); el.click&&el.click();} })()",
