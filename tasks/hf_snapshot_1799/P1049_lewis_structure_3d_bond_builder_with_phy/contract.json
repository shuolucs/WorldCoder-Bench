      ]
    },
    {
      "id": "A8",
      "name": "DebugOverlayPanel",
      "type": "dom_element",
      "semantic": "Physics debug info panel in top-right corner",
      "locator_hints": [
        "div.debug-overlay",
        "#debug-panel",
        "top-right positioned div"
      ]
    },
    {
      "id": "A9",
      "name": "ValidationPanel",
      "type": "dom_element",
      "semantic": "Electron counting validation panel bottom-left",
      "locator_hints": [
        "div.validation-panel",
        "#validation",
        "bottom-left positioned div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "EmptyScene",
      "conditions": [
        "window.__3D_STATE__.atomCount === 0",
        "window.__3D_STATE__.bondCount === 0",
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "SingleCarbonAdded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 1",
        "window.__3D_STATE__.atoms[0].element === 'C'",
        "window.__3D_STATE__.atoms[0].valenceElectrons === 4"
      ]
    },
    {
      "id": "S2",
      "name": "TwoAtomsPresent",
      "conditions": [
        "window.__3D_STATE__.atomCount === 2",
        "window.__3D_STATE__.bondCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "TwoAtomsSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAtoms.length === 2"
      ]
    },
    {
      "id": "S4",
      "name": "SingleBondCreated",
      "conditions": [
        "window.__3D_STATE__.bondCount === 1",
        "window.__3D_STATE__.bonds[0].order === 1"
      ]
    },
    {
      "id": "S5",
      "name": "DoubleBondCreated",
      "conditions": [
        "window.__3D_STATE__.bondCount === 1",
        "window.__3D_STATE__.bonds[0].order === 2"
      ]
    },
    {
      "id": "S6",
      "name": "DebugOverlayActive",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "PhysicsEquilibrium",
      "conditions": [
        "window.__3D_STATE__.equilibrium === true",
        "window.__3D_STATE__.totalKineticEnergy < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "PhysicsReset",
      "conditions": [
        "window.__3D_STATE__.totalKineticEnergy === 0"
      ]
    },
    {
      "id": "S9",
      "name": "SceneCleared",
      "conditions": [
        "window.__3D_STATE__.atomCount === 0",
        "window.__3D_STATE__.bondCount === 0",
        "window.__3D_STATE__.atoms.length === 0",
        "window.__3D_STATE__.bonds.length === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Add C"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.atoms !== 'undefined' && Array.isArray(window.__3D_STATE__.atoms)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[0].element === 'C'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[0].valenceElectrons === 4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].position.y) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.atoms[0].position.x) && !isNaN(window.__3D_STATE__.atoms[0].position.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Add H"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[1].element === 'H'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[1].valenceElectrons === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[1].position.y === 0 || Math.abs(window.__3D_STATE__.atoms[1].position.y) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.atoms[1].position.x**2 + window.__3D_STATE__.atoms[1].position.z**2) <= 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedAtoms = [window.__3D_STATE__.atoms[0].id, window.__3D_STATE__.atoms[1].id];"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAtoms.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtoms[0] === window.__3D_STATE__.atoms[0].id",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtoms[1] === window.__3D_STATE__.atoms[1].id",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedAtoms[0] !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bondCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds[0].order === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds[0].atom1Id === window.__3D_STATE__.atoms[0].id || window.__3D_STATE__.bonds[0].atom2Id === window.__3D_STATE__.atoms[0].id",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[0].bondedElectrons === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[1].bondedElectrons === 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalPotentialEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bondCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds[0].order === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[0].bondedElectrons === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[1].bondedElectrons === 4 || window.__3D_STATE__.atoms[1].bondedElectrons === 2",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy) && isFinite(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalKineticEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalPotentialEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalPotentialEnergy)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalKineticEnergy) && isFinite(window.__3D_STATE__.totalPotentialEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.equilibrium === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.atoms[0].position.x)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.atoms[1].position.x)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].position.y) < 0.01 && Math.abs(window.__3D_STATE__.atoms[1].position.y) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Reset Physics"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].velocity.x) < 0.001 && Math.abs(window.__3D_STATE__.atoms[0].velocity.y) < 0.001 && Math.abs(window.__3D_STATE__.atoms[0].velocity.z) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[1].velocity.x) < 0.001 && Math.abs(window.__3D_STATE__.atoms[1].velocity.y) < 0.001 && Math.abs(window.__3D_STATE__.atoms[1].velocity.z) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Clear"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bonds.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtoms.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.physicsEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.octetSatisfied === 'object'",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}