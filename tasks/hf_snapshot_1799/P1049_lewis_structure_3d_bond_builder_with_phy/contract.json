{
  "task_id": "P1049_lewis_structure_3d_bond_builder_with_phy",
  "affordances": [
    {
      "id": "A1",
      "name": "AddCarbonButton",
      "type": "dom_element",
      "semantic": "Button to add a carbon atom to the scene",
