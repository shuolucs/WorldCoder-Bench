        ".toolbar button:nth-child(4)"
      ]
    },
    {
      "id": "A3",
      "name": "AddOxygenButton",
      "type": "dom_element",
      "semantic": "Button to add an oxygen atom to the scene",
      "locator_hints": [
        "button:contains('Add O')",
