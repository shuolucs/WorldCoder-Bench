  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "postconditions": [
        "particleCount、explosionCount、simTime 有限"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "!Number.isNaN(window.__3D_STATE__.particleCount) && !Number.isNaN(window.__3D_STATE__.explosionCount) && isFinite(window.__3D_STATE__.simTime)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "click",
        "target": "canvas",
        "position": {
          "x": 0.5,
          "y": 0.22
        }
      },
      "postconditions": [
        "约 2s 后 explosionCount>0 且 particleCount>50"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 2000,
        "checks": [
          {
            "expr": "window.__3D_STATE__.explosionCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "window.__SPREAD0__ = (function(){ var ps=window.__3D_STATE__.particles||[]; if(!ps.length) return { avgD: 0, n: 0, cx: 0, cy: 0, cz: 0 }; var cx=0,cy=0,cz=0; for(var i=0;i<ps.length;i++){ cx+=ps[i].x; cy+=ps[i].y; cz+=ps[i].z; } cx/=ps.length; cy/=ps.length; cz/=ps.length; var ad=0; for(var j=0;j<ps.length;j++){ ad+=Math.hypot(ps[j].x-cx, ps[j].y-cy, ps[j].z-cz); } ad/=ps.length; return { avgD: ad, n: ps.length, cx: cx, cy: cy, cz: cz }; })();",
        "wait_ms": 1000
      },
      "postconditions": [
        "爆炸后 1s 内：相对质心平均距离严格增大（外向扩散）",
        "记录 __COMY_REF__ 供重力检查"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "postconditions": [
        "重力：粒子质心 Y 低于 SPREAD 结束时的 __COMY_REF__",
        "或相对 transition 开始时 particles 质心 Y 下降"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "淡出移除：particleCount 明显低于本段开始前"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount < before.particleCount * 0.65",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "click",
        "target": "canvas",
        "position": {
          "x": 0.28,
          "y": 0.36
        }
      },
      "postconditions": [
        "新爆炸 explosionCount 增加",
        "particles 中至少 3 种颜色值"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 2200,
        "checks": [
          {
            "expr": "window.__3D_STATE__.explosionCount > before.explosionCount",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "eval",
        "code": "window.__PRE_AUTO_PART__ = window.__3D_STATE__.particleCount; window.__PRE_AUTO_EXP__ = window.__3D_STATE__.explosionCount; document.getElementById('autoBtn').click();",
        "wait_ms": 6000
      },
      "postconditions": [
        "自动发射：6s 内 explosionCount 至少 +2 且 particleCount 相对开启前增加（周期性补充）"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.explosionCount >= window.__PRE_AUTO_EXP__ + 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > window.__PRE_AUTO_PART__",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "dom_click",
        "selector": "#clearBtn"
      },
      "postconditions": [
        "清除后 totalParticles / particleCount → 0"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "action": {
        "type": "eval",
        "code": "document.getElementById('autoBtn').click();",
        "wait_ms": 60000
      },
      "postconditions": [
        "60s 后无 NaN，simTime 有限，爆炸次数持续增长"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.particleCount) && !Number.isNaN(window.__3D_STATE__.particleCount)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.explosionCount) && !Number.isNaN(window.__3D_STATE__.explosionCount)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.simTime) && !Number.isNaN(window.__3D_STATE__.simTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explosionCount > 8",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "action": {
        "type": "wait",
        "duration_ms": 400
      },
      "postconditions": [
        "HUD particleCount 与 __3D_STATE__ 一致（若存在）"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
