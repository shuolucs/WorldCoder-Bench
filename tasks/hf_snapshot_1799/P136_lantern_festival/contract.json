          {
            "expr": "window.__3D_STATE__.lanternCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clickedLanternId >= 0 || window.__3D_STATE__.clickedLanternId === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
