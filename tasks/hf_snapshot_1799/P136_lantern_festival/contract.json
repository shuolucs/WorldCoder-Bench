            "expr": "Array.isArray(window.__3D_STATE__.lanternHeights) && window.__3D_STATE__.lanternHeights.length === 20",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.lanternCount)",
            "tier": "L2"
          },
