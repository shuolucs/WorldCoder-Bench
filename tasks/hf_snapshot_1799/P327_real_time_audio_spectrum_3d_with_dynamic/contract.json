        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "RunningDifficulty1",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Difficulty3Set",
      "conditions": [
