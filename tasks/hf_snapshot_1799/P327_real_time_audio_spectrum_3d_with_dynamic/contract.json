  "affordances": [
    {
      "id": "A1",
      "name": "ShoeModel",
      "type": "3d_object",
      "semantic": "Central GLTF shoe model that rotates",
      "locator_hints": [
        "scene.children with gltf",
        "window.__3D_STATE__.shoeLoaded"
      ]
    },
    {
      "id": "A2",
