      "type": "3d_object",
      "semantic": "64 bars arranged in a circle reacting to simulated audio",
      "locator_hints": [
        "window.__3D_STATE__.barCount === 64"
      ]
    },
    {
      "id": "A3",
      "name": "ParticleSystem",
