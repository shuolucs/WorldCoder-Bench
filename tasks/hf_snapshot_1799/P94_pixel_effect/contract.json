      ]
    },
    {
      "id": "A4",
      "name": "NormalModeSelect",
      "type": "dom_element",
      "semantic": "法线模式",
      "locator_hints": [
        "normalModeSelect"
      ]
    },
    {
      "id": "A5",
      "name": "ColorLimitSlider",
      "type": "dom_element",
      "semantic": "颜色数量限制",
      "locator_hints": [
        "colorLimitSlider"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "默认后期"
    },
    {
      "id": "S1",
      "name": "init_verified",
      "description": "校验"
    },
    {
      "id": "S2",
      "name": "pixel_large",
      "description": "大块像素"
    },
    {
      "id": "S3",
      "name": "edge_on",
      "description": "边缘开"
    },
    {
      "id": "S4",
      "name": "normal_mode",
      "description": "切换法线模式"
    },
    {
      "id": "S5",
      "name": "color_limit",
      "description": "色阶变化"
    },
    {
      "id": "S6",
      "name": "edge_off",
      "description": "边缘关"
    },
    {
      "id": "S7",
      "name": "stable",
      "description": "稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "postconditions": [
        "objectCount=5，控件齐全"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.pixelSize)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.normalMode === 'string' && window.__3D_STATE__.normalMode.length > 0",
            "tier": "L0"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.colorLimit)",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.fps)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pixelSizeSlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('edgeToggle') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('normalModeSelect') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('colorLimitSlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pixelSize >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ var s=document.getElementById('pixelSizeSlider'); if(s){ var hi=parseFloat(s.max)||32; s.value=String(hi*0.9); s.dispatchEvent(new Event('input',{bubbles:true})); } })()",
        "wait_ms": 300
      },
      "postconditions": [
        "pixelSize 变化"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pixelSize !== before.pixelSize",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pixelSize > before.pixelSize",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ var cb=document.getElementById('edgeToggle'); if(cb){ cb.checked=true; cb.dispatchEvent(new Event('change',{bubbles:true})); } })()",
        "wait_ms": 250
      },
      "postconditions": [
        "edgeEnabled true"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.edgeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeEnabled !== before.edgeEnabled",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.pixelSize !== before.pixelSize",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "eval",
        "code": "(function(){ var sel=document.getElementById('normalModeSelect'); if(sel && sel.options && sel.options.length>1){ sel.selectedIndex = (sel.selectedIndex+1)%sel.options.length; sel.dispatchEvent(new Event('change',{bubbles:true})); } })()",
        "wait_ms": 300
      },
      "postconditions": [
        "normalMode 变化"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.normalMode !== before.normalMode",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "eval",
        "code": "(function(){ var s=document.getElementById('colorLimitSlider'); if(s){ var hi=parseFloat(s.max)||64; s.value=String(Math.max(parseFloat(s.min)||4, hi*0.5)); s.dispatchEvent(new Event('input',{bubbles:true})); } })()",
        "wait_ms": 300
      },
      "postconditions": [
        "colorLimit 更新"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorLimit !== before.colorLimit",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.colorLimit)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "eval",
        "code": "(function(){ var cb=document.getElementById('edgeToggle'); if(cb){ cb.checked=false; cb.dispatchEvent(new Event('change',{bubbles:true})); } })()",
        "wait_ms": 250
      },
      "postconditions": [
        "edge 关"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.edgeEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeEnabled !== before.edgeEnabled",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "eval",
        "code": "(function(){ var s=document.getElementById('pixelSizeSlider'); if(s){ var lo=parseFloat(s.min)||1; s.value=String(lo); s.dispatchEvent(new Event('input',{bubbles:true})); } })()",
        "wait_ms": 300
      },
      "postconditions": [
        "pixelSize 再变"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Number.isFinite(window.__3D_STATE__.pixelSize)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pixelSize !== before.pixelSize",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60s FPS 仍有限"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.fps)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === before.objectCount",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.objectCount)",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}