  "states": [
    {
      "id": "S0",
      "name": "Initial_Sphere",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 0",
        "window.__3D_STATE__.currentShapeName === 'Sphere'",
        "window.__3D_STATE__.morphProgress === 1.0",
        "window.__3D_STATE__.isMorphing === false",
        "window.__3D_STATE__.wireframeEnabled === false"
      ]
    },
    {
      "id": "S1",
      "name": "Morphing_To_Cube",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 1",
        "window.__3D_STATE__.isMorphing === true",
        "window.__3D_STATE__.morphProgress > 0.0 && window.__3D_STATE__.morphProgress < 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "Cube_Complete",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 1",
        "window.__3D_STATE__.currentShapeName === 'Cube'",
        "window.__3D_STATE__.morphProgress === 1.0",
        "window.__3D_STATE__.isMorphing === false"
      ]
    },
    {
      "id": "S3",
      "name": "Wireframe_On",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotation_On",
      "conditions": [
        "window.__3D_STATE__.autoRotation === true"
      ]
    },
    {
      "id": "S5",
      "name": "Color_Changed",
      "conditions": [
        "window.__3D_STATE__.meshColor !== '#00aaff'"
      ]
    },
    {
      "id": "S6",
      "name": "Direct_Shape_Torus",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 2",
        "window.__3D_STATE__.currentShapeName === 'Torus'",
        "window.__3D_STATE__.morphProgress === 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "Prev_Shape_Sphere_Wrap",
      "conditions": [
        "window.__3D_STATE__.currentShapeIndex === 0",
        "window.__3D_STATE__.currentShapeName === 'Sphere'",
        "window.__3D_STATE__.morphProgress === 1.0"
      ]
    }
  ],
