        "contains weight and thickness info"
      ]
    },
    {
      "id": "A10",
      "name": "BackdropModel",
      "type": "3d_object",
      "semantic": "Loaded collision-world.glb model as backdrop",
      "locator_hints": [
        "position near (0, 0, -3)",
        "semi-transparent"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 1",
        "window.__3D_STATE__.darkTheme === true",
        "window.__3D_STATE__.compareMode === false",
        "window.__3D_STATE__.lidAngle === 110"
      ]
    },
    {
      "id": "S1",
      "name": "UltraSlimSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 0",
        "window.__3D_STATE__.specsVisible === 'UltraSlim'"
      ]
    },
    {
      "id": "S2",
      "name": "LidFullyOpen",
      "conditions": [
        "window.__3D_STATE__.lidAngle >= 160"
      ]
    },
    {
      "id": "S3",
      "name": "LidClosed",
      "conditions": [
        "window.__3D_STATE__.lidAngle === 0"
      ]
    },
    {
      "id": "S4",
      "name": "CompareMode",
      "conditions": [
        "window.__3D_STATE__.compareMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "LightTheme",
      "conditions": [
        "window.__3D_STATE__.darkTheme === false"
      ]
    },
    {
      "id": "S6",
      "name": "CreatorEdgeRotated",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 2",
        "Math.abs(window.__3D_STATE__.rotationY) > 0.2"
      ]
    },
    {
      "id": "S7",
      "name": "BackToDefault",
      "conditions": [
        "window.__3D_STATE__.selectedLaptop === 1",
        "window.__3D_STATE__.compareMode === false",
        "window.__3D_STATE__.darkTheme === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
