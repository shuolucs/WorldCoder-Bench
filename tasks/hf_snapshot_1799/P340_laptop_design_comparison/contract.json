            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedLaptop !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lidAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.compareMode === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.darkTheme === 'boolean'",
            "tier": "L0"
