{
  "task_id": "P2375_multiplayer_iodine_clock_oscillation_col",
  "affordances": [
    {
      "id": "A1",
      "name": "Beaker0",
      "type": "3d_object",
      "semantic": "First iodine clock beaker at x=-4.5 with 4s default period",
      "locator_hints": [
        "leftmost beaker",
        "beaker index 0"
      ]
    },
    {
      "id": "A2",
      "name": "Beaker1",
      "type": "3d_object",
      "semantic": "Second iodine clock beaker at x=-1.5 with 5s default period",
      "locator_hints": [
        "second beaker from left",
        "beaker index 1"
      ]
    },
    {
      "id": "A3",
      "name": "Beaker2",
      "type": "3d_object",
      "semantic": "Third iodine clock beaker at x=1.5 with 6s default period",
      "locator_hints": [
        "third beaker from left",
        "beaker index 2"
      ]
    },
    {
      "id": "A4",
      "name": "Beaker3",
      "type": "3d_object",
      "semantic": "Fourth iodine clock beaker at x=4.5 with 8s default period",
      "locator_hints": [
        "rightmost beaker",
        "beaker index 3"
      ]
    },
    {
      "id": "A5",
      "name": "SyncAllButton",
      "type": "dom_element",
      "semantic": "Button to synchronize all beakers to phase 0",
      "locator_hints": [
        "button containing 'Sync'",
        "bottom center button"
      ]
    },
    {
      "id": "A6",
      "name": "CascadeModeButton",
      "type": "dom_element",
      "semantic": "Toggle button for cascade stagger mode",
      "locator_hints": [
        "button containing 'Cascade'",
        "bottom center toggle"
      ]
    },
    {
      "id": "A7",
      "name": "HUDElapsedTime",
      "type": "dom_element",
      "semantic": "Top-left elapsed time display",
      "locator_hints": [
        "text containing 'Elapsed Time'"
      ]
    },
    {
      "id": "A8",
      "name": "HUDTemperature",
      "type": "dom_element",
      "semantic": "Top-right temperature mode display",
      "locator_hints": [
        "text containing 'Temperature'"
      ]
    },
    {
      "id": "A9",
      "name": "PausedOverlay",
      "type": "dom_element",
      "semantic": "PAUSED text overlay shown when simulation is paused",
      "locator_hints": [
        "text 'PAUSED'",
        "centered overlay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.beakerCount === 4",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.selectedBeakerIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "OscillationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.beakers[0].phase >= 0 && window.__3D_STATE__.beakers[0].phase < 1"
      ]
    },
    {
      "id": "S2",
      "name": "BeakerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBeakerIndex >= 0 && window.__3D_STATE__.selectedBeakerIndex <= 3"
      ]
    },
    {
      "id": "S3",
      "name": "PeriodAdjusted",
      "conditions": [
        "window.__3D_STATE__.beakers[window.__3D_STATE__.selectedBeakerIndex].basePeriod !== 4"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "TemperatureElevated",
      "conditions": [
        "window.__3D_STATE__.temperatureMode === 'elevated'"
      ]
    },
    {
      "id": "S6",
      "name": "BeakersSynced",
      "conditions": [
        "window.__3D_STATE__.syncCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "CascadeModeActive",
      "conditions": [
        "window.__3D_STATE__.cascadeMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "ReagentBurstApplied",
      "conditions": [
        "window.__3D_STATE__.beakers[window.__3D_STATE__.selectedBeakerIndex].phase >= 0.7"
      ]
    },
    {
      "id": "S9",
      "name": "BluePhaseObserved",
      "conditions": [
        "window.__3D_STATE__.beakers.some(b => b.isBlue === true)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beakers === 'object' && Array.isArray(window.__3D_STATE__.beakers) && window.__3D_STATE__.beakers.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].phase >= 0 && window.__3D_STATE__.beakers[0].phase < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].basePeriod === 4 && window.__3D_STATE__.beakers[1].basePeriod === 5 && window.__3D_STATE__.beakers[2].basePeriod === 6 && window.__3D_STATE__.beakers[3].basePeriod === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => !isNaN(b.phase) && !isNaN(b.period) && !isNaN(b.stirrerRPM))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCycles === window.__3D_STATE__.beakers.reduce((s, b) => s + b.cycleCount, 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A1",
        "position_hint": "center of leftmost beaker"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBeakerIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.beakers[0].phase === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].period > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].stirrerRPM > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beakers[0].basePeriod === 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].period === 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].basePeriod >= 1.5 && window.__3D_STATE__.beakers[0].basePeriod <= 12.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].stirrerRPM > window.__3D_STATE__.beakers[1].stirrerRPM",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[1].basePeriod === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ window.__test_pausePhase0 = window.__3D_STATE__.beakers[0].phase; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.phase >= 0 && b.phase < 1.0)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperatureMode === 'normal'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 1500)); const frozenPhase = window.__3D_STATE__.beakers[0].phase; window.__test_frozenPhase = frozenPhase; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'p'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.beakers[0].phase - window.__test_frozenPhase) < 0.01 || window.__3D_STATE__.beakers[0].phase > window.__test_frozenPhase || window.__3D_STATE__.beakers[0].phase < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => !isNaN(b.phase))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBeakerIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].basePeriod === 3.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatureMode === 'elevated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].period === window.__3D_STATE__.beakers[0].basePeriod / 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[1].period === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[2].period === 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[3].period === 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].stirrerRPM > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "A5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.syncCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.phase < 0.15)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.beakers[0].phase - window.__3D_STATE__.beakers[1].phase) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.beakers[2].phase - window.__3D_STATE__.beakers[3].phase) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureMode === 'elevated'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "A6"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cascadeMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakerCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.phase >= 0 && b.phase < 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCycles === window.__3D_STATE__.beakers.reduce((s, b) => s + b.cycleCount, 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => !isNaN(b.colorHex) === false && typeof b.colorHex === 'string')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'r'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beakers[0].phase >= 0.7 || window.__3D_STATE__.beakers[0].phase < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].isBlue === true || window.__3D_STATE__.beakers[0].phase >= 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBeakerIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cascadeMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.period > 0 && b.period <= 12)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalCycles >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.some(b => b.isBlue === true) || window.__3D_STATE__.beakers.some(b => b.cycleCount >= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.colorHex.startsWith('#'))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.phase >= 0 && b.phase < 1.0 && !isNaN(b.phase))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalCycles === window.__3D_STATE__.beakers.reduce((sum, b) => sum + b.cycleCount, 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 8",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}