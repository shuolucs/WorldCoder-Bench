  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.layerCount === 7",
        "window.__3D_STATE__.isRaining === false",
        "window.__3D_STATE__.isExploded === false",
        "window.__3D_STATE__.selectedLayer === null",
        "window.__3D_STATE__.visibleLayerCount === 7"
      ]
    },
    {
      "id": "S1",
      "name": "RainActive",
      "conditions": [
        "window.__3D_STATE__.isRaining === true"
      ]
    },
    {
      "id": "S2",
      "name": "RainActiveWithParticles",
      "conditions": [
        "window.__3D_STATE__.isRaining === true",
        "window.__3D_STATE__.rainStats.active > 0"
      ]
    },
    {
      "id": "S3",
      "name": "RainStopped",
      "conditions": [
        "window.__3D_STATE__.isRaining === false"
      ]
    },
    {
      "id": "S4",
      "name": "LayerSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLayer !== null"
      ]
    },
    {
      "id": "S5",
      "name": "ExplodedView",
      "conditions": [
        "window.__3D_STATE__.isExploded === true"
      ]
    },
    {
      "id": "S6",
      "name": "LayerHidden",
      "conditions": [
        "window.__3D_STATE__.visibleLayerCount < 7"
      ]
    },
    {
      "id": "S7",
      "name": "ExplodedCollapsed",
      "conditions": [
        "window.__3D_STATE__.isExploded === false",
        "window.__3D_STATE__.explodedGap === 0"
      ]
    },
    {
      "id": "S8",
      "name": "DrainageOccurring",
      "conditions": [
        "window.__3D_STATE__.rainStats.drained > 0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.isExploded === false",
        "window.__3D_STATE__.selectedLayer === null",
        "window.__3D_STATE__.visibleLayerCount === 7"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.layerCount === 7",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.layers) && window.__3D_STATE__.layers.length === 7",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isRaining === false && window.__3D_STATE__.isExploded === false && window.__3D_STATE__.selectedLayer === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.spawned === 0 && window.__3D_STATE__.rainStats.active === 0 && window.__3D_STATE__.rainStats.drained === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object' && !isNaN(window.__3D_STATE__.cameraPosition.x) && !isNaN(window.__3D_STATE__.cameraPosition.y) && !isNaN(window.__3D_STATE__.cameraPosition.z)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Toggle Rain"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRaining === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainStats === 'object' && window.__3D_STATE__.rainStats !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainStats.spawned === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainStats.active === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particlePositions)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainStats.spawned > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.active > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.active <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.spawned === window.__3D_STATE__.rainStats.active + window.__3D_STATE__.rainStats.drained",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === window.__3D_STATE__.rainStats.active",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainStats.drained > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.spawned === window.__3D_STATE__.rainStats.active + window.__3D_STATE__.rainStats.drained",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.active <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => p.y >= 0.5 && p.y <= 6.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRaining === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S8",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Toggle Rain"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRaining === false",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var s = window.__3D_STATE__.rainStats; return s.spawned === s.active + s.drained; })()",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainStats.drained === 'number' && window.__3D_STATE__.rainStats.drained > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rainStats.spawned > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isExploded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodedGap === 1.0 || (typeof window.__3D_STATE__.explodedGap === 'number' && window.__3D_STATE__.explodedGap > 0.8)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[6].yPosition > window.__3D_STATE__.layers[5].yPosition",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].visible === true && window.__3D_STATE__.layers[6].visible === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var l = window.__3D_STATE__.layers; var totalGap = l[6].yPosition - l[0].yPosition; return totalGap > 8.0; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target_hint": "DrainageLayer",
        "position": {
          "x": 0.5,
          "y": 0.4
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLayer !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedLayer === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedLayer.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isExploded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
