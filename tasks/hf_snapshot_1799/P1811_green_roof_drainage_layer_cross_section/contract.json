        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[2].visible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleLayerCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].visible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[6].visible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.filter(l => l.visible).length === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isExploded === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedLayer === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleLayerCount === 7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.explodedGap === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.every(l => l.visible === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[0].yPosition >= 0 && window.__3D_STATE__.layers[0].yPosition <= 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: '1'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: '7'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.layers[0].visible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[6].visible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleLayerCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers[3].visible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.layers.filter(l => !l.visible).length === 2",
            "tier": "L2"
          }
        ]
