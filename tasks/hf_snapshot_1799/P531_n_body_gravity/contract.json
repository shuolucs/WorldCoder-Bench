{
  "task_id": "P531_n_body_gravity",
  "affordances": [
    {"id": "A1", "name": "Bodies", "type": "3d_object", "semantic": "Sphere meshes representing gravitational bodies", "locator_hints": ["sphere meshes in scene"]},
    {"id": "A2", "name": "Trails", "type": "3d_object", "semantic": "Line trails behind each body", "locator_hints": ["line objects in scene"]},
    {"id": "A3", "name": "GSlider", "type": "dom_element", "semantic": "Slider to adjust gravitational constant", "locator_hints": ["#slider-G"]},
    {"id": "A4", "name": "DtSlider", "type": "dom_element", "semantic": "Slider to adjust timestep", "locator_hints": ["#slider-dt"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Top-left info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial_Paused", "conditions": ["window.__3D_STATE__.bodyCount === 5", "window.__3D_STATE__.isPaused === true"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S2", "name": "BodyAdded", "conditions": ["window.__3D_STATE__.bodyCount > 5"]},
    {"id": "S3", "name": "GChanged", "conditions": ["window.__3D_STATE__.G !== 100"]},
    {"id": "S4", "name": "Evolved", "conditions": ["window.__3D_STATE__.frameCount > 50"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.bodyCount === 5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalMass > 0", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"},
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Running')", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "a"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bodyCount === before.bodyCount + 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.totalMass > before.totalMass", "tier": "L1"},
        {"expr": "document.getElementById('hud-bodies').textContent.includes(String(window.__3D_STATE__.bodyCount))", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-G').value = 300; document.getElementById('slider-G').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.G === 300", "tier": "L2"},
        {"expr": "document.getElementById('hud-G').textContent.includes('300')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.frameCount > before.frameCount + 10", "tier": "L0"},
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return typeof s.totalEnergy === 'number' && isFinite(s.totalEnergy); })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return s.bodyCount >= 1 && s.bodyCount <= 20; })()", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "c"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bodiesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()", "tier": "L0"}
      ]}
    }
  ]
}
