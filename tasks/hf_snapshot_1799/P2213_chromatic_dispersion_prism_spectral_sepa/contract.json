            "expr": "window.__3D_STATE__.channelOffsets !== undefined && Math.abs(window.__3D_STATE__.channelOffsets.g.x) < 0.0001 && Math.abs(window.__3D_STATE__.channelOffsets.g.y) < 0.0001",
            "tier": "L2"
          }
        ]
