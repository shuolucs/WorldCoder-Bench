  "states": [
    {
      "id": "S0",
      "name": "Initial_ModelLoading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.frameCount < 2"
      ]
    },
    {
      "id": "S1",
      "name": "SceneReady_DefaultParams",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.dispersionStrength === 0",
        "window.__3D_STATE__.radialMode === false",
        "window.__3D_STATE__.glowEnabled === false",
        "window.__3D_STATE__.activePreset === 'None'"
      ]
    },
    {
      "id": "S2",
      "name": "SubtleRainbowPreset",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength === 0.008",
        "window.__3D_STATE__.dispersionAngle === 45",
        "window.__3D_STATE__.radialMode === false",
        "window.__3D_STATE__.glowEnabled === true",
        "window.__3D_STATE__.glowIntensity === 0.5",
        "window.__3D_STATE__.activePreset === 'Subtle Rainbow'"
      ]
    },
    {
      "id": "S3",
      "name": "HeavySplitPreset",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength === 0.035",
        "window.__3D_STATE__.dispersionAngle === 0",
        "window.__3D_STATE__.radialMode === false",
        "window.__3D_STATE__.glowEnabled === false",
        "window.__3D_STATE__.activePreset === 'Heavy Split'"
      ]
    },
    {
      "id": "S4",
      "name": "RadialBurstPreset",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength === 0.025",
        "window.__3D_STATE__.radialMode === true",
        "window.__3D_STATE__.glowEnabled === true",
        "window.__3D_STATE__.glowIntensity === 1.2",
        "window.__3D_STATE__.activePreset === 'Radial Burst'"
      ]
    },
    {
      "id": "S5",
      "name": "ManualStrengthIncreased",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength > 0"
      ]
    },
    {
      "id": "S6",
      "name": "GlowToggledOn",
      "conditions": [
        "window.__3D_STATE__.glowEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "RadialModeActive",
      "conditions": [
        "window.__3D_STATE__.radialMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetAfterPreset",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength === 0",
        "window.__3D_STATE__.glowEnabled === false",
        "window.__3D_STATE__.radialMode === false",
        "window.__3D_STATE__.activePreset === 'None'"
      ]
    },
    {
      "id": "S9",
      "name": "StrengthAtMax",
      "conditions": [
        "window.__3D_STATE__.dispersionStrength === 0.05"
      ]
    }
  ],
