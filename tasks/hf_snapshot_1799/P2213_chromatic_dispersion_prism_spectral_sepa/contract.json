            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.prismCenter !== undefined && Math.abs(window.__3D_STATE__.prismCenter.x - 0.5) < 0.01 && Math.abs(window.__3D_STATE__.prismCenter.y - 0.5) < 0.01",
            "tier": "L2"
          }
        ]
