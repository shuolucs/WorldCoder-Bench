        "#strap-label"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_DefaultStrap",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentStrap === 'leather'",
        "window.__3D_STATE__.strapIndex === 0",
        "window.__3D_STATE__.swapCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "MetalStrapSelected",
      "conditions": [
        "window.__3D_STATE__.currentStrap === 'metal'",
        "window.__3D_STATE__.strapIndex === 1",
        "window.__3D_STATE__.price === 299"
      ]
    },
    {
      "id": "S2",
      "name": "RubberStrapSelected",
      "conditions": [
        "window.__3D_STATE__.currentStrap === 'rubber'",
        "window.__3D_STATE__.strapIndex === 2",
        "window.__3D_STATE__.price === 99"
      ]
    },
    {
      "id": "S3",
      "name": "NatoStrapSelected",
      "conditions": [
        "window.__3D_STATE__.currentStrap === 'nato'",
        "window.__3D_STATE__.strapIndex === 3",
        "window.__3D_STATE__.price === 129"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotateEnabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesDisabled",
      "conditions": [
        "window.__3D_STATE__.particlesEnabled === false"
      ]
    },
    {
      "id": "S7",
      "name": "BackToLeather",
      "conditions": [
        "window.__3D_STATE__.currentStrap === 'leather'",
        "window.__3D_STATE__.strapIndex === 0",
        "window.__3D_STATE__.price === 149"
      ]
    }
  ],
