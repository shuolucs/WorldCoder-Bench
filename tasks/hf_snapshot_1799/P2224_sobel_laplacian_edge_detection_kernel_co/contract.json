  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded_OriginalMode",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.currentMode === 0",
        "window.__3D_STATE__.currentModeName === 'original'"
      ]
    },
    {
      "id": "S1",
      "name": "SobelMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 1",
        "window.__3D_STATE__.currentModeName === 'sobel'"
      ]
    },
    {
      "id": "S2",
      "name": "LaplacianMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 2",
        "window.__3D_STATE__.currentModeName === 'laplacian'"
      ]
    },
    {
      "id": "S3",
      "name": "SplitMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 3",
        "window.__3D_STATE__.currentModeName === 'split'"
      ]
    },
    {
      "id": "S4",
      "name": "OverlayMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 4",
        "window.__3D_STATE__.currentModeName === 'overlay'"
      ]
    },
    {
      "id": "S5",
      "name": "StrengthIncreased",
      "conditions": [
        "window.__3D_STATE__.edgeStrength > 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "ThresholdModified",
      "conditions": [
        "window.__3D_STATE__.threshold !== 0.1"
      ]
    },
    {
      "id": "S7",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S8",
      "name": "SobelColorChanged",
      "conditions": [
        "window.__3D_STATE__.sobelColorHex !== '#00ff80'"
      ]
    },
    {
      "id": "S9",
      "name": "LaplacianColorChanged",
      "conditions": [
        "window.__3D_STATE__.laplacianColorHex !== '#ff4d00'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelBBoxSize === 'object' && window.__3D_STATE__.modelBBoxSize !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelBBoxSize.x > 0 && window.__3D_STATE__.modelBBoxSize.y > 0 && window.__3D_STATE__.modelBBoxSize.z > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.sobelKernel) && window.__3D_STATE__.sobelKernel.length === 9",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.laplacianKernel) && window.__3D_STATE__.laplacianKernel.length === 9",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentModeName === 'sobel'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.sobelKernel) === JSON.stringify([-1,0,1,-2,0,2,-1,0,1])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeStrength === 1.0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.modeHistory) && window.__3D_STATE__.modeHistory[window.__3D_STATE__.modeHistory.length - 1] === 1",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentModeName === 'laplacian'",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.laplacianKernel) === JSON.stringify([0,-1,0,-1,4,-1,0,-1,0])",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.threshold === 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentModeName === 'split'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetWidth > 0 && window.__3D_STATE__.renderTargetHeight > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetWidth === window.innerWidth",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetHeight === window.innerHeight",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fps)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentModeName === 'overlay'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modeHistory.length >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeStrength - 1.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeStrength >= 0.1 && window.__3D_STATE__.edgeStrength <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.edgeStrength)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-strength') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.threshold - 0.15) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.threshold >= 0.0 && window.__3D_STATE__.threshold <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.threshold === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.threshold)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-threshold') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-rotate') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-rotate').textContent.toLowerCase().includes('off') || document.getElementById('hud-rotate').textContent.toLowerCase().includes('false') || document.getElementById('hud-rotate').textContent.toLowerCase().includes('disabled')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sobelColorHex !== '#00ff80'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sobelColorHex === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sobelColorHex.startsWith('#')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sobelColorHex.toLowerCase() === '#00ffff'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-sobel-color') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.laplacianColorHex !== '#ff4d00'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.laplacianColorHex === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.laplacianColorHex.startsWith('#')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.laplacianColorHex.toLowerCase() === '#ff00ff'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-laplacian-color') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modeHistory.length <= 10",
            "tier": "L2"
          }
        ]
      }
