  "states": [
    {
      "id": "S0",
      "name": "Initial_Noon",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 12",
        "window.__3D_STATE__.openCount === 0",
        "window.__3D_STATE__.selectedCabinet === -1",
        "window.__3D_STATE__.soldierLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "Midnight_Lighting",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 0",
        "window.__3D_STATE__.ambientIntensity <= 0.15"
      ]
    },
    {
      "id": "S2",
      "name": "Dawn_Lighting",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 6",
        "window.__3D_STATE__.ambientIntensity >= 0.25 && window.__3D_STATE__.ambientIntensity <= 0.4"
      ]
    },
    {
      "id": "S3",
      "name": "Cabinet0_Open",
      "conditions": [
        "window.__3D_STATE__.cabinetDoors[0] === true",
        "window.__3D_STATE__.openCount === 1"
      ]
    },
    {
      "id": "S4",
      "name": "AllCabinets_Open",
      "conditions": [
        "window.__3D_STATE__.cabinetDoors[0] === true",
        "window.__3D_STATE__.cabinetDoors[1] === true",
        "window.__3D_STATE__.cabinetDoors[2] === true",
        "window.__3D_STATE__.openCount === 3"
      ]
    },
    {
      "id": "S5",
      "name": "Cabinet_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedCabinet >= 0 && window.__3D_STATE__.selectedCabinet <= 4"
      ]
    },
    {
      "id": "S6",
      "name": "Color_Changed",
      "conditions": [
        "window.__3D_STATE__.cabinetColors.some(c => c !== '#654321' && c !== '#8B6914')"
      ]
    },
    {
      "id": "S7",
      "name": "Cost_Updated",
      "conditions": [
        "window.__3D_STATE__.totalCost > 900"
      ]
    },
    {
      "id": "S8",
      "name": "Dusk_Lighting",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 18",
        "window.__3D_STATE__.ambientIntensity >= 0.25 && window.__3D_STATE__.ambientIntensity <= 0.4"
      ]
    },
    {
      "id": "S9",
      "name": "Cabinet0_Closed_Again",
      "conditions": [
        "window.__3D_STATE__.cabinetDoors[0] === false",
        "window.__3D_STATE__.openCount === 2"
      ]
    }
  ],
