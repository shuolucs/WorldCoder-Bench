{
  "task_id": "P467_magnetic_field_lines_3d_with_time_contro",
  "affordances": [
    {
      "id": "A1",
      "name": "BarMagnet",
      "type": "3d_object",
      "semantic": "Bar magnet at origin with N (red) and S (blue) poles along X-axis",
      "locator_hints": [
        "Two box meshes at origin",
        "Red mesh x>0, Blue mesh x<0"
      ]
    },
    {
      "id": "A2",
      "name": "FieldLines",
      "type": "3d_object",
      "semantic": "16 magnetic field lines curving from N to S pole",
      "locator_hints": [
        "TubeGeometry or Line objects",
        "Vertex-colored red to blue"
      ]
    },
    {
      "id": "A3",
      "name": "DirectionArrows",
      "type": "3d_object",
      "semantic": "Small cone arrows along field lines showing direction",
      "locator_hints": [
        "ConeGeometry objects tangent to curves"
      ]
    },
    {
      "id": "A4",
      "name": "TestCharges",
      "type": "3d_object",
      "semantic": "4 glowing spheres moving along field lines",
      "locator_hints": [
        "Emissive sphere meshes",
        "radius ~0.15"
      ]
    },
    {
      "id": "A5",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling time scale from 0.1 to 5.0",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A8",
      "name": "FieldStrengthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling magnetic moment from 0.5 to 3.0",
      "locator_hints": [
        "#slider-strength"
      ]
    },
    {
      "id": "A9",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "Shows elapsed simulation time",
      "locator_hints": [
        "#display-time"
      ]
    },
    {
      "id": "A10",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Shows PAUSED or RUNNING",
      "locator_hints": [
        "#display-status"
      ]
    },
    {
      "id": "A11",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Top-right panel with simulation info",
      "locator_hints": [
        "#info-panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.fieldStrength === 1.0",
        "window.__3D_STATE__.numFieldLines === 16"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PlayingFaster",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.timeScale === 1.5"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simulationTime === 0"
      ]
    },
    {
      "id": "S5",
      "name": "FieldLinesHidden",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "FieldLinesVisible",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "StrongerField",
      "conditions": [
        "window.__3D_STATE__.fieldStrength === 2.0"
      ]
    },
    {
      "id": "S8",
      "name": "XYView",
      "conditions": [
        "window.__3D_STATE__.cameraView === 'xy'"
      ]
    },
    {
      "id": "S9",
      "name": "XZView",
      "conditions": [
        "window.__3D_STATE__.cameraView === 'xz'"
      ]
    },
    {
      "id": "S10",
      "name": "PerspectiveView",
      "conditions": [
        "window.__3D_STATE__.cameraView === 'perspective'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
