{
  "task_id": "P565_gyroscope_precession",
  "affordances": [
    {"id": "A1", "name": "Gyroscope", "type": "3d_object", "semantic": "Axle with rotor and counterweight", "locator_hints": ["torus + cylinder group"]},
    {"id": "A2", "name": "VectorArrows", "type": "3d_object", "semantic": "Angular momentum and torque arrows", "locator_hints": ["ArrowHelper"]},
    {"id": "A3", "name": "Trail", "type": "3d_object", "semantic": "Axle tip trail line", "locator_hints": ["line geometry"]},
    {"id": "A4", "name": "SpinSlider", "type": "dom_element", "semantic": "Spin speed control", "locator_hints": ["#slider-spin-speed"]},
    {"id": "A5", "name": "TiltSlider", "type": "dom_element", "semantic": "Tilt angle control", "locator_hints": ["#slider-tilt"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Precessing", "conditions": ["window.__3D_STATE__.precessionAngle > 0.1"]},
    {"id": "S2", "name": "SpinChanged", "conditions": ["window.__3D_STATE__.spinSpeed !== 40"]},
    {"id": "S3", "name": "TiltChanged", "conditions": ["Math.abs(window.__3D_STATE__.tiltAngle - 45) > 3"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.precessionAngle < 0.05"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.precessionRate > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.angularMomentum > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gyroValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-spin-speed').value = 80; document.getElementById('slider-spin-speed').dispatchEvent(new Event('input')); document.dispatchEvent(new KeyboardEvent('keydown',{key:'r'})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.spinSpeed >= 70", "tier": "L2"},
        {"expr": "window.__3D_STATE__.gyroValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.precessionRate < before.precessionRate || window.__3D_STATE__.precessionRate < 0.5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gyroValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-tilt').value = 70; document.getElementById('slider-tilt').dispatchEvent(new Event('input')); document.dispatchEvent(new KeyboardEvent('keydown',{key:'r'})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.tiltAngle > 60", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.gyroValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "v"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.vectorsVisible !== before.vectorsVisible", "tier": "L2"}
      ]}
    }
  ]
}
