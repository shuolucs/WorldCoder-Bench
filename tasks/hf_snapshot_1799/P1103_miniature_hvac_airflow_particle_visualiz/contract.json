  "states": [
    {
      "id": "S0",
      "name": "Initial_Cooling_SystemOn",
      "conditions": [
        "window.__3D_STATE__.mode === 'cooling'",
        "window.__3D_STATE__.systemOn === true",
        "window.__3D_STATE__.particleCount === 500",
        "window.__3D_STATE__.fanSpeed === 'medium'",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "Heating_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'heating'",
        "window.__3D_STATE__.previousMode === 'cooling'"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Room_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedRoom !== null"
      ]
    },
    {
      "id": "S4",
      "name": "Fan_High",
      "conditions": [
        "window.__3D_STATE__.fanSpeed === 'high'",
        "window.__3D_STATE__.fanMultiplier === 1.5"
      ]
    },
    {
      "id": "S5",
      "name": "System_Off",
      "conditions": [
        "window.__3D_STATE__.systemOn === false"
      ]
    },
    {
      "id": "S6",
      "name": "Temp_Adjusted",
      "conditions": [
        "window.__3D_STATE__.targetTemp !== 18"
      ]
    },
    {
      "id": "S7",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.mode === 'cooling'",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S8",
      "name": "Reset_Applied",
      "conditions": [
        "window.__3D_STATE__.particleCount === 500",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S9",
      "name": "Fan_Low",
      "conditions": [
        "window.__3D_STATE__.fanSpeed === 'low'",
        "window.__3D_STATE__.fanMultiplier === 0.5"
      ]
    },
    {
      "id": "S10",
      "name": "Resumed_After_Pause",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S11",
      "name": "Room_Deselected",
      "conditions": [
        "window.__3D_STATE__.selectedRoom === null"
      ]
    }
  ],
