      ]
    },
    {
      "id": "A3",
      "name": "BuildingDiorama",
      "type": "3d_object",
      "semantic": "Semi-transparent 2-story building cross-section",
      "locator_hints": [
        "group containing walls, floors, ducts"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
