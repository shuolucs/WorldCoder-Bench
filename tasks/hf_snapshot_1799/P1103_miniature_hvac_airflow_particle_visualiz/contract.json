        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesInBounds === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemp >= 16 && window.__3D_STATE__.avgTemp <= 28",
            "tier": "L2"
          },
          {
