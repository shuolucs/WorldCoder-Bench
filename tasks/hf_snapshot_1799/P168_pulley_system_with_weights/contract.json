      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.avocadoLoaded === true",
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.leftY === 4.0",
        "window.__3D_STATE__.rightY === 4.0"
      ]
    },
    {
      "id": "S1",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.velocity >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "Weights_Moving",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.velocity > 0.1",
        "window.__3D_STATE__.rightY < 4.0",
        "window.__3D_STATE__.leftY > 4.0"
      ]
    },
    {
      "id": "S3",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.leftY === 4.0",
        "window.__3D_STATE__.rightY === 4.0",
        "window.__3D_STATE__.velocity === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Mass_Changed",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.massLeft !== 3.0 || window.__3D_STATE__.massRight !== 5.0"
      ]
    },
    {
      "id": "S6",
      "name": "Hit_Limit",
      "conditions": [
        "window.__3D_STATE__.hitLimit === true",
        "window.__3D_STATE__.simRunning === false"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed_After_Mass_Change",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.massLeft !== 3.0 || window.__3D_STATE__.massRight !== 5.0"
      ]
    }
  ],
  "transitions": [
