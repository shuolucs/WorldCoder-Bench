{
  "task_id": "P330_procedural_protein_folding_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinChain",
      "type": "3d_object",
      "semantic": "The 30-node procedural protein backbone chain",
      "locator_hints": [
        "group containing 30 sphere meshes and 29 cylinder bonds"
      ]
    },
    {
      "id": "A2",
      "name": "FoldButton",
      "type": "dom_element",
      "semantic": "Button to start folding simulation",
      "locator_hints": [
        "#foldBtn"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset protein to unfolded state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A4",
      "name": "DenatureButton",
      "type": "dom_element",
      "semantic": "Button to randomize protein positions",
      "locator_hints": [
        "#denatureBtn"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed 1-10",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A6",
      "name": "HighlightButton",
      "type": "dom_element",
      "semantic": "Toggle button cycling highlight through residue types",
      "locator_hints": [
        "#highlightBtn"
      ]
    },
    {
      "id": "A7",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing state, step, energy, RoG",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A8",
      "name": "ResidueInfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected residue details",
      "locator_hints": [
        "#residueInfo"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialUnfolded",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'unfolded'",
        "window.__3D_STATE__.foldingStep === 0",
        "window.__3D_STATE__.nodeCount === 30",
        "window.__3D_STATE__.bondCount === 29",
        "window.__3D_STATE__.isSimulating === false"
      ]
    },
    {
      "id": "S1",
      "name": "FoldingActive",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folding'",
        "window.__3D_STATE__.foldingStep > 0",
        "window.__3D_STATE__.isSimulating === true"
      ]
    },
    {
      "id": "S2",
      "name": "FoldingProgressed",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folding'",
        "window.__3D_STATE__.foldingStep >= 50",
        "window.__3D_STATE__.isSimulating === true"
      ]
    },
    {
      "id": "S3",
      "name": "FoldedOrConverged",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folded' || window.__3D_STATE__.foldingStep >= 500",
        "window.__3D_STATE__.isSimulating === false"
      ]
    },
    {
      "id": "S4",
      "name": "ResetAfterFold",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'unfolded'",
        "window.__3D_STATE__.foldingStep === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Denatured",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'denatured'",
        "window.__3D_STATE__.isSimulating === false"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.simulationSpeed === 10"
      ]
    },
    {
      "id": "S7",
      "name": "HighlightHydrophobic",
      "conditions": [
        "window.__3D_STATE__.highlightType === 'hydrophobic'"
      ]
    },
    {
      "id": "S8",
      "name": "HighlightCycledToCharged",
      "conditions": [
        "window.__3D_STATE__.highlightType === 'charged'"
      ]
    },
    {
      "id": "S9",
      "name": "FoldingAfterDenature",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folding'",
        "window.__3D_STATE__.isSimulating === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#foldBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'folding'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 30",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes.length === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingStep >= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingState === 'folding'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.radiusOfGyration) && window.__3D_STATE__.radiusOfGyration > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(p => isFinite(p.x) && isFinite(p.y) && isFinite(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 15000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'folded' || window.__3D_STATE__.foldingStep >= 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radiusOfGyration < 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingStep === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nodePositions[0].y) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nodePositions[0].z) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#denatureBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'denatured'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.some(p => Math.abs(p.y) > 0.5 || Math.abs(p.z) > 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(p => Math.sqrt(p.x*p.x + p.y*p.y + p.z*p.z) <= 12)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 10; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationSpeed === 10",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('speedSlider').value === '10'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingState === 'denatured'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#highlightBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highlightType === 'hydrophobic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[0] === 'hydrophobic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[1] === 'hydrophilic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[2] === 'charged'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('highlightBtn').click(); document.getElementById('highlightBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highlightType === 'charged'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[2] === 'charged'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'folding'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationSpeed === 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.length === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingStep === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isSimulating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nodePositions.every(p => Math.abs(p.y) < 0.01 && Math.abs(p.z) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nodePositions[29].x - window.__3D_STATE__.nodePositions[0].x) - 29 * 1.2 < 0.5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}