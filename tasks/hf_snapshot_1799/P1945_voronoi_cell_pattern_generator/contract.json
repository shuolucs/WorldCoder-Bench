  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.numPoints === 8",
        "window.__3D_STATE__.borderThickness === 0.015",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.animating === false",
        "window.__3D_STATE__.distortion === 0.0",
        "window.__3D_STATE__.numCustomPoints === 0",
        "window.__3D_STATE__.shaderCompiled === true"
      ]
    },
    {
      "id": "S1",
      "name": "PointsIncreased",
      "conditions": [
        "window.__3D_STATE__.numPoints === 9",
        "window.__3D_STATE__.totalDisplayedPoints === 9"
      ]
    },
    {
      "id": "S2",
      "name": "PointsDecreased",
      "conditions": [
        "window.__3D_STATE__.numPoints === 8",
        "window.__3D_STATE__.totalDisplayedPoints === 8"
      ]
    },
    {
      "id": "S3",
      "name": "BorderCycled",
      "conditions": [
        "window.__3D_STATE__.borderThickness === 0.05",
        "window.__3D_STATE__.borderPresetIndex === 2"
      ]
    },
    {
      "id": "S4",
      "name": "ColorModeCycled",
      "conditions": [
        "window.__3D_STATE__.colorMode === 1",
        "window.__3D_STATE__.colorModeName === 'gradient'"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationToggled",
      "conditions": [
        "window.__3D_STATE__.animating === true",
        "window.__3D_STATE__.animationSpeed === 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.animating === true"
      ]
    },
    {
      "id": "S7",
      "name": "DistortionApplied",
      "conditions": [
        "window.__3D_STATE__.distortion === 0.25",
        "window.__3D_STATE__.distortionPresetIndex === 1"
      ]
    },
    {
      "id": "S8",
      "name": "CustomPointAdded",
      "conditions": [
        "window.__3D_STATE__.numCustomPoints === 1",
        "window.__3D_STATE__.customPoints.length === 1"
      ]
    },
    {
      "id": "S9",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.numPoints === 8",
        "window.__3D_STATE__.borderThickness === 0.015",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.animating === false",
        "window.__3D_STATE__.distortion === 0.0",
        "window.__3D_STATE__.numCustomPoints === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPoints === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resolution !== undefined && window.__3D_STATE__.resolution.w > 0 && window.__3D_STATE__.resolution.h > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.borderThickness) && window.__3D_STATE__.borderThickness === 0.015",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numPoints === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDisplayedPoints === 9 + window.__3D_STATE__.numCustomPoints",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPoints >= 3 && window.__3D_STATE__.numPoints <= 20",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-points') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-points').textContent.includes('9')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numPoints === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDisplayedPoints === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPoints >= 3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.numPoints)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-points').textContent.includes('8')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'B'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'B'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.borderThickness === 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.borderPresetIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.borderThickness >= 0.005 && window.__3D_STATE__.borderThickness <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.borderThickness)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-border') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-border').textContent.includes('0.05')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "C"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorModeName === 'gradient'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorMode >= 0 && window.__3D_STATE__.colorMode <= 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-colormode').textContent.toLowerCase().includes('gradient')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animating === true",
