          },
          {
            "expr": "window.__3D_STATE__.animationSpeed === 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.animationSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationSpeed >= 0.0 && window.__3D_STATE__.animationSpeed <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-animation').textContent.toUpperCase().includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1200
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "D"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
