          },
          {
            "expr": "window.__3D_STATE__.distortionPresetIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.distortion)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distortion >= 0.0 && window.__3D_STATE__.distortion <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-distortion').textContent.includes('0.25')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numCustomPoints === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.customPoints)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.customPoints.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customPoints[0].x >= 0 && window.__3D_STATE__.customPoints[0].x <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customPoints[0].y >= 0 && window.__3D_STATE__.customPoints[0].y <= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-custompoints').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "R"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numPoints === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.borderThickness === 0.015",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distortion === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numCustomPoints === 0",
            "tier": "L2"
          }
        ]
