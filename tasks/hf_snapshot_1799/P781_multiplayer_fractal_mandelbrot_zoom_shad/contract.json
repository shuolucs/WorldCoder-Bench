{
  "task_id": "P781_multiplayer_fractal_mandelbrot_zoom_shad",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalQuad",
      "type": "3d_object",
      "semantic": "Fullscreen quad displaying the Mandelbrot fractal via custom shader",
      "locator_hints": [
        "scene.children mesh with PlaneGeometry"
      ]
    },
    {
      "id": "A2",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing zoom, center, iterations, color scheme, players, FPS",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A3",
      "name": "PlayerBar",
      "type": "dom_element",
      "semantic": "Bottom bar showing player status indicators",
      "locator_hints": [
        "#player-bar"
      ]
    },
    {
      "id": "A4",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas for mouse interactions",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.rendererInitialized === true",
        "window.__3D_STATE__.centerX === -0.5",
        "window.__3D_STATE__.centerY === 0.0",
        "window.__3D_STATE__.zoom === 1.0",
        "window.__3D_STATE__.maxIter === 256",
        "window.__3D_STATE__.colorScheme === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ZoomedIn",
      "conditions": [
        "window.__3D_STATE__.zoom > 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "ColorSchemeChanged",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 1",
        "window.__3D_STATE__.colorSchemeName === 'Fire'"
      ]
    },
    {
      "id": "S3",
      "name": "IterationsIncreased",
      "conditions": [
        "window.__3D_STATE__.maxIter === 320"
      ]
    },
    {
      "id": "S4",
      "name": "PlayerToggled",
      "conditions": [
        "window.__3D_STATE__.player2Active === false"
      ]
    },
    {
      "id": "S5",
      "name": "PannedViaArrow",
      "conditions": [
        "window.__3D_STATE__.centerX !== -0.5 || window.__3D_STATE__.centerY !== 0.0"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.centerX === -0.5",
        "window.__3D_STATE__.zoom === 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "IterationsDecreased",
      "conditions": [
        "window.__3D_STATE__.maxIter < 256"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleColorCycles",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 3",
        "window.__3D_STATE__.colorSchemeName === 'Grayscale'"
      ]
    },
    {
      "id": "S9",
      "name": "MultiplePlayersToggled",
      "conditions": [
        "window.__3D_STATE__.activePlayers <= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rendererInitialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.centerX === -0.5 && window.__3D_STATE__.centerY === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoom === 1.0 && window.__3D_STATE__.maxIter === 256 && window.__3D_STATE__.colorScheme === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let prevZoom = window.__3D_STATE__.zoom; window.__prevZoom = prevZoom; let canvas = document.querySelector('canvas'); canvas.dispatchEvent(new WheelEvent('wheel', {deltaY: -100, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.zoom > window.__prevZoom",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.zoom - window.__prevZoom * 1.15) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoom >= 0.5 && window.__3D_STATE__.zoom <= 1e12",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.zoom) && isFinite(window.__3D_STATE__.zoom)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.zoomHistory) && window.__3D_STATE__.zoomHistory.length > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorScheme === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorSchemeName === 'Fire'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorSchemeName === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorScheme >= 0 && window.__3D_STATE__.colorScheme <= 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.toLowerCase().includes('fire')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "="
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxIter === 320",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter > 256",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter >= 64 && window.__3D_STATE__.maxIter <= 2048",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter % 64 === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxIter === 'number' && !isNaN(window.__3D_STATE__.maxIter)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.player2Active === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.player1Active === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePlayers === 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.activePlayers === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activePlayers === [window.__3D_STATE__.player1Active, window.__3D_STATE__.player2Active, window.__3D_STATE__.player3Active, window.__3D_STATE__.player4Active].filter(Boolean).length",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__prePanCenterX = window.__3D_STATE__.centerX; window.__prePanZoom = window.__3D_STATE__.zoom; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.centerX > window.__prePanCenterX",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.centerX - (window.__prePanCenterX + 0.1 / window.__prePanZoom)) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.centerX) && isFinite(window.__3D_STATE__.centerX)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.centerY) && isFinite(window.__3D_STATE__.centerY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoom === window.__prePanZoom",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.centerX === -0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.centerY === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoom === 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.centerX) && !isNaN(window.__3D_STATE__.centerY) && !isNaN(window.__3D_STATE__.zoom)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererInitialized === true && window.__3D_STATE__.shaderCompiled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preDecIter = window.__3D_STATE__.maxIter; document.dispatchEvent(new KeyboardEvent('keydown', {key: '-', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxIter === window.__preDecIter - 64",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter >= 64",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter % 64 === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxIter <= 2048",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxIter === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for (let i = 0; i < 3; i++) { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c', bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorScheme === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorSchemeName === 'Grayscale'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorSchemeName === 'string' && window.__3D_STATE__.colorSchemeName.length > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorScheme >= 0 && window.__3D_STATE__.colorScheme <= 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__preToggleCount = window.__3D_STATE__.activePlayers; document.dispatchEvent(new KeyboardEvent('keydown', {key: '3', bubbles: true})); document.dispatchEvent(new KeyboardEvent('keydown', {key: '4', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.player3Active === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.player4Active === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.player1Active === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePlayers <= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePlayers === [window.__3D_STATE__.player1Active, window.__3D_STATE__.player2Active, window.__3D_STATE__.player3Active, window.__3D_STATE__.player4Active].filter(Boolean).length",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.player1CursorX) && !isNaN(window.__3D_STATE__.player1CursorY)",
            "tier": "L2"
          }
        ]
