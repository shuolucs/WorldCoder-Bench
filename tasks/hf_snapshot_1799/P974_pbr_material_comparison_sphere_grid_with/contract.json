  "states": [
    {
      "id": "S0",
      "name": "InitialGridRendered",
      "conditions": [
        "window.__3D_STATE__.sphereCount === 12",
        "window.__3D_STATE__.selectedSphereIndex === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.envMapGlobal === true"
      ]
    },
    {
      "id": "S1",
      "name": "SphereSelectedViaArrow",
