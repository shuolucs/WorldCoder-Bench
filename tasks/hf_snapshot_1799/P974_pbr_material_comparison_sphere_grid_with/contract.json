    {
      "id": "S11",
      "name": "MultiSphereModifiedAndResetAll",
      "conditions": [
        "window.__3D_STATE__.spheres[0].metalness === 0.0",
        "window.__3D_STATE__.spheres[4].roughness === 0.0"
      ]
    }
