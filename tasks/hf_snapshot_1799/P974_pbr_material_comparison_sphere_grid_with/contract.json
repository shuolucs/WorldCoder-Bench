      ]
    },
    {
      "id": "S10",
      "name": "ResetSelectedApplied",
      "conditions": [
        "window.__3D_STATE__.spheres[1].metalness === 0.33 || window.__3D_STATE__.spheres[1].roughness === 0.3"
      ]
