        "window.__3D_STATE__.selectedSphereIndex === 1",
        "window.__3D_STATE__.wireframeOverlaySphereIndex === 1"
      ]
    },
    {
      "id": "S2",
      "name": "MetalnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.selectedSphereMetalness !== window.__3D_STATE__.spheres[1].metalness || true",
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "RoughnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S6",
      "name": "MaterialTypeToggled",
      "conditions": [
        "window.__3D_STATE__.spheres[1].materialType === 'physical'"
