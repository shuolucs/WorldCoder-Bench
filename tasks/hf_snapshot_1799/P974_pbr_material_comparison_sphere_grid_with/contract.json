    },
    {
      "id": "S7",
      "name": "ParticlesToggled",
      "conditions": [
        "window.__3D_STATE__.spheres[1].particlesVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "EnvMapToggled",
      "conditions": [
        "window.__3D_STATE__.spheres[1].envMapEnabled === false"
      ]
    },
    {
      "id": "S9",
      "name": "ParticleDensityChanged",
