  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelsLoaded.city === true",
        "window.__3D_STATE__.modelsLoaded.carTemplate === true"
