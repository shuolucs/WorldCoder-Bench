        "window.__3D_STATE__.formation === 'V_FORMATION'",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.totalResets >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "Diamond_Formation",
      "conditions": [
        "window.__3D_STATE__.formation === 'DIAMOND_FORMATION'",
