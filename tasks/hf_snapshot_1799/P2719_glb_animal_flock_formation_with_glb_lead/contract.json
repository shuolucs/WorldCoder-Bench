    },
    {
      "id": "S1",
      "name": "V_Formation_Running",
      "conditions": [
        "window.__3D_STATE__.formation === 'V_FORMATION'",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.activeFollowerCount === 5"
      ]
    },
    {
      "id": "S2",
      "name": "Line_Formation",
      "conditions": [
        "window.__3D_STATE__.formation === 'LINE_FORMATION'",
        "window.__3D_STATE__.formationCycleCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "Circle_Formation",
      "conditions": [
        "window.__3D_STATE__.formation === 'CIRCLE_FORMATION'",
        "window.__3D_STATE__.formationCycleCount >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "Speed_Modified",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
