      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const beam = window.__3D_STATE__.members.filter(m => m.type === 'beam')[1] || window.__3D_STATE__.members.find(m => m.type === 'beam'); if(beam && beam.mesh) { const pos = new THREE.Vector3(); beam.mesh.getWorldPosition(pos); pos.x += 1; const loadId = Date.now(); const dir = new THREE.Vector3(0,-1,0); const mag = window.__3D_STATE__.nextLoadMagnitude; const arrow = new THREE.ArrowHelper(dir, pos, mag/6, 0xff2222); const scene = beam.mesh.parent; if(scene) scene.add(arrow); const loadObj = {id: loadId, position:{x:pos.x,y:pos.y,z:pos.z}, magnitude: mag, arrowHelper: arrow}; window.__3D_STATE__.loads.push(loadObj); window.__3D_STATE__.loadCount = window.__3D_STATE__.loads.length; window.__3D_STATE__.totalLoad = window.__3D_STATE__.loads.reduce((s,l)=>s+l.magnitude,0); }"
