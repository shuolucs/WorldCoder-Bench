      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const beam = window.__3D_STATE__.members.find(m => m.type === 'beam'); if(beam && beam.mesh) { const pos = new THREE.Vector3(); beam.mesh.getWorldPosition(pos); const loadId = Date.now(); const dir = new THREE.Vector3(0,-1,0); const arrow = new THREE.ArrowHelper(dir, pos, 1.5, 0xff2222); const scene = beam.mesh.parent; if(scene) scene.add(arrow); const loadObj = {id: loadId, position:{x:pos.x,y:pos.y,z:pos.z}, magnitude: window.__3D_STATE__.nextLoadMagnitude, arrowHelper: arrow}; window.__3D_STATE__.loads.push(loadObj); window.__3D_STATE__.loadCount = window.__3D_STATE__.loads.length; window.__3D_STATE__.totalLoad = window.__3D_STATE__.loads.reduce((s,l)=>s+l.magnitude,0); }"
