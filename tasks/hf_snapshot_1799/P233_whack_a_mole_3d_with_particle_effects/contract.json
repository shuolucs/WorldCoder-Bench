  "states": [
    {
      "id": "S0",
      "name": "Initial_Waiting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.holeCount === 9",
        "window.__3D_STATE__.activeMoles === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Started",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.timeRemaining <= 30",
        "window.__3D_STATE__.timeRemaining > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Moles_Active",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.activeMoles > 0",
        "window.__3D_STATE__.activeMoles <= 9",
        "window.__3D_STATE__.molesPopulated > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Whack_Scored",
      "conditions": [
        "window.__3D_STATE__.whackCount > 0",
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.totalParticlesSpawned >= 20"
      ]
    },
    {
      "id": "S4",
      "name": "Miss_Registered",
      "conditions": [
        "window.__3D_STATE__.missCount > 0",
        "window.__3D_STATE__.currentCombo === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Combo_Active",
      "conditions": [
        "window.__3D_STATE__.currentCombo >= 2",
        "window.__3D_STATE__.whackCount >= 2"
      ]
    },
    {
      "id": "S6",
      "name": "Combo_Bonus",
      "conditions": [
        "window.__3D_STATE__.currentCombo >= 3",
        "window.__3D_STATE__.maxCombo >= 3"
      ]
    },
    {
      "id": "S7",
      "name": "Particles_Flying",
      "conditions": [
        "window.__3D_STATE__.particlesAlive > 0",
        "window.__3D_STATE__.totalParticlesSpawned > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Timer_Low",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.timeRemaining <= 5",
        "window.__3D_STATE__.timeRemaining > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'",
        "window.__3D_STATE__.timeRemaining === 0"
      ]
    }
  ],
