        "#btnSnapshot"
      ]
    },
    {
      "id": "A9",
      "name": "SelectedDepthDisplay",
      "type": "dom_element",
      "semantic": "Shows selected branch depth level",
      "locator_hints": [
        "#selectedDepth"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Gen0",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalBranches === 0",
        "window.__3D_STATE__.colorTheme === 'natural'",
        "window.__3D_STATE__.leavesVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Gen1_Growing",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.isGrowing === true"
      ]
    },
    {
      "id": "S2",
      "name": "Gen1_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.growthProgress === 1.0",
        "window.__3D_STATE__.totalBranches > 0",
        "window.__3D_STATE__.isGrowing === false"
      ]
    },
    {
      "id": "S3",
      "name": "Gen2_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.growthProgress === 1.0",
        "window.__3D_STATE__.totalBranches > window.__3D_STATE__._prevBranches"
      ]
    },
    {
      "id": "S4",
      "name": "Theme_Autumn",
      "conditions": [
        "window.__3D_STATE__.colorTheme === 'autumn'"
      ]
    },
    {
      "id": "S5",
      "name": "Leaves_Hidden",
      "conditions": [
        "window.__3D_STATE__.leavesVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "Snapshot_Taken",
      "conditions": [
        "window.__3D_STATE__.snapshotTaken === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalBranches === 0",
        "window.__3D_STATE__.totalLeaves === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Angle !== before.Angle || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.Angle === 'number' && !isNaN(window.__3D_STATE__.Angle)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Symbols)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
