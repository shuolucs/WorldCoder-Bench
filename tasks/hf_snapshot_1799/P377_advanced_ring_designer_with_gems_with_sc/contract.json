{
  "task_id": "P377_advanced_ring_designer_with_gems_with_sc",
  "affordances": [
    {
      "id": "A1",
      "name": "Ring",
      "type": "3d_object",
      "semantic": "Gold torus ring at origin that holds gem slots",
      "locator_hints": [
        "TorusGeometry",
        "gold material"
      ]
    },
    {
      "id": "A2",
      "name": "HelmetModel",
      "type": "3d_object",
      "semantic": "GLTF model loaded as decorative centerpiece above ring",
      "locator_hints": [
        "DamagedHelmet.glb",
        "position y=2"
      ]
    },
    {
      "id": "A3",
      "name": "GemSlots",
      "type": "3d_object",
      "semantic": "6 small spheres around the ring representing gem slots",
      "locator_hints": [
        "SphereGeometry",
        "radius 0.08"
      ]
    },
    {
      "id": "A4",
      "name": "RubyButton",
      "type": "dom_element",
      "semantic": "Button to select ruby gem type",
      "locator_hints": [
        "#btn-ruby"
      ]
    },
    {
      "id": "A5",
      "name": "DiamondButton",
      "type": "dom_element",
      "semantic": "Button to select diamond gem type",
      "locator_hints": [
        "#btn-diamond"
      ]
    },
    {
      "id": "A6",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to clear all gems and reset",
      "locator_hints": [
        "#btn-clear"
      ]
    },
    {
      "id": "A7",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Button to fill empty slots with random gems",
      "locator_hints": [
        "#btn-randomize"
      ]
    },
    {
      "id": "A8",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing design score",
      "locator_hints": [
        "#score-display"
      ]
    },
    {
      "id": "A9",
      "name": "GemCountDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing gems placed count",
      "locator_hints": [
        "#gem-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.gemsPlaced === 0",
        "window.__3D_STATE__.designComplete === false",
        "window.__3D_STATE__.selectedGemType === null"
      ]
    },
    {
      "id": "S1",
      "name": "GemTypeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedGemType !== null",
        "typeof window.__3D_STATE__.selectedGemType === 'string'"
      ]
    },
    {
      "id": "S2",
      "name": "FirstGemPlaced",
      "conditions": [
        "window.__3D_STATE__.gemsPlaced === 1",
        "window.__3D_STATE__.totalScore > 0",
        "window.__3D_STATE__.gemSlots[0] !== null"
      ]
    },
    {
      "id": "S3",
      "name": "AllGemsRandomized",
      "conditions": [
        "window.__3D_STATE__.gemsPlaced === 6",
        "window.__3D_STATE__.totalScore >= 60",
        "window.__3D_STATE__.designComplete === true"
      ]
    },
    {
      "id": "S4",
      "name": "Cleared",
      "conditions": [
        "window.__3D_STATE__.gemsPlaced === 0",
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.designComplete === false"
      ]
    },
    {
      "id": "S5",
      "name": "DiamondSelected",
      "conditions": [
        "window.__3D_STATE__.selectedGemType === 'diamond'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-ruby"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalScore !== before.totalScore || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalScore === 'number' && !isNaN(window.__3D_STATE__.totalScore)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.gemsPlaced === 'number' && !isNaN(window.__3D_STATE__.gemsPlaced)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.gemSlots)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalScore >= 0",
            "tier": "L2"
          }
        ]
      }
    },
