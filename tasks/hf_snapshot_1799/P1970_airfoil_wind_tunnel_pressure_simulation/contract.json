{
  "task_id": "P1970_airfoil_wind_tunnel_pressure_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "Airfoil",
      "type": "3d_object",
      "semantic": "NACA-style airfoil body with pressure-mapped vertex colors inside the wind tunnel",
      "locator_hints": [
        "airfoil mesh in scene",
        "extruded airfoil geometry"
      ]
    },
    {
      "id": "A2",
      "name": "WindTunnel",
      "type": "3d_object",
      "semantic": "Semi-transparent rectangular tunnel enclosure",
      "locator_hints": [
        "wireframe or transparent box"
      ]
    },
    {
      "id": "A3",
      "name": "StreamlineParticles",
      "type": "3d_object",
      "semantic": "200 small spheres representing airflow streamlines",
      "locator_hints": [
        "particle group",
        "sphere instances"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation parameters",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset AOA and wind speed to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleParticlesButton",
      "type": "dom_element",
      "semantic": "Button to show/hide streamline particles",
      "locator_hints": [
        "#toggleParticlesBtn"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.angleOfAttack === 0",
        "window.__3D_STATE__.windSpeed === 20",
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.isStalled === false"
      ]
    },
    {
      "id": "S1",
      "name": "AOAIncreased",
      "conditions": [
        "window.__3D_STATE__.angleOfAttack > 0",
        "window.__3D_STATE__.isStalled === false"
      ]
    },
    {
      "id": "S2",
      "name": "WindSpeedChanged",
      "conditions": [
        "window.__3D_STATE__.windSpeed !== 20"
      ]
    },
    {
      "id": "S3",
      "name": "StalledState",
      "conditions": [
        "Math.abs(window.__3D_STATE__.angleOfAttack) > 12",
        "window.__3D_STATE__.isStalled === true"
      ]
    },
    {
      "id": "S4",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.angleOfAttack === 0",
        "window.__3D_STATE__.windSpeed === 20"
      ]
    },
    {
      "id": "S6",
      "name": "NegativeAOA",
      "conditions": [
        "window.__3D_STATE__.angleOfAttack < 0",
        "window.__3D_STATE__.isStalled === false"
      ]
    },
    {
      "id": "S7",
      "name": "HighSpeedState",
      "conditions": [
        "window.__3D_STATE__.windSpeed === 50"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.angleOfAttack === 'number' && window.__3D_STATE__.angleOfAttack === 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.windSpeed === 'number' && window.__3D_STATE__.windSpeed === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dynamicPressure !== undefined && Math.abs(window.__3D_STATE__.dynamicPressure - 0.5 * 1.225 * 20 * 20) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesVisible === true && window.__3D_STATE__.isStalled === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "count": 5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.angleOfAttack === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isStalled === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.liftCoefficient - 2 * Math.PI * (5 * Math.PI / 180)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liftForce > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.liftForce === 'number' && !isNaN(window.__3D_STATE__.liftForce)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 4
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windSpeed === 40",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dynamicPressure - 0.5 * 1.225 * 40 * 40) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liftForce > 0 && !isNaN(window.__3D_STATE__.liftForce)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudSpeed') !== null && document.getElementById('hudSpeed').textContent.includes('40')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudQ') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "count": 8
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.angleOfAttack === 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isStalled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.liftCoefficient - 0.8 * Math.sin(2 * 13 * Math.PI / 180)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudStall') !== null && document.getElementById('hudStall').textContent.includes('Yes')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudAOA') !== null && document.getElementById('hudAOA').textContent.includes('13')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#toggleParticlesBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particlesVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.angleOfAttack === 13",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isStalled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.angleOfAttack === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windSpeed === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isStalled === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dynamicPressure - 0.5 * 1.225 * 20 * 20) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hudAOA').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown",
        "count": 8
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.angleOfAttack === -8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liftCoefficient < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liftForce < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isStalled === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.liftCoefficient - 2 * Math.PI * (-8 * Math.PI / 180)) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 10
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windSpeed === 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dynamicPressure - 0.5 * 1.225 * 50 * 50) < 3.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.liftForce === 'number' && !isNaN(window.__3D_STATE__.liftForce)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tunnelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.airfoilVertexCount >= 60",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}