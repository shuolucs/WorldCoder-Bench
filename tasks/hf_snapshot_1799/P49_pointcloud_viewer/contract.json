{
  "task_id": "P49_pointcloud_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "PointCloud",
      "type": "3d_object",
      "semantic": "100k Points + ShaderMaterial",
      "locator_hints": [
        "Points",
        "point cloud"
      ]
    },
    {
      "id": "A2",
      "name": "ColorModeSelect",
      "type": "dom_element",
      "semantic": "颜色模式",
      "locator_hints": [
        "colorMode"
      ]
    },
    {
      "id": "A3",
      "name": "PointSizeSlider",
      "type": "dom_element",
      "semantic": "点大小",
      "locator_hints": [
        "pointSize"
      ]
    },
    {
      "id": "A4",
      "name": "ClipMin",
      "type": "dom_element",
      "semantic": "Y 裁剪下限",
      "locator_hints": [
        "clipMin"
      ]
    },
    {
      "id": "A5",
      "name": "ClipMax",
      "type": "dom_element",
      "semantic": "Y 裁剪上限",
      "locator_hints": [
        "clipMax"
      ]
    },
    {
      "id": "A6",
      "name": "ShowBBox",
      "type": "dom_element",
      "semantic": "包围盒显示",
      "locator_hints": [
        "showBBox"
      ]
    },
    {
      "id": "A7",
      "name": "MainCanvas",
      "type": "dom_element",
      "semantic": "WebGL 画布",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "点云加载"
    },
    {
      "id": "S1",
      "name": "init_ok",
      "description": "100000 点"
    },
    {
      "id": "S2",
      "name": "clipped",
      "description": "裁剪后 visible 减少"
    },
    {
      "id": "S3",
      "name": "color_changed",
      "description": "颜色模式改变"
    },
    {
      "id": "S4",
      "name": "size_changed",
      "description": "点大小改变"
    },
    {
      "id": "S5",
      "name": "bbox_toggled",
      "description": "包围盒切换"
    },
    {
      "id": "S6",
      "name": "stable_30s",
      "description": "30s 稳定"
    },
    {
      "id": "S7",
      "name": "stable_60s",
      "description": "60s 稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "totalPoints===100000",
        "bbox 有限",
        "visiblePoints 在有效范围"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints <= 100000",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boundingBox.min.x) && isFinite(window.__3D_STATE__.boundingBox.max.x)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boundingBox.min.y) && isFinite(window.__3D_STATE__.boundingBox.max.y)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boundingBox.min.z) && isFinite(window.__3D_STATE__.boundingBox.max.z)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalPoints)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "eval",
        "code": "(function(){ var a=document.getElementById('clipMin'); var b=document.getElementById('clipMax'); if(a&&b){ var lo=parseFloat(a.min||-10), hi=parseFloat(b.max||10); var mid=(lo+hi)*0.5; a.value=String(mid-0.1); b.value=String(mid+0.1); a.dispatchEvent(new Event('input',{bubbles:true})); b.dispatchEvent(new Event('input',{bubbles:true})); } })()",
        "wait_ms": 800
      },
      "postconditions": [
        "收紧裁剪后 visiblePoints < totalPoints"
      ],
      "severity": "P0",
      "_note": "若默认 clip 已很窄，实现应保证滑块能进一步减少可见点。",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.visiblePoints < window.__3D_STATE__.totalPoints",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints !== before.visiblePoints",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.visiblePoints)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "eval",
        "code": "(function(){ var s=document.getElementById('colorMode'); if(!s)return; var cur=s.value; var opts=['uniform','height','distance-from-center']; var i=Math.max(0,opts.indexOf(cur)); var next=opts[(i+1)%opts.length]; s.value=next; s.dispatchEvent(new Event('change',{bubbles:true})); })()",
        "wait_ms": 500
      },
      "postconditions": [
        "colorMode 改变"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode !== before.colorMode",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorMode.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_input",
        "selector": "#pointSize",
        "value": "3.5"
      },
      "postconditions": [
        "pointSize 接近 3.5"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.pointSize - 3.5) < 0.6",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.pointSize)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointSize > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "dom_click",
        "selector": "#showBBox"
      },
      "postconditions": [
        "包围盒状态可探测"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 400,
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.boundingBox.min.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boundingBox.max.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints >= 0 && window.__3D_STATE__.visiblePoints <= 100000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "wait",
        "duration_ms": 30000
      },
      "postconditions": [
        "30s 无 NaN"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "!isNaN(window.__3D_STATE__.visiblePoints)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.clipRange.min) && isFinite(window.__3D_STATE__.clipRange.max)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints <= 100000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 30000
      },
      "postconditions": [
        "60s 稳定"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints <= window.__3D_STATE__.totalPoints",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visiblePoints >= 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.pointSize)",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalPoints)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "clipRange 与 DOM 一致趋势"
      ],
      "severity": "P2",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.clipRange === 'object'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.clipRange.min)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.clipRange.max)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalPoints === 100000",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}