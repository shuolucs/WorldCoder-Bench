  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.morphA === 1",
        "window.__3D_STATE__.morphB === 0",
        "window.__3D_STATE__.morphC === 0",
        "window.__3D_STATE__.amplitude === 1.0",
        "window.__3D_STATE__.frequency === 2.0",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.activePreset === 'A'"
      ]
    },
    {
      "id": "S1",
      "name": "MorphPresetB",
      "conditions": [
        "window.__3D_STATE__.morphA === 0",
        "window.__3D_STATE__.morphB === 1",
        "window.__3D_STATE__.morphC === 0",
        "window.__3D_STATE__.activePreset === 'B'"
      ]
    },
    {
      "id": "S2",
      "name": "BlendMode",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Blend'",
        "Math.abs(window.__3D_STATE__.normalizedWeights.a + window.__3D_STATE__.normalizedWeights.b + window.__3D_STATE__.normalizedWeights.c - 1.0) < 0.001"
      ]
    },
    {
      "id": "S3",
      "name": "AmplitudeIncreased",
      "conditions": [
        "window.__3D_STATE__.amplitude > 1.0",
        "window.__3D_STATE__.amplitude <= 3.0"
      ]
    },
    {
      "id": "S4",
      "name": "ColorModeCycled",
      "conditions": [
        "window.__3D_STATE__.colorMode === 1"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "FrequencyChanged",
      "conditions": [
        "window.__3D_STATE__.frequency !== 2.0",
        "window.__3D_STATE__.frequency >= 0.5",
        "window.__3D_STATE__.frequency <= 6.0"
      ]
    },
    {
      "id": "S7",
      "name": "SnapshotTaken",
      "conditions": [
        "window.__3D_STATE__.snapshotHeight > 0"
      ]
    },
    {
      "id": "S8",
      "name": "MorphPresetC",
      "conditions": [
        "window.__3D_STATE__.morphA === 0",
        "window.__3D_STATE__.morphB === 0",
        "window.__3D_STATE__.morphC === 1",
        "window.__3D_STATE__.activePreset === 'C'"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.morphA === 1",
        "window.__3D_STATE__.morphB === 0",
        "window.__3D_STATE__.morphC === 0",
        "window.__3D_STATE__.amplitude === 1.0",
        "window.__3D_STATE__.frequency === 2.0",
        "window.__3D_STATE__.colorMode === 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.activePreset === 'A'"
      ]
    }
  ],
