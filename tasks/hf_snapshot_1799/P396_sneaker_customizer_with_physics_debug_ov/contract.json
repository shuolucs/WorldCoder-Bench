  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.physicsActive === false",
        "window.__3D_STATE__.isGrounded === false",
        "Math.abs(window.__3D_STATE__.positionY - 1.0) < 0.1"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChanged_Red",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#ff3333'"
      ]
    },
    {
      "id": "S2",
      "name": "ColorChanged_Blue",
      "conditions": [
        "window.__3D_STATE__.currentColor === '#3333ff'"
      ]
    },
    {
      "id": "S3",
      "name": "PhysicsDrop_Active",
      "conditions": [
        "window.__3D_STATE__.physicsActive === true",
        "window.__3D_STATE__.velocityY < 0"
      ]
    },
    {
      "id": "S4",
      "name": "SneakerGrounded",
      "conditions": [
        "window.__3D_STATE__.isGrounded === true",
        "window.__3D_STATE__.physicsActive === false"
      ]
    },
    {
      "id": "S5",
      "name": "DebugVisible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "ScaleModified",
      "conditions": [
        "Math.abs(window.__3D_STATE__.modelScale - 1.5) < 0.15"
      ]
    },
    {
      "id": "S8",
      "name": "ResetAfterDrop",
      "conditions": [
        "Math.abs(window.__3D_STATE__.positionY - 1.0) < 0.1",
        "window.__3D_STATE__.physicsActive === false",
        "window.__3D_STATE__.bounceCount === 0"
      ]
    }
  ],
