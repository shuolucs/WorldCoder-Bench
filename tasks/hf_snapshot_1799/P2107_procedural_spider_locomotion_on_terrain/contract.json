      "conditions": [
        "window.__3D_STATE__.spiderSpeed < 4.0"
      ]
    },
    {
      "id": "S8",
      "name": "SpiderReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.spiderPosition.x - 5) < 0.5",
        "window.__3D_STATE__.totalStepsTaken === 0"
      ]
    },
    {
      "id": "S9",
      "name": "DebugEnabled",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S10",
