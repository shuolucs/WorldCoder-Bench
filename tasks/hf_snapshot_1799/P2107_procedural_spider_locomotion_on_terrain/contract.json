      ]
    },
    {
      "id": "S4",
      "name": "GaitSwitchedToWave",
      "conditions": [
        "window.__3D_STATE__.gaitMode === 'wave'"
      ]
    },
    {
      "id": "S5",
      "name": "WaveGaitActive",
      "conditions": [
        "window.__3D_STATE__.gaitMode === 'wave'",
        "window.__3D_STATE__.legsCurrentlyStepping <= 1"
      ]
