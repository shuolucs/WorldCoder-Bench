  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.glbLoaded === true",
        "window.__3D_STATE__.frameCount > 0",
        "window.__3D_STATE__.legPositionsValid === true"
      ]
    },
    {
      "id": "S1",
      "name": "SpiderMovingForward",
      "conditions": [
        "window.__3D_STATE__.isMoving === true",
        "window.__3D_STATE__.spiderPosition.z !== 5"
      ]
    },
    {
      "id": "S2",
      "name": "StepsTaken",
      "conditions": [
        "window.__3D_STATE__.totalStepsTaken > 0"
      ]
    },
    {
