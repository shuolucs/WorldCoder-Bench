  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Level1",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.activeAttractors === 1"
      ]
    },
    {
      "id": "S2",
      "name": "Level3_Active",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.activeAttractors === 3"
      ]
    },
    {
      "id": "S3",
      "name": "Level5_Active",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.activeAttractors === 5"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed_From_Pause",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "Repulsor_Active",
      "conditions": [
        "window.__3D_STATE__.repulsorCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "Camera_Top",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'top'"
      ]
    },
    {
      "id": "S8",
      "name": "Camera_Free",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'free'"
      ]
    },
    {
      "id": "S9",
      "name": "Snapshot_Taken",
      "conditions": [
        "window.__3D_STATE__.snapshotCentroid !== null"
      ]
    },
    {
      "id": "S10",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.activeAttractors === 1"
      ]
    }
  ],
