      "conditions": [
        "window.__3D_STATE__.dartsThrown === 3",
        "window.__3D_STATE__.dartsRemaining === 3",
        "window.__3D_STATE__.currentRound === 2"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyTwoReached",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel >= 2",
        "window.__3D_STATE__.totalScore >= 50"
      ]
    },
    {
      "id": "S5",
      "name": "HelmetVisible",
      "conditions": [
        "window.__3D_STATE__.totalScore >= 100",
        "window.__3D_STATE__.helmetVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyThreeReached",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.totalScore >= 150"
      ]
    },
    {
      "id": "S7",
      "name": "AllDartsThrown",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 9",
        "window.__3D_STATE__.gameOver === true"
      ]
    },
    {
      "id": "S8",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.currentRound === 1",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.difficultyLevel === 1"
      ]
    }
