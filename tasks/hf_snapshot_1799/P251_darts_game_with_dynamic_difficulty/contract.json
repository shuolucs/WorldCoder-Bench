  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalScore === 0",
        "window.__3D_STATE__.currentRound === 1",
        "window.__3D_STATE__.dartsRemaining === 3",
        "window.__3D_STATE__.dartsThrown === 0",
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.helmetVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "FirstDartThrown",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 1",
        "window.__3D_STATE__.dartsRemaining === 2",
        "window.__3D_STATE__.currentRound === 1"
      ]
    },
    {
      "id": "S2",
      "name": "SecondDartThrown",
      "conditions": [
        "window.__3D_STATE__.dartsThrown === 2",
        "window.__3D_STATE__.dartsRemaining === 1"
