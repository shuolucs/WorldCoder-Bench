            "expr": "Math.abs(window.__3D_STATE__.anchorPositions[0].x - (-3.5)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.anchorPositions[0].y - 10) < 0.01",
            "tier": "L2"
          },
