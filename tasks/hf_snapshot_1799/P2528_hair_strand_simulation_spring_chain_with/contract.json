{
  "task_id": "P2528_hair_strand_simulation_spring_chain_with",
  "affordances": [
    {
      "id": "A1",
      "name": "HairStrands",
      "type": "3d_object",
      "semantic": "8 hair strands each with 16 spring-connected particles simulated via Verlet integration",
      "locator_hints": [
        "strandCount === 8",
        "particlesPerStrand === 16"
      ]
    },
    {
      "id": "A2",
      "name": "LittlestTokyoModel",
      "type": "3d_object",
      "semantic": "GLTF model loaded as collision environment",
      "locator_hints": [
        "modelLoaded === true"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing time scale, pause state, gravity mode, wind, energy",
      "locator_hints": [
        "position: absolute",
        "top-left"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A5",
      "name": "WindButton",
      "type": "dom_element",
      "semantic": "Button to toggle wind",
      "locator_hints": [
        "#windBtn"
      ]
    },
    {
      "id": "A6",
      "name": "TimeControl",
      "type": "3d_object",
      "semantic": "Time scale and pause system controlled by keyboard",
      "locator_hints": [
        "timeScale",
        "paused"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initializing",
      "conditions": [
        "window.__3D_STATE__ === undefined || window.__3D_STATE__.initialized !== true"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "TimeScaleModified",
      "conditions": [
        "window.__3D_STATE__.timeScale !== 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S4",
      "name": "GravityChanged",
      "conditions": [
        "window.__3D_STATE__.gravityMode !== 'down'"
      ]
    },
    {
      "id": "S5",
      "name": "WindActive",
      "conditions": [
        "window.__3D_STATE__.windActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "SnapshotSaved",
      "conditions": [
        "window.__3D_STATE__.snapshotCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.undoCount > 0"
      ]
    },
    {
      "id": "S8",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.redoCount > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.gravityMode === 'down'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.strandCount === 8",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.particlesPerStrand === 16",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelBBoxCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
