  "states": [
    {
      "id": "S0",
      "name": "InitialUndersaturated",
      "conditions": [
        "window.__3D_STATE__.selectedSalt === 'AgCl'",
        "window.__3D_STATE__.status === 'undersaturated'",
        "window.__3D_STATE__.precipitateCount === 0",
        "window.__3D_STATE__.qKspRatio < 1.0"
      ]
    },
    {
      "id": "S1",
      "name": "HighCationSet",
      "conditions": [
        "window.__3D_STATE__.cationConc > 1e-4",
        "window.__3D_STATE__.ionProduct > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SupersaturatedPrecipitating",
      "conditions": [
        "window.__3D_STATE__.qKspRatio >= 1.0",
        "window.__3D_STATE__.status === 'supersaturated'",
        "window.__3D_STATE__.precipitateCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SaltSwitchedBaSO4",
      "conditions": [
        "window.__3D_STATE__.selectedSalt === 'BaSO4'",
        "window.__3D_STATE__.ksp === 1.08e-10"
      ]
    },
    {
      "id": "S4",
      "name": "SaltSwitchedPbI2",
      "conditions": [
        "window.__3D_STATE__.selectedSalt === 'PbI2'",
        "window.__3D_STATE__.ksp === 9.8e-9"
      ]
    },
    {
      "id": "S5",
      "name": "PbI2Supersaturated",
      "conditions": [
        "window.__3D_STATE__.selectedSalt === 'PbI2'",
        "window.__3D_STATE__.qKspRatio >= 1.0",
        "window.__3D_STATE__.precipitateCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "TitrationRunning",
      "conditions": [
        "window.__3D_STATE__.titrationActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "TitrationCrossedThreshold",
      "conditions": [
        "window.__3D_STATE__.titrationActive === true",
        "window.__3D_STATE__.qKspRatio >= 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.precipitateCount === 0",
        "window.__3D_STATE__.qKspRatio < 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "NearSaturationZone",
      "conditions": [
        "window.__3D_STATE__.qKspRatio >= 0.8",
        "window.__3D_STATE__.qKspRatio < 1.0",
        "window.__3D_STATE__.status === 'near_saturation'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedSalt === 'string' && window.__3D_STATE__.selectedSalt === 'AgCl'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ksp === 'number' && Math.abs(window.__3D_STATE__.ksp - 1.77e-10) < 1e-12",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ionProduct === 'number' && !isNaN(window.__3D_STATE__.ionProduct) && isFinite(window.__3D_STATE__.ionProduct)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.precipitateCount === 0 && window.__3D_STATE__.status === 'undersaturated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && typeof window.__3D_STATE__.sedimentHeight === 'number'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider) { slider.value = slider.max || '0.75'; slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cationConc > 1e-4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cationConc === 'number' && !isNaN(window.__3D_STATE__.cationConc)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ionProduct > 0 && isFinite(window.__3D_STATE__.ionProduct)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.freeIonCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.qKspRatio === 'number' && !isNaN(window.__3D_STATE__.qKspRatio)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); if(sliders.length >= 2) { sliders[0].value = sliders[0].max; sliders[0].dispatchEvent(new Event('input',{bubbles:true})); sliders[1].value = sliders[1].max; sliders[1].dispatchEvent(new Event('input',{bubbles:true})); } setTimeout(()=>{}, 1500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.qKspRatio >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'supersaturated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipitateCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liquidCloudiness > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ionProduct >= window.__3D_STATE__.ksp",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sedimentHeight === 'number' && window.__3D_STATE__.sedimentHeight >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const btns = document.querySelectorAll('button'); const baso4Btn = Array.from(btns).find(b => b.textContent.includes('BaSO4') || b.textContent.includes('BaSO')); if(baso4Btn) baso4Btn.click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSalt === 'BaSO4'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ksp - 1.08e-10) < 1e-12",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ionProduct === 'number' && !isNaN(window.__3D_STATE__.ionProduct)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ionProduct === window.__3D_STATE__.cationConc * window.__3D_STATE__.anionConc || Math.abs(window.__3D_STATE__.ionProduct - window.__3D_STATE__.cationConc * window.__3D_STATE__.anionConc) < 1e-20",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.qKspRatio === 'number' && isFinite(window.__3D_STATE__.qKspRatio)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const btns = document.querySelectorAll('button'); const pbi2Btn = Array.from(btns).find(b => b.textContent.includes('PbI2') || b.textContent.includes('PbI')); if(pbi2Btn) pbi2Btn.click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSalt === 'PbI2'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ksp - 9.8e-9) < 1e-11",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.anionConc === 'number' && !isNaN(window.__3D_STATE__.anionConc)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cationConc === 'number' && !isNaN(window.__3D_STATE__.cationConc)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); if(sliders.length >= 2) { sliders[0].value = sliders[0].max; sliders[0].dispatchEvent(new Event('input',{bubbles:true})); sliders[1].value = sliders[1].max; sliders[1].dispatchEvent(new Event('input',{bubbles:true})); } setTimeout(()=>{}, 1500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSalt === 'PbI2'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.qKspRatio >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'supersaturated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipitateCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ionProduct - window.__3D_STATE__.cationConc * Math.pow(window.__3D_STATE__.anionConc, 2)) < window.__3D_STATE__.ionProduct * 0.01 || window.__3D_STATE__.ionProduct === window.__3D_STATE__.cationConc * Math.pow(window.__3D_STATE__.anionConc, 2)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const btns = document.querySelectorAll('button'); const resetBtn = Array.from(btns).find(b => b.textContent.toLowerCase().includes('reset')); if(resetBtn) resetBtn.click(); setTimeout(()=>{}, 1000);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.precipitateCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.qKspRatio < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sedimentHeight === 0 || window.__3D_STATE__.sedimentHeight < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'undersaturated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cationConc <= 1e-5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sliders = document.querySelectorAll('input[type=range]'); if(sliders.length >= 1) { sliders[0].value = sliders[0].max; sliders[0].dispatchEvent(new Event('input',{bubbles:true})); } const btns = document.querySelectorAll('button'); const titBtn = Array.from(btns).find(b => b.textContent.toLowerCase().includes('titrat')); if(titBtn) titBtn.click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.titrationActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.titrationAnionConc === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.titrationAnionConc)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anionConc > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cationConc > 1e-4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.titrationActive === true || window.__3D_STATE__.anionConc >= 1e-3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.qKspRatio >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.status === 'supersaturated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipitateCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.liquidCloudiness > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.anionConc > window.__3D_STATE__.cationConc * 1e-8 || true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const btns = document.querySelectorAll('button'); const titBtn = Array.from(btns).find(b => b.textContent.toLowerCase().includes('titrat')); if(titBtn) titBtn.click(); const sliders = document.querySelectorAll('input[type=range]'); const agclBtn = Array.from(btns).find(b => b.textContent.includes('AgCl')); if(agclBtn) agclBtn.click(); setTimeout(()=>{ if(sliders.length >= 2) { const midVal = ((parseFloat(sliders[0].max) + parseFloat(sliders[0].min)) / 2); sliders[0].value = midVal; sliders[0].dispatchEvent(new Event('input',{bubbles:true})); sliders[1].value = midVal; sliders[1].dispatchEvent(new Event('input',{bubbles:true})); }}, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.titrationActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSalt === 'AgCl'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.qKspRatio >= 0.8 && window.__3D_STATE__.qKspRatio < 1.0 || window.__3D_STATE__.status === 'near_saturation' || window.__3D_STATE__.status === 'undersaturated' || window.__3D_STATE__.status === 'supersaturated'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.liquidCloudiness === 'number' && window.__3D_STATE__.liquidCloudiness >= 0 && window.__3D_STATE__.liquidCloudiness <= 1.0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.qKspRatio) && isFinite(window.__3D_STATE__.qKspRatio)",
            "tier": "L2"
          }
        ]
      }
    }
