{
  "task_id": "P578_conveyor_belt",
  "affordances": [
    {"id": "A1", "name": "ConveyorBelt", "type": "3d_object", "semantic": "Moving belt surface that transports items from left to right", "locator_hints": ["belt", "conveyor", "box", "surface"]},
    {"id": "A2", "name": "SortingItem", "type": "3d_object", "semantic": "GLB item (BoxAnimated, Duck, or WaterBottle) riding on the belt", "locator_hints": ["item", "product", "box", "duck", "bottle"]},
    {"id": "A3", "name": "SortingBins", "type": "3d_object", "semantic": "Three color-coded collection bins for sorted items", "locator_hints": ["bin", "container", "basket"]},
    {"id": "A4", "name": "Diverter", "type": "3d_object", "semantic": "Paddle mechanism that pushes items into bins", "locator_hints": ["diverter", "paddle", "pusher"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Top-left overlay showing score, correct/wrong/missed counts", "locator_hints": ["hud", "overlay"]},
    {"id": "A6", "name": "SliderBeltSpeed", "type": "dom_element", "semantic": "Slider controlling belt movement speed", "locator_hints": ["slider-beltspeed"]},
    {"id": "A7", "name": "SliderSpawnRate", "type": "dom_element", "semantic": "Slider controlling interval between item spawns", "locator_hints": ["slider-spawnrate"]}
  ],
  "states": [
    {"id": "S0", "name": "initial_running", "conditions": ["window.__3D_STATE__.score === 0", "window.__3D_STATE__.itemsSpawned === 0 || window.__3D_STATE__.itemsSpawned <= 2"]},
    {"id": "S1", "name": "items_moving", "conditions": ["window.__3D_STATE__.itemsSpawned > 0", "window.__3D_STATE__.itemsOnBelt >= 0"]},
    {"id": "S2", "name": "sorting_happened", "conditions": ["window.__3D_STATE__.correctSorts + window.__3D_STATE__.wrongSorts + window.__3D_STATE__.missedItems > 0"]},
    {"id": "S3", "name": "belt_speed_changed", "conditions": ["window.__3D_STATE__.beltSpeed !== 2.0"]}
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
          {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.score === 'number'", "tier": "L0"},
          {"expr": "typeof window.__3D_STATE__.beltSpeed === 'number' && window.__3D_STATE__.beltSpeed > 0", "tier": "L1"},
          {"expr": "typeof window.__3D_STATE__.isValid === 'boolean' && window.__3D_STATE__.isValid === true", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.itemsSpawned > 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.itemsOnBelt >= 0", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount + 60", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {"type": "keyboard", "key": "1"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.diverterActive === 'A' || window.__3D_STATE__.diverterActive === 'none'", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {"type": "wait", "duration_ms": 12000},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.itemsSpawned > before.itemsSpawned", "tier": "L1"},
          {"expr": "window.__3D_STATE__.correctSorts + window.__3D_STATE__.wrongSorts + window.__3D_STATE__.missedItems > 0", "tier": "L1"},
          {"expr": "typeof window.__3D_STATE__.score === 'number'", "tier": "L1"},
          {"expr": "window.__3D_STATE__.lastSortResult === 'correct' || window.__3D_STATE__.lastSortResult === 'wrong' || window.__3D_STATE__.lastSortResult === 'miss'", "tier": "L1"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-beltspeed').value = 4.5; document.getElementById('slider-beltspeed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "Math.abs(window.__3D_STATE__.beltSpeed - 4.5) < 0.6", "tier": "L2"},
          {"expr": "window.__3D_STATE__.beltSpeed > before.beltSpeed", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {"type": "keyboard", "key": "3"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.diverterActive === 'C' || window.__3D_STATE__.diverterActive === 'none'", "tier": "L1"},
          {"expr": "window.__3D_STATE__.frameCount > before.frameCount", "tier": "L0"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S0",
      "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {"expr": "window.__3D_STATE__.score === 0", "tier": "L2"},
          {"expr": "window.__3D_STATE__.correctSorts === 0 && window.__3D_STATE__.wrongSorts === 0 && window.__3D_STATE__.missedItems === 0", "tier": "L2"},
          {"expr": "window.__3D_STATE__.itemsSpawned === 0", "tier": "L2"},
          {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
        ]
      }
    }
  ]
}
