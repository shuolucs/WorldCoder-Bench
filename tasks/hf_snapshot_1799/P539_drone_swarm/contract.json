{
  "task_id": "P539_drone_swarm",
  "affordances": [
    {"id": "A1", "name": "Drones", "type": "3d_object", "semantic": "8 drone meshes with rotors", "locator_hints": ["box meshes with cylinder children"]},
    {"id": "A2", "name": "SpeedSlider", "type": "dom_element", "semantic": "Max speed control", "locator_hints": ["#slider-speed"]},
    {"id": "A3", "name": "SeparationSlider", "type": "dom_element", "semantic": "Separation distance", "locator_hints": ["#slider-separation"]},
    {"id": "A4", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial_Circle", "conditions": ["window.__3D_STATE__.droneCount === 8", "window.__3D_STATE__.formation === 'circle'"]},
    {"id": "S1", "name": "Converging", "conditions": ["window.__3D_STATE__.avgDistToTarget > 0"]},
    {"id": "S2", "name": "LineFormation", "conditions": ["window.__3D_STATE__.formation === 'line'"]},
    {"id": "S3", "name": "VFormation", "conditions": ["window.__3D_STATE__.formation === 'v-shape'"]},
    {"id": "S4", "name": "LeaderMode", "conditions": ["window.__3D_STATE__.leaderMode === true"]},
    {"id": "S5", "name": "Paused", "conditions": ["window.__3D_STATE__.isPaused === true"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.droneCount === 8", "tier": "L2"},
        {"expr": "window.__3D_STATE__.formation === 'circle'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.dronesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgDistToTarget < before.avgDistToTarget || window.__3D_STATE__.converged === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.minSeparation > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.dronesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "2"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.formation === 'line'", "tier": "L2"},
        {"expr": "document.getElementById('hud-formation').textContent.includes('line')", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "3"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.formation === 'v-shape'", "tier": "L2"},
        {"expr": "document.getElementById('hud-formation').textContent.includes('v-shape')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "l"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.leaderMode === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-leader').textContent.includes('ON')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S5", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-paused').textContent.includes('Paused')", "tier": "L2"}
      ]}
    },
    {
      "id": "T7", "from": "S5", "to": "S5", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-speed').value = 15; document.getElementById('slider-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.maxSpeed === 15", "tier": "L2"}
      ]}
    }
  ]
}
