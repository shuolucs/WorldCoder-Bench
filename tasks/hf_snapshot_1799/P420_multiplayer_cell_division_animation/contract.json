  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'interphase'",
        "window.__3D_STATE__.player2Phase === 'interphase'",
        "window.__3D_STATE__.totalCellCount === 2",
        "window.__3D_STATE__.animationSpeed === 1"
      ]
    },
    {
      "id": "S1",
      "name": "P1Prophase",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'prophase'",
        "window.__3D_STATE__.player2Phase === 'interphase'"
      ]
    },
    {
      "id": "S2",
      "name": "P1Metaphase",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'metaphase'"
      ]
    },
    {
      "id": "S3",
      "name": "P2ProphaseStarted",
      "conditions": [
        "window.__3D_STATE__.player2Phase === 'prophase'"
      ]
    },
    {
      "id": "S4",
      "name": "P1Complete",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'complete'",
        "window.__3D_STATE__.player1CellCount === 2"
      ]
    },
    {
      "id": "S5",
      "name": "BothAdvanced",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'complete'",
        "window.__3D_STATE__.player2Phase !== 'interphase'"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.animationSpeed !== 1"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.player1Phase === 'interphase'",
        "window.__3D_STATE__.player2Phase === 'interphase'",
        "window.__3D_STATE__.totalCellCount === 2"
      ]
    }
  ],
  "transitions": [
