      "action": {
        "type": "script",
        "code": "/* Simulate moving sofa to (0, 0) inside room via drag */ const event = new CustomEvent('furniture-move', {detail: {name: 'sofa', x: 0, z: 0}}); document.dispatchEvent(event); /* fallback: directly set position if custom event not supported */ if(window.__3D_STATE__.furniturePositions.sofa.x !== 0) { window.moveFurniture && window.moveFurniture('sofa', 0, 0); }",
        "description": "Drag sofa to center of room (0, 0)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.furniturePositions.sofa.inRoom === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions.sofa.x % 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.furniturePositions.sofa.z % 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.furnitureCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'move'",
            "tier": "L2"
          }
        ]
      }
    },
