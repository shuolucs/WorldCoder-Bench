{
  "task_id": "P2372_electrochemical_cell_voltage_comparison_",
  "affordances": [
    {
      "id": "A1",
      "name": "RobotAssistant",
      "type": "3d_object",
      "semantic": "Lab assistant robot loaded from robot.glb with idle bobbing animation",
      "locator_hints": [
        "robot.glb model",
        "position near (-6, 0, 0)"
      ]
    },
    {
      "id": "A2",
      "name": "Cell0_ZnCu",
      "type": "3d_object",
      "semantic": "Zinc-Copper electrochemical cell beaker at x=-2",
      "locator_hints": [
        "transparent beaker",
        "leftmost cell"
      ]
    },
    {
      "id": "A3",
      "name": "Cell1_FeAg",
      "type": "3d_object",
      "semantic": "Iron-Silver electrochemical cell beaker at x=1.5",
      "locator_hints": [
        "middle beaker"
      ]
    },
    {
      "id": "A4",
      "name": "Cell2_MgAu",
      "type": "3d_object",
      "semantic": "Magnesium-Gold electrochemical cell beaker at x=5",
      "locator_hints": [
        "rightmost beaker",
        "highest voltage cell"
      ]
    },
    {
      "id": "A5",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Starts the electrochemical simulation",
      "locator_hints": [
        "#btn-start"
      ]
    },
    {
      "id": "A6",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Pauses the simulation",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A8",
      "name": "SpeedButtons",
      "type": "dom_element",
      "semantic": "Speed multiplier buttons x1/x2/x5",
      "locator_hints": [
        "#btn-speed-1",
        "#btn-speed-2",
        "#btn-speed-5"
      ]
    },
    {
      "id": "A9",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Info panel showing selected cell details",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A10",
      "name": "VoltageChart",
      "type": "dom_element",
      "semantic": "Bar chart showing voltage percentages for all cells",
      "locator_hints": [
        "#voltage-chart"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.cellVoltages[0] === 0",
        "window.__3D_STATE__.cellVoltages[1] === 0",
        "window.__3D_STATE__.cellVoltages[2] === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Robot_Loaded",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Running",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S3",
      "name": "Voltages_Ramping",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.cellVoltages[0] > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Cell_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedCell >= 0",
        "window.__3D_STATE__.selectedCell <= 2"
      ]
    },
    {
      "id": "S5",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier > 1"
      ]
    },
    {
      "id": "S7",
      "name": "Near_Steady_State",
      "conditions": [
        "window.__3D_STATE__.cellVoltages[0] > 1.0",
        "window.__3D_STATE__.cellVoltages[1] > 1.15",
        "window.__3D_STATE__.cellVoltages[2] > 3.5"
      ]
    },
    {
      "id": "S8",
      "name": "Simulation_Reset",
      "conditions": [
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.cellVoltages[0] === 0",
        "window.__3D_STATE__.simRunning === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.robotY === 'number' && !isNaN(window.__3D_STATE__.robotY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellCount === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.cellVoltages) && window.__3D_STATE__.cellVoltages.length === 3",
            "tier": "L0"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.theoreticalVoltages) === JSON.stringify([1.10, 1.24, 3.87])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] >= 0 && window.__3D_STATE__.cellVoltages[0] <= 1.10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] > 0.3 && window.__3D_STATE__.cellVoltages[0] <= 1.10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[1] > 0.3 && window.__3D_STATE__.cellVoltages[1] <= 1.24",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] > 1.0 && window.__3D_STATE__.cellVoltages[2] <= 3.87",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electrodeGlow[2] > window.__3D_STATE__.electrodeGlow[0]",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cellVoltages[0] === 'number' && !isNaN(window.__3D_STATE__.cellVoltages[0])",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCell === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.cellNames)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellNames[1] === 'Fe/Ag'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalVoltages[1] === 1.24",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.voltageBarHeights === 'object' && window.__3D_STATE__.voltageBarHeights[1] >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-speed-5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.speedMultiplier)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCell === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-start').click(); await new Promise(r => setTimeout(r, 3000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[1] > 1.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] > 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electrodeGlow[0] > 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.voltageBarHeights[0] > 85 && window.__3D_STATE__.voltageBarHeights[1] > 85 && window.__3D_STATE__.voltageBarHeights[2] > 85",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCell === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellNames[2] === 'Mg/Au'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] <= 3.87",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electrodeGlow[2] >= 0 && window.__3D_STATE__.electrodeGlow[2] <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S4",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[1] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-speed-2').click(); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'S'})); await new Promise(r => setTimeout(r, 2500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[0] > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltages[2] > window.__3D_STATE__.cellVoltages[1] && window.__3D_STATE__.cellVoltages[1] > window.__3D_STATE__.cellVoltages[0]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleActive === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}