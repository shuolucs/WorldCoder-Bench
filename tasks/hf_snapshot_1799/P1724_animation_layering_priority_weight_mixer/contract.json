    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.layerTargetWeights[0] === 1.0",
        "window.__3D_STATE__.layerTargetWeights[1] === 0.0",
        "window.__3D_STATE__.layerTargetWeights[2] === 0.0",
        "window.__3D_STATE__.layerTargetWeights[3] === 0.0",
        "window.__3D_STATE__.priorityMode === 'weighted'",
        "window.__3D_STATE__.selectedLayer === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Walk_Layer_Activated",
      "conditions": [
        "window.__3D_STATE__.layerTargetWeights[1] > 0.0",
        "window.__3D_STATE__.layerEnabled[1] === true"
      ]
    },
    {
      "id": "S2",
      "name": "Walk_Blend_Complete",
      "conditions": [
        "Math.abs(window.__3D_STATE__.layerWeights[1] - window.__3D_STATE__.layerTargetWeights[1]) < 0.02",
        "window.__3D_STATE__.blendProgress >= 0.95"
      ]
    },
    {
      "id": "S3",
      "name": "Multi_Layer_Active",
      "conditions": [
        "window.__3D_STATE__.layerTargetWeights[1] > 0.0",
        "window.__3D_STATE__.layerTargetWeights[2] > 0.0"
      ]
    },
    {
      "id": "S4",
      "name": "Priority_Verified",
      "conditions": [
        "window.__3D_STATE__.effectiveWeights[2] > window.__3D_STATE__.effectiveWeights[1] || window.__3D_STATE__.priorityMode === 'additive'"
      ]
    },
    {
      "id": "S5",
      "name": "Additive_Mode",
      "conditions": [
        "window.__3D_STATE__.priorityMode === 'additive'"
      ]
    },
    {
      "id": "S6",
      "name": "Preset_Applied",
      "conditions": [
        "window.__3D_STATE__.presetName !== 'Custom'"
      ]
    },
    {
      "id": "S7",
      "name": "Layer_Disabled",
      "conditions": [
        "window.__3D_STATE__.layerEnabled[0] === false"
      ]
    },
    {
      "id": "S8",
      "name": "Undo_Performed",
