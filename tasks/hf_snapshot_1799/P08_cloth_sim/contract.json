            "expr": "(function(){ const p = window.__3D_STATE__.pinned[0]; return Math.abs(p.x) < 0.1 && Math.abs(p.y - 5) < 0.1 && Math.abs(p.z) < 0.1; })()",
            "tier": "L2"
