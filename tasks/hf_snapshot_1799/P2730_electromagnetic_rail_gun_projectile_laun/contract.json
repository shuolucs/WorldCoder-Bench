  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.modelsLoaded.projectile === true",
        "window.__3D_STATE__.modelsLoaded.target === true"
      ]
    },
    {
      "id": "S1",
      "name": "ParametersAdjusted",
      "conditions": [
        "window.__3D_STATE__.current !== 2000 || window.__3D_STATE__.bField !== 1.0",
        "window.__3D_STATE__.force === window.__3D_STATE__.current * 6 * window.__3D_STATE__.bField"
      ]
    },
    {
      "id": "S2",
      "name": "ProjectileLaunched",
      "conditions": [
        "window.__3D_STATE__.launched === true",
        "window.__3D_STATE__.inFlight === true",
        "window.__3D_STATE__.fireCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "InFlightPaused",
      "conditions": [
        "window.__3D_STATE__.inFlight === true",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S4",
      "name": "InFlightResumed",
      "conditions": [
        "window.__3D_STATE__.inFlight === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "CollisionOccurred",
      "conditions": [
        "window.__3D_STATE__.collisionOccurred === true",
        "window.__3D_STATE__.momentumError < 0.001"
      ]
    },
    {
      "id": "S6",
      "name": "GravityEnabled",
      "conditions": [
