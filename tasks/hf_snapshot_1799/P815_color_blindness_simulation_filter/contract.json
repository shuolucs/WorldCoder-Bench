{
  "task_id": "P815_color_blindness_simulation_filter",
  "affordances": [
    {
      "id": "A1",
      "name": "NormalButton",
      "type": "dom_element",
      "semantic": "Button to set normal vision mode",
      "locator_hints": [
        "#btn-normal"
      ]
    },
    {
      "id": "A2",
      "name": "ProtanopiaButton",
      "type": "dom_element",
      "semantic": "Button to set protanopia simulation",
      "locator_hints": [
        "#btn-protanopia"
      ]
    },
    {
      "id": "A3",
      "name": "DeuteranopiaButton",
      "type": "dom_element",
      "semantic": "Button to set deuteranopia simulation",
      "locator_hints": [
        "#btn-deuteranopia"
      ]
    },
    {
      "id": "A4",
      "name": "TritanopiaButton",
      "type": "dom_element",
      "semantic": "Button to set tritanopia simulation",
      "locator_hints": [
        "#btn-tritanopia"
      ]
    },
    {
      "id": "A5",
      "name": "AchromatopsiaButton",
      "type": "dom_element",
      "semantic": "Button to set achromatopsia simulation",
      "locator_hints": [
        "#btn-achromatopsia"
      ]
    },
    {
      "id": "A6",
      "name": "SeveritySlider",
      "type": "dom_element",
      "semantic": "Range slider controlling filter severity",
      "locator_hints": [
        "#severity-slider"
      ]
    },
    {
      "id": "A7",
      "name": "ModeDisplay",
      "type": "dom_element",
      "semantic": "HUD element showing current mode name",
      "locator_hints": [
        "#mode-display"
      ]
    },
    {
      "id": "A8",
      "name": "ColoredObjects",
      "type": "3d_object",
      "semantic": "The 5 colorful 3D objects in the scene",
      "locator_hints": [
        "sphere",
        "cube",
        "cylinder",
        "torus",
        "cone"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Normal",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'normal'",
        "window.__3D_STATE__.severity === 100",
        "window.__3D_STATE__.filterActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "Protanopia_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'protanopia'",
        "window.__3D_STATE__.filterActive === true"
      ]
    },
    {
      "id": "S2",
      "name": "Deuteranopia_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'deuteranopia'",
        "window.__3D_STATE__.filterActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "Tritanopia_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'tritanopia'",
        "window.__3D_STATE__.filterActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "Achromatopsia_Active",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'achromatopsia'",
        "window.__3D_STATE__.filterActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "Reduced_Severity",
      "conditions": [
        "window.__3D_STATE__.severity < 100",
        "window.__3D_STATE__.severityFloat < 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "Zero_Severity",
      "conditions": [
        "window.__3D_STATE__.severity === 0",
        "window.__3D_STATE__.severityFloat === 0.0"
      ]
    },
    {
      "id": "S7",
      "name": "Back_To_Normal",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'normal'",
        "window.__3D_STATE__.filterActive === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMode === 'normal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.currentMatrix) && window.__3D_STATE__.currentMatrix.length === 9",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-protanopia"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 'protanopia'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterActive === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[0] - 0.567) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[1] - 0.433) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMatrix.every(v => !isNaN(v))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.severityFloat === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 'deuteranopia'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterActive === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[0] - 0.625) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[3] - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#mode-display').textContent.toLowerCase().includes('deuteranopia')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-tritanopia"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 'tritanopia'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[0] - 0.95) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[5] - 0.567) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[8] - 0.525) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMatrix.every(v => v >= 0 && v <= 1)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 'achromatopsia'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[0] - 0.299) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[1] - 0.587) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentMatrix[2] - 0.114) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMatrix[0] === window.__3D_STATE__.currentMatrix[3]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMatrix[3] === window.__3D_STATE__.currentMatrix[6]",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.severity === 90",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.severityFloat - 0.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMode === 'achromatopsia'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterActive === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#severity-slider').value === '90'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<9;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.severity === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.severityFloat === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMode === 'achromatopsia'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#severity-label').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentMode === 'normal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterActive === false",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#mode-display').textContent.toLowerCase().includes('normal')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}