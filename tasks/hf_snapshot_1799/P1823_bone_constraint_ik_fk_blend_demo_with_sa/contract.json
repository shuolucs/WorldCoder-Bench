            "expr": "Math.abs(window.__3D_STATE__.fkAngles[0] - 0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[1] - 0.3) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[2] - (-0.2)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[3] - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[4] - (-0.1)) < 0.001",
