  "states": [
    {
      "id": "S0",
      "name": "Initial_FK_Mode",
      "conditions": [
        "window.__3D_STATE__.blendWeight === 0",
        "window.__3D_STATE__.boneCount === 5",
        "window.__3D_STATE__.selectedBone === 0",
        "window.__3D_STATE__.filledSlotCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Bone_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedBone >= 0 && window.__3D_STATE__.selectedBone <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "FK_Angle_Modified",
      "conditions": [
        "window.__3D_STATE__.fkAngles.some((a, i) => i === window.__3D_STATE__.selectedBone && Math.abs(a - [0, 0.3, -0.2, 0.5, -0.1][i]) > 0.01)"
      ]
    },
    {
      "id": "S3",
      "name": "Blend_Partial",
      "conditions": [
        "window.__3D_STATE__.blendWeight > 0 && window.__3D_STATE__.blendWeight < 1"
      ]
    },
    {
      "id": "S4",
      "name": "Blend_Full_IK",
      "conditions": [
        "window.__3D_STATE__.blendWeight === 1"
      ]
    },
    {
      "id": "S5",
      "name": "Slot_Saved",
      "conditions": [
        "window.__3D_STATE__.filledSlotCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.filledSlotCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "PerBone_Override_Set",
      "conditions": [
        "window.__3D_STATE__.perBoneOverrides.some(v => v >= 0)"
      ]
    },
    {
      "id": "S8",
      "name": "IK_Target_Hidden",
      "conditions": [
        "window.__3D_STATE__.isIKTargetVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "FK_Reset",
      "conditions": [
        "window.__3D_STATE__.fkAngles.every((a, i) => Math.abs(a - [0, 0.3, -0.2, 0.5, -0.1][i]) < 0.001)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boneCount === 5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.fkAngles) && window.__3D_STATE__.fkAngles.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ikAngles) && window.__3D_STATE__.ikAngles.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.finalAngles) && window.__3D_STATE__.finalAngles.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight === 0 && window.__3D_STATE__.selectedBone === 0 && window.__3D_STATE__.filledSlotCount === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBone === 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fkAngles[2] === 'number' && isFinite(window.__3D_STATE__.fkAngles[2])",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[2] - (-0.2)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chainLength !== undefined && Math.abs(window.__3D_STATE__.chainLength - 5.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkAngles.every(a => isFinite(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const before = window.__3D_STATE__.fkAngles[2]; window.__T3_before = before; for(let i=0;i<4;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'a'})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'a'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBone === 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fkAngles[2] - (-0.2 - 0.2)) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkAngles[2] < window.__T3_before",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalAngles[2] === window.__3D_STATE__.fkAngles[2]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkAngles.every(a => isFinite(a) && !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider){slider.value='0.5'; slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendWeight - 0.5) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalAngles.every((f, i) => { const fk = window.__3D_STATE__.fkAngles[i]; const ik = window.__3D_STATE__.ikAngles[i]; const ov = window.__3D_STATE__.perBoneOverrides[i]; const bw = ov >= 0 ? ov : window.__3D_STATE__.blendWeight; return Math.abs(f - (fk + (ik - fk) * bw)) < 0.05; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight > 0 && window.__3D_STATE__.blendWeight < 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tipToTargetDistance === 'number' && isFinite(window.__3D_STATE__.tipToTargetDistance)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.finalAngles.every(a => isFinite(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_preBlend = window.__3D_STATE__.blendWeight; window.__T5_preFk = [...window.__3D_STATE__.fkAngles]; const btns = [...document.querySelectorAll('button')].filter(b => b.textContent.includes('Save 1')); if(btns.length) btns[0].click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.filledSlotCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.savedSlots[0] !== null && window.__3D_STATE__.savedSlots[0] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.savedSlots[0].fkAngles) && window.__3D_STATE__.savedSlots[0].fkAngles.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.savedSlots[0].blendWeight - window.__T5_preBlend) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.savedSlots[0].fkAngles.every((a, i) => Math.abs(a - window.__T5_preFk[i]) < 0.001)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider){slider.value='1.0'; slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendWeight - 1.0) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalAngles.every((f, i) => { const ov = window.__3D_STATE__.perBoneOverrides[i]; const bw = ov >= 0 ? ov : 1.0; return bw === 1.0 ? Math.abs(f - window.__3D_STATE__.ikAngles[i]) < 0.05 : true; })",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ikConverged === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ikIterations >= 0 && window.__3D_STATE__.ikIterations <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tipToTargetDistance <= window.__3D_STATE__.chainLength + 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T7_preLoad_blend = window.__3D_STATE__.blendWeight; const btns = [...document.querySelectorAll('button')].filter(b => b.textContent.includes('Load 1')); if(btns.length) btns[0].click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendWeight - window.__3D_STATE__.savedSlots[0].blendWeight) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight !== window.__T7_preLoad_blend || Math.abs(window.__3D_STATE__.savedSlots[0].blendWeight - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fkAngles.every((a, i) => Math.abs(a - window.__3D_STATE__.savedSlots[0].fkAngles[i]) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filledSlotCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalAngles.every(a => isFinite(a) && !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown',{key:'2'})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'2'})); setTimeout(()=>{ document.dispatchEvent(new KeyboardEvent('keydown',{key:'b'})); document.dispatchEvent(new KeyboardEvent('keyup',{key:'b'})); },100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBone === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.perBoneOverrides[1] >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.perBoneOverrides[1] === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.perBoneOverrides.filter(v => v >= 0).length >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.finalAngles[1] - window.__3D_STATE__.fkAngles[1]) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isIKTargetVisible === false",
            "tier": "L2"
          },
          {
