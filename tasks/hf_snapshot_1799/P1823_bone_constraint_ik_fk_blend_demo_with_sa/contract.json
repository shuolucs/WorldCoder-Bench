            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.ikTargetPos.x) && isFinite(window.__3D_STATE__.ikTargetPos.y) && isFinite(window.__3D_STATE__.ikTargetPos.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chainTipPos === 'object' && isFinite(window.__3D_STATE__.chainTipPos.x)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
