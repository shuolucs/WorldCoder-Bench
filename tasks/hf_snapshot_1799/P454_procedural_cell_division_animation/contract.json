{
  "task_id": "P454_procedural_cell_division_animation",
  "affordances": [
    {
      "id": "A1",
      "name": "ParentCell",
      "type": "3d_object",
      "semantic": "The main dividing cell sphere",
      "locator_hints": [
        "semi-transparent green sphere at origin",
        "radius ~2"
      ]
    },
    {
      "id": "A2",
      "name": "Nucleus",
      "type": "3d_object",
      "semantic": "Purple nucleus sphere inside the cell",
      "locator_hints": [
        "smaller purple sphere inside cell"
      ]
    },
    {
      "id": "A3",
      "name": "Chromosomes",
      "type": "3d_object",
      "semantic": "Red elongated boxes representing chromosomes",
      "locator_hints": [
        "small red boxes inside nucleus/cell"
      ]
    },
    {
      "id": "A4",
      "name": "RobotObserver",
      "type": "3d_object",
      "semantic": "Loaded robot.glb model orbiting the cell",
      "locator_hints": [
        "robot model orbiting at radius 6"
      ]
    },
    {
      "id": "A5",
      "name": "NextPhaseBtn",
      "type": "dom_element",
      "semantic": "Button to advance to next division phase",
      "locator_hints": [
        "#nextPhaseBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetBtn",
      "type": "dom_element",
      "semantic": "Button to reset to interphase",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleLabelsBtn",
      "type": "dom_element",
      "semantic": "Button to toggle structure labels",
      "locator_hints": [
        "#toggleLabelsBtn"
      ]
    },
    {
      "id": "A8",
      "name": "PhaseDisplay",
      "type": "dom_element",
      "semantic": "Shows current phase name",
      "locator_hints": [
        "#phaseDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "PhaseCounter",
      "type": "dom_element",
      "semantic": "Shows phase X/5",
      "locator_hints": [
        "#phaseCounter"
      ]
    },
    {
      "id": "A10",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Educational description of current phase",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A11",
      "name": "DaughterCells",
      "type": "3d_object",
      "semantic": "Two daughter cells created in telophase",
      "locator_hints": [
        "two smaller spheres at y=+2.5 and y=-2.5"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'INTERPHASE'",
        "window.__3D_STATE__.chromosomeCount === 4",
        "window.__3D_STATE__.nucleusOpacity >= 0.7"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'PROPHASE'",
        "window.__3D_STATE__.chromosomeCount === 8"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'METAPHASE'"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'ANAPHASE'"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseName === 'TELOPHASE'",
        "window.__3D_STATE__.daughterCellsVisible === true"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.animationPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "RobotHidden",
      "conditions": [
        "window.__3D_STATE__.robotVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "LabelsToggled",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToInterphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.daughterCellsVisible === false",
        "window.__3D_STATE__.chromosomeCount === 4"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#nextPhaseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPhase !== before.currentPhase || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentPhase === 'number' && !isNaN(window.__3D_STATE__.currentPhase)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.chromosomeCount === 'number' && !isNaN(window.__3D_STATE__.chromosomeCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromosomeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.robotVisible === 'boolean'",
            "tier": "L0"
          }
        ]
      }
