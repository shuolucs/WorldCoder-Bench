          },
          {
            "expr": "typeof window.__3D_STATE__.birdCount === 'number' && !isNaN(window.__3D_STATE__.birdCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leadDistance === 'number' && !isNaN(window.__3D_STATE__.leadDistance)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.birdCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeScale > 2",
            "tier": "L2"
          },
          {
