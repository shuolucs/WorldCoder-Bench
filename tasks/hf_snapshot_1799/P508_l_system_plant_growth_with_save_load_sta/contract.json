{
  "task_id": "P508_l_system_plant_growth_with_save_load_sta",
  "affordances": [
    {
      "id": "A1",
      "name": "LSystemPlant",
      "type": "3d_object",
      "semantic": "Procedurally generated L-system plant group at (3,0,0)",
      "locator_hints": [
        "plant group",
        "position.x === 3"
      ]
    },
    {
      "id": "A2",
      "name": "AvocadoModel",
      "type": "3d_object",
      "semantic": "Loaded Avocado.glb model at (-3,0,0)",
      "locator_hints": [
        "avocado",
        "gltf model"
      ]
    },
    {
      "id": "A3",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to increment generation",
      "locator_hints": [
        "#btn-grow"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset plant to gen 0",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A5",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state",
      "locator_hints": [
        "#btn-save"
      ]
    },
    {
      "id": "A6",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load saved state",
      "locator_hints": [
        "#btn-load"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleButton",
      "type": "dom_element",
      "semantic": "Button to toggle plant visibility",
      "locator_hints": [
        "#btn-toggle"
      ]
    },
    {
      "id": "A8",
      "name": "AngleUpButton",
      "type": "dom_element",
      "semantic": "Button to increase branch angle",
      "locator_hints": [
        "#btn-angle-up"
      ]
    },
    {
      "id": "A9",
      "name": "AngleDownButton",
      "type": "dom_element",
      "semantic": "Button to decrease branch angle",
      "locator_hints": [
        "#btn-angle-down"
      ]
    },
    {
      "id": "A10",
      "name": "StatusText",
      "type": "dom_element",
      "semantic": "HUD text showing generation, segments, leaves, angle",
      "locator_hints": [
        "#status-text"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.savedState === null",
        "window.__3D_STATE__.plantVisible === true",
        "window.__3D_STATE__.angle === 25"
      ]
    },
    {
      "id": "S1",
      "name": "Generation1",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.segmentCount > 1",
        "window.__3D_STATE__.leafCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Generation2",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.segmentCount > window.__3D_STATE__.leafCount"
      ]
    },
    {
      "id": "S3",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedState !== null",
        "window.__3D_STATE__.savedState.generation === window.__3D_STATE__.generation"
      ]
    },
    {
      "id": "S4",
      "name": "PlantHidden",
      "conditions": [
        "window.__3D_STATE__.plantVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "PlantVisible",
      "conditions": [
        "window.__3D_STATE__.plantVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "AngleModified",
      "conditions": [
        "window.__3D_STATE__.angle !== 25"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.segmentCount === 1",
        "window.__3D_STATE__.leafCount === 1"
      ]
    },
    {
      "id": "S8",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.savedState !== null",
        "window.__3D_STATE__.generation === window.__3D_STATE__.savedState.generation"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-grow"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('status-text').textContent.includes('Gen: 1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('status-text').textContent.includes('Gen: 2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-save"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedState !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedState.generation === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedState !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-angle-up"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('status-text').textContent.includes('30')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-reset').click(); await new Promise(r => setTimeout(r, 300)); document.getElementById('btn-load').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}