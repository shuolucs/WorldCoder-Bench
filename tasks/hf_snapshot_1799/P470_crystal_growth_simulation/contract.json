  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.harvestCount === 0",
        "window.__3D_STATE__.growthEnabled === true",
        "window.__3D_STATE__.resonanceActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "Single_Crystal_Planted",
      "conditions": [
        "window.__3D_STATE__.crystalCount === 1",
        "window.__3D_STATE__.crystalPhases.includes('seed') || window.__3D_STATE__.crystalPhases.includes('growing')"
      ]
    },
    {
      "id": "S2",
      "name": "Crystal_Growing",
      "conditions": [
        "window.__3D_STATE__.crystalCount >= 1",
        "window.__3D_STATE__.tallestCrystalHeight > 0.1",
        "window.__3D_STATE__.growthEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "Crystal_Ring_Planted",
      "conditions": [
        "window.__3D_STATE__.crystalCount >= 6",
        "window.__3D_STATE__.ringPlanted === true"
      ]
    },
    {
      "id": "S4",
      "name": "Growth_Paused",
      "conditions": [
        "window.__3D_STATE__.growthEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "Growth_Resumed",
      "conditions": [
        "window.__3D_STATE__.growthEnabled === true",
        "window.__3D_STATE__.totalGrowthCycles > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Speed_Boosted",
      "conditions": [
        "window.__3D_STATE__.timeSpeed === 3"
      ]
    },
    {
      "id": "S7",
      "name": "Crystals_Mature",
      "conditions": [
        "window.__3D_STATE__.matureCount >= 1",
        "window.__3D_STATE__.tallestCrystalHeight >= 3.0"
      ]
    },
    {
      "id": "S8",
      "name": "Resonance_Active",
      "conditions": [
        "window.__3D_STATE__.resonanceActive === true",
        "window.__3D_STATE__.matureCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "Fox_Moved",
      "conditions": [
        "window.__3D_STATE__.foxPosition.x !== 0 || window.__3D_STATE__.foxPosition.z !== 5"
      ]
    },
    {
      "id": "S10",
      "name": "Crystal_Harvested",
      "conditions": [
        "window.__3D_STATE__.harvestCount >= 1"
      ]
    },
    {
      "id": "S11",
      "name": "All_Cleared",
      "conditions": [
        "window.__3D_STATE__.crystalCount === 0",
        "window.__3D_STATE__.harvestCount >= 1"
      ]
    },
    {
      "id": "S12",
      "name": "Resonance_Stopped",
      "conditions": [
        "window.__3D_STATE__.resonanceActive === false",
        "window.__3D_STATE__.harvestCount >= 1"
      ]
    }
  ],
