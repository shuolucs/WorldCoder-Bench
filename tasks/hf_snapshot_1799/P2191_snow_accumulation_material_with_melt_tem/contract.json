          {
            "expr": "Math.abs(window.__3D_STATE__.snowAmount - 0.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowAmount > 0 && window.__3D_STATE__.snowAmount < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.snowThreshold - (0.8 - 0.5 * window.__3D_STATE__.snowAmount)) < 0.05",
