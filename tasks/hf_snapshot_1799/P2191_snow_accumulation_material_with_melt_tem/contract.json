      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('temperature-slider').value = 10; document.getElementById('temperature-slider').dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
