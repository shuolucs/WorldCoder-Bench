          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount !== undefined && window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === -5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowAmount === 1.0",
            "tier": "L2"
          },
