            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowRoughness >= 0.85 && window.__3D_STATE__.snowRoughness <= 0.95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snowThreshold >= 0.25 && window.__3D_STATE__.snowThreshold <= 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L2"
          }
        ]
