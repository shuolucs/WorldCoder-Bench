  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.modelLoaded === undefined"
      ]
    },
    {
      "id": "S1",
      "name": "InitialSnowState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.temperature === -5",
        "window.__3D_STATE__.snowAmount === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "PartialMelt",
      "conditions": [
        "window.__3D_STATE__.temperature > 0",
        "window.__3D_STATE__.temperature < 20",
        "window.__3D_STATE__.snowAmount > 0",
        "window.__3D_STATE__.snowAmount < 1"
      ]
    },
    {
      "id": "S3",
      "name": "FullMelt",
      "conditions": [
        "window.__3D_STATE__.temperature >= 20",
        "window.__3D_STATE__.snowAmount === 0"
      ]
    },
    {
      "id": "S4",
      "name": "MaxSnow",
      "conditions": [
        "window.__3D_STATE__.temperature === -10",
        "window.__3D_STATE__.snowAmount === 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.temperature === -5",
        "window.__3D_STATE__.snowAmount === 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
