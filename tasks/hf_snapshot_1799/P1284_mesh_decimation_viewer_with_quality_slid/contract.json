      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 50; slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentFaceCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.qualityPercent === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaceCount < window.__3D_STATE__.originalFaceCount",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.reductionPercent - 50) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshColorHex === 0x44ff88 || window.__3D_STATE__.meshColorHex === 4521864",
