  "states": [
    {
      "id": "S0",
      "name": "InitialFullQuality",
      "conditions": [
        "window.__3D_STATE__.qualityPercent === 100",
        "window.__3D_STATE__.meshExists === true",
        "window.__3D_STATE__.wireframeEnabled === false",
        "window.__3D_STATE__.boundingBoxVisible === false",
        "window.__3D_STATE__.screenshotMode === false",
        "window.__3D_STATE__.currentFaceCount === window.__3D_STATE__.originalFaceCount"
      ]
    },
    {
      "id": "S1",
      "name": "DecimatedTo50",
      "conditions": [
        "window.__3D_STATE__.qualityPercent === 50",
        "window.__3D_STATE__.currentFaceCount < window.__3D_STATE__.originalFaceCount",
        "window.__3D_STATE__.reductionPercent > 45 && window.__3D_STATE__.reductionPercent < 55"
      ]
    },
    {
      "id": "S2",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "DecimatedTo10",
      "conditions": [
        "window.__3D_STATE__.qualityPercent === 10",
        "window.__3D_STATE__.reductionPercent > 85"
      ]
    },
    {
      "id": "S4",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S5",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.canUndo === true"
      ]
    },
    {
