        "window.__3D_STATE__.currentFaceCount >= window.__3D_STATE__.minFaceCount"
      ]
    },
    {
      "id": "S11",
      "name": "RestoredAfterUndo",
      "conditions": [
        "window.__3D_STATE__.qualityPercent === 50",
        "window.__3D_STATE__.historyIndex >= 0"
      ]
    }
  ],
