  "states": [
    {
      "id": "S0",
      "name": "InitialResting",
      "conditions": [
        "window.__3D_STATE__.sphereY === 0",
        "window.__3D_STATE__.mode === 'auto'",
        "window.__3D_STATE__.current !== undefined"
      ]
    },
    {
      "id": "S1",
      "name": "PIDConverging",
      "conditions": [
        "window.__3D_STATE__.sphereY > 0.5",
        "window.__3D_STATE__.mode === 'auto'",
        "window.__3D_STATE__.current > 0"
      ]
    },
    {
      "id": "S2",
      "name": "StableHover",
      "conditions": [
        "window.__3D_STATE__.isStable === true",
        "Math.abs(window.__3D_STATE__.error) < 0.2",
        "window.__3D_STATE__.stabilityCounter >= 60"
      ]
    },
    {
      "id": "S3",
      "name": "DisturbedFromStable",
      "conditions": [
        "window.__3D_STATE__.disturbanceCount > 0",
        "Math.abs(window.__3D_STATE__.sphereVelocity) > 0.5"
      ]
    },
    {
      "id": "S4",
      "name": "RecoveredAfterDisturbance",
      "conditions": [
        "window.__3D_STATE__.isStable === true",
        "window.__3D_STATE__.disturbanceCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "ManualMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'manual'"
      ]
    },
    {
      "id": "S6",
      "name": "ManualCurrentAdjusted",
      "conditions": [
        "window.__3D_STATE__.mode === 'manual'",
        "window.__3D_STATE__.current > 0"
      ]
    },
    {
      "id": "S7",
      "name": "TargetHeightChanged",
      "conditions": [
        "window.__3D_STATE__.targetHeight !== 3.0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.sphereY === 0",
        "window.__3D_STATE__.sphereVelocity === 0",
        "window.__3D_STATE__.integralTerm === 0"
      ]
    },
    {
      "id": "S9",
      "name": "StableAtNewTarget",
      "conditions": [
        "window.__3D_STATE__.isStable === true",
        "window.__3D_STATE__.targetHeight !== 3.0",
