            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.listenerPosition.x - 3) < 0.1 && Math.abs(window.__3D_STATE__.listenerPosition.z - 0) < 0.1",
            "tier": "L2"
