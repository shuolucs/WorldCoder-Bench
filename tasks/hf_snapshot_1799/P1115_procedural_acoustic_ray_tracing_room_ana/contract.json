        "window.__3D_STATE__.raysVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "RaysTraced",
      "conditions": [
        "window.__3D_STATE__.totalRaysTraced === 36",
        "window.__3D_STATE__.raysVisible === true",
        "window.__3D_STATE__.rayPaths.length === 36"
      ]
    },
    {
      "id": "S2",
      "name": "RaysCleared",
      "conditions": [
        "window.__3D_STATE__.totalRaysTraced === 0",
        "window.__3D_STATE__.raysVisible === false",
        "window.__3D_STATE__.receivedRaysCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "MaterialChanged",
      "conditions": [
        "window.__3D_STATE__.materialPreset !== 'Concrete'",
        "window.__3D_STATE__.raysVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "RoomResized",
      "conditions": [
        "window.__3D_STATE__.roomWidth !== 10 || window.__3D_STATE__.roomDepth !== 8",
        "window.__3D_STATE__.raysVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "RetracedAfterResize",
