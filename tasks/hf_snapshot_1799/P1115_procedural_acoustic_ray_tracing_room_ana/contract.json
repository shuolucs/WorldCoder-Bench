      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.roomWidth === 'number' && typeof window.__3D_STATE__.roomHeight === 'number' && typeof window.__3D_STATE__.roomDepth === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.roomVolume === window.__3D_STATE__.roomWidth * window.__3D_STATE__.roomHeight * window.__3D_STATE__.roomDepth",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomVolume === 320",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionCoefficient === 0.02",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.rt60) && isFinite(window.__3D_STATE__.rt60) && window.__3D_STATE__.rt60 > 0",
            "tier": "L2"
          }
        ]
