  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.roomWidth === 10",
        "window.__3D_STATE__.roomHeight === 4",
        "window.__3D_STATE__.roomDepth === 8",
        "window.__3D_STATE__.materialPreset === 'Concrete'",
