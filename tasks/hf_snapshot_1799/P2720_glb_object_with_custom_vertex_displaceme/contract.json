{
  "task_id": "P2720_glb_object_with_custom_vertex_displaceme",
  "affordances": [
    {
      "id": "A1",
      "name": "AnimatedTerrain",
      "type": "3d_object",
      "semantic": "Plane geometry with vertex displacement shader creating animated waves",
      "locator_hints": [
        "PlaneGeometry mesh with ShaderMaterial",
        "terrain plane rotated on X"
      ]
    },
    {
      "id": "A2",
      "name": "HeadModel",
      "type": "3d_object",
      "semantic": "LeePerrySmith GLB head model at left side of scene",
      "locator_hints": [
        "LeePerrySmith.glb",
        "position near (-4, 3, 0)"
      ]
    },
    {
      "id": "A3",
      "name": "FibreModel",
      "type": "3d_object",
      "semantic": "CarbonFibre GLB model at right side of scene",
      "locator_hints": [
        "CarbonFibre.glb",
        "position near (4, 3, 0)"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing amplitude, frequency, displacement status, FPS, focus",
      "locator_hints": [
        "div#hud",
        "top-left overlay"
      ]
    },
    {
      "id": "A5",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "PerspectiveCamera with OrbitControls, focusable on models",
      "locator_hints": [
        "PerspectiveCamera",
        "OrbitControls"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelsLoading",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded < 2"
      ]
    },
    {
      "id": "S1",
      "name": "InitialReady",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === 2",
        "window.__3D_STATE__.terrainAmplitude === 1.5",
        "window.__3D_STATE__.terrainFrequency === 0.3",
        "window.__3D_STATE__.displacementEnabled === false",
        "window.__3D_STATE__.cameraFocus === 'overview'"
      ]
    },
    {
      "id": "S2",
      "name": "AmplitudeIncreased",
      "conditions": [
        "window.__3D_STATE__.terrainAmplitude === 1.75"
      ]
    },
    {
      "id": "S3",
      "name": "FrequencyAdjusted",
      "conditions": [
        "window.__3D_STATE__.terrainFrequency !== 0.3"
      ]
    },
    {
      "id": "S4",
      "name": "DisplacementActive",
      "conditions": [
        "window.__3D_STATE__.displacementEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "FocusedOnHead",
      "conditions": [
        "window.__3D_STATE__.cameraFocus === 'head'"
      ]
    },
    {
      "id": "S6",
      "name": "FocusedOnFibre",
      "conditions": [
        "window.__3D_STATE__.cameraFocus === 'fibre'"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.terrainAmplitude === 1.5",
        "window.__3D_STATE__.terrainFrequency === 0.3",
        "window.__3D_STATE__.displacementEnabled === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelsLoaded === 2",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.headPosition === 'object' && window.__3D_STATE__.headPosition.x !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.fibrePosition === 'object' && window.__3D_STATE__.fibrePosition.x !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.terrainAmplitude === 1.5 && window.__3D_STATE__.terrainFrequency === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.terrainAmplitude === 1.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.terrainAmplitude > 1.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.terrainAmplitude === 'number' && !isNaN(window.__3D_STATE__.terrainAmplitude)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.terrainAmplitude >= 0.0 && window.__3D_STATE__.terrainAmplitude <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.terrainFrequency === 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.terrainFrequency < 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.terrainFrequency === 'number' && !isNaN(window.__3D_STATE__.terrainFrequency)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.terrainFrequency >= 0.1 && window.__3D_STATE__.terrainFrequency <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "e"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displacementEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelDisplacementValue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelDisplacementValue)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.headRotationY !== 0 || window.__3D_STATE__.elapsedTime < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fibreRotationY !== 0 || window.__3D_STATE__.elapsedTime < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraFocus === 'head'",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraPosition === 'object' && window.__3D_STATE__.cameraPosition.x !== undefined",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraPosition.x - (-4)) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelsLoaded === 2",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('head')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraFocus === 'fibre'",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraPosition.x - 4) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraPosition.y > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.displacementEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.toLowerCase().includes('fibre')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.terrainAmplitude === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.terrainFrequency === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.displacementEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelDisplacementValue === 0.0 || window.__3D_STATE__.modelDisplacementValue === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}