      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#customX').value = '0.25'; document.querySelector('#customX').dispatchEvent(new Event('input')); document.querySelector('#customY').value = '-0.15'; document.querySelector('#customY').dispatchEvent(new Event('input')); document.querySelector('#addSampleBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.customSamples.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.customSamples[0].x - 0.25) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.customSamples[0].y - (-0.15)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePattern === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samplesInViz >= 1",
            "tier": "L2"
          }
        ]
