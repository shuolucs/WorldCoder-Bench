          },
          {
            "expr": "window.__3D_STATE__.activePattern === 'rotated4'",
            "tier": "L2"
          },
          {
            "expr": "!(window.__3D_STATE__.currentJitterX === 0 && window.__3D_STATE__.currentJitterY === 0) || window.__3D_STATE__.patternSampleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 4",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.blendAlpha) && window.__3D_STATE__.blendAlpha > 0 && window.__3D_STATE__.blendAlpha <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
