            "expr": "Math.abs(window.__3D_STATE__.customSamples[1].y - 0.40) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.samplesInViz >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
