      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.customSamples.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePattern === 'custom'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentJitterX === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentJitterY === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePattern === 'halton23'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jitterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSampleIndex >= 0 && window.__3D_STATE__.currentSampleIndex < 8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blendAlpha - 1.0 / (window.__3D_STATE__.accumulatedFrames + 1)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentJitterX) && !isNaN(window.__3D_STATE__.currentJitterY)",
            "tier": "L2"
          }
        ]
