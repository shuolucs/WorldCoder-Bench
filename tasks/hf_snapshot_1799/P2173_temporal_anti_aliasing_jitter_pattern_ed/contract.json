    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#customX').value = '-0.30'; document.querySelector('#customX').dispatchEvent(new Event('input')); document.querySelector('#customY').value = '0.40'; document.querySelector('#customY').dispatchEvent(new Event('input')); document.querySelector('#addSampleBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.customSamples.length === 2",
