  "states": [
    {
      "id": "S0",
      "name": "Initial_SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.activePattern === 'halton23'",
        "window.__3D_STATE__.jitterEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "Pattern_Uniform4_Active",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'uniform4'",
        "window.__3D_STATE__.patternSampleCount === 4"
      ]
    },
    {
      "id": "S2",
      "name": "Pattern_Rotated4_Active",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'rotated4'",
        "window.__3D_STATE__.patternSampleCount === 4"
      ]
    },
    {
      "id": "S3",
      "name": "Jitter_Disabled",
      "conditions": [
        "window.__3D_STATE__.jitterEnabled === false",
        "window.__3D_STATE__.currentJitterX === 0",
        "window.__3D_STATE__.currentJitterY === 0"
      ]
    },
    {
      "id": "S4",
      "name": "Jitter_ReEnabled",
      "conditions": [
        "window.__3D_STATE__.jitterEnabled === true",
        "window.__3D_STATE__.activePattern === 'rotated4'"
      ]
    },
    {
      "id": "S5",
      "name": "Custom_Pattern_Selected",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'custom'",
        "window.__3D_STATE__.patternSampleCount === 0"
      ]
    },
    {
      "id": "S6",
      "name": "Custom_Sample_Added",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'custom'",
        "window.__3D_STATE__.customSamples.length === 1",
        "window.__3D_STATE__.patternSampleCount === 1"
      ]
    },
    {
      "id": "S7",
      "name": "Custom_Second_Sample_Added",
      "conditions": [
        "window.__3D_STATE__.customSamples.length === 2",
        "window.__3D_STATE__.patternSampleCount === 2"
      ]
    },
    {
      "id": "S8",
      "name": "Custom_Cleared",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'custom'",
        "window.__3D_STATE__.customSamples.length === 0",
        "window.__3D_STATE__.patternSampleCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Accumulation_Reset",
      "conditions": [
        "window.__3D_STATE__.accumulatedFrames === 0"
      ]
    },
    {
      "id": "S10",
      "name": "Halton_Restored_ManualAdvance",
      "conditions": [
        "window.__3D_STATE__.activePattern === 'halton23'",
        "window.__3D_STATE__.patternSampleCount === 8"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.foxPosition === 'object' && Math.abs(window.__3D_STATE__.foxPosition.y) < 0.5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activePattern === 'halton23'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraFOV === 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePattern === 'uniform4'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentSampleIndex >= 0 && window.__3D_STATE__.currentSampleIndex < 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentJitterX >= -0.5 && window.__3D_STATE__.currentJitterX <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentJitterY >= -0.5 && window.__3D_STATE__.currentJitterY <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.projMatrixElement8) && isFinite(window.__3D_STATE__.projMatrixElement8)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePattern === 'rotated4'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.patternSampleCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jitterEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentJitterX) <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentJitterY) <= 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "j"
