            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.n2Count === 8 && window.__3D_STATE__.h2Count === 24 && window.__3D_STATE__.nh3Count === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.keq === 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionQuotientQ === 'number' && !isNaN(window.__3D_STATE__.reactionQuotientQ) && window.__3D_STATE__.reactionQuotientQ >= 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalAtomN === 2 * 8 + 1 * 4 && window.__3D_STATE__.totalAtomH === 2 * 24 + 3 * 4",
            "tier": "L2"
          }
        ]
