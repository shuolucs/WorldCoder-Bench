  "states": [
    {
      "id": "S0",
      "name": "SceneInitialized",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.n2Count === 8",
        "window.__3D_STATE__.h2Count === 24",
        "window.__3D_STATE__.nh3Count === 4"
      ]
    },
    {
      "id": "S1",
      "name": "AfterAddN2Perturbation",
      "conditions": [
        "window.__3D_STATE__.n2Count >= 12",
        "window.__3D_STATE__.lastPerturbation === 'add_n2'"
      ]
    },
    {
      "id": "S2",
      "name": "EquilibriumShiftingForward",
      "conditions": [
        "window.__3D_STATE__.equilibriumStatus === 'forward'"
      ]
    },
    {
      "id": "S3",
      "name": "AfterForwardReaction",
      "conditions": [
        "window.__3D_STATE__.forwardReactionCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "AfterAddNH3Perturbation",
      "conditions": [
        "window.__3D_STATE__.nh3Count >= 6",
        "window.__3D_STATE__.lastPerturbation === 'add_nh3'"
      ]
    },
    {
      "id": "S5",
      "name": "EquilibriumShiftingReverse",
      "conditions": [
        "window.__3D_STATE__.equilibriumStatus === 'reverse'"
      ]
    },
    {
