        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S8",
      "name": "AfterRemoveH2",
      "conditions": [
        "window.__3D_STATE__.lastPerturbation === 'remove_h2'"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.n2Count === 8",
        "window.__3D_STATE__.h2Count === 24",
        "window.__3D_STATE__.nh3Count === 4",
        "window.__3D_STATE__.lastPerturbation === 'reset'"
      ]
    }
  ],
