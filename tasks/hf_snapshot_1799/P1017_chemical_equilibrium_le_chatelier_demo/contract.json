            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculeCount === 8 + 4 + 24 + 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalAtomN === 2 * 12 + 1 * 4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionQuotientQ === 'number' && !isNaN(window.__3D_STATE__.reactionQuotientQ)",
            "tier": "L0"
