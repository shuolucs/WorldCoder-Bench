  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 50",
        "window.__3D_STATE__.mass === 2.0",
        "window.__3D_STATE__.gravity === 9.81",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.debugVisible === true",
        "window.__3D_STATE__.precessionAngle === 0"
      ]
    },
    {
      "id": "S1",
      "name": "RobotLoaded",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "SimRunning",
      "conditions": [
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.frameCount > 0",
        "window.__3D_STATE__.precessionAngle > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SpinIncreased",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 60"
      ]
    },
    {
      "id": "S4",
      "name": "MassDecreased",
      "conditions": [
        "window.__3D_STATE__.mass === 1.5"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "DebugHidden",
      "conditions": [
        "window.__3D_STATE__.debugVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "ZeroGravity",
      "conditions": [
        "window.__3D_STATE__.gravity === 0",
        "window.__3D_STATE__.precessionRate === 0"
      ]
    },
    {
      "id": "S8",
      "name": "GravityRestored",
      "conditions": [
        "window.__3D_STATE__.gravity === 9.81",
        "window.__3D_STATE__.precessionRate > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 50",
        "window.__3D_STATE__.mass === 2.0",
        "window.__3D_STATE__.precessionAngle === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.robotLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energy === 625",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.precessionRate - (2.0 * 9.81 * 2.0) / (0.5 * 50)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.precessionRate) && isFinite(window.__3D_STATE__.precessionRate)",
            "tier": "L2"
          }
        ]
      }
    },
