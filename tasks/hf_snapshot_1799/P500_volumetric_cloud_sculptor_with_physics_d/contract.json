      "locator_hints": [
        "#debugOverlay"
      ]
    },
    {
      "id": "A6",
      "name": "InfoLabel",
      "type": "dom_element",
      "semantic": "Bottom-left info label showing particle count and tool",
      "locator_hints": [
        "#infoLabel"
      ]
    },
    {
      "id": "A7",
      "name": "Toolbar",
      "type": "dom_element",
      "semantic": "Top toolbar containing tool buttons",
      "locator_hints": [
        "#toolbar"
      ]
    },
    {
      "id": "A8",
      "name": "SunLight",
      "type": "3d_object",
      "semantic": "Directional sun light",
      "locator_hints": [
        "DirectionalLight"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.toolMode === 'ADD'",
        "window.__3D_STATE__.totalParticles >= 45 && window.__3D_STATE__.totalParticles <= 75",
        "window.__3D_STATE__.debugVisible === false",
        "window.__3D_STATE__.heatmapActive === false",
        "window.__3D_STATE__.windEnabled === true",
        "window.__3D_STATE__.clusterCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "DebugEnabled",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "RemoveToolSelected",
      "conditions": [
        "window.__3D_STATE__.toolMode === 'REMOVE'"
      ]
    },
    {
      "id": "S3",
      "name": "ParticlesAdded",
      "conditions": [
        "window.__3D_STATE__.totalParticles > 75"
      ]
    },
    {
      "id": "S4",
      "name": "WindDisabled",
      "conditions": [
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "HeatmapActive",
      "conditions": [
        "window.__3D_STATE__.heatmapActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "ParticlesRemoved",
      "conditions": [
        "window.__3D_STATE__.historyStackSize >= 2"
      ]
    },
    {
      "id": "S7",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.historyStackSize >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "PhysicsRunning",
      "conditions": [
        "window.__3D_STATE__.physicsStepCount > 0",
        "window.__3D_STATE__.particlesInBounds === true"
      ]
    },
    {
      "id": "S9",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.totalParticles >= 45 && window.__3D_STATE__.totalParticles <= 75",
        "window.__3D_STATE__.clusterCount === 3",
        "window.__3D_STATE__.historyStackSize === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.physicsStepCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgParticleY === 'number' && !isNaN(window.__3D_STATE__.avgParticleY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleY > 0 && window.__3D_STATE__.avgParticleY < 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunIntensity === 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S8",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debugOverlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugOverlay').style.display !== 'none' && document.getElementById('debugOverlay').offsetParent !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugOverlay').textContent.includes('Particle') || document.getElementById('debugOverlay').textContent.includes('particle') || document.getElementById('debugOverlay').textContent.includes('FPS') || document.getElementById('debugOverlay').textContent.includes('fps')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.toolMode === 'ADD'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesInBounds === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnRemove"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.toolMode === 'REMOVE'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btnRemove').style.border.includes('cyan') || document.getElementById('btnRemove').style.borderColor === 'rgb(0, 255, 255)' || document.getElementById('btnRemove').style.border.includes('#00ffff') || getComputedStyle(document.getElementById('btnRemove')).borderColor === 'rgb(0, 255, 255)'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoLabel').textContent.includes('REMOVE')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
