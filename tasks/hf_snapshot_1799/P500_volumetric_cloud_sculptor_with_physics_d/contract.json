        "#btnRemove"
      ]
    },
    {
      "id": "A4",
      "name": "ShapeButton",
      "type": "dom_element",
      "semantic": "Button to select SHAPE sculpting tool",
      "locator_hints": [
        "#btnShape"
      ]
    },
    {
      "id": "A5",
      "name": "DebugOverlay",
      "type": "dom_element",
