          {
            "expr": "window.__3D_STATE__.historyStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalParticles === 'number' && !isNaN(window.__3D_STATE__.totalParticles)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
