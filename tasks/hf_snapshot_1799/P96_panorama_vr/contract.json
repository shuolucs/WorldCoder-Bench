      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.viewDirection.pitch)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.viewDirection.yaw)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRoom === 1",
            "tier": "L2"
