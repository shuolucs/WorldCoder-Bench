            "expr": "window.__3D_STATE__.selectedHotspot === null || typeof window.__3D_STATE__.selectedHotspot === 'string'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRoom === 1",
            "tier": "L2"
