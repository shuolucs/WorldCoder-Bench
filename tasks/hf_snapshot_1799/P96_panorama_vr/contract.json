            "expr": "window.__3D_STATE__.currentRoom === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRoom !== before.currentRoom",
            "tier": "L2"
          }
        ]
      }
    },
    {
