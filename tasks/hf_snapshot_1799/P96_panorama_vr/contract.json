  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "roomCount=3，hotspotCount=5"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.roomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hotspotCount === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.viewDirection === 'object'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.viewDirection.yaw)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_click",
        "selector": "#roomNext"
      },
      "postconditions": [
        "currentRoom 变化"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentRoom === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRoom !== before.currentRoom",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
