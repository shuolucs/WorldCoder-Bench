  "states": [
    {
      "id": "S0",
      "name": "Initial_Waiting",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.bricksRemaining === 40",
        "window.__3D_STATE__.bricksDestroyed === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Playing",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.lives > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Ball_Moving",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.ballSpeed > 0"
      ]
    },
    {
      "id": "S3",
      "name": "P1_Paddle_Moved",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "Math.abs(window.__3D_STATE__.p1PaddleX) > 0.1"
      ]
    },
    {
      "id": "S4",
      "name": "P2_Paddle_Moved",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "Math.abs(window.__3D_STATE__.p2PaddleX) > 0.1"
      ]
    },
    {
      "id": "S5",
      "name": "Bricks_Partially_Destroyed",
      "conditions": [
        "window.__3D_STATE__.bricksDestroyed > 0",
        "window.__3D_STATE__.bricksRemaining < 40"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Paused",
      "conditions": [
        "window.__3D_STATE__.gameState === 'paused'"
      ]
    },
    {
      "id": "S7",
      "name": "Speed_Increased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier > 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "Life_Lost",
      "conditions": [
        "window.__3D_STATE__.lives < 3"
      ]
    },
    {
      "id": "S9",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'",
        "window.__3D_STATE__.lives === 0"
      ]
    },
    {
      "id": "S10",
      "name": "Game_Won",
      "conditions": [
        "window.__3D_STATE__.gameState === 'won'",
        "window.__3D_STATE__.bricksRemaining === 0"
      ]
    },
    {
      "id": "S11",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.bricksRemaining === 40"
      ]
    }
  ],
