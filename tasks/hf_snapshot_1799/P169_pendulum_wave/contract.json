{
  "task_id": "P169_pendulum_wave",
  "affordances": [
    {
      "id": "A1",
      "name": "PendulumWave",
      "type": "3d_object",
      "semantic": "Array of 15 pendulums with different lengths creating a wave pattern",
      "locator_hints": [
        "pendulum bobs are spheres hanging from support bar"
      ]
    },
    {
      "id": "A2",
      "name": "SupportBar",
      "type": "3d_object",
      "semantic": "Horizontal bar at y=12 from which pendulums hang",
      "locator_hints": [
        "box mesh at y=12"
      ]
    },
    {
      "id": "A3",
      "name": "MichelleModel",
      "type": "3d_object",
      "semantic": "Character model loaded from Michelle.glb standing on platform",
      "locator_hints": [
        "GLTF model at x=-8"
      ]
    },
    {
      "id": "A4",
      "name": "Platform",
      "type": "3d_object",
      "semantic": "Raised platform for Michelle to stand on",
      "locator_hints": [
        "box at (-8, 0.25, 0)"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing simulation status, time, speed, gravity",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A6",
      "name": "SpaceKey",
      "type": "dom_element",
      "semantic": "Spacebar toggles play/pause",
      "locator_hints": [
        "keyboard event Space"
      ]
    },
    {
      "id": "A7",
      "name": "ResetKey",
      "type": "dom_element",
      "semantic": "R key resets simulation",
      "locator_hints": [
        "keyboard event KeyR"
      ]
    },
    {
      "id": "A8",
      "name": "GravityToggle",
      "type": "dom_element",
      "semantic": "G key toggles gravity between Earth and Moon",
      "locator_hints": [
        "keyboard event KeyG"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.pendulumCount === 15"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SpedUp",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.timeMultiplier > 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "MoonGravity",
      "conditions": [
        "window.__3D_STATE__.gravityMode === 'moon'",
        "Math.abs(window.__3D_STATE__.gravity - 1.62) < 0.01"
      ]
    },
    {
      "id": "S5",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.resetCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SlowedDown",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.timeMultiplier < 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "EarthGravityRestored",
      "conditions": [
        "window.__3D_STATE__.gravityMode === 'earth'",
        "Math.abs(window.__3D_STATE__.gravity - 9.81) < 0.01"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths[0] >= 3.9 && window.__3D_STATE__.pendulumLengths[0] <= 4.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths[14] >= 8.1 && window.__3D_STATE__.pendulumLengths[14] <= 8.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => typeof a === 'number' && !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => a >= -0.51 && a <= 0.51)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions[0].y < 12 && window.__3D_STATE__.pendulumBobPositions[0].y > 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeMultiplier === 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('status-text') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: '='})), 200); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: '='})), 400);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeMultiplier >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions.every(p => p.y > 0 && p.y < 13)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => Math.abs(a) <= 0.51)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.gravity - 1.62) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions.every(p => !isNaN(p.x) && !isNaN(p.y))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => Math.abs(a - 0.5) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions[0].y < 12",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: '-'})), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeMultiplier <= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => typeof a === 'number' && !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.gravity - 9.81) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}