{
  "task_id": "P1285_procedural_voxel_raymarcher_with_transfe",
  "affordances": [
    {
      "id": "A1",
      "name": "RaymarchQuad",
      "type": "3d_object",
      "semantic": "Fullscreen quad displaying the raymarched volume",
      "locator_hints": [
        "scene.children with PlaneGeometry",
        "ShaderMaterial mesh"
      ]
    },
    {
      "id": "A2",
      "name": "TransferFunctionCanvas",
      "type": "dom_element",
      "semantic": "The 256x100 canvas for editing the transfer function",
      "locator_hints": [
        "#transferFunctionCanvas",
        "canvas element at bottom-center"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing density scale, step count, control points, FPS",
      "locator_hints": [
        "#hud",
        "div at top-left"
      ]
    },
    {
      "id": "A4",
      "name": "MainCanvas",
      "type": "dom_element",
      "semantic": "The Three.js WebGL canvas for mouse drag rotation",
      "locator_hints": [
        "renderer.domElement",
        "canvas.webgl"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.volumeRendered === true",
        "window.__3D_STATE__.shaderCompiled === true",
        "window.__3D_STATE__.controlPoints.length === 5",
        "window.__3D_STATE__.densityScale === 1.5",
        "window.__3D_STATE__.stepCount === 128",
        "Math.abs(window.__3D_STATE__.rotationX - 0.3) < 0.01",
        "Math.abs(window.__3D_STATE__.rotationY - 0.5) < 0.01",
        "window.__3D_STATE__.tfEditorVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "DensityScaleIncreased",
      "conditions": [
        "window.__3D_STATE__.densityScale >= 1.6 && window.__3D_STATE__.densityScale <= 1.7"
      ]
    },
    {
      "id": "S2",
      "name": "DensityScaleDecreased",
      "conditions": [
        "window.__3D_STATE__.densityScale >= 1.4 && window.__3D_STATE__.densityScale <= 1.6"
      ]
    },
    {
      "id": "S3",
      "name": "StepCountIncreased",
      "conditions": [
        "window.__3D_STATE__.stepCount === 256"
      ]
    },
    {
      "id": "S4",
      "name": "StepCountDecreased",
      "conditions": [
        "window.__3D_STATE__.stepCount === 128"
      ]
    },
    {
      "id": "S5",
      "name": "VolumeRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.rotationY - 0.5) > 0.05"
      ]
    },
    {
      "id": "S6",
      "name": "RotationReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.rotationX - 0.3) < 0.01",
        "Math.abs(window.__3D_STATE__.rotationY - 0.5) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "TFEditorHidden",
      "conditions": [
        "window.__3D_STATE__.tfEditorVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "TFEditorShownAgain",
      "conditions": [
        "window.__3D_STATE__.tfEditorVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "ControlPointSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPointIndex >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "ControlPointAdded",
      "conditions": [
        "window.__3D_STATE__.controlPoints.length === 6"
      ]
    }
  ],
