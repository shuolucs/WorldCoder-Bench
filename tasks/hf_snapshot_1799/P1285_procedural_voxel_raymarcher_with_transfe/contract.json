      "action": {
        "type": "script",
        "code": "const tfCanvas = document.getElementById('transferFunctionCanvas'); const rect = tfCanvas.getBoundingClientRect(); const cpX = rect.left + (0.25 * 256); const cpY = rect.top + (0.7 * 100); tfCanvas.dispatchEvent(new MouseEvent('mousedown', {clientX: cpX, clientY: cpY, bubbles: true})); setTimeout(() => { tfCanvas.dispatchEvent(new MouseEvent('mouseup', {clientX: cpX, clientY: cpY, bubbles: true})); }, 50);"
