      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const c = document.querySelector('canvas:not(#transferFunctionCanvas)'); const rect = c.getBoundingClientRect(); const cx = rect.left + rect.width/2; const cy = rect.top + rect.height/2; c.dispatchEvent(new MouseEvent('mousedown', {clientX: cx, clientY: cy, bubbles: true})); setTimeout(() => { c.dispatchEvent(new MouseEvent('mousemove', {clientX: cx + 150, clientY: cy, bubbles: true})); setTimeout(() => { c.dispatchEvent(new MouseEvent('mouseup', {clientX: cx + 150, clientY: cy, bubbles: true})); }, 50); }, 50);"
      },
