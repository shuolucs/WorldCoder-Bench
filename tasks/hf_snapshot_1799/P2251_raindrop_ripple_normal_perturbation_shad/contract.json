{
  "task_id": "P2251_raindrop_ripple_normal_perturbation_shad",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainStemModel",
      "type": "3d_object",
      "semantic": "The loaded BrainStem.glb model with custom ripple shader material applied",
      "locator_hints": [
        "scene.children",
        "GLTFLoader result"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing ripple stats",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A3",
      "name": "RippleCountDisplay",
      "type": "dom_element",
      "semantic": "Shows current active ripple count",
      "locator_hints": [
        "#ripple-count"
      ]
    },
    {
      "id": "A4",
      "name": "RainStatusDisplay",
      "type": "dom_element",
      "semantic": "Shows rain ON/OFF status",
      "locator_hints": [
        "#rain-status"
      ]
    },
    {
      "id": "A5",
      "name": "IntensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling ripple intensity 0-2",
      "locator_hints": [
        "#intensity-slider"
      ]
    },
    {
      "id": "A6",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to clear all active ripples",
      "locator_hints": [
        "#clear-btn"
      ]
    },
    {
      "id": "A7",
      "name": "BurstButton",
      "type": "dom_element",
      "semantic": "Button to spawn 10 ripples at once",
      "locator_hints": [
        "#burst-btn"
      ]
    },
    {
      "id": "A8",
      "name": "IntensityDisplay",
      "type": "dom_element",
      "semantic": "Shows current intensity value",
      "locator_hints": [
        "#intensity-display"
      ]
    },
    {
      "id": "A9",
      "name": "TotalSpawnedDisplay",
      "type": "dom_element",
      "semantic": "Shows cumulative ripples spawned",
      "locator_hints": [
        "#total-spawned"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__ === undefined || window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoadedRainActive",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rainEnabled === true"
      ]
    },
    {
      "id": "S2",
      "name": "RipplesAccumulating",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rainEnabled === true",
        "window.__3D_STATE__.activeRippleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "RainPaused",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rainEnabled === false"
      ]
    },
    {
      "id": "S4",
      "name": "RipplesCleared",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.activeRippleCount === 0",
        "window.__3D_STATE__.clearedAtTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "IntensityAdjusted",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rippleIntensity !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "BurstTriggered",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.lastBurstTime > 0"
      ]
    },
    {
      "id": "S7",
      "name": "ManualRippleAdded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.lastManualRippleTime > 0"
      ]
    },
    {
      "id": "S8",
      "name": "RainResumed",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.rainEnabled === true",
        "window.__3D_STATE__.totalSpawned > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ripples === 'object' && Array.isArray(window.__3D_STATE__.ripples)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ripples.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rippleIntensity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRipples === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeRippleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpawned >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).length === window.__3D_STATE__.activeRippleCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).every(r => r.age >= 0 && r.age <= 3.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0 && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rippleSpeed === 0.8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('rain-status') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('rain-status').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalSpawned === 'number' && window.__3D_STATE__.totalSpawned > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rippleLifetime === 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('intensity-slider'); if(slider) { const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '0.35'); slider.dispatchEvent(new Event('input', {bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rippleIntensity - 0.35) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('intensity-slider') !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(parseFloat(document.getElementById('intensity-slider').value) - 0.35) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('intensity-display') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rippleIntensity >= 0.0 && window.__3D_STATE__.rippleIntensity <= 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#clear-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeRippleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.every(r => r.active === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clearedAtTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpawned > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('ripple-count').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#burst-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastBurstTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeRippleCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).every(r => !isNaN(r.centerX) && !isNaN(r.centerY) && !isNaN(r.centerZ))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).every(r => r.age >= 0 && r.age < 1.0)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastBurstTime === 'number' && window.__3D_STATE__.lastBurstTime > window.__3D_STATE__.clearedAtTime",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_burst_total = window.__3D_STATE__.totalSpawned; document.getElementById('burst-btn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSpawned > window.__pre_burst_total",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpawned >= window.__pre_burst_total + 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeRippleCount <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeRippleCount === window.__3D_STATE__.ripples.filter(r => r.active).length",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).every(r => Math.abs(r.centerX) < 5 && Math.abs(r.centerY) < 5 && Math.abs(r.centerZ) < 5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('rain-status').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpawned > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('intensity-slider'); if(slider) { const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '2.0'); slider.dispatchEvent(new Event('input', {bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.rippleIntensity - 2.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rippleIntensity <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeRippleCount >= 0 && window.__3D_STATE__.activeRippleCount <= 20",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('intensity-display') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_clear_total = window.__3D_STATE__.totalSpawned; document.getElementById('clear-btn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeRippleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.every(r => r.active === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSpawned === window.__pre_clear_total",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clearedAtTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ripples.filter(r => r.active).length === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}