{
  "task_id": "P515_sound_reactive_sculpture_with_particle_e",
  "affordances": [
    {
      "id": "A1",
      "name": "Sculpture",
      "type": "3d_object",
      "semantic": "LittlestTokyo GLTF model used as central sculpture",
      "locator_hints": [
        "scene.children find mesh group",
        "window.__3D_STATE__.modelLoaded"
      ]
    },
    {
      "id": "A2",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "2000-particle Points system around sculpture",
      "locator_hints": [
        "THREE.Points in scene",
        "window.__3D_STATE__.particleCount"
      ]
    },
    {
      "id": "A3",
      "name": "AudioButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulated audio",
      "locator_hints": [
        "#btn-audio"
      ]
    },
    {
      "id": "A4",
      "name": "ModeSelector",
      "type": "dom_element",
      "semantic": "Dropdown to select interaction mode",
      "locator_hints": [
        "#select-mode"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display overlay with stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "WarmLight",
      "type": "3d_object",
      "semantic": "Warm point light reacting to bass",
      "locator_hints": [
        "window.__3D_STATE__.warmLightIntensity"
      ]
    },
    {
      "id": "A7",
      "name": "CoolLight",
      "type": "3d_object",
      "semantic": "Cool point light reacting to mid",
      "locator_hints": [
        "window.__3D_STATE__.coolLightIntensity"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Load",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.audioActive === false",
        "window.__3D_STATE__.mode === 'Ambient'",
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.colorScheme === 'default'"
      ]
    },
    {
      "id": "S1",
      "name": "Audio_Active",
      "conditions": [
        "window.__3D_STATE__.audioActive === true",
        "window.__3D_STATE__.bass >= 0",
        "window.__3D_STATE__.bass <= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Explosive_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'Explosive'",
        "window.__3D_STATE__.audioActive === true"
      ]
    },
    {
      "id": "S3",
      "name": "Zen_Mode",
      "conditions": [
        "window.__3D_STATE__.mode === 'Zen'",
        "window.__3D_STATE__.audioActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "Particles_Hidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "Ocean_Colors",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'ocean'"
      ]
    },
    {
      "id": "S6",
      "name": "Fire_Colors",
      "conditions": [
        "window.__3D_STATE__.colorScheme === 'fire'"
      ]
    },
    {
      "id": "S7",
      "name": "Camera_Reset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 5) < 0.5",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 15) < 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "Audio_Stopped_After_Activity",
      "conditions": [
        "window.__3D_STATE__.audioActive === false",
        "window.__3D_STATE__.frameCount > 60"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Ambient !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Explosive !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Zen !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-audio"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-audio').textContent.includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Ambient !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Explosive !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Zen !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('select-mode').value = 'Explosive'; document.getElementById('select-mode').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-mode').textContent.includes('Explosive')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('select-mode').value === 'Explosive'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('select-mode').value = 'Zen'; document.getElementById('select-mode').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-mode').textContent.includes('Zen')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-particles').textContent.includes('hidden') || document.getElementById('hud-particles').textContent.includes('0')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-color').textContent.includes('ocean')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-color').textContent.includes('fire')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('hud-audio').textContent.includes('OFF')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}