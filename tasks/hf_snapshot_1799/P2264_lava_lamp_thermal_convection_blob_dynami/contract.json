{
  "task_id": "P2264_lava_lamp_thermal_convection_blob_dynami",
  "affordances": [
    {
      "id": "A1",
      "name": "LavaLampGlass",
      "type": "3d_object",
      "semantic": "Transparent cylindrical glass body of the lava lamp",
      "locator_hints": [
        "cylinder mesh with transmission material",
        "opacity ~0.15"
      ]
    },
    {
      "id": "A2",
      "name": "LavaBlobs",
      "type": "3d_object",
      "semantic": "Array of 8 initial sphere blobs simulating lava convection",
      "locator_hints": [
        "sphere meshes with emissive red/yellow material"
      ]
    },
    {
      "id": "A3",
      "name": "ChessModel",
      "type": "3d_object",
      "semantic": "Loaded ABeautifulGame.glb chess set model placed beside the lamp",
      "locator_hints": [
        "GLTF model at x=4"
      ]
    },
    {
      "id": "A4",
      "name": "GravitySlider",
      "type": "dom_element",
      "semantic": "Range input controlling gravity multiplier",
      "locator_hints": [
        "#gravitySlider"
      ]
    },
    {
      "id": "A5",
      "name": "ViscositySlider",
      "type": "dom_element",
      "semantic": "Range input controlling drag coefficient",
      "locator_hints": [
        "#viscositySlider"
      ]
    },
    {
      "id": "A6",
      "name": "AddBlobButton",
      "type": "dom_element",
      "semantic": "Button to add a new blob to the simulation",
      "locator_hints": [
        "#addBlobBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Real-time heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initialized",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.blobCount === 8",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationTime > 0",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "HeatBoosted",
      "conditions": [
        "window.__3D_STATE__.heatBoostCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "CoolBlasted",
      "conditions": [
        "window.__3D_STATE__.coolBlastCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "Shaken",
      "conditions": [
        "window.__3D_STATE__.shakeCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "GravityAdjusted",
      "conditions": [
        "window.__3D_STATE__.gravity !== 9.8"
      ]
    },
    {
      "id": "S7",
      "name": "BlobAdded",
      "conditions": [
        "window.__3D_STATE__.blobCount === 9"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.blobCount === 8",
        "window.__3D_STATE__.heatBoostCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "ViscosityAdjusted",
      "conditions": [
        "window.__3D_STATE__.viscosity !== 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount === 8",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blobs) && window.__3D_STATE__.blobs.length === 8",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => typeof b.temperature === 'number' && b.temperature >= 0 && b.temperature <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0 && !isNaN(window.__3D_STATE__.simulationTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.chessModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.x) && !isNaN(b.y) && !isNaN(b.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.vx) && !isNaN(b.vy) && !isNaN(b.vz))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => Math.sqrt(b.x*b.x + b.z*b.z) <= 1.15)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => b.y >= -1.6 && b.y <= 3.6)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number' && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const before = window.__3D_STATE__.blobs.map(b => b.temperature); window.__T3_before_temps__ = before; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'h', code: 'KeyH', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatBoostCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => b.temperature >= 0 && b.temperature <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageTemperature > 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.averageTemperature === 'number' && !isNaN(window.__3D_STATE__.averageTemperature)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobs.some(b => b.temperature > 0.4)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T4_before_avg__ = window.__3D_STATE__.averageTemperature; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c', code: 'KeyC', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.coolBlastCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageTemperature < window.__T4_before_avg__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => b.temperature >= 0 && b.temperature <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.temperature))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.coolBlastCount === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_before_velocities__ = window.__3D_STATE__.blobs.map(b => Math.sqrt(b.vx*b.vx + b.vy*b.vy + b.vz*b.vz)); document.dispatchEvent(new KeyboardEvent('keydown', {key: 's', code: 'KeyS', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shakeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.some((b, i) => Math.sqrt(b.vx*b.vx + b.vy*b.vy + b.vz*b.vz) > window.__T5_before_velocities__[i] * 0.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.vx) && !isNaN(b.vy) && !isNaN(b.vz))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => Math.abs(b.vx) < 50 && Math.abs(b.vy) < 50 && Math.abs(b.vz) < 50)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount === 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T6_before_simTime__ = window.__3D_STATE__.simulationTime; document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.simulationTime - window.__T6_before_simTime__) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.paused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobCount >= 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true})); const slider = document.getElementById('gravitySlider'); if(slider) { const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '15'); slider.dispatchEvent(new Event('input', {bubbles: true})); slider.dispatchEvent(new Event('change', {bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravity >= 14.5 && window.__3D_STATE__.gravity <= 15.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravity !== 9.8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.gravity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('gravitySlider') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addBlobBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blobCount === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.length === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs[8] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.blobs[8].temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blobs[8].temperature - 0.5) < 0.15 || window.__3D_STATE__.blobs[8].temperature >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs[8].radius > 0.1 && window.__3D_STATE__.blobs[8].radius < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('viscositySlider'); if(slider) { const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '1.5'); slider.dispatchEvent(new Event('input', {bubbles: true})); slider.dispatchEvent(new Event('change', {bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viscosity >= 1.4 && window.__3D_STATE__.viscosity <= 1.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viscosity !== 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.viscosity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('viscositySlider') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobCount === 9",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blobCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.length === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatBoostCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coolBlastCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shakeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravity >= 9.7 && window.__3D_STATE__.gravity <= 9.9",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}