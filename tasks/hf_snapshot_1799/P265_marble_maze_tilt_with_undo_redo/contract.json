  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "InitialReady",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.tiltX === 0",
        "window.__3D_STATE__.tiltZ === 0",
        "window.__3D_STATE__.fallCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "TiltedRight",
      "conditions": [
        "window.__3D_STATE__.tiltZ > 0.01"
      ]
    },
    {
      "id": "S3",
      "name": "MarbleMoving",
      "conditions": [
        "window.__3D_STATE__.speed > 0.1"
      ]
    },
    {
      "id": "S4",
      "name": "SnapshotsCaptured",
      "conditions": [
        "window.__3D_STATE__.snapshotCount >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S6",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.canRedo === false || window.__3D_STATE__.undoIndex === window.__3D_STATE__.snapshotCount - 1"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.snapshotCount <= 1",
        "window.__3D_STATE__.tiltX === 0",
        "window.__3D_STATE__.tiltZ === 0"
      ]
    }
  ],
