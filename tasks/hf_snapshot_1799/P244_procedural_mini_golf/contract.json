  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.courseWidth === 8",
        "window.__3D_STATE__.courseLength === 20"
      ]
    },
    {
      "id": "S1",
      "name": "InitialReady",
      "conditions": [
        "window.__3D_STATE__.gameStatus === 'aiming'",
        "window.__3D_STATE__.strokes === 0",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.ballPosition.z > 5.5"
      ]
    },
    {
      "id": "S2",
      "name": "FerrarLoaded",
      "conditions": [
        "window.__3D_STATE__.ferrarLoaded === true",
        "window.__3D_STATE__.obstacleCount === 3"
      ]
    },
    {
      "id": "S3",
      "name": "Charging",
      "conditions": [
        "window.__3D_STATE__.charging === true",
        "window.__3D_STATE__.power > 0"
      ]
    },
    {
      "id": "S4",
      "name": "BallMoving",
      "conditions": [
        "window.__3D_STATE__.ballMoving === true",
        "window.__3D_STATE__.gameStatus === 'moving'",
        "window.__3D_STATE__.strokes >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "BallStopped",
      "conditions": [
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.gameStatus === 'aiming'",
        "window.__3D_STATE__.strokes >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "AimAdjusted",
      "conditions": [
        "window.__3D_STATE__.ballMoving === false",
        "Math.abs(window.__3D_STATE__.aimAngle) > 0.04"
      ]
    },
    {
      "id": "S7",
      "name": "SecondShotMoving",
      "conditions": [
        "window.__3D_STATE__.ballMoving === true",
        "window.__3D_STATE__.strokes >= 2"
      ]
    },
    {
      "id": "S8",
      "name": "BallInHole",
      "conditions": [
        "window.__3D_STATE__.holeComplete === true",
        "window.__3D_STATE__.gameStatus === 'complete'"
      ]
    },
    {
      "id": "S9",
      "name": "BallReset",
      "conditions": [
        "window.__3D_STATE__.ballPosition.z > 5.5",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.ballSpeed < 0.01"
      ]
    }
  ],
