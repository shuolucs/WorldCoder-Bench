{
  "task_id": "P497_fractal_tree_generator_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalTree",
      "type": "3d_object",
      "semantic": "The recursive fractal tree made of cylinder branches",
      "locator_hints": [
        "scene children with cylinder geometry",
        "brown/green colored meshes"
      ]
    },
    {
      "id": "A2",
      "name": "Flamingo",
      "type": "3d_object",
      "semantic": "The flamingo GLB model perched on the tree",
      "locator_hints": [
        "window.__flamingo",
        "GLTF loaded model"
      ]
    },
    {
      "id": "A3",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to increase tree depth",
      "locator_hints": [
        "#btn-grow"
      ]
    },
    {
      "id": "A4",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last grow",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A5",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone grow",
      "locator_hints": [
        "#btn-redo"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset tree to depth 0",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "DepthDisplay",
      "type": "dom_element",
      "semantic": "Shows current depth",
      "locator_hints": [
        "#depth-display"
      ]
    },
    {
      "id": "A8",
      "name": "BranchCountDisplay",
      "type": "dom_element",
      "semantic": "Shows total branch count",
      "locator_hints": [
        "#branch-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Trunk_Only",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 0",
        "window.__3D_STATE__.branchCount === 1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Depth_1",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 1",
        "window.__3D_STATE__.branchCount === 3"
      ]
    },
    {
      "id": "S2",
      "name": "Depth_2",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 2",
        "window.__3D_STATE__.branchCount === 7"
      ]
    },
    {
      "id": "S3",
      "name": "Depth_3_With_Leaves",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 3",
        "window.__3D_STATE__.branchCount === 15",
        "window.__3D_STATE__.hasLeaves === true"
      ]
    },
    {
      "id": "S4",
      "name": "After_Undo_To_Depth2",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 2",
        "window.__3D_STATE__.branchCount === 7",
        "window.__3D_STATE__.hasLeaves === false",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "After_Redo_To_Depth3",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 3",
        "window.__3D_STATE__.branchCount === 15",
        "window.__3D_STATE__.hasLeaves === true"
      ]
    },
    {
      "id": "S6",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.treeDepth === 0",
        "window.__3D_STATE__.branchCount === 1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Flamingo_Loaded",
      "conditions": [
        "window.__3D_STATE__.flamingoLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
