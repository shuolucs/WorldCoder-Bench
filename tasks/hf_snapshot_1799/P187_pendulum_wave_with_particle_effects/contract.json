        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles[0] !== window.__3D_STATE__.pendulumAngles[14]",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions[0].x < -6 && window.__3D_STATE__.pendulumBobPositions[0].x > -8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions[14].x > 6 && window.__3D_STATE__.pendulumBobPositions[14].x < 8",
