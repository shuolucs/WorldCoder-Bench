        "colored HSL gradient"
      ]
    },
    {
      "id": "A2",
      "name": "PendulumRods",
      "type": "3d_object",
      "semantic": "Thin cylinder rods connecting pivots to bobs",
      "locator_hints": [
        "cylinders from y=10 downward"
      ]
    },
    {
      "id": "A3",
      "name": "ParticleSystems",
      "type": "3d_object",
      "semantic": "Particle trail effects behind each bob",
      "locator_hints": [
        "Points objects near bobs"
      ]
    },
    {
      "id": "A4",
      "name": "NefertitiBust",
      "type": "3d_object",
      "semantic": "Gold Nefertiti bust loaded from GLB at center-back",
      "locator_hints": [
        "position (0, 1.5, -5)",
        "metallic gold material"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left info overlay showing time, amplitude, particles, paused, selected",
      "locator_hints": [
        "div with monospace font",
        "top-left corner"
      ]
    },
    {
      "id": "A6",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark ground plane at y=0",
      "locator_hints": [
        "50x50 plane"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.amplitude === 0.8",
        "window.__3D_STATE__.particlesEnabled === true",
        "window.__3D_STATE__.selectedPendulum === -1",
        "window.__3D_STATE__.pendulumCount === 15"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.pendulumAngles.length === 15"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S4",
      "name": "AmplitudeIncreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.amplitude - 0.9) < 0.01"
      ]
    },
    {
      "id": "S5",
      "name": "ParticlesDisabled",
      "conditions": [
        "window.__3D_STATE__.particlesEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.elapsedTime < 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "NefertitiLoaded",
      "conditions": [
        "window.__3D_STATE__.nefertitiLoaded === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.length === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a) && Math.abs(a) <= 0.81)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions.every(p => p.y > 3 && p.y < 11)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "(() => { window.__testTime = window.__3D_STATE__.elapsedTime; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.amplitude - 0.9) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitude > 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a) && Math.abs(a) <= 0.91)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particlesEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumBobPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amplitude > 0.09 && window.__3D_STATE__.amplitude < 1.51",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pendulumCount === 15",
