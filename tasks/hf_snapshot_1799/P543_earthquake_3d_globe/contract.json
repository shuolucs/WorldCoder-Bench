{
  "task_id": "P543_earthquake_3d_globe",
  "affordances": [
    {"id": "A1", "name": "Globe", "type": "3d_object", "semantic": "Earth sphere with procedural land/ocean colors", "locator_hints": ["sphere geometry mesh"]},
    {"id": "A2", "name": "WaveRings", "type": "3d_object", "semantic": "Expanding P-wave and S-wave ring fronts", "locator_hints": ["torus/ring meshes"]},
    {"id": "A3", "name": "EpicenterMarkers", "type": "3d_object", "semantic": "Yellow pulsing spheres at epicenters", "locator_hints": ["small sphere meshes yellow"]},
    {"id": "A4", "name": "MagnitudeSlider", "type": "dom_element", "semantic": "Earthquake magnitude control", "locator_hints": ["#slider-magnitude"]},
    {"id": "A5", "name": "WaveSpeedSlider", "type": "dom_element", "semantic": "Wave speed multiplier", "locator_hints": ["#slider-wave-speed"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.activeQuakes === 0", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "QuakePlaced", "conditions": ["window.__3D_STATE__.activeQuakes > 0"]},
    {"id": "S2", "name": "WavesPropagating", "conditions": ["window.__3D_STATE__.latestPWaveRadius > 1"]},
    {"id": "S3", "name": "Cleared", "conditions": ["window.__3D_STATE__.activeQuakes === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.activeQuakes === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.globeValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-magnitude').value = 7; document.getElementById('slider-magnitude').dispatchEvent(new Event('input')); const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.left + rect.width*0.5, clientY: rect.top + rect.height*0.4})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.activeQuakes >= 1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.magnitude >= 6", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.latestPWaveRadius > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.latestPWaveRadius > window.__3D_STATE__.latestSWaveRadius || window.__3D_STATE__.latestPWaveRadius >= window.__3D_STATE__.latestSWaveRadius", "tier": "L1"},
        {"expr": "window.__3D_STATE__.globeValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.totalWaveEnergy > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-wave-speed').value = 2.5; document.getElementById('slider-wave-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.waveSpeedMultiplier >= 2.0", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "c"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.activeQuakes === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.globeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "a"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.autoRotate !== before.autoRotate", "tier": "L2"},
        {"expr": "document.getElementById('hud-rotate') !== null", "tier": "L2"}
      ]}
    }
  ]
}
