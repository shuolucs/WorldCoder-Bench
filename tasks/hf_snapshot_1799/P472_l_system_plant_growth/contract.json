      ]
    },
    {
      "id": "A2",
      "name": "PlantGroups",
      "type": "3d_object",
      "semantic": "Six L-system plant groups arranged in circle",
      "locator_hints": [
        "radius 2.5 from origin",
        "on ground plane y=0"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark green ground plane",
      "locator_hints": [
        "y=0",
        "20x20 size"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing generation and segment count",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A5",
      "name": "ExportButton",
      "type": "dom_element",
      "semantic": "Export Stats button top-right",
      "locator_hints": [
        "button#export-btn"
      ]
    },
    {
      "id": "A6",
      "name": "StatsDisplay",
      "type": "dom_element",
      "semantic": "Stats output div below export button",
      "locator_hints": [
        "div#stats-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_ModelLoading",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalSegments === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded_Gen0",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalSegments === 0",
        "window.__3D_STATE__.axiom === 'F'"
      ]
    },
    {
      "id": "S2",
      "name": "Gen1_Growing",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.growthAnimating === true"
      ]
    },
    {
      "id": "S3",
      "name": "Gen1_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.growthAnimating === false",
        "window.__3D_STATE__.totalSegments > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Gen2_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.growthAnimating === false"
      ]
    },
    {
      "id": "S5",
      "name": "AutumnMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'autumn'"
      ]
    },
    {
      "id": "S6",
      "name": "LeavesEnabled",
      "conditions": [
        "window.__3D_STATE__.leavesEnabled === true",
        "window.__3D_STATE__.leafCount > 0"
      ]
    },
    {
      "id": "S7",
      "name": "WindActive",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "PlantClicked",
      "conditions": [
        "window.__3D_STATE__.lastClickedPlant >= 0",
        "window.__3D_STATE__.lastClickedPlant <= 5"
      ]
    },
    {
      "id": "S9",
      "name": "StatsExported",
      "conditions": [
        "window.__3D_STATE__.statsExported === true"
      ]
    },
    {
      "id": "S10",
      "name": "ResetToGen0",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalSegments === 0",
        "window.__3D_STATE__.axiom === 'F'"
      ]
    }
  ],
  "transitions": [
