      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[4].turbidity > window.__3D_STATE__.beakers[3].turbidity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[3].turbidity > window.__3D_STATE__.beakers[2].turbidity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[2].turbidity > window.__3D_STATE__.beakers[1].turbidity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[1].turbidity > window.__3D_STATE__.beakers[0].turbidity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSulfurMass === window.__3D_STATE__.beakers.reduce((s,b) => s + b.turbidity, 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S2",
      "severity": "P0",
