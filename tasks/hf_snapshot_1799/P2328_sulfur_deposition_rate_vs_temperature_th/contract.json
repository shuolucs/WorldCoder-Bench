  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.beakers.every(b => b.turbidity === 0)",
        "window.__3D_STATE__.experimentComplete === false"
      ]
    },
    {
      "id": "S1",
      "name": "Experiment_Running",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.simulationPaused === false",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Experiment_Paused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.simulationPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Partial_Deposition",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.beakers.some(b => b.turbidity > 0.1)",
        "window.__3D_STATE__.beakers.some(b => b.obscured === false)"
      ]
    },
    {
      "id": "S4",
      "name": "Hottest_Beaker_Obscured",
      "conditions": [
        "window.__3D_STATE__.beakers[4].obscured === true",
        "window.__3D_STATE__.beakers[0].obscured === false"
      ]
    },
    {
      "id": "S5",
      "name": "All_Obscured",
      "conditions": [
        "window.__3D_STATE__.experimentComplete === true",
        "window.__3D_STATE__.beakers.every(b => b.obscured === true)"
      ]
    },
    {
      "id": "S6",
      "name": "Debug_Overlay_Visible",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Graph_Visible",
      "conditions": [
        "window.__3D_STATE__.graphVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "Beaker_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedBeakerIndex !== null && window.__3D_STATE__.selectedBeakerIndex >= 0"
      ]
    },
    {
      "id": "S9",
      "name": "Post_Reset",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.beakers.every(b => b.turbidity === 0)",
        "window.__3D_STATE__.experimentComplete === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Start Experiment"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.beakers) && window.__3D_STATE__.beakers.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => typeof b.arrheniusRate === 'number' && b.arrheniusRate > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nanDetected === false",
            "tier": "L2"
          }
        ]
      }
    },
