{
  "task_id": "P480_crystal_growth_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "BasePlatform",
      "type": "3d_object",
      "semantic": "Hexagonal base platform where crystals grow from",
      "locator_hints": [
        "hexagonal mesh at y=0",
        "dark stone platform"
      ]
    },
    {
      "id": "A2",
      "name": "CrystalShard",
      "type": "3d_object",
      "semantic": "Individual crystal shard geometry",
      "locator_hints": [
        "scaled icosahedron",
        "transparent physical material"
      ]
    },
    {
      "id": "A3",
      "name": "ClusterCounter",
      "type": "dom_element",
      "semantic": "HUD showing cluster count",
      "locator_hints": [
        "top-left text",
        "Clusters: X/5"
      ]
    },
    {
      "id": "A4",
      "name": "ShardCounter",
      "type": "dom_element",
      "semantic": "HUD showing shard count",
      "locator_hints": [
        "top-left text",
        "Shards: X/60"
      ]
    },
    {
      "id": "A5",
      "name": "TypeIndicator",
      "type": "dom_element",
      "semantic": "Current crystal type display",
      "locator_hints": [
        "top-right",
        "colored square"
      ]
    },
    {
      "id": "A6",
      "name": "GrowthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling growth speed",
      "locator_hints": [
        "bottom-center slider",
        "range input"
      ]
    },
    {
      "id": "A7",
      "name": "StatusPanel",
      "type": "dom_element",
      "semantic": "Status indicators panel",
      "locator_hints": [
        "bottom-left",
        "ON/OFF indicators"
      ]
    },
    {
      "id": "A8",
      "name": "SparkleParticles",
      "type": "3d_object",
      "semantic": "Floating sparkle particles near crystals",
      "locator_hints": [
        "small spheres",
        "additive blending"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.clusterCount === 0",
        "window.__3D_STATE__.shardCount === 0",
        "window.__3D_STATE__.selectedType === 'amethyst'",
        "window.__3D_STATE__.frozen === false",
        "window.__3D_STATE__.autoGrowth === false"
      ]
    },
    {
      "id": "S1",
      "name": "Type_Selected_Emerald",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'emerald'",
        "window.__3D_STATE__.selectedTypeIndex === 2"
      ]
    },
    {
      "id": "S2",
      "name": "Type_Selected_Sapphire",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'sapphire'",
        "window.__3D_STATE__.selectedTypeIndex === 3"
      ]
    },
    {
      "id": "S3",
      "name": "First_Cluster_Placed",
      "conditions": [
        "window.__3D_STATE__.clusterCount === 1",
        "window.__3D_STATE__.shardCount > 0",
        "window.__3D_STATE__.lastClusterPosition !== null"
      ]
    },
    {
      "id": "S4",
      "name": "Crystals_Growing",
      "conditions": [
        "window.__3D_STATE__.shardCount >= 3",
        "window.__3D_STATE__.averageShardScale > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Growth_Frozen",
      "conditions": [
        "window.__3D_STATE__.frozen === true"
      ]
    },
    {
      "id": "S6",
      "name": "Auto_Growth_Active",
      "conditions": [
        "window.__3D_STATE__.autoGrowth === true",
        "window.__3D_STATE__.frozen === false"
      ]
    },
    {
      "id": "S7",
      "name": "Rotation_Active",
      "conditions": [
        "window.__3D_STATE__.rotating === true"
      ]
    },
    {
      "id": "S8",
      "name": "Glow_Enabled",
      "conditions": [
        "window.__3D_STATE__.glowEnabled === true"
      ]
    },
    {
      "id": "S9",
      "name": "Growth_Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.growthSpeed !== 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "Scene_Cleared",
      "conditions": [
        "window.__3D_STATE__.clusterCount === 0",
        "window.__3D_STATE__.shardCount === 0",
        "window.__3D_STATE__.lastClusterPosition === null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.clusterCount !== before.clusterCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.clusterCount === 'number' && !isNaN(window.__3D_STATE__.clusterCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.shardCount === 'number' && !isNaN(window.__3D_STATE__.shardCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.totalClusters)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.clusterCount >= 0",
            "tier": "L2"
          },
