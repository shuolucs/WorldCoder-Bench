{
  "task_id": "P184_multiplayer_heat_conduction_visualizatio",
  "affordances": [
    {
      "id": "A1",
      "name": "HeatGrid",
      "type": "3d_object",
      "semantic": "10x10 grid of tiles representing temperature cells",
      "locator_hints": [
        "grid of 100 mesh objects on XZ plane"
      ]
    },
    {
      "id": "A2",
      "name": "Player1Avatar",
      "type": "3d_object",
      "semantic": "Red-tinted Michelle model for Player 1",
      "locator_hints": [
        "Michelle.glb model with red tint at p1 position"
      ]
    },
    {
      "id": "A3",
      "name": "Player2Avatar",
      "type": "3d_object",
      "semantic": "Blue-tinted Michelle model for Player 2",
      "locator_hints": [
        "Michelle.glb model with blue tint at p2 position"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all temperatures and remove sources/sinks",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A5",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume the heat simulation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A6",
      "name": "PositionDisplay",
      "type": "dom_element",
      "semantic": "HUD showing both player positions",
      "locator_hints": [
        "#posDisplay"
      ]
    },
    {
      "id": "A7",
      "name": "CountDisplay",
      "type": "dom_element",
      "semantic": "HUD showing source and sink counts",
      "locator_hints": [
        "#countDisplay"
      ]
    },
    {
      "id": "A8",
      "name": "AvgTempDisplay",
      "type": "dom_element",
      "semantic": "HUD showing average temperature",
      "locator_hints": [
        "#avgTempDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "SimStatusDisplay",
      "type": "dom_element",
      "semantic": "HUD showing simulation running/paused",
      "locator_hints": [
        "#simStatus"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelsLoaded",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.p1ModelVisible === true",
        "window.__3D_STATE__.p2ModelVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Player1Moved",
      "conditions": [
        "window.__3D_STATE__.p1Pos.x === 1 && window.__3D_STATE__.p1Pos.z === 0"
      ]
    },
    {
      "id": "S2",
      "name": "HeatSourcePlaced",
      "conditions": [
        "window.__3D_STATE__.sources.length === 1",
        "window.__3D_STATE__.grid[1][0] === 100"
      ]
    },
    {
      "id": "S3",
      "name": "Player2Moved",
      "conditions": [
        "window.__3D_STATE__.p2Pos.x === 8 && window.__3D_STATE__.p2Pos.z === 9"
      ]
    },
    {
      "id": "S4",
      "name": "ColdSinkPlaced",
      "conditions": [
        "window.__3D_STATE__.sinks.length === 1",
        "window.__3D_STATE__.grid[8][9] === -100"
      ]
    },
    {
      "id": "S5",
      "name": "DiffusionProgressed",
      "conditions": [
        "window.__3D_STATE__.stepCount >= 10",
        "window.__3D_STATE__.avgTemp !== 0"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.sources.length === 0",
        "window.__3D_STATE__.sinks.length === 0",
        "window.__3D_STATE__.avgTemp === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p1ModelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p2ModelVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p1Pos.x === 0 && window.__3D_STATE__.p1Pos.z === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p2Pos.x === 9 && window.__3D_STATE__.p2Pos.z === 9",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.p1Pos.x === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p1Pos.z === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p1Pos.x >= 0 && window.__3D_STATE__.p1Pos.x <= 9",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('posDisplay').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sources.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sources[0].x === 1 && window.__3D_STATE__.sources[0].z === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[1][0] === 100",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('countDisplay').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.p2Pos.x === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p2Pos.z === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.p2Pos.x >= 0 && window.__3D_STATE__.p2Pos.x <= 9",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('posDisplay').textContent.includes('8')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "Enter"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sinks.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sinks[0].x === 8 && window.__3D_STATE__.sinks[0].z === 9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[8][9] === -100",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('countDisplay').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepCount >= 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgTemp)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.avgTemp)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[1][0] === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[8][9] === -100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('simStatus').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepCount === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sources.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sinks.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemp === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[1][0] === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[8][9] === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}