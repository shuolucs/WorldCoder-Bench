{
  "task_id": "P1273_miniature_frustum_culling_visualizer_wit",
  "affordances": [
    {
      "id": "A1",
      "name": "SubjectCamera",
      "type": "3d_object",
      "semantic": "The movable perspective camera whose frustum is visualized",
      "locator_hints": [
        "yellow cone mesh",
        "subject camera object"
      ]
    },
    {
      "id": "A2",
      "name": "FrustumWireframe",
      "type": "3d_object",
      "semantic": "Cyan wireframe lines showing the subject camera frustum",
      "locator_hints": [
        "LineSegments with cyan material"
      ]
    },
    {
      "id": "A3",
      "name": "SceneObjects",
      "type": "3d_object",
      "semantic": "25 scattered box/sphere objects tested against frustum",
      "locator_hints": [
        "BoxGeometry and SphereGeometry meshes"
      ]
    },
    {
      "id": "A4",
      "name": "AABBWireframes",
      "type": "3d_object",
      "semantic": "Wireframe bounding boxes around each object, colored by culling state",
      "locator_hints": [
        "green or red wireframe boxes"
      ]
    },
    {
      "id": "A5",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Overlay panel showing frustum stats",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleAABBButton",
      "type": "dom_element",
      "semantic": "Button to toggle AABB wireframe visibility",
      "locator_hints": [
        "#btn-toggle-aabb"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset subject camera to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalObjects === 25",
        "window.__3D_STATE__.subjectFOV === 60",
        "window.__3D_STATE__.subjectFar === 20",
        "window.__3D_STATE__.subjectNear === 1",
        "window.__3D_STATE__.aabbVisible === true",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S1",
      "name": "AfterRotateLeft",
      "conditions": [
        "window.__3D_STATE__.subjectRotationY !== 0",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMoveForward",
      "conditions": [
        "window.__3D_STATE__.subjectPosition.y === 2",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S3",
      "name": "FOVDecreased",
      "conditions": [
        "window.__3D_STATE__.subjectFOV === 55",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S4",
      "name": "FarPlaneIncreased",
      "conditions": [
        "window.__3D_STATE__.subjectFar === 22",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S5",
      "name": "AABBsHidden",
      "conditions": [
        "window.__3D_STATE__.aabbVisible === false",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S6",
      "name": "AABBsRestoredVisible",
      "conditions": [
        "window.__3D_STATE__.aabbVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "FOVAtMinimum",
      "conditions": [
        "window.__3D_STATE__.subjectFOV === 20",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S8",
      "name": "FarPlaneAtMinimum",
      "conditions": [
        "window.__3D_STATE__.subjectFar === 6",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.subjectFOV === 60",
        "window.__3D_STATE__.subjectFar === 20",
        "window.__3D_STATE__.subjectPosition.x === 0",
        "window.__3D_STATE__.subjectPosition.z === 0",
        "window.__3D_STATE__.conservationCheck === 25"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalObjects === 25",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectStates) && window.__3D_STATE__.objectStates.length === 25",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFOV === 60 && window.__3D_STATE__.subjectFar === 20 && window.__3D_STATE__.subjectNear === 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.subjectPosition.x) && !isNaN(window.__3D_STATE__.subjectPosition.y) && !isNaN(window.__3D_STATE__.subjectPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.subjectRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectRotationY - 5) < 0.5 || Math.abs(window.__3D_STATE__.subjectRotationY + 355) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectPosition.y === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.every(o => typeof o.inside === 'boolean')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectPosition.y === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectPosition.x !== 0 || window.__3D_STATE__.subjectPosition.z !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.subjectPosition.x) && !isNaN(window.__3D_STATE__.subjectPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "q"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectFOV === 55",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-fov') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-fov').textContent.includes('55')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.filter(o => o.inside).length === window.__3D_STATE__.insideCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectFar === 22",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-far') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-far').textContent.includes('22')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.every(o => o.inside ? o.opacity === 1.0 : o.opacity === 0.25)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-aabb"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.aabbVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.every(o => o.bboxVisible === false)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFar === 22",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFOV === 55",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-aabb"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.aabbVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.every(o => o.bboxVisible === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectStates.filter(o => o.inside).length >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0; i<8; i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'q'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectFOV >= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFOV <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-fov').textContent.includes('20')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount <= window.__3D_STATE__.totalObjects",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0; i<8; i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'n'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectFar >= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFar <= 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-far').textContent.includes('6')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 25",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.subjectFOV === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectFar === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.subjectNear === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectPosition.x) < 0.01 && window.__3D_STATE__.subjectPosition.y === 2 && Math.abs(window.__3D_STATE__.subjectPosition.z) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationCheck === 25",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-fov').textContent.includes('60')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}