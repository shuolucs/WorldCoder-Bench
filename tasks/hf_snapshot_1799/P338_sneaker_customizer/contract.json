{
  "task_id": "P338_sneaker_customizer",
  "affordances": [
    {
      "id": "A1",
      "name": "SneakerGroup",
      "type": "3d_object",
      "semantic": "The complete sneaker model group containing all customizable parts",
      "locator_hints": [
        "scene.getObjectByName('sneakerGroup')",
        "the grouped sneaker mesh"
      ]
    },
    {
      "id": "A2",
      "name": "UpperMesh",
      "type": "3d_object",
      "semantic": "The main upper body of the sneaker",
      "locator_hints": [
        "upper part mesh",
        "largest colored section"
      ]
    },
    {
      "id": "A3",
      "name": "ZoneButtons",
      "type": "dom_element",
      "semantic": "Six zone selector buttons in the control panel",
      "locator_hints": [
        "#btn_upper",
        "#btn_tongue",
        "#btn_laces",
        "#btn_swoosh",
        "#btn_heelTab",
        "#btn_midsole"
      ]
    },
    {
      "id": "A4",
      "name": "ColorSwatches",
      "type": "dom_element",
      "semantic": "Eight circular color palette buttons",
      "locator_hints": [
        ".colorSwatch",
        "data-color attribute"
      ]
    },
    {
      "id": "A5",
      "name": "RotateButton",
      "type": "dom_element",
      "semantic": "Toggle button for auto-rotation",
      "locator_hints": [
        "#btnRotate"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all customizations",
      "locator_hints": [
        "#btnReset"
      ]
    },
    {
      "id": "A7",
      "name": "ScreenshotButton",
      "type": "dom_element",
      "semantic": "Button to enter screenshot mode",
      "locator_hints": [
        "#btnScreenshot"
      ]
    },
    {
      "id": "A8",
      "name": "PriceDisplay",
      "type": "dom_element",
      "semantic": "Shows current price based on customizations",
      "locator_hints": [
        "#priceDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "SpecPanel",
      "type": "dom_element",
      "semantic": "Right panel showing color configuration",
      "locator_hints": [
        "#specPanel"
      ]
    },
    {
      "id": "A10",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Bottom panel with all controls",
      "locator_hints": [
        "#controlPanel"
      ]
    },
    {
      "id": "A11",
      "name": "Platform",
      "type": "3d_object",
      "semantic": "Circular display platform under the sneaker",
      "locator_hints": [
        "cylinder platform mesh"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.selectedZone === 'upper'",
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.cameraZ === 5",
        "window.__3D_STATE__.price === 120",
        "window.__3D_STATE__.colorChanges === 0",
        "window.__3D_STATE__.screenshotMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "TongueSelected",
      "conditions": [
        "window.__3D_STATE__.selectedZone === 'tongue'"
      ]
    },
    {
      "id": "S2",
      "name": "TongueColorChanged",
      "conditions": [
        "window.__3D_STATE__.selectedZone === 'tongue'",
        "window.__3D_STATE__.colors.tongue === '#0055cc'",
        "window.__3D_STATE__.colorChanges >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "SwooshSelected",
      "conditions": [
        "window.__3D_STATE__.selectedZone === 'swoosh'"
      ]
    },
    {
      "id": "S4",
      "name": "SwooshColorChanged",
      "conditions": [
        "window.__3D_STATE__.colors.swoosh === '#ff8800'",
        "window.__3D_STATE__.colorChanges >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S6",
      "name": "RotatedAndStopped",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.sneakerRotationY > 0.1"
      ]
    },
    {
      "id": "S7",
      "name": "ZoomedIn",
      "conditions": [
        "window.__3D_STATE__.cameraZ < 5"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleZonesCustomized",
      "conditions": [
        "window.__3D_STATE__.zonesCustomized >= 3"
      ]
    },
    {
      "id": "S9",
      "name": "ScreenshotModeActive",
      "conditions": [
        "window.__3D_STATE__.screenshotMode === true"
      ]
    },
    {
      "id": "S10",
      "name": "ScreenshotModeExited",
      "conditions": [
        "window.__3D_STATE__.screenshotMode === false",
        "window.__3D_STATE__.totalInteractions >= 8"
      ]
    },
    {
      "id": "S11",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.colors.upper === '#cc0000'",
        "window.__3D_STATE__.colors.tongue === '#cc0000'",
        "window.__3D_STATE__.colors.swoosh === '#000000'",
        "window.__3D_STATE__.price === 120"
      ]
    },
    {
      "id": "S12",
      "name": "FinalCustomized",
      "conditions": [
        "window.__3D_STATE__.zonesCustomized >= 2",
        "window.__3D_STATE__.totalInteractions >= 12"
      ]
    }
  ],
