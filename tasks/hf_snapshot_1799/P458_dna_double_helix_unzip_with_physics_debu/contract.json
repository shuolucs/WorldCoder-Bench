    },
    {
      "id": "S3",
      "name": "Rezipped_One",
      "conditions": [
        "window.__3D_STATE__.unzipLevel >= 2",
        "window.__3D_STATE__.unzipLevel < 3"
      ]
    },
    {
      "id": "S4",
      "name": "Auto_Unzip_Active",
      "conditions": [
        "window.__3D_STATE__.autoUnzip === true"
      ]
    },
    {
      "id": "S5",
      "name": "Auto_Unzip_Progressed",
      "conditions": [
        "window.__3D_STATE__.autoUnzip === true",
