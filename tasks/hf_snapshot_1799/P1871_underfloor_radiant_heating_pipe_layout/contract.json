        "top-left overlay div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.mode === 'idle'",
        "window.__3D_STATE__.totalSegments === 0",
        "window.__3D_STATE__.globalAvgTemp === 15",
        "window.__3D_STATE__.simulationStep === 0"
      ]
    },
    {
      "id": "S1",
      "name": "PlacingPipeRun",
      "conditions": [
        "window.__3D_STATE__.mode === 'placing'",
        "window.__3D_STATE__.currentRunLength >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "FirstRunFinalized",
      "conditions": [
        "window.__3D_STATE__.mode === 'idle'",
        "window.__3D_STATE__.pipeRuns >= 1",
        "window.__3D_STATE__.totalSegments > 0"
      ]
    },
    {
      "id": "S3",
      "name": "MultiplePipeRuns",
      "conditions": [
        "window.__3D_STATE__.mode === 'idle'",
        "window.__3D_STATE__.pipeRuns >= 2",
        "window.__3D_STATE__.totalSegments > 0"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.mode === 'simulating'",
        "window.__3D_STATE__.simulationStep > 0"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationComplete",
      "conditions": [
        "window.__3D_STATE__.mode === 'complete'",
        "window.__3D_STATE__.simulationStep === 20"
      ]
    },
    {
      "id": "S6",
      "name": "TempsReset",
      "conditions": [
        "window.__3D_STATE__.globalAvgTemp === 15",
        "window.__3D_STATE__.simulationStep === 0",
        "window.__3D_STATE__.mode === 'idle'"
      ]
    },
    {
      "id": "S7",
      "name": "FlowRateAdjusted",
      "conditions": [
        "window.__3D_STATE__.zoneAFlowRate !== 0.5 || window.__3D_STATE__.zoneBFlowRate !== 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "ReSimulationComplete",
      "conditions": [
        "window.__3D_STATE__.mode === 'complete'",
        "window.__3D_STATE__.simulationStep === 20"
      ]
    },
    {
      "id": "S9",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.totalSegments === 0",
        "window.__3D_STATE__.pipeRuns === 0",
        "window.__3D_STATE__.globalAvgTemp === 15",
        "window.__3D_STATE__.mode === 'idle'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "FloorGrid",
        "description": "Click on a grid cell center (e.g. cell at grid position 2,2) to start a pipe run"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'placing'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentRunLength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentRunLength >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSegments === 0 || window.__3D_STATE__.currentRunLength >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Simulate clicking 4 adjacent cells in Zone A to create a pipe run, then press Enter\n// Place cells at (1,1)->(2,1)->(3,1)->(4,1) by dispatching raycasted clicks, then finalize\nconst canvas = document.querySelector('canvas');\nconst rect = canvas.getBoundingClientRect();\n// We use script injection to directly add pipe segments for testability\nif (window.__TEST_ADD_PIPE_RUN) { window.__TEST_ADD_PIPE_RUN([[1,1],[2,1],[3,1],[4,1]]); } else { const evt = new KeyboardEvent('keydown', {key: 'Enter'}); document.dispatchEvent(evt); }",
        "description": "Finalize the first pipe run with Enter key after placing segments"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeRuns >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSegments > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.remainingCapacity === 80 - window.__3D_STATE__.totalSegments",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneASegments + window.__3D_STATE__.zoneBSegments === window.__3D_STATE__.totalSegments",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRunLength === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Add a second pipe run in Zone B area\nif (window.__TEST_ADD_PIPE_RUN) { window.__TEST_ADD_PIPE_RUN([[6,3],[7,3],[8,3],[6,4],[7,4]]); }",
        "description": "Place and finalize a second pipe run in Zone B"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pipeRuns >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSegments > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneBSegments > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneASegments > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.remainingCapacity === 80 - window.__3D_STATE__.totalSegments",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.heatSourceCount === 'number' && window.__3D_STATE__.heatSourceCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "SimulateButton",
        "description": "Click the Simulate button to start thermal diffusion"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'simulating'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.globalAvgTemp >= 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp >= 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000,
        "description": "Wait for all 20 simulation steps to complete (20 * 100ms = 2s + buffer)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.globalAvgTemp > 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 40 && window.__3D_STATE__.maxTemp >= 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp >= 15 && window.__3D_STATE__.minTemp <= 40",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.gridTemps) && window.__3D_STATE__.gridTemps.length === 10",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "ResetTempsButton",
        "description": "Click Reset Temps to restore all cells to 15°C"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.globalAvgTemp === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneAAvgTemp === 15 && window.__3D_STATE__.zoneBAvgTemp === 15",
            "tier": "L2"
          }
