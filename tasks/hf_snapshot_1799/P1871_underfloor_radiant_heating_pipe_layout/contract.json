      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sliderA = document.querySelector('input[type=range]'); if(sliderA) { sliderA.value = 0.8; sliderA.dispatchEvent(new Event('input', {bubbles:true})); }",
        "description": "Adjust Zone A flow rate slider to 0.8"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.zoneAFlowRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.zoneAFlowRate - 0.8) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSegments > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeRuns >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Simulate')); if(btn) btn.click(); await new Promise(r => setTimeout(r, 3000));",
        "description": "Click Simulate again with adjusted flow rate and wait for completion"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.globalAvgTemp > 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneAAvgTemp !== window.__3D_STATE__.zoneBAvgTemp",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 40 && window.__3D_STATE__.minTemp >= 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "ClearAllPipesButton",
        "description": "Click Clear All Pipes to remove everything and fully reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalSegments === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pipeRuns === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneASegments === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneBSegments === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.remainingCapacity === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.globalAvgTemp === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatSourceCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Verify full reset matches initial state\ntrue;",
        "description": "Verify the scene has returned to its exact initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSegments === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentRunLength === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.zoneAFlowRate - 0.5) < 0.05 || window.__3D_STATE__.zoneAFlowRate >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridTemps[0][0] === 15 && window.__3D_STATE__.gridTemps[9][9] === 15",
