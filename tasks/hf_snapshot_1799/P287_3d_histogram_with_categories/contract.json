{
  "task_id": "P287_3d_histogram_with_categories",
  "affordances": [
    {
      "id": "A1",
      "name": "FoodBar",
      "type": "3d_object",
      "semantic": "Red histogram bar for Food category (value 75)",
      "locator_hints": [
        "barValues[0] === 75",
        "first bar at x=-4"
      ]
    },
    {
      "id": "A2",
      "name": "TransportBar",
      "type": "3d_object",
      "semantic": "Teal histogram bar for Transport category (value 45)",
      "locator_hints": [
        "barValues[1] === 45",
        "second bar at x=-2"
      ]
    },
    {
      "id": "A3",
      "name": "HousingBar",
      "type": "3d_object",
      "semantic": "Blue histogram bar for Housing category (value 90)",
      "locator_hints": [
        "barValues[2] === 90",
        "third bar at x=0"
      ]
    },
    {
      "id": "A4",
      "name": "EntertainmentBar",
      "type": "3d_object",
      "semantic": "Yellow histogram bar for Entertainment category (value 30)",
      "locator_hints": [
        "barValues[3] === 30",
        "fourth bar at x=2"
      ]
    },
    {
      "id": "A5",
      "name": "SavingsBar",
      "type": "3d_object",
      "semantic": "Purple histogram bar for Savings category (value 60)",
      "locator_hints": [
        "barValues[4] === 60",
        "fifth bar at x=4"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleViewButton",
      "type": "dom_element",
      "semantic": "Button to toggle between normal and top-down camera views",
      "locator_hints": [
        "#btn-toggle-view"
      ]
    },
    {
      "id": "A7",
      "name": "FoodButton",
      "type": "dom_element",
      "semantic": "Button for Food category selection",
      "locator_hints": [
        "#btn-food"
      ]
    },
    {
      "id": "A8",
      "name": "HUDSelected",
      "type": "dom_element",
      "semantic": "HUD text showing selected category",
      "locator_hints": [
        "#hud-selected"
      ]
    },
    {
      "id": "A9",
      "name": "LittlestTokyoModel",
      "type": "3d_object",
      "semantic": "Decorative 3D city model loaded from GLB",
      "locator_hints": [
        "modelLoaded === true"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.barCount === 5",
        "window.__3D_STATE__.selectedBar === null",
        "window.__3D_STATE__.viewMode === 'normal'",
        "window.__3D_STATE__.totalValue === 300"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "BarSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBar !== null",
        "window.__3D_STATE__.selectedBar >= 0 && window.__3D_STATE__.selectedBar <= 4"
      ]
    },
    {
      "id": "S3",
      "name": "TopDownView",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'topdown'"
      ]
    },
    {
      "id": "S4",
      "name": "BarDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedBar === null",
        "window.__3D_STATE__.viewMode === 'normal'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__.barValues) === JSON.stringify([75, 45, 90, 30, 60])",
            "tier": "L2"
          },
          {
            "expr": "JSON.stringify(window.__3D_STATE__.barHeights) === JSON.stringify([7.5, 4.5, 9.0, 3.0, 6.0])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-food"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-selected').textContent.toLowerCase().includes('food')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-toggle-view"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-toggle-view"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}