  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'build'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.componentsPlaced === 0",
        "window.__3D_STATE__.circuitStatus === 'open'",
        "window.__3D_STATE__.currentAmps === 0"
      ]
    },
    {
      "id": "S1",
      "name": "LampLoaded",
      "conditions": [
        "window.__3D_STATE__.lampLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "ComponentSelected",
      "conditions": [
        "window.__3D_STATE__.selectedComponent !== null",
        "window.__3D_STATE__.mode === 'build'"
      ]
    },
    {
      "id": "S3",
      "name": "ComponentsPlaced",
      "conditions": [
        "window.__3D_STATE__.componentsPlaced > 0",
        "window.__3D_STATE__.mode === 'build'"
      ]
    },
    {
      "id": "S4",
      "name": "ConnectMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'connect'"
      ]
    },
    {
      "id": "S5",
      "name": "ConnectionsMade",
      "conditions": [
        "window.__3D_STATE__.connectionsCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SwitchToggled",
      "conditions": [
        "window.__3D_STATE__.switchClosed === true"
      ]
    },
    {
      "id": "S7",
      "name": "CircuitEvaluated",
      "conditions": [
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.circuitStatus !== 'open'"
      ]
    },
    {
      "id": "S8",
      "name": "CircuitComplete",
      "conditions": [
        "window.__3D_STATE__.circuitComplete === true",
        "window.__3D_STATE__.ledGlowing === true",
        "window.__3D_STATE__.currentAmps === 0.09",
        "window.__3D_STATE__.score === 100"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.componentsPlaced === 0",
        "window.__3D_STATE__.connectionsCount === 0",
        "window.__3D_STATE__.circuitStatus === 'open'"
      ]
    }
  ],
