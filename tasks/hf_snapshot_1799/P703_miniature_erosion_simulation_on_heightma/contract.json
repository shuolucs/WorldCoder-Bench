          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['slope', 'erosion_delta'].includes(window.__3D_STATE__.colorMode)",
            "tier": "L2"
          },
          {
