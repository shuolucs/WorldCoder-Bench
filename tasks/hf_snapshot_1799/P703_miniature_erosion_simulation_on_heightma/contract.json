    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width / 2; const cy = rect.top + rect.height / 2; canvas.dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.focusPoint !== null && window.__3D_STATE__.focusPoint !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.focusPoint === 'object'",
            "tier": "L0"
          },
          {
