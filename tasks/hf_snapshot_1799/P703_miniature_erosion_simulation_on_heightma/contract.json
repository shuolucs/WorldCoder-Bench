  "states": [
    {
      "id": "S0",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.simulationStep === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.colorMode === 'elevation'",
        "window.__3D_STATE__.waterVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.simulationStep > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.simulationStep > 0"
      ]
    },
    {
      "id": "S3",
      "name": "AfterManualRainBurst",
      "conditions": [
        "window.__3D_STATE__.simulationStep > 0",
        "window.__3D_STATE__.totalErosionVolume > 0"
      ]
    },
    {
      "id": "S4",
      "name": "ErosionRateChanged",
      "conditions": [
        "window.__3D_STATE__.erosionRate !== 0.03"
      ]
    },
    {
      "id": "S5",
      "name": "ColorModeCycled",
      "conditions": [
        "window.__3D_STATE__.colorMode !== 'elevation'"
      ]
    },
    {
      "id": "S6",
      "name": "WaterHidden",
      "conditions": [
        "window.__3D_STATE__.waterVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterSignificantErosion",
      "conditions": [
        "window.__3D_STATE__.simulationStep >= 30",
        "window.__3D_STATE__.totalErosionVolume > 0"
      ]
    },
    {
      "id": "S8",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.simulationStep === 0",
        "window.__3D_STATE__.totalErosionVolume === 0",
        "window.__3D_STATE__.totalDepositionVolume === 0"
      ]
    },
    {
      "id": "S9",
      "name": "FocusPointActive",
      "conditions": [
        "window.__3D_STATE__.focusPoint !== null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.terrainVertexCount === 16384",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep === 0 && window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.originalMeanHeight === 'number' && window.__3D_STATE__.originalMeanHeight > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMin >= 0 && window.__3D_STATE__.heightmapMax <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalErosionVolume === 0 && window.__3D_STATE__.totalDepositionVolume === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start-stop"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#btn-start-stop').textContent.trim().toLowerCase().includes('pause')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationStep === 'number' && !isNaN(window.__3D_STATE__.simulationStep)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalErosionVolume === 'number' && !isNaN(window.__3D_STATE__.totalErosionVolume)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 2000)); document.querySelector('#btn-start-stop').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalErosionVolume > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDepositionVolume >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDepositionVolume <= window.__3D_STATE__.totalErosionVolume",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMean <= window.__3D_STATE__.originalMeanHeight",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalErosionVolume > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMin >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.heightmapMean) && window.__3D_STATE__.heightmapMean > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('#slider-erosion-rate'); const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '0.08'); slider.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.erosionRate - 0.08) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.erosionRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.depositionRate === 0.02",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#slider-erosion-rate') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'slope'",
