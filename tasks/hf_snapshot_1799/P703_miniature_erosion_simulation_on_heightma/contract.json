            "expr": "window.__3D_STATE__.heightmapMin >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMax > window.__3D_STATE__.heightmapMin",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
