      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#btn-start-stop').click(); await new Promise(r => setTimeout(r, 3000)); document.querySelector('#btn-start-stop').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalErosionVolume > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDepositionVolume <= window.__3D_STATE__.totalErosionVolume",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMean < window.__3D_STATE__.originalMeanHeight",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heightmapMin >= 0 && !isNaN(window.__3D_STATE__.heightmapMax)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationStep === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalErosionVolume === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDepositionVolume === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.heightmapMean - window.__3D_STATE__.originalMeanHeight) < 0.001",
