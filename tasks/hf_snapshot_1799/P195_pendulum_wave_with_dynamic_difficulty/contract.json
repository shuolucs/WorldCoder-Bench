{
  "task_id": "P195_pendulum_wave_with_dynamic_difficulty",
  "affordances": [
    {
      "id": "A1",
      "name": "EasyButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Easy (Level 1)",
      "locator_hints": [
        "button:contains('Easy')",
        "#easy-btn"
      ]
    },
    {
      "id": "A2",
      "name": "MediumButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Medium (Level 2)",
      "locator_hints": [
        "button:contains('Medium')",
        "#medium-btn"
      ]
    },
    {
      "id": "A3",
      "name": "HardButton",
      "type": "dom_element",
      "semantic": "Button to set difficulty to Hard (Level 3)",
      "locator_hints": [
        "button:contains('Hard')",
        "#hard-btn"
      ]
    },
    {
      "id": "A4",
      "name": "PendulumBobs",
      "type": "3d_object",
      "semantic": "Array of pendulum bob spheres that can be clicked",
      "locator_hints": [
        "mesh with sphere geometry",
        "bob"
      ]
    },
    {
      "id": "A5",
      "name": "ParrotModel",
      "type": "3d_object",
      "semantic": "Loaded Parrot.glb model on top of the frame",
      "locator_hints": [
        "GLTF model",
        "parrot"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-right HUD showing simulation info",
      "locator_hints": [
        "div with monospace font",
        "#hud"
      ]
    },
    {
      "id": "A7",
      "name": "SpaceKey",
      "type": "dom_element",
      "semantic": "Space bar to toggle pause",
      "locator_hints": [
        "keyboard:Space"
      ]
    },
    {
      "id": "A8",
      "name": "RKey",
      "type": "dom_element",
      "semantic": "R key to reset simulation",
      "locator_hints": [
        "keyboard:KeyR"
      ]
    },
    {
      "id": "A9",
      "name": "GKey",
      "type": "dom_element",
      "semantic": "G key to cycle gravity in Hard mode",
      "locator_hints": [
        "keyboard:KeyG"
      ]
    },
    {
      "id": "A10",
      "name": "ArrowKeys",
      "type": "dom_element",
      "semantic": "Up/Down arrows to adjust theta_max",
      "locator_hints": [
        "keyboard:ArrowUp",
        "keyboard:ArrowDown"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialEasyState",
      "conditions": [
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.numPendulums === 5",
        "window.__3D_STATE__.gravity === 9.81",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.thetaMax === 0.5"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.frameCount > 10"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "MediumDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 2",
        "window.__3D_STATE__.numPendulums === 10",
        "window.__3D_STATE__.dampingCoeff === 0.001"
      ]
    },
    {
      "id": "S4",
      "name": "HardDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 3",
        "window.__3D_STATE__.numPendulums === 15",
        "window.__3D_STATE__.dampingCoeff === 0.005"
      ]
    },
    {
      "id": "S5",
      "name": "GravityChanged",
      "conditions": [
        "window.__3D_STATE__.difficulty === 3",
        "window.__3D_STATE__.gravityCycleIndex > 0"
      ]
    },
    {
      "id": "S6",
      "name": "ThetaMaxAdjusted",
      "conditions": [
        "Math.abs(window.__3D_STATE__.thetaMax - 0.5) > 0.05"
      ]
    },
    {
      "id": "S7",
      "name": "BobSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBobIndex >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    },
    {
      "id": "S9",
      "name": "ParrotLoadedAndAnimating",
      "conditions": [
        "window.__3D_STATE__.parrotLoaded === true",
        "window.__3D_STATE__.parrotY >= 12.7 && window.__3D_STATE__.parrotY <= 13.3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.length === window.__3D_STATE__.numPendulums",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a) && isFinite(a))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths.every(l => l >= 4.0 && l <= 6.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(2)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPendulums === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dampingCoeff === 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.length === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths[0] >= 2.9 && window.__3D_STATE__.pendulumLengths[0] <= 3.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button:nth-of-type(3)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.difficulty === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPendulums === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dampingCoeff === 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.length === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths[0] >= 2.4 && window.__3D_STATE__.pendulumLengths[0] <= 2.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumLengths[14] >= 7.9 && window.__3D_STATE__.pendulumLengths[14] <= 8.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityCycleIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gravity - 4.9) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a) && isFinite(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaMax - 0.6) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thetaMax >= 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thetaMax <= 1.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => Math.abs(a) <= window.__3D_STATE__.thetaMax + 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0 || window.__3D_STATE__.elapsedTime < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => Math.abs(a - window.__3D_STATE__.thetaMax) < 0.05 || Math.abs(a) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numPendulums === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAngles.every(a => !isNaN(a))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S0",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.parrotLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.parrotY >= 12.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.parrotY <= 13.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.parrotY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.parrotY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S1",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedBobIndex = 0;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBobIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBobIndex < window.__3D_STATE__.numPendulums",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngles[window.__3D_STATE__.selectedBobIndex] === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.energySum)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energySum >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}