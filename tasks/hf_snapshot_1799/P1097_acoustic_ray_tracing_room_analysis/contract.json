          {
            "expr": "window.__3D_STATE__.raysVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.receiverHits === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hitRatio === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgHitPathLength === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.estimatedRT60 === 0",
