        "type": "script",
        "code": "var ws = document.querySelectorAll('select'); var wallSel = ws[ws.length-1]; wallSel.value = 'floor'; wallSel.dispatchEvent(new Event('change')); setTimeout(function(){ var sliders = document.querySelectorAll('input[type=range]'); var absSlider = sliders[sliders.length-1]; absSlider.value = 0.9; absSlider.dispatchEvent(new Event('input')); }, 200);"
      },
