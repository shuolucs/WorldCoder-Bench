  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.roomWidth === 10",
        "window.__3D_STATE__.roomDepth === 8",
        "window.__3D_STATE__.raysTraced === 0",
        "window.__3D_STATE__.raysVisible === false",
        "window.__3D_STATE__.rayCount === 24"
      ]
    },
    {
      "id": "S1",
      "name": "RaysTraced",
      "conditions": [
        "window.__3D_STATE__.raysTraced > 0",
        "window.__3D_STATE__.raysVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "RaysCleared",
      "conditions": [
        "window.__3D_STATE__.raysTraced === 0",
        "window.__3D_STATE__.raysVisible === false",
        "window.__3D_STATE__.receiverHits === 0"
      ]
    },
    {
      "id": "S3",
      "name": "PresetConcertHall",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Concert Hall'",
        "window.__3D_STATE__.roomWidth === 16",
        "window.__3D_STATE__.roomDepth === 12"
      ]
    },
    {
      "id": "S4",
      "name": "PresetRecordingStudio",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Recording Studio'",
        "window.__3D_STATE__.roomWidth === 6"
      ]
    },
    {
      "id": "S5",
      "name": "HighAbsorptionApplied",
      "conditions": [
        "window.__3D_STATE__.wallAbsorption.floor >= 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "RaysTracedAfterAbsorption",
      "conditions": [
        "window.__3D_STATE__.raysTraced > 0",
        "window.__3D_STATE__.raysVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "RayCountChanged",
      "conditions": [
        "window.__3D_STATE__.rayCount !== 24"
      ]
    },
    {
      "id": "S8",
      "name": "RaysTracedWithNewCount",
      "conditions": [
        "window.__3D_STATE__.raysTraced > 0",
        "window.__3D_STATE__.raysVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "PresetBathroom",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Bathroom'",
        "window.__3D_STATE__.roomWidth === 3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Trace Rays"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.raysTraced === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.raysTraced === window.__3D_STATE__.rayCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.raysVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.receiverHits === 'number' && window.__3D_STATE__.receiverHits >= 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.avgHitPathLength === 'number' && !isNaN(window.__3D_STATE__.avgHitPathLength)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.estimatedRT60 === 'number' && !isNaN(window.__3D_STATE__.estimatedRT60) && window.__3D_STATE__.estimatedRT60 >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
