            "expr": "window.__3D_STATE__.roomWidth === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomHeight === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomDepth === 12",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.wallAbsorption.floor - 0.15) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sourceInsideRoom === true && window.__3D_STATE__.receiverInsideRoom === true",
            "tier": "L2"
          }
        ]
