        "window.__3D_STATE__.duckLoaded === true",
        "window.__3D_STATE__.players[0].active === true",
        "window.__3D_STATE__.players[1].active === false",
        "window.__3D_STATE__.selectedPlayer === 1",
        "window.__3D_STATE__.distortionEnabled === true",
        "window.__3D_STATE__.turbulenceSpeed === 'normal'"
      ]
    },
    {
      "id": "S1",
      "name": "Player2_Activated",
      "conditions": [
        "window.__3D_STATE__.players[1].active === true",
        "window.__3D_STATE__.selectedPlayer === 2",
        "window.__3D_STATE__.activePlayerCount === 2"
      ]
    },
    {
      "id": "S2",
      "name": "Player2_IntensityIncreased",
      "conditions": [
        "window.__3D_STATE__.players[1].intensity >= 1.1",
        "window.__3D_STATE__.totalIntensity > 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "AllPlayersActive",
      "conditions": [
        "window.__3D_STATE__.activePlayerCount === 4",
        "window.__3D_STATE__.fireShaderActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "DistortionDisabled",
      "conditions": [
        "window.__3D_STATE__.distortionEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "TurbulenceFast",
      "conditions": [
