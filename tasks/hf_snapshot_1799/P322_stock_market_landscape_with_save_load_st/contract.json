{
  "task_id": "P322_stock_market_landscape_with_save_load_st",
  "affordances": [
    {
      "id": "A1",
      "name": "SimulateButton",
      "type": "dom_element",
      "semantic": "Button that advances market simulation by one day",
      "locator_hints": [
        "#simulateBtn"
      ]
    },
    {
      "id": "A2",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button that saves current state to localStorage",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A3",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button that loads saved state from localStorage",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleDragonButton",
      "type": "dom_element",
      "semantic": "Button that toggles dragon model visibility",
      "locator_hints": [
        "#toggleDragonBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button that resets to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "StockTowers",
      "type": "3d_object",
      "semantic": "Five vertical bars representing stock prices",
      "locator_hints": [
        "BoxGeometry towers at x=-12,-6,0,6,12"
      ]
    },
    {
      "id": "A7",
      "name": "DragonModel",
      "type": "3d_object",
      "semantic": "Dragon GLB model as market mascot",
      "locator_hints": [
        "DragonAttenuation.glb at (0,0,-10)"
      ]
    },
    {
      "id": "A8",
      "name": "DayDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current day number",
      "locator_hints": [
        "#dayDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "MarketCapDisplay",
      "type": "dom_element",
      "semantic": "HUD showing total market capitalization",
      "locator_hints": [
        "#marketCapDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.day === 0",
        "window.__3D_STATE__.dragonLoaded === true",
        "window.__3D_STATE__.dragonVisible === true",
        "JSON.stringify(window.__3D_STATE__.prices) === JSON.stringify([150, 280, 95, 420, 210])"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstSimulation",
      "conditions": [
        "window.__3D_STATE__.day === 1",
        "window.__3D_STATE__.simulationCount === 1"
      ]
    },
    {
      "id": "S2",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S3",
      "name": "DragonHidden",
      "conditions": [
        "window.__3D_STATE__.dragonVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "AfterMoreSimulations",
      "conditions": [
        "window.__3D_STATE__.day >= 3",
        "window.__3D_STATE__.simulationCount >= 3"
      ]
    },
    {
      "id": "S5",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true",
        "window.__3D_STATE__.day >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.day === 0",
        "JSON.stringify(window.__3D_STATE__.prices) === JSON.stringify([150, 280, 95, 420, 210])",
        "window.__3D_STATE__.dragonVisible === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#simulateBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#saveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "localStorage.getItem('stockMarketState') !== null",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('stockMarketState')).prices.length === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleDragonBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#simulateBtn').click(); setTimeout(() => document.querySelector('#simulateBtn').click(), 200);",
        "delay_after_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#loadBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__.prices) === JSON.stringify([150, 280, 95, 420, 210])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "localStorage.getItem('stockMarketState') !== null",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('stockMarketState')).day === 0",
            "tier": "L2"
          },
          {
            "expr": "JSON.parse(localStorage.getItem('stockMarketState')).prices.length === 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}