      ]
    },
    {
      "id": "S3",
      "name": "HourIncremented",
      "conditions": [
        "window.__3D_STATE__.hours === 11",
        "window.__3D_STATE__.minutes === 10",
        "window.__3D_STATE__.timeDisplay === '11:10'"
      ]
    },
    {
      "id": "S4",
      "name": "MinuteIncremented",
