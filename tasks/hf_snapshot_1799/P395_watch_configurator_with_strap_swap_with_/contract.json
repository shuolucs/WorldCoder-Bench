      "conditions": [
        "window.__3D_STATE__.spinEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpinDisabled_RotationAdvanced",
      "conditions": [
        "window.__3D_STATE__.spinEnabled === false",
        "window.__3D_STATE__.watchRotationY !== 0"
      ]
    },
    {
      "id": "S7",
      "name": "TimeWrappedToMidnight",
      "conditions": [
        "window.__3D_STATE__.hours === 0",
        "window.__3D_STATE__.timeDisplay.startsWith('00:')"
      ]
    }
  ],
