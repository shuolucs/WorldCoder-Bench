{
  "task_id": "P1581_blend_tree_animation_state_machine",
  "affordances": [
    {
      "id": "A1",
      "name": "Character",
      "type": "3d_object",
      "semantic": "Capsule-based humanoid proxy that animates according to state machine",
      "locator_hints": [
        "scene.getObjectByName('character')",
        "CylinderGeometry body with sphere head"
      ]
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground reference plane at y=0",
      "locator_hints": [
        "PlaneGeometry 20x20"
      ]
    },
    {
      "id": "A3",
      "name": "StateDisplay",
      "type": "dom_element",
      "semantic": "Label showing current animation state and blend progress",
      "locator_hints": [
        "#state-display"
      ]
    },
    {
      "id": "A4",
      "name": "BlendBar",
      "type": "dom_element",
      "semantic": "Progress bar showing blend weight visually",
      "locator_hints": [
        "#blend-bar"
      ]
    },
    {
      "id": "A5",
      "name": "BlendDurationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling blend transition duration",
      "locator_hints": [
        "#blend-duration"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset character to origin and idle",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "HistoryList",
      "type": "dom_element",
      "semantic": "List of last 5 state transitions",
      "locator_hints": [
        "#history-list"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.currentState === 'idle'",
        "window.__3D_STATE__.blendWeight === 1.0",
        "window.__3D_STATE__.isBlending === false",
        "window.__3D_STATE__.characterPosition.y >= 0"
      ]
    },
    {
      "id": "S1",
      "name": "Blending_To_Walk",
      "conditions": [
        "window.__3D_STATE__.isBlending === true",
        "window.__3D_STATE__.currentState === 'walk'"
      ]
    },
    {
      "id": "S2",
      "name": "Walking",
      "conditions": [
        "window.__3D_STATE__.currentState === 'walk'",
        "window.__3D_STATE__.isBlending === false",
        "window.__3D_STATE__.blendWeight === 1.0"
      ]
    },
    {
      "id": "S3",
      "name": "Blending_To_Run",
      "conditions": [
        "window.__3D_STATE__.isBlending === true",
        "window.__3D_STATE__.currentState === 'run'"
      ]
    },
    {
      "id": "S4",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.currentState === 'run'",
        "window.__3D_STATE__.isBlending === false"
      ]
    },
    {
      "id": "S5",
      "name": "Jumping",
      "conditions": [
        "window.__3D_STATE__.currentState === 'jump'",
        "window.__3D_STATE__.jumpPhase > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Crouching",
      "conditions": [
        "window.__3D_STATE__.currentState === 'crouch'",
        "window.__3D_STATE__.isBlending === false"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_Idle",
      "conditions": [
        "window.__3D_STATE__.currentState === 'idle'",
        "Math.abs(window.__3D_STATE__.characterPosition.x) < 0.01",
        "Math.abs(window.__3D_STATE__.characterPosition.z) < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "Custom_Blend_Duration",
      "conditions": [
        "window.__3D_STATE__.blendDuration !== 0.4"
      ]
    },
    {
      "id": "S9",
      "name": "Post_Jump_Return",
      "conditions": [
        "window.__3D_STATE__.currentState !== 'jump'",
        "window.__3D_STATE__.jumpPhase === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentState === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlending === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight >= 0.0 && window.__3D_STATE__.blendWeight <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transitionHistory.length >= 1 && window.__3D_STATE__.transitionHistory[window.__3D_STATE__.transitionHistory.length - 1].from === 'idle' && window.__3D_STATE__.transitionHistory[window.__3D_STATE__.transitionHistory.length - 1].to === 'walk'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isBlending === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityX - 1.0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterPosition.y >= 0 && window.__3D_STATE__.characterPosition.y < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.limbRotations.leftLeg) <= 0.35",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'run'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlending === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight >= 0.0 && window.__3D_STATE__.blendWeight < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.blendSourceValues === 'object' && window.__3D_STATE__.blendSourceValues !== null",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blendSourceValues.velocity - 1.0) < 0.2 && Math.abs(window.__3D_STATE__.blendTargetValues.velocity - 3.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'run'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlending === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.velocityX - 3.0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDistance > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.limbRotations.leftLeg) <= 0.55",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'run'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transitionHistory.length >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isTransitionAllowed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalDistance > 0 && !isNaN(window.__3D_STATE__.totalDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S2",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isTransitionAllowed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterPosition.y >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterPosition.x) && !isNaN(window.__3D_STATE__.characterPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'jump'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jumpPhase > 0.0 && window.__3D_STATE__.jumpPhase <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterPosition.y > 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.jumpPhase === 'number' && !isNaN(window.__3D_STATE__.jumpPhase)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState !== 'jump'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.jumpPhase === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterPosition.y >= 0 && window.__3D_STATE__.characterPosition.y < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentState === 'idle' || window.__3D_STATE__.currentState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterPosition.y)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'crouch'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterScaleY < 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterScaleY >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previousState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isTransitionAllowed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityX === 0 || Math.abs(window.__3D_STATE__.velocityX) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.characterPosition.x) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.characterPosition.z) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.characterScaleY >= 0.95 && window.__3D_STATE__.characterScaleY <= 1.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlending === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityX === 0 || Math.abs(window.__3D_STATE__.velocityX) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#blend-duration').value = '1.2'; document.querySelector('#blend-duration').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.blendDuration - 1.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.blendDuration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blendDuration >= 0.1 && window.__3D_STATE__.blendDuration <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#blend-duration') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S8",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentState === 'walk'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isBlending === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.blendDuration - 1.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendWeight < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && typeof window.__3D_STATE__.frameCount === 'number'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}