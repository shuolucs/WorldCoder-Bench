            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.coriolisEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.trajectoryCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__ != null && typeof window.__3D_STATE__ === 'object'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trajectoryCount === 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.angle) && !Number.isNaN(window.__3D_STATE__.angle) && window.__3D_STATE__.angle >= 0 && window.__3D_STATE__.angle <= 90",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.speed) && !Number.isNaN(window.__3D_STATE__.speed) && window.__3D_STATE__.speed >= 10 && window.__3D_STATE__.speed <= 100",
            "tier": "L2"
          },
          {
