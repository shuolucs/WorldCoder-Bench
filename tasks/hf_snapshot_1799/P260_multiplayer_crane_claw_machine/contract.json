      ]
    },
    {
      "id": "S6",
      "name": "Player2Moved",
      "conditions": [
        "window.__3D_STATE__.currentPlayer === 2",
        "window.__3D_STATE__.clawZ !== 0 || window.__3D_STATE__.clawX !== 0"
      ]
    },
    {
      "id": "S7",
      "name": "FoxGrabbed",
      "conditions": [
        "window.__3D_STATE__.foxGrabbed === true",
        "window.__3D_STATE__.lastGrabbedPrize === 'fox'"
