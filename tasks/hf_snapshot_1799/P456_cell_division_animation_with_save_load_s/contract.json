      ]
    },
    {
      "id": "A10",
      "name": "PhaseLabel",
      "type": "dom_element",
      "semantic": "Text display showing current phase name",
      "locator_hints": [
        "#phase-label"
      ]
    },
    {
      "id": "A11",
      "name": "PhaseCounter",
      "type": "dom_element",
      "semantic": "Text display showing phase number",
      "locator_hints": [
        "#phase-counter"
      ]
    },
    {
      "id": "A12",
      "name": "DaughterCells",
      "type": "3d_object",
      "semantic": "Two smaller cells that appear after cytokinesis",
      "locator_hints": [
        "two smaller spheres at y ±2.5"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Interphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.phaseName === 'Interphase'"
      ]
    },
    {
      "id": "S1",
      "name": "Prophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 1",
        "window.__3D_STATE__.phaseName === 'Prophase'"
      ]
    },
    {
      "id": "S2",
      "name": "Metaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 2",
        "window.__3D_STATE__.phaseName === 'Metaphase'"
      ]
    },
    {
      "id": "S3",
      "name": "Anaphase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 3",
        "window.__3D_STATE__.phaseName === 'Anaphase'"
      ]
    },
    {
      "id": "S4",
      "name": "Telophase",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 4",
        "window.__3D_STATE__.phaseName === 'Telophase'"
      ]
    },
    {
      "id": "S5",
      "name": "Cytokinesis",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 5",
        "window.__3D_STATE__.phaseName === 'Cytokinesis'"
      ]
    },
    {
      "id": "S6",
      "name": "Complete",
      "conditions": [
        "window.__3D_STATE__.currentPhase === 6",
        "window.__3D_STATE__.phaseName === 'Complete'"
      ]
    },
    {
      "id": "S7",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true"
      ]
    },
    {
      "id": "S8",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.isAnimating === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Lighting !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Keyboard !== undefined",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('phase-label').textContent.includes('Prophase')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('phase-counter').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-next"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-save"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 500,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "localStorage.getItem('cellDivisionState') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S7",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-load"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('phase-label').textContent.includes('Anaphase')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-prev"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2000,
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          },
          {
