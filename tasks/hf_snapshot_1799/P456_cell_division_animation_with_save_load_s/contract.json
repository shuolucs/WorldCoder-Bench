{
  "task_id": "P456_cell_division_animation_with_save_load_s",
  "affordances": [
    {
      "id": "A1",
      "name": "ParentCell",
      "type": "3d_object",
      "semantic": "The main cell membrane sphere that undergoes division",
      "locator_hints": [
        "semi-transparent green sphere",
        "radius ~2"
      ]
    },
    {
      "id": "A2",
      "name": "Nucleus",
      "type": "3d_object",
      "semantic": "The purple nucleus inside the cell",
      "locator_hints": [
