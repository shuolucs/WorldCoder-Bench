      ]
    },
    {
      "id": "A7",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state",
      "locator_hints": [
        "#btn-save"
      ]
    },
    {
      "id": "A8",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load saved state",
