{
  "task_id": "P2216_vignette_parametric_shape_falloff_curves",
  "affordances": [
    {
      "id": "A1",
      "name": "RobotModel",
      "type": "3d_object",
      "semantic": "Loaded robot.glb model centered at origin",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "VignetteShaderPass",
      "type": "3d_object",
      "semantic": "Custom ShaderPass implementing parametric vignette",
      "locator_hints": [
        "EffectComposer pass with vignette uniforms"
      ]
    },
    {
      "id": "A3",
      "name": "ShapeButtons",
      "type": "dom_element",
      "semantic": "Four buttons to select vignette shape",
      "locator_hints": [
