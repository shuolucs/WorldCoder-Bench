      ]
    },
    {
      "id": "A8",
      "name": "ColorPicker",
      "type": "dom_element",
      "semantic": "Color input for vignette overlay color",
      "locator_hints": [
        "#colorPicker"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all vignette parameters to defaults",
      "locator_hints": [
        "#btnReset"
      ]
    },
    {
      "id": "A10",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay panel containing all controls",
      "locator_hints": [
        "#controlPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.composerEnabled === true",
        "window.__3D_STATE__.shape === 0",
        "window.__3D_STATE__.curve === 0",
        "window.__3D_STATE__.intensity === 0.7"
      ]
    },
    {
      "id": "S1",
      "name": "ShapeChangedToEllipse",
      "conditions": [
        "window.__3D_STATE__.shape === 1",
        "window.__3D_STATE__.shapeName === 'ellipse'"
      ]
    },
    {
      "id": "S2",
      "name": "CurveChangedToQuadratic",
      "conditions": [
        "window.__3D_STATE__.curve === 2",
        "window.__3D_STATE__.curveName === 'quadratic'"
      ]
    },
    {
      "id": "S3",
      "name": "IntensityAdjusted",
      "conditions": [
        "window.__3D_STATE__.intensity === 1.2"
      ]
    },
    {
      "id": "S4",
      "name": "RadiusAndSoftnessAdjusted",
      "conditions": [
        "window.__3D_STATE__.radius === 0.3",
        "window.__3D_STATE__.softness === 0.8"
      ]
    },
    {
      "id": "S5",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.vignetteColor !== '#000000'"
      ]
    },
    {
      "id": "S6",
      "name": "KeyboardShapeSwitch",
      "conditions": [
        "window.__3D_STATE__.shape === 2",
        "window.__3D_STATE__.shapeName === 'diamond'"
      ]
    },
    {
      "id": "S7",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.shape === 0",
        "window.__3D_STATE__.curve === 0",
        "window.__3D_STATE__.intensity === 0.7",
        "window.__3D_STATE__.radius === 0.5",
        "window.__3D_STATE__.softness === 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.passCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shape === 0 && window.__3D_STATE__.shapeName === 'circle' && window.__3D_STATE__.curve === 0 && window.__3D_STATE__.curveName === 'smooth'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnEllipse"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shape === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shapeName === 'ellipse'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shape === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.intensity === 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.curve === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnQuadratic"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.curve === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.curveName === 'quadratic'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.curve === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shape === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sliderIntensity').value = 1.2; document.getElementById('sliderIntensity').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intensity === 1.2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.intensity >= 0 && window.__3D_STATE__.intensity <= 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shape === 1 && window.__3D_STATE__.curve === 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('sliderIntensity').value === '1.2'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sliderRadius').value = 0.3; document.getElementById('sliderRadius').dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('sliderSoftness').value = 0.8; document.getElementById('sliderSoftness').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.radius === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.softness === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius >= 0.1 && window.__3D_STATE__.radius <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.softness >= 0.1 && window.__3D_STATE__.softness <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity === 1.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shape === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shapeName === 'diamond'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.softness === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnReset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shape === 0 && window.__3D_STATE__.shapeName === 'circle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.curve === 0 && window.__3D_STATE__.curveName === 'smooth'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.intensity === 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.radius === 0.5 && window.__3D_STATE__.softness === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vignetteColor === '#000000'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('sliderIntensity').value === '0.7' && document.getElementById('sliderRadius').value === '0.5'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}