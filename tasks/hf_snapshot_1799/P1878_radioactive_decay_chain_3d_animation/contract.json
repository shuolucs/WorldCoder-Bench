        "button with text 'Decay'",
        "centered bottom of screen",
        "glowing green border"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button that resets the chain back to U-238 step 0",
      "locator_hints": [
        "button with text 'Reset'",
        "next to Decay button"
      ]
    },
    {
      "id": "A4",
      "name": "HUDPanel",
