{
  "task_id": "P490_volumetric_cloud_sculptor_with_physics_d",
  "affordances": [
    {
      "id": "A1",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "Semi-transparent horse GLB model used as sculpting guide",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "CloudParticles",
      "type": "3d_object",
      "semantic": "500 sprite-based cloud particles with physics",
      "locator_hints": [
        "sprites in scene"
      ]
    },
    {
      "id": "A3",
      "name": "AttractButton",
      "type": "dom_element",
      "semantic": "Button to select Attract sculpting tool",
      "locator_hints": [
        "button containing text 'Attract'"
      ]
    },
    {
      "id": "A4",
      "name": "RepelButton",
      "type": "dom_element",
      "semantic": "Button to select Repel sculpting tool",
      "locator_hints": [
        "button containing text 'Repel'"
      ]
    },
    {
      "id": "A5",
      "name": "FreezeButton",
      "type": "dom_element",
      "semantic": "Button to select Freeze sculpting tool",
      "locator_hints": [
        "button containing text 'Freeze'"
      ]
    },
    {
      "id": "A6",
      "name": "DebugOverlay",
      "type": "3d_object",
      "semantic": "Physics debug visualization with velocity vectors and bounding boxes",
      "locator_hints": [
        "ArrowHelper objects, Line objects in scene"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-right HUD displaying simulation stats",
      "locator_hints": [
        "div with stats text in top-right"
      ]
    },
    {
      "id": "A8",
      "name": "WindArrow",
      "type": "3d_object",
      "semantic": "Arrow helper showing wind direction",
      "locator_hints": [
        "ArrowHelper in scene for wind"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 500",
        "window.__3D_STATE__.currentTool === 'attract'",
        "window.__3D_STATE__.simulationPaused === false",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.windStrength === 0.5",
        "window.__3D_STATE__.windPresetIndex === 0",
        "window.__3D_STATE__.frozenCount === 0",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.modelOpacity >= 0.25 && window.__3D_STATE__.modelOpacity <= 0.35"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 60",
        "window.__3D_STATE__.averageVelocity > 0",
        "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
        "window.__3D_STATE__.totalKineticEnergy >= 0"
      ]
    },
    {
      "id": "S3",
      "name": "DebugEnabled",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S4",
      "name": "ToolChangedToRepel",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'repel'"
      ]
    },
    {
      "id": "S5",
      "name": "ToolChangedToFreeze",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'freeze'"
      ]
    },
    {
      "id": "S6",
      "name": "WindChanged",
      "conditions": [
        "window.__3D_STATE__.windPresetIndex === 1",
        "window.__3D_STATE__.windDirection.z === -1"
      ]
    },
    {
      "id": "S7",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S8",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationPaused === true"
      ]
    },
    {
      "id": "S9",
      "name": "WindStrengthIncreased",
      "conditions": [
        "window.__3D_STATE__.windStrength === 0.75"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.frozenCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelOpacity >= 0.25 && window.__3D_STATE__.modelOpacity <= 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 14 && window.__3D_STATE__.cameraDistance < 16",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageVelocity > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCount === 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.averageVelocity >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCount + window.__3D_STATE__.frozenCount === 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_content": "Repel"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'repel'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_content": "Freeze"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'freeze'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windPresetIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection.x === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection.z === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windDirection.y === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windStrength === 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windPresetIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.averageVelocity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTool === 'freeze'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "+"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windStrength === 0.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windStrength >= 0.0 && window.__3D_STATE__.windStrength <= 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frozenCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          }
        ]
