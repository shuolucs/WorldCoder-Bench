  "states": [
    {
      "id": "S0",
      "name": "MenuState",
      "conditions": [
        "window.__3D_STATE__.gameState === 'menu'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "PlayingInitial",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.isGrounded === true"
      ]
    },
    {
      "id": "S2",
      "name": "Jumping",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.isGrounded === false",
        "window.__3D_STATE__.storkVelocityY > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Airborne_Falling",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.isGrounded === false",
        "window.__3D_STATE__.storkVelocityY <= 0"
      ]
    },
    {
      "id": "S4",
      "name": "Landed",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.isGrounded === true",
        "window.__3D_STATE__.jumpCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "LaneChanged",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.currentLane !== 0"
      ]
    },
    {
      "id": "S6",
      "name": "ScoreIncreased",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.score >= 3"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.currentSpeed > 8"
      ]
    },
    {
      "id": "S8",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameover'"
      ]
    },
    {
      "id": "S9",
      "name": "Restarted",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.jumpCount === 0"
      ]
    }
  ],
