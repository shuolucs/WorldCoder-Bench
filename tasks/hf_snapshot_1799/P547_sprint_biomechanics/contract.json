{
  "task_id": "P547_sprint_biomechanics",
  "affordances": [
    {"id": "A1", "name": "HumanoidModel", "type": "3d_object", "semantic": "Loaded Xbot.glb with skeleton", "locator_hints": ["GLTF scene", "SkinnedMesh"]},
    {"id": "A2", "name": "JointArcs", "type": "3d_object", "semantic": "Visual angle arcs at joints", "locator_hints": ["line geometries at joints"]},
    {"id": "A3", "name": "FootTrail", "type": "3d_object", "semantic": "Foot position trail dots", "locator_hints": ["small spheres on ground"]},
    {"id": "A4", "name": "FrequencySlider", "type": "dom_element", "semantic": "Stride frequency control", "locator_hints": ["#slider-frequency"]},
    {"id": "A5", "name": "HipAmpSlider", "type": "dom_element", "semantic": "Hip amplitude control", "locator_hints": ["#slider-hip-amp"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.gaitPhase > 0"]},
    {"id": "S2", "name": "ParamsChanged", "conditions": ["window.__3D_STATE__.strideFrequency !== 2.5"]},
    {"id": "S3", "name": "Paused", "conditions": ["window.__3D_STATE__.isPaused === true"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.gaitPhase === 0 || window.__3D_STATE__.gaitPhase < 0.01"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.gaitPhase > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.bonesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Math.abs(s.leftHipAngle + s.rightHipAngle) < s.hipAmplitude * 1.5 || true; })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-frequency').value = 4.0; document.getElementById('slider-frequency').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.strideFrequency >= 3.5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bonesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-hip-amp').value = 1.2; document.getElementById('slider-hip-amp').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.hipAmplitude >= 1.0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bonesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": " "},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-phase') !== null", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.bonesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "g"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isPaused === false", "tier": "L2"}
      ]}
    }
  ]
}
