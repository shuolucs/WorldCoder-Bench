  "affordances": [
    {
      "id": "A1",
      "name": "RoadNetwork",
      "type": "3d_object",
      "semantic": "Crossing roads with lane markings forming an intersection at origin",
      "locator_hints": [
        "ground plane with road meshes",
        "lane markings as dashed lines"
      ]
    },
    {
      "id": "A2",
      "name": "VehicleParticles",
      "type": "3d_object",
      "semantic": "Box-shaped vehicle meshes color-coded by speed",
      "locator_hints": [
        "BoxGeometry meshes on roads",
        "colored green/yellow/red"
      ]
    },
    {
      "id": "A3",
      "name": "TrafficLight",
      "type": "3d_object",
      "semantic": "Traffic light post with three colored spheres at intersection",
      "locator_hints": [
        "cylinder post near origin",
        "three sphere lights"
      ]
    },
    {
      "id": "A4",
      "name": "ExhaustParticles",
      "type": "3d_object",
      "semantic": "Small semi-transparent gray spheres trailing behind vehicles",
      "locator_hints": [
        "tiny spheres near vehicle rears",
        "fading upward"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing vehicle count, avg speed, light phase, time",
      "locator_hints": [
        "HTML div overlay",
        "text content with stats"
      ]
    },
    {
      "id": "A6",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume simulation",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A7",
      "name": "AddTrafficButton",
      "type": "dom_element",
      "semantic": "Button to increase vehicle pool by 10",
      "locator_hints": [
        "#btn-add"
      ]
    },
    {
      "id": "A8",
      "name": "ClearTrafficButton",
      "type": "dom_element",
      "semantic": "Button to remove all vehicles",
      "locator_hints": [
        "#btn-clear"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.vehicleCount >= 0",
        "window.__3D_STATE__.maxVehicles === 60",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isFastForward === false",
        "window.__3D_STATE__.cameraMode === 'perspective'"
      ]
    },
    {
      "id": "S1",
      "name": "VehiclesSpawned",
      "conditions": [
        "window.__3D_STATE__.vehicleCount > 0",
        "window.__3D_STATE__.totalSpawned > 0",
        "window.__3D_STATE__.avgSpeed >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "TrafficPhaseChanged",
      "conditions": [
        "window.__3D_STATE__.trafficPhase !== 'H-Green' || window.__3D_STATE__.phaseDuration >= 0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S5",
      "name": "TrafficAdded",
      "conditions": [
        "window.__3D_STATE__.maxVehicles === 70"
      ]
    },
    {
      "id": "S6",
      "name": "TrafficCleared",
      "conditions": [
        "window.__3D_STATE__.vehicleCount === 0"
      ]
    },
    {
      "id": "S7",
      "name": "TopDownCamera",
      "conditions": [
        "window.__3D_STATE__.cameraMode === 'topdown'"
      ]
    },
    {
      "id": "S8",
      "name": "FastForward",
      "conditions": [
        "window.__3D_STATE__.isFastForward === true"
      ]
    },
    {
      "id": "S9",
      "name": "TrafficRebuilt",
      "conditions": [
        "window.__3D_STATE__.vehicleCount > 0",
        "window.__3D_STATE__.maxVehicles === 70"
      ]
    }
  ],
