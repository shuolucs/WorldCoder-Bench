  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.sunAzimuth === 180",
        "window.__3D_STATE__.sunAltitude === 45",
        "window.__3D_STATE__.analysisMode === 'lux'",
        "window.__3D_STATE__.windowStates[0] === true && window.__3D_STATE__.windowStates[1] === true && window.__3D_STATE__.windowStates[2] === true"
      ]
    },
    {
      "id": "S1",
      "name": "AltitudeChanged",
      "conditions": [
        "window.__3D_STATE__.sunAltitude === 70"
      ]
    },
    {
      "id": "S2",
      "name": "WindowW2Disabled",
      "conditions": [
        "window.__3D_STATE__.windowStates[1] === false"
      ]
    },
    {
      "id": "S3",
      "name": "ComplianceModeActive",
      "conditions": [
        "window.__3D_STATE__.analysisMode === 'compliance'"
      ]
    },
    {
      "id": "S4",
      "name": "CellSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCell !== null"
      ]
    },
    {
      "id": "S5",
      "name": "AzimuthChanged",
      "conditions": [
        "window.__3D_STATE__.sunAzimuth === 90"
      ]
    },
    {
      "id": "S6",
      "name": "UniformityModeActive",
      "conditions": [
        "window.__3D_STATE__.analysisMode === 'uniformity'"
      ]
    },
    {
      "id": "S7",
      "name": "MultipleWindowsDisabled",
      "conditions": [
        "window.__3D_STATE__.windowStates[0] === false && window.__3D_STATE__.windowStates[2] === false"
      ]
    },
    {
      "id": "S8",
      "name": "LowAltitude",
      "conditions": [
        "window.__3D_STATE__.sunAltitude === 10"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.sunAzimuth === 180",
        "window.__3D_STATE__.sunAltitude === 45",
        "window.__3D_STATE__.analysisMode === 'lux'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.gridLux) && window.__3D_STATE__.gridLux.length === 280",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellCount === 280 && window.__3D_STATE__.gridCols === 20 && window.__3D_STATE__.gridRows === 14",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => typeof v === 'number' && !isNaN(v) && isFinite(v) && v >= 0 && v <= 2000)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stats === 'object' && typeof window.__3D_STATE__.stats.avgLux === 'number' && window.__3D_STATE__.stats.avgLux > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stats.minLux >= 0 && window.__3D_STATE__.stats.maxLux <= 2000 && window.__3D_STATE__.stats.minLux <= window.__3D_STATE__.stats.avgLux",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s=document.querySelector('#altitude-slider'); s.value=70; s.dispatchEvent(new Event('input',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunAltitude === 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => typeof v === 'number' && !isNaN(v) && v >= 0 && v <= 2000)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux > 0",
            "tier": "L2"
          },
          {
            "expr": "(() => { const maxLux = Math.max(...window.__3D_STATE__.gridLux); return maxLux > 200; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.complianceRate >= 0 && window.__3D_STATE__.stats.complianceRate <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggle-w2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windowStates[1] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowStates[0] === true && window.__3D_STATE__.windowStates[2] === true",
            "tier": "L2"
          },
          {
            "expr": "(() => { const prevTotal = 3*2 + 4*2.5 + 3*2; const newTotal = 3*2 + 3*2; return Math.abs(window.__3D_STATE__.totalWindowArea - newTotal) < 0.5; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => !isNaN(v) && v >= 0 && v <= 2000)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let d=document.querySelector('#analysis-mode'); d.value='compliance'; d.dispatchEvent(new Event('change',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.analysisMode === 'compliance'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.length === 280",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stats.complianceRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stats.complianceRate >= 0 && window.__3D_STATE__.stats.complianceRate <= 100",
            "tier": "L2"
          },
          {
            "expr": "(() => { const passing = window.__3D_STATE__.gridLux.filter(v => v >= 300).length; const rate = (passing / 280) * 100; return Math.abs(window.__3D_STATE__.stats.complianceRate - rate) < 1.0; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let d=document.querySelector('#analysis-mode'); d.value='lux'; d.dispatchEvent(new Event('change',{bubbles:true})); let cv=document.querySelector('canvas'); let rect=cv.getBoundingClientRect(); let cx=rect.left+rect.width*0.5; let cy=rect.top+rect.height*0.7; cv.dispatchEvent(new MouseEvent('click',{clientX:cx,clientY:cy,bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCell !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCell.col === 'number' && typeof window.__3D_STATE__.selectedCell.row === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedCell.col >= 0 && window.__3D_STATE__.selectedCell.col < 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCell.row >= 0 && window.__3D_STATE__.selectedCell.row < 14",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCell.lux === 'number' && window.__3D_STATE__.selectedCell.lux >= 0 && window.__3D_STATE__.selectedCell.lux <= 2000",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s=document.querySelector('#azimuth-slider'); s.value=90; s.dispatchEvent(new Event('input',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunAzimuth === 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => typeof v === 'number' && !isNaN(v) && v >= 0 && v <= 2000)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.minLux <= window.__3D_STATE__.stats.maxLux",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux >= window.__3D_STATE__.stats.minLux && window.__3D_STATE__.stats.avgLux <= window.__3D_STATE__.stats.maxLux",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stats.uniformityRatio === 'number' && window.__3D_STATE__.stats.uniformityRatio >= 0 && window.__3D_STATE__.stats.uniformityRatio <= 1",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let d=document.querySelector('#analysis-mode'); d.value='uniformity'; d.dispatchEvent(new Event('change',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.analysisMode === 'uniformity'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.length === 280",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stats.uniformityRatio === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stats.uniformityRatio >= 0 && window.__3D_STATE__.stats.uniformityRatio <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "(() => { const avg = window.__3D_STATE__.stats.avgLux; const min = window.__3D_STATE__.stats.minLux; return avg > 0 ? Math.abs(window.__3D_STATE__.stats.uniformityRatio - (min / avg)) < 0.01 : true; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#toggle-w1').click(); document.querySelector('#toggle-w3').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windowStates[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowStates[2] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowStates[1] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWindowArea === 0 || window.__3D_STATE__.totalWindowArea < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux === 0 || window.__3D_STATE__.stats.avgLux < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => v < 1)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#toggle-w1').click(); document.querySelector('#toggle-w2').click(); document.querySelector('#toggle-w3').click(); let s=document.querySelector('#altitude-slider'); s.value=10; s.dispatchEvent(new Event('input',{bubbles:true})); let d=document.querySelector('#analysis-mode'); d.value='lux'; d.dispatchEvent(new Event('change',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunAltitude === 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowStates[0] === true && window.__3D_STATE__.windowStates[1] === true && window.__3D_STATE__.windowStates[2] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.analysisMode === 'lux'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux > 0",
            "tier": "L2"
          },
          {
            "expr": "(() => { const sinAlt = Math.sin(10 * Math.PI / 180); return window.__3D_STATE__.stats.maxLux < 1500; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sunAzimuth === 180",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunAltitude === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.analysisMode === 'lux'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.windowStates[0] === true && window.__3D_STATE__.windowStates[1] === true && window.__3D_STATE__.windowStates[2] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gridLux.every(v => typeof v === 'number' && !isNaN(v) && v >= 0 && v <= 2000)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stats.avgLux > 0 && window.__3D_STATE__.stats.complianceRate >= 0",
            "tier": "L2"
          }
        ]
      }
