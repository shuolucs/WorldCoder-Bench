{
  "task_id": "P537_anatomy_skeleton",
  "affordances": [
    {"id": "A1", "name": "Skeleton", "type": "3d_object", "semantic": "Hierarchical skeleton with 22 bones", "locator_hints": ["group containing cylinder and sphere meshes"]},
    {"id": "A2", "name": "BoneLabel", "type": "dom_element", "semantic": "Label showing selected bone name", "locator_hints": ["#label-bone"]},
    {"id": "A3", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.totalBones === 22", "window.__3D_STATE__.selectedBone === null", "window.__3D_STATE__.isTransparent === false", "window.__3D_STATE__.isExploded === false"]},
    {"id": "S1", "name": "TransparentMode", "conditions": ["window.__3D_STATE__.isTransparent === true"]},
    {"id": "S2", "name": "ExplodedMode", "conditions": ["window.__3D_STATE__.isExploded === true"]},
    {"id": "S3", "name": "ViewChanged", "conditions": ["window.__3D_STATE__.cameraView !== 'free'"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.selectedBone === null", "window.__3D_STATE__.isTransparent === false", "window.__3D_STATE__.isExploded === false"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.totalBones === 22", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bonesValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isTransparent === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-transparent').textContent.includes('ON')", "tier": "L2"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "e"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isExploded === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-explode').textContent.includes('ON')", "tier": "L2"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "1"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.cameraView === 'front'", "tier": "L2"},
        {"expr": "document.getElementById('hud-view').textContent.includes('Front')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "2"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.cameraView === 'side'", "tier": "L2"},
        {"expr": "document.getElementById('hud-view').textContent.includes('Side')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.selectedBone === null", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isTransparent === false", "tier": "L2"},
        {"expr": "window.__3D_STATE__.isExploded === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-bone').textContent.includes('None')", "tier": "L2"}
      ]}
    }
  ]
}
