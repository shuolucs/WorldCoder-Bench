  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.gameFinished === false",
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameFinished === false",
        "window.__3D_STATE__.speed >= 0"
      ]
    },
    {
      "id": "S2",
      "name": "MovingLeft",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.skierX < 0"
      ]
    },
    {
      "id": "S3",
      "name": "SlowMotionActive",
      "conditions": [
        "window.__3D_STATE__.slowMotionActive === true",
        "window.__3D_STATE__.timeScale === 0.3"
      ]
    },
    {
      "id": "S4",
      "name": "SlowMotionOff",
      "conditions": [
        "window.__3D_STATE__.slowMotionActive === false",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "BoostActive",
      "conditions": [
        "window.__3D_STATE__.boostActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "BoostCooldown",
      "conditions": [
        "window.__3D_STATE__.boostActive === false",
        "window.__3D_STATE__.boostCooldown > 0"
      ]
    },
    {
      "id": "S7",
      "name": "GameFinished",
      "conditions": [
        "window.__3D_STATE__.gameFinished === true"
      ]
    }
  ],
  "transitions": [
