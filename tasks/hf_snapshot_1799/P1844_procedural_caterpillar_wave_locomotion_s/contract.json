  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 12",
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.heading === 0",
        "window.__3D_STATE__.amplitude === 0.15",
        "window.__3D_STATE__.frequency === 3.0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0",
        "window.__3D_STATE__.frameCount > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speed === 1.25",
        "window.__3D_STATE__.lastAction === 'speed_up'"
      ]
    },
    {
      "id": "S3",
      "name": "HeadingChanged",
      "conditions": [
        "Math.abs(window.__3D_STATE__.heading) > 0.04",
        "window.__3D_STATE__.lastAction === 'turn_left' || window.__3D_STATE__.lastAction === 'turn_right'"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.lastAction === 'pause'"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.lastAction === 'resume'"
      ]
    },
    {
      "id": "S6",
      "name": "AmplitudeModified",
      "conditions": [
        "window.__3D_STATE__.amplitude !== 0.15",
        "window.__3D_STATE__.lastAction === 'amplitude_change'"
      ]
    },
    {
      "id": "S7",
      "name": "FrequencyModified",
      "conditions": [
        "window.__3D_STATE__.frequency !== 3.0",
        "window.__3D_STATE__.lastAction === 'frequency_change'"
      ]
    },
    {
      "id": "S8",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'undo'",
        "window.__3D_STATE__.redoStackSize > 0"
