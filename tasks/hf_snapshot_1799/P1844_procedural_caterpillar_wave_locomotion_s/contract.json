    {
      "id": "S9",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S10",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.heading === 0",
        "window.__3D_STATE__.amplitude === 0.15",
        "window.__3D_STATE__.frequency === 3.0",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S11",
      "name": "MaxSpeedClamped",
      "conditions": [
