  "states": [
    {
      "id": "S0",
      "name": "ModelsLoaded",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "WaitingToStart",
      "conditions": [
        "window.__3D_STATE__.gameState === 'waiting'",
        "window.__3D_STATE__.playerScore === 0",
        "window.__3D_STATE__.aiScore === 0"
      ]
    },
    {
      "id": "S2",
      "name": "GamePlaying",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S3",
      "name": "PlayerMoving",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "Math.abs(window.__3D_STATE__.playerVelocity.x) + Math.abs(window.__3D_STATE__.playerVelocity.z) > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "PlayerAttacked",
      "conditions": [
        "window.__3D_STATE__.playerAttacking === true || window.__3D_STATE__.playerStamina < 100"
      ]
    },
    {
      "id": "S5",
      "name": "CollisionOccurred",
      "conditions": [
        "window.__3D_STATE__.lastCollisionTime > 0"
      ]
    },
    {
      "id": "S6",
      "name": "RoundEnded",
      "conditions": [
        "window.__3D_STATE__.gameState === 'roundEnd' || window.__3D_STATE__.playerScore + window.__3D_STATE__.aiScore > 0"
      ]
    },
    {
      "id": "S7",
      "name": "StaminaRecovering",
      "conditions": [
        "window.__3D_STATE__.playerStamina > 0",
        "window.__3D_STATE__.playerStamina <= 100"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleRounds",
      "conditions": [
        "window.__3D_STATE__.roundNumber >= 2"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameState === 'gameOver'",
        "window.__3D_STATE__.winner !== null"
      ]
    }
  ],
