{
  "task_id": "P286_network_topology_graph",
  "affordances": [
    {
      "id": "A1",
      "name": "NetworkNodes",
      "type": "3d_object",
      "semantic": "Six colored spheres arranged in a circle representing network services",
      "locator_hints": [
        "sphere meshes in a group",
        "radius 0.6 spheres"
      ]
    },
    {
      "id": "A2",
      "name": "CenterModel",
      "type": "3d_object",
      "semantic": "GLB model at origin representing core server",
      "locator_hints": [
        "ABeautifulGame.glb model at origin"
      ]
    },
    {
      "id": "A3",
      "name": "Edges",
      "type": "3d_object",
      "semantic": "White lines connecting nodes",
      "locator_hints": [
        "Line objects with white material"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleLabelsButton",
      "type": "dom_element",
      "semantic": "Button to toggle node label visibility",
      "locator_hints": [
        "#toggleLabels"
      ]
    },
    {
      "id": "A5",
      "name": "ResetViewButton",
      "type": "dom_element",
      "semantic": "Button to reset camera position",
      "locator_hints": [
        "#resetView"
      ]
    },
    {
      "id": "A6",
      "name": "PulseButton",
      "type": "dom_element",
      "semantic": "Button to trigger network pulse animation",
      "locator_hints": [
        "#pulseNetwork"
      ]
    },
    {
      "id": "A7",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Info panel showing node count, edge count, and selected node",
      "locator_hints": [
        "top-left panel div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 7",
        "window.__3D_STATE__.edgeCount === 12",
        "window.__3D_STATE__.selectedNode === null",
        "window.__3D_STATE__.labelsVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNode !== null",
        "typeof window.__3D_STATE__.selectedNode === 'string'"
      ]
    },
    {
      "id": "S3",
      "name": "LabelsHidden",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 15) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 25) < 1"
      ]
    },
    {
      "id": "S5",
      "name": "Pulsing",
      "conditions": [
        "window.__3D_STATE__.pulsing === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nodeCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedNode !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.labelsVisible !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "Node 0 sphere (red, Web Server)",
        "offset_hint": "click on the red sphere node"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nodeCount !== before.nodeCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number' && !isNaN(window.__3D_STATE__.nodeCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.edgeCount === 'number' && !isNaN(window.__3D_STATE__.edgeCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.nodesData)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
