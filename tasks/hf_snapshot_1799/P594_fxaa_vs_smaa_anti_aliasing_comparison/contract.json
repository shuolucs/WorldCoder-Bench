{
  "task_id": "P594_fxaa_vs_smaa_anti_aliasing_comparison",
  "affordances": [
    {
      "id": "A1",
      "name": "SceneObjects",
      "type": "3d_object",
      "semantic": "Collection of aliasing-test geometry (icosahedron, lines, checkerboard plane)",
      "locator_hints": [
        "scene.children with type Mesh or Line"
      ]
    },
    {
      "id": "A2",
      "name": "SplitDivider",
      "type": "dom_element",
      "semantic": "Draggable vertical divider controlling viewport split",
      "locator_hints": [
        "div with cursor:col-resize",
        "4px wide white bar"
      ]
    },
    {
      "id": "A3",
      "name": "SwapButton",
      "type": "dom_element",
      "semantic": "Button that swaps left and right AA methods",
      "locator_hints": [
        "button containing 'Swap Sides'"
      ]
    },
    {
      "id": "A4",
      "name": "LeftLabel",
      "type": "dom_element",
      "semantic": "Overlay label showing left side AA method",
      "locator_hints": [
        "top-left corner text"
      ]
    },
    {
      "id": "A5",
      "name": "RightLabel",
      "type": "dom_element",
      "semantic": "Overlay label showing right side AA method",
      "locator_hints": [
        "top-right corner text"
      ]
    },
    {
      "id": "A6",
      "name": "HUDCenter",
      "type": "dom_element",
      "semantic": "Top-center HUD showing method pair",
      "locator_hints": [
        "top-center text like 'FXAA | SMAA'"
      ]
    },
    {
      "id": "A7",
      "name": "ZoomInset",
      "type": "dom_element",
      "semantic": "4x magnified pixel-zoom inset at bottom-right",
      "locator_hints": [
        "200x200 canvas or div at bottom-right"
      ]
    },
    {
      "id": "A8",
      "name": "RotationDisplay",
      "type": "dom_element",
      "semantic": "Bottom-left rotation degree display",
      "locator_hints": [
        "bottom-left text showing degrees"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.leftMethod === 'FXAA'",
        "window.__3D_STATE__.rightMethod === 'SMAA'",
        "Math.abs(window.__3D_STATE__.dividerPosition - 0.5) < 0.01",
        "window.__3D_STATE__.pixelZoomActive === false",
        "window.__3D_STATE__.sceneRotationDeg === 0",
        "window.__3D_STATE__.swapCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "LeftSetToNone",
      "conditions": [
        "window.__3D_STATE__.leftMethod === 'None'",
        "window.__3D_STATE__.rightMethod === 'SMAA'",
        "window.__3D_STATE__.lastKeyPressed === '1'"
      ]
    },
    {
      "id": "S2",
      "name": "RightSetToFXAA",
      "conditions": [
        "window.__3D_STATE__.rightMethod === 'FXAA'",
        "window.__3D_STATE__.lastKeyPressed === '5'"
      ]
    },
    {
      "id": "S3",
      "name": "SidesSwapped",
      "conditions": [
        "window.__3D_STATE__.swapCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "SceneRotated",
      "conditions": [
        "window.__3D_STATE__.sceneRotationDeg > 0"
      ]
    },
    {
      "id": "S5",
      "name": "PixelZoomOn",
      "conditions": [
        "window.__3D_STATE__.pixelZoomActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "PixelZoomOff",
      "conditions": [
        "window.__3D_STATE__.pixelZoomActive === false"
      ]
    },
    {
      "id": "S7",
      "name": "DividerMoved",
      "conditions": [
        "Math.abs(window.__3D_STATE__.dividerPosition - 0.5) > 0.05"
      ]
    },
    {
      "id": "S8",
      "name": "BothSameMethod",
      "conditions": [
        "window.__3D_STATE__.leftMethod === window.__3D_STATE__.rightMethod"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.leftMethod === 'FXAA'",
        "window.__3D_STATE__.rightMethod === 'SMAA'",
        "Math.abs(window.__3D_STATE__.dividerPosition - 0.5) < 0.01",
        "window.__3D_STATE__.sceneRotationDeg === 0",
        "window.__3D_STATE__.resetCount >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftMethod === 'string' && typeof window.__3D_STATE__.rightMethod === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.leftMethod === 'FXAA' && window.__3D_STATE__.rightMethod === 'SMAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount >= 7",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dividerPosition - 0.5) < 0.01 && window.__3D_STATE__.pixelZoomActive === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leftMethod === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightMethod === 'SMAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === '1'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerRightEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.smaaWidth === 'number' && window.__3D_STATE__.smaaWidth > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leftMethod === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightMethod === 'FXAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === '5'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fxaaResolutionX === 'number' && window.__3D_STATE__.fxaaResolutionX > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.fxaaResolutionY === 'number' && window.__3D_STATE__.fxaaResolutionY > 0",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fxaaResolutionX - (1.0 / window.innerWidth)) < 0.0001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.swapCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftMethod === 'FXAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightMethod === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerLeftEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dividerPosition >= 0.1 && window.__3D_STATE__.dividerPosition <= 0.9",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sceneRotationDeg === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sceneRotationDeg)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg >= 0 && window.__3D_STATE__.sceneRotationDeg < 360",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === 'ArrowRight'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pixelZoomActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === 'P' || window.__3D_STATE__.lastKeyPressed === 'p'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pixelZoomActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === 'P' || window.__3D_STATE__.lastKeyPressed === 'p'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerLeftEnabled === true || window.__3D_STATE__.composerRightEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraPositionZ === 12",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leftMethod === 'FXAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightMethod === 'None'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === '2'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerLeftEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fxaaResolutionX * window.innerWidth - 1.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leftMethod === 'FXAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rightMethod === 'SMAA'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dividerPosition - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pixelZoomActive === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<12;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneRotationDeg >= 0 && window.__3D_STATE__.sceneRotationDeg < 360",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sceneRotationDeg)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftMethod === 'FXAA' && window.__3D_STATE__.rightMethod === 'SMAA'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastKeyPressed === 'ArrowRight'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}