  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#3498db'",
        "window.__3D_STATE__.pattern === 'none'",
        "window.__3D_STATE__.thickness === 0.12",
        "window.__3D_STATE__.isSelected === false",
        "window.__3D_STATE__.textLabel === ''"
      ]
    },
    {
      "id": "S1",
      "name": "BottleLoaded",
      "conditions": [
        "window.__3D_STATE__.bottleLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#e74c3c'",
        "window.__3D_STATE__.colorChangeCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "MaterialGlossy",
      "conditions": [
        "window.__3D_STATE__.material === 'glossy'"
      ]
    },
    {
      "id": "S4",
      "name": "PatternApplied",
      "conditions": [
        "window.__3D_STATE__.pattern === 'stripes'",
        "window.__3D_STATE__.patternCycleCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "ThicknessAdjusted",
      "conditions": [
        "window.__3D_STATE__.thickness === 0.20"
      ]
    },
    {
      "id": "S6",
      "name": "CaseSelected",
      "conditions": [
        "window.__3D_STATE__.isSelected === true"
      ]
    },
    {
      "id": "S7",
      "name": "CaseRotated",
      "conditions": [
        "window.__3D_STATE__.isAnimating === false",
        "Math.abs(window.__3D_STATE__.caseRotationY - Math.PI / 2) < 0.15 || Math.abs(window.__3D_STATE__.caseRotationY - (-Math.PI / 2)) < 0.15 || Math.abs(window.__3D_STATE__.caseRotationY % (Math.PI/2)) < 0.15"
      ]
    },
    {
      "id": "S8",
      "name": "TextApplied",
      "conditions": [
        "window.__3D_STATE__.textLabel.length > 0",
        "window.__3D_STATE__.textLabel.length <= 12"
      ]
    },
    {
      "id": "S9",
      "name": "FullyCustomized",
      "conditions": [
        "window.__3D_STATE__.caseColor !== '#3498db'",
        "window.__3D_STATE__.pattern !== 'none'",
        "window.__3D_STATE__.textLabel.length > 0",
        "window.__3D_STATE__.material === 'glossy' || window.__3D_STATE__.material === 'matte'"
      ]
    },
    {
      "id": "S10",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#3498db'",
        "window.__3D_STATE__.pattern === 'none'",
        "window.__3D_STATE__.thickness === 0.12",
        "window.__3D_STATE__.textLabel === ''"
      ]
    }
  ],
