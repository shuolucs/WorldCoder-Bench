      "locator_hints": [
        "button with text Freeze"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paletteIndex === 0",
        "window.__3D_STATE__.paletteName === 'ironbow'",
        "window.__3D_STATE__.minTemp === 0",
        "window.__3D_STATE__.maxTemp === 100",
        "window.__3D_STATE__.sensitivity === 1.0",
        "window.__3D_STATE__.isolinesEnabled === false",
        "window.__3D_STATE__.selectedObjectIndex === null",
        "JSON.stringify(window.__3D_STATE__.objectInitialTemperatures) === '[90,60,45,75,30]'"
      ]
    },
    {
      "id": "S1",
      "name": "PaletteCycled",
      "conditions": [
        "window.__3D_STATE__.paletteIndex === 1",
        "window.__3D_STATE__.paletteName === 'rainbow'"
      ]
    },
    {
      "id": "S2",
      "name": "ObjectSelected",
      "conditions": [
        "window.__3D_STATE__.selectedObjectIndex !== null",
        "typeof window.__3D_STATE__.selectedObjectIndex === 'number'"
      ]
    },
    {
      "id": "S3",
      "name": "TemperatureModified",
      "conditions": [
        "window.__3D_STATE__.objectTemperatures[0] !== window.__3D_STATE__.objectInitialTemperatures[0]"
      ]
    },
    {
      "id": "S4",
      "name": "SensitivityChanged",
      "conditions": [
        "window.__3D_STATE__.sensitivity !== 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "IsolinesOn",
      "conditions": [
        "window.__3D_STATE__.isolinesEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "RangeAdjusted",
      "conditions": [
        "window.__3D_STATE__.minTemp !== 0 || window.__3D_STATE__.maxTemp !== 100"
      ]
    },
    {
      "id": "S7",
      "name": "DiffusionFrozen",
      "conditions": [
        "window.__3D_STATE__.diffusionFrozen === true"
      ]
    },
    {
      "id": "S8",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.paletteIndex === 0",
        "window.__3D_STATE__.sensitivity === 1.0",
        "window.__3D_STATE__.selectedObjectIndex === null",
        "window.__3D_STATE__.minTemp === 0",
        "window.__3D_STATE__.maxTemp === 100"
      ]
    },
    {
      "id": "S9",
      "name": "MultiPaletteCycled",
      "conditions": [
        "window.__3D_STATE__.paletteIndex === 3",
        "window.__3D_STATE__.paletteName === 'arctic'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectTemperatures) && window.__3D_STATE__.objectTemperatures.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectInitialTemperatures) && window.__3D_STATE__.objectInitialTemperatures.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastDeltaTime === 'number' && !isNaN(window.__3D_STATE__.lastDeltaTime) && window.__3D_STATE__.lastDeltaTime > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectTemperatures.every(t => typeof t === 'number' && !isNaN(t) && t >= 0 && t <= 150)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paletteIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paletteName === 'rainbow'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.paletteName === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paletteIndex >= 0 && window.__3D_STATE__.paletteIndex <= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "HeatSphere",
        "position_hint": "click on sphere at left side of scene (~25% from left, ~50% height)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedObjectIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedObjectIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectTemperatures[0] >= 0 && window.__3D_STATE__.objectTemperatures[0] <= 150",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paletteIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevTemp = window.__3D_STATE__.objectTemperatures[0]; window.__PREV_TEMP_0__ = prevTemp; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__PREV_TEMP_0__ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectTemperatures[0] > window.__PREV_TEMP_0__",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[0] - (window.__PREV_TEMP_0__ + 5)) < 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectTemperatures[0] <= 150",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedObjectIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsSync === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('input[type=range]'); if(slider) { slider.value = 2.0; slider.dispatchEvent(new Event('input', {bubbles:true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sensitivity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sensitivity - 2.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sensitivity >= 0.5 && window.__3D_STATE__.sensitivity <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsSync === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sensitivity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "i"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isolinesEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isolinesEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsSync === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sensitivity >= 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__PREV_MAX__ = window.__3D_STATE__.maxTemp; document.dispatchEvent(new KeyboardEvent('keydown', {key: '+'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__PREV_MAX__ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp === window.__PREV_MAX__ + 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp > window.__3D_STATE__.minTemp",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxTemp <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "selector_hint": "Freeze button"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.diffusionFrozen === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.diffusionFrozen === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectTemperatures.every(t => !isNaN(t) && t >= 0 && t <= 150)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__FROZEN_TEMPS__ = [...window.__3D_STATE__.objectTemperatures]; await new Promise(r => setTimeout(r, 1000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.diffusionFrozen === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__FROZEN_TEMPS__) && window.__FROZEN_TEMPS__.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[0] - window.__FROZEN_TEMPS__[0]) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[1] - window.__FROZEN_TEMPS__[1]) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[2] - window.__FROZEN_TEMPS__[2]) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[4] - window.__FROZEN_TEMPS__[4]) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "selector_hint": "Reset button"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paletteIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paletteName === 'ironbow'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sensitivity - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedObjectIndex === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minTemp === 0 && window.__3D_STATE__.maxTemp === 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.objectTemperatures[0] - 90) < 0.5 && Math.abs(window.__3D_STATE__.objectTemperatures[4] - 30) < 0.5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}