        "range 3-20"
      ]
    },
    {
      "id": "A9",
      "name": "ShadowBiasSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling shadow bias",
      "locator_hints": [
        "#shadowBiasSlider",
        "range -0.005 to 0.005"
      ]
    },
    {
      "id": "A10",
      "name": "AnimateLightCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox toggling light orbit animation",
      "locator_hints": [
        "#animateLightCheckbox"
      ]
    },
    {
      "id": "A11",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button resetting all parameters to defaults",
      "locator_hints": [
        "#resetButton"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialDefaults",
      "conditions": [
        "window.__3D_STATE__.lightSize === 4.0",
        "window.__3D_STATE__.numSamples === 16",
        "window.__3D_STATE__.lightHeight === 10",
        "window.__3D_STATE__.shadowBias === -0.001",
        "window.__3D_STATE__.animateLight === false",
        "window.__3D_STATE__.shadowMapEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "HardShadowPreset",
      "conditions": [
        "window.__3D_STATE__.lightSize === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "VerySoftPreset",
      "conditions": [
        "window.__3D_STATE__.lightSize === 20.0"
      ]
    },
    {
      "id": "S3",
      "name": "SamplesChanged",
      "conditions": [
        "window.__3D_STATE__.numSamples === 32"
      ]
    },
    {
      "id": "S4",
      "name": "LightHeightAdjusted",
      "conditions": [
        "window.__3D_STATE__.lightHeight !== 10"
      ]
    },
    {
      "id": "S5",
      "name": "AnimationActive",
      "conditions": [
        "window.__3D_STATE__.animateLight === true"
      ]
    },
    {
      "id": "S6",
      "name": "BiasAdjusted",
      "conditions": [
        "window.__3D_STATE__.shadowBias !== -0.001"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.lightSize === 4.0",
        "window.__3D_STATE__.numSamples === 16",
        "window.__3D_STATE__.lightHeight === 10",
        "window.__3D_STATE__.animateLight === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightSize === 'number' && !isNaN(window.__3D_STATE__.lightSize)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapSize === 2048",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rendererShadowType === THREE.PCFSoftShadowMap",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightSize === 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('lightSizeSlider').value === '1'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numSamples === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightSize === 20.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('lightSizeSlider').value === '20'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightSize > 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightPosition === 'object' && window.__3D_STATE__.lightPosition !== null",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.lightPosition.x) && !isNaN(window.__3D_STATE__.lightPosition.y) && !isNaN(window.__3D_STATE__.lightPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('samplesSelect').value = '32'; document.getElementById('samplesSelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numSamples === 32",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('samplesSelect').value === '32'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.numSamples === 'number'",
            "tier": "L0"
          },
          {
            "expr": "[8, 16, 32, 64].includes(window.__3D_STATE__.numSamples)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('lightHeightSlider').value = '5'; document.getElementById('lightHeightSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightHeight === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightPosition.y === 5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('lightHeightSlider').value === '5'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightHeight >= 3 && window.__3D_STATE__.lightHeight <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('animateLightCheckbox').checked = true; document.getElementById('animateLightCheckbox').dispatchEvent(new Event('change')); return new Promise(r => setTimeout(r, 1200));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animateLight === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('animateLightCheckbox').checked === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lightPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.lightPosition.x ** 2 + window.__3D_STATE__.lightPosition.z ** 2) > 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.lightPosition.x) && !isNaN(window.__3D_STATE__.lightPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('shadowBiasSlider').value = '0.002'; document.getElementById('shadowBiasSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.shadowBias - 0.002) < 0.0005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowBias >= -0.005 && window.__3D_STATE__.shadowBias <= 0.005",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shadowBias === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.shadowBias)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadowMapEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lightSize === 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numSamples === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightHeight === 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shadowBias - (-0.001)) < 0.0005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animateLight === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('lightSizeSlider').value === '4'",
            "tier": "L2"
          }
        ]
      }
    }
