{
  "task_id": "P741_shader_playground_with_live_glsl_editing",
  "affordances": [
    {
      "id": "A1",
      "name": "PrimaryMesh",
      "type": "3d_object",
      "semantic": "Main icosahedron mesh with custom ShaderMaterial",
      "locator_hints": [
        "scene.children with isMesh and geometry type"
      ]
    },
    {
      "id": "A2",
      "name": "PreviewPlane",
      "type": "3d_object",
      "semantic": "Secondary plane mesh for 2D shader preview",
      "locator_hints": [
        "mesh at x=2.5"
      ]
    },
    {
      "id": "A3",
      "name": "ShaderEditor",
      "type": "dom_element",
      "semantic": "Textarea for editing GLSL code",
      "locator_hints": [
        "#shader-editor"
      ]
    },
    {
      "id": "A4",
      "name": "CompileButton",
      "type": "dom_element",
      "semantic": "Button to compile current shader",
      "locator_hints": [
        "#btn-compile"
      ]
    },
    {
      "id": "A5",
      "name": "VertexTab",
      "type": "dom_element",
      "semantic": "Tab to switch to vertex shader editing",
      "locator_hints": [
        "#tab-vertex"
      ]
    },
    {
      "id": "A6",
      "name": "FragmentTab",
      "type": "dom_element",
      "semantic": "Tab to switch to fragment shader editing",
      "locator_hints": [
        "#tab-fragment"
      ]
    },
    {
      "id": "A7",
      "name": "IntensitySlider",
      "type": "dom_element",
      "semantic": "Range slider controlling u_intensity uniform",
      "locator_hints": [
        "#slider-intensity"
      ]
    },
    {
      "id": "A8",
      "name": "GeometrySelect",
      "type": "dom_element",
      "semantic": "Dropdown to change primary mesh geometry",
      "locator_hints": [
        "#select-geometry"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset shaders to defaults",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last shader edit",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A11",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo undone shader edit",
      "locator_hints": [
        "#btn-redo"
      ]
    },
    {
      "id": "A12",
      "name": "ErrorLog",
      "type": "dom_element",
      "semantic": "Div displaying compilation status/errors",
      "locator_hints": [
        "#error-log"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.meshExists === true",
        "window.__3D_STATE__.previewMeshExists === true",
        "window.__3D_STATE__.currentGeometry === 'Icosahedron'",
        "window.__3D_STATE__.compilationSuccessCount === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isWireframe === false",
        "window.__3D_STATE__.activeTab === 'fragment'",
        "window.__3D_STATE__.undoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "AfterSuccessfulCompile",
      "conditions": [
        "window.__3D_STATE__.compilationSuccessCount >= 1",
        "window.__3D_STATE__.lastCompilationStatus === 'success'"
      ]
    },
    {
      "id": "S2",
      "name": "AfterFailedCompile",
      "conditions": [
        "window.__3D_STATE__.compilationErrorCount >= 1",
        "window.__3D_STATE__.lastCompilationStatus === 'error'"
      ]
    },
    {
      "id": "S3",
      "name": "VertexTabActive",
      "conditions": [
        "window.__3D_STATE__.activeTab === 'vertex'"
      ]
    },
    {
      "id": "S4",
      "name": "TimePaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S5",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.isWireframe === true"
      ]
    },
    {
      "id": "S6",
      "name": "GeometryChanged",
      "conditions": [
        "window.__3D_STATE__.currentGeometry !== 'Icosahedron'"
      ]
    },
    {
      "id": "S7",
      "name": "IntensityModified",
      "conditions": [
        "Math.abs(window.__3D_STATE__.uIntensity - 1.0) > 0.05"
      ]
    },
    {
      "id": "S8",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.compilationSuccessCount >= 2"
      ]
    },
    {
      "id": "S10",
      "name": "ScreenshotCaptured",
      "conditions": [
        "window.__3D_STATE__.screenshotTaken === true"
      ]
    },
    {
      "id": "S11",
      "name": "ShadersReset",
      "conditions": [
        "window.__3D_STATE__.lastCompilationStatus === 'success'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true && window.__3D_STATE__.previewMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uTime > 0 && !isNaN(window.__3D_STATE__.uTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentGeometry === 'Icosahedron'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraDistance - 3.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const editor = document.getElementById('shader-editor'); const oldVal = editor.value; editor.value = oldVal.replace('vec3(0,2,4)', 'vec3(1,3,5)'); document.getElementById('btn-compile').click(); return oldVal;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.compilationSuccessCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompilationStatus === 'success'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationErrorCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage === '' || window.__3D_STATE__.errorMessage === undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const editor = document.getElementById('shader-editor'); editor.value = 'void main() { INVALID_SYNTAX }'; document.getElementById('btn-compile').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.compilationErrorCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompilationStatus === 'error'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.errorMessage.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationSuccessCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#tab-vertex"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTab === 'vertex'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.editorContent.indexOf('gl_Position') !== -1 || window.__3D_STATE__.editorContent.indexOf('modelViewMatrix') !== -1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentVertexShader === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentVertexShader.length > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "(() => { window.__testTime1 = window.__3D_STATE__.uTime; return true; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 800
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__testTime1 === 'undefined' || Math.abs(window.__3D_STATE__.uTime - window.__testTime1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.uTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uTime >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isWireframe === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previewMeshExists === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sel = document.getElementById('select-geometry'); sel.value = 'Torus'; sel.dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentGeometry === 'Torus'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previewMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isWireframe === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationSuccessCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.getElementById('slider-intensity'); slider.value = '3.5'; slider.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.uIntensity - 3.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uIntensity >= 0.1 && window.__3D_STATE__.uIntensity <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentGeometry === 'Torus'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.uIntensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-undo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompilationStatus === 'success'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationSuccessCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFragmentShader.indexOf('vec3(0,2,4)') !== -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-redo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastCompilationStatus === 'success'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFragmentShader.indexOf('vec3(1,3,5)') !== -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.compilationSuccessCount >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.screenshotTaken === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentGeometry === 'Torus'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T13",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastCompilationStatus === 'success'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFragmentShader.indexOf('vec3(0,2,4)') !== -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentVertexShader.indexOf('modelViewMatrix') !== -1 || window.__3D_STATE__.currentVertexShader.indexOf('gl_Position') !== -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.previewMeshExists === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}