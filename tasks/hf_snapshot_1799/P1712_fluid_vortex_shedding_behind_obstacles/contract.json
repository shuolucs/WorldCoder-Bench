          {
            "expr": "document.querySelector('#select-viz') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.querySelector('#select-viz').value === 'velocity'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.velocityFieldSample === 'object' && typeof window.__3D_STATE__.velocityFieldSample.u === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.velocityFieldSample.u) && !isNaN(window.__3D_STATE__.velocityFieldSample.v)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#select-viz').value='dye'; document.querySelector('#select-viz').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.vizMode === 'dye'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#select-viz').value === 'dye'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.kineticEnergy === 'number' && isFinite(window.__3D_STATE__.kineticEnergy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S9",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
