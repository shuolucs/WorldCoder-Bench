          },
          {
            "expr": "typeof window.__3D_STATE__.reynoldsNumber === 'number' && window.__3D_STATE__.reynoldsNumber > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.inflowVelocity >= 0.5 && window.__3D_STATE__.inflowVelocity <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.energyHistory) && window.__3D_STATE__.energyHistory.length > 0",
            "tier": "L0"
          }
        ]
      }
    },
