      "from": "S7",
      "to": "S10",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<5;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));} for(let i=0;i<4;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowLeft'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.inflowVelocity >= 4.5 || window.__3D_STATE__.inflowVelocity === 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viscosity <= 0.0002",
            "tier": "L2"
          },
          {
