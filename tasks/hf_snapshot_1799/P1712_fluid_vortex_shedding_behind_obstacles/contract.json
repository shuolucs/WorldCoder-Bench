            "expr": "window.__3D_STATE__.kineticEnergy >= 0 && isFinite(window.__3D_STATE__.kineticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viscosity === 0.002",
