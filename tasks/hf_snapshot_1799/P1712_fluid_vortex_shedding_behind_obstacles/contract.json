        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.obstacleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.obstacles.length === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.obstacles[0].type === 'circle'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastRemovedObstacleId === 'number'",
