  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.simulationStep === 0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.vizMode === 'vorticity'",
        "window.__3D_STATE__.obstacleCount === 1",
        "window.__3D_STATE__.inflowVelocity === 2.0",
        "window.__3D_STATE__.viscosity === 0.001"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationStep > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "VizModeChanged",
      "conditions": [
        "window.__3D_STATE__.vizMode !== 'vorticity'"
      ]
    },
    {
      "id": "S4",
      "name": "InflowIncreased",
      "conditions": [
        "window.__3D_STATE__.inflowVelocity > 2.0"
      ]
    },
    {
      "id": "S5",
      "name": "ObstacleAdded",
      "conditions": [
        "window.__3D_STATE__.obstacleCount > 1"
      ]
    },
    {
      "id": "S6",
      "name": "ObstacleUndone",
      "conditions": [
        "window.__3D_STATE__.lastRemovedObstacleId !== null"
      ]
    },
    {
      "id": "S7",
      "name": "ViscosityChanged",
      "conditions": [
        "window.__3D_STATE__.viscosity !== 0.001"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.simulationStep === 0",
        "window.__3D_STATE__.obstacleCount === 1"
      ]
    },
    {
      "id": "S9",
      "name": "DyeVizMode",
      "conditions": [
        "window.__3D_STATE__.vizMode === 'dye'"
      ]
    },
    {
      "id": "S10",
      "name": "HighReynolds",
      "conditions": [
        "window.__3D_STATE__.reynoldsNumber > 20000"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationStep === 'number' && window.__3D_STATE__.simulationStep > 10",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.kineticEnergy === 'number' && !isNaN(window.__3D_STATE__.kineticEnergy) && window.__3D_STATE__.kineticEnergy > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalVorticity === 'number' && !isNaN(window.__3D_STATE__.totalVorticity) && isFinite(window.__3D_STATE__.totalVorticity)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gridWidth === 200 && window.__3D_STATE__.gridHeight === 80",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.obstacles) && window.__3D_STATE__.obstacles.length === 1 && window.__3D_STATE__.obstacles[0].type === 'circle'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "(() => { window.__pausedStep = window.__3D_STATE__.simulationStep; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.kineticEnergy >= 0 && isFinite(window.__3D_STATE__.kineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxVelocityMagnitude <= window.__3D_STATE__.inflowVelocity * 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationStep >= window.__pausedStep",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameTimestamp === 'number' && window.__3D_STATE__.frameTimestamp > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dt === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pressureIterations === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "v"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.vizMode === 'velocity'",
            "tier": "L2"
