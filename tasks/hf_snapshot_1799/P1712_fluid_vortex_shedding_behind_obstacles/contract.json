            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.kineticEnergy) && !isNaN(window.__3D_STATE__.kineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalVorticity) && !isNaN(window.__3D_STATE__.totalVorticity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
