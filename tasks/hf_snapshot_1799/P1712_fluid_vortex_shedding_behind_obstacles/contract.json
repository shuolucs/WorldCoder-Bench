            "expr": "window.__3D_STATE__.kineticEnergy > 0 && isFinite(window.__3D_STATE__.kineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.energyHistory) && window.__3D_STATE__.energyHistory.length >= 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyHistory.every(e => typeof e === 'number' && isFinite(e) && !isNaN(e))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reynoldsNumber === (2.0 * 10) / 0.001",
            "tier": "L2"
          }
        ]
      }
