      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const sl = document.getElementById('slider-grain-freq'); sl.value = 20; sl.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.grainFrequency === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'slider'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency >= 2 && window.__3D_STATE__.grainFrequency <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('slider-grain-freq').value == '20'",
            "tier": "L2"
          }
        ]
      }
    },
