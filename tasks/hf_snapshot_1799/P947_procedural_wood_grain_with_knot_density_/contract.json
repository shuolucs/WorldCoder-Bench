  "states": [
    {
      "id": "S0",
      "name": "InitialDefaults",
      "conditions": [
        "window.__3D_STATE__.grainFrequency === 10",
        "window.__3D_STATE__.knotDensity === 3",
        "window.__3D_STATE__.knotSize === 0.3",
        "window.__3D_STATE__.noiseScale === 1.5",
        "window.__3D_STATE__.lastAction === 'init'",
        "window.__3D_STATE__.plankCount === 2"
      ]
    },
    {
      "id": "S1",
      "name": "GrainFrequencyModified",
      "conditions": [
        "window.__3D_STATE__.grainFrequency !== 10",
        "window.__3D_STATE__.lastAction === 'slider'"
      ]
    },
    {
      "id": "S2",
      "name": "KnotDensityModified",
      "conditions": [
        "window.__3D_STATE__.knotDensity !== 3",
        "window.__3D_STATE__.lastAction === 'slider'"
      ]
    },
    {
      "id": "S3",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.saveSlotOccupied === true",
        "window.__3D_STATE__.lastAction === 'save'"
      ]
    },
    {
      "id": "S4",
      "name": "StateAfterReset",
      "conditions": [
        "window.__3D_STATE__.grainFrequency === 10",
        "window.__3D_STATE__.knotDensity === 3",
        "window.__3D_STATE__.lastAction === 'reset'"
      ]
    },
    {
      "id": "S5",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'load'",
        "window.__3D_STATE__.saveSlotOccupied === true"
      ]
    },
    {
      "id": "S6",
      "name": "PresetFineOak",
      "conditions": [
        "window.__3D_STATE__.grainFrequency === 22",
        "window.__3D_STATE__.knotDensity === 1.5",
        "window.__3D_STATE__.lastAction === 'preset_fine_oak'"
      ]
    },
    {
      "id": "S7",
      "name": "PresetKnottyPine",
      "conditions": [
        "window.__3D_STATE__.knotDensity === 8",
        "window.__3D_STATE__.knotSize === 0.6",
        "window.__3D_STATE__.lastAction === 'preset_knotty_pine'"
      ]
    },
    {
      "id": "S8",
      "name": "KnotSizeAndNoiseModified",
      "conditions": [
        "window.__3D_STATE__.knotSize !== 0.3",
        "window.__3D_STATE__.noiseScale !== 1.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.plankCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 10 && window.__3D_STATE__.knotDensity === 3 && window.__3D_STATE__.knotSize === 0.3 && window.__3D_STATE__.noiseScale === 1.5",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.baseColor) && window.__3D_STATE__.baseColor.length === 3 && Math.abs(window.__3D_STATE__.baseColor[0] - 0.55) < 0.05",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.mainPlankPosition) && Math.abs(window.__3D_STATE__.mainPlankPosition[1]) < 0.01",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
