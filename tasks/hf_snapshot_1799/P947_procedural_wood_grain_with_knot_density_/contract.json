            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.knotDensity >= 0 && window.__3D_STATE__.knotDensity <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grainFrequency === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSynced === true",
            "tier": "L2"
          }
        ]
