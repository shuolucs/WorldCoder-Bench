{
  "task_id": "P502_multiplayer_volumetric_cloud_sculptor",
  "affordances": [
    {
      "id": "A1",
      "name": "CloudVolume",
      "type": "3d_object",
      "semantic": "10x10x10 grid of voxel spheres forming the sculptable cloud",
      "locator_hints": [
        "centered at (0,6,0)",
        "1000 voxels total"
      ]
    },
    {
      "id": "A2",
      "name": "FoxModel",
      "type": "3d_object",
      "semantic": "Fox.glb mascot model positioned at (-5, 0, 3)",
      "locator_hints": [
        "scaled to 0.05",
        "animated"
      ]
    },
    {
      "id": "A3",
      "name": "SimPlayer2Cursor",
      "type": "3d_object",
      "semantic": "Red glowing sphere representing simulated player 2",
      "locator_hints": [
        "red color",
        "moves within cloud volume"
      ]
    },
    {
      "id": "A4",
      "name": "SimPlayer3Cursor",
      "type": "3d_object",
      "semantic": "Green glowing sphere representing simulated player 3",
      "locator_hints": [
        "green color",
        "moves within cloud volume"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset cloud densities to initial noise pattern",
      "locator_hints": [
        "text contains 'Reset'"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleFoxButton",
      "type": "dom_element",
      "semantic": "Button to toggle fox animation play/pause",
      "locator_hints": [
        "text contains 'Fox' or 'Animation'"
      ]
    },
    {
      "id": "A7",
      "name": "HUDToolInfo",
      "type": "dom_element",
      "semantic": "Top-left HUD showing current tool, brush radius, visible voxels",
      "locator_hints": [
        "top-left corner"
      ]
    },
    {
      "id": "A8",
      "name": "HUDPlayerList",
      "type": "dom_element",
      "semantic": "Top-right HUD showing player list and sculpt counts",
      "locator_hints": [
        "top-right corner"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.totalVoxels === 1000",
        "window.__3D_STATE__.currentTool === 'add'"
      ]
    },
    {
      "id": "S1",
      "name": "Fox_Loaded_Scene_Ready",
      "conditions": [
        "window.__3D_STATE__.foxLoaded === true",
        "window.__3D_STATE__.foxAnimating === true",
        "window.__3D_STATE__.visibleVoxels > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Tool_Switched_To_Subtract",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'subtract'"
      ]
    },
    {
      "id": "S3",
      "name": "Tool_Switched_To_Smooth",
      "conditions": [
        "window.__3D_STATE__.currentTool === 'smooth'"
      ]
    },
    {
      "id": "S4",
      "name": "Brush_Radius_Changed",
      "conditions": [
        "window.__3D_STATE__.brushRadius !== 2.5"
      ]
    },
    {
      "id": "S5",
      "name": "Cloud_Sculpted_By_User",
      "conditions": [
        "window.__3D_STATE__.playerSculptCounts.player1 > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SimPlayers_Have_Sculpted",
      "conditions": [
        "window.__3D_STATE__.playerSculptCounts.player2 > 0 || window.__3D_STATE__.playerSculptCounts.player3 > 0"
      ]
    },
    {
      "id": "S7",
      "name": "Clouds_Reset",
      "conditions": [
        "window.__3D_STATE__.resetCount > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Fox_Animation_Toggled",
      "conditions": [
        "window.__3D_STATE__.foxAnimating === false"
      ]
    },
    {
      "id": "S9",
      "name": "Brush_At_Maximum",
      "conditions": [
        "window.__3D_STATE__.brushRadius === 5.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxPosition.x === -5 && window.__3D_STATE__.foxPosition.z === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxAnimating === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleVoxels > 100 && window.__3D_STATE__.visibleVoxels <= 1000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgDensity > 0 && !isNaN(window.__3D_STATE__.avgDensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'subtract'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVoxels === 1000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCenterY === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'smooth'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDensity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minDensity >= 0.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.dispatchEvent(new WheelEvent('wheel', {deltaY: -300, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.brushRadius > 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius % 0.5 === 0 || Math.abs(window.__3D_STATE__.brushRadius % 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTool === 'smooth'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.currentTool = 'add'; document.dispatchEvent(new KeyboardEvent('keydown', {key: '1'})); setTimeout(() => { const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const cx = rect.left + rect.width/2; const cy = rect.top + rect.height * 0.35; canvas.dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true})); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playerSculptCounts.player1 >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgDensity > 0 && !isNaN(window.__3D_STATE__.avgDensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDensity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minDensity >= 0.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 7000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playerSculptCounts.player2 >= 1 || window.__3D_STATE__.playerSculptCounts.player3 >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simPlayersActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgDensity > 0 && !isNaN(window.__3D_STATE__.avgDensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxDensity <= 1.0 && window.__3D_STATE__.minDensity >= 0.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleVoxels > 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgDensity > 0.2 && window.__3D_STATE__.avgDensity < 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVoxels === 1000",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgDensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "match_text": "Fox"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foxAnimating === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxPosition.x === -5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxPosition.y === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0; i<10; i++) { document.querySelector('canvas').dispatchEvent(new WheelEvent('wheel', {deltaY: -500, bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.brushRadius === 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 8 && window.__3D_STATE__.cameraDistance <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVoxels === 1000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTool === 'add'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brushRadius === 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foxLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 8 && window.__3D_STATE__.cameraDistance <= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalVoxels === 1000 && !isNaN(window.__3D_STATE__.avgDensity)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}