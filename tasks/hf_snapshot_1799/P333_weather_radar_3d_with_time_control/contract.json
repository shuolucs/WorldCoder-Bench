        "#nextBtn"
      ]
    },
    {
      "id": "A9",
      "name": "TimeLabel",
      "type": "dom_element",
      "semantic": "Label showing current time step",
      "locator_hints": [
        "#timeLabel"
      ]
    },
    {
      "id": "A10",
      "name": "LegendPanel",
      "type": "dom_element",
      "semantic": "Toggleable legend overlay showing color scale",
      "locator_hints": [
        "#legendPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.gridVisible === true",
        "window.__3D_STATE__.legendVisible === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "TimeAdvancedToStep3",
      "conditions": [
        "window.__3D_STATE__.currentTimeStep === 3"
      ]
    },
    {
      "id": "S3",
      "name": "PlaybackActive",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "PlaybackPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S5",
      "name": "LegendShown",
      "conditions": [
        "window.__3D_STATE__.legendVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "GridHidden",
      "conditions": [
        "window.__3D_STATE__.gridVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 0) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 60) < 1",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 80) < 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTimeStep !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.radarSweepAngle !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTimeStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 0",
            "tier": "L2"
          }
