{
  "task_id": "P399_solar_eclipse_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "Sun",
      "type": "3d_object",
      "semantic": "The star at center of the system, positioned at (-150,0,0)",
      "locator_hints": [
        "sphere radius 20",
        "yellow emissive"
      ]
    },
    {
      "id": "A2",
      "name": "Earth",
      "type": "3d_object",
      "semantic": "Planet at origin that the Moon orbits",
      "locator_hints": [
        "sphere radius 8",
        "blue-green"
      ]
    },
    {
      "id": "A3",
      "name": "Moon",
      "type": "3d_object",
      "semantic": "Orbiting body that causes eclipses",
      "locator_hints": [
        "sphere radius 3",
        "gray"
      ]
    },
    {
      "id": "A4",
      "name": "ShadowCone",
      "type": "3d_object",
      "semantic": "Visualization of the umbra shadow",
      "locator_hints": [
        "semi-transparent cone"
      ]
    },
    {
      "id": "A5",
      "name": "ObservationChair",
      "type": "3d_object",
      "semantic": "SheenChair.glb loaded on Earth surface",
      "locator_hints": [
        "GLTF model",
        "position near (0,8,0)"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedUpButton",
      "type": "dom_element",
      "semantic": "Increases simulation speed",
      "locator_hints": [
        "#speed-up",
        "button"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedDownButton",
      "type": "dom_element",
      "semantic": "Decreases simulation speed",
      "locator_hints": [
        "#speed-down",
        "button"
      ]
    },
    {
      "id": "A8",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Toggles pause state",
      "locator_hints": [
        "#pause-btn"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets simulation to initial state",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A10",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD displaying simulation data",
      "locator_hints": [
        "#info-panel"
      ]
    },
    {
      "id": "A11",
      "name": "EclipseStatusDisplay",
      "type": "dom_element",
      "semantic": "Shows current eclipse status text",
      "locator_hints": [
        "#eclipse-status"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.moonAngle === 0 || window.__3D_STATE__.moonAngle >= 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.eclipseStatus === 'none'",
        "window.__3D_STATE__.cameraView === 1"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "window.__3D_STATE__.moonAngle > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.timeScale === 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "TopDownView",
      "conditions": [
        "window.__3D_STATE__.cameraView === 2"
      ]
    },
    {
      "id": "S5",
      "name": "ShadowConeToggled",
      "conditions": [
        "window.__3D_STATE__.shadowConeVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "EclipseAligned",
      "conditions": [
        "window.__3D_STATE__.eclipseStatus !== 'none'",
        "window.__3D_STATE__.eclipsePercent > 0"
      ]
    },
    {
      "id": "S7",
      "name": "EarthSurfaceView",
      "conditions": [
        "window.__3D_STATE__.cameraView === 3"
      ]
    },
    {
      "id": "S8",
      "name": "LabelsToggled",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.moonAngle < 0.1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#speed-up"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('speed-display') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('speed-display').textContent.includes('2')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pause-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.isPaused = false; (function(){ var targetAngle = Math.PI; var event = new KeyboardEvent('keydown', {key: '1'}); document.dispatchEvent(event); })();"
      },
      "pre_action": {
        "type": "script",
        "code": "document.getElementById('pause-btn').click(); (function wait(){ if(window.__3D_STATE__.moonPosition.x > -25) { requestAnimationFrame(wait); } })();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S1",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "l"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S3",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#speed-down"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('speed-display') !== null",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}