      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addShapeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
