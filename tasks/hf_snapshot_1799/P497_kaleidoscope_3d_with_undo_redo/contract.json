{
  "task_id": "P497_kaleidoscope_3d_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "AddShapeButton",
      "type": "dom_element",
      "semantic": "Button to add a new random shape to the kaleidoscope",
      "locator_hints": [
        "#addShapeBtn"
      ]
    },
    {
      "id": "A2",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo the last shape addition",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A3",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo the last undone action",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to clear all shapes and reset history",
      "locator_hints": [
        "#clearBtn"
      ]
    },
    {
      "id": "A5",
      "name": "KaleidoscopeGroup",
      "type": "3d_object",
      "semantic": "The rotating group containing all kaleidoscope shapes",
      "locator_hints": [
        "scene.children group rotating on Z"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.seedCount === 0",
        "window.__3D_STATE__.totalMeshCount === 0",
        "window.__3D_STATE__.historyLength === 0",
        "window.__3D_STATE__.redoLength === 0"
      ]
    },
    {
      "id": "S1",
      "name": "One_Shape_Added",
      "conditions": [
        "window.__3D_STATE__.seedCount === 1",
        "window.__3D_STATE__.totalMeshCount === 6",
        "window.__3D_STATE__.historyLength === 1"
      ]
    },
    {
      "id": "S2",
      "name": "Two_Shapes_Added",
      "conditions": [
        "window.__3D_STATE__.seedCount === 2",
        "window.__3D_STATE__.totalMeshCount === 12",
        "window.__3D_STATE__.historyLength === 2"
      ]
    },
    {
      "id": "S3",
      "name": "One_Shape_After_Undo",
      "conditions": [
        "window.__3D_STATE__.seedCount === 1",
        "window.__3D_STATE__.totalMeshCount === 6",
        "window.__3D_STATE__.redoLength === 1"
      ]
    },
    {
      "id": "S4",
      "name": "Two_Shapes_After_Redo",
      "conditions": [
        "window.__3D_STATE__.seedCount === 2",
        "window.__3D_STATE__.totalMeshCount === 12",
        "window.__3D_STATE__.redoLength === 0"
      ]
    },
    {
      "id": "S5",
      "name": "Cleared",
      "conditions": [
        "window.__3D_STATE__.seedCount === 0",
        "window.__3D_STATE__.totalMeshCount === 0",
        "window.__3D_STATE__.historyLength === 0",
        "window.__3D_STATE__.redoLength === 0"
      ]
    }
  ],
  "transitions": [
