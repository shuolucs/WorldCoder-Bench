      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "PreStart",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.isAlive === true",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.isAlive === true",
        "window.__3D_STATE__.timeScale === 1.0"
      ]
    },
    {
      "id": "S2",
      "name": "Jumping",
      "conditions": [
        "window.__3D_STATE__.isGrounded === false",
        "window.__3D_STATE__.jumpCount >= 1",
        "window.__3D_STATE__.isAlive === true"
      ]
    },
    {
      "id": "S3",
      "name": "SlowMotionActive",
      "conditions": [
        "window.__3D_STATE__.isSlowMotion === true",
        "window.__3D_STATE__.timeScale === 0.25",
        "window.__3D_STATE__.isAlive === true"
      ]
    },
    {
      "id": "S4",
      "name": "TimeFrozen",
      "conditions": [
        "window.__3D_STATE__.isTimeFrozen === true",
        "window.__3D_STATE__.timeScale === 0.0"
      ]
    },
    {
      "id": "S5",
      "name": "Sliding",
      "conditions": [
        "window.__3D_STATE__.isSliding === true",
        "window.__3D_STATE__.isAlive === true"
      ]
    },
    {
      "id": "S6",
      "name": "LaneSwitched",
      "conditions": [
        "window.__3D_STATE__.currentLane !== 0",
        "window.__3D_STATE__.isAlive === true"
      ]
    },
    {
      "id": "S7",
      "name": "EnergyDepleted",
      "conditions": [
        "window.__3D_STATE__.timeEnergy <= 0",
        "window.__3D_STATE__.isSlowMotion === false"
      ]
    },
    {
      "id": "S8",
      "name": "Dead",
      "conditions": [
        "window.__3D_STATE__.isAlive === false"
      ]
    },
    {
      "id": "S9",
      "name": "Restarted",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.isAlive === true",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.distance < 1"
      ]
    }
  ],
