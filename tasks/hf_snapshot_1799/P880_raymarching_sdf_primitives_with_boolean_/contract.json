{
  "task_id": "P880_raymarching_sdf_primitives_with_boolean_",
  "affordances": [
    {
      "id": "A1",
      "name": "FullscreenQuad",
      "type": "3d_object",
      "semantic": "Fullscreen quad mesh with raymarching ShaderMaterial",
