  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.boolOperation === 'union'",
        "window.__3D_STATE__.boolOpIndex === 0",
        "window.__3D_STATE__.smoothK === 0.5",
        "window.__3D_STATE__.orbitAngle === 0",
        "window.__3D_STATE__.animating === true"
      ]
    },
    {
      "id": "S1",
      "name": "IntersectionMode",
      "conditions": [
        "window.__3D_STATE__.boolOperation === 'intersection'",
        "window.__3D_STATE__.boolOpIndex === 1"
      ]
    },
    {
      "id": "S2",
      "name": "SubtractionMode",
      "conditions": [
        "window.__3D_STATE__.boolOperation === 'subtraction'",
        "window.__3D_STATE__.boolOpIndex === 2"
      ]
    },
    {
      "id": "S3",
      "name": "SmoothUnionMode",
      "conditions": [
        "window.__3D_STATE__.boolOperation === 'smooth_union'",
        "window.__3D_STATE__.boolOpIndex === 3"
      ]
    },
    {
      "id": "S4",
      "name": "OrbitedRight",
      "conditions": [
        "Math.abs(window.__3D_STATE__.orbitAngle - 0.1) < 0.001"
      ]
    },
    {
      "id": "S5",
      "name": "SmoothKIncreased",
      "conditions": [
        "Math.abs(window.__3D_STATE__.smoothK - 0.55) < 0.001"
      ]
    },
    {
      "id": "S6",
      "name": "AnimationPaused",
      "conditions": [
        "window.__3D_STATE__.animating === false"
      ]
    },
    {
      "id": "S7",
      "name": "OrbitedLeft",
      "conditions": [
        "window.__3D_STATE__.orbitAngle < 0"
      ]
    },
    {
      "id": "S8",
      "name": "SmoothKDecreased",
      "conditions": [
        "window.__3D_STATE__.smoothK < 0.5"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.boolOperation === 'union'",
        "window.__3D_STATE__.orbitAngle === 0",
        "window.__3D_STATE__.smoothK === 0.5",
        "window.__3D_STATE__.animating === true"
      ]
    }
  ],
  "transitions": [
