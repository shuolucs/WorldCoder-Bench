      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rayMaxSteps === 128 && window.__3D_STATE__.rayMaxDist === 50.0 && window.__3D_STATE__.raySurfaceEpsilon === 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.primitiveCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.elapsedTime) && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sphereCenter === 'object' && typeof window.__3D_STATE__.boxCenter === 'object' && typeof window.__3D_STATE__.torusCenter === 'object' && typeof window.__3D_STATE__.cylinderCenter === 'object'",
            "tier": "L0"
