  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.selectedPart === 0",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
      "name": "PartSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPart >= 0 && window.__3D_STATE__.selectedPart <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "ColorApplied",
      "conditions": [
        "window.__3D_STATE__.partColors.some(c => c !== '#ffffff')"
      ]
    },
    {
      "id": "S3",
      "name": "MultipleColorsApplied",
      "conditions": [
        "window.__3D_STATE__.partColors.filter(c => c !== '#ffffff').length >= 2"
      ]
    },
    {
      "id": "S4",
      "name": "ConfigSaved",
      "conditions": [
        "window.__3D_STATE__.savedConfig !== null"
      ]
    },
    {
      "id": "S5",
      "name": "ColorsReset",
      "conditions": [
        "window.__3D_STATE__.partColors.every(c => c === '#ffffff')"
      ]
    },
    {
      "id": "S6",
      "name": "ConfigLoaded",
      "conditions": [
        "window.__3D_STATE__.partColors.some(c => c !== '#ffffff')"
      ]
    },
    {
      "id": "S7",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S8",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S9",
      "name": "FullCustomization",
      "conditions": [
        "window.__3D_STATE__.partColors.filter(c => c !== '#ffffff').length >= 3"
      ]
    }
  ],
