{
  "task_id": "P87_artifact_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ArtifactMesh",
      "type": "3d_object",
      "semantic": "当前文物模型",
      "locator_hints": [
        "lathe",
        "vase",
        "plate"
      ]
    },
    {
      "id": "A2",
      "name": "ArtifactSelect",
      "type": "dom_element",
      "semantic": "文物选择",
      "locator_hints": [
        "artifactSelect"
      ]
    },
    {
      "id": "A3",
      "name": "AutoRotate",
      "type": "dom_element",
      "semantic": "自动旋转",
      "locator_hints": [
        "autoRotate"
      ]
    },
    {
      "id": "A4",
      "name": "Hotspots",
      "type": "3d_object",
      "semantic": "红色标注点",
      "locator_hints": [
        "hotspot",
        "sprite"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "vase",
      "description": "默认花瓶"
    },
    {
      "id": "S1",
      "name": "plate",
      "description": "切换盘子"
    },
    {
      "id": "S2",
      "name": "figurine",
      "description": "切换雕像"
    },
    {
      "id": "S3",
      "name": "auto_on",
      "description": "自动旋转开"
    },
    {
      "id": "S4",
      "name": "auto_off",
      "description": "自动旋转关"
    },
    {
      "id": "S5",
      "name": "annotations_ok",
      "description": "5 个热点"
    },
    {
      "id": "S6",
      "name": "size_ok",
      "description": "artifactSize 有效"
    },
    {
      "id": "S7",
      "name": "stable",
      "description": "稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "初始状态"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentArtifact === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.annotationCount === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.autoRotate === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.measurements)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.artifactSize && isFinite(window.__3D_STATE__.artifactSize.w)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_input",
        "selector": "#artifactSelect",
        "value": "plate"
      },
      "postconditions": [
        "当前盘子"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentArtifact === 'plate' || window.__3D_STATE__.currentArtifact === 'Plate'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_input",
        "selector": "#artifactSelect",
        "value": "figurine"
      },
      "postconditions": [
        "雕像"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentArtifact === 'figurine' || window.__3D_STATE__.currentArtifact === 'Figurine'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_click",
        "selector": "#autoRotate"
      },
      "postconditions": [
        "autoRotate true"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_click",
        "selector": "#autoRotate"
      },
      "postconditions": [
        "autoRotate false"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "postconditions": [
        "selectedAnnotation 类型"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.annotationCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAnnotation === null || (typeof window.__3D_STATE__.selectedAnnotation === 'number' && window.__3D_STATE__.selectedAnnotation >= 0 && window.__3D_STATE__.selectedAnnotation < 5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "dom_input",
        "selector": "#artifactSelect",
        "value": "vase"
      },
      "postconditions": [
        "尺寸三维有效"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 600,
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.artifactSize.h) && isFinite(window.__3D_STATE__.artifactSize.d)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "measurements 为数组"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.measurements)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.annotationCount === 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}