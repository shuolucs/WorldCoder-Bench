        "wave details popup"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.emitting === false",
        "window.__3D_STATE__.frequency === 3",
        "window.__3D_STATE__.amplitude === 1.0",
        "window.__3D_STATE__.activeWaves === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "EmissionStarted",
      "conditions": [
        "window.__3D_STATE__.emitting === true",
        "window.__3D_STATE__.activeWaves >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "FrequencyIncreased",
      "conditions": [
        "window.__3D_STATE__.frequency === 3.5",
        "window.__3D_STATE__.emitting === true"
      ]
    },
    {
      "id": "S3",
      "name": "AmplitudeDecreased",
      "conditions": [
        "window.__3D_STATE__.amplitude === 0.9",
        "window.__3D_STATE__.energy === Math.round(0.9*0.9*3.5*100)/100"
      ]
    },
    {
      "id": "S4",
      "name": "WavesPropagating",
      "conditions": [
        "window.__3D_STATE__.activeWaves >= 3",
        "window.__3D_STATE__.oldestWaveRadius > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "MediumModeNone",
      "conditions": [
        "window.__3D_STATE__.mediumMode === 'none'"
      ]
    },
    {
      "id": "S7",
      "name": "MediumModeActive",
      "conditions": [
        "window.__3D_STATE__.mediumMode === 'active'"
      ]
    },
    {
      "id": "S8",
      "name": "Zone1Toggled",
      "conditions": [
        "window.__3D_STATE__.zone1Visible === false"
      ]
    },
    {
      "id": "S9",
      "name": "HighFrequencyHighAmplitude",
      "conditions": [
        "window.__3D_STATE__.frequency >= 8",
        "window.__3D_STATE__.amplitude >= 1.8"
      ]
    },
    {
      "id": "S10",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.activeWaves === 0",
        "window.__3D_STATE__.totalWavesEmitted === 0",
        "window.__3D_STATE__.frequency === 3",
        "window.__3D_STATE__.amplitude === 1.0",
        "window.__3D_STATE__.emitting === false"
      ]
    },
    {
      "id": "S11",
      "name": "ResumedAfterReset",
      "conditions": [
        "window.__3D_STATE__.emitting === true",
        "window.__3D_STATE__.activeWaves >= 1",
        "window.__3D_STATE__.frequency === 3",
        "window.__3D_STATE__.amplitude === 1.0"
      ]
    }
  ],
