          {
            "expr": "typeof window.__3D_STATE__.failureOverlay === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.propagationMode === 'animated'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.membersAtRisk === 'number' && !isNaN(window.__3D_STATE__.membersAtRisk)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
