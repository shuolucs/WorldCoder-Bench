      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.memberCount === 'number' && window.__3D_STATE__.memberCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.members.length === window.__3D_STATE__.memberCount",
            "tier": "L2"
