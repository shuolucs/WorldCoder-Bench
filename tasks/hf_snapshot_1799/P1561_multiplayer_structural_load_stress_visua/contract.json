  "states": [
    {
      "id": "S0",
      "name": "InitialUnloaded",
      "conditions": [
        "window.__3D_STATE__.totalLoad === 0",
        "window.__3D_STATE__.structuralIntegrity === 100",
        "window.__3D_STATE__.membersAtRisk === 0",
        "window.__3D_STATE__.propagationMode === 'instant'",
        "window.__3D_STATE__.failureOverlay === false",
        "window.__3D_STATE__.earthquakeApplied === false"
      ]
    },
    {
      "id": "S1",
      "name": "SingleLoadPlaced",
      "conditions": [
        "window.__3D_STATE__.totalLoad > 0",
        "window.__3D_STATE__.structuralIntegrity < 100"
      ]
    },
    {
      "id": "S2",
      "name": "PropagationAnimated",
      "conditions": [
        "window.__3D_STATE__.propagationMode === 'animated'"
      ]
    },
    {
      "id": "S3",
      "name": "FailureOverlayActive",
      "conditions": [
        "window.__3D_STATE__.failureOverlay === true"
      ]
    },
    {
      "id": "S4",
      "name": "EarthquakeApplied",
      "conditions": [
        "window.__3D_STATE__.earthquakeApplied === true",
        "window.__3D_STATE__.totalLoad > 0"
      ]
    },
    {
      "id": "S5",
      "name": "HighStressState",
      "conditions": [
        "window.__3D_STATE__.membersAtRisk > 0",
        "window.__3D_STATE__.maxStressRatio > 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "PlayerVisibilityToggled",
      "conditions": [
        "window.__3D_STATE__.players.some(p => p.visible === false)"
      ]
    },
    {
      "id": "S7",
      "name": "AllLoadsReset",
      "conditions": [
        "window.__3D_STATE__.totalLoad === 0",
        "window.__3D_STATE__.structuralIntegrity === 100",
        "window.__3D_STATE__.membersAtRisk === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.structuralIntegrity === 'number' && window.__3D_STATE__.structuralIntegrity === 100",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalLoad === 'number' && window.__3D_STATE__.totalLoad === 0",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.members) && window.__3D_STATE__.members.length > 0",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.players) && window.__3D_STATE__.players.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => typeof m.stressRatio === 'number' && !isNaN(m.stressRatio) && m.stressRatio === 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__PRE_LOAD = window.__3D_STATE__.totalLoad; const beams = window.__3D_STATE__.members.filter(m => m.type === 'beam'); if(beams.length > 0) { const targetBeam = beams[0].id; if(typeof window.__placeLoad === 'function') { window.__placeLoad('Player1', targetBeam, 100); } }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLoad === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.currentLoad > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.players[0].loadCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction.includes('Player1')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.floorLoads.reduce((a,b) => a+b, 0) === window.__3D_STATE__.totalLoad",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__PRE_INTEGRITY = window.__3D_STATE__.structuralIntegrity; window.__PRE_TOTAL = window.__3D_STATE__.totalLoad; const beams = window.__3D_STATE__.members.filter(m => m.type === 'beam' && m.currentLoad === 0); if(beams.length > 0 && typeof window.__placeLoad === 'function') { window.__placeLoad('Player1', beams[0].id, 100); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLoad === window.__PRE_TOTAL + 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < window.__PRE_INTEGRITY",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.players[0].loadCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.filter(m => m.currentLoad > 0).length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => !isNaN(m.stressRatio) && m.stressRatio >= 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.propagationMode === 'animated'",
