      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const beams = window.__3D_STATE__.members.filter(m => m.type === 'beam'); if(beams.length > 0 && typeof window.__placeLoad === 'function') { for(let i = 0; i < Math.min(4, beams.length); i++) { window.__placeLoad('Player2', beams[i].id, 200); } }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxStressRatio > 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.membersAtRisk > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity < 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.some(m => m.stressRatio > 0.8)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.members.every(m => typeof m.stressRatio === 'number' && !isNaN(m.stressRatio) && m.stressRatio >= 0)",
            "tier": "L2"
          }
