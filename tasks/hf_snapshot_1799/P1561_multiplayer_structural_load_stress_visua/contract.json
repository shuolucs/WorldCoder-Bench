          },
          {
            "expr": "typeof window.__3D_STATE__.propagationMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalLoad > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.structuralIntegrity === window.__3D_STATE__.structuralIntegrity",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
