  "states": [
    {
      "id": "S0",
      "name": "SceneReady",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.basePairCount === 10",
        "window.__3D_STATE__.unzipProgress === 0"
      ]
    },
    {
      "id": "S1",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.rotationPaused === true"
      ]
    },
    {
      "id": "S2",
      "name": "RotationResumed",
      "conditions": [
        "window.__3D_STATE__.rotationPaused === false"
      ]
    },
    {
      "id": "S3",
      "name": "UnzipInProgress",
      "conditions": [
        "window.__3D_STATE__.isUnzipping === true"
      ]
    },
    {
      "id": "S4",
      "name": "FullyUnzipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 10",
        "window.__3D_STATE__.isFullyUnzipped === true",
        "window.__3D_STATE__.isUnzipping === false"
      ]
    },
    {
      "id": "S5",
      "name": "RezipInProgress",
      "conditions": [
        "window.__3D_STATE__.isRezipping === true"
      ]
    },
    {
      "id": "S6",
      "name": "FullyRezipped",
      "conditions": [
        "window.__3D_STATE__.unzipProgress === 0",
        "window.__3D_STATE__.isFullyUnzipped === false",
        "window.__3D_STATE__.isRezipping === false"
      ]
    },
    {
      "id": "S7",
      "name": "HighlightModeOn",
      "conditions": [
        "window.__3D_STATE__.highlightMode === true"
      ]
    },
    {
      "id": "S8",
      "name": "LabelsVisible",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === true"
      ]
    }
  ],
