{
  "task_id": "P302_protein_folding_viewer_with_save_load_st",
  "affordances": [
    {
      "id": "A1",
      "name": "ProteinChain",
      "type": "3d_object",
      "semantic": "Chain of 20 amino acid residue spheres connected by bonds",
      "locator_hints": [
        "spheres with radius 0.5",
        "colored red/blue/green"
      ]
    },
    {
      "id": "A2",
      "name": "FoldButton",
      "type": "dom_element",
      "semantic": "Button to trigger protein folding animation",
      "locator_hints": [
        "#foldBtn"
      ]
    },
    {
      "id": "A3",
      "name": "UnfoldButton",
      "type": "dom_element",
      "semantic": "Button to unfold protein back to straight line",
      "locator_hints": [
        "#unfoldBtn"
      ]
    },
    {
      "id": "A4",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state to localStorage",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A5",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load saved state from localStorage",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset protein to initial configuration",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected residue information",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A8",
      "name": "EnergyDisplay",
      "type": "dom_element",
      "semantic": "Display showing current energy score",
      "locator_hints": [
        "#energyDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "ResidueCountLabel",
      "type": "dom_element",
      "semantic": "Label showing total residue count",
      "locator_hints": [
        "#residueCount"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialUnfolded",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'unfolded'",
        "window.__3D_STATE__.residueCount === 20",
        "window.__3D_STATE__.selectedResidue === null",
        "window.__3D_STATE__.hydrophobicVisible === true",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
      "name": "Folded",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folded'"
      ]
    },
    {
      "id": "S2",
      "name": "ResidueSelected",
      "conditions": [
        "window.__3D_STATE__.selectedResidue !== null",
        "typeof window.__3D_STATE__.selectedResidue === 'number'"
      ]
    },
    {
      "id": "S3",
      "name": "HydrophobicHidden",
      "conditions": [
        "window.__3D_STATE__.hydrophobicVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedState !== null",
        "window.__3D_STATE__.savedState.positions !== undefined"
      ]
    },
    {
      "id": "S6",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'folded' || window.__3D_STATE__.foldingState === 'unfolded'"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToInitial",
      "conditions": [
        "window.__3D_STATE__.foldingState === 'unfolded'",
        "Math.abs(window.__3D_STATE__.residuePositions[0].x - (-19)) < 0.5"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingState === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - (-19)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[19].x - 19) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[0] === 'hydrophobic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[1] === 'hydrophilic'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes[2] === 'neutral'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.energy) && window.__3D_STATE__.energy > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#foldBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'folded'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - 3*Math.cos(0)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].y - (-8)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].z - 3*Math.sin(0)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energy > 0 && !isNaN(window.__3D_STATE__.energy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#saveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.savedState !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedState.positions !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.savedState.positions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.savedState.foldingState === 'folded'",
            "tier": "L2"
          },
          {
            "expr": "localStorage.getItem('proteinState') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 1500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - (-19)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[10].x - 1) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[19].x - 19) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S7",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#loadBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 1500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'folded'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - 3*Math.cos(0)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[5].y - (5*0.8 - 8)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S6",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.hydrophobicVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueTypes.filter(t => t === 'hydrophobic').length === 7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hydrophobicVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingState === 'folded'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S1",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#unfoldBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "wait_ms": 2500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingState === 'unfolded'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - (-19)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[19].x - 19) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.every(p => Math.abs(p.y) < 0.5 && Math.abs(p.z) < 0.5)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}