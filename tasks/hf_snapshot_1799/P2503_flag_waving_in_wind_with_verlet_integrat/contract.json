{
  "task_id": "P2503_flag_waving_in_wind_with_verlet_integrat",
  "affordances": [
    {
      "id": "A1",
      "name": "ClothMesh",
      "type": "3d_object",
      "semantic": "The flag cloth rendered as a deformable mesh driven by Verlet particles",
      "locator_hints": [
        "scene mesh with red material",
        "PlaneGeometry-based mesh"
      ]
    },
    {
      "id": "A2",
      "name": "Flagpole",
      "type": "3d_object",
      "semantic": "Vertical cylinder representing the flagpole",
      "locator_hints": [
        "CylinderGeometry mesh at x=-3"
      ]
    },
    {
      "id": "A3",
      "name": "WindSlider",
      "type": "dom_element",
      "semantic": "Range input controlling wind strength multiplier",
      "locator_hints": [
        "#windSlider"
      ]
    },
    {
      "id": "A4",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume the simulation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset cloth to initial flat state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A6",
      "name": "GravityButton",
      "type": "dom_element",
      "semantic": "Button to toggle gravity on/off",
      "locator_hints": [
        "#gravityBtn"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 500",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.windStrength === 1.0",
        "window.__3D_STATE__.simStep === 0 || window.__3D_STATE__.simStep > 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simStep > 0",
        "window.__3D_STATE__.maxParticleDisplacement > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "WindAdjusted",
      "conditions": [
        "window.__3D_STATE__.windStrength !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "WindRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.windDirection.z - 1.5) > 0.1 || Math.abs(window.__3D_STATE__.windDirection.x - 2.0) > 0.1"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.maxParticleDisplacement < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "HighWind",
      "conditions": [
        "window.__3D_STATE__.windStrength >= 2.5"
      ]
    },
    {
      "id": "S8",
      "name": "ZeroWind",
      "conditions": [
        "window.__3D_STATE__.windStrength === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount === 500",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particlePositions !== 'undefined' && window.__3D_STATE__.particlePositions.length === 1500",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simStep > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxParticleDisplacement > 0.05",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleY) && window.__3D_STATE__.avgParticleY > 0 && window.__3D_STATE__.avgParticleY < 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pinnedCount === 20",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.trim().toLowerCase().includes('resume')",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('simState').textContent.trim() === 'Paused'",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.simStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyEstimate !== undefined && !isNaN(window.__3D_STATE__.energyEstimate)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.trim().toLowerCase().includes('pause')",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('simState').textContent.trim() === 'Running'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simStep > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('windSlider').value = '2.0'; document.getElementById('windSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windStrength - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('windSlider').value === '2'",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('windValue').textContent.includes('2')",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('windDisplay').textContent.includes('2')",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.constraintIterations === 5",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#gravityBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('gravityBtn').textContent.includes('OFF')",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('gravityDisplay').textContent.trim() === 'OFF'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.dampingFactor === 0.99",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dt - 0.016) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windDirection.x - 2.0) > 0.05 || Math.abs(window.__3D_STATE__.windDirection.z - 1.5) > 0.05",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windDirection.x === 'number' && !isNaN(window.__3D_STATE__.windDirection.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.windDirection.z === 'number' && !isNaN(window.__3D_STATE__.windDirection.z)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.windDirection.y) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.sqrt(window.__3D_STATE__.windDirection.x**2 + window.__3D_STATE__.windDirection.z**2) > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxParticleDisplacement < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pinnedCount === 20",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === 1500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleY)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyEstimate < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('windSlider').value = '3.0'; document.getElementById('windSlider').dispatchEvent(new Event('input', {bubbles:true})); return new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windStrength - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxParticleDisplacement > 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.energyEstimate) && window.__3D_STATE__.energyEstimate < 100000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgParticleY > -10 && window.__3D_STATE__.avgParticleY < 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every((v, i) => !isNaN(v)) || (() => { for(let i=0;i<window.__3D_STATE__.particlePositions.length;i++){if(isNaN(window.__3D_STATE__.particlePositions[i]))return false;} return true; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('windSlider').value = '0'; document.getElementById('windSlider').dispatchEvent(new Event('input', {bubbles:true})); return new Promise(r => setTimeout(r, 1500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windStrength === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cols === 25 && window.__3D_STATE__.rows === 20",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.restLengthH - 4.0/24) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.restLengthV - 2.5/19) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flagpoleHeight === 5",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxParticleDisplacement < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.pinnedCount === 20",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.clothWidth === 4.0 && window.__3D_STATE__.clothHeight === 2.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgParticleY) && window.__3D_STATE__.avgParticleY > 2.0 && window.__3D_STATE__.avgParticleY < 4.5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}