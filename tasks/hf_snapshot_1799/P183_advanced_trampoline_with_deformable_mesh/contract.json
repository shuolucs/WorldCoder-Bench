    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "InitialDrop",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.ferrariPosition.y > 2.5",
        "window.__3D_STATE__.bounceCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "FirstBounce",
      "conditions": [
        "window.__3D_STATE__.bounceCount === 1",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S3",
      "name": "TrampolineDeformed",
      "conditions": [
        "window.__3D_STATE__.trampolineDeformation > 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "PostBounceAscent",
      "conditions": [
        "window.__3D_STATE__.ferrariVelocity.y > 0",
        "window.__3D_STATE__.bounceCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "MultipleBounces",
      "conditions": [
        "window.__3D_STATE__.bounceCount >= 3",
        "window.__3D_STATE__.combo >= 2"
      ]
    },
    {
      "id": "S6",
      "name": "SpaceLaunch",
      "conditions": [
        "window.__3D_STATE__.ferrariVelocity.y > 5",
        "window.__3D_STATE__.ferrariPosition.y > 3"
      ]
    },
    {
      "id": "S7",
      "name": "HorizontalMovement",
      "conditions": [
        "Math.abs(window.__3D_STATE__.ferrariVelocity.x) > 0.1 || Math.abs(window.__3D_STATE__.ferrariVelocity.z) > 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "GravityModified",
      "conditions": [
        "window.__3D_STATE__.gravity !== 9.81"
      ]
    },
    {
      "id": "S9",
      "name": "HighCombo",
      "conditions": [
        "window.__3D_STATE__.combo >= 5"
      ]
    },
    {
      "id": "S10",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.bounceCount === 0",
        "window.__3D_STATE__.ferrariPosition.y >= 11"
      ]
    },
    {
      "id": "S11",
      "name": "EnergyDecay",
      "conditions": [
        "window.__3D_STATE__.totalEnergy >= 0",
        "window.__3D_STATE__.totalEnergy < 200"
      ]
