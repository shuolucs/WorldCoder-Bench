{
  "task_id": "P209_bowling_game",
  "affordances": [
    {
      "id": "A1",
      "name": "BowlingBall",
      "type": "3d_object",
      "semantic": "The bowling ball sphere that the player launches",
      "locator_hints": [
        "sphere mesh",
        "radius 0.5",
        "color #222244"
      ]
    },
    {
      "id": "A2",
      "name": "LanternPins",
      "type": "3d_object",
      "semantic": "10 lantern-shaped bowling pins in triangular formation",
      "locator_hints": [
        "Lantern.glb clones",
        "triangle formation at z=-25 to z=-29.5"
      ]
    },
    {
      "id": "A3",
      "name": "BowlingLane",
      "type": "3d_object",
      "semantic": "The wooden bowling lane surface",
      "locator_hints": [
        "box geometry",
        "width 4, length 40"
      ]
    },
    {
      "id": "A4",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD score counter",
      "locator_hints": [
        "#score-display"
      ]
    },
    {
      "id": "A5",
      "name": "PhaseDisplay",
      "type": "dom_element",
      "semantic": "HUD phase indicator",
      "locator_hints": [
        "#phase-display"
      ]
    },
    {
      "id": "A6",
      "name": "PowerBar",
      "type": "dom_element",
      "semantic": "Power charge bar",
      "locator_hints": [
        "#power-bar"
      ]
    },
    {
      "id": "A7",
      "name": "Instructions",
      "type": "dom_element",
      "semantic": "Control instructions text",
      "locator_hints": [
        "#instructions"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Aiming",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.pinsDown === 0",
        "window.__3D_STATE__.launched === false",
        "window.__3D_STATE__.totalPins === 10"
      ]
    },
    {
      "id": "S1",
      "name": "Aim_Adjusted_Left",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.ballAimX < 0"
      ]
    },
    {
      "id": "S2",
      "name": "Aim_Adjusted_Right",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.ballAimX > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Power_Charging",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.power > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Ball_Rolling",
      "conditions": [
        "window.__3D_STATE__.phase === 'rolling'",
        "window.__3D_STATE__.launched === true"
      ]
    },
    {
      "id": "S5",
      "name": "Pins_Knocked",
      "conditions": [
        "window.__3D_STATE__.phase === 'rolling'",
        "window.__3D_STATE__.pinsDown > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Finished",
      "conditions": [
        "window.__3D_STATE__.phase === 'finished'"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Reset",
      "conditions": [
        "window.__3D_STATE__.phase === 'aiming'",
        "window.__3D_STATE__.resetCount > 0",
        "window.__3D_STATE__.pinsDown === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "duration": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'aiming'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballPosition.z > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "duration": 1200
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'aiming'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " ",
        "event": "keydown",
        "duration": 800
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'aiming'",
            "tier": "L2"
          }
        ]
      }
    },
    {
