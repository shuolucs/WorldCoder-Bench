        "duration": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'finished'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('phase-display') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
