      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition.z < 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ballPosition.x) && !isNaN(window.__3D_STATE__.ballPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
