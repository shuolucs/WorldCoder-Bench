{
  "task_id": "P291_weather_radar_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "RadarSweep",
      "type": "3d_object",
      "semantic": "Rotating radar sweep line on the ground plane",
      "locator_hints": [
        "sweep",
        "pie slice mesh rotating around Y-axis"
      ]
    },
    {
      "id": "A2",
      "name": "Layer0Group",
      "type": "3d_object",
      "semantic": "Low altitude precipitation layer at y=5",
      "locator_hints": [
        "layer0",
        "green-yellow boxes"
      ]
    },
    {
      "id": "A3",
      "name": "Layer1Group",
      "type": "3d_object",
      "semantic": "Mid altitude precipitation layer at y=15",
      "locator_hints": [
        "layer1",
        "yellow-orange boxes"
      ]
    },
    {
      "id": "A4",
      "name": "Layer2Group",
      "type": "3d_object",
      "semantic": "High altitude precipitation layer at y=25",
      "locator_hints": [
        "layer2",
        "orange-red boxes"
      ]
    },
    {
      "id": "A5",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD overlay panel",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A6",
      "name": "ModeDisplay",
      "type": "dom_element",
      "semantic": "Current radar mode text display",
      "locator_hints": [
        "#mode-display"
      ]
    },
    {
      "id": "A7",
      "name": "LayerCountDisplay",
      "type": "dom_element",
      "semantic": "Active layer count display",
      "locator_hints": [
        "#layer-count"
      ]
    },
    {
      "id": "A8",
      "name": "SweepAngleDisplay",
      "type": "dom_element",
      "semantic": "Real-time sweep angle display",
      "locator_hints": [
        "#sweep-angle"
      ]
    },
    {
      "id": "A9",
      "name": "BtnLayer0",
      "type": "dom_element",
      "semantic": "Toggle button for low altitude layer",
      "locator_hints": [
        "#btn-layer0"
      ]
    },
    {
      "id": "A10",
      "name": "BtnLayer1",
      "type": "dom_element",
      "semantic": "Toggle button for mid altitude layer",
      "locator_hints": [
        "#btn-layer1"
      ]
    },
    {
      "id": "A11",
      "name": "BtnLayer2",
      "type": "dom_element",
      "semantic": "Toggle button for high altitude layer",
      "locator_hints": [
        "#btn-layer2"
      ]
    },
    {
      "id": "A12",
      "name": "BtnMode",
      "type": "dom_element",
      "semantic": "Cycle mode button",
      "locator_hints": [
        "#btn-mode"
      ]
    },
    {
      "id": "A13",
      "name": "BtnPause",
      "type": "dom_element",
      "semantic": "Pause/Resume button",
      "locator_hints": [
        "#btn-pause"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'Reflectivity'",
        "window.__3D_STATE__.modeIndex === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.activeLayerCount === 3",
        "window.__3D_STATE__.layerVisible[0] === true && window.__3D_STATE__.layerVisible[1] === true && window.__3D_STATE__.layerVisible[2] === true"
      ]
    },
    {
      "id": "S1",
      "name": "Layer2Hidden",
      "conditions": [
        "window.__3D_STATE__.layerVisible[2] === false",
        "window.__3D_STATE__.activeLayerCount === 2"
      ]
    },
    {
      "id": "S2",
      "name": "Layer1AlsoHidden",
      "conditions": [
        "window.__3D_STATE__.layerVisible[1] === false",
        "window.__3D_STATE__.layerVisible[2] === false",
        "window.__3D_STATE__.activeLayerCount === 1"
      ]
    },
    {
      "id": "S3",
      "name": "VelocityMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'Velocity'",
        "window.__3D_STATE__.modeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "CompositeMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'Composite'",
        "window.__3D_STATE__.modeIndex === 2"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S7",
      "name": "AllLayersRestored",
      "conditions": [
        "window.__3D_STATE__.layerVisible[0] === true && window.__3D_STATE__.layerVisible[1] === true && window.__3D_STATE__.layerVisible[2] === true",
        "window.__3D_STATE__.activeLayerCount === 3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__.layerHeights) === JSON.stringify([5, 15, 25])",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-layer2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-mode"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('mode-display').textContent.includes('Velocity')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('mode-display').textContent.includes('Composite')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('btn-pause').textContent.trim() === 'Resume'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('btn-pause').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-layer1').click(); document.getElementById('btn-layer2').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('layer-count').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}