{
  "task_id": "P312_protein_folding_viewer_with_save_load_st",
  "affordances": [
    {
      "id": "A1",
      "name": "FoldButton",
      "type": "dom_element",
      "semantic": "Button to trigger protein folding animation",
      "locator_hints": [
        "#foldBtn"
      ]
    },
    {
      "id": "A2",
      "name": "UnfoldButton",
      "type": "dom_element",
      "semantic": "Button to trigger protein unfolding animation",
      "locator_hints": [
        "#unfoldBtn"
      ]
    },
    {
      "id": "A3",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save current state",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A4",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load saved state",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling animation speed",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A6",
      "name": "ResidueChain",
      "type": "3d_object",
      "semantic": "Array of 20 amino acid residue spheres",
      "locator_hints": [
        "residues array"
      ]
    },
    {
      "id": "A7",
      "name": "BondConnectors",
      "type": "3d_object",
      "semantic": "19 bond cylinders connecting residues",
      "locator_hints": [
        "bonds array"
      ]
    },
    {
      "id": "A8",
      "name": "FishModel",
      "type": "3d_object",
      "semantic": "Barramundi fish GLB model as reference organism",
      "locator_hints": [
        "fish model at (8,-2,0)"
      ]
    },
    {
      "id": "A9",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js render canvas for raycasting clicks",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Unfolded",
      "conditions": [
        "window.__3D_STATE__.foldingProgress === 0",
        "window.__3D_STATE__.residueCount === 20",
        "window.__3D_STATE__.viewMode === 'normal'",
        "window.__3D_STATE__.selectedResidueIndex === -1",
        "window.__3D_STATE__.saveCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Folding_In_Progress",
      "conditions": [
        "window.__3D_STATE__.isFolding === true",
        "window.__3D_STATE__.foldingProgress > 0 && window.__3D_STATE__.foldingProgress < 1"
      ]
    },
    {
      "id": "S2",
      "name": "Fully_Folded",
      "conditions": [
        "window.__3D_STATE__.foldingProgress === 1",
        "window.__3D_STATE__.isFolding === false"
      ]
    },
    {
      "id": "S3",
      "name": "State_Saved_Folded",
      "conditions": [
        "window.__3D_STATE__.saveCount >= 1",
        "window.__3D_STATE__.savedState !== null"
      ]
    },
    {
      "id": "S4",
      "name": "Unfolding_In_Progress",
      "conditions": [
        "window.__3D_STATE__.isUnfolding === true",
        "window.__3D_STATE__.foldingProgress > 0 && window.__3D_STATE__.foldingProgress < 1"
      ]
    },
    {
      "id": "S5",
      "name": "Fully_Unfolded_Again",
      "conditions": [
        "window.__3D_STATE__.foldingProgress === 0",
        "window.__3D_STATE__.isUnfolding === false"
      ]
    },
    {
      "id": "S6",
      "name": "State_Loaded_Folded",
      "conditions": [
        "window.__3D_STATE__.loadCount >= 1",
        "window.__3D_STATE__.foldingProgress === 1"
      ]
    },
    {
      "id": "S7",
      "name": "Residue_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedResidueIndex >= 0 && window.__3D_STATE__.selectedResidueIndex <= 19"
      ]
    },
    {
      "id": "S8",
      "name": "Wireframe_Mode",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'wireframe'"
      ]
    },
    {
      "id": "S9",
      "name": "Spacefill_Mode",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'spacefill'"
      ]
    },
    {
      "id": "S10",
      "name": "Fish_Hidden",
      "conditions": [
        "window.__3D_STATE__.fishVisible === false"
      ]
    },
    {
      "id": "S11",
      "name": "Speed_Adjusted",
      "conditions": [
        "window.__3D_STATE__.animationSpeed !== 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#foldBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isFolding === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingProgress > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.residuePositions[0].x) && !isNaN(window.__3D_STATE__.residuePositions[0].y) && !isNaN(window.__3D_STATE__.residuePositions[0].z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 19",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingProgress === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isFolding === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - 2*Math.cos(0)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].y - (0*0.35 - 3.5)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[10].x - 2*Math.cos(10*100*Math.PI/180)) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#saveBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.saveCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.savedState !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.savedState === 'string'",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.savedState).foldingProgress === 1",
            "tier": "L2"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.savedState).residuePositions.length === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#unfoldBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isUnfolding === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingProgress < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energy !== undefined && !isNaN(window.__3D_STATE__.energy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foldingProgress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isUnfolding === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - (-9.5)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[19].x - 9.5) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[10].y) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#loadBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.loadCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingProgress === 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[0].x - 2*Math.cos(0)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.residuePositions[5].y - (5*0.35 - 3.5)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energy <= 0 || window.__3D_STATE__.energy === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedResidueIndex = 5; document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: 400, clientY: 300}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedResidueIndex >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedResidueIndex <= 19",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewMode === 'wireframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingProgress === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residuePositions.every(p => !isNaN(p.x))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewMode === 'spacefill'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 19",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldingProgress === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fishVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewMode === 'spacefill'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.saveCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S11",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.0; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.animationSpeed === 2.0 || Math.abs(window.__3D_STATE__.animationSpeed - 2.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fishVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.viewMode === 'spacefill'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.loadCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S11",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 1.0; document.getElementById('speedSlider').dispatchEvent(new Event('input')); window.dispatchEvent(new KeyboardEvent('keydown', {key: '1'})); window.dispatchEvent(new KeyboardEvent('keydown', {key: 'f'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.viewMode === 'normal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fishVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationSpeed === 1.0 || Math.abs(window.__3D_STATE__.animationSpeed - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraPosition !== undefined && !isNaN(window.__3D_STATE__.cameraPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.residueCount === 20",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}