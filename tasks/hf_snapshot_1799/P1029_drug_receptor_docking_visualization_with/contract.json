          },
          {
            "expr": "window.__3D_STATE__.forceVectors.every(function(v){ return typeof v.magnitude === 'number' && !isNaN(v.magnitude); })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.forceVectors.every(function(v){ return typeof v.attractive === 'boolean'; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.forceVectors.every(function(v){ return v.magnitude >= 0.0 && v.magnitude <= 200; })",
            "tier": "L2"
          }
        ]
