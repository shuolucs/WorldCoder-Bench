            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'MANUAL'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moveHistory.length <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ligandRotationY === 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
