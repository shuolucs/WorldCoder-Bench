      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
