          },
          {
            "expr": "typeof window.__3D_STATE__.autoDockConverged === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#mode-indicator') !== null",
            "tier": "L0"
          }
        ]
