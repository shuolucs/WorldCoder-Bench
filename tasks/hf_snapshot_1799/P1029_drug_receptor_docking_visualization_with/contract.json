          {
            "expr": "window.__3D_STATE__.ligandPosition.x === 0 && window.__3D_STATE__.ligandPosition.y === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moveHistory.length >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dockingDistance < 8.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.vanDerWaals) && !isNaN(window.__3D_STATE__.electrostatic)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
