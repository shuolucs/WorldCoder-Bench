          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ligandPosition.x) <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'MANUAL'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.dockingDistance) && window.__3D_STATE__.dockingDistance > 0",
