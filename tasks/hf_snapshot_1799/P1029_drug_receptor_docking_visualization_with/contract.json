  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'MANUAL'",
        "window.__3D_STATE__.ligandPosition.z === 8",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.gridVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "LigandMovedManually",
      "conditions": [
        "window.__3D_STATE__.mode === 'MANUAL'",
        "window.__3D_STATE__.ligandPosition.z < 8",
        "window.__3D_STATE__.moveHistory.length > 1"
      ]
    },
    {
      "id": "S2",
      "name": "LigandMovedMultiAxis",
      "conditions": [
        "window.__3D_STATE__.mode === 'MANUAL'",
        "window.__3D_STATE__.ligandPosition.x !== 0 || window.__3D_STATE__.ligandPosition.y !== 0",
        "window.__3D_STATE__.ligandPosition.z < 8"
      ]
    },
    {
      "id": "S3",
      "name": "LigandRotated",
      "conditions": [
        "window.__3D_STATE__.ligandRotationY !== 0",
        "window.__3D_STATE__.mode === 'MANUAL'"
      ]
    },
    {
      "id": "S4",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.moveHistoryIndex < window.__3D_STATE__.moveHistory.length - 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.moveHistoryIndex > 0"
      ]
    },
    {
      "id": "S6",
      "name": "AutoDockRunning",
      "conditions": [
        "window.__3D_STATE__.mode === 'AUTO_DOCK'",
        "window.__3D_STATE__.autoDockConverged === false"
      ]
    },
    {
      "id": "S7",
      "name": "AutoDockConverged",
      "conditions": [
        "window.__3D_STATE__.autoDockConverged === true",
        "window.__3D_STATE__.dockingDistance < 1.0"
      ]
    },
    {
      "id": "S8",
      "name": "DebugOverlayActive",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "SnapshotTaken",
      "conditions": [
        "window.__3D_STATE__.snapshot !== null",
        "window.__3D_STATE__.snapshot.timestamp > 0"
      ]
    },
    {
      "id": "S10",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.ligandPosition.z === 8",
        "window.__3D_STATE__.ligandPosition.x === 0",
        "window.__3D_STATE__.mode === 'MANUAL'",
        "window.__3D_STATE__.moveHistory.length <= 1"
      ]
    },
    {
      "id": "S11",
      "name": "GridToggled",
      "conditions": [
        "window.__3D_STATE__.gridVisible === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ligandPosition === 'object' && typeof window.__3D_STATE__.ligandPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.receptorAtomCount >= 6 && window.__3D_STATE__.receptorAtomCount <= 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ligandAtomCount === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'MANUAL'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
