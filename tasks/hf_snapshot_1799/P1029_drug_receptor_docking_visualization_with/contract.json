          },
          {
            "expr": "window.__3D_STATE__.autoDockConverged === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestEnergy <= window.__3D_STATE__.totalEnergy + 0.0001",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bestDockingPosition === 'object' && typeof window.__3D_STATE__.bestDockingPosition.x === 'number'",
