  "affordances": [
    {
      "id": "A1",
      "name": "KaleidoscopeGroup",
      "type": "3d_object",
      "semantic": "The main group containing all kaleidoscope shapes with rotational symmetry",
      "locator_hints": [
        "scene.children group with mirrored shapes"
      ]
    },
    {
      "id": "A2",
      "name": "HUDPanel",
      "type": "dom_element",
