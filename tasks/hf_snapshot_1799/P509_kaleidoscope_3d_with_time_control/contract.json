      ]
    },
    {
      "id": "A3",
      "name": "SpeedDisplay",
      "type": "dom_element",
      "semantic": "Shows current time speed multiplier",
      "locator_hints": [
        "#hud-speed"
      ]
    },
    {
      "id": "A4",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "Shows elapsed time",
      "locator_hints": [
        "#hud-time"
      ]
    },
    {
      "id": "A5",
      "name": "SymmetryDisplay",
      "type": "dom_element",
      "semantic": "Shows current symmetry fold count",
      "locator_hints": [
        "#hud-symmetry"
      ]
    },
    {
      "id": "A6",
      "name": "ColorModeDisplay",
      "type": "dom_element",
      "semantic": "Shows current color mode",
      "locator_hints": [
        "#hud-color-mode"
      ]
    },
    {
      "id": "A7",
      "name": "PauseDisplay",
      "type": "dom_element",
      "semantic": "Shows PAUSED text when paused",
      "locator_hints": [
        "#hud-pause"
      ]
    },
    {
      "id": "A8",
      "name": "SnapshotDisplay",
      "type": "dom_element",
      "semantic": "Shows snapshot count",
      "locator_hints": [
        "#hud-snapshots"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.timeSpeed === 1.0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.symmetryFold === 6",
        "window.__3D_STATE__.colorMode === 'rainbow'",
        "window.__3D_STATE__.snapshotCount === 0",
        "window.__3D_STATE__.shapesPositionsValid === true"
      ]
    },
    {
      "id": "S1",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.timeSpeed === 1.25",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true",
        "window.__3D_STATE__.timeSpeed === 0"
      ]
    },
    {
      "id": "S3",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.timeSpeed > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Symmetry8Fold",
      "conditions": [
        "window.__3D_STATE__.symmetryFold === 8",
        "window.__3D_STATE__.shapeCount === 40"
      ]
    },
    {
      "id": "S5",
      "name": "ColorModeChanged",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'monochrome'"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedNegative",
      "conditions": [
        "window.__3D_STATE__.timeSpeed < 0"
      ]
    },
    {
      "id": "S7",
      "name": "SnapshotTaken",
      "conditions": [
        "window.__3D_STATE__.snapshotCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.timeSpeed === 1.0",
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeSpeed !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPaused !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.symmetryFold !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.timeSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.snapshotCount >= 0",
            "tier": "L2"
          }
        ]
      }
