  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.barValues[0] === 85",
        "window.__3D_STATE__.barValues[1] === 142",
        "window.__3D_STATE__.particlesVisible === true",
        "window.__3D_STATE__.selectedBar === -1",
        "window.__3D_STATE__.sorted === false"
      ]
    },
    {
      "id": "S1",
      "name": "BottleLoaded",
      "conditions": [
        "window.__3D_STATE__.bottleLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "BarHovered",
      "conditions": [
        "window.__3D_STATE__.hoveredBar >= 0 && window.__3D_STATE__.hoveredBar <= 5"
      ]
    },
    {
      "id": "S3",
      "name": "BarSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBar >= 0 && window.__3D_STATE__.selectedBar <= 5"
      ]
    },
    {
      "id": "S4",
      "name": "Randomized",
      "conditions": [
        "window.__3D_STATE__.barValues.every(v => v >= 50 && v <= 150)",
        "window.__3D_STATE__.barValues[0] !== 85 || window.__3D_STATE__.barValues[1] !== 142"
      ]
    },
    {
      "id": "S5",
      "name": "ParticlesHidden",
      "conditions": [
        "window.__3D_STATE__.particlesVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "Sorted",
      "conditions": [
        "window.__3D_STATE__.sorted === true"
      ]
    },
    {
      "id": "S7",
