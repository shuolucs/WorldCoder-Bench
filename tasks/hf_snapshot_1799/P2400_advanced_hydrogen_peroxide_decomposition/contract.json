      "name": "Thermometer_Restored",
      "conditions": [
        "window.__3D_STATE__.thermometerVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "Reaction_Complete",
      "conditions": [
        "window.__3D_STATE__.reactionComplete === true",
        "window.__3D_STATE__.status === 'COMPLETE'",
        "window.__3D_STATE__.h2o2_moles < 0.01"
      ]
    },
    {
      "id": "S10",
      "name": "Experiment_Reset",
      "conditions": [
        "window.__3D_STATE__.status === 'IDLE'",
        "window.__3D_STATE__.h2o2_moles === 1.0",
        "window.__3D_STATE__.o2_moles_produced === 0",
        "window.__3D_STATE__.catalystAdded === false"
