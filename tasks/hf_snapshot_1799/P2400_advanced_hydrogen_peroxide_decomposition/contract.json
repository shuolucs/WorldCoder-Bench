  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.status === 'IDLE'",
        "window.__3D_STATE__.h2o2_moles === 1.0",
        "window.__3D_STATE__.catalystAdded === false",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Dragon_Loaded",
      "conditions": [
        "window.__3D_STATE__.dragonLoaded === true",
        "window.__3D_STATE__.dragonModel !== null"
      ]
    },
    {
      "id": "S2",
      "name": "Concentration_Changed",
      "conditions": [
        "window.__3D_STATE__.concentration !== '3%'",
        "window.__3D_STATE__.reactionActive === false"
      ]
    },
    {
      "id": "S3",
      "name": "Catalyst_Added_Reacting",
      "conditions": [
        "window.__3D_STATE__.catalystAdded === true",
        "window.__3D_STATE__.reactionActive === true",
        "window.__3D_STATE__.status === 'REACTING'"
      ]
    },
    {
      "id": "S4",
      "name": "Reaction_Progressing",
      "conditions": [
        "window.__3D_STATE__.h2o2_moles < 1.0",
        "window.__3D_STATE__.o2_moles_produced > 0",
        "window.__3D_STATE__.temperature > 25"
      ]
    },
    {
      "id": "S5",
      "name": "Data_Recorded",
      "conditions": [
        "window.__3D_STATE__.dataLog.length > 0"
      ]
    },
    {
