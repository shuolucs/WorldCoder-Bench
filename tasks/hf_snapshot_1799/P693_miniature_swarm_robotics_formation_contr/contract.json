        "#btn_reset"
      ]
    },
    {
      "id": "A5",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume simulation",
      "locator_hints": [
        "#btn_pause"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing swarm stats",
