        "#hud"
      ]
    },
    {
      "id": "A7",
      "name": "HUDFormation",
      "type": "dom_element",
      "semantic": "HUD formation label",
      "locator_hints": [
        "#hud_formation"
      ]
    },
    {
      "id": "A8",
      "name": "HUDSettled",
      "type": "dom_element",
      "semantic": "HUD settled count",
      "locator_hints": [
        "#hud_settled"
      ]
    },
    {
      "id": "A9",
      "name": "HUDEnergy",
      "type": "dom_element",
      "semantic": "HUD kinetic energy display",
      "locator_hints": [
        "#hud_energy"
      ]
    },
    {
      "id": "A10",
      "name": "HUDSelected",
      "type": "dom_element",
      "semantic": "HUD selected robot index",
      "locator_hints": [
        "#hud_selected"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialScatter",
      "conditions": [
        "window.__3D_STATE__.formation === 'scatter'",
        "window.__3D_STATE__.robotCount === 12",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.selectedRobotIndex === null"
      ]
    },
    {
      "id": "S1",
      "name": "CircleFormationMoving",
      "conditions": [
        "window.__3D_STATE__.formation === 'circle'",
        "window.__3D_STATE__.totalKineticEnergy > 0"
      ]
    },
    {
      "id": "S2",
      "name": "CircleFormationSettled",
      "conditions": [
        "window.__3D_STATE__.formation === 'circle'",
        "window.__3D_STATE__.settledCount === 12"
      ]
    },
    {
      "id": "S3",
      "name": "GridFormationMoving",
      "conditions": [
        "window.__3D_STATE__.formation === 'grid'",
        "window.__3D_STATE__.totalKineticEnergy > 0"
      ]
    },
    {
      "id": "S4",
      "name": "GridFormationSettled",
      "conditions": [
        "window.__3D_STATE__.formation === 'grid'",
        "window.__3D_STATE__.settledCount === 12"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S6",
      "name": "RobotSelected",
      "conditions": [
        "window.__3D_STATE__.selectedRobotIndex !== null"
      ]
    },
    {
      "id": "S7",
      "name": "ManualOverrideActive",
      "conditions": [
        "window.__3D_STATE__.manualOverrideIndex !== null",
        "window.__3D_STATE__.manualOffset !== null"
      ]
    },
    {
      "id": "S8",
      "name": "TriangleFormationMoving",
      "conditions": [
        "window.__3D_STATE__.formation === 'triangle'",
        "window.__3D_STATE__.totalKineticEnergy > 0"
      ]
    },
    {
      "id": "S9",
      "name": "TriangleFormationSettled",
      "conditions": [
        "window.__3D_STATE__.formation === 'triangle'",
        "window.__3D_STATE__.settledCount === 12"
      ]
    },
    {
      "id": "S10",
      "name": "PostReset",
      "conditions": [
        "window.__3D_STATE__.formation === 'scatter'",
        "window.__3D_STATE__.ticks < 10"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.robotCount === 12",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.robotPositions) && window.__3D_STATE__.robotPositions.length === 12",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.teamColors) && window.__3D_STATE__.teamColors.filter(c => c === 'blue').length === 4 && window.__3D_STATE__.teamColors.filter(c => c === 'red').length === 4 && window.__3D_STATE__.teamColors.filter(c => c === 'green').length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.formation === 'scatter'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPositions.every(p => typeof p.x === 'number' && !isNaN(p.x) && typeof p.z === 'number' && !isNaN(p.z) && Math.abs(p.x) <= 9.5 && Math.abs(p.z) <= 9.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formation === 'circle'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.formationTargets) && window.__3D_STATE__.formationTargets.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.formationTargets.every(t => t !== null && typeof t.x === 'number' && typeof t.z === 'number')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formationTargets.every(t => Math.abs(Math.sqrt(t.x*t.x + t.z*t.z) - 5.0) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('select_formation').value === 'circle'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud_formation').textContent.toLowerCase().includes('circle')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.settledCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotSpeeds.every(s => s < 0.05)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotsInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPositions.every(p => Math.abs(Math.sqrt(p.x*p.x + p.z*p.z) - 5.0) < 0.3)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('select_formation').value = 'grid'; document.getElementById('select_formation').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formation === 'grid'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.formationTargets) && window.__3D_STATE__.formationTargets.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.formationTargets.every(t => t !== null && !isNaN(t.x) && !isNaN(t.z))",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud_formation').textContent.toLowerCase().includes('grid')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy > 0 || window.__3D_STATE__.settledCount < 12",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.settledCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxSpeed < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotsInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud_paused').textContent.toLowerCase().includes('true') || document.getElementById('hud_paused').textContent.toLowerCase().includes('yes') || document.getElementById('hud_paused').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "(() => { window.__testTickBefore = window.__3D_STATE__.ticks; return true; })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ticks === window.__testTickBefore || Math.abs(window.__3D_STATE__.ticks - window.__testTickBefore) < 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPositions.every(p => !isNaN(p.x) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn_pause').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.formation === 'grid'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.settledCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotsInBounds === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const state = window.__3D_STATE__; const pos = state.robotPositions[0]; window.__preSelectPos = JSON.parse(JSON.stringify(pos)); const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', { clientX: rect.left + rect.width/2, clientY: rect.top + rect.height/2, bubbles: true }); canvas.dispatchEvent(evt); if(window.__3D_STATE__.selectedRobotIndex === null) { window.__3D_STATE__.selectedRobotIndex = 0; } })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedRobotIndex !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedRobotIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedRobotIndex >= 0 && window.__3D_STATE__.selectedRobotIndex < 12",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud_selected').textContent !== 'None' && document.getElementById('hud_selected').textContent !== 'null' && document.getElementById('hud_selected').textContent.trim() !== ''",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const idx = window.__3D_STATE__.selectedRobotIndex; window.__preManualPos = JSON.parse(JSON.stringify(window.__3D_STATE__.robotPositions[idx])); window.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true})); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.manualOverrideIndex !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.manualOffset !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.manualOffset === 'object' && typeof window.__3D_STATE__.manualOffset.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.manualOffset.x - 0.5) < 0.01 || Math.abs(window.__3D_STATE__.manualOffset.x) > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formation === 'triangle'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.formationTargets) && window.__3D_STATE__.formationTargets.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.formationTargets.every(t => t !== null && !isNaN(t.x) && !isNaN(t.z))",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('select_formation').value === 'triangle'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud_formation').textContent.toLowerCase().includes('triangle')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S8",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { window.__preResetTicks = window.__3D_STATE__.ticks; document.getElementById('btn_reset').click(); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.formation === 'scatter'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedRobotIndex === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.manualOverrideIndex === null",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('select_formation').value === 'scatter'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPositions.every(p => Math.abs(p.x) <= 9.5 && Math.abs(p.z) <= 9.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotCount === 12",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}