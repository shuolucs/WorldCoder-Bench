{
  "task_id": "P693_miniature_swarm_robotics_formation_contr",
  "affordances": [
    {
      "id": "A1",
      "name": "DioramaGround",
      "type": "3d_object",
      "semantic": "20x20 flat ground plane with grid texture",
      "locator_hints": [
        "ground plane mesh",
        "y=0"
      ]
    },
    {
      "id": "A2",
      "name": "SwarmRobots",
      "type": "3d_object",
      "semantic": "12 small robot agents with colored bodies and LED spheres",
      "locator_hints": [
        "robot group meshes",
        "box body + sphere LED"
      ]
    },
    {
      "id": "A3",
      "name": "FormationDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select formation",
