      "locator_hints": [
        "#time-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.selectedPeakIndex === null"
      ]
    },
    {
      "id": "S1",
      "name": "PeakSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPeakIndex !== null",
        "window.__3D_STATE__.selectedPeakIndex >= 0 && window.__3D_STATE__.selectedPeakIndex <= 4"
      ]
    },
    {
      "id": "S2",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentTime >= 0"
      ]
    },
    {
      "id": "S3",
      "name": "TimeMidpoint",
      "conditions": [
        "window.__3D_STATE__.currentTime === 50"
      ]
    },
    {
      "id": "S4",
      "name": "TimeAdvanced",
      "conditions": [
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 1"
      ]
    },
    {
      "id": "S6",
      "name": "Zoomed",
      "conditions": [
        "window.__3D_STATE__.cameraZoom !== 1"
      ]
    },
    {
      "id": "S7",
      "name": "TimeReset",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peakHeights) && window.__3D_STATE__.peakHeights.length === 5",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[0] - 1.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[2] - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.isosbesticAbsorbance - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakCenters[0] === 350",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.peakFWHM) && Math.abs(window.__3D_STATE__.peakFWHM[0] - 2.355 * 20) < 0.1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.peakHeights[0] === 'number' && !isNaN(window.__3D_STATE__.peakHeights[0])",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.peakHeights[0] > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('time-slider').value = 50; document.getElementById('time-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime === 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[0] - 1.8 * Math.exp(-0.03 * 50)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[1] - 1.2 * Math.exp(-0.03 * 50)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[2] - 1.6 * (1 - Math.exp(-0.03 * 50))) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[4] - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime >= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalAbsorbance === 'number' && !isNaN(window.__3D_STATE__.totalAbsorbance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 600
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakHeights[0] < 1.8 * Math.exp(-0.03 * 50)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakHeights[2] > 1.6 * (1 - Math.exp(-0.03 * 50))",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.isosbesticAbsorbance - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactantSum < window.__3D_STATE__.productSum || window.__3D_STATE__.currentTime < 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speed-select').value = '4'; document.getElementById('speed-select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime >= 0 && window.__3D_STATE__.currentTime <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakHeights.every(h => h >= 0 && !isNaN(h))",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[4] - 0.7) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[0] - 1.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[1] - 1.2) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[2] - 0.1) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[3] - 0.05) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "5"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakCenters[4] === 480",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[4] - 0.7) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakFWHM[4] - 2.355 * 35) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S1",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('time-slider').value = 100; document.getElementById('time-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime === 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[0] - 1.8 * Math.exp(-0.03 * 100)) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[2] - 1.6 * (1 - Math.exp(-0.03 * 100))) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.peakHeights[3] - 1.0 * (1 - Math.exp(-0.03 * 100))) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.productSum > window.__3D_STATE__.reactantSum",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.isosbesticAbsorbance - 0.7) < 0.01",
            "tier": "L2"
          }
        ]
      }
