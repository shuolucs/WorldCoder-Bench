      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.totalCrystals === 0",
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.temperature === 'warm'"
      ]
    },
    {
      "id": "S1",
      "name": "Player1GrowthPulsed",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.totalCrystals >= 3",
        "window.__3D_STATE__.player1Crystals >= 3",
        "window.__3D_STATE__.player1Score >= 15"
      ]
    },
    {
      "id": "S2",
      "name": "SwitchedToPlayer2",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.totalCrystals >= 3"
      ]
    },
    {
      "id": "S3",
      "name": "Player2GrowthPulsed",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.player2Crystals >= 3",
        "window.__3D_STATE__.player2Score >= 15"
      ]
    },
    {
      "id": "S4",
      "name": "TemperatureCold",
      "conditions": [
        "window.__3D_STATE__.temperature === 'cold'",
        "window.__3D_STATE__.temperatureMultiplier === 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "RotationEnabled",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "WaveTriggered",
      "conditions": [
        "window.__3D_STATE__.waveActive === true || window.__3D_STATE__.totalCrystals >= 6"
      ]
    },
    {
      "id": "S7",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S8",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.totalCrystals === 0",
        "window.__3D_STATE__.player1Score === 0",
        "window.__3D_STATE__.player2Score === 0",
        "window.__3D_STATE__.player3Score === 0"
      ]
    }
  ],
