      ]
    },
    {
      "id": "A8",
      "name": "TurntableButton",
      "type": "dom_element",
      "semantic": "Toggle button for turntable auto-rotation",
      "locator_hints": [
        "#btn-turntable"
      ]
    },
    {
      "id": "A9",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all customizations",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A10",
      "name": "RotationDisplay",
      "type": "dom_element",
      "semantic": "Span showing current rotation in degrees",
      "locator_hints": [
        "#rotation-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.meshCount > 0"
      ]
    },
    {
      "id": "S1",
      "name": "DefaultState",
      "conditions": [
        "window.__3D_STATE__.materialType === 'matte'",
        "window.__3D_STATE__.turntableActive === false",
        "window.__3D_STATE__.soleColor.toLowerCase() === '#ffffff'"
      ]
    },
    {
      "id": "S2",
      "name": "SoleColorChanged",
      "conditions": [
        "window.__3D_STATE__.soleColor.toLowerCase() === '#ff0000'"
      ]
    },
    {
      "id": "S3",
      "name": "GlossyMaterial",
      "conditions": [
        "window.__3D_STATE__.materialType === 'glossy'",
        "window.__3D_STATE__.roughness < 0.35"
      ]
    },
    {
      "id": "S4",
      "name": "MetallicMaterial",
      "conditions": [
        "window.__3D_STATE__.materialType === 'metallic'",
        "window.__3D_STATE__.metalness > 0.8"
      ]
    },
    {
      "id": "S5",
      "name": "TurntableOn",
      "conditions": [
        "window.__3D_STATE__.turntableActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "TurntableRotated",
      "conditions": [
        "window.__3D_STATE__.turntableActive === true",
        "window.__3D_STATE__.rotationY > 0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.materialType === 'matte'",
        "window.__3D_STATE__.turntableActive === false",
        "window.__3D_STATE__.upperColor.toLowerCase() === '#2196f3'"
      ]
    }
  ],
  "transitions": [
