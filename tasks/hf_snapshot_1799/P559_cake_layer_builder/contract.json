{
  "task_id": "P559_cake_layer_builder",
  "affordances": [
    {"id": "A1", "name": "CakeLayers", "type": "3d_object", "semantic": "Stacked cylinder cake layers", "locator_hints": ["cylinder meshes"]},
    {"id": "A2", "name": "Frosting", "type": "3d_object", "semantic": "Frosting cylinders around layers", "locator_hints": ["slightly larger cylinder meshes"]},
    {"id": "A3", "name": "Decorations", "type": "3d_object", "semantic": "GLB topper models on top", "locator_hints": ["GLTF models on top of cake"]},
    {"id": "A4", "name": "AddLayerBtn", "type": "dom_element", "semantic": "Add layer button", "locator_hints": ["#btn-add-layer"]},
    {"id": "A5", "name": "RadiusSlider", "type": "dom_element", "semantic": "Layer radius control", "locator_hints": ["#slider-radius"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Empty", "conditions": ["window.__3D_STATE__.layerCount === 0"]},
    {"id": "S1", "name": "OneLayer", "conditions": ["window.__3D_STATE__.layerCount === 1"]},
    {"id": "S2", "name": "MultiLayer", "conditions": ["window.__3D_STATE__.layerCount >= 2"]},
    {"id": "S3", "name": "Decorated", "conditions": ["window.__3D_STATE__.decoration !== 'None'"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.layerCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelsLoaded >= 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cakeValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('btn-add-layer').click(); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layerCount === 1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalHeight > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cakeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-radius').value = 1.5; document.getElementById('slider-radius').dispatchEvent(new Event('input')); document.getElementById('btn-add-layer').click(); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layerCount === 2", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bottomCompression < 1.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.totalHeight > before.totalHeight", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.topLayerFrosting === true", "tier": "L2"},
        {"expr": "document.getElementById('hud-frosting').textContent.includes('Yes')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "1"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.decoration === 'Avocado'", "tier": "L2"},
        {"expr": "document.getElementById('hud-decoration').textContent.includes('Avocado')", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layerCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.decoration === 'None'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.cakeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "for(let i=0; i<5; i++) document.getElementById('btn-add-layer').click(); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.layerCount === 5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.bottomCompression < 0.9", "tier": "L1"},
        {"expr": "window.__3D_STATE__.cakeValid === true", "tier": "L0"}
      ]}
    }
  ]
}
