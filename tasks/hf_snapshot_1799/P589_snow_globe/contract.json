    {"id": "A3", "name": "Lantern", "type": "3d_object", "semantic": "Lantern GLB model inside globe", "locator_hints": ["GLTF model Lantern"]},
    {"id": "A4", "name": "SnowParticles", "type": "3d_object", "semantic": "White snow particles inside globe", "locator_hints": ["Points geometry white"]},
    {"id": "A5", "name": "ParticleSlider", "type": "dom_element", "semantic": "Particle count control", "locator_hints": ["#slider-particles"]},
    {"id": "A6", "name": "GravitySlider", "type": "dom_element", "semantic": "Gravity strength control", "locator_hints": ["#slider-gravity"]},
