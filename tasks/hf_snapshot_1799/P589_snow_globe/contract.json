  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.frameCount > 0", "window.__3D_STATE__.shakeCount === 0"]},
    {"id": "S1", "name": "Shaken", "conditions": ["window.__3D_STATE__.airborneCount > 50"]},
    {"id": "S2", "name": "Settling", "conditions": ["window.__3D_STATE__.airborneCount < before.airborneCount || window.__3D_STATE__.settledCount > 100"]},
    {"id": "S3", "name": "GravityChanged", "conditions": ["window.__3D_STATE__.gravity !== 0.5"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.settledCount > window.__3D_STATE__.particleCount * 0.5"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount >= 200", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.shakeCount >= 1", "tier": "L2"},
        {"expr": "window.__3D_STATE__.airborneCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.settledCount > 50", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-gravity').value = 1.8; document.getElementById('slider-gravity').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.gravity >= 1.5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-particles').value = 1000; document.getElementById('slider-particles').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.particleCount >= 900", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.settledCount > window.__3D_STATE__.particleCount * 0.3", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "l"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.lightsOn !== before.lightsOn", "tier": "L2"}
      ]}
    }
  ]
}
