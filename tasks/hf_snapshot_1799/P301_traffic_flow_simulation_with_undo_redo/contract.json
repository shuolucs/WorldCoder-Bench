      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.vehicleCount === 8",
        "window.__3D_STATE__.lightsPlaced === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.historySize === 0",
        "window.__3D_STATE__.redoSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "PedestrianLoaded",
      "conditions": [
        "window.__3D_STATE__.pedestrianLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "FirstLightPlaced",
      "conditions": [
        "window.__3D_STATE__.lightsPlaced === 1",
        "window.__3D_STATE__.historySize === 1"
      ]
    },
    {
      "id": "S3",
      "name": "VehiclesStopped",
      "conditions": [
        "window.__3D_STATE__.stoppedCount > 0",
        "window.__3D_STATE__.lightsPlaced >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.lightsPlaced === 0",
        "window.__3D_STATE__.redoSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.lightsPlaced === 1",
        "window.__3D_STATE__.redoSize === 0"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 5"
      ]
    },
    {
      "id": "S8",
      "name": "MultipleLightsPlaced",
      "conditions": [
        "window.__3D_STATE__.lightsPlaced >= 2",
        "window.__3D_STATE__.historySize >= 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
