{
  "task_id": "P433_solar_eclipse_simulation_with_particle_e",
  "affordances": [
    {
      "id": "A1",
      "name": "Sun",
      "type": "3d_object",
      "semantic": "Glowing sun sphere at center of scene",
      "locator_hints": [
        "radius 8 sphere",
        "color #FDB813",
        "position (0,0,-50)"
      ]
    },
    {
      "id": "A2",
      "name": "Moon",
      "type": "3d_object",
      "semantic": "Orbiting moon sphere that causes eclipse",
      "locator_hints": [
        "radius 2.2 sphere",
        "dark grey",
        "orbits around z-axis"
      ]
    },
    {
      "id": "A3",
      "name": "CoronaParticles",
      "type": "3d_object",
      "semantic": "Particle system simulating solar corona and wind",
      "locator_hints": [
        "THREE.Points",
        "1000 particles",
        "orange-yellow"
      ]
    },
    {
      "id": "A4",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle orbital animation",
      "locator_hints": [
        "#playPauseBtn"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling orbital speed",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A6",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Panel displaying eclipse state and moon angle",
      "locator_hints": [
        "#infoPanel"
      ]
    },
    {
      "id": "A7",
      "name": "ControlPanel",
      "type": "dom_element",
      "semantic": "Bottom control panel with UI elements",
      "locator_hints": [
        "#controlPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.moonAngle >= 0",
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.cameraPreset === 1",
        "window.__3D_STATE__.coronaVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier !== 1"
      ]
    },
    {
      "id": "S3",
      "name": "CameraPreset2",
      "conditions": [
        "window.__3D_STATE__.cameraPreset === 2"
      ]
    },
    {
      "id": "S4",
      "name": "CoronaHidden",
      "conditions": [
        "window.__3D_STATE__.coronaVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "EclipseOccurring",
      "conditions": [
        "window.__3D_STATE__.eclipseState !== 'none'"
      ]
    },
    {
      "id": "S6",
      "name": "TotalEclipse",
      "conditions": [
        "window.__3D_STATE__.eclipseState === 'total'",
        "window.__3D_STATE__.angularSeparation < 1.5"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.moonAngle < 5",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('playPauseBtn').textContent.trim() === 'Play'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('playPauseBtn').textContent.trim() === 'Pause'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 3; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('speedSlider').value === '3'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('infoPanel').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S0",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S0",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target": "Sun",
        "position": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S0",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const targetAngle = 180; window.__3D_STATE__._forceAngle = targetAngle; /* Wait for moon to reach alignment */ (function waitForEclipse() { if(window.__3D_STATE__.eclipseState === 'total') return; setTimeout(waitForEclipse, 100); })();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S3",
      "to": "S0",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}