{
  "task_id": "P694_queueing_theory_bank_simulation_with_par",
  "affordances": [
    {
      "id": "A1",
      "name": "BankFloor",
      "type": "3d_object",
      "semantic": "Beige floor plane representing the bank interior",
      "locator_hints": [
        "large flat box at y=0"
      ]
    },
    {
      "id": "A2",
      "name": "TellerWindows",
      "type": "3d_object",
      "semantic": "Three teller service windows along back wall",
      "locator_hints": [
        "blue boxes at z=-10, x=-6,0,6"
      ]
    },
    {
      "id": "A3",
      "name": "TellerIndicators",
      "type": "3d_object",
      "semantic": "Status spheres above each teller (green=idle, red=busy)",
      "locator_hints": [
        "small spheres above teller boxes"
      ]
    },
    {
      "id": "A4",
      "name": "CustomerMeshes",
      "type": "3d_object",
      "semantic": "Capsule-shaped customer entities in the scene",
      "locator_hints": [
        "cylinder+sphere combos with random colors"
      ]
    },
    {
      "id": "A5",
      "name": "Particles",
      "type": "3d_object",
      "semantic": "Particle effect spheres emitted during service events",
      "locator_hints": [
        "small 0.1 radius spheres, gold or green"
      ]
    },
    {
      "id": "A6",
      "name": "AddCustomerBtn",
      "type": "dom_element",
      "semantic": "Button to manually spawn a customer",
      "locator_hints": [
        "#addCustomerBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ToggleAutoBtn",
      "type": "dom_element",
      "semantic": "Button to toggle automatic Poisson arrivals",
      "locator_hints": [
        "#toggleAutoBtn"
      ]
    },
    {
      "id": "A8",
      "name": "ArrivalRateSlider",
      "type": "dom_element",
      "semantic": "Slider controlling arrival rate lambda",
      "locator_hints": [
        "#arrivalRateSlider"
      ]
    },
    {
      "id": "A9",
      "name": "ResetBtn",
      "type": "dom_element",
      "semantic": "Button to reset entire simulation",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A10",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing real-time queueing statistics",
      "locator_hints": [
        "#statsPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialIdle",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.totalArrived === 0",
        "window.__3D_STATE__.totalServed === 0",
        "window.__3D_STATE__.queueLength === 0",
        "window.__3D_STATE__.autoArrival === true"
      ]
    },
    {
      "id": "S1",
      "name": "ManualCustomerAdded",
      "conditions": [
        "window.__3D_STATE__.totalArrived >= 1",
        "window.__3D_STATE__.customersInScene >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "MultipleCustomersQueued",
      "conditions": [
        "window.__3D_STATE__.totalArrived >= 5",
        "window.__3D_STATE__.customersInScene >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "ServiceInProgress",
      "conditions": [
        "window.__3D_STATE__.tellerStates.some(t => t.busy === true)"
      ]
    },
    {
      "id": "S4",
      "name": "AutoArrivalPaused",
      "conditions": [
        "window.__3D_STATE__.autoArrival === false"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S6",
      "name": "TellerClosed",
      "conditions": [
        "window.__3D_STATE__.tellerStates.some(t => t.open === false)"
      ]
    },
    {
      "id": "S7",
      "name": "ArrivalRateChanged",
      "conditions": [
        "window.__3D_STATE__.arrivalRate !== 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "CustomersServed",
      "conditions": [
        "window.__3D_STATE__.totalServed >= 1",
        "window.__3D_STATE__.avgServiceTime > 0"
      ]
    },
    {
      "id": "S9",
      "name": "PostReset",
      "conditions": [
        "window.__3D_STATE__.totalArrived === 0",
        "window.__3D_STATE__.totalServed === 0",
        "window.__3D_STATE__.queueLength === 0",
        "window.__3D_STATE__.simulationTime < 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addCustomerBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalArrived === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.tellerStates !== 'undefined' && Array.isArray(window.__3D_STATE__.tellerStates)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrived >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customersInScene >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastEvent === 'arrival' || window.__3D_STATE__.lastEvent === 'service_start'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simulationTime) && window.__3D_STATE__.simulationTime >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<4;i++){document.getElementById('addCustomerBtn').click();}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalArrived >= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customersInScene >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queueLength >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrived >= window.__3D_STATE__.totalServed + window.__3D_STATE__.queueLength",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.length === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tellerStates.some(t => t.busy === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.filter(t => t.open).length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.every(t => typeof t.utilization === 'number' && t.utilization >= 0 && t.utilization <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticles !== undefined && typeof window.__3D_STATE__.activeParticles === 'number'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.filter(t => t.busy).every(t => t.servingCustomerId !== null)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleAutoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoArrival === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.arrivalRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.arrivalRate === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleAutoBtn').textContent.toLowerCase().includes('resume')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simulationTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgWaitTime) && window.__3D_STATE__.avgWaitTime >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown',{key:'p'})); setTimeout(()=>window.dispatchEvent(new KeyboardEvent('keydown',{key:'1'})),200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates[0].open === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.filter(t => t.open).length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates[0].busy === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates[0].servingCustomerId === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "let s=document.getElementById('arrivalRateSlider'); let nv=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; nv.call(s,'1.5'); s.dispatchEvent(new Event('input',{bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrivalRate === 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('arrivalRateSlider').value === '1.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('arrivalRateLabel') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates[0].open === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalServiceTimeSum)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 10000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalServed >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgServiceTime > 0 && window.__3D_STATE__.avgServiceTime <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgWaitTime >= 0 && !isNaN(window.__3D_STATE__.avgWaitTime)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrived >= window.__3D_STATE__.totalServed",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalServiceTimeSum > 0 && Math.abs(window.__3D_STATE__.avgServiceTime - (window.__3D_STATE__.totalServiceTimeSum / window.__3D_STATE__.totalServed)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.filter(t => t.open).every(t => t.utilization > 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalArrived === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalServed === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queueLength === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customersInScene === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.every(t => t.open === true && t.busy === false && t.servingCustomerId === null)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgWaitTime === 0 && window.__3D_STATE__.avgServiceTime === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalArrived === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.customersInScene === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastEvent === 'arrival' || window.__3D_STATE__.lastEvent === 'service_start'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates.every(t => t.open === true)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}