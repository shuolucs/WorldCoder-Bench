        "window.__3D_STATE__.quizQuestionNumber === 1"
      ]
    },
    {
      "id": "S3",
      "name": "FirstCorrectAnswer",
      "conditions": [
        "window.__3D_STATE__.quizActive === true",
        "window.__3D_STATE__.lastAnswerCorrect === true",
        "window.__3D_STATE__.quizCorrectCount >= 1",
        "window.__3D_STATE__.quizScore >= 10"
      ]
    },
    {
      "id": "S4",
      "name": "DifficultyIncreased",
      "conditions": [
        "window.__3D_STATE__.quizDifficulty >= 2",
