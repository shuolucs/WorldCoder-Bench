  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "conditions": [
        "window.__3D_STATE__.elementsLoaded === 36",
        "window.__3D_STATE__.quizActive === false",
        "window.__3D_STATE__.selectedElement === null",
        "window.__3D_STATE__.activeFilter === 'All'",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
