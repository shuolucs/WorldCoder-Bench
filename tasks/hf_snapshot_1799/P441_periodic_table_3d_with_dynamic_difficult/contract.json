        "window.__3D_STATE__.difficultyChanges >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "WrongAnswer",
      "conditions": [
        "window.__3D_STATE__.lastAnswerCorrect === false",
        "window.__3D_STATE__.quizStreak === 0",
        "window.__3D_STATE__.quizWrongCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "CategoryFiltered",
      "conditions": [
        "window.__3D_STATE__.activeFilter !== 'All'",
        "window.__3D_STATE__.visibleElementCount < 36"
      ]
    },
    {
      "id": "S7",
      "name": "FilterReset",
      "conditions": [
        "window.__3D_STATE__.activeFilter === 'All'",
        "window.__3D_STATE__.visibleElementCount === 36"
      ]
    },
    {
      "id": "S8",
