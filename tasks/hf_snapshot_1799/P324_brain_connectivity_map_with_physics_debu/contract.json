{
  "task_id": "P324_brain_connectivity_map_with_physics_debu",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainNodes",
      "type": "3d_object",
      "semantic": "12 brain region spheres color-coded by region",
      "locator_hints": [
        "SphereGeometry meshes in scene",
        "colored red/green/blue/yellow"
      ]
    },
    {
      "id": "A2",
      "name": "Connections",
      "type": "3d_object",
      "semantic": "20 connection edges between brain nodes",
      "locator_hints": [
        "Line or Cylinder objects connecting nodes"
      ]
    },
    {
      "id": "A3",
      "name": "SignalPulses",
      "type": "3d_object",
      "semantic": "Small spheres traveling along connections",
      "locator_hints": [
        "small bright spheres moving between nodes"
      ]
    },
    {
      "id": "A4",
      "name": "DebugOverlay",
      "type": "3d_object",
      "semantic": "Force vectors, velocity vectors, bounding sphere wireframe",
      "locator_hints": [
        "ArrowHelper objects",
        "wireframe sphere"
      ]
    },
    {
      "id": "A5",
      "name": "TogglePhysicsButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume physics simulation",
      "locator_hints": [
        "#btn-physics"
      ]
    },
    {
      "id": "A6",
      "name": "ResetLayoutButton",
      "type": "dom_element",
      "semantic": "Button to reset node positions",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "HighlightRegionButton",
      "type": "dom_element",
      "semantic": "Button to cycle through region highlighting",
      "locator_hints": [
        "#btn-highlight"
      ]
    },
    {
      "id": "A8",
      "name": "ToggleDebugButton",
      "type": "dom_element",
      "semantic": "Button to toggle debug overlay",
      "locator_hints": [
        "#btn-debug"
      ]
    },
    {
      "id": "A9",
      "name": "NodeInfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected node details",
      "locator_hints": [
        "#node-info"
      ]
    },
    {
      "id": "A10",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left and top-right HUD text",
      "locator_hints": [
        "HUD div elements"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 12",
        "window.__3D_STATE__.connectionCount === 20",
        "window.__3D_STATE__.physicsActive === true",
        "window.__3D_STATE__.debugMode === false",
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.highlightedRegion === 'all'"
      ]
    },
    {
      "id": "S1",
      "name": "PhysicsRunning",
      "conditions": [
        "window.__3D_STATE__.physicsActive === true",
        "window.__3D_STATE__.totalKineticEnergy >= 0",
        "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "PhysicsPaused",
      "conditions": [
        "window.__3D_STATE__.physicsActive === false",
        "window.__3D_STATE__.maxVelocity === 0"
      ]
    },
    {
      "id": "S3",
      "name": "DebugOn",
      "conditions": [
        "window.__3D_STATE__.debugMode === true"
      ]
    },
    {
      "id": "S4",
      "name": "DebugOff",
      "conditions": [
        "window.__3D_STATE__.debugMode === false"
      ]
    },
    {
      "id": "S5",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex >= 0",
        "window.__3D_STATE__.selectedNodeIndex < 12"
      ]
    },
    {
      "id": "S6",
      "name": "RegionHighlighted",
      "conditions": [
        "window.__3D_STATE__.highlightedRegion !== 'all'"
      ]
    },
    {
      "id": "S7",
      "name": "LayoutReset",
      "conditions": [
        "window.__3D_STATE__.physicsActive === true",
        "window.__3D_STATE__.maxVelocity === 0",
        "window.__3D_STATE__.nodesInBounds === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Frontal !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Parietal !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Temporal !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Occipital !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.connectionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.physicsActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.connectionCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-physics"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nodeCount !== before.nodeCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number' && !isNaN(window.__3D_STATE__.nodeCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.connectionCount === 'number' && !isNaN(window.__3D_STATE__.connectionCount)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.nodePositions)",
            "tier": "L0"
          },
