{
  "task_id": "P819_depth_of_field_with_bokeh_shape_selector",
  "affordances": [
    {
      "id": "A1",
      "name": "ControlsPanel",
      "type": "dom_element",
      "semantic": "Top-right panel containing all DOF and debug controls",
      "locator_hints": [
        "#controls-panel"
      ]
    },
    {
      "id": "A2",
      "name": "FocusSlider",
      "type": "dom_element",
      "semantic": "Slider controlling DOF focus distance",
      "locator_hints": [
        "#slider-focus"
      ]
    },
    {
      "id": "A3",
      "name": "ApertureSlider",
      "type": "dom_element",
      "semantic": "Slider controlling DOF aperture",
      "locator_hints": [
        "#slider-aperture"
      ]
    },
    {
      "id": "A4",
      "name": "MaxBlurSlider",
      "type": "dom_element",
      "semantic": "Slider controlling DOF max blur",
      "locator_hints": [
        "#slider-maxblur"
      ]
    },
    {
      "id": "A5",
      "name": "BtnCircle",
      "type": "dom_element",
      "semantic": "Button to select circle bokeh shape",
      "locator_hints": [
        "#btn-circle"
      ]
    },
    {
      "id": "A6",
      "name": "BtnHexagon",
      "type": "dom_element",
      "semantic": "Button to select hexagon bokeh shape",
      "locator_hints": [
        "#btn-hexagon"
      ]
    },
    {
      "id": "A7",
      "name": "BtnStar",
      "type": "dom_element",
      "semantic": "Button to select star bokeh shape",
      "locator_hints": [
        "#btn-star"
      ]
    },
    {
      "id": "A8",
      "name": "BtnDebug",
      "type": "dom_element",
      "semantic": "Toggle button for physics debug overlay",
      "locator_hints": [
        "#btn-debug"
      ]
    },
    {
      "id": "A9",
      "name": "BtnPause",
      "type": "dom_element",
      "semantic": "Pause/resume physics simulation",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A10",
      "name": "BtnReset",
      "type": "dom_element",
      "semantic": "Reset all spheres to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A11",
      "name": "DebugCanvas",
      "type": "dom_element",
      "semantic": "2D canvas overlay showing physics debug info",
      "locator_hints": [
        "#debug-canvas"
      ]
    },
    {
      "id": "A12",
      "name": "BouncingSpheres",
      "type": "3d_object",
      "semantic": "20 colored spheres with gravity and bounce physics",
      "locator_hints": [
        "sphere meshes in scene"
      ]
    },
    {
      "id": "A13",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane at y=0",
      "locator_hints": [
        "ground mesh"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.sphereCount === 20",
        "window.__3D_STATE__.bokehShape === 'circle'",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.composerEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "PhysicsRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 30",
        "window.__3D_STATE__.totalKineticEnergy > 0"
      ]
    },
    {
      "id": "S2",
      "name": "DebugOverlayOn",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "BokehHexagon",
      "conditions": [
        "window.__3D_STATE__.bokehShape === 'hexagon'",
        "window.__3D_STATE__.bokehShapeIndex === 1"
      ]
    },
    {
      "id": "S4",
      "name": "BokehStar",
      "conditions": [
        "window.__3D_STATE__.bokehShape === 'star'",
        "window.__3D_STATE__.bokehShapeIndex === 2"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "FocusAdjusted",
      "conditions": [
        "window.__3D_STATE__.focusDistance !== 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.sphereCount === 20"
      ]
    },
    {
      "id": "S8",
      "name": "ApertureAdjusted",
      "conditions": [
        "window.__3D_STATE__.aperture !== 0.005"
      ]
    },
    {
      "id": "S9",
      "name": "DebugOverlayOff",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.spherePositions === 'object' && Array.isArray(window.__3D_STATE__.spherePositions) && window.__3D_STATE__.spherePositions.length === 20",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.sphereVelocities === 'object' && Array.isArray(window.__3D_STATE__.sphereVelocities) && window.__3D_STATE__.sphereVelocities.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy > 0 && !isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => p.y >= 0.3 && !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.every(v => !isNaN(v.x) && !isNaN(v.y) && !isNaN(v.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debug-canvas') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debug-canvas').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalKineticEnergy === 'number' && window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.spheresResting === 'number' && window.__3D_STATE__.spheresResting >= 0 && window.__3D_STATE__.spheresResting <= 20",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-hexagon"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bokehShape === 'hexagon'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bokehShapeIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-hexagon').classList.contains('active')",
            "tier": "L2"
          },
          {
            "expr": "!document.getElementById('btn-circle').classList.contains('active')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bokehShape === 'star'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bokehShapeIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-star').classList.contains('active')",
            "tier": "L2"
          },
          {
            "expr": "!document.getElementById('btn-hexagon').classList.contains('active')",
            "tier": "L2"
          },
          {
            "expr": "!document.getElementById('btn-circle').classList.contains('active')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "p"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ window.__T5_ke = window.__3D_STATE__.totalKineticEnergy; window.__T5_frame = window.__3D_STATE__.frameCount; return true; })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.y) && p.y >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bokehShape === 'star'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-focus').value = 0.2; document.getElementById('slider-focus').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.focusDistance - 0.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('label-focus').textContent.includes('0.2')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-aperture').value = 0.008; document.getElementById('slider-aperture').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.aperture - 0.008) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('label-aperture').textContent.includes('0.008') || document.getElementById('label-aperture').textContent.includes('0.0080')",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.focusDistance - 0.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bokehShapeIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sphereCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => p.y >= 2.5)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.every(v => Math.abs(v.x) < 0.01 && Math.abs(v.y) < 0.01 && Math.abs(v.z) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "target": "#btn-debug"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugOverlayVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debug-canvas') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debug-canvas').style.display === 'none' || document.getElementById('debug-canvas').style.visibility === 'hidden' || document.getElementById('debug-canvas').style.opacity === '0'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0 && !isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => p.y >= 0.3 && p.y < 15)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravity === 9.81",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.restitution === 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.groundY === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sphereVelocities.every(v => Math.abs(v.y) < 50)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}