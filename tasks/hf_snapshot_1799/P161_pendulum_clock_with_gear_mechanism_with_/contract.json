{
  "task_id": "P161_pendulum_clock_with_gear_mechanism_with_",
  "affordances": [
    {
      "id": "A1",
      "name": "Pendulum",
      "type": "3d_object",
      "semantic": "Swinging pendulum with rod and golden bob",
      "locator_hints": [
        "gold sphere at bottom",
        "pivot at (0, 0.5, 0.3)"
      ]
    },
    {
      "id": "A2",
      "name": "EscapeWheel",
      "type": "3d_object",
      "semantic": "Toothed escape wheel gear linked to pendulum",
      "locator_hints": [
        "copper colored gear",
        "12 teeth",
        "position near (0, 1.0, 0.2)"
      ]
    },
    {
      "id": "A3",
      "name": "MinuteHand",
      "type": "3d_object",
      "semantic": "Minute hand on clock face",
      "locator_hints": [
        "longer thin dark box on clock face"
      ]
    },
    {
      "id": "A4",
      "name": "HourHand",
      "type": "3d_object",
      "semantic": "Hour hand on clock face",
      "locator_hints": [
        "shorter dark box on clock face"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling time scale",
      "locator_hints": [
        "#speedSlider",
        "range input at bottom"
      ]
    },
    {
      "id": "A6",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to pause/resume simulation",
      "locator_hints": [
        "#pauseBtn"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A8",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "HUD showing simulated elapsed time",
      "locator_hints": [
        "#timeDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "AngleDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current pendulum angle",
      "locator_hints": [
        "#angleDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.timeScale === 1",
        "window.__3D_STATE__.elapsedSimTime >= 0",
        "window.__3D_STATE__.gearCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.elapsedSimTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.timeScale !== 1",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S4",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.elapsedSimTime < 0.1",
        "Math.abs(window.__3D_STATE__.minuteHandAngle) < 0.05",
        "Math.abs(window.__3D_STATE__.hourHandAngle) < 0.05"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedSimTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pendulumAngle) && isFinite(window.__3D_STATE__.pendulumAngle)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumAngle) <= Math.PI / 12 + 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.escapeWheelAngle > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gearCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#pauseBtn').textContent.trim() === 'Play'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedSimTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#pauseBtn').textContent.trim() === 'Pause'",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.pendulumAngleDeg) && isFinite(window.__3D_STATE__.pendulumAngleDeg)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#speedSlider').value = 5; document.querySelector('#speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeScale === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.minuteHandAngle) && isFinite(window.__3D_STATE__.minuteHandAngle)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedSimTime < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.minuteHandAngle) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.hourHandAngle) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.escapeWheelAngle) && isFinite(window.__3D_STATE__.escapeWheelAngle)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}