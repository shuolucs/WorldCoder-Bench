{
  "task_id": "P2716_dual_glb_character_synchronized_dance_ch",
  "affordances": [
    {
      "id": "A1",
      "name": "CharacterA",
      "type": "3d_object",
      "semantic": "Left dancer loaded from IridescenceAbalone.glb at x=-2",
      "locator_hints": [
        "position.x === -2",
        "left dancer"
      ]
    },
    {
      "id": "A2",
      "name": "CharacterB",
      "type": "3d_object",
      "semantic": "Right dancer loaded from DragonDispersion.glb at x=2",
      "locator_hints": [
        "position.x === 2",
        "right dancer"
      ]
    },
    {
      "id": "A3",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Toggle play/pause for the dance",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A4",
      "name": "BPMSlider",
      "type": "dom_element",
      "semantic": "Slider to adjust beats per minute",
      "locator_hints": [
        "#bpm-slider"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset choreography to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "BeatIndicator",
      "type": "dom_element",
      "semantic": "Visual flash on each beat",
      "locator_hints": [
        "#beat-indicator"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing BPM, beat count, move, status",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelsLoaded_Paused",
      "conditions": [
        "window.__3D_STATE__.modelsLoaded === true",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.beatCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Playing_Sway",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.currentMove === 'sway'"
      ]
    },
    {
      "id": "S2",
      "name": "Playing_BeatAdvanced",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.beatCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "BPM_Changed",
      "conditions": [
        "window.__3D_STATE__.bpm !== 120"
      ]
    },
    {
      "id": "S4",
      "name": "Playing_MoveChanged",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.moveIndex > 0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused_MidDance",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.beatCount > 0"
      ]
    },
    {
      "id": "S6",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.beatCount === 0",
        "window.__3D_STATE__.moveIndex === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.characterA_position === 'object' && typeof window.__3D_STATE__.characterB_position === 'object'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterA_position.x) && !isNaN(window.__3D_STATE__.characterB_position.x)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false && window.__3D_STATE__.beatCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.characterA_position.x - (-2)) < 0.5 && Math.abs(window.__3D_STATE__.characterB_position.x - 2) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMove === 'sway'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.moveIndex === 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.beatPhase === 'number' && window.__3D_STATE__.beatPhase >= 0 && window.__3D_STATE__.beatPhase < 1",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim() === 'Pause'",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beatCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 2.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterA_rotation.y) && !isNaN(window.__3D_STATE__.characterB_rotation.y)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.beatInterval === 60 / window.__3D_STATE__.bpm",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.characterA_rotation.z + window.__3D_STATE__.characterB_rotation.z) < 0.05 || Math.abs(window.__3D_STATE__.characterA_rotation.y + window.__3D_STATE__.characterB_rotation.y) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('bpm-slider').value = 180; document.getElementById('bpm-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bpm === 180",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.beatInterval - (60 / 180)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('bpm-label') !== null && document.getElementById('bpm-label').textContent.includes('180')",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.moveIndex > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentMove !== 'sway' || window.__3D_STATE__.moveIndex >= 4",
            "tier": "L2"
          },
          {
            "expr": "['sway','bounce','spin','lean'].includes(window.__3D_STATE__.currentMove)",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterA_position.y) && !isNaN(window.__3D_STATE__.characterB_position.y)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.beatCount >= 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim() === 'Play'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.beatCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__frozen_elapsed = window.__3D_STATE__.elapsedTime; window.__frozen_beatCount = window.__3D_STATE__.beatCount;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === window.__frozen_elapsed",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.beatCount === window.__frozen_beatCount",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.characterA_position.x) && !isNaN(window.__3D_STATE__.characterA_position.y) && !isNaN(window.__3D_STATE__.characterA_position.z)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beatCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.moveIndex === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentMove === 'sway'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L1"
          },
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim() === 'Play'",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}