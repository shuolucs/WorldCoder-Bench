{
  "task_id": "P246_rhythm_game_with_3d_track_with_save_load",
  "affordances": [
    {
      "id": "A1",
      "name": "Duck Avatar",
      "type": "3d_object",
      "semantic": "Player receptor duck model on the track",
      "locator_hints": [
        "GLTFLoader Duck.glb",
        "position near z=8"
      ]
    },
    {
      "id": "A2",
      "name": "Note Spheres",
      "type": "3d_object",
      "semantic": "Rhythm note spheres moving along the track",
      "locator_hints": [
        "SphereGeometry radius 0.3",
        "moving along Z"
      ]
    },
    {
      "id": "A3",
      "name": "Track",
      "type": "3d_object",
      "semantic": "The 3D lane track",
      "locator_hints": [
        "PlaneGeometry or BoxGeometry width 4 length 60"
      ]
    },
    {
      "id": "A4",
      "name": "Save Button",
      "type": "dom_element",
      "semantic": "Saves game state to localStorage",
      "locator_hints": [
        "#saveBtn"
      ]
    },
    {
      "id": "A5",
      "name": "Load Button",
      "type": "dom_element",
      "semantic": "Loads game state from localStorage",
      "locator_hints": [
        "#loadBtn"
      ]
    },
    {
      "id": "A6",
      "name": "Reset Button",
      "type": "dom_element",
      "semantic": "Resets game to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "Score Display",
      "type": "dom_element",
      "semantic": "Shows current score",
      "locator_hints": [
        "#scoreDisplay"
      ]
    },
    {
      "id": "A8",
      "name": "Combo Display",
      "type": "dom_element",
      "semantic": "Shows current combo",
      "locator_hints": [
        "#comboDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "Judgment Display",
      "type": "dom_element",
      "semantic": "Shows last hit judgment",
      "locator_hints": [
        "#judgmentDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.duckLane === 1"
      ]
    },
    {
      "id": "S1",
      "name": "Game_Running",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S2",
      "name": "Notes_Appearing",
      "conditions": [
        "window.__3D_STATE__.notesActive > 0",
        "window.__3D_STATE__.notesSpawned > 0"
      ]
    },
    {
      "id": "S3",
      "name": "First_Hit_Registered",
      "conditions": [
        "window.__3D_STATE__.totalNotesHit >= 1",
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.combo >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "Combo_Building",
      "conditions": [
        "window.__3D_STATE__.combo >= 2",
        "window.__3D_STATE__.totalNotesHit >= 2"
      ]
    },
    {
      "id": "S5",
      "name": "Duck_Moved",
      "conditions": [
        "window.__3D_STATE__.duckLane !== 1"
      ]
    },
    {
      "id": "S6",
      "name": "Game_Paused_Mid",
      "conditions": [
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S7",
      "name": "State_Saved",
      "conditions": [
        "window.__3D_STATE__.saveExists === true"
      ]
    },
    {
      "id": "S8",
      "name": "State_Reset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.combo === 0",
        "window.__3D_STATE__.perfectCount === 0",
        "window.__3D_STATE__.greatCount === 0",
        "window.__3D_STATE__.goodCount === 0",
        "window.__3D_STATE__.missCount === 0"
      ]
    },
    {
      "id": "S9",
      "name": "State_Loaded",
      "conditions": [
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.paused === true",
        "window.__3D_STATE__.saveExists === true"
      ]
    },
    {
      "id": "S10",
      "name": "Resumed_After_Load",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.score > 0"
      ]
    },
    {
      "id": "S11",
      "name": "Multiple_Hits_Scored",
      "conditions": [
        "window.__3D_STATE__.totalNotesHit >= 4",
        "window.__3D_STATE__.score >= 200"
      ]
    }
  ],
  "transitions": [
