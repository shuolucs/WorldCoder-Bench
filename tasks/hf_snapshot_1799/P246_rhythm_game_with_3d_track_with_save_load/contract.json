      "action": {
        "type": "script",
        "code": "// Wait for first note (lane 0 at time 1.0) to reach hit zone, then press D\nsetTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'd'})); document.dispatchEvent(new KeyboardEvent('keyup', {key: 'd'})); }, 500);"
