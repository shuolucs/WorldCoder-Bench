{
  "task_id": "P345_advanced_molecular_dynamics_viewer_with_",
  "affordances": [
    {
      "id": "A1",
      "name": "MoleculeGroup",
      "type": "3d_object",
      "semantic": "Group containing all atoms and bonds",
      "locator_hints": [
        "scene.children group with 13 children (7 spheres + 6 cylinders)"
      ]
    },
    {
      "id": "A2",
      "name": "CentralAtom",
      "type": "3d_object",
      "semantic": "Carbon atom at origin",
      "locator_hints": [
        "Sphere at (0,0,0), color 0x333333, radius 1.0"
      ]
    },
    {
      "id": "A3",
      "name": "HydrogenAtoms",
      "type": "3d_object",
      "semantic": "4 hydrogen atoms around center",
      "locator_hints": [
        "White spheres at (±3,0,0) and (0,±3,0)"
      ]
    },
    {
      "id": "A4",
      "name": "OxygenAtoms",
      "type": "3d_object",
      "semantic": "2 oxygen atoms along Z axis",
      "locator_hints": [
        "Red spheres at (0,0,±3)"
      ]
    },
    {
      "id": "A5",
      "name": "StaticButton",
      "type": "dom_element",
      "semantic": "Button to switch to static mode",
      "locator_hints": [
        "#btnStatic"
      ]
    },
    {
      "id": "A6",
      "name": "VibrationButton",
      "type": "dom_element",
      "semantic": "Button to switch to vibration mode",
      "locator_hints": [
        "#btnVibration"
      ]
    },
    {
      "id": "A7",
      "name": "RotationButton",
      "type": "dom_element",
      "semantic": "Button to switch to rotation mode",
      "locator_hints": [
        "#btnRotation"
      ]
    },
    {
      "id": "A8",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all state",
      "locator_hints": [
        "#btnReset"
      ]
    },
    {
      "id": "A9",
      "name": "TemperatureSlider",
      "type": "dom_element",
      "semantic": "Range slider for temperature",
      "locator_hints": [
        "#tempSlider"
      ]
    },
    {
      "id": "A10",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display panel",
      "locator_hints": [
        "#hudPanel"
      ]
    },
    {
      "id": "A11",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "Score readout in HUD",
      "locator_hints": [
        "#scoreDisplay"
      ]
    },
    {
      "id": "A12",
      "name": "AtomsFoundDisplay",
      "type": "dom_element",
      "semantic": "Atoms found counter in HUD",
      "locator_hints": [
        "#atomsFoundDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.mode === 'static'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.atomsFound === 0",
        "window.__3D_STATE__.temperature === 300",
        "window.__3D_STATE__.atomCount === 7",
        "window.__3D_STATE__.bondCount === 6"
      ]
    },
    {
      "id": "S1",
      "name": "VibrationActive",
      "conditions": [
        "window.__3D_STATE__.mode === 'vibration'",
        "window.__3D_STATE__.vibrationAmplitude === 0.5"
      ]
    },
    {
      "id": "S2",
      "name": "RotationActive",
      "conditions": [
        "window.__3D_STATE__.mode === 'rotation'"
      ]
    },
    {
      "id": "S3",
      "name": "AtomClicked",
      "conditions": [
        "window.__3D_STATE__.score >= 10",
        "window.__3D_STATE__.atomsFound >= 1",
        "window.__3D_STATE__.lastClickResult === 'hit'"
      ]
    },
    {
      "id": "S4",
      "name": "MissedClick",
      "conditions": [
        "window.__3D_STATE__.lastClickResult === 'miss'"
      ]
    },
    {
      "id": "S5",
      "name": "TemperatureChanged",
      "conditions": [
        "window.__3D_STATE__.temperature !== 300"
      ]
    },
    {
      "id": "S6",
      "name": "AllAtomsFound",
      "conditions": [
        "window.__3D_STATE__.allAtomsFound === true",
        "window.__3D_STATE__.atomsFound === 7"
      ]
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.mode === 'static'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.atomsFound === 0",
        "window.__3D_STATE__.temperature === 300"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'static'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnVibration"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'vibration'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vibrationAmplitude - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('modeDisplay').textContent.toLowerCase().includes('vibration')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnRotation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'rotation'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.moleculeRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.moleculeRotationY)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('modeDisplay').textContent.toLowerCase().includes('rotation')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'rotation'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.moleculeRotationY > 1.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.moleculeRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('tempSlider').value = 450; document.getElementById('tempSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 450",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vibrationAmplitude - 0.75) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tempDisplay').textContent.includes('450')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnStatic"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'static'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsFound === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('modeDisplay').textContent.toLowerCase().includes('static')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btnReset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'static'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsFound === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allAtomsFound === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.score >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsFound >= 0 && window.__3D_STATE__.atomsFound <= 7",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.atomsClickedSet)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.atomsClickedSet.length === window.__3D_STATE__.atomsFound",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('scoreDisplay') !== null && document.getElementById('atomsFoundDisplay') !== null",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}