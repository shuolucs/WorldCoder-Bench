{
  "task_id": "P2181_light_probe_spherical_harmonics_visualiz",
  "affordances": [
    {
      "id": "A1",
      "name": "FoxModel",
      "type": "3d_object",
      "semantic": "Loaded Fox.glb model centered at origin, normalized to 2-unit bounding box",
      "locator_hints": [
        "scene.children with type Group or Mesh from GLTF"
      ]
    },
    {
      "id": "A2",
      "name": "SHVisualizationSphere",
      "type": "3d_object",
      "semantic": "Icosahedron sphere at (3,1.5,0) showing SH irradiance via custom shader",
      "locator_hints": [
        "mesh at position x=3"
      ]
    },
    {
      "id": "A3",
      "name": "WireframeOverlay",
      "type": "3d_object",
      "semantic": "Wireframe overlay on SH sphere, togglable",
      "locator_hints": [
        "wireframe mesh near SH sphere"
      ]
    },
    {
      "id": "A4",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Horizontal ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh rotated horizontal"
      ]
    },
    {
      "id": "A5",
      "name": "BandSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select SH band (0, 1, or 2)",
      "locator_hints": [
        "#band-select"
      ]
    },
    {
      "id": "A6",
      "name": "IntensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling light probe intensity [0,3]",
      "locator_hints": [
        "#intensity-slider"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets all SH coefficients and intensity to defaults",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A8",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Randomizes all 9 SH coefficients",
      "locator_hints": [
        "#randomize-btn"
      ]
    },
    {
      "id": "A9",
      "name": "WireframeToggle",
      "type": "dom_element",
      "semantic": "Checkbox toggling wireframe overlay visibility",
      "locator_hints": [
        "#wireframe-toggle"
      ]
    },
    {
      "id": "A10",
      "name": "RotateToggle",
      "type": "dom_element",
      "semantic": "Checkbox toggling continuous fox rotation",
      "locator_hints": [
        "#rotate-toggle"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Default_SH",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.selectedBand === 0",
        "window.__3D_STATE__.probeIntensity === 1.0",
        "window.__3D_STATE__.wireframeVisible === true",
        "window.__3D_STATE__.rotateModel === false"
      ]
    },
    {
      "id": "S2",
      "name": "Band_Changed",
      "conditions": [
        "window.__3D_STATE__.selectedBand !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "Intensity_Modified",
      "conditions": [
        "window.__3D_STATE__.probeIntensity !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "Randomized",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'randomize'"
      ]
    },
    {
      "id": "S5",
      "name": "Reset_To_Default",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'reset'",
        "window.__3D_STATE__.probeIntensity === 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "Wireframe_Hidden",
      "conditions": [
        "window.__3D_STATE__.wireframeVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Model_Rotating",
      "conditions": [
        "window.__3D_STATE__.rotateModel === true"
      ]
    },
    {
      "id": "S8",
      "name": "Band_Cycled_Via_Keyboard",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'band_cycle'"
      ]
    },
    {
      "id": "S9",
      "name": "Post_Rotation_Verified",
      "conditions": [
        "window.__3D_STATE__.rotateModel === true",
        "window.__3D_STATE__.modelRotationY > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shCoefficients === 'object' && window.__3D_STATE__.shCoefficients.length === 9",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients[0].r > 0.7 && window.__3D_STATE__.shCoefficients[0].r < 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probeIntensity === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shSpherePosition.x === 3 && window.__3D_STATE__.shSpherePosition.y === 1.5 && window.__3D_STATE__.shSpherePosition.z === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.max(window.__3D_STATE__.foxBoundingBoxSize.x, window.__3D_STATE__.foxBoundingBoxSize.y, window.__3D_STATE__.foxBoundingBoxSize.z) <= 2.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#band-select').value = document.querySelector('#band-select').options[1].value; document.querySelector('#band-select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedBand === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedBand === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastAction !== 'init'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.length === 9",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.coefficientSum) && isFinite(window.__3D_STATE__.coefficientSum)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let slider = document.querySelector('#intensity-slider'); slider.value = 2.5; slider.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.probeIntensity - 2.5) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.probeIntensity > 0 && window.__3D_STATE__.probeIntensity <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.probeIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.probeIntensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#randomize-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'randomize'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.every(c => c.r >= -1 && c.r <= 1 && c.g >= -1 && c.g <= 1 && c.b >= -1 && c.b <= 1)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.every(c => !isNaN(c.r) && !isNaN(c.g) && !isNaN(c.b))",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.coefficientSum - window.__3D_STATE__.shCoefficients.reduce((s,c) => s + Math.abs(c.r) + Math.abs(c.g) + Math.abs(c.b), 0)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients[0].r !== 0.8 || window.__3D_STATE__.shCoefficients[0].g !== 0.75",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'reset'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.probeIntensity - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shCoefficients[0].r - 0.8) < 0.01 && Math.abs(window.__3D_STATE__.shCoefficients[0].g - 0.75) < 0.01 && Math.abs(window.__3D_STATE__.shCoefficients[0].b - 0.65) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.shCoefficients[2].r - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBand === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_wireframe'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.wireframeVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let cb = document.querySelector('#rotate-toggle'); cb.checked = true; cb.dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotateModel === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'toggle_rotate'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotateModel === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelRotationY > 0.3",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.modelRotationY) && isFinite(window.__3D_STATE__.modelRotationY)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'band_cycle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedBand === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedBand === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBand >= 0 && window.__3D_STATE__.selectedBand <= 2",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#band-select').selectedIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: 'r'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'randomize'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.every(c => !isNaN(c.r) && !isNaN(c.g) && !isNaN(c.b))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shCoefficients.every(c => c.r >= -1 && c.r <= 1 && c.g >= -1 && c.g <= 1 && c.b >= -1 && c.b <= 1)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.coefficientSum - window.__3D_STATE__.shCoefficients.reduce((s,c) => s + Math.abs(c.r) + Math.abs(c.g) + Math.abs(c.b), 0)) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coefficientSum >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}