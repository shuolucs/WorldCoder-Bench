  "states": [
    {
      "id": "S0",
      "name": "Initial_Explore",
      "conditions": [
        "window.__3D_STATE__.quizActive === false",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S1",
      "name": "Parrot_Loaded",
      "conditions": [
        "window.__3D_STATE__.parrotLoaded === true",
        "window.__3D_STATE__.elementsCount === 18"
      ]
    },
    {
      "id": "S2",
      "name": "Element_Info_Shown",
      "conditions": [
        "window.__3D_STATE__.elementInfoVisible === true",
        "window.__3D_STATE__.selectedElement !== null"
      ]
    },
    {
      "id": "S3",
      "name": "Quiz_Active",
      "conditions": [
        "window.__3D_STATE__.quizActive === true",
        "window.__3D_STATE__.currentQuestionElement !== null",
        "window.__3D_STATE__.currentQuestionType >= 1",
        "window.__3D_STATE__.currentQuestionType <= 3"
      ]
    },
    {
      "id": "S4",
      "name": "Correct_Answer",
      "conditions": [
        "window.__3D_STATE__.lastAnswerCorrect === true",
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.streak >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Wrong_Answer",
      "conditions": [
        "window.__3D_STATE__.lastAnswerCorrect === false",
        "window.__3D_STATE__.lives < 3"
      ]
    },
    {
      "id": "S6",
      "name": "Help_Visible",
      "conditions": [
        "window.__3D_STATE__.helpVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Game_Over",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.lives === 0"
      ]
    },
    {
      "id": "S8",
      "name": "Quiz_Reset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.lives === 3",
        "window.__3D_STATE__.streak === 0",
        "window.__3D_STATE__.questionsAnswered === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const boxes = window.__3D_STATE__; /* simulate clicking an element in explore mode - click on the first element in the scene */ const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const event = new MouseEvent('click', {clientX: rect.left + 50, clientY: rect.top + rect.height/2, bubbles: true}); canvas.dispatchEvent(event);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#start-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('question-display').textContent.length > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate correct answer by reading current question and clicking the right element or option */ const state = window.__3D_STATE__; const sym = state.currentQuestionElement; const qtype = state.currentQuestionType; if (qtype === 3) { const btns = [document.getElementById('option-0'), document.getElementById('option-1'), document.getElementById('option-2'), document.getElementById('option-3')]; for (let b of btns) { if (b && b.dataset && b.dataset.correct === 'true') { b.click(); break; } } } else { /* For element click questions, dispatch a custom event or use exposed helper */ if (window.__quizAnswer) { window.__quizAnswer(sym); } else { /* Try clicking correct option if available */ const btns = document.querySelectorAll('[data-symbol=\"' + sym + '\"]'); if (btns.length > 0) btns[0].click(); } }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Simulate wrong answer by clicking an incorrect element */ const state = window.__3D_STATE__; const sym = state.currentQuestionElement; const qtype = state.currentQuestionType; if (qtype === 3) { const btns = [document.getElementById('option-0'), document.getElementById('option-1'), document.getElementById('option-2'), document.getElementById('option-3')]; for (let b of btns) { if (b && b.dataset && b.dataset.correct !== 'true') { b.click(); break; } } } else { if (window.__quizWrongAnswer) { window.__quizWrongAnswer(); } }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('help-panel') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Force lives to 0 by answering wrong repeatedly */ window.__3D_STATE__.lives = 0; window.__3D_STATE__.gameOver = true; if (document.getElementById('game-over-overlay')) { document.getElementById('game-over-overlay').style.display = 'flex'; }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('game-over-overlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('game-over-overlay').style.display === 'flex' || document.getElementById('game-over-overlay').style.display === 'block'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#reset-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
