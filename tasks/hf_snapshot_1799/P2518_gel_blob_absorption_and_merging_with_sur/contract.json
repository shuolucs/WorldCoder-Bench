{
  "task_id": "P2518_gel_blob_absorption_and_merging_with_sur",
  "affordances": [
    {
      "id": "A1",
      "name": "GelBlob",
      "type": "3d_object",
      "semantic": "Translucent gel blob with soft-body deformation",
      "locator_hints": [
        "mesh with MeshPhysicalMaterial and transmission",
        "sphere geometry with 32+ segments"
      ]
    },
    {
      "id": "A2",
      "name": "CorsetModel",
      "type": "3d_object",
      "semantic": "Loaded Corset.glb model that absorbs gel blobs",
      "locator_hints": [
        "GLTF loaded model at origin",
        "semi-transparent mesh group"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Dark reflective ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry at y=0"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing blob count, mass, gravity, tension, absorbed count, FPS",
      "locator_hints": [
        "position:fixed or position:absolute top-left div",
        "monospace font white text"
      ]
    },
    {
      "id": "A5",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas for click interactions",
      "locator_hints": [
        "canvas element",
        "renderer.domElement"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false || window.__3D_STATE__.modelLoaded === undefined"
      ]
    },
    {
      "id": "S1",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.blobCount === 3",
        "window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.surfaceTensionLevel === 'medium'"
      ]
    },
    {
      "id": "S2",
      "name": "GravityDisabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "GravityReEnabled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "TensionCycled",
      "conditions": [
        "window.__3D_STATE__.surfaceTensionLevel === 'high'"
      ]
    },
    {
      "id": "S5",
      "name": "BlobSpawned",
      "conditions": [
        "window.__3D_STATE__.blobCount >= 4"
      ]
    },
    {
      "id": "S6",
      "name": "ForcedMerge",
      "conditions": [
        "window.__3D_STATE__.mergeCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.blobCount === 3",
        "window.__3D_STATE__.absorbedCount === 0",
        "window.__3D_STATE__.mergeCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount === 3",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalMass >= 2.99 && window.__3D_STATE__.totalMass <= 3.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blobs) && window.__3D_STATE__.blobs.length === 3",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.x) && !isNaN(b.y) && !isNaN(b.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.velocityY))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount >= 1 && window.__3D_STATE__.blobCount <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.surfaceTensionLevel === 'medium'",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMass > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => typeof b.mass === 'number' && b.mass > 0)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.surfaceTensionLevel === 'high'",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.surfaceTensionValue === 0.9",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => typeof b.radius === 'number' && b.radius > 0)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalMass === window.__3D_STATE__.blobs.reduce((s, b) => s + b.mass, 0)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const prevCount = window.__3D_STATE__.blobCount; const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', { clientX: rect.left + rect.width / 2, clientY: rect.top + rect.height / 2, bubbles: true }); canvas.dispatchEvent(evt); window.__test_prevBlobCount = prevCount; })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blobCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount <= 10",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blobs) && window.__3D_STATE__.blobs.length === window.__3D_STATE__.blobCount",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => b.radius > 0 && b.radius < 2)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMass >= window.__3D_STATE__.blobCount * 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { window.__test_preMergeCount = window.__3D_STATE__.blobCount; window.__test_preMergeMass = window.__3D_STATE__.totalMass; const blobs = window.__3D_STATE__.blobs; if (blobs.length >= 2) { blobs[0].x = blobs[1].x; blobs[0].y = blobs[1].y; blobs[0].z = blobs[1].z; } document.dispatchEvent(new KeyboardEvent('keydown', {key: 'm', bubbles: true})); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mergeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobCount < window.__test_preMergeCount || window.__3D_STATE__.mergeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalMass - window.__test_preMergeMass) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => !isNaN(b.x) && !isNaN(b.y) && !isNaN(b.z) && !isNaN(b.radius))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.blobCount === 3",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.absorbedCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.mergeCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalMass >= 2.99 && window.__3D_STATE__.totalMass <= 3.01",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.blobs) && window.__3D_STATE__.blobs.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.blobs.every(b => b.absorbed === false && b.mass >= 0.99 && b.mass <= 1.01)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}