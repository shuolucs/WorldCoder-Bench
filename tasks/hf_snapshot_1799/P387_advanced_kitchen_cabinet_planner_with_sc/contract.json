  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.selectedType === null",
        "window.__3D_STATE__.layoutRating === 'Incomplete'",
        "window.__3D_STATE__.theme === 'classic'"
      ]
    },
    {
      "id": "S1",
      "name": "BaseCabinetSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'base'"
      ]
    },
    {
      "id": "S2",
      "name": "FirstCabinetPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 1",
        "window.__3D_STATE__.coverageScore === 4",
        "window.__3D_STATE__.varietyCount === 1"
      ]
    },
    {
      "id": "S3",
      "name": "MultipleCabinetsPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount >= 3",
        "window.__3D_STATE__.varietyCount >= 2",
        "window.__3D_STATE__.score >= 22"
      ]
    },
    {
      "id": "S4",
      "name": "DoorsOpened",
      "conditions": [
        "window.__3D_STATE__.doorsOpen === true"
      ]
    },
    {
      "id": "S5",
      "name": "ThemeChanged",
      "conditions": [
        "window.__3D_STATE__.theme === 'modern'"
      ]
    },
    {
      "id": "S6",
      "name": "HighScoreLayout",
      "conditions": [
        "window.__3D_STATE__.cabinetCount >= 5",
        "window.__3D_STATE__.score >= 30",
        "window.__3D_STATE__.layoutRating !== 'Incomplete'"
      ]
    },
    {
      "id": "S7",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.layoutRating === 'Incomplete'"
      ]
    }
  ],
