    },
    {
      "id": "S1",
      "name": "ParcelSelected",
      "conditions": [
        "window.__3D_STATE__.selectedParcel !== null",
        "window.__3D_STATE__.selectedParcel.row >= 0 && window.__3D_STATE__.selectedParcel.row <= 9",
        "window.__3D_STATE__.selectedParcel.col >= 0 && window.__3D_STATE__.selectedParcel.col <= 9"
      ]
    },
    {
      "id": "S2",
      "name": "OneBuildingPlaced",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 1",
        "window.__3D_STATE__.buildings.length === 1",
        "window.__3D_STATE__.buildings[0].floors === 3",
        "window.__3D_STATE__.buildings[0].height === 12"
      ]
    },
    {
      "id": "S3",
      "name": "BuildingFloorsIncreased",
      "conditions": [
