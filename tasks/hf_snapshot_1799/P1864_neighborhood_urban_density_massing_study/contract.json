    },
    {
      "id": "S4",
      "name": "BuildingFloorsDecreased",
      "conditions": [
        "window.__3D_STATE__.selectedBuildingFloors < window.__3D_STATE__.maxHeight / 4 || window.__3D_STATE__.selectedBuildingFloors >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "ZoneChanged",
      "conditions": [
