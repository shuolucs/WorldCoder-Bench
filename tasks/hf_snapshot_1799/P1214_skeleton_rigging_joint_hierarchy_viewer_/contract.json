        "code": "const state = window.__3D_STATE__; const jointNames = Object.keys(state.jointWorldPositions || {}); const chestJoint = jointNames.find(n => n.toLowerCase().includes('chest')); if(chestJoint) { const pos = state.jointWorldPositions[chestJoint]; const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const THREE = window.THREE || {Vector3: class{}}; const camera = window.__camera || document.querySelector('canvas').__camera; /* Simulate click via script */ if(window.__selectJoint) { window.__selectJoint(chestJoint); } else { canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.width/2, clientY: rect.height/3, bubbles: true})); } }"
