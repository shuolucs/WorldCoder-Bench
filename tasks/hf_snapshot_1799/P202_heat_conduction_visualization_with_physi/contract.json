{
  "task_id": "P202_heat_conduction_visualization_with_physi",
  "affordances": [
    {
      "id": "A1",
      "name": "MetalBarSegments",
      "type": "3d_object",
      "semantic": "Row of 20 box segments representing the discretized metal bar",
      "locator_hints": [
        "20 box meshes along X-axis",
        "children of scene or a group"
      ]
    },
    {
      "id": "A2",
      "name": "ToggleHeatButton",
      "type": "dom_element",
      "semantic": "Button to toggle the heat source on/off",
      "locator_hints": [
        "#toggleHeatBtn"
      ]
    },
    {
      "id": "A3",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug overlay showing temperatures and sim state",
      "locator_hints": [
        "#debugOverlay"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing source and pause status",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A5",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for raycasting clicks",
      "locator_hints": [
        "canvas",
        "renderer.domElement"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_AllCool",
      "conditions": [
        "window.__3D_STATE__.heatSourceActive === false",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.debugVisible === false",
        "window.__3D_STATE__.segmentCount === 20",
        "Math.abs(window.__3D_STATE__.totalEnergy - 400) < 1"
      ]
    },
    {
      "id": "S1",
      "name": "HeatSourceActivated",
      "conditions": [
        "window.__3D_STATE__.heatSourceActive === true",
        "window.__3D_STATE__.temperatures[0] === 200"
      ]
    },
    {
      "id": "S2",
      "name": "HeatConducting",
      "conditions": [
        "window.__3D_STATE__.heatSourceActive === true",
        "window.__3D_STATE__.temperatures[1] > 20",
        "window.__3D_STATE__.totalEnergy > 400"
      ]
    },
    {
      "id": "S3",
      "name": "DebugVisible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.heatSourceActive === false",
        "Math.abs(window.__3D_STATE__.totalEnergy - 400) < 1",
        "window.__3D_STATE__.temperatures[0] >= 19 && window.__3D_STATE__.temperatures[0] <= 21"
      ]
    },
    {
      "id": "S7",
      "name": "HotSpotPlaced",
      "conditions": [
        "window.__3D_STATE__.clickedSegmentIndex !== null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleHeatBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatSourceActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[0] === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[19] === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatures[0] === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[1] > 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[5] > 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 450",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures.every(t => !isNaN(t) && t >= 0 && t <= 300)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.debugVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('debugOverlay') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('debugOverlay').style.display !== 'none' || document.getElementById('debugOverlay').style.visibility !== 'hidden'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatSourceActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures.every(t => !isNaN(t) && t >= 0 && t <= 300)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const savedTime = window.__3D_STATE__.simTime; const savedEnergy = window.__3D_STATE__.totalEnergy; window.__testSavedTime = savedTime; window.__testSavedEnergy = savedEnergy; return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatSourceActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatSourceActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[0] >= 19 && window.__3D_STATE__.temperatures[0] <= 21",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[10] >= 19 && window.__3D_STATE__.temperatures[10] <= 21",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatures[19] >= 19 && window.__3D_STATE__.temperatures[19] <= 21",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergy - 400) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const segments = window.__3D_STATE__.temperatures; if(segments && segments.length === 20) { const idx = 10; window.__3D_STATE__.temperatures[idx] = 150; window.__3D_STATE__.clickedSegmentIndex = idx; } return true;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatures[10] >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clickedSegmentIndex === 10 || window.__3D_STATE__.clickedSegmentIndex === null",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}