{
  "task_id": "P2463_gas_chromatography_retention_time_peak_a",
  "affordances": [
    {
      "id": "A1",
      "name": "RedVial",
      "type": "3d_object",
      "semantic": "Red sample vial in the rack (index 0)",
      "locator_hints": [
        "red colored cylinder/mesh in vial rack",
        "first vial from left"
      ]
    },
    {
      "id": "A2",
      "name": "GreenVial",
      "type": "3d_object",
      "semantic": "Green sample vial in the rack (index 1)",
      "locator_hints": [
        "green colored cylinder/mesh in vial rack",
        "second vial"
      ]
    },
    {
      "id": "A3",
      "name": "BlueVial",
      "type": "3d_object",
      "semantic": "Blue sample vial in the rack (index 2)",
      "locator_hints": [
        "blue colored cylinder/mesh in vial rack",
        "third vial"
      ]
    },
    {
      "id": "A4",
      "name": "InjectButton",
      "type": "dom_element",
      "semantic": "Button to inject selected sample into GC",
      "locator_hints": [
        "#inject-btn"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the instrument and chromatogram",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A6",
      "name": "ChromatogramMonitor",
      "type": "3d_object",
      "semantic": "Monitor displaying the chromatogram plot",
      "locator_hints": [
        "flat screen behind instrument",
        "emissive front face mesh"
      ]
    },
    {
      "id": "A7",
      "name": "PeakInfoPanel",
      "type": "dom_element",
      "semantic": "Panel showing selected peak details",
      "locator_hints": [
        "#peak-info"
      ]
    },
    {
      "id": "A8",
      "name": "OvenTempOverlay",
      "type": "dom_element",
      "semantic": "Oven temperature display overlay",
      "locator_hints": [
        "#oven-temp"
      ]
    },
    {
      "id": "A9",
      "name": "StatusBar",
      "type": "dom_element",
      "semantic": "Status bar showing run state",
      "locator_hints": [
        "#status-bar"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.selectedVial === null",
        "window.__3D_STATE__.runState === 'idle'",
        "window.__3D_STATE__.sweepProgress === 0",
        "window.__3D_STATE__.detectedPeaks.length === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Vial_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedVial !== null",
        "window.__3D_STATE__.runState === 'idle'"
      ]
    },
    {
      "id": "S2",
      "name": "Run_In_Progress",
      "conditions": [
        "window.__3D_STATE__.runState === 'running'",
        "window.__3D_STATE__.sweepProgress > 0",
        "window.__3D_STATE__.sweepProgress < 1"
      ]
    },
    {
      "id": "S3",
      "name": "Run_Complete",
      "conditions": [
        "window.__3D_STATE__.runState === 'complete'",
        "window.__3D_STATE__.sweepProgress === 1",
        "window.__3D_STATE__.detectedPeaks.length > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Peak_Selected",
      "conditions": [
        "window.__3D_STATE__.runState === 'complete'",
        "window.__3D_STATE__.selectedPeakIndex !== null"
      ]
    },
    {
      "id": "S5",
      "name": "Peak_Detection_Active",
      "conditions": [
        "window.__3D_STATE__.peakDetectionMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "Oven_Temp_Visible",
      "conditions": [
        "window.__3D_STATE__.ovenTempVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_To_Idle",
      "conditions": [
        "window.__3D_STATE__.selectedVial === null",
        "window.__3D_STATE__.runState === 'idle'",
        "window.__3D_STATE__.detectedPeaks.length === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "A1",
        "description": "Click the red vial to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedVial === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedVial === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sweepProgress === 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.detectedPeaks)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#inject-btn",
        "description": "Click Inject Sample button to start the GC run"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.runState === 'running'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedVial === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sweepProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sweepProgress >= 0 && window.__3D_STATE__.sweepProgress <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ovenTemperature !== undefined && !isNaN(window.__3D_STATE__.ovenTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 12000,
        "description": "Wait for the chromatogram sweep to complete (~10s + buffer)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.runState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sweepProgress === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks.length === 3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.detectedPeaks[0].retentionTime - 3.2) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.detectedPeaks[1].retentionTime - 7.8) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalPeakArea - window.__3D_STATE__.detectedPeaks.reduce((s,p) => s + p.height * p.width * Math.sqrt(2 * Math.PI), 0)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedPeakIndex = 1;",
        "description": "Select the second peak (highest peak at ~7.8 min) programmatically"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks[1] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.detectedPeaks[1].retentionTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks[1].height > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.detectedPeaks[1].width)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "a",
        "description": "Press 'A' to toggle automatic peak detection mode on"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.peakDetectionMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runState === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks.every(p => typeof p.retentionTime === 'number' && typeof p.height === 'number')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.baselineNoise >= 0 && window.__3D_STATE__.baselineNoise <= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t",
        "description": "Press 'T' to toggle oven temperature display"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ovenTempVisible === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.ovenTemperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ovenTemperature === 150",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedVial === 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.ovenTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#reset-btn",
        "description": "Click Reset button to clear everything and return to idle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedVial === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sweepProgress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedPeakIndex === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.peakDetectionMode === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S0",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target": "A3",
        "description": "Click the blue vial to select it and verify different sample configuration"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedVial === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runState === 'idle'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedVial === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sweepProgress === 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}