            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectMaterials) && window.__3D_STATE__.objectMaterials.length === 3",
            "tier": "L0"
          },
          {
