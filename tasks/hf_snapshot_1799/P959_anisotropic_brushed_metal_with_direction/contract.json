        "window.__3D_STATE__.anisotropyStrength !== 0.8"
      ]
    },
    {
      "id": "S3",
      "name": "ObjectSelected",
      "conditions": [
        "window.__3D_STATE__.selectedObjectIndex >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "PhysicsOverlayVisible",
      "conditions": [
        "window.__3D_STATE__.physicsOverlayVisible === true"
      ]
    },
    {
