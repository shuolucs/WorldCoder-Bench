        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S9",
      "name": "RedoPerformed",
      "conditions": [
        "window.__3D_STATE__.redoStackSize < window.__3D_STATE__._prevRedoStackSize || window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S10",
      "name": "MultiStepComplete",
      "conditions": [
        "window.__3D_STATE__.brushAngleDeg !== 0",
        "window.__3D_STATE__.anisotropyStrength !== 0.8",
        "window.__3D_STATE__.selectedObjectIndex >= 0"
      ]
    }
