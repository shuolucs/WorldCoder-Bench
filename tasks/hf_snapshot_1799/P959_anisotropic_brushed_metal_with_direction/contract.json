          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tangentDirection.x - Math.cos(45 * Math.PI / 180)) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tangentDirection.y - Math.sin(45 * Math.PI / 180)) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tangentDirection.x * window.__3D_STATE__.tangentDirection.x + window.__3D_STATE__.tangentDirection.y * window.__3D_STATE__.tangentDirection.y - 1.0) < 0.0001",
            "tier": "L2"
