{
  "task_id": "P488_volumetric_cloud_sculptor_with_save_load",
  "affordances": [
    {
      "id": "A1",
      "name": "AddCloudButton",
      "type": "dom_element",
      "semantic": "Button to add a new cloud to the scene",
      "locator_hints": [
        "text='Add Cloud'",
        "button"
      ]
    },
    {
      "id": "A2",
      "name": "DeleteCloudButton",
      "type": "dom_element",
      "semantic": "Button to delete the selected cloud",
      "locator_hints": [
        "text='Delete Cloud'",
        "button"
      ]
    },
    {
      "id": "A3",
      "name": "SaveButton",
      "type": "dom_element",
      "semantic": "Button to save cloud state to localStorage",
      "locator_hints": [
        "text='Save'",
        "button"
      ]
    },
    {
      "id": "A4",
      "name": "LoadButton",
      "type": "dom_element",
      "semantic": "Button to load cloud state from localStorage",
      "locator_hints": [
        "text='Load'",
        "button"
      ]
    },
    {
      "id": "A5",
      "name": "ClearAllButton",
      "type": "dom_element",
      "semantic": "Button to remove all clouds",
      "locator_hints": [
        "text='Clear All'",
        "button"
      ]
    },
    {
      "id": "A6",
      "name": "CloudObjects",
      "type": "3d_object",
      "semantic": "Cloud groups in the 3D scene made of clustered spheres",
      "locator_hints": [
        "mesh groups with transparent white spheres"
      ]
    },
    {
      "id": "A7",
      "name": "InfoDisplay",
      "type": "dom_element",
      "semantic": "HUD showing cloud count and selected cloud info",
      "locator_hints": [
        "text containing 'Clouds:'"
      ]
    },
    {
      "id": "A8",
      "name": "ScaleKeys",
      "type": "dom_element",
      "semantic": "Keyboard + and - for scaling",
      "locator_hints": [
        "keyboard '+' and '-'"
      ]
    },
    {
      "id": "A9",
      "name": "DensityKey",
      "type": "dom_element",
      "semantic": "Keyboard D for density cycling",
      "locator_hints": [
        "keyboard 'D' or 'd'"
      ]
    },
    {
      "id": "A10",
      "name": "OpacityKey",
      "type": "dom_element",
      "semantic": "Keyboard O for opacity cycling",
      "locator_hints": [
        "keyboard 'O' or 'o'"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.isInitialized === true",
        "window.__3D_STATE__.cloudCount === 3",
        "window.__3D_STATE__.selectedCloudId === null"
      ]
    },
    {
      "id": "S1",
      "name": "CloudAdded",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 4"
      ]
    },
    {
      "id": "S2",
      "name": "CloudSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCloudId !== null",
        "window.__3D_STATE__.selectedCloudScale !== null"
      ]
    },
    {
      "id": "S3",
      "name": "CloudScaled",
      "conditions": [
        "window.__3D_STATE__.selectedCloudScale >= 0.2",
        "window.__3D_STATE__.selectedCloudScale <= 3.0"
      ]
    },
    {
      "id": "S4",
      "name": "DensityChanged",
      "conditions": [
        "[6,12,18,24].includes(window.__3D_STATE__.selectedCloudDensity)"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.lastSavedJSON !== null",
        "window.__3D_STATE__.lastSaveTimestamp !== null"
      ]
    },
    {
      "id": "S6",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.cloudCount === 0",
        "window.__3D_STATE__.selectedCloudId === null"
      ]
    },
    {
      "id": "S7",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.cloudCount > 0",
        "window.__3D_STATE__.lastLoadTimestamp !== null"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Add Cloud"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.every(c => c.x >= -20 && c.x <= 20)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.every(c => c.y >= 5 && c.y <= 25)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.every(c => !isNaN(c.x) && !isNaN(c.y) && !isNaN(c.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const state = window.__3D_STATE__; const firstCloud = state.clouds[0]; window.__SELECT_CLOUD__ && window.__SELECT_CLOUD__(firstCloud.id); if(!window.__SELECT_CLOUD__) { const event = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); document.querySelector('canvas').dispatchEvent(event); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCloudId !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudDensity !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudOpacity !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedCloudScale === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "+"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedCloudScale >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.selectedCloudScale)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.find(c => c.id === window.__3D_STATE__.selectedCloudId).scale === window.__3D_STATE__.selectedCloudScale",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "[6, 12, 18, 24].includes(window.__3D_STATE__.selectedCloudDensity)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudId !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.clouds.find(c => c.id === window.__3D_STATE__.selectedCloudId).density === window.__3D_STATE__.selectedCloudDensity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Save"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastSavedJSON !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastSavedJSON === 'string'",
            "tier": "L0"
          },
          {
            "expr": "JSON.parse(window.__3D_STATE__.lastSavedJSON).length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastSaveTimestamp > 0",
            "tier": "L2"
          },
          {
            "expr": "localStorage.getItem('cloudSculptorState') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Clear All"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudId === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudScale === null",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Load"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastLoadTimestamp > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.every(c => c.scale >= 0.2 && c.scale <= 3.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.every(c => [6,12,18,24].includes(c.density))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const delBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Clear All')); if(delBtn) delBtn.click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.clouds.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedCloudId === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isInitialized === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}