{
  "task_id": "P285_real_time_audio_spectrum_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "SpectrumBars",
      "type": "3d_object",
      "semantic": "Grid of 128 3D bars representing audio frequency bins",
      "locator_hints": [
        "16x8 grid of BoxGeometry meshes"
      ]
    },
    {
      "id": "A2",
      "name": "ToggleAudioButton",
      "type": "dom_element",
      "semantic": "Button to start/stop audio playback",
      "locator_hints": [
        "#toggleAudio"
      ]
    },
    {
      "id": "A3",
      "name": "WaveformSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select oscillator waveform type",
      "locator_hints": [
        "#waveformSelect"
      ]
    },
    {
      "id": "A4",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Slider controlling oscillator frequency (100-2000Hz)",
      "locator_hints": [
        "#frequencySlider"
      ]
    },
    {
      "id": "A5",
      "name": "GainSlider",
      "type": "dom_element",
      "semantic": "Slider controlling audio gain (0-100 mapped to 0-1)",
      "locator_hints": [
        "#gainSlider"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleViewButton",
      "type": "dom_element",
      "semantic": "Button cycling through 3 camera preset views",
      "locator_hints": [
        "#toggleView"
      ]
    },
    {
      "id": "A7",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "Panel displaying amplitude, peak bin, and FPS stats",
      "locator_hints": [
        "#statsPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Scene_Ready",
      "conditions": [
        "window.__3D_STATE__.barsInitialized === true",
        "window.__3D_STATE__.barCount === 128",
        "window.__3D_STATE__.audioPlaying === false",
        "window.__3D_STATE__.currentView === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Audio_Playing",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === true",
        "window.__3D_STATE__.averageAmplitude > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Waveform_Changed",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === true",
        "window.__3D_STATE__.waveform !== 'sine'"
      ]
    },
    {
      "id": "S3",
      "name": "Frequency_Changed",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === true",
        "window.__3D_STATE__.frequency !== 440"
      ]
    },
    {
      "id": "S4",
      "name": "Gain_Changed",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === true",
        "window.__3D_STATE__.gain !== 0.3"
      ]
    },
    {
      "id": "S5",
      "name": "View_Rotated",
      "conditions": [
        "window.__3D_STATE__.currentView !== 0"
      ]
    },
    {
      "id": "S6",
      "name": "Audio_Stopped",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === false"
      ]
    },
    {
      "id": "S7",
      "name": "Gain_Zeroed",
      "conditions": [
        "window.__3D_STATE__.audioPlaying === true",
        "window.__3D_STATE__.gain === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleAudio"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('waveformSelect').value = 'square'; document.getElementById('waveformSelect').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('frequencySlider'); slider.value = 1000; slider.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('gainSlider'); slider.value = 80; slider.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleView"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var slider = document.getElementById('gainSlider'); slider.value = 0; slider.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleAudio"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}