  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.objectDistance === 7",
        "window.__3D_STATE__.raysVisible === true",
        "window.__3D_STATE__.lightSourceX === -7"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "FocalLengthChanged",
      "conditions": [
        "window.__3D_STATE__.focalLength !== 3"
      ]
    },
    {
      "id": "S3",
      "name": "LightSourceMoved",
      "conditions": [
        "window.__3D_STATE__.lightSourceX !== -7"
      ]
    },
    {
      "id": "S4",
      "name": "RaysHidden",
      "conditions": [
        "window.__3D_STATE__.raysVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.focalLength === 3",
        "window.__3D_STATE__.lightSourceX === -7",
        "window.__3D_STATE__.raysVisible === true"
      ]
    }
  ],
