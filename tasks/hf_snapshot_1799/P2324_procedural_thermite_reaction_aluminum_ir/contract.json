  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.phase === 'IDLE'",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.reactionStarted === false"
      ]
    },
    {
      "id": "S1",
      "name": "Ignition_Phase",
      "conditions": [
        "window.__3D_STATE__.phase === 'IGNITION'",
