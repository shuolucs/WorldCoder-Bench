        "window.__3D_STATE__.coolingRate < 0"
      ]
    },
    {
      "id": "S5",
      "name": "Complete_Phase",
      "conditions": [
        "window.__3D_STATE__.phase === 'COMPLETE'",
        "window.__3D_STATE__.temperature <= 200"
      ]
    },
    {
      "id": "S6",
