        "window.__3D_STATE__.temperature <= 500",
        "window.__3D_STATE__.reactionStarted === true"
      ]
    },
    {
      "id": "S2",
      "name": "Peak_Reaction_Phase",
      "conditions": [
        "window.__3D_STATE__.phase === 'PEAK_REACTION'",
        "window.__3D_STATE__.temperature > 500",
        "window.__3D_STATE__.activeSparkCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Molten_Flow_Phase",
      "conditions": [
        "window.__3D_STATE__.phase === 'MOLTEN_FLOW'",
        "window.__3D_STATE__.moltenIronScale > 0",
        "window.__3D_STATE__.temperature >= 2400"
      ]
    },
    {
      "id": "S4",
      "name": "Cooling_Phase",
      "conditions": [
        "window.__3D_STATE__.phase === 'COOLING'",
