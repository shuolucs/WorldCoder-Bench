      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const c = document.querySelector('canvas'); const r = c.getBoundingClientRect(); const cx = r.left + r.width/2; const cy = r.top + r.height/2; c.dispatchEvent(new MouseEvent('click', {clientX: cx, clientY: cy, bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.splashCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastSplashTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastSplashTime === 'number' && !isNaN(window.__3D_STATE__.lastSplashTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dropletCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dropletsSpawnedTotal > 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S1",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 200",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0 && !isNaN(window.__3D_STATE__.fps)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletRadiusAvg === 'number' && window.__3D_STATE__.dropletRadiusAvg >= 0.01 && window.__3D_STATE__.dropletRadiusAvg <= 0.06",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxDropletAge === 'number' && window.__3D_STATE__.maxDropletAge > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dropletsSpawnedTotal >= window.__3D_STATE__.dropletCount",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.dropletCount) && !isNaN(window.__3D_STATE__.refractionStrength) && !isNaN(window.__3D_STATE__.fps) && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          }
        ]
      }
