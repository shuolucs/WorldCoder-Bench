          },
          {
            "expr": "window.__3D_STATE__.rainActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletsSpawnedTotal === 'number' && window.__3D_STATE__.dropletsSpawnedTotal > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletCount === 'number' && !isNaN(window.__3D_STATE__.dropletCount)",
            "tier": "L0"
          }
        ]
