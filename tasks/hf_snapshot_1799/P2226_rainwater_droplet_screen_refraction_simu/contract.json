        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.refractionStrength >= 0.034",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refractionStrength <= 0.08",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.refractionStrength === 'number' && !isNaN(window.__3D_STATE__.refractionStrength)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dropletCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<10;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.refractionStrength >= 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refractionStrength < 0.03",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.refractionStrength === 'number' && !isNaN(window.__3D_STATE__.refractionStrength)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refractionStrength <= 0.08",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          }
        ]
