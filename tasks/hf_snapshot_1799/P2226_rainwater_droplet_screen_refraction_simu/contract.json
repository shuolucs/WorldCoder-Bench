{
  "task_id": "P2226_rainwater_droplet_screen_refraction_simu",
  "affordances": [
    {
      "id": "A1",
      "name": "DamagedHelmet",
      "type": "3d_object",
      "semantic": "GLTF helmet model as the refraction target scene object",
      "locator_hints": [
        "scene.children find mesh",
        "gltf.scene"
      ]
    },
    {
      "id": "A2",
      "name": "RefractionQuad",
      "type": "3d_object",
      "semantic": "Fullscreen quad with custom refraction ShaderMaterial",
      "locator_hints": [
        "fullscreen quad",
        "ShaderMaterial"
      ]
    },
    {
      "id": "A3",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to clear all active droplets",
      "locator_hints": [
        "#clearBtn"
      ]
    },
    {
      "id": "A4",
      "name": "ToggleTrailButton",
      "type": "dom_element",
      "semantic": "Button to toggle trail rendering",
      "locator_hints": [
        "#toggleTrailBtn"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas for click interactions",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.helmetLoaded === false || window.__3D_STATE__.helmetLoaded === true"
      ]
    },
    {
      "id": "S1",
      "name": "Scene_Ready_Rain_Active",
      "conditions": [
        "window.__3D_STATE__.helmetLoaded === true",
        "window.__3D_STATE__.rainActive === true",
        "window.__3D_STATE__.dropletCount > 0",
        "window.__3D_STATE__.frameCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Rain_Paused",
      "conditions": [
        "window.__3D_STATE__.rainActive === false"
      ]
    },
    {
      "id": "S3",
      "name": "Refraction_Increased",
      "conditions": [
        "window.__3D_STATE__.refractionStrength > 0.03"
      ]
    },
    {
      "id": "S4",
      "name": "Refraction_Decreased",
      "conditions": [
        "window.__3D_STATE__.refractionStrength < 0.03"
      ]
    },
    {
      "id": "S5",
      "name": "Burst_Mode_Active",
      "conditions": [
        "window.__3D_STATE__.burstMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "Droplets_Cleared",
      "conditions": [
        "window.__3D_STATE__.dropletCount === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Trails_Disabled",
      "conditions": [
        "window.__3D_STATE__.trailsEnabled === false"
      ]
    },
    {
      "id": "S8",
      "name": "Splash_Triggered",
      "conditions": [
        "window.__3D_STATE__.splashCount > 0",
        "window.__3D_STATE__.lastSplashTime > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Simulation_Running_Steady",
      "conditions": [
        "window.__3D_STATE__.frameCount > 200",
        "window.__3D_STATE__.dropletCount > 0",
        "window.__3D_STATE__.fps > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rainActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dropletCount > 0 && window.__3D_STATE__.dropletCount <= 200",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.refractionStrength === 'number' && !isNaN(window.__3D_STATE__.refractionStrength) && Math.abs(window.__3D_STATE__.refractionStrength - 0.03) < 0.001",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetWidth > 0 && window.__3D_STATE__.renderTargetHeight > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainActive === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletCount === 'number' && !isNaN(window.__3D_STATE__.dropletCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && !isNaN(window.__3D_STATE__.fps)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.trailsEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rainActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dropletsSpawnedTotal === 'number' && window.__3D_STATE__.dropletsSpawnedTotal > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
