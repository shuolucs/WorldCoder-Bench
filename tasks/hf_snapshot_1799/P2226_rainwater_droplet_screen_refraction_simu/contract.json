          },
          {
            "expr": "window.__3D_STATE__.helmetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.frameCount === 'number' && window.__3D_STATE__.frameCount > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S1",
      "to": "S7",
      "severity": "P0",
      "action": {
