      "locator_hints": [
        "scene.children box"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialDefaultState",
      "conditions": [
        "window.__3D_STATE__.crtEnabled === true",
        "window.__3D_STATE__.curvature === 0.3",
        "window.__3D_STATE__.scanlineIntensity === 0.35",
        "window.__3D_STATE__.brightness === 1.1",
        "window.__3D_STATE__.activePreset === 'Custom' || window.__3D_STATE__.activePreset === 'custom'"
      ]
    },
    {
      "id": "S1",
      "name": "CRTDisabled",
      "conditions": [
        "window.__3D_STATE__.crtEnabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "CRTReEnabled",
      "conditions": [
        "window.__3D_STATE__.crtEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "CurvatureAdjusted",
      "conditions": [
        "window.__3D_STATE__.curvature >= 0.7 && window.__3D_STATE__.curvature <= 0.8"
      ]
    },
    {
      "id": "S4",
      "name": "HeavyCRTPresetActive",
      "conditions": [
        "window.__3D_STATE__.curvature === 0.6",
        "window.__3D_STATE__.scanlineIntensity === 0.6",
        "window.__3D_STATE__.activePreset === 'Heavy CRT'"
      ]
    },
    {
      "id": "S5",
      "name": "ArcadePresetActive",
      "conditions": [
        "window.__3D_STATE__.curvature === 0.45",
        "window.__3D_STATE__.scanlineIntensity === 0.5",
        "window.__3D_STATE__.activePreset === 'Arcade'"
      ]
    },
    {
      "id": "S6",
      "name": "RotationPaused",
      "conditions": [
        "window.__3D_STATE__.rotationPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "RotationResumed",
      "conditions": [
        "window.__3D_STATE__.rotationPaused === false"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.curvature === 0.3",
        "window.__3D_STATE__.scanlineIntensity === 0.35",
        "window.__3D_STATE__.brightness === 1.1",
        "window.__3D_STATE__.flickerAmount === 0.03"
      ]
    },
    {
      "id": "S9",
      "name": "CleanPresetActive",
      "conditions": [
        "window.__3D_STATE__.curvature === 0.0",
        "window.__3D_STATE__.scanlineIntensity === 0.0",
        "window.__3D_STATE__.vignetteIntensity === 0.0",
        "window.__3D_STATE__.activePreset === 'Clean'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crtEnabled === true && window.__3D_STATE__.curvature === 0.3 && window.__3D_STATE__.scanlineIntensity === 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeUniform > 0 && !isNaN(window.__3D_STATE__.timeUniform)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.crtEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleCRT').textContent.includes('OFF')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.curvature === 'number' && window.__3D_STATE__.curvature === 0.3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rotationPaused === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleCRT"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.crtEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleCRT').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineCount === 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chromaOffset === 0.003",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glowStrength === 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('sliderCurvature'); let nativeSet = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeSet.call(s, '0.75'); s.dispatchEvent(new Event('input', {bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.curvature >= 0.7 && window.__3D_STATE__.curvature <= 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.curvature - 0.75) < 0.06",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crtEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineIntensity === 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brightness >= 0.5 && window.__3D_STATE__.brightness <= 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'Heavy CRT'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.curvature - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineIntensity - 0.6) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineCount - 400) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chromaOffset - 0.008) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vignetteIntensity - 0.8) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'Arcade'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.curvature - 0.45) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineIntensity - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineCount - 350) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.glowStrength - 0.25) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.brightness - 1.3) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.torusKnotRotationY === 'number' && !isNaN(window.__3D_STATE__.torusKnotRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.crtEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'Arcade'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pausedRotY = window.__3D_STATE__.torusKnotRotationY; document.dispatchEvent(new KeyboardEvent('keydown', {key: ' '})); await new Promise(r => setTimeout(r, 600));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rotationPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.torusKnotRotationY !== window.__pausedRotY",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.torusKnotRotationY - window.__pausedRotY) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeUniform > 0 && !isNaN(window.__3D_STATE__.timeUniform)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.curvature - 0.3) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineIntensity - 0.35) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanlineCount - 300) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chromaOffset - 0.003) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vignetteIntensity - 0.4) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.brightness - 1.1) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "4"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'Clean'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.curvature === 0.0 || Math.abs(window.__3D_STATE__.curvature) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanlineIntensity === 0.0 || Math.abs(window.__3D_STATE__.scanlineIntensity) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.vignetteIntensity === 0.0 || Math.abs(window.__3D_STATE__.vignetteIntensity) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.glowStrength === 0.0 || Math.abs(window.__3D_STATE__.glowStrength) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.brightness - 1.0) < 0.001",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}