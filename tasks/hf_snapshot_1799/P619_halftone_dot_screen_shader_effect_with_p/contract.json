            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.sphereVelocities) && window.__3D_STATE__.sphereVelocities.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spherePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
