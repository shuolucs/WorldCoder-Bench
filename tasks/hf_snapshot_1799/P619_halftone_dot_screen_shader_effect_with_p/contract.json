      "conditions": [
        "window.__3D_STATE__.resetCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "ScaleAdjusted",
      "conditions": [
        "window.__3D_STATE__.scale === 1.5"
      ]
    }
