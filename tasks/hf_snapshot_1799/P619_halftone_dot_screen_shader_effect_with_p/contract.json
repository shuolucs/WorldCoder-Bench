      ]
    },
    {
      "id": "S2",
      "name": "HalftoneDisabled",
      "conditions": [
        "window.__3D_STATE__.halftoneEnabled === false"
      ]
    },
    {
      "id": "S3",
      "name": "HalftoneReEnabled",
      "conditions": [
        "window.__3D_STATE__.halftoneEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "DotSizeIncreased",
      "conditions": [
        "window.__3D_STATE__.dotSize === 5.0"
      ]
    },
    {
      "id": "S5",
      "name": "AngleAdjusted",
      "conditions": [
