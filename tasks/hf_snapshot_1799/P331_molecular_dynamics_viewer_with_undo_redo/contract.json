{
  "task_id": "P331_molecular_dynamics_viewer_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "OxygenAtom",
      "type": "3d_object",
      "semantic": "Red oxygen atom sphere at origin",
      "locator_hints": [
        "red sphere",
        "radius 0.6",
        "position (0,0,0)"
      ]
    },
    {
      "id": "A2",
      "name": "HydrogenAtom1",
      "type": "3d_object",
      "semantic": "White hydrogen atom at (1.2, 0.8, 0)",
      "locator_hints": [
        "white sphere",
        "radius 0.4"
      ]
    },
    {
      "id": "A3",
      "name": "HydrogenAtom2",
      "type": "3d_object",
      "semantic": "White hydrogen atom at (-1.2, 0.8, 0)",
      "locator_hints": [
        "white sphere",
        "radius 0.4"
      ]
    },
    {
      "id": "A4",
      "name": "AddAtomButton",
      "type": "dom_element",
      "semantic": "Button to add a carbon atom",
      "locator_hints": [
        "#addAtom"
      ]
    },
    {
      "id": "A5",
      "name": "RemoveAtomButton",
      "type": "dom_element",
      "semantic": "Button to remove selected atom",
      "locator_hints": [
        "#removeAtom"
      ]
    },
    {
      "id": "A6",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Undo button",
      "locator_hints": [
        "#undoBtn"
      ]
    },
    {
      "id": "A7",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Redo button",
      "locator_hints": [
        "#redoBtn"
      ]
    },
    {
      "id": "A8",
      "name": "ToggleSimButton",
      "type": "dom_element",
      "semantic": "Start/Stop simulation button",
      "locator_hints": [
        "#toggleSim"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Info panel showing atom/bond counts and stack sizes",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialWaterMolecule",
      "conditions": [
        "window.__3D_STATE__.atomCount === 3",
        "window.__3D_STATE__.bondCount === 2",
        "window.__3D_STATE__.selectedAtomIndex === -1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S1",
      "name": "AtomSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAtomIndex >= 0",
        "window.__3D_STATE__.lastAction === 'select'"
      ]
    },
    {
      "id": "S2",
      "name": "AtomMoved",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'move'"
      ]
    },
    {
      "id": "S3",
      "name": "AtomAdded",
      "conditions": [
        "window.__3D_STATE__.atomCount === 4",
        "window.__3D_STATE__.lastAction === 'add'"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S6",
      "name": "AtomRemoved",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'remove'"
      ]
    },
    {
      "id": "S7",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S8",
      "name": "SimulationStopped",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false"
      ]
    },
    {
      "id": "S9",
      "name": "MultipleUndos",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 2",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.length === 3 && window.__3D_STATE__.atoms[0].type === 'O' && window.__3D_STATE__.atoms[1].type === 'H' && window.__3D_STATE__.atoms[2].type === 'H'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "OxygenAtom",
        "description": "Click on the oxygen atom at the center to select it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'select'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('Selected: 0') || document.getElementById('hud').textContent.includes('Selected: O')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].x - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].y - 0.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'move'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy !== undefined && !isNaN(window.__3D_STATE__.totalEnergy) && isFinite(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#undoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].x - 0.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].y - 0.0) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#redoBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.atoms[0].x - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#addAtom"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[3].type === 'C'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[3].x >= -3 && window.__3D_STATE__.atoms[3].x <= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms[3].y >= -3 && window.__3D_STATE__.atoms[3].y <= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'add'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* Select the new carbon atom (index 3) by clicking it, then click removeAtom */ var evt = new MouseEvent('click', {bubbles:true}); document.getElementById('removeAtom').dispatchEvent(evt);",
        "description": "Select the carbon atom then remove it. We assume atom index 3 is selected or we select it first."
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'remove'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtomIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.every(a => !isNaN(a.x) && !isNaN(a.y) && !isNaN(a.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleSim"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleSim').textContent.includes('Stop')",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud').textContent.includes('ON')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleSim"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('toggleSim').textContent.includes('Start')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.every(a => isFinite(a.x) && isFinite(a.y) && isFinite(a.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z",
        "ctrlKey": true,
        "description": "Press Ctrl+Z twice to undo two actions"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atoms.every(a => !isNaN(a.x) && !isNaN(a.y) && !isNaN(a.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount >= 0 && Number.isInteger(window.__3D_STATE__.bondCount)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}