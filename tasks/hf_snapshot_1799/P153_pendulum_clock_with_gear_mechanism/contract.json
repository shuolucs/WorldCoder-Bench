{
  "task_id": "P153_pendulum_clock_with_gear_mechanism",
  "affordances": [
    {
      "id": "A1",
      "name": "ToggleButton",
      "type": "dom_element",
      "semantic": "Start/Stop button for the pendulum simulation",
      "locator_hints": [
        "#toggleBtn"
      ]
    },
    {
      "id": "A2",
      "name": "DampingButton",
      "type": "dom_element",
      "semantic": "Toggle damping on/off",
      "locator_hints": [
        "#dampingBtn"
      ]
    },
    {
      "id": "A3",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed multiplier",
      "locator_hints": [
        "#speedSlider"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets simulation to initial state",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A5",
      "name": "PendulumBob",
      "type": "3d_object",
      "semantic": "Gold sphere at end of pendulum rod, clickable for push",
      "locator_hints": [
        "pendulum bob sphere",
        "gold sphere"
      ]
    },
    {
      "id": "A6",
      "name": "GearMechanism",
      "type": "3d_object",
      "semantic": "Three interlocking gears inside clock",
      "locator_hints": [
        "gear group",
        "escape wheel"
      ]
    },
    {
      "id": "A7",
      "name": "ClockHands",
      "type": "3d_object",
      "semantic": "Hour and minute hands on clock face",
      "locator_hints": [
        "minute hand",
        "hour hand"
      ]
    },
    {
      "id": "A8",
      "name": "CoffeematModel",
      "type": "3d_object",
      "semantic": "Loaded GLB coffee machine model on shelf",
      "locator_hints": [
        "coffeemat.glb model"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation values",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Stopped",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.pendulumAmplitude === 0.4",
        "window.__3D_STATE__.swingCount === 0",
        "window.__3D_STATE__.dampingEnabled === false",
        "window.__3D_STATE__.gearsVisible === true"
      ]
    },
    {
      "id": "S1",
      "name": "Running_NoDamping",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.dampingEnabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "Running_Swinging",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.swingCount > 0",
        "window.__3D_STATE__.gear1Rotation !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "Running_WithDamping",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.dampingEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "Amplitude_Decreased",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.dampingEnabled === true",
        "window.__3D_STATE__.pendulumAmplitude < 0.4"
      ]
    },
    {
      "id": "S5",
      "name": "Amplitude_Boosted",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.pendulumAmplitude > 0.4"
      ]
    },
    {
      "id": "S6",
      "name": "Gears_Hidden",
      "conditions": [
        "window.__3D_STATE__.gearsVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.simulationSpeed !== 6"
      ]
    },
    {
      "id": "S8",
      "name": "Paused_MidSwing",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.swingCount > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.pendulumAmplitude === 0.4",
        "window.__3D_STATE__.swingCount === 0",
        "window.__3D_STATE__.gear1Rotation === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngle === 'number' && !isNaN(window.__3D_STATE__.pendulumAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude === 0.4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumOmega - Math.sqrt(9.81/1.5)) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.assetLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.swingCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear1Rotation > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumAmplitude - 0.4) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear2Rotation !== 0 && !isNaN(window.__3D_STATE__.gear2Rotation)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.gear1Rotation * (20/12) - Math.abs(window.__3D_STATE__.gear2Rotation)) / Math.max(Math.abs(window.__3D_STATE__.gear2Rotation), 0.001) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#dampingBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dampingEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude <= 0.4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumEnergy === 'number' && !isNaN(window.__3D_STATE__.pendulumEnergy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pendulumEnergy > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude < 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude > 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime) && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pendulumAngle) <= window.__3D_STATE__.pendulumAmplitude + 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target_hint": "pendulum bob gold sphere",
        "position": "center_of_pendulum_bob"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude > 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude <= 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngle === 'number' && !isNaN(window.__3D_STATE__.pendulumAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gearsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear1Rotation > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.gear3Rotation)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 15; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationSpeed === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.minuteHandAngle === 'number' && !isNaN(window.__3D_STATE__.minuteHandAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.hourHandAngle === 'number' && !isNaN(window.__3D_STATE__.hourHandAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.swingCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngle === 'number' && !isNaN(window.__3D_STATE__.pendulumAngle) && isFinite(window.__3D_STATE__.pendulumAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.gear1Rotation === 'number' && isFinite(window.__3D_STATE__.gear1Rotation)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude === 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.swingCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear1Rotation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear2Rotation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gear3Rotation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minuteHandAngle === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hourHandAngle === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggleBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pendulumAmplitude === 0.4",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.pendulumAngle === 'number' && !isNaN(window.__3D_STATE__.pendulumAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gearsVisible === false",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}