          {
            "expr": "['Spread', 'Folded', 'Glide'].includes(window.__3D_STATE__.currentPose)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoFlap === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pose-btn') !== null && document.getElementById('pose-btn').textContent.length > 0",
            "tier": "L2"
          },
          {
