            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentPose === 'none'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.flapAngle === 'number' && !isNaN(window.__3D_STATE__.flapAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.flapAngle >= -30 && window.__3D_STATE__.flapAngle <= 45",
            "tier": "L2"
          },
