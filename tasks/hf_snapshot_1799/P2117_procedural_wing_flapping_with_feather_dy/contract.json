        "window.__3D_STATE__.flexAmplitude === 15",
        "window.__3D_STATE__.currentPose === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.autoFlap === false",
        "window.__3D_STATE__.currentPose === 'none'"
      ]
    },
    {
      "id": "S2",
      "name": "Speed_Adjusted",
      "conditions": [
        "window.__3D_STATE__.flapSpeed !== 1.5",
        "window.__3D_STATE__.autoFlap === true"
      ]
    },
    {
      "id": "S3",
      "name": "Flex_Adjusted",
      "conditions": [
        "window.__3D_STATE__.flexAmplitude !== 15"
      ]
    },
    {
      "id": "S4",
      "name": "Pose_Active",
      "conditions": [
        "window.__3D_STATE__.currentPose !== 'none'",
        "window.__3D_STATE__.autoFlap === false"
      ]
    },
    {
      "id": "S5",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.flapSpeed === 1.5",
        "window.__3D_STATE__.flexAmplitude === 15",
        "window.__3D_STATE__.autoFlap === true",
        "window.__3D_STATE__.currentPose === 'none'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.featherCount === 16",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoFlap === true && window.__3D_STATE__.flapSpeed === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bodyPosition !== undefined && Math.abs(window.__3D_STATE__.bodyPosition.y - 2.2) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 1.5 && window.__3D_STATE__.cycleCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flapAngle >= -30 && window.__3D_STATE__.flapAngle <= 45",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.flapAngle) && !isNaN(window.__3D_STATE__.leftWingAngle)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leftWingAngle + window.__3D_STATE__.rightWingAngle) < 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wingSpan > 0 && window.__3D_STATE__.wingSpan !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftWingAngle === 'number' && typeof window.__3D_STATE__.rightWingAngle === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
