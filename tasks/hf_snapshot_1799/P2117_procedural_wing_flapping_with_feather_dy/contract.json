      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.flapSpeed >= 1.75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flapSpeed <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoFlap === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-speed') !== null && document.getElementById('hud-speed').textContent.length > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.flapSpeed)",
            "tier": "L2"
          }
