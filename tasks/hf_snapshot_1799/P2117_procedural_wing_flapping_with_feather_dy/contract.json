          {
            "expr": "['Spread', 'Folded', 'Glide'].includes(window.__3D_STATE__.currentPose)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoFlap === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.leftWingAngle) && !isNaN(window.__3D_STATE__.rightWingAngle)",
            "tier": "L2"
