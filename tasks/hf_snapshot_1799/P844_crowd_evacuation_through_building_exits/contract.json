    },
    {
      "id": "S3",
      "name": "Paused_MidEvacuation",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Resumed_After_Pause",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S5",
      "name": "ExitC_Blocked",
