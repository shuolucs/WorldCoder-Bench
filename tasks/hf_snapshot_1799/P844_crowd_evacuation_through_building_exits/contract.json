    },
    {
      "id": "S8",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.agentCount === 50",
        "window.__3D_STATE__.evacuatedTotal === 0",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.running === false"
      ]
    },
    {
      "id": "S9",
      "name": "Partial_Evacuation_Advanced",
      "conditions": [
        "window.__3D_STATE__.evacuatedTotal >= 5",
        "window.__3D_STATE__.running === true"
      ]
    }
  ],
