        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.magnetStrength === 60",
        "window.__3D_STATE__.status === 'Levitating'"
      ]
    },
    {
      "id": "S2",
      "name": "DroppedOscillating",
      "conditions": [
        "window.__3D_STATE__.bustY > 2.5",
        "Math.abs(window.__3D_STATE__.bustVelocity) > 0.1"
      ]
    },
    {
      "id": "S3",
      "name": "EquilibriumReached",
      "conditions": [
        "window.__3D_STATE__.equilibriumReached === true",
        "window.__3D_STATE__.status === 'Levitating'"
      ]
    },
    {
      "id": "S4",
      "name": "MagnetKilled",
      "conditions": [
        "window.__3D_STATE__.magnetStrength === 0",
        "window.__3D_STATE__.status === 'Falling' || window.__3D_STATE__.status === 'Resting'"
      ]
    },
    {
      "id": "S5",
      "name": "BustResting",
      "conditions": [
        "window.__3D_STATE__.bustY <= 0.5",
        "window.__3D_STATE__.status === 'Resting'"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.magnetStrength === 60",
        "window.__3D_STATE__.bustY > 2.0"
      ]
    },
    {
      "id": "S7",
      "name": "SpinDisabled",
      "conditions": [
        "window.__3D_STATE__.isSpinning === false"
      ]
    },
    {
      "id": "S8",
      "name": "HighMagnetStrength",
      "conditions": [
        "window.__3D_STATE__.magnetStrength === 120",
