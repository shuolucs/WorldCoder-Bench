{
  "task_id": "P216_asteroid_defense",
  "affordances": [
    {
      "id": "A1",
      "name": "DefenseStation",
      "type": "3d_object",
      "semantic": "The loaded GLB shoe model acting as the player's defense station at origin",
      "locator_hints": [
        "GLB model at (0,0,0)",
        "MaterialsVariantsShoe.glb"
      ]
    },
    {
      "id": "A2",
      "name": "Asteroid",
      "type": "3d_object",
      "semantic": "Brown icosahedron enemies moving toward the station",
      "locator_hints": [
        "IcosahedronGeometry",
        "brown colored mesh"
      ]
    },
    {
      "id": "A3",
      "name": "Projectile",
      "type": "3d_object",
      "semantic": "Yellow sphere projectiles fired by clicking",
      "locator_hints": [
        "small yellow sphere",
        "SphereGeometry(0.2)"
      ]
    },
    {
      "id": "A4",
      "name": "Shield",
      "type": "3d_object",
      "semantic": "Blue transparent wireframe sphere shield around station",
      "locator_hints": [
        "wireframe sphere",
        "blue transparent"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing score, wave, HP, shield cooldown",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A6",
      "name": "GameOverOverlay",
      "type": "dom_element",
      "semantic": "Centered overlay showing GAME OVER",
      "locator_hints": [
        "div#game-over-overlay"
      ]
    },
    {
      "id": "A7",
      "name": "PauseOverlay",
      "type": "dom_element",
      "semantic": "Overlay showing PAUSED when game is paused",
      "locator_hints": [
        "div#pause-overlay"
      ]
    },
    {
      "id": "A8",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for click interactions",
      "locator_hints": [
        "canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Loading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.wave === 1",
        "window.__3D_STATE__.stationHP === 5",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "AsteroidsSpawned",
      "conditions": [
        "window.__3D_STATE__.asteroidCount > 0",
        "window.__3D_STATE__.gameOver === false"
      ]
    },
    {
      "id": "S3",
      "name": "ProjectileFired",
      "conditions": [
        "window.__3D_STATE__.projectileCount > 0",
        "window.__3D_STATE__.totalShotsFired > 0"
      ]
    },
    {
      "id": "S4",
      "name": "AsteroidDestroyed",
      "conditions": [
        "window.__3D_STATE__.totalAsteroidsDestroyed > 0",
        "window.__3D_STATE__.score >= 100"
      ]
    },
    {
      "id": "S5",
      "name": "ShieldActivated",
      "conditions": [
        "window.__3D_STATE__.shieldActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "ShieldOnCooldown",
      "conditions": [
        "window.__3D_STATE__.shieldActive === false",
        "window.__3D_STATE__.shieldCooldownRemaining > 0"
      ]
    },
    {
      "id": "S7",
      "name": "GamePaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S8",
      "name": "GameResumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S9",
      "name": "Wave2Reached",
      "conditions": [
        "window.__3D_STATE__.wave >= 2"
      ]
    },
    {
      "id": "S10",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.stationHP <= 0"
      ]
    }
  ],
  "transitions": [
