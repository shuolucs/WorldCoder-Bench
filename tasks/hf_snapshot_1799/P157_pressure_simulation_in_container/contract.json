{
  "task_id": "P157_pressure_simulation_in_container",
  "affordances": [
    {
      "id": "A1",
      "name": "Container",
      "type": "3d_object",
      "semantic": "Transparent rectangular container holding gas particles",
      "locator_hints": [
        "wireframe or semi-transparent box at origin"
      ]
    },
    {
      "id": "A2",
      "name": "Piston",
      "type": "3d_object",
      "semantic": "Movable top wall of the container that slides vertically",
      "locator_hints": [
        "flat box at y=4 initially, color #888888"
      ]
    },
    {
      "id": "A3",
      "name": "GasParticles",
      "type": "3d_object",
      "semantic": "50 small spheres representing gas molecules",
      "locator_hints": [
        "small colored spheres inside the container"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay displaying simulation metrics",
      "locator_hints": [
        "div#hud at top-left"
      ]
    },
    {
      "id": "A5",
      "name": "PressureDisplay",
      "type": "dom_element",
      "semantic": "Shows current pressure value",
      "locator_hints": [
        "#pressureDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "TemperatureDisplay",
      "type": "dom_element",
      "semantic": "Shows current temperature value",
      "locator_hints": [
        "#temperatureDisplay"
      ]
    },
    {
      "id": "A7",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Shows Running or Paused status",
      "locator_hints": [
        "#statusDisplay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount === 50",
        "window.__3D_STATE__.pistonY === 4",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.heatBoost === false"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simTime > 0",
        "window.__3D_STATE__.pressure >= 0",
        "window.__3D_STATE__.temperature > 0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S2",
      "name": "PistonLowered",
      "conditions": [
        "window.__3D_STATE__.pistonY < 4",
        "window.__3D_STATE__.volume < 512"
      ]
    },
    {
      "id": "S3",
      "name": "PistonRaised",
      "conditions": [
        "window.__3D_STATE__.pistonY > 4",
        "window.__3D_STATE__.volume > 512"
      ]
    },
    {
      "id": "S4",
      "name": "HeatBoostActive",
      "conditions": [
        "window.__3D_STATE__.heatBoost === true",
        "window.__3D_STATE__.temperature > 0"
      ]
    },
    {
      "id": "S5",
      "name": "HeatBoostDeactivated",
      "conditions": [
        "window.__3D_STATE__.heatBoost === false"
      ]
    },
    {
      "id": "S6",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.pistonY === 4",
        "window.__3D_STATE__.heatBoost === false",
        "window.__3D_STATE__.particleCount === 50"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allParticlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSpeed > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown",
        "repeat": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pistonY === 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume === 8 * (2.5 + 4) * 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pistonClamped === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allParticlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "repeat": 6
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pistonY === 5.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume === 8 * (5.5 + 4) * 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allParticlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatBoost === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgSpeed > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatBoost === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allParticlesInBounds === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusDisplay').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "x": 400,
        "y": 300
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('statusDisplay').textContent.toLowerCase().includes('running')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pistonY === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volume === 8 * 8 * 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatBoost === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.allParticlesInBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlesValid === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}