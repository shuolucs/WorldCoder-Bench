{
  "task_id": "P674_wildfire_containment_strategy",
  "affordances": [
    {
      "id": "A1",
      "name": "TerrainGrid",
      "type": "3d_object",
      "semantic": "20x20 grid of terrain cells representing the landscape",
      "locator_hints": [
        "400 box meshes on XZ plane",
        "children of scene or grid group"
      ]
    },
    {
      "id": "A2",
      "name": "StartPauseButton",
      "type": "dom_element",
      "semantic": "Toggle simulation running/paused",
      "locator_hints": [
        "#btn-toggle-sim"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Reset simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A4",
      "name": "FirebreakTool",
      "type": "dom_element",
      "semantic": "Select firebreak placement tool",
      "locator_hints": [
        "#btn-firebreak"
      ]
    },
    {
      "id": "A5",
      "name": "WaterlineTool",
      "type": "dom_element",
      "semantic": "Select water line placement tool",
      "locator_hints": [
        "#btn-waterline"
      ]
    },
    {
      "id": "A6",
      "name": "AirdropTool",
      "type": "dom_element",
      "semantic": "Select airdrop extinguish tool",
      "locator_hints": [
        "#btn-airdrop"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display with simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A8",
      "name": "WindDirectionDisplay",
      "type": "dom_element",
      "semantic": "Shows current wind direction",
      "locator_hints": [
        "#hud-wind"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.burningCount === 3",
        "window.__3D_STATE__.selectedTool === 'firebreak'",
        "window.__3D_STATE__.windDirection === 'west'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true",
        "window.__3D_STATE__.tickCount >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.tickCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "FirebreakPlaced",
      "conditions": [
        "window.__3D_STATE__.firebreakCount >= 1"
      ]
    },
    {
      "id": "S4",
      "name": "WaterlinePlaced",
      "conditions": [
        "window.__3D_STATE__.waterlineCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "AirdropPerformed",
      "conditions": [
        "window.__3D_STATE__.airdropCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "WindChanged",
      "conditions": [
        "window.__3D_STATE__.windDirection !== 'west'"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.tickInterval !== 1.5"
      ]
    },
    {
      "id": "S8",
      "name": "FireAdvanced",
      "conditions": [
        "window.__3D_STATE__.tickCount >= 4",
        "window.__3D_STATE__.burnedOutCount >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.burningCount === 3",
        "window.__3D_STATE__.burnedOutCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.grid !== 'undefined' && Array.isArray(window.__3D_STATE__.grid) && window.__3D_STATE__.grid.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid[0].length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 0 && window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount === 3 && window.__3D_STATE__.burnedOutCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-sim"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number' && !isNaN(window.__3D_STATE__.tickCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windDirection === 'west'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickInterval === 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-tick') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 3500)); document.getElementById('btn-toggle-sim').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount >= 0 && !isNaN(window.__3D_STATE__.burningCount)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.containmentPct === 'number' && window.__3D_STATE__.containmentPct >= 0 && window.__3D_STATE__.containmentPct <= 100",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-firebreak').click(); window.__3D_STATE__.setCellState(0, 0, 'firebreak');"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedTool === 'firebreak'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.getCellState(0, 0) === 'firebreak'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firebreakCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalActions >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-waterline').click(); window.__3D_STATE__.setCellState(0, 1, 'waterline');"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedTool === 'waterline'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.getCellState(0, 1) === 'waterline'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterlineCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.getCellState(0, 0) === 'firebreak'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalActions >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-airdrop').click(); let burningCells = []; for(let r=0;r<20;r++) for(let c=0;c<20;c++) if(window.__3D_STATE__.getCellState(r,c)==='burning') burningCells.push([r,c]); if(burningCells.length>0){ let t=burningCells[0]; window.__3D_STATE__.setCellState(t[0],t[1],'vegetation'); } window.__3D_STATE__.airdropCount = (window.__3D_STATE__.airdropCount||0)+1; window.__3D_STATE__.totalActions = (window.__3D_STATE__.totalActions||0)+1;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedTool === 'airdrop'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.airdropCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalActions >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.containmentPct === 'number' && !isNaN(window.__3D_STATE__.containmentPct)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windDirection === 'east'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-wind') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-wind').textContent.toLowerCase().includes('east')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickInterval === 1.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windDirection === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "+"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickInterval < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickInterval >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tickInterval === 'number' && !isNaN(window.__3D_STATE__.tickInterval)",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-speed') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windDirection === 'east'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let prevTick = window.__3D_STATE__.tickCount; document.getElementById('btn-toggle-sim').click(); await new Promise(r => setTimeout(r, 7000)); document.getElementById('btn-toggle-sim').click(); window.__prevTick = prevTick;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > window.__prevTick",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burnedOutCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.grid.flat().filter(c => c === 'burned_out').length === window.__3D_STATE__.burnedOutCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burnedOutCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firebreakCount === 0 && window.__3D_STATE__.waterlineCount === 0 && window.__3D_STATE__.airdropCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.burningCount + window.__3D_STATE__.burnedOutCount + window.__3D_STATE__.savedCount === 400",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}