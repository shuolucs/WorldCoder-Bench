{
  "task_id": "P535_deformable_soft_body",
  "affordances": [
    {"id": "A1", "name": "MassPoints", "type": "3d_object", "semantic": "64 mass points forming the soft body", "locator_hints": ["sphere meshes"]},
    {"id": "A2", "name": "Springs", "type": "3d_object", "semantic": "Spring connections rendered as lines", "locator_hints": ["line segments"]},
    {"id": "A3", "name": "StiffnessSlider", "type": "dom_element", "semantic": "Spring stiffness control", "locator_hints": ["#slider-stiffness"]},
    {"id": "A4", "name": "DampingSlider", "type": "dom_element", "semantic": "Damping control", "locator_hints": ["#slider-damping"]},
    {"id": "A5", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.particleCount === 64", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Falling", "conditions": ["window.__3D_STATE__.avgY < 5"]},
    {"id": "S2", "name": "Resting", "conditions": ["window.__3D_STATE__.totalKineticEnergy < 0.5"]},
    {"id": "S3", "name": "Poked", "conditions": ["window.__3D_STATE__.totalKineticEnergy > 0.5"]},
    {"id": "S4", "name": "Dropped", "conditions": ["window.__3D_STATE__.avgY > 6"]},
    {"id": "S5", "name": "Reset", "conditions": ["window.__3D_STATE__.particleCount === 64"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 64", "tier": "L2"},
        {"expr": "window.__3D_STATE__.springCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.avgY < before.avgY || window.__3D_STATE__.avgY < 5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 4000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgY > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.totalKineticEnergy < before.totalKineticEnergy || window.__3D_STATE__.totalKineticEnergy < 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.volumeRatio > 0.3 && window.__3D_STATE__.volumeRatio < 3.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "p"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.maxStrain > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "d"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.avgY > 5", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S5", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.particleCount === 64", "tier": "L2"},
        {"expr": "window.__3D_STATE__.particlesValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; const vals = Object.values(s).filter(v => typeof v === 'number'); return vals.some(v => v !== 0); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T7", "from": "S5", "to": "S5", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-stiffness').value = 800; document.getElementById('slider-stiffness').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.stiffness === 800", "tier": "L2"}
      ]}
    }
  ]
}
