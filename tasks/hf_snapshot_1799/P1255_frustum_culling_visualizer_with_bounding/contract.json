{
  "task_id": "P1255_frustum_culling_visualizer_with_bounding",
  "affordances": [
    {
      "id": "A1",
      "name": "SubjectCamera",
      "type": "3d_object",
      "semantic": "The perspective camera whose frustum is visualized and tested for culling",
      "locator_hints": [
        "subject camera",
        "frustum source camera"
      ]
    },
    {
      "id": "A2",
      "name": "ObserverCamera",
      "type": "3d_object",
      "semantic": "The camera the user views the scene through with OrbitControls",
      "locator_hints": [
        "observer camera",
        "orbit camera"
      ]
    },
    {
      "id": "A3",
      "name": "SceneObjects",
      "type": "3d_object",
      "semantic": "The 30 randomly placed geometry objects being culled",
      "locator_hints": [
        "boxes",
        "spheres",
        "cones",
        "scene objects"
      ]
    },
    {
      "id": "A4",
      "name": "BoundingBoxHelpers",
      "type": "3d_object",
      "semantic": "AABB wireframe helpers around each object, colored by cull state",
      "locator_hints": [
        "Box3Helper",
        "bounding box wireframes"
      ]
    },
    {
      "id": "A5",
      "name": "FrustumHelper",
      "type": "3d_object",
      "semantic": "CameraHelper visualizing the subject camera frustum",
      "locator_hints": [
        "CameraHelper",
        "frustum wireframe"
      ]
    },
    {
      "id": "A6",
      "name": "ToggleBBButton",
      "type": "dom_element",
      "semantic": "Button to toggle bounding box visibility",
      "locator_hints": [
        "#btn-toggle-bb"
      ]
    },
    {
      "id": "A7",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Button to randomize object positions",
      "locator_hints": [
        "#btn-randomize"
      ]
    },
    {
      "id": "A8",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Overlay showing culling stats, far/near plane, yaw",
      "locator_hints": [
        "#hud-panel",
        "#hud-inside-count",
        "#hud-far-plane"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalObjects === 30",
        "window.__3D_STATE__.farPlane === 80",
        "window.__3D_STATE__.nearPlane === 1",
        "window.__3D_STATE__.boundingBoxesVisible === true",
        "window.__3D_STATE__.subjectCamYaw === 0 || typeof window.__3D_STATE__.subjectCamYaw === 'number'"
      ]
    },
    {
      "id": "S1",
      "name": "AfterYawRotation",
      "conditions": [
        "window.__3D_STATE__.subjectCamYaw !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "AfterForwardMove",
      "conditions": [
        "window.__3D_STATE__.subjectCamPosition.z !== 50"
      ]
    },
    {
      "id": "S3",
      "name": "FarPlaneToggled",
      "conditions": [
        "window.__3D_STATE__.farPlane === 40"
      ]
    },
    {
      "id": "S4",
      "name": "NearPlaneCycled",
      "conditions": [
        "window.__3D_STATE__.nearPlane === 5"
      ]
    },
    {
      "id": "S5",
      "name": "BoundingBoxesHidden",
      "conditions": [
        "window.__3D_STATE__.boundingBoxesVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "ObjectsRandomized",
      "conditions": [
        "window.__3D_STATE__.lastRandomizeSeed > 0"
      ]
    },
    {
      "id": "S7",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.subjectCamPosition.z - 50) < 1",
        "window.__3D_STATE__.farPlane === 80 || window.__3D_STATE__.farPlane === 40"
      ]
    },
    {
      "id": "S8",
      "name": "NearPlaneCycledAgain",
      "conditions": [
        "window.__3D_STATE__.nearPlane === 15"
      ]
    },
    {
      "id": "S9",
      "name": "FarPlaneRestoredAfterSecondToggle",
      "conditions": [
        "window.__3D_STATE__.farPlane === 80"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalObjects === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frustumPlaneCount === 6",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectCullStates) && window.__3D_STATE__.objectCullStates.length === 30",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.objectOpacities) && window.__3D_STATE__.objectOpacities.length === 30",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "count": 3
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.subjectCamYaw === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.subjectCamYaw)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectCamYaw - (-6)) < 1.5 || Math.abs(window.__3D_STATE__.subjectCamYaw - 6) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectOpacities.every(o => o === 1.0 || Math.abs(o - 0.15) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "count": 5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.subjectCamPosition === 'object'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.subjectCamPosition.x) && !isNaN(window.__3D_STATE__.subjectCamPosition.y) && !isNaN(window.__3D_STATE__.subjectCamPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectCamPosition.z - 50) > 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.farPlane === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlane < window.__3D_STATE__.farPlane",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-far-plane') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-far-plane').textContent.includes('40')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nearPlane === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlaneIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlane < window.__3D_STATE__.farPlane",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-near-plane') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-near-plane').textContent.includes('5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-toggle-bb"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.boundingBoxesVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalObjects === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCullStates.filter(s => s === true).length === window.__3D_STATE__.insideCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-randomize"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastRandomizeSeed > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalObjects === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCullStates.length === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectOpacities.length === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectOpacities.every(o => o === 1.0 || Math.abs(o - 0.15) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectCamPosition.x - 0) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectCamPosition.y - 15) < 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.subjectCamPosition.z - 50) < 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.subjectCamPosition.x)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "n",
        "count": 2
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.nearPlane === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlaneIndex === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlane < window.__3D_STATE__.farPlane",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frustumPlaneCount === 6",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-near-plane').textContent.includes('15')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.farPlane === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nearPlane < window.__3D_STATE__.farPlane",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.insideCount + window.__3D_STATE__.outsideCount === 30",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-far-plane').textContent.includes('80')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.objectCullStates.filter(s => s === true).length === window.__3D_STATE__.insideCount",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}