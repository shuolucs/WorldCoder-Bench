        "text contains 'Snapshot'"
      ]
    },
    {
      "id": "A11",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left info panel showing HRR, exhaust, interface height, temperature, particles, vent status",
      "locator_hints": [
        "top-left div",
        "position absolute"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.heatReleaseRate === 5",
        "window.__3D_STATE__.exhaustRate === 50",
        "window.__3D_STATE__.ventsActive === true",
        "window.__3D_STATE__.firePositionX === 0",
        "window.__3D_STATE__.snapshotLog.length === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HRRAdjusted",
      "conditions": [
        "window.__3D_STATE__.heatReleaseRate !== 5",
        "window.__3D_STATE__.interfaceHeight >= 2 && window.__3D_STATE__.interfaceHeight <= 28"
      ]
    },
    {
      "id": "S2",
      "name": "ExhaustAdjusted",
      "conditions": [
        "window.__3D_STATE__.exhaustRate !== 50"
      ]
    },
    {
      "id": "S3",
      "name": "VentsDisabled",
      "conditions": [
        "window.__3D_STATE__.ventsActive === false"
      ]
    },
    {
      "id": "S4",
      "name": "VentsReEnabled",
      "conditions": [
        "window.__3D_STATE__.ventsActive === true"
      ]
    },
    {
      "id": "S5",
      "name": "FireMoved",
      "conditions": [
        "window.__3D_STATE__.firePositionX !== 0"
      ]
    },
    {
      "id": "S6",
      "name": "FireReset",
      "conditions": [
        "window.__3D_STATE__.firePositionX === 0"
      ]
    },
    {
      "id": "S7",
      "name": "InterfacePlaneHidden",
      "conditions": [
        "window.__3D_STATE__.interfacePlaneVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "InterfacePlaneShown",
      "conditions": [
        "window.__3D_STATE__.interfacePlaneVisible === true"
      ]
    },
    {
      "id": "S9",
      "name": "SnapshotTaken",
      "conditions": [
        "window.__3D_STATE__.snapshotLog.length >= 1"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.heatReleaseRate === 'number' && !isNaN(window.__3D_STATE__.heatReleaseRate)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.interfaceHeight === 'number' && !isNaN(window.__3D_STATE__.interfaceHeight)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.smokeTemperature === 'number' && !isNaN(window.__3D_STATE__.smokeTemperature)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ventColors) && window.__3D_STATE__.ventColors.length === 4",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatReleaseRate === 5.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.interfaceHeight === 'number' && !isNaN(window.__3D_STATE__.interfaceHeight)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.interfaceHeight >= 2 && window.__3D_STATE__.interfaceHeight <= 28",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.smokeTemperature > 20",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.smokeTemperature - (20 + (5.5 * 200) / (50 + 1))) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range][max=\"100\"]').value = 80; document.querySelector('input[type=range][max=\"100\"]').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.exhaustRate === 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interfaceHeight >= 2 && window.__3D_STATE__.interfaceHeight <= 28",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.smokeTemperature - (20 + (window.__3D_STATE__.heatReleaseRate * 200) / (80 + 1))) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.interfacePlaneY === 'number' && !isNaN(window.__3D_STATE__.interfacePlaneY)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.particlesAboveInterface + window.__3D_STATE__.particlesBelowInterface - window.__3D_STATE__.activeParticleCount) <= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_contains": "Toggle Vents"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventColors.every(c => c !== '#00ff00' && c !== '#00FF00' && c.toLowerCase() !== '#0f0')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeParticleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_before = window.__3D_STATE__.activeParticleCount; await new Promise(r => setTimeout(r, 3000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount >= window.__T5_before",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.interfaceHeight)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.smokeTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_contains": "Toggle Vents"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventColors.some(c => c === '#00ff00' || c === '#00FF00' || c.toLowerCase() === '#008000' || c.toLowerCase() === '#0f0' || c.toLowerCase() === '#00ff00')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interfaceHeight >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowRight",
        "repeat": 5
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.firePositionX === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.firePositionX >= -8 && window.__3D_STATE__.firePositionX <= 8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeParticleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.interfaceHeight)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_contains": "Reset Fire"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.firePositionX === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interfaceHeight >= 2 && window.__3D_STATE__.interfaceHeight <= 28",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.particlesAboveInterface + window.__3D_STATE__.particlesBelowInterface - window.__3D_STATE__.activeParticleCount) <= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "v"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.interfacePlaneVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.interfacePlaneY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.interfacePlaneY)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventsActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.heatReleaseRate >= 1 && window.__3D_STATE__.heatReleaseRate <= 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_contains": "Snapshot"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.snapshotLog.length === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotLog[0].interfaceHeight === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotLog[0].smokeTemp === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotLog[0].aboveCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotLog[0].belowCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.snapshotLog[0].timestamp === 'number'",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}