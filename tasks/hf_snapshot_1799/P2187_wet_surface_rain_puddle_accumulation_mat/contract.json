        "window.__3D_STATE__.globalWetness > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Puddles_Forming",
      "conditions": [
        "window.__3D_STATE__.puddleLevel > 0",
        "window.__3D_STATE__.puddleCoverage > 0"
      ]
    },
    {
      "id": "S4",
      "name": "High_Intensity",
      "conditions": [
        "window.__3D_STATE__.rainIntensity >= 0.8"
      ]
    },
    {
      "id": "S5",
      "name": "Flooded",
      "conditions": [
