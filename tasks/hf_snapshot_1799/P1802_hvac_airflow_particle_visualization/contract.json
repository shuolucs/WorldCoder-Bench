  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.fanSpeed === 1.5",
        "window.__3D_STATE__.supplyTemp === 24",
        "window.__3D_STATE__.ventsActive[0] === true && window.__3D_STATE__.ventsActive[1] === true && window.__3D_STATE__.ventsActive[2] === true",
        "window.__3D_STATE__.velocityVizOn === false"
      ]
    },
    {
      "id": "S1",
      "name": "ParticlesFlowing",
      "conditions": [
        "window.__3D_STATE__.particleCount > 0",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Vent1Disabled",
      "conditions": [
        "window.__3D_STATE__.ventsActive[0] === false"
      ]
    },
    {
      "id": "S3",
      "name": "FanSpeedChanged",
      "conditions": [
        "window.__3D_STATE__.fanSpeed !== 1.5"
      ]
    },
    {
      "id": "S4",
      "name": "SupplyTempChanged",
      "conditions": [
        "window.__3D_STATE__.supplyTemp !== 24"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "VelocityVizEnabled",
      "conditions": [
        "window.__3D_STATE__.velocityVizOn === true"
      ]
    },
    {
      "id": "S7",
      "name": "AllVentsDisabled",
      "conditions": [
        "window.__3D_STATE__.ventsActive[0] === false && window.__3D_STATE__.ventsActive[1] === false && window.__3D_STATE__.ventsActive[2] === false"
      ]
    },
    {
      "id": "S8",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.fanSpeed === 1.5",
        "window.__3D_STATE__.supplyTemp === 24",
        "window.__3D_STATE__.ventsActive[0] === true && window.__3D_STATE__.ventsActive[1] === true && window.__3D_STATE__.ventsActive[2] === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0 && isFinite(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemperature >= 16 && window.__3D_STATE__.avgTemperature <= 28",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount <= 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#toggleVent1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventsActive[1] === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventsActive[2] === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ventsActive) && window.__3D_STATE__.ventsActive.length === 3",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ventsActive[0] === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('fanSpeedSlider').value = 2.8; document.getElementById('fanSpeedSlider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.fanSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fanSpeed - 2.8) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fanSpeed > 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fanSpeed >= 0 && window.__3D_STATE__.fanSpeed <= 3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.fanSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('tempSlider').value = 17; document.getElementById('tempSlider').dispatchEvent(new Event('input', {bubbles:true})); await new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.supplyTemp === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.supplyTemp - 17) < 0.6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.supplyTemp >= 16 && window.__3D_STATE__.supplyTemp <= 28",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemperature < 24",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ambientTemp === 22",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.toLowerCase().includes('resume')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const beforeTime = window.__3D_STATE__.simTime; const beforeCount = window.__3D_STATE__.particleCount; window.__pauseSnapshot__ = {time: beforeTime, count: beforeCount}; await new Promise(r => setTimeout(r, 1000)); window.__pauseVerify__ = {timeDelta: Math.abs(window.__3D_STATE__.simTime - beforeTime), countDelta: Math.abs(window.__3D_STATE__.particleCount - beforeCount)}; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'v', code: 'KeyV', bubbles: true})); window.dispatchEvent(new KeyboardEvent('keydown', {key: 'v', code: 'KeyV', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.velocityVizOn === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.velocityVizOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__pauseVerify__.timeDelta < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#pauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('pauseBtn').textContent.toLowerCase().includes('pause')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.velocityVizOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('toggleVent2').click(); document.getElementById('toggleVent3').click(); await new Promise(r => setTimeout(r, 3000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive[0] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventsActive[1] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ventsActive[2] === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomBounds !== undefined && window.__3D_STATE__.roomBounds.minX < window.__3D_STATE__.roomBounds.maxX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => p.x >= window.__3D_STATE__.roomBounds.minX && p.x <= window.__3D_STATE__.roomBounds.maxX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ventsActive[0] === true && window.__3D_STATE__.ventsActive[1] === true && window.__3D_STATE__.ventsActive[2] === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fanSpeed - 1.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.supplyTemp - 24) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount <= 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount > 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemperature > 20 && window.__3D_STATE__.avgTemperature < 26",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKineticEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleTemperatures.every(t => t >= 16 && t <= 28 && isFinite(t))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 2.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}