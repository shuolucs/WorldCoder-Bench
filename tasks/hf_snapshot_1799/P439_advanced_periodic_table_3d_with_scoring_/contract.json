  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.robotLoaded === true",
        "window.__3D_STATE__.elementCount >= 18"
      ]
    },
    {
      "id": "S1",
      "name": "ElementSelected",
      "conditions": [
        "window.__3D_STATE__.selectedElement !== null",
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S2",
      "name": "ElementDeselected",
      "conditions": [
        "window.__3D_STATE__.selectedElement === null",
        "window.__3D_STATE__.infoPanelVisible === false"
      ]
    },
    {
      "id": "S3",
      "name": "QuizStarted",
      "conditions": [
        "window.__3D_STATE__.quizActive === true",
        "window.__3D_STATE__.currentQuestion === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.streak === 0"
      ]
    },
    {
      "id": "S4",
      "name": "FirstQuestionCorrect",
      "conditions": [
        "window.__3D_STATE__.questionsAnswered === 1",
        "window.__3D_STATE__.totalCorrect === 1",
        "window.__3D_STATE__.score === 10",
        "window.__3D_STATE__.streak === 1"
      ]
    },
    {
      "id": "S5",
      "name": "SecondQuestionCorrect",
      "conditions": [
        "window.__3D_STATE__.questionsAnswered === 2",
        "window.__3D_STATE__.totalCorrect === 2",
        "window.__3D_STATE__.score === 20",
        "window.__3D_STATE__.streak === 2"
      ]
    },
    {
      "id": "S6",
      "name": "ThirdQuestionCorrectStreakBonus",
      "conditions": [
        "window.__3D_STATE__.questionsAnswered === 3",
        "window.__3D_STATE__.totalCorrect === 3",
        "window.__3D_STATE__.streak === 3",
        "window.__3D_STATE__.multiplier === 2",
        "window.__3D_STATE__.score === 40"
      ]
    },
    {
      "id": "S7",
      "name": "FourthQuestionIncorrect",
      "conditions": [
        "window.__3D_STATE__.questionsAnswered === 4",
        "window.__3D_STATE__.totalIncorrect === 1",
        "window.__3D_STATE__.streak === 0",
        "window.__3D_STATE__.multiplier === 1",
        "window.__3D_STATE__.score === 37"
      ]
    },
    {
      "id": "S8",
      "name": "FifthQuestionCorrectQuizComplete",
      "conditions": [
        "window.__3D_STATE__.questionsAnswered === 5",
        "window.__3D_STATE__.quizComplete === true",
        "window.__3D_STATE__.totalCorrect === 4",
        "window.__3D_STATE__.score === 47"
      ]
    },
    {
      "id": "S9",
      "name": "ResultsShown",
      "conditions": [
        "window.__3D_STATE__.quizComplete === true",
        "window.__3D_STATE__.quizActive === false"
      ]
    }
  ],
