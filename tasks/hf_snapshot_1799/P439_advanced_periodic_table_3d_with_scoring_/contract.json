    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(); const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const elements = scene.children.filter(c => c.userData && c.userData.element); if(elements.length > 0) { const el = elements[0]; const pos = new THREE.Vector3(); el.getWorldPosition(pos); pos.project(camera); const x = (pos.x + 1)/2 * rect.width + rect.left; const y = (-pos.y + 1)/2 * rect.height + rect.top; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true})); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('info-panel') !== null",
            "tier": "L0"
          }
        ]
      }
