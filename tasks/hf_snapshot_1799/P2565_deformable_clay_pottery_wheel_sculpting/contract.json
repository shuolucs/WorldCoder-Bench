{
  "task_id": "P2565_deformable_clay_pottery_wheel_sculpting",
  "affordances": [
    {
      "id": "A1",
      "name": "ClayBody",
      "type": "3d_object",
      "semantic": "Deformable clay mesh on the pottery wheel, built from lathe geometry with 17 control points",
      "locator_hints": [
        "Mesh with MeshStandardMaterial color 0xc4713b",
        "Lathe geometry centered at origin"
      ]
    },
    {
      "id": "A2",
      "name": "PotteryWheel",
      "type": "3d_object",
      "semantic": "Spinning circular wheel base that the clay sits on",
      "locator_hints": [
        "Cylinder geometry radius 1.5",
        "Dark wood material 0x3d2b1f"
      ]
    },
    {
      "id": "A3",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling wheel RPM from 0 to 120",
      "locator_hints": [
        "#speed-slider",
        "input[type=range]"
      ]
    },
    {
      "id": "A4",
      "name": "WheelToggle",
      "type": "dom_element",
      "semantic": "Button to start/stop the pottery wheel",
      "locator_hints": [
        "#wheel-toggle"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset clay to initial cylinder",
      "locator_hints": [
        "#reset-btn"
      ]
    },
    {
      "id": "A6",
      "name": "RPMDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing current RPM",
      "locator_hints": [
        "#rpm-display"
      ]
    },
    {
      "id": "A7",
      "name": "VolumeDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing current clay volume",
      "locator_hints": [
        "#volume-display"
      ]
    },
    {
      "id": "A8",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing OK or CRACKED status",
      "locator_hints": [
        "#status-display"
      ]
    },
    {
      "id": "A9",
      "name": "SmoothCountDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing number of smoothing passes",
      "locator_hints": [
        "#smooth-count"
      ]
    },
    {
      "id": "A10",
      "name": "UndoCountDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing available undo count",
      "locator_hints": [
        "#undo-count"
      ]
    },
    {
      "id": "A11",
      "name": "RedoCountDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing available redo count",
      "locator_hints": [
        "#redo-count"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialSpinning",
      "conditions": [
        "window.__3D_STATE__.wheelSpinning === true",
        "window.__3D_STATE__.wheelRPM >= 55 && window.__3D_STATE__.wheelRPM <= 65",
        "window.__3D_STATE__.activePreset === 'cylinder' || window.__3D_STATE__.activePreset === null",
        "window.__3D_STATE__.cracked === false",
        "window.__3D_STATE__.smoothCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "WheelStopped",
      "conditions": [
        "window.__3D_STATE__.wheelSpinning === false",
        "window.__3D_STATE__.wheelRPM === 0"
      ]
    },
    {
      "id": "S2",
      "name": "BowlPresetApplied",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'bowl'",
        "Math.abs(window.__3D_STATE__.controlPoints[0].radius - 0.6) < 0.02",
        "Math.abs(window.__3D_STATE__.controlPoints[7].radius - 0.28) < 0.05"
      ]
    },
    {
      "id": "S3",
      "name": "VasePresetApplied",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'vase'",
        "Math.abs(window.__3D_STATE__.controlPoints[4].radius - 0.8) < 0.05",
        "Math.abs(window.__3D_STATE__.controlPoints[10].radius - 0.32) < 0.05"
      ]
    },
    {
      "id": "S4",
      "name": "SmoothedOnce",
      "conditions": [
        "window.__3D_STATE__.smoothCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "UndoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "RedoneState",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.controlPoints.every(p => Math.abs(p.radius - 0.6) < 0.01)",
        "window.__3D_STATE__.cracked === false"
      ]
    },
    {
      "id": "S8",
      "name": "RPMAdjusted",
      "conditions": [
        "window.__3D_STATE__.wheelRPM >= 100 && window.__3D_STATE__.wheelRPM <= 125"
      ]
    },
    {
      "id": "S9",
      "name": "MultiSmoothed",
      "conditions": [
        "window.__3D_STATE__.smoothCount >= 4"
      ]
    },
    {
      "id": "S10",
      "name": "WheelRestarted",
      "conditions": [
        "window.__3D_STATE__.wheelSpinning === true",
        "window.__3D_STATE__.wheelRPM > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.controlPoints) && window.__3D_STATE__.controlPoints.length === 17",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => typeof p.radius === 'number' && typeof p.y === 'number')",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentVolume === 'number' && !isNaN(window.__3D_STATE__.currentVolume) && window.__3D_STATE__.currentVolume > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.initialVolume === 'number' && Math.abs(window.__3D_STATE__.currentVolume - window.__3D_STATE__.initialVolume) / window.__3D_STATE__.initialVolume < 0.01",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30 && window.__3D_STATE__.meshVertexCount > 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#wheel-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wheelSpinning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wheelRPM === 0",
            "tier": "L1"
          },
          {
            "expr": "document.querySelector('#wheel-toggle').textContent.trim().toLowerCase().includes('start')",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.wheelRPM === 'number' && !isNaN(window.__3D_STATE__.wheelRPM)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.volumeError < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#wheel-toggle"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wheelSpinning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wheelRPM > 0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#wheel-toggle').textContent.trim().toLowerCase().includes('stop')",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cracked === 'boolean' && window.__3D_STATE__.cracked === false",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => p.radius >= 0.08 && p.radius <= 1.4)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S10",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'bowl'",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[0].radius - 0.6) < 0.02",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[6].radius - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[16].radius - 0.98) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius > 0.9 && window.__3D_STATE__.minRadius < 0.35",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volumeError < 0.02 || typeof window.__3D_STATE__.volumeError === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activePreset === 'vase'",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[4].radius - 0.8) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[9].radius - 0.35) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[4].radius > window.__3D_STATE__.controlPoints[9].radius",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.thicknesses) && window.__3D_STATE__.thicknesses.length === 17",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.smoothCount === 1",
            "tier": "L1"
          },
          {
            "expr": "document.querySelector('#smooth-count') !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[4].radius !== 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => !isNaN(p.radius) && p.radius >= 0.08)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.minThickness === 'number' && !isNaN(window.__3D_STATE__.minThickness)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:'s'}));document.dispatchEvent(new KeyboardEvent('keyup',{key:'s'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.smoothCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => p.radius >= 0.08 && p.radius <= 1.4)",
            "tier": "L2"
          },
          {
            "expr": "(function(){const pts=window.__3D_STATE__.controlPoints; let maxDiff=0; for(let i=1;i<pts.length;i++){maxDiff=Math.max(maxDiff,Math.abs(pts[i].radius-pts[i-1].radius));} return maxDiff;}()) < 0.25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => !isNaN(p.radius) && !isNaN(p.y))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S9",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.smoothCount < 4 || window.__3D_STATE__.activePreset !== null",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.undoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => typeof p.radius === 'number' && !isNaN(p.radius))",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cracked === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => p.radius >= 0.08 && p.radius <= 1.4)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentVolume === 'number' && window.__3D_STATE__.currentVolume > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshVertexCount > 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S8",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const slider=document.querySelector('#speed-slider'); if(slider){const nativeInputValueSetter=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set; nativeInputValueSetter.call(slider,'120'); slider.dispatchEvent(new Event('input',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wheelRPM >= 100",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#speed-slider').value >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wheelSpinning === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.wheelRPM === 'number' && !isNaN(window.__3D_STATE__.wheelRPM)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S8",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => Math.abs(p.radius - 0.6) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cracked === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentVolume - window.__3D_STATE__.initialVolume) / window.__3D_STATE__.initialVolume < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.smoothCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activePreset === 'cylinder' || window.__3D_STATE__.activePreset === null",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S7",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('#reset-btn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.controlPoints.every(p => Math.abs(p.radius - 0.6) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cracked === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.minRadius >= 0.58 && window.__3D_STATE__.maxRadius <= 0.62",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#status-display') !== null && !document.querySelector('#status-display').textContent.includes('CRACKED')",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.volumeError) < 0.01",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}