  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.currentMode === 'total'",
        "window.__3D_STATE__.selectedCountry === null",
        "window.__3D_STATE__.barScale === 1.0",
        "window.__3D_STATE__.hotspotCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "AutoRotationPaused",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S2",
      "name": "AutoRotationResumed",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S3",
      "name": "DensityMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'density'"
      ]
    },
    {
      "id": "S4",
      "name": "TotalMode",
      "conditions": [
        "window.__3D_STATE__.currentMode === 'total'"
      ]
    },
    {
      "id": "S5",
      "name": "BarsScaledUp",
      "conditions": [
        "window.__3D_STATE__.barScale === 1.5"
      ]
    },
    {
      "id": "S6",
      "name": "BarsScaledUpMax",
      "conditions": [
        "window.__3D_STATE__.barScale >= 2.9 && window.__3D_STATE__.barScale <= 3.0"
      ]
    },
    {
      "id": "S7",
      "name": "BarsScaledDown",
      "conditions": [
        "window.__3D_STATE__.barScale < 1.0 && window.__3D_STATE__.barScale >= 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraDistance - 3.5) < 0.1"
      ]
    },
    {
      "id": "S9",
      "name": "FerrariLoaded",
      "conditions": [
        "window.__3D_STATE__.ferrariLoaded === true"
      ]
    }
  ],
