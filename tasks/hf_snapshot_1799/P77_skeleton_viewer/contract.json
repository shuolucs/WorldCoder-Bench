{
  "task_id": "P77_skeleton_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "SkeletonMesh",
      "type": "3d_object",
      "semantic": "骨架网格",
      "locator_hints": [
        "cylinder",
        "bone",
        "joint"
      ]
    },
    {
      "id": "A2",
      "name": "BoneInfoPanel",
      "type": "dom_element",
      "semantic": "骨骼信息面板",
      "locator_hints": [
        "boneInfo"
      ]
    },
    {
      "id": "A3",
      "name": "PoseSelect",
      "type": "dom_element",
      "semantic": "姿态预设",
      "locator_hints": [
        "poseSelect"
      ]
    },
    {
      "id": "A4",
      "name": "BoneRotX",
      "type": "dom_element",
      "semantic": "选中骨 X 旋转",
      "locator_hints": [
        "boneRotX"
      ]
    },
    {
      "id": "A5",
      "name": "BoneRotY",
      "type": "dom_element",
      "semantic": "选中骨 Y 旋转",
      "locator_hints": [
        "boneRotY"
      ]
    },
    {
      "id": "A6",
      "name": "BoneRotZ",
      "type": "dom_element",
      "semantic": "选中骨 Z 旋转",
      "locator_hints": [
        "boneRotZ"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "T-pose，20 骨，无选中"
    },
    {
      "id": "S1",
      "name": "pose_rest",
      "description": "rest 姿态"
    },
    {
      "id": "S2",
      "name": "pose_walk",
      "description": "walk 帧姿态"
    },
    {
      "id": "S3",
      "name": "bone_selected",
      "description": "已选中某骨骼"
    },
    {
      "id": "S4",
      "name": "rot_x_changed",
      "description": "boneRotX 已调"
    },
    {
      "id": "S5",
      "name": "rot_y_changed",
      "description": "boneRotY 已调"
    },
    {
      "id": "S6",
      "name": "bones_array_ok",
      "description": "bones 数组完整"
    },
    {
      "id": "S7",
      "name": "stable",
      "description": "状态稳定"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "boneCount=20，bones 长度 20"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.boneCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.bones) && window.__3D_STATE__.bones.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedBone === null || typeof window.__3D_STATE__.selectedBone === 'string'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentPose === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "action": {
        "type": "dom_input",
        "selector": "#poseSelect",
        "value": "rest"
      },
      "postconditions": [
        "currentPose 为 rest"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 800,
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPose === 'rest' || window.__3D_STATE__.currentPose === 'Rest'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "action": {
        "type": "dom_input",
        "selector": "#poseSelect",
        "value": "walk"
      },
      "postconditions": [
        "walk 姿态"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 800,
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPose === 'walk' || window.__3D_STATE__.currentPose === 'Walk'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "action": {
        "type": "dom_click",
        "selector": "canvas"
      },
      "postconditions": [
        "可能选中骨骼；若实现仅点击 mesh，此步宽松"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.boneCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bones.every(b => b && typeof b.name === 'string' && b.rotation && isFinite(b.rotation.x))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "action": {
        "type": "dom_input",
        "selector": "#boneRotX",
        "value": "0.8"
      },
      "postconditions": [
        "某骨 rotation.x 变化或保持有限"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.bones.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bones.every(b => isFinite(b.rotation.x) && isFinite(b.rotation.y) && isFinite(b.rotation.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "action": {
        "type": "dom_input",
        "selector": "#boneRotY",
        "value": "-0.5"
      },
      "postconditions": [
        "旋转分量有限"
      ],
      "severity": "P1",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 500,
        "checks": [
          {
            "expr": "window.__3D_STATE__.bones.every(b => isFinite(b.rotation.y))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "action": {
        "type": "dom_input",
        "selector": "#poseSelect",
        "value": "tpose"
      },
      "postconditions": [
        "回到 T-pose，bones 含 parent/length"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 800,
        "checks": [
          {
            "expr": "window.__3D_STATE__.bones.every(b => typeof b.length === 'number' && isFinite(b.length))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bones.every(b => b.parent === null || typeof b.parent === 'string')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "长期 boneCount 仍为 20"
      ],
      "severity": "P0",
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.boneCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bones.length === 20",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}