      ]
    },
    {
      "id": "S4",
      "name": "MovedLaterally",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "window.__3D_STATE__.playerX !== 0"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
