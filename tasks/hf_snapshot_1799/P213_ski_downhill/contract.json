    {
      "id": "S7",
      "name": "Finished",
      "conditions": [
        "window.__3D_STATE__.gameState === 'finished'"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.gameState === 'ready'",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.playerZ === 0"
      ]
    }
