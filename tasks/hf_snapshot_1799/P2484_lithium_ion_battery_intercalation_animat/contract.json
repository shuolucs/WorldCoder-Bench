  "states": [
    {
      "id": "S0",
      "name": "InitialFullyCharged",
      "conditions": [
        "window.__3D_STATE__.mode === 'idle'",
        "window.__3D_STATE__.ionsInAnode === 8",
        "window.__3D_STATE__.ionsInCathode === 0",
        "window.__3D_STATE__.ionsInTransit === 0",
        "window.__3D_STATE__.stateOfCharge === 1.0",
        "window.__3D_STATE__.totalIons === 8",
        "window.__3D_STATE__.cycleCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "DischargingInProgress",
      "conditions": [
        "window.__3D_STATE__.mode === 'discharging'",
        "window.__3D_STATE__.ionsInAnode < 8"
      ]
    },
    {
      "id": "S2",
      "name": "FullyDischarged",
      "conditions": [
        "window.__3D_STATE__.ionsInAnode === 0",
        "window.__3D_STATE__.ionsInCathode === 8",
        "window.__3D_STATE__.stateOfCharge === 0.0"
      ]
    },
    {
      "id": "S3",
      "name": "ChargingInProgress",
      "conditions": [
        "window.__3D_STATE__.mode === 'charging'",
        "window.__3D_STATE__.ionsInCathode < 8"
      ]
    },
    {
      "id": "S4",
      "name": "RechargedFull",
      "conditions": [
        "window.__3D_STATE__.ionsInAnode === 8",
        "window.__3D_STATE__.ionsInCathode === 0",
        "window.__3D_STATE__.cycleCount >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.animationSpeed !== 2"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.ionsInAnode === 8",
        "window.__3D_STATE__.stateOfCharge === 1.0",
        "window.__3D_STATE__.mode === 'idle'"
      ]
    },
    {
      "id": "S8",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStack.length > 0"
      ]
    },
    {
      "id": "S9",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStack.length === 0 || window.__3D_STATE__.undoStack.length > 0"
      ]
    },
    {
      "id": "S10",
      "name": "IonSelected",
      "conditions": [
        "window.__3D_STATE__.selectedIon !== null"
      ]
    }
  ],
