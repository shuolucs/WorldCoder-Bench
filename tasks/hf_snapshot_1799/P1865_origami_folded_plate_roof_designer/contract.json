    {
      "id": "A1",
      "name": "RoofPanels",
      "type": "3d_object",
      "semantic": "Array of triangular folded plate panels forming the origami roof",
      "locator_hints": [
        "mesh with wood/concrete/glass material",
        "castShadow=true triangles"
      ]
    },
    {
      "id": "A2",
      "name": "SupportColumns",
      "type": "3d_object",
      "semantic": "Four vertical columns supporting the roof at corners",
      "locator_hints": [
        "BoxGeometry 0.2x*x0.2",
        "gray color #808080"
      ]
    },
    {
      "id": "A3",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Ground reference plane with grid",
