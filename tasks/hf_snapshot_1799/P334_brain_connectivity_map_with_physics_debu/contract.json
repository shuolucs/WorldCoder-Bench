  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 12",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.connectionsVisible === true",
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.viewMode === 'normal'"
      ]
    },
    {
      "id": "S1",
      "name": "HorseLoaded",
