        "window.__3D_STATE__.horseLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "DebugOverlayOn",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ]
    },
    {
      "id": "S3",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex >= 0",
        "window.__3D_STATE__.selectedNodeName !== ''"
      ]
    },
    {
      "id": "S4",
      "name": "ConnectionsHidden",
      "conditions": [
        "window.__3D_STATE__.connectionsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "HeatmapMode",
      "conditions": [
        "window.__3D_STATE__.viewMode === 'heatmap'"
      ]
    },
    {
      "id": "S6",
      "name": "RandomNodeActivated",
      "conditions": [
        "window.__3D_STATE__.activeNodeCount >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "AllNodesActivated",
      "conditions": [
        "window.__3D_STATE__.allNodesActivated === true",
        "window.__3D_STATE__.activeNodeCount === 12"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.selectedNodeIndex === -1",
        "window.__3D_STATE__.allNodesActivated === false",
        "window.__3D_STATE__.activeNodeCount === 0"
      ]
    }
  ],
