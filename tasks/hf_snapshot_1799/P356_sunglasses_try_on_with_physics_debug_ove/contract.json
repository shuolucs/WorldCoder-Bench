  "states": [
    {
      "id": "S0",
      "name": "Initial_Loading",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded_Sunglasses_Floating",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.sunglassesPlaced === false",
        "window.__3D_STATE__.sunglassesY >= 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "Sunglasses_Falling",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.sunglassesPlaced === false",
        "window.__3D_STATE__.velocityY < 0"
      ]
    },
    {
      "id": "S3",
      "name": "Sunglasses_Placed",
      "conditions": [
        "window.__3D_STATE__.sunglassesPlaced === true",
        "window.__3D_STATE__.velocityY === 0"
      ]
    },
    {
      "id": "S4",
      "name": "Sunglasses_Dropped",
      "conditions": [
        "window.__3D_STATE__.sunglassesPlaced === false",
        "window.__3D_STATE__.sunglassesY < 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "Sunglasses_On_Ground",
      "conditions": [
        "window.__3D_STATE__.sunglassesY <= -0.9",
        "window.__3D_STATE__.groundContactCount >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "Debug_Overlay_Visible",
      "conditions": [
        "window.__3D_STATE__.debugVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "Lens_Color_Changed",
      "conditions": [
        "window.__3D_STATE__.lensColorIndex > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Wireframe_Enabled",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    }
  ],
