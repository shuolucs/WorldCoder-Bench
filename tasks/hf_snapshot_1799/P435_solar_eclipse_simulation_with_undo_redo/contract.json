      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD displaying simulation stats",
      "locator_hints": [
        "top-left div",
        "time step display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.timeStep === 0",
        "window.__3D_STATE__.moonAngle === 0",
        "window.__3D_STATE__.isPlaying === false || window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.eclipseActive === false",
        "window.__3D_STATE__.historyLength === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.timeStep > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.moonAngularSpeed !== 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackLength > 0",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S5",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.redoStackLength >= 0"
      ]
    },
    {
      "id": "S6",
      "name": "MoonSelected",
      "conditions": [
        "window.__3D_STATE__.moonSelected === true"
      ]
    },
    {
      "id": "S7",
      "name": "InfoPanelOpen",
      "conditions": [
        "window.__3D_STATE__.infoPanelVisible === true"
      ]
    },
    {
      "id": "S8",
      "name": "EclipseOccurring",
      "conditions": [
        "window.__3D_STATE__.eclipseActive === true",
        "window.__3D_STATE__.shadowIntensity > 0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.timeStep === 0",
        "window.__3D_STATE__.moonAngle === 0",
        "window.__3D_STATE__.historyLength === 0",
        "window.__3D_STATE__.redoStackLength === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
