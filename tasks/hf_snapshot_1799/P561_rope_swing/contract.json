{
  "task_id": "P561_rope_swing",
  "affordances": [
    {"id": "A1", "name": "Rope", "type": "3d_object", "semantic": "Verlet chain rendered as tube", "locator_hints": ["tube geometry"]},
    {"id": "A2", "name": "Character", "type": "3d_object", "semantic": "Soldier GLB model at rope end", "locator_hints": ["GLTF soldier model"]},
    {"id": "A3", "name": "Tree", "type": "3d_object", "semantic": "Procedural tree with branch", "locator_hints": ["cylinder trunk + cone foliage"]},
    {"id": "A4", "name": "RopeLengthSlider", "type": "dom_element", "semantic": "Rope length control", "locator_hints": ["#slider-rope-length"]},
    {"id": "A5", "name": "DampingSlider", "type": "dom_element", "semantic": "Damping control", "locator_hints": ["#slider-damping"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Hanging", "conditions": ["window.__3D_STATE__.isAttached === true", "window.__3D_STATE__.swingAngle < 5"]},
    {"id": "S1", "name": "Swinging", "conditions": ["window.__3D_STATE__.swingAngle > 5"]},
    {"id": "S2", "name": "Detached", "conditions": ["window.__3D_STATE__.isAttached === false"]},
    {"id": "S3", "name": "Reset", "conditions": ["window.__3D_STATE__.isAttached === true", "window.__3D_STATE__.characterSpeed < 0.5"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.segmentCount === 20", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ropeValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.isAttached === true", "tier": "L2"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "s"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.characterSpeed > 0.5", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ropeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.swingAngle > 0 || window.__3D_STATE__.characterSpeed > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.maxTension > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ropeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "keyboard", "key": "l"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isAttached === false", "tier": "L2"},
        {"expr": "document.getElementById('hud-attached').textContent.includes('No')", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.isAttached === true", "tier": "L2"},
        {"expr": "window.__3D_STATE__.ropeValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-rope-length').value = 7; document.getElementById('slider-rope-length').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.ropeLength >= 6", "tier": "L2"}
      ]}
    }
  ]
}
