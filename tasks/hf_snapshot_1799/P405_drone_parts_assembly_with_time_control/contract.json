{
  "task_id": "P405_drone_parts_assembly_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "TimeSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling assembly timeline progress",
      "locator_hints": [
        "#timeSlider",
        "input[type='range']"
      ]
    },
    {
      "id": "A2",
      "name": "PlayButton",
      "type": "dom_element",
      "semantic": "Play/Pause toggle for auto-play animation",
      "locator_hints": [
        "#playBtn"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets assembly progress to zero",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A4",
      "name": "SpeedUpButton",
      "type": "dom_element",
      "semantic": "Increases playback speed",
      "locator_hints": [
        "#speedUp"
      ]
    },
    {
      "id": "A5",
      "name": "SpeedDownButton",
      "type": "dom_element",
      "semantic": "Decreases playback speed",
      "locator_hints": [
        "#speedDown"
      ]
    },
    {
      "id": "A6",
      "name": "ExplodeButton",
      "type": "dom_element",
      "semantic": "Toggles exploded view when fully assembled",
      "locator_hints": [
        "#explodeBtn"
      ]
    },
    {
      "id": "A7",
      "name": "Chassis",
      "type": "3d_object",
      "semantic": "Horse.glb model serving as drone chassis",
      "locator_hints": [
        "horse.glb",
        "chassis"
      ]
    },
    {
      "id": "A8",
      "name": "ProgressDisplay",
      "type": "dom_element",
      "semantic": "Shows current assembly percentage",
      "locator_hints": [
        "#progressDisplay"
      ]
    },
    {
      "id": "A9",
      "name": "PartsCountDisplay",
      "type": "dom_element",
      "semantic": "Shows number of assembled parts",
      "locator_hints": [
        "#partsCount"
      ]
    },
    {
      "id": "A10",
      "name": "CompleteBanner",
      "type": "dom_element",
      "semantic": "Assembly complete notification banner",
      "locator_hints": [
        "#completeBanner"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Disassembled",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress === 0",
        "window.__3D_STATE__.partsAssembled === 0",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.isExploded === false"
      ]
    },
    {
      "id": "S1",
      "name": "Model_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.assemblyProgress === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Partial_Assembly_25",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress >= 0.24 && window.__3D_STATE__.assemblyProgress <= 0.26"
      ]
    },
    {
      "id": "S3",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S4",
      "name": "Partial_Assembly_50",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress >= 0.49 && window.__3D_STATE__.assemblyProgress <= 0.51"
      ]
    },
    {
      "id": "S5",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 0.005"
      ]
    },
    {
      "id": "S6",
      "name": "Partial_Assembly_75",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress >= 0.74 && window.__3D_STATE__.assemblyProgress <= 0.76"
      ]
    },
    {
      "id": "S7",
      "name": "Fully_Assembled",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress >= 0.99",
        "window.__3D_STATE__.partsAssembled === 5",
        "window.__3D_STATE__.assemblyComplete === true"
      ]
    },
    {
      "id": "S8",
      "name": "Exploded_View",
      "conditions": [
        "window.__3D_STATE__.isExploded === true",
        "window.__3D_STATE__.assemblyComplete === true"
      ]
    },
    {
      "id": "S9",
      "name": "Reset_After_Assembly",
      "conditions": [
        "window.__3D_STATE__.assemblyProgress === 0",
        "window.__3D_STATE__.partsAssembled === 0",
        "window.__3D_STATE__.isPlaying === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('timeSlider').value = 25; document.getElementById('timeSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#playBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
