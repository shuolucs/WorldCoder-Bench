          {
            "expr": "window.__3D_STATE__.precipitationCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.rainBurstActive === 'boolean'",
            "tier": "L0"
          }
