  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.temperature === 50",
        "window.__3D_STATE__.speedMultiplier === 1",
        "window.__3D_STATE__.fishLoaded === true",
        "window.__3D_STATE__.cyclesCompleted === 0",
        "window.__3D_STATE__.highlightedStage === 0"
      ]
    },
    {
      "id": "S1",
      "name": "TemperatureIncreased",
      "conditions": [
        "window.__3D_STATE__.temperature >= 80",
        "window.__3D_STATE__.evaporationCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedToggled",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 3"
      ]
    },
    {
      "id": "S3",
      "name": "LabelsToggled",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S4",
      "name": "CloudClicked",
      "conditions": [
        "window.__3D_STATE__.cloudClicked >= 1",
        "window.__3D_STATE__.precipitationCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "StageHighlighted",
      "conditions": [
        "window.__3D_STATE__.highlightedStage === 2"
      ]
    },
    {
      "id": "S6",
      "name": "CycleRunning",
      "conditions": [
        "window.__3D_STATE__.totalParticles > 0",
        "window.__3D_STATE__.totalParticles <= 200"
      ]
    },
    {
      "id": "S7",
      "name": "CycleCompleted",
      "conditions": [
        "window.__3D_STATE__.cyclesCompleted >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.cyclesCompleted === 0",
        "window.__3D_STATE__.highlightedStage === 0",
        "window.__3D_STATE__.cloudClicked === 0"
      ]
    },
    {
      "id": "S9",
      "name": "SpeedSlow",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 0.3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fishLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fishX >= 8 && window.__3D_STATE__.fishX <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 0 && window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('temperatureSlider').value = 85; document.getElementById('temperatureSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature <= 100",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.evaporationCount === 'number' && !isNaN(window.__3D_STATE__.evaporationCount)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#cycleSpeedBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 3",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('cycleSpeedBtn').textContent.includes('Fast') || document.getElementById('cycleSpeedBtn').textContent.includes('3')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles >= 0 && window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.fishX)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalParticles > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles <= 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.evaporationCount + window.__3D_STATE__.condensationCount + window.__3D_STATE__.precipitationCount + window.__3D_STATE__.collectionCount === window.__3D_STATE__.totalParticles || Math.abs((window.__3D_STATE__.evaporationCount + window.__3D_STATE__.condensationCount + window.__3D_STATE__.precipitationCount + window.__3D_STATE__.collectionCount) - window.__3D_STATE__.totalParticles) <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fishX >= 8 && window.__3D_STATE__.fishX <= 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S6",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target_object": "Cloud",
        "position_hint": "center of cloud at (-5, 15, 0)"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudClicked >= 1",
            "tier": "L2"
