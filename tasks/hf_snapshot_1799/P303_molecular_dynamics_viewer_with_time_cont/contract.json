{
  "task_id": "P303_molecular_dynamics_viewer_with_time_cont",
  "affordances": [
    {
      "id": "A1",
      "name": "BoundaryBox",
      "type": "3d_object",
      "semantic": "Wireframe cube boundary of side 20",
      "locator_hints": [
        "wireframe box",
        "EdgesGeometry",
        "BoxHelper"
      ]
    },
    {
      "id": "A2",
      "name": "Atoms",
      "type": "3d_object",
      "semantic": "12 spheres representing atoms",
      "locator_hints": [
        "SphereGeometry",
        "mesh children of scene"
      ]
    },
    {
      "id": "A3",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Head-up display with simulation info",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A4",
      "name": "TimeDisplay",
      "type": "dom_element",
      "semantic": "Simulation time readout",
      "locator_hints": [
        "#hud-time"
      ]
    },
    {
      "id": "A5",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Playing/Paused status",
      "locator_hints": [
        "#hud-status"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedDisplay",
      "type": "dom_element",
      "semantic": "Time scale readout",
      "locator_hints": [
        "#hud-timescale"
      ]
    },
    {
      "id": "A7",
      "name": "TempDisplay",
      "type": "dom_element",
      "semantic": "Temperature readout",
      "locator_hints": [
        "#hud-temperature"
      ]
    },
    {
      "id": "A8",
      "name": "DisplayModeLabel",
      "type": "dom_element",
      "semantic": "Current display mode label",
      "locator_hints": [
        "#hud-displaymode"
      ]
    },
    {
      "id": "A9",
      "name": "AtomInfo",
      "type": "dom_element",
      "semantic": "Selected atom info panel",
      "locator_hints": [
        "#atom-info"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Running",
      "conditions": [
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.atomCount === 12",
        "window.__3D_STATE__.simulationTime >= 0",
        "window.__3D_STATE__.displayMode === 'none'"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.playing === false"
      ]
    },
    {
      "id": "S2",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.playing === true",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.timeScale === 1.5"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedMaxed",
      "conditions": [
        "window.__3D_STATE__.timeScale === 5.0"
      ]
    },
    {
      "id": "S5",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.timeScale < 5.0"
      ]
    },
    {
      "id": "S6",
      "name": "DisplayColorMode",
      "conditions": [
        "window.__3D_STATE__.displayMode === 'color'"
      ]
    },
    {
      "id": "S7",
      "name": "DisplaySizeMode",
      "conditions": [
        "window.__3D_STATE__.displayMode === 'size'"
      ]
    },
    {
      "id": "S8",
      "name": "DisplayNoneMode",
      "conditions": [
        "window.__3D_STATE__.displayMode === 'none'"
      ]
    },
    {
      "id": "S9",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.playing === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy) && window.__3D_STATE__.totalKineticEnergy > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playing === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status').textContent.includes('Paused')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number' && window.__3D_STATE__.simulationTime > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-status').textContent.includes('Playing')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeScale === 1.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-timescale').textContent.includes('1.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<8;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowUp'}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeScale === 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeScale <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-timescale').textContent.includes('5')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.timeScale === 4.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeScale < 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature) && window.__3D_STATE__.temperature > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode === 'color'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-displaymode').textContent.includes('color')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode === 'size'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-displaymode').textContent.includes('size')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode === 'none'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-displaymode').textContent.includes('none')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKineticEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timeScale === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playing === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-timescale').textContent.includes('1')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}