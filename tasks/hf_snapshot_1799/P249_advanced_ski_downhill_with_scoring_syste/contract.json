{
  "task_id": "P249_advanced_ski_downhill_with_scoring_syste",
  "affordances": [
    {
      "id": "A1",
      "name": "Skier",
      "type": "3d_object",
      "semantic": "Player-controlled skier (SheenChair.glb model) that moves downhill",
      "locator_hints": [
        "GLTFLoader loaded model",
        "window.__3D_STATE__.skierX"
      ]
    },
    {
      "id": "A2",
      "name": "StartButton",
      "type": "dom_element",
      "semantic": "Button to start the game",
      "locator_hints": [
        "#startButton"
      ]
    },
    {
      "id": "A3",
      "name": "RestartButton",
      "type": "dom_element",
      "semantic": "Button to restart after game over",
      "locator_hints": [
        "#restartButton"
      ]
    },
    {
      "id": "A4",
      "name": "Obstacles",
      "type": "3d_object",
      "semantic": "Red box obstacles on the slope",
      "locator_hints": [
        "red boxes",
        "window.__3D_STATE__.obstacleCount"
      ]
    },
    {
      "id": "A5",
      "name": "Gates",
      "type": "3d_object",
      "semantic": "Green pole scoring gates",
      "locator_hints": [
        "green cylinders",
        "window.__3D_STATE__.gateCount"
      ]
    },
    {
      "id": "A6",
      "name": "BoostRamps",
      "type": "3d_object",
      "semantic": "Yellow boost ramps on the slope",
      "locator_hints": [
        "yellow boxes"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Score, speed, combo, distance display",
      "locator_hints": [
        "DOM overlay text elements"
      ]
    },
    {
      "id": "A8",
      "name": "PauseText",
      "type": "dom_element",
      "semantic": "PAUSED indicator text",
      "locator_hints": [
        "#pauseText"
      ]
    },
    {
      "id": "A9",
      "name": "GameOverOverlay",
      "type": "dom_element",
      "semantic": "Game over screen with final score",
      "locator_hints": [
        "#gameOverOverlay"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "PreGame",
      "conditions": [
        "window.__3D_STATE__.gameStarted === false",
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.score === 0"
      ]
    },
    {
      "id": "S1",
      "name": "GameRunning",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.gameOver === false",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "GamePaused",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "GameRunningAfterUnpause",
      "conditions": [
        "window.__3D_STATE__.gameStarted === true",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.distance > 0"
      ]
    },
    {
      "id": "S4",
      "name": "MovedLeft",
      "conditions": [
        "window.__3D_STATE__.skierX < -0.1",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S5",
      "name": "MovedRight",
      "conditions": [
        "window.__3D_STATE__.skierX > 0.1",
        "window.__3D_STATE__.gameStarted === true"
      ]
    },
    {
      "id": "S6",
      "name": "Accelerating",
      "conditions": [
        "window.__3D_STATE__.speed > 0.3",
        "window.__3D_STATE__.distance > 10"
      ]
    },
    {
      "id": "S7",
      "name": "BoostedState",
      "conditions": [
        "window.__3D_STATE__.boosted === true",
        "window.__3D_STATE__.speed > 0.5"
      ]
    },
    {
      "id": "S8",
      "name": "ScoringProgress",
      "conditions": [
        "window.__3D_STATE__.score > 0",
        "window.__3D_STATE__.distance > 50"
      ]
    },
    {
      "id": "S9",
      "name": "GameOver",
      "conditions": [
        "window.__3D_STATE__.gameOver === true",
        "window.__3D_STATE__.distance >= 500"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#startButton"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
