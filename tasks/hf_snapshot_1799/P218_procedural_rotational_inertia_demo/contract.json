      ]
    },
    {
      "id": "S7",
      "name": "TorqueApplied",
      "conditions": [
        "window.__3D_STATE__.torqueCount >= 1"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.massRadius === 1.0",
        "Math.abs(window.__3D_STATE__.omega - 2.0) < 0.01"
      ]
    }
  ],
