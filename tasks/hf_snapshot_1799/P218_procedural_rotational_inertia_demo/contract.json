    {
      "id": "A1",
      "name": "Turntable",
      "type": "3d_object",
      "semantic": "Rotating platform carrying robot and masses",
      "locator_hints": [
        "flat cylinder at y=0.1",
        "blue-ish color",
        "radius 4"
      ]
    },
    {
      "id": "A2",
      "name": "RobotModel",
      "type": "3d_object",
      "semantic": "Loaded robot.glb model at center of turntable",
      "locator_hints": [
        "parented to turntable",
        "position (0,0,0)"
      ]
    },
    {
      "id": "A3",
      "name": "MassSpheres",
      "type": "3d_object",
      "semantic": "Two red spheres representing adjustable masses on turntable",
