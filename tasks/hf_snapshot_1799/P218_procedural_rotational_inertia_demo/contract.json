        "red spheres",
        "radius 0.4",
        "on turntable"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing omega, I, L, r, paused",
      "locator_hints": [
        "div#hud",
        "top-left"
      ]
    },
    {
      "id": "A5",
      "name": "ApplyTorqueButton",
      "type": "dom_element",
