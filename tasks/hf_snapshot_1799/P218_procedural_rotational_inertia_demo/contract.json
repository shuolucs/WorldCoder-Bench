  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true",
        "window.__3D_STATE__.massRadius === 1.0",
        "Math.abs(window.__3D_STATE__.omega - 2.0) < 0.01",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "MassesMovedOut",
      "conditions": [
        "window.__3D_STATE__.massRadius === 1.5",
        "window.__3D_STATE__.momentOfInertia === 2.0 + 2 * 1.0 * 1.5 * 1.5"
      ]
    },
    {
      "id": "S2",
      "name": "MassesMovedFurtherOut",
      "conditions": [
        "window.__3D_STATE__.massRadius === 2.0",
        "window.__3D_STATE__.momentOfInertia === 2.0 + 2 * 1.0 * 2.0 * 2.0"
      ]
    },
    {
      "id": "S3",
      "name": "MassesMovedIn",
      "conditions": [
        "window.__3D_STATE__.massRadius === 1.5"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S6",
