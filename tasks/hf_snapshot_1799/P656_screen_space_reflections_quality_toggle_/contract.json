            "expr": "window.__3D_STATE__.ssrMaxSteps === 32",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ssrOpacity - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ssrResolution - 0.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyLength === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoLength === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStack[2] === 'low'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStack[0] === 'off'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#label-preset').textContent.toLowerCase().includes('medium')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}