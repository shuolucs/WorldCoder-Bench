      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S8",
      "name": "After_Undo",
      "conditions": [
        "window.__3D_STATE__.undoStack.length >= 0",
        "window.__3D_STATE__.phase !== 'complete'"
