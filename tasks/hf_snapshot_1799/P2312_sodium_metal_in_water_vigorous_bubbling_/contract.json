    },
    {
      "id": "S2",
      "name": "Reacting",
      "conditions": [
        "window.__3D_STATE__.phase === 'reacting'",
        "window.__3D_STATE__.pH > 7.0",
        "window.__3D_STATE__.bubbleCount > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Indicator_Added_Reacting",
      "conditions": [
