    },
    {
      "id": "S4",
      "name": "Vigorous_Reaction",
      "conditions": [
        "window.__3D_STATE__.phase === 'vigorous'",
        "window.__3D_STATE__.pH > 9.0"
      ]
    },
    {
      "id": "S5",
      "name": "Explosion",
      "conditions": [
