  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.magnetCount === 1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.fieldLinesVisible === true",
        "window.__3D_STATE__.selectedMagnetId === -1"
      ]
    },
    {
      "id": "S1",
      "name": "SecondMagnetAdded",
