        "window.__3D_STATE__.undoStackSize === 2"
      ]
    },
    {
      "id": "S3",
      "name": "UndoneToTwoMagnets",
      "conditions": [
        "window.__3D_STATE__.magnetCount === 2",
        "window.__3D_STATE__.undoStackSize === 1",
        "window.__3D_STATE__.redoStackSize === 1",
        "window.__3D_STATE__.lastAction === 'undo'"
      ]
    },
    {
      "id": "S4",
      "name": "RedoneToThreeMagnets",
      "conditions": [
        "window.__3D_STATE__.magnetCount === 3",
        "window.__3D_STATE__.undoStackSize === 2",
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'redo'"
      ]
    },
    {
      "id": "S5",
      "name": "FieldLinesHidden",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === false",
        "window.__3D_STATE__.magnetCount === 3"
      ]
    },
    {
      "id": "S6",
      "name": "FieldLinesRestored",
      "conditions": [
        "window.__3D_STATE__.fieldLinesVisible === true",
        "window.__3D_STATE__.magnetCount === 3"
      ]
    },
    {
      "id": "S7",
      "name": "MagnetRotated",
      "conditions": [
        "window.__3D_STATE__.selectedMagnetId !== -1",
        "window.__3D_STATE__.lastAction === 'rotate'",
        "window.__3D_STATE__.undoStackSize >= 3"
      ]
    }
  ],
