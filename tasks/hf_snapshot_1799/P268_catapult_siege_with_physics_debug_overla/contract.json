  "states": [
    {
      "id": "S0",
      "name": "Initial_Ready",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'ready'",
        "window.__3D_STATE__.power === 0",
        "window.__3D_STATE__.shotsFired === 0",
        "window.__3D_STATE__.bricksDestroyed === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Charging",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'charging'",
        "window.__3D_STATE__.isCharging === true",
        "window.__3D_STATE__.power > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Flying",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'flying'",
        "window.__3D_STATE__.isFiring === true",
        "window.__3D_STATE__.boulderPosition.y > 0.6"
      ]
    },
    {
      "id": "S3",
      "name": "Landed",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'landed'",
        "window.__3D_STATE__.isFiring === false",
        "window.__3D_STATE__.boulderPosition.y <= 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "AngleAdjusted",
      "conditions": [
        "window.__3D_STATE__.angle !== 45",
        "window.__3D_STATE__.gamePhase === 'ready'"
      ]
    },
    {
      "id": "S5",
      "name": "DebugOn",
      "conditions": [
        "window.__3D_STATE__.debugMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "DebugOff",
      "conditions": [
        "window.__3D_STATE__.debugMode === false"
      ]
    },
    {
      "id": "S7",
      "name": "ResetAfterShot",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'ready'",
        "window.__3D_STATE__.power === 0",
        "window.__3D_STATE__.isFiring === false"
      ]
    },
    {
      "id": "S8",
      "name": "BricksHit",
      "conditions": [
        "window.__3D_STATE__.bricksDestroyed > 0"
      ]
    }
  ],
