{
  "task_id": "P676_queueing_theory_bank_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "BankFloor",
      "type": "3d_object",
      "semantic": "The bank floor plane and walls forming the environment",
      "locator_hints": [
        "plane geometry at y=0",
        "beige colored floor"
      ]
    },
    {
      "id": "A2",
      "name": "TellerCounters",
      "type": "3d_object",
      "semantic": "Box geometries representing teller service counters along back wall",
      "locator_hints": [
        "box at z=-8",
        "brown colored counters"
      ]
    },
    {
      "id": "A3",
      "name": "TellerStatusLights",
      "type": "3d_object",
      "semantic": "Sphere indicators above each teller showing busy/available",
      "locator_hints": [
        "small spheres above counters",
        "green or red color"
      ]
    },
    {
      "id": "A4",
      "name": "Customers",
      "type": "3d_object",
      "semantic": "Capsule geometries representing bank customers in queue or being served",
      "locator_hints": [
        "capsule geometry",
        "pastel colored"
      ]
    },
    {
      "id": "A5",
      "name": "StartPauseButton",
      "type": "dom_element",
      "semantic": "Button to start or pause the simulation",
      "locator_hints": [
        "#btn-start-pause"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the simulation to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "ArrivalRateSlider",
      "type": "dom_element",
      "semantic": "Slider controlling customer arrival rate lambda",
      "locator_hints": [
        "#slider-arrival"
      ]
    },
    {
      "id": "A8",
      "name": "ServiceRateSlider",
      "type": "dom_element",
      "semantic": "Slider controlling teller service rate mu",
      "locator_hints": [
        "#slider-service"
      ]
    },
    {
      "id": "A9",
      "name": "TellerAddButton",
      "type": "dom_element",
      "semantic": "Button to add a teller",
      "locator_hints": [
        "#btn-teller-add"
      ]
    },
    {
      "id": "A10",
      "name": "TellerRemoveButton",
      "type": "dom_element",
      "semantic": "Button to remove a teller",
      "locator_hints": [
        "#btn-teller-remove"
      ]
    },
    {
      "id": "A11",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing live queue statistics",
      "locator_hints": [
        "#stats-panel"
      ]
    },
    {
      "id": "A12",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed multiplier",
      "locator_hints": [
        "#slider-speed"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalArrivals === 0",
        "window.__3D_STATE__.numTellers === 3",
        "window.__3D_STATE__.queueLength === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Running_Accumulating",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.totalArrivals > 0",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Running_With_Queue",
      "conditions": [
        "window.__3D_STATE__.running === true",
        "window.__3D_STATE__.queueLength > 0",
        "window.__3D_STATE__.totalInSystem > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalArrivals > 0"
      ]
    },
    {
      "id": "S4",
      "name": "Tellers_Added",
      "conditions": [
        "window.__3D_STATE__.numTellers === 4"
      ]
    },
    {
      "id": "S5",
      "name": "Tellers_Reduced",
      "conditions": [
        "window.__3D_STATE__.numTellers === 3"
      ]
    },
    {
      "id": "S6",
      "name": "High_Arrival_Rate",
      "conditions": [
        "window.__3D_STATE__.arrivalRate >= 4.0",
        "window.__3D_STATE__.running === true"
      ]
    },
    {
      "id": "S7",
      "name": "Serving_Customers",
      "conditions": [
        "window.__3D_STATE__.totalServed > 0",
        "window.__3D_STATE__.throughput > 0"
      ]
    },
    {
      "id": "S8",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.running === false",
        "window.__3D_STATE__.totalArrivals === 0",
        "window.__3D_STATE__.totalServed === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.simulationSpeed !== 1.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-start-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalArrivals === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.numTellers === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.tellerStates) && window.__3D_STATE__.tellerStates.length === 3",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalArrivals > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInSystem >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgWaitTime) && window.__3D_STATE__.avgWaitTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.serverUtilization >= 0 && window.__3D_STATE__.serverUtilization <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals === window.__3D_STATE__.totalServed + window.__3D_STATE__.totalInSystem",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.throughput)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals === window.__3D_STATE__.totalServed + window.__3D_STATE__.totalInSystem",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-teller-add"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numTellers === 4",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.tellerStates) && window.__3D_STATE__.tellerStates.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tellerStates[3] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.tellerStates[3].busy === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.tellerStates[3].customersServed === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-teller-remove"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.numTellers === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.tellerStates) && window.__3D_STATE__.tellerStates.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals === window.__3D_STATE__.totalServed + window.__3D_STATE__.totalInSystem",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.queueLength) && window.__3D_STATE__.queueLength >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-arrival'); let nativeSet = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSet.call(s, '4.5'); s.dispatchEvent(new Event('input', {bubbles:true})); document.getElementById('btn-start-pause').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.arrivalRate >= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.theoreticalAvgWait === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.theoreticalAvgWait)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalAvgWait >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalServed > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.throughput > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgServiceTime) && window.__3D_STATE__.avgServiceTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals === window.__3D_STATE__.totalServed + window.__3D_STATE__.totalInSystem",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.serverUtilization > 0 && window.__3D_STATE__.serverUtilization <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "let s = document.getElementById('slider-speed'); let nativeSet = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; nativeSet.call(s, '3.0'); s.dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationSpeed >= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number' && window.__3D_STATE__.simTime > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.avgWaitTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S9",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalArrivals === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalServed === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInSystem === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queueLength === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.numTellers === 3",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.customers)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.serverUtilization === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.serverUtilization)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}