      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A8",
      "name": "PresetSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select effect presets",
      "locator_hints": [
        "#presetSelect"
      ]
    },
    {
      "id": "A9",
      "name": "EffectComposer",
      "type": "3d_object",
      "semantic": "Three.js EffectComposer managing post-processing pipeline",
      "locator_hints": [
        "composer.passes"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialDefault",
      "conditions": [
        "window.__3D_STATE__.effectEnabled === true",
        "window.__3D_STATE__.chromaticStrength === 0.01",
        "window.__3D_STATE__.chromaticAngle === 0",
        "window.__3D_STATE__.distortionK1 === 0.0",
        "window.__3D_STATE__.distortionK2 === 0.0",
        "window.__3D_STATE__.activePreset === 'None' || window.__3D_STATE__.activePreset === 'Custom'",
        "window.__3D_STATE__.composerPassCount === 2"
      ]
    },
    {
      "id": "S1",
      "name": "EffectDisabled",
      "conditions": [
        "window.__3D_STATE__.effectEnabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "EffectReEnabled",
      "conditions": [
        "window.__3D_STATE__.effectEnabled === true"
      ]
    },
    {
      "id": "S3",
      "name": "ChromaticStrengthAdjusted",
      "conditions": [
        "window.__3D_STATE__.chromaticStrength >= 0.03 && window.__3D_STATE__.chromaticStrength <= 0.04"
      ]
    },
    {
      "id": "S4",
      "name": "DistortionK1Adjusted",
      "conditions": [
        "window.__3D_STATE__.distortionK1 >= 0.4 && window.__3D_STATE__.distortionK1 <= 0.6"
      ]
    },
    {
      "id": "S5",
      "name": "HeavyBarrelPresetApplied",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Heavy Barrel'",
        "Math.abs(window.__3D_STATE__.chromaticStrength - 0.02) < 0.001",
        "Math.abs(window.__3D_STATE__.distortionK1 - 0.6) < 0.01"
      ]
    },
    {
      "id": "S6",
      "name": "PsychedelicPresetApplied",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Psychedelic'",
        "Math.abs(window.__3D_STATE__.chromaticStrength - 0.04) < 0.001",
        "Math.abs(window.__3D_STATE__.distortionK1 - 0.8) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "ManualOverrideAfterPreset",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Custom'"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.chromaticStrength === 0.01",
        "window.__3D_STATE__.distortionK1 === 0.0",
        "window.__3D_STATE__.distortionK2 === 0.0",
        "window.__3D_STATE__.chromaticAngle === 0"
      ]
    },
    {
      "id": "S9",
      "name": "SubtlePresetViaKeyboard",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'Subtle'",
        "Math.abs(window.__3D_STATE__.chromaticStrength - 0.005) < 0.001",
        "Math.abs(window.__3D_STATE__.chromaticAngle - 45) < 1"
      ]
    },
    {
      "id": "S10",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 0",
        "typeof window.__3D_STATE__.torusRotationY === 'number'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.torusRotationY === 'number' && !isNaN(window.__3D_STATE__.torusRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.effectEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.uniformsSync === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
