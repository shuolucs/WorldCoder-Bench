{
  "task_id": "P1933_chromatic_aberration_with_lens_distortio",
  "affordances": [
    {
      "id": "A1",
      "name": "TorusKnot",
      "type": "3d_object",
      "semantic": "Central rotating torus knot mesh",
      "locator_hints": [
        "scene.children with geometry type TorusKnotGeometry"
      ]
    },
    {
      "id": "A2",
      "name": "EffectToggleCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox to enable/disable the post-process effect",
      "locator_hints": [
        "#toggleEffect"
      ]
    },
    {
      "id": "A3",
      "name": "ChromaticStrengthSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling chromatic aberration strength",
      "locator_hints": [
        "#chromaticStrength"
      ]
    },
    {
      "id": "A4",
      "name": "ChromaticAngleSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling chromatic aberration angle",
      "locator_hints": [
        "#chromaticAngle"
      ]
    },
    {
      "id": "A5",
      "name": "DistortionK1Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling primary radial distortion",
      "locator_hints": [
        "#distortionK1"
      ]
    },
    {
      "id": "A6",
      "name": "DistortionK2Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling secondary radial distortion",
      "locator_hints": [
