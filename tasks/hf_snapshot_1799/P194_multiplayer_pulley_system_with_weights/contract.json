    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.massA === 3",
        "window.__3D_STATE__.massB === 0",
        "window.__3D_STATE__.foxOnPlatform === 'A'",
        "Math.abs(window.__3D_STATE__.platformA_y - 4) < 0.5"
      ]
    },
    {
      "id": "S1",
      "name": "FoxMovedToB",
      "conditions": [
        "window.__3D_STATE__.foxOnPlatform === 'B'",
        "window.__3D_STATE__.massA === 0",
        "window.__3D_STATE__.massB === 3"
      ]
    },
    {
      "id": "S2",
      "name": "BlockAddedToA",
      "conditions": [
        "window.__3D_STATE__.blocksOnA >= 1",
        "window.__3D_STATE__.massA >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "PlatformsMoved",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "Math.abs(window.__3D_STATE__.platformA_y - 4) > 0.3"
      ]
    },
    {
      "id": "S5",
      "name": "PlatformsClamped",
      "conditions": [
        "window.__3D_STATE__.platformA_y >= 1 && window.__3D_STATE__.platformA_y <= 7",
        "window.__3D_STATE__.platformB_y >= 1 && window.__3D_STATE__.platformB_y <= 7"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.foxOnPlatform === 'A'",
        "window.__3D_STATE__.blocksOnA === 0",
        "window.__3D_STATE__.blocksOnB === 0"
      ]
    },
    {
      "id": "S7",
      "name": "BalancedSystem",
      "conditions": [
        "Math.abs(window.__3D_STATE__.massA - window.__3D_STATE__.massB) < 0.5",
        "Math.abs(window.__3D_STATE__.acceleration) < 1.0"
      ]
    }
