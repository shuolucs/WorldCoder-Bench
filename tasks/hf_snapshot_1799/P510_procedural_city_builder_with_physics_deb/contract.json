        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-snapshot"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.snapshot !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.snapshot)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.snapshot.every(s => typeof s.gridX === 'number' && typeof s.gridZ === 'number' && typeof s.height === 'number')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.snapshot.every(s => s.height >= 2 && s.height <= 15)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S9",
