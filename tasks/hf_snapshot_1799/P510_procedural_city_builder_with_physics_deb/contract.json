{
  "task_id": "P510_procedural_city_builder_with_physics_deb",
  "affordances": [
    {
      "id": "A1",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "50x50 ground plane for building placement",
      "locator_hints": [
        "ground",
        "plane at y=0"
      ]
    },
    {
      "id": "A2",
      "name": "PreviewBuilding",
      "type": "3d_object",
      "semantic": "Semi-transparent green preview of building to be placed",
      "locator_hints": [
        "preview",
        "green transparent box"
      ]
    },
    {
      "id": "A3",
      "name": "PlacedBuildings",
      "type": "3d_object",
      "semantic": "Array of placed city buildings on the grid",
      "locator_hints": [
        "buildings",
        "boxes on grid"
      ]
    },
    {
      "id": "A4",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Statistics overlay panel",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A5",
      "name": "RandomizeButton",
      "type": "dom_element",
      "semantic": "Button to place 10 random buildings",
      "locator_hints": [
        "#btn-randomize"
      ]
    },
    {
      "id": "A6",
      "name": "ClearButton",
      "type": "dom_element",
      "semantic": "Button to remove all buildings",
      "locator_hints": [
        "#btn-clear"
      ]
    },
    {
      "id": "A7",
      "name": "EarthquakeButton",
      "type": "dom_element",
      "semantic": "Button to trigger earthquake simulation",
      "locator_hints": [
        "#btn-earthquake"
      ]
    },
    {
      "id": "A8",
      "name": "SnapshotButton",
      "type": "dom_element",
      "semantic": "Button to save city layout snapshot",
      "locator_hints": [
        "#btn-snapshot"
      ]
    },
    {
      "id": "A9",
      "name": "DebugOverlay",
      "type": "3d_object",
      "semantic": "Wireframe bounding boxes, mass labels, velocity arrows",
      "locator_hints": [
        "debug wireframes",
        "yellow bounding boxes"
      ]
    },
    {
      "id": "A10",
      "name": "HeatmapCells",
      "type": "3d_object",
      "semantic": "Colored ground cells showing building density",
      "locator_hints": [
        "heatmap planes",
        "colored cells at y=0.05"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty_City",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 0",
        "window.__3D_STATE__.totalMass === 0",
        "window.__3D_STATE__.debugMode === false",
        "window.__3D_STATE__.heatmapMode === false",
        "window.__3D_STATE__.earthquakeActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "Randomized_City",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 10",
        "window.__3D_STATE__.totalMass > 0",
        "window.__3D_STATE__.avgHeight > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Debug_Mode_On",
      "conditions": [
        "window.__3D_STATE__.debugMode === true"
      ]
    },
    {
      "id": "S3",
      "name": "Debug_Mode_Off",
      "conditions": [
        "window.__3D_STATE__.debugMode === false"
      ]
    },
    {
      "id": "S4",
      "name": "Heatmap_Mode_On",
      "conditions": [
        "window.__3D_STATE__.heatmapMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "Heatmap_Mode_Off",
      "conditions": [
        "window.__3D_STATE__.heatmapMode === false"
      ]
    },
    {
      "id": "S6",
      "name": "Earthquake_Active",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === true"
      ]
    },
    {
      "id": "S7",
      "name": "Post_Earthquake",
      "conditions": [
        "window.__3D_STATE__.earthquakeActive === false",
        "window.__3D_STATE__.lastCollapsedCount >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "City_Cleared",
      "conditions": [
        "window.__3D_STATE__.buildingCount === 0",
        "window.__3D_STATE__.totalMass === 0",
        "window.__3D_STATE__.avgHeight === 0",
        "window.__3D_STATE__.maxHeight === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Snapshot_Saved",
      "conditions": [
        "window.__3D_STATE__.snapshot !== null",
        "Array.isArray(window.__3D_STATE__.snapshot)"
      ]
    },
    {
      "id": "S10",
      "name": "Buildings_Animating",
      "conditions": [
        "window.__3D_STATE__.animatingCount > 0"
      ]
    },
    {
      "id": "S11",
      "name": "Buildings_Settled",
      "conditions": [
        "window.__3D_STATE__.animatingCount === 0",
        "window.__3D_STATE__.buildingCount > 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-randomize"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 700
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S11",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-debug').textContent.includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('hud-debug').textContent.includes('OFF')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
