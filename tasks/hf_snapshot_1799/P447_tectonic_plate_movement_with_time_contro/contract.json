  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.plateCount === 4"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationAdvanced",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.simulationTime >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed === 4"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPausedMidway",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.simulationTime > 0"
      ]
    },
    {
      "id": "S5",
      "name": "ConvergentBoundary",
      "conditions": [
        "window.__3D_STATE__.convergentActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.isPlaying === false"
      ]
    }
  ],
