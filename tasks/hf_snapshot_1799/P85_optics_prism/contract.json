            "expr": "(function(){ const n = window.__3D_STATE__.refractiveIndex; const lightAng = window.__3D_STATE__.lightAngle * Math.PI / 180; const sinRefracted = Math.sin(lightAng) / n; if (sinRefracted > 1) return true; const refractedAng = Math.asin(sinRefracted); const prismApex = 60 * Math.PI / 180; const internalAngle = prismApex - refractedAng; const sinExit = n * Math.sin(internalAngle); if (sinExit > 1) return true; const exitAng = Math.asin(sinExit); const theoreticalDeviation = (lightAng - refractedAng) + (exitAng - internalAngle) + 0; const td_deg = theoreticalDeviation * 180 / Math.PI; const actualTD = window.__3D_STATE__.totalDeviation; return Math.abs(actualTD - td_deg) < td_deg * 0.15 + 5; })()",
