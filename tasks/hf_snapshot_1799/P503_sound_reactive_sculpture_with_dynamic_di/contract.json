    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.fishCount === 8"
