{
  "task_id": "P1249_voxel_raymarcher_with_transfer_function_",
  "affordances": [
    {
      "id": "A1",
      "name": "VolumeQuad",
      "type": "3d_object",
      "semantic": "Fullscreen quad rendering the raymarched volume",
      "locator_hints": [
        "scene.children mesh with ShaderMaterial",
        "PlaneGeometry(2,2)"
      ]
    },
    {
      "id": "A2",
      "name": "TFEditorCanvas",
      "type": "dom_element",
      "semantic": "2D canvas for editing the transfer function",
      "locator_hints": [
        "#tf-editor",
        "canvas element 512x150"
      ]
    },
    {
      "id": "A3",
      "name": "HUDOverlay",
      "type": "dom_element",
      "semantic": "Top-left HUD showing step size, FPS, TF version",
      "locator_hints": [
        "top-left text overlay",
        "monospace font element"
      ]
    },
    {
      "id": "A4",
      "name": "MainCanvas",
      "type": "dom_element",
      "semantic": "Three.js WebGL canvas for 3D rendering and camera orbit",
      "locator_hints": [
        "document.querySelector('canvas')",
        "renderer.domElement"
      ]
    },
    {
      "id": "A5",
      "name": "ControlPoints",
      "type": "dom_element",
      "semantic": "5 draggable control points on the TF editor canvas",
      "locator_hints": [
        "circles drawn on #tf-editor canvas"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.volumeSize.x === 64",
        "window.__3D_STATE__.stepSize === 1/128",
        "window.__3D_STATE__.cameraAzimuth === 0",
        "window.__3D_STATE__.cameraElevation === 0",
        "window.__3D_STATE__.cameraDistance === 2.5",
        "window.__3D_STATE__.controlPoints.length === 5",
        "window.__3D_STATE__.tfEditorVisible === true",
        "window.__3D_STATE__.backgroundColor === '#000000'",
        "window.__3D_STATE__.transferFunctionVersion >= 1"
      ]
    },
    {
      "id": "S1",
      "name": "StepSizeToggled",
      "conditions": [
        "window.__3D_STATE__.stepSize === 1/64"
      ]
    },
    {
      "id": "S2",
      "name": "CameraOrbited",
      "conditions": [
        "window.__3D_STATE__.cameraAzimuth !== 0 || window.__3D_STATE__.cameraElevation !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "CameraReset",
      "conditions": [
        "window.__3D_STATE__.cameraAzimuth === 0",
        "window.__3D_STATE__.cameraElevation === 0",
        "window.__3D_STATE__.cameraDistance === 2.5"
      ]
    },
    {
      "id": "S4",
      "name": "TFEditorHidden",
      "conditions": [
        "window.__3D_STATE__.tfEditorVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "TFEditorRestored",
      "conditions": [
        "window.__3D_STATE__.tfEditorVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "ControlPointDragged",
      "conditions": [
        "window.__3D_STATE__.controlPoints[2].opacity !== 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "BackgroundCycled",
      "conditions": [
        "window.__3D_STATE__.backgroundColor === '#333333'"
      ]
    },
    {
      "id": "S8",
      "name": "BackgroundCycledAgain",
      "conditions": [
        "window.__3D_STATE__.backgroundColor === '#001133'"
      ]
    },
    {
      "id": "S9",
      "name": "CameraZoomed",
      "conditions": [
        "window.__3D_STATE__.cameraDistance !== 2.5"
      ]
    },
    {
      "id": "S10",
      "name": "StepSizeRestoredHigh",
      "conditions": [
        "window.__3D_STATE__.stepSize === 1/128"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.volumeSize.x === 64 && window.__3D_STATE__.volumeSize.y === 64 && window.__3D_STATE__.volumeSize.z === 64",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stepSize === 1/128",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.controlPoints) && window.__3D_STATE__.controlPoints.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[0].density === 0 && window.__3D_STATE__.controlPoints[0].opacity === 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[2].density === 127 && Math.abs(window.__3D_STATE__.controlPoints[2].opacity - 0.5) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.stepSize - 1/64) < 0.0001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxSteps === 256",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.accumulationMethod === 'front_to_back'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const c = document.querySelector('canvas'); const rect = c.getBoundingClientRect(); const cx = rect.left + rect.width/2; const cy = rect.top + rect.height/2; c.dispatchEvent(new MouseEvent('mousedown', {clientX: cx, clientY: cy, button: 0, bubbles: true})); c.dispatchEvent(new MouseEvent('mousemove', {clientX: cx + 120, clientY: cy - 60, button: 0, bubbles: true})); c.dispatchEvent(new MouseEvent('mouseup', {clientX: cx + 120, clientY: cy - 60, button: 0, bubbles: true})); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraAzimuth === 'number' && !isNaN(window.__3D_STATE__.cameraAzimuth)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraElevation === 'number' && !isNaN(window.__3D_STATE__.cameraElevation)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraAzimuth) > 1 || Math.abs(window.__3D_STATE__.cameraElevation) > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraElevation >= -89 && window.__3D_STATE__.cameraElevation <= 89",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 1.0 && window.__3D_STATE__.cameraDistance <= 5.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraAzimuth === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraElevation === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraDistance - 2.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tfEditorVisible === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tf-editor') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('tf-editor').style.display === 'none' || document.getElementById('tf-editor').offsetParent === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tfEditorVisible === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('tf-editor').offsetParent !== null || document.getElementById('tf-editor').style.display !== 'none'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints.length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transferFunctionVersion >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "(() => { const tfCanvas = document.getElementById('tf-editor'); const rect = tfCanvas.getBoundingClientRect(); const cpX = rect.left + (127/255) * rect.width; const cpYStart = rect.top + rect.height * (1 - 0.5); const cpYEnd = rect.top + rect.height * (1 - 0.15); const prevVersion = window.__3D_STATE__.transferFunctionVersion; tfCanvas.dispatchEvent(new MouseEvent('mousedown', {clientX: cpX, clientY: cpYStart, bubbles: true})); tfCanvas.dispatchEvent(new MouseEvent('mousemove', {clientX: cpX, clientY: cpYEnd, bubbles: true})); tfCanvas.dispatchEvent(new MouseEvent('mouseup', {clientX: cpX, clientY: cpYEnd, bubbles: true})); window.__3D_STATE__._prevTFVersion = prevVersion; })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.controlPoints[2].opacity - 0.5) > 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[2].opacity >= 0 && window.__3D_STATE__.controlPoints[2].opacity <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[2].density === 127",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.transferFunctionVersion > (window.__3D_STATE__._prevTFVersion || 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.controlPoints[0].opacity === 0 && window.__3D_STATE__.controlPoints[4].opacity === 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.backgroundColor === '#333333'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.backgroundColor === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.backgroundColor === '#001133'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earlyTerminationThreshold === 0.95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.accumulationMethod === 'front_to_back'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "(() => { const c = document.querySelector('canvas'); const evt = new WheelEvent('wheel', {deltaY: 300, bubbles: true}); c.dispatchEvent(evt); })()"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraDistance > 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rayMarchActive === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}