        "text_match": "Technology"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalBars !== before.totalBars || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalBars === 'number' && !isNaN(window.__3D_STATE__.totalBars)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.hoveredBarIndex === 'number' && !isNaN(window.__3D_STATE__.hoveredBarIndex)",
            "tier": "L0"
          },
