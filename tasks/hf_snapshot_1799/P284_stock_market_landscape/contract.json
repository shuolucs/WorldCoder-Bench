      "type": "3d_object",
      "semantic": "Grid of 100 vertical bars representing stock prices colored by sector",
      "locator_hints": [
        "BoxGeometry bars in 10x10 grid"
      ]
    },
    {
      "id": "A2",
      "name": "AnalystModel",
      "type": "3d_object",
      "semantic": "facecap.glb model acting as market analyst avatar",
      "locator_hints": [
        "GLTF model at (0, 0, -22)"
      ]
    },
    {
      "id": "A3",
      "name": "SectorButtons",
      "type": "dom_element",
      "semantic": "Filter buttons for Technology, Finance, Healthcare, Energy, Consumer, All",
      "locator_hints": [
        "button elements at top of screen"
      ]
    },
    {
      "id": "A4",
      "name": "Tooltip",
      "type": "dom_element",
      "semantic": "Hover tooltip showing bar sector and height",
      "locator_hints": [
        "div tooltip following mouse"
      ]
    },
    {
      "id": "A5",
      "name": "HUDMarketIndex",
      "type": "dom_element",
      "semantic": "Market index display showing average bar height",
      "locator_hints": [
        "top-left HUD element"
      ]
    },
    {
      "id": "A6",
      "name": "HUDStatus",
      "type": "dom_element",
      "semantic": "Simulation status display (LIVE/PAUSED)",
      "locator_hints": [
        "bottom HUD element"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalBars === 100",
        "window.__3D_STATE__.activeFilter === 'All'",
        "window.__3D_STATE__.simulationRunning === false",
        "window.__3D_STATE__.currentView === 'default'",
        "window.__3D_STATE__.timeOfDay === 'day'"
      ]
    },
    {
      "id": "S1",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "SectorFiltered",
      "conditions": [
        "window.__3D_STATE__.activeFilter !== 'All'"
      ]
    },
    {
      "id": "S3",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true"
      ]
    },
    {
      "id": "S4",
      "name": "MarketCrashed",
      "conditions": [
        "window.__3D_STATE__.crashTriggered === true"
      ]
    },
    {
      "id": "S5",
      "name": "MarketRecovered",
      "conditions": [
        "window.__3D_STATE__.recovered === true"
      ]
    },
    {
      "id": "S6",
      "name": "ViewChanged",
      "conditions": [
        "window.__3D_STATE__.currentView !== 'default'"
      ]
    },
    {
      "id": "S7",
      "name": "TimeChanged",
      "conditions": [
        "window.__3D_STATE__.timeOfDay !== 'day'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.right !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBars !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalBars === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.hoveredBarIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationRunning === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalBars >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
