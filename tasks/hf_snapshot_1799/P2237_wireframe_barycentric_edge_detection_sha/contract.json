{
  "task_id": "P2237_wireframe_barycentric_edge_detection_sha",
  "affordances": [
    {
      "id": "A1",
      "name": "FaceCapModel",
      "type": "3d_object",
      "semantic": "The loaded facecap.glb model with barycentric wireframe shader applied",
      "locator_hints": [
        "scene.children",
        "mesh with ShaderMaterial"
      ]
    },
    {
      "id": "A2",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing all shader parameters and stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A3",
      "name": "KeyboardControls",
      "type": "dom_element",
      "semantic": "Keyboard event listeners for W/S/D/A/Q/M/C/R/Z/Y keys",
      "locator_hints": [
        "document keydown listener"
      ]
    },
    {
      "id": "A4",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "PerspectiveCamera with OrbitControls",
      "locator_hints": [
        "camera at (0,0,3)"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.triangleCount > 0",
        "window.__3D_STATE__.hasBarycentricAttr === true"
      ]
    },
    {
      "id": "S1",
      "name": "EdgeWidthIncreased",
      "conditions": [
        "window.__3D_STATE__.edgeWidth === 1.75"
      ]
    },
    {
      "id": "S2",
      "name": "EdgeWidthDecreased",
      "conditions": [
        "window.__3D_STATE__.edgeWidth === 1.5"
      ]
    },
    {
      "id": "S3",
      "name": "RenderModeCycled",
      "conditions": [
        "window.__3D_STATE__.renderMode === 1",
        "window.__3D_STATE__.renderModeName === 'wireframe_only'"
      ]
    },
    {
      "id": "S4",
      "name": "XRayModeActive",
      "conditions": [
        "window.__3D_STATE__.renderMode === 3",
        "window.__3D_STATE__.renderModeName === 'xray'"
      ]
    },
    {
      "id": "S5",
      "name": "ColorPresetChanged",
      "conditions": [
        "window.__3D_STATE__.colorPresetIndex === 1",
        "window.__3D_STATE__.colorPresetName === 'magenta'"
      ]
    },
    {
      "id": "S6",
      "name": "DashEnabled",
      "conditions": [
        "window.__3D_STATE__.dashEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "AnimationActive",
      "conditions": [
        "window.__3D_STATE__.animationSpeed === 2.0"
      ]
    },
    {
      "id": "S8",
      "name": "DiagonalsSuppressed",
      "conditions": [
        "window.__3D_STATE__.showDiagonals === false"
      ]
    },
    {
      "id": "S9",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.showDiagonals === true",
        "window.__3D_STATE__.historySize >= 0"
      ]
    },
    {
      "id": "S10",
      "name": "RedoApplied",
      "conditions": [
        "window.__3D_STATE__.showDiagonals === false",
        "window.__3D_STATE__.redoSize >= 0"
      ]
    },
    {
      "id": "S11",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.edgeWidth === 1.5",
        "window.__3D_STATE__.renderMode === 0",
        "window.__3D_STATE__.colorPresetIndex === 0",
        "window.__3D_STATE__.dashEnabled === false",
        "window.__3D_STATE__.animationSpeed === 0.0",
        "window.__3D_STATE__.showDiagonals === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.triangleCount > 0 && !isNaN(window.__3D_STATE__.triangleCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.hasBarycentricAttr === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeWidth - 1.5) < 0.001 && window.__3D_STATE__.renderMode === 0 && window.__3D_STATE__.colorPresetIndex === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeWidth - 1.75) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeWidth >= 0.25 && window.__3D_STATE__.edgeWidth <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.edgeWidth)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historySize >= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.includes('1.75')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "s"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeWidth - 1.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeWidth >= 0.25 && window.__3D_STATE__.edgeWidth <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.edgeWidth)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historySize >= 2",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.includes('1.50')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "m"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.renderMode === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderModeName === 'wireframe_only'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fillOpacity === 0 || Math.abs(window.__3D_STATE__.edgeOpacity - 1.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendingMode === 'NormalBlending'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.toLowerCase().includes('wireframe_only')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'm'})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'm'})), 100);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.renderMode === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderModeName === 'xray'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendingMode === 'AdditiveBlending'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fillOpacity <= 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeOpacity - 1.0) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorPresetIndex === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorPresetName === 'magenta'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.edgeColor) && window.__3D_STATE__.edgeColor.length === 3",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeColor[0] - 1.0) < 0.01 && Math.abs(window.__3D_STATE__.edgeColor[1] - 0.0) < 0.01 && Math.abs(window.__3D_STATE__.edgeColor[2] - 0.8) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.edgeColor.every(c => c >= 0.0 && c <= 1.0 && !isNaN(c))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dashEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dashEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.historySize >= 1",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.toLowerCase().includes('on')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.animationSpeed - 2.0) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.animationSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time >= 0 && !isNaN(window.__3D_STATE__.time)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.fps === 'number' && window.__3D_STATE__.fps > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "q"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.showDiagonals === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.showDiagonals === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.historySize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoSize === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null && document.getElementById('hud').textContent.toLowerCase().includes('off')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "z"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.showDiagonals === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.historySize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.historySize) && !isNaN(window.__3D_STATE__.redoSize)",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "y"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.showDiagonals === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoSize >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.showDiagonals === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.triangleCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeWidth - 1.5) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderMode === 0 && window.__3D_STATE__.renderModeName === 'wireframe_overlay'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorPresetIndex === 0 && window.__3D_STATE__.colorPresetName === 'cyan'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dashEnabled === false && Math.abs(window.__3D_STATE__.animationSpeed - 0.0) < 0.001 && window.__3D_STATE__.showDiagonals === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fillOpacity - 0.85) < 0.01 && Math.abs(window.__3D_STATE__.edgeOpacity - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blendingMode === 'NormalBlending'",
            "tier": "L2"
          }
        ]
      }
