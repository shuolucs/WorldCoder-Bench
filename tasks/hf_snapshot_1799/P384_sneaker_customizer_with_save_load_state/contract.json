  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_DefaultState",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.selectedPart === 'partA'",
        "window.__3D_STATE__.partMaterials.partA === 'standard'",
        "window.__3D_STATE__.partScales.partA === 1.0",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
      "name": "PartBSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'partB'"
      ]
    },
    {
      "id": "S2",
      "name": "PartAColoredRed",
      "conditions": [
        "window.__3D_STATE__.partColors.partA === 0xff0000"
      ]
    },
    {
      "id": "S3",
      "name": "PartBMetallic",
      "conditions": [
        "window.__3D_STATE__.partMaterials.partB === 'metallic'"
      ]
    },
    {
      "id": "S4",
      "name": "PartBScaled",
      "conditions": [
        "window.__3D_STATE__.partScales.partB >= 1.4 && window.__3D_STATE__.partScales.partB <= 1.6"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateOn",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S6",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.saveCount >= 1",
        "window.__3D_STATE__.statusText === 'Saved!'"
      ]
    },
    {
      "id": "S7",
      "name": "StateReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.partScales.partA === 1.0",
        "window.__3D_STATE__.partScales.partB === 1.0",
        "window.__3D_STATE__.partMaterials.partA === 'standard'",
        "window.__3D_STATE__.partMaterials.partB === 'standard'"
      ]
    },
    {
      "id": "S8",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.loadCount >= 1",
        "window.__3D_STATE__.statusText === 'Loaded!'"
      ]
    },
    {
      "id": "S9",
      "name": "PartCGlossyBlue",
      "conditions": [
        "window.__3D_STATE__.selectedPart === 'partC'",
        "window.__3D_STATE__.partColors.partC === 0x0000ff",
        "window.__3D_STATE__.partMaterials.partC === 'glossy'"
      ]
    },
    {
      "id": "S10",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    }
  ],
