        "code": "function pressKey(k,n){for(let i=0;i<n;i++){document.dispatchEvent(new KeyboardEvent('keydown',{key:k}));}} window.__3D_STATE__.lightAzimuth > 45 ? pressKey('ArrowLeft', Math.round((window.__3D_STATE__.lightAzimuth - 45)/10)) : pressKey('ArrowRight', Math.round((45 - window.__3D_STATE__.lightAzimuth)/10)); setTimeout(()=>{ let elDiff = 30 - window.__3D_STATE__.lightElevation; elDiff < 0 ? pressKey('ArrowDown', Math.round(Math.abs(elDiff)/5)) : pressKey('ArrowUp', Math.round(elDiff/5)); }, 200);"
      },
