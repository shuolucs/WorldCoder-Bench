    {
      "id": "S7",
      "name": "Trails_Hidden",
      "conditions": [
        "window.__3D_STATE__.trailsVisible === false"
      ]
    },
    {
      "id": "S8",
      "name": "After_Reset",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.challengeActive === false"
      ]
    },
    {
      "id": "S9",
      "name": "High_Speed_Running",
      "conditions": [
        "window.__3D_STATE__.timeScale === 4.0",
        "window.__3D_STATE__.isPaused === false"
      ]
    }
  ],
