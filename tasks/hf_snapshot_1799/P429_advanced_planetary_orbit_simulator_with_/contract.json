      ]
    },
    {
      "id": "S2",
      "name": "Simulation_Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S3",
      "name": "TimeScale_Changed",
      "conditions": [
        "window.__3D_STATE__.timeScale !== 1.0",
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S4",
      "name": "Planet_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedPlanet !== null"
      ]
    },
    {
      "id": "S5",
