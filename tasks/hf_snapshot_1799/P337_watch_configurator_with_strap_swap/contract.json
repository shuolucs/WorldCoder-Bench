  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.strapType === 'leather'",
        "window.__3D_STATE__.dialColor === 'white'",
        "window.__3D_STATE__.caseMaterial === 'silver'",
        "window.__3D_STATE__.totalPrice === 299",
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S1",
      "name": "SteelStrapSelected",
      "conditions": [
        "window.__3D_STATE__.strapType === 'steel'",
        "window.__3D_STATE__.totalPrice === 379"
      ]
    },
    {
      "id": "S2",
      "name": "SteelStrapBlackDial",
      "conditions": [
        "window.__3D_STATE__.strapType === 'steel'",
        "window.__3D_STATE__.dialColor === 'black'",
        "window.__3D_STATE__.totalPrice === 389"
      ]
    },
    {
      "id": "S3",
      "name": "SteelStrapBlackDialGoldCase",
      "conditions": [
        "window.__3D_STATE__.strapType === 'steel'",
        "window.__3D_STATE__.dialColor === 'black'",
        "window.__3D_STATE__.caseMaterial === 'gold'",
        "window.__3D_STATE__.totalPrice === 539"
      ]
    },
    {
      "id": "S4",
      "name": "NatoStrapBlackDialGoldCase",
      "conditions": [
        "window.__3D_STATE__.strapType === 'nato'",
        "window.__3D_STATE__.dialColor === 'black'",
        "window.__3D_STATE__.caseMaterial === 'gold'",
        "window.__3D_STATE__.totalPrice === 474"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateEnabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S6",
      "name": "AutoRotateDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.strapType === 'leather'",
        "window.__3D_STATE__.dialColor === 'white'",
        "window.__3D_STATE__.caseMaterial === 'silver'",
        "window.__3D_STATE__.totalPrice === 299",
        "window.__3D_STATE__.autoRotate === false"
      ]
    }
  ],
