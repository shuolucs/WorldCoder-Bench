  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.temperature === 50",
        "window.__3D_STATE__.simulationSpeed === 1.0",
        "window.__3D_STATE__.cloudSaturation === 0",
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "EvaporationActive",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.evaporationCount > 0",
        "window.__3D_STATE__.cloudSaturation > 0"
      ]
    },
    {
      "id": "S3",
      "name": "HighTemperature",
      "conditions": [
        "window.__3D_STATE__.temperature >= 90",
        "window.__3D_STATE__.evaporationCount > 0"
      ]
    },
    {
      "id": "S4",
      "name": "PrecipitationTriggered",
      "conditions": [
        "window.__3D_STATE__.cloudSaturation >= 0.7",
        "window.__3D_STATE__.precipitationCount > 0"
      ]
    },
    {
      "id": "S5",
      "name": "EvaporationDisabled",
      "conditions": [
        "window.__3D_STATE__.evapEnabled === false"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedModified",
      "conditions": [
        "window.__3D_STATE__.simulationSpeed !== 1.0"
      ]
    },
    {
      "id": "S7",
      "name": "PrecipitationStopped",
      "conditions": [
        "window.__3D_STATE__.cloudSaturation < 0.3",
        "window.__3D_STATE__.precipitationCount === 0"
      ]
    },
    {
      "id": "S8",
      "name": "AllPhasesDisabled",
      "conditions": [
        "window.__3D_STATE__.evapEnabled === false",
        "window.__3D_STATE__.precipEnabled === false",
        "window.__3D_STATE__.runoffEnabled === false"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.cloudSaturation === 0",
        "window.__3D_STATE__.temperature === 50",
        "window.__3D_STATE__.simulationSpeed === 1.0",
        "window.__3D_STATE__.elapsedTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudSaturation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.treeCount >= 5 && window.__3D_STATE__.treeCount <= 8",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#playPauseBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.sunAngle)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cloudSaturation)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.evaporationCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudSaturation > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudSaturation <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaterParticles >= window.__3D_STATE__.evaporationCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('tempSlider').value = 100; document.getElementById('tempSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature <= 100",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.evapEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudSaturation >= 0.7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipitationCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalWaterParticles === window.__3D_STATE__.evaporationCount + window.__3D_STATE__.precipitationCount + window.__3D_STATE__.runoffCount || Math.abs(window.__3D_STATE__.totalWaterParticles - (window.__3D_STATE__.evaporationCount + window.__3D_STATE__.precipitationCount + window.__3D_STATE__.runoffCount)) <= 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.precipitationCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.evapEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.condenseEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('speedSlider').value = 2.5; document.getElementById('speedSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.simulationSpeed - 2.5) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationSpeed > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationSpeed <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.simulationSpeed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('togglePrecip').click(); document.getElementById('toggleRunoff').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.evapEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runoffEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cloudSaturation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.simulationSpeed - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.evapEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precipEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runoffEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudSaturation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oceanWaveAmplitude >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.oceanWaveAmplitude)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.condenseEnabled === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
