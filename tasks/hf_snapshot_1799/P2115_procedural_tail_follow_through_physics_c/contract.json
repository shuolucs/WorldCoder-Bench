{
  "task_id": "P2115_procedural_tail_follow_through_physics_c",
  "affordances": [
    {
      "id": "A1",
      "name": "HorseModel",
      "type": "3d_object",
      "semantic": "The loaded horse.glb model that can be moved with arrow keys",
      "locator_hints": [
        "GLTFLoader result",
        "scene child with horse mesh"
      ]
    },
    {
      "id": "A2",
      "name": "TailChain",
      "type": "3d_object",
      "semantic": "8 sphere segments forming the procedural physics tail",
      "locator_hints": [
        "8 Mesh spheres with color 0xff6644"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button that resets horse and tail to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A4",
      "name": "WindToggle",
      "type": "dom_element",
      "semantic": "Button that toggles lateral wind force on tail",
      "locator_hints": [
        "#btn-wind"
      ]
    },
    {
      "id": "A5",
      "name": "StiffnessSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling spring stiffness (5-80)",
      "locator_hints": [
        "#slider-stiffness"
      ]
    },
    {
      "id": "A6",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing horse position, rotation, tail tip, wind, FPS",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.tailSegmentCount === 8"
      ]
    },
    {
      "id": "S1",
      "name": "InitialIdle",
      "conditions": [
        "Math.abs(window.__3D_STATE__.horsePosition.x) < 0.5",
        "Math.abs(window.__3D_STATE__.horsePosition.z) < 0.5",
        "window.__3D_STATE__.windEnabled === false"
      ]
    },
    {
      "id": "S2",
      "name": "HorseMovedForward",
      "conditions": [
        "window.__3D_STATE__.horsePosition.z < -0.5 || window.__3D_STATE__.horsePosition.z > 0.5 || window.__3D_STATE__.horsePosition.x < -0.5 || window.__3D_STATE__.horsePosition.x > 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "TailFollowThrough",
      "conditions": [
        "window.__3D_STATE__.tailSegments[7].vy !== 0 || window.__3D_STATE__.tailSegments[7].vx !== 0 || window.__3D_STATE__.tailSegments[7].vz !== 0"
      ]
    },
    {
      "id": "S4",
      "name": "WindActive",
      "conditions": [
        "window.__3D_STATE__.windEnabled === true"
      ]
    },
    {
      "id": "S5",
      "name": "StiffnessChanged",
      "conditions": [
        "window.__3D_STATE__.stiffness !== 35"
      ]
    },
    {
      "id": "S6",
      "name": "ResetComplete",
      "conditions": [
        "Math.abs(window.__3D_STATE__.horsePosition.x) < 0.1",
        "Math.abs(window.__3D_STATE__.horsePosition.z) < 0.1"
      ]
    },
    {
      "id": "S7",
      "name": "HorseRotated",
      "conditions": [
        "Math.abs(window.__3D_STATE__.horseRotationY) > 0.3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.tailSegments === 'object' && Array.isArray(window.__3D_STATE__.tailSegments)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tailSegmentCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.length === 8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.anchorPosition === 'object' && window.__3D_STATE__.anchorPosition !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === false && window.__3D_STATE__.stiffness === 35",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.sqrt(window.__3D_STATE__.horsePosition.x ** 2 + window.__3D_STATE__.horsePosition.z ** 2) > 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.horsePosition.x === 'number' && !isNaN(window.__3D_STATE__.horsePosition.x)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.horsePosition.z === 'number' && !isNaN(window.__3D_STATE__.horsePosition.z)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => !isNaN(s.x) && !isNaN(s.y) && !isNaN(s.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => !isNaN(s.vx) && !isNaN(s.vy) && !isNaN(s.vz))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tailSegments[7].vx !== 0 || window.__3D_STATE__.tailSegments[7].vy !== 0 || window.__3D_STATE__.tailSegments[7].vz !== 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.tailSegments[7].x - window.__3D_STATE__.anchorPosition.x) > 0.01 || Math.abs(window.__3D_STATE__.tailSegments[7].z - window.__3D_STATE__.anchorPosition.z) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => Math.abs(s.x) < 50 && Math.abs(s.y) < 50 && Math.abs(s.z) < 50)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every((s, i, arr) => i === 0 || Math.sqrt((s.x - arr[i-1].x)**2 + (s.y - arr[i-1].y)**2 + (s.z - arr[i-1].z)**2) <= 0.35)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowLeft",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.horseRotationY) > 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.horseRotationY === 'number' && !isNaN(window.__3D_STATE__.horseRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments[7].vx !== 0 || window.__3D_STATE__.tailSegments[7].vz !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => isFinite(s.x) && isFinite(s.y) && isFinite(s.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fps > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S7",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-wind"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.windEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => isFinite(s.vx) && isFinite(s.vy) && isFinite(s.vz))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegmentCount === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stiffness === 35",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-stiffness').value = 60; document.getElementById('slider-stiffness').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stiffness === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stiffness >= 5 && window.__3D_STATE__.stiffness <= 80",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stiffness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.windEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => isFinite(s.x) && isFinite(s.y) && isFinite(s.z))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.horsePosition.x) < 0.1 && Math.abs(window.__3D_STATE__.horsePosition.z) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => Math.abs(s.vx) < 0.01 && Math.abs(s.vy) < 0.01 && Math.abs(s.vz) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tailSegments.every(s => isFinite(s.x) && isFinite(s.y) && isFinite(s.z))",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.horseRotationY) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}