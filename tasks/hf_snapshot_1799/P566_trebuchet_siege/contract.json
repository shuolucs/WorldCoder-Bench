{
  "task_id": "P566_trebuchet_siege",
  "affordances": [
    {"id": "A1", "name": "Trebuchet", "type": "3d_object", "semantic": "Siege engine with arm, counterweight, sling", "locator_hints": ["box + cylinder assemblage"]},
    {"id": "A2", "name": "Projectile", "type": "3d_object", "semantic": "Stone ball with trail", "locator_hints": ["small sphere + trail line"]},
    {"id": "A3", "name": "Target", "type": "3d_object", "semantic": "DamagedHelmet GLB + castle wall", "locator_hints": ["GLTF model + stacked boxes"]},
    {"id": "A4", "name": "CWSlider", "type": "dom_element", "semantic": "Counterweight mass control", "locator_hints": ["#slider-counterweight"]},
    {"id": "A5", "name": "ReleaseSlider", "type": "dom_element", "semantic": "Release angle control", "locator_hints": ["#slider-release-angle"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Loaded", "conditions": ["window.__3D_STATE__.status === 'Loaded'"]},
    {"id": "S1", "name": "Firing", "conditions": ["window.__3D_STATE__.status === 'Firing' || window.__3D_STATE__.status === 'Flying'"]},
    {"id": "S2", "name": "Landed", "conditions": ["window.__3D_STATE__.status === 'Hit' || window.__3D_STATE__.status === 'Miss'"]},
    {"id": "S3", "name": "CWChanged", "conditions": ["window.__3D_STATE__.counterweightMass !== 50"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.status === 'Loaded'"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.status === 'Loaded'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.trebuchetValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Firing' || window.__3D_STATE__.status === 'Flying'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.trebuchetValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 6000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Hit' || window.__3D_STATE__.status === 'Miss'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.projectileDistance > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.maxProjectileHeight > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-counterweight').value = 90; document.getElementById('slider-counterweight').dispatchEvent(new Event('input')); document.dispatchEvent(new KeyboardEvent('keydown',{key:'r'})); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.counterweightMass >= 80", "tier": "L2"},
        {"expr": "window.__3D_STATE__.status === 'Loaded'", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Loaded'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.trebuchetValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-release-angle').value = 60; document.getElementById('slider-release-angle').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.releaseAngle >= 55", "tier": "L2"}
      ]}
    }
  ]
}
