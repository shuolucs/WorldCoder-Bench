{
  "task_id": "P2180_velvet_sheen_fabric_material_with_light_",
  "affordances": [
    {
      "id": "A1",
      "name": "FishModel",
      "type": "3d_object",
      "semantic": "BarramundiFish GLB model with velvet sheen material applied",
      "locator_hints": [
        "loaded via GLTFLoader",
        "centered at origin"
      ]
    },
    {
      "id": "A2",
      "name": "KeyLight",
      "type": "3d_object",
      "semantic": "Directional light orbiting the model at controllable angles",
      "locator_hints": [
        "DirectionalLight",
        "yellow sphere indicator"
      ]
    },
    {
      "id": "A3",
      "name": "AzimuthSlider",
      "type": "dom_element",
      "semantic": "Slider controlling light azimuth angle 0-360 degrees",
      "locator_hints": [
        "#azimuthSlider"
      ]
    },
    {
      "id": "A4",
      "name": "ElevationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling light elevation angle 5-85 degrees",
      "locator_hints": [
        "#elevationSlider"
      ]
    },
    {
      "id": "A5",
      "name": "SheenSlider",
      "type": "dom_element",
      "semantic": "Slider controlling material sheen intensity 0-1",
      "locator_hints": [
        "#sheenSlider"
      ]
    },
    {
      "id": "A6",
      "name": "SheenRoughnessSlider",
      "type": "dom_element",
      "semantic": "Slider controlling material sheen roughness 0-1",
      "locator_hints": [
        "#sheenRoughnessSlider"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to defaults",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A8",
      "name": "ColorPresetSelect",
      "type": "dom_element",
      "semantic": "Dropdown to select color presets for the velvet material",
      "locator_hints": [
        "#colorPreset"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Loading",
      "conditions": [
        "window.__3D_STATE__ !== undefined",
        "window.__3D_STATE__.modelLoaded === false"
      ]
    },
    {
      "id": "S1",
      "name": "ModelReady_DefaultParams",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.azimuth === 45",
        "window.__3D_STATE__.elevation === 45",
        "window.__3D_STATE__.sheen === 1.0",
        "window.__3D_STATE__.sheenRoughness === 0.3"
      ]
    },
    {
      "id": "S2",
      "name": "AzimuthChanged",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.azimuth === 180"
      ]
    },
    {
      "id": "S3",
      "name": "ElevationChanged",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.elevation === 75"
      ]
    },
    {
      "id": "S4",
      "name": "SheenModified",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.sheen === 0.5"
      ]
    },
    {
      "id": "S5",
      "name": "SheenRoughnessModified",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.sheenRoughness === 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "ColorPresetChanged",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.colorPreset === 'Royal Blue'"
      ]
    },
    {
      "id": "S7",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.azimuth === 45",
        "window.__3D_STATE__.elevation === 45",
        "window.__3D_STATE__.sheen === 1.0",
        "window.__3D_STATE__.sheenRoughness === 0.3"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightRadius === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor !== undefined && typeof window.__3D_STATE__.materialColor === 'string'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('azimuthSlider').value = 180; document.getElementById('azimuthSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.azimuth === 180",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightPosition.x - 4 * Math.cos(45 * Math.PI/180) * Math.cos(180 * Math.PI/180)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightPosition.z - 4 * Math.cos(45 * Math.PI/180) * Math.sin(180 * Math.PI/180)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightPosition.y - 4 * Math.sin(45 * Math.PI/180)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.lightPosition.x) && !isNaN(window.__3D_STATE__.lightPosition.y) && !isNaN(window.__3D_STATE__.lightPosition.z)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('elevationSlider').value = 75; document.getElementById('elevationSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elevation === 75",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightPosition.y - 4 * Math.sin(75 * Math.PI/180)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.lightPosition.x**2 + window.__3D_STATE__.lightPosition.y**2 + window.__3D_STATE__.lightPosition.z**2) - 4) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightPosition.y > window.__3D_STATE__.lightPosition.x || window.__3D_STATE__.lightPosition.y > window.__3D_STATE__.lightPosition.z",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.azimuth === 180",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sheenSlider').value = 50; document.getElementById('sheenSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sheen === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheen >= 0 && window.__3D_STATE__.sheen <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheenRoughness === 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sheenColor === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sheenRoughnessSlider').value = 80; document.getElementById('sheenRoughnessSlider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sheenRoughness === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheenRoughness >= 0 && window.__3D_STATE__.sheenRoughness <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheen === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elevation === 75",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.azimuth === 180",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('colorPreset').value = 'Royal Blue'; document.getElementById('colorPreset').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorPreset === 'Royal Blue'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialColor.toLowerCase().includes('00008b') || window.__3D_STATE__.materialColor.toLowerCase() === '#00008b'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheenColor.toLowerCase().includes('87ceeb') || window.__3D_STATE__.sheenColor.toLowerCase() === '#87ceeb'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.azimuth === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elevation === 45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheen === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sheenRoughness === 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(Math.sqrt(window.__3D_STATE__.lightPosition.x**2 + window.__3D_STATE__.lightPosition.y**2 + window.__3D_STATE__.lightPosition.z**2) - 4) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.colorPreset === 'Velvet Red'",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}