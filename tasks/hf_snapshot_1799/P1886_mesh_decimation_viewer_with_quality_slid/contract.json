    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "window.__T7_rotBefore = window.__3D_STATE__.meshRotationY;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.meshRotationY - window.__T7_rotBefore) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.meshRotationY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
