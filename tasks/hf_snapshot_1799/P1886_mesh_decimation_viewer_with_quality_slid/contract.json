    {
      "id": "A9",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay panel containing all controls",
      "locator_hints": [
        "#info-panel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialFullQuality",
      "conditions": [
        "window.__3D_STATE__.quality === 1.0",
        "window.__3D_STATE__.renderMode === 'solid'",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.currentFaces === window.__3D_STATE__.originalFaces",
        "window.__3D_STATE__.reductionPercent === 0"
      ]
    },
    {
      "id": "S1",
      "name": "MediumDecimation",
      "conditions": [
        "window.__3D_STATE__.quality === 0.5",
        "window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces",
        "window.__3D_STATE__.reductionPercent > 0"
      ]
    },
    {
      "id": "S2",
      "name": "HeavyDecimation",
      "conditions": [
        "window.__3D_STATE__.quality === 0.1",
        "window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces * 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "WireframeMode",
      "conditions": [
        "window.__3D_STATE__.renderMode === 'wireframe'"
      ]
    },
    {
      "id": "S4",
      "name": "PointsMode",
      "conditions": [
        "window.__3D_STATE__.renderMode === 'points'"
      ]
    },
    {
      "id": "S5",
      "name": "AutoRotateOff",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false"
      ]
    },
    {
      "id": "S6",
      "name": "ExtremeDecimation",
      "conditions": [
        "window.__3D_STATE__.quality === 0.05",
        "window.__3D_STATE__.reductionPercent > 50"
      ]
    },
    {
      "id": "S7",
      "name": "KeyboardQualityAdjusted",
      "conditions": [
        "window.__3D_STATE__.quality < 1.0",
        "window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces"
      ]
    },
    {
      "id": "S8",
      "name": "ResetToDefaults",
      "conditions": [
        "window.__3D_STATE__.quality === 1.0",
        "window.__3D_STATE__.renderMode === 'solid'",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.currentFaces === window.__3D_STATE__.originalFaces"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.originalFaces === 'number' && window.__3D_STATE__.originalFaces > 10000",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.quality === 1.0 && window.__3D_STATE__.currentFaces === window.__3D_STATE__.originalFaces",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderMode === 'solid' && window.__3D_STATE__.autoRotate === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.boundingBoxMax === 'number' && window.__3D_STATE__.boundingBoxMax > 0 && !isNaN(window.__3D_STATE__.boundingBoxMax)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshVisible === true && window.__3D_STATE__.reductionPercent === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('quality-slider').value = 0.5; document.getElementById('quality-slider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quality === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reductionPercent > 0 && window.__3D_STATE__.reductionPercent <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentVertices > 0 && !isNaN(window.__3D_STATE__.currentVertices)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cellSize === 'number' && window.__3D_STATE__.cellSize > 0 && !isNaN(window.__3D_STATE__.cellSize)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.decimationTime === 'number' && window.__3D_STATE__.decimationTime >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T3_prevFaces = window.__3D_STATE__.currentFaces; document.getElementById('quality-slider').value = 0.1; document.getElementById('quality-slider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quality === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces < window.__T3_prevFaces",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces * 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reductionPercent > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellSize > 0 && !isNaN(window.__3D_STATE__.cellSize)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-wireframe"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.renderMode === 'wireframe'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quality === 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces > 0 && window.__3D_STATE__.currentFaces < window.__3D_STATE__.originalFaces",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.renderMode === 'points'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.meshVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentVertices > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quality === 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoRotate === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderMode === 'points'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.meshRotationY === 'number' && !isNaN(window.__3D_STATE__.meshRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.meshVisible === true",
            "tier": "L2"
          }
        ]
