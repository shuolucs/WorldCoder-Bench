      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('quality-slider').value = 0.05; document.getElementById('quality-slider').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quality === 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reductionPercent > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces <= window.__3D_STATE__.originalFaces",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentVertices) && window.__3D_STATE__.currentVertices > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quality >= 0.1 && window.__3D_STATE__.quality <= 0.1 + 0.001",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces <= window.__3D_STATE__.originalFaces",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFaces > 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.reductionPercent === 'number' && window.__3D_STATE__.reductionPercent >= 0 && window.__3D_STATE__.reductionPercent <= 100",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellSize > 0",
            "tier": "L2"
          }
