{
  "task_id": "P1886_mesh_decimation_viewer_with_quality_slid",
  "affordances": [
    {
      "id": "A1",
      "name": "TorusKnotMesh",
      "type": "3d_object",
      "semantic": "The main torus knot mesh that gets decimated",
      "locator_hints": [
        "scene.children mesh",
        "TorusKnot geometry"
      ]
    },
    {
      "id": "A2",
      "name": "QualitySlider",
      "type": "dom_element",
      "semantic": "Range slider controlling decimation quality from 0.05 to 1.0",
      "locator_hints": [
        "#quality-slider"
      ]
    },
    {
      "id": "A3",
      "name": "StatsDisplay",
      "type": "dom_element",
      "semantic": "Text display showing face count, vertex count, reduction %",
      "locator_hints": [
        "#stats-display"
      ]
    },
    {
      "id": "A4",
      "name": "SolidButton",
      "type": "dom_element",
      "semantic": "Button to switch to solid render mode",
      "locator_hints": [
        "#btn-solid"
      ]
    },
    {
      "id": "A5",
      "name": "WireframeButton",
      "type": "dom_element",
