      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('colorPicker').value = '#e74c3c'; document.getElementById('colorPicker').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.emblemScale !== before.emblemScale || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
