  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#3498db'",
        "window.__3D_STATE__.materialType === 'matte'",
        "window.__3D_STATE__.pattern === 'none'",
        "window.__3D_STATE__.emblemVisible === false",
        "window.__3D_STATE__.emblemScale === 0.3",
        "window.__3D_STATE__.isRotating === false"
      ]
    },
    {
      "id": "S1",
      "name": "ColorChanged",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#e74c3c'"
      ]
    },
    {
      "id": "S2",
      "name": "MaterialGlossy",
      "conditions": [
        "window.__3D_STATE__.materialType === 'glossy'",
        "window.__3D_STATE__.roughness <= 0.15",
        "window.__3D_STATE__.metalness >= 0.15 && window.__3D_STATE__.metalness <= 0.25"
      ]
    },
    {
      "id": "S3",
      "name": "MaterialMetallic",
      "conditions": [
        "window.__3D_STATE__.materialType === 'metallic'",
        "window.__3D_STATE__.roughness >= 0.25 && window.__3D_STATE__.roughness <= 0.35",
        "window.__3D_STATE__.metalness >= 0.85"
      ]
    },
    {
      "id": "S4",
      "name": "StripesApplied",
      "conditions": [
        "window.__3D_STATE__.pattern === 'stripes'"
      ]
    },
    {
      "id": "S5",
      "name": "DotsApplied",
      "conditions": [
        "window.__3D_STATE__.pattern === 'dots'"
      ]
    },
    {
      "id": "S6",
      "name": "EmblemShown",
      "conditions": [
        "window.__3D_STATE__.emblemVisible === true"
      ]
    },
    {
      "id": "S7",
      "name": "EmblemScaled",
      "conditions": [
        "window.__3D_STATE__.emblemScale === 0.7"
      ]
    },
    {
      "id": "S8",
      "name": "CaseRotated",
      "conditions": [
        "window.__3D_STATE__.isRotating === false",
        "Math.abs(window.__3D_STATE__.caseRotationY % 3.14) < 0.15"
      ]
    }
  ],
  "transitions": [
