        "checks": [
          {
            "expr": "window.__3D_STATE__.pingActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedNode >= 0",
            "tier": "L2"
          }
        ]
      }
    },
