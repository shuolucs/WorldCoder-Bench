{
  "task_id": "P276_network_topology_graph",
  "affordances": [
    {
      "id": "A1",
      "name": "CentralHub",
      "type": "3d_object",
      "semantic": "The coffeemat.glb model at origin representing the network hub (Node 0)",
      "locator_hints": [
        "position near (0,0,0)",
        "loaded GLB model"
      ]
    },
    {
      "id": "A2",
      "name": "NetworkNodes",
      "type": "3d_object",
      "semantic": "8 spheres arranged in a circle around the hub",
      "locator_hints": [
        "spheres at radius ~6 on XZ plane"
      ]
    },
    {
      "id": "A3",
      "name": "Edges",
      "type": "3d_object",
      "semantic": "Line objects connecting nodes",
      "locator_hints": [
        "THREE.Line objects"
      ]
    },
    {
      "id": "A4",
      "name": "NodeLabels",
      "type": "3d_object",
      "semantic": "Text sprites above each node",
      "locator_hints": [
        "sprite objects above nodes"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left overlay showing topology info",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset view and deselect",
      "locator_hints": [
        "button#resetBtn"
      ]
    },
    {
      "id": "A7",
      "name": "PingSpheres",
      "type": "3d_object",
      "semantic": "Animated spheres that travel along edges during ping",
      "locator_hints": [
        "small glowing spheres on edges"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 9",
        "window.__3D_STATE__.topology === 'star'",
        "window.__3D_STATE__.selectedNode === -1",
        "window.__3D_STATE__.labelsVisible === true",
        "window.__3D_STATE__.pingActive === false"
      ]
    },
    {
      "id": "S1",
      "name": "HubModelLoaded",
      "conditions": [
        "window.__3D_STATE__.hubModelLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNode >= 0 && window.__3D_STATE__.selectedNode <= 8"
      ]
    },
    {
      "id": "S3",
      "name": "TopologyRing",
      "conditions": [
        "window.__3D_STATE__.topology === 'ring'",
        "window.__3D_STATE__.edgeCount === 16"
      ]
    },
    {
      "id": "S4",
      "name": "TopologyMesh",
      "conditions": [
        "window.__3D_STATE__.topology === 'mesh'",
        "window.__3D_STATE__.edgeCount === 36"
      ]
    },
    {
      "id": "S5",
      "name": "PingActive",
      "conditions": [
        "window.__3D_STATE__.pingActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "LabelsHidden",
      "conditions": [
        "window.__3D_STATE__.labelsVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "ViewReset",
      "conditions": [
        "window.__3D_STATE__.selectedNode === -1",
        "Math.abs(window.__3D_STATE__.cameraDistance - 17) < 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.topology === 'star'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_canvas",
        "target": "node sphere at approximate screen position of Node 1",
        "position_hint": "raycast hit on first outer node sphere"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedNode >= 1 && window.__3D_STATE__.selectedNode <= 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedNode !== -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.topology === 'star'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
