    },
    {
      "id": "S5",
      "name": "MirrorModeOn",
      "conditions": [
        "window.__3D_STATE__.mirrorMode === true",
        "window.__3D_STATE__.historyLength === 4",
        "window.__3D_STATE__.historyIndex === 3"
      ]
    },
    {
      "id": "S6",
      "name": "RotationPaused",
      "conditions": [
