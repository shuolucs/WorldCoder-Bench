  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Initial",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.segments === 6",
        "window.__3D_STATE__.radius === 2.0",
        "window.__3D_STATE__.scale === 0.5",
        "window.__3D_STATE__.mirrorMode === false",
        "window.__3D_STATE__.cloneCount === 6",
        "window.__3D_STATE__.historyLength === 1",
        "window.__3D_STATE__.historyIndex === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SegmentsIncreased",
      "conditions": [
        "window.__3D_STATE__.segments === 7",
