      "conditions": [
        "window.__3D_STATE__.mirrorMode === false",
        "window.__3D_STATE__.scale === 0.5",
        "window.__3D_STATE__.historyIndex === 2",
        "window.__3D_STATE__.canRedo === true"
      ]
    },
    {
      "id": "S9",
      "name": "NewActionAfterUndo_FuturePurged",
      "conditions": [
        "window.__3D_STATE__.segments === 8",
        "window.__3D_STATE__.historyIndex === 3",
        "window.__3D_STATE__.historyLength === 4",
        "window.__3D_STATE__.canRedo === false"
      ]
    },
    {
      "id": "S10",
      "name": "ResetToInitial",
      "conditions": [
        "window.__3D_STATE__.segments === 6",
        "window.__3D_STATE__.radius === 2.0",
