        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.windIntensity - 0.75) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vertexDisplacementMax - 0.75 * 0.15) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.visibleParticleSpeed > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stormActive === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('wind-slider').value === '0.75'",
            "tier": "L2"
          }
