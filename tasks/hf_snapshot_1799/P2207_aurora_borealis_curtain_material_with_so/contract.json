  "states": [
    {
      "id": "S0",
      "name": "Initial_Loaded",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.windIntensity === 0.3",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.colorPhase === 0.0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.stormActive === false",
        "window.__3D_STATE__.activePreset === 'default'"
      ]
    },
    {
      "id": "S1",
      "name": "Wind_Adjusted",
      "conditions": [
        "window.__3D_STATE__.windIntensity === 0.75",
        "window.__3D_STATE__.stormActive === false"
      ]
    },
    {
      "id": "S2",
      "name": "Purple_Preset_Active",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'purple'",
        "Math.abs(window.__3D_STATE__.colorPhase - 3.14) < 0.01",
        "window.__3D_STATE__.windIntensity === 0.6",
        "window.__3D_STATE__.timeScale === 1.5"
      ]
    },
    {
      "id": "S3",
      "name": "Animation_Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ]
    },
    {
      "id": "S4",
      "name": "Animation_Resumed",
      "conditions": [
        "window.__3D_STATE__.isPaused === false"
      ]
    },
    {
      "id": "S5",
      "name": "Storm_Active",
      "conditions": [
        "window.__3D_STATE__.stormActive === true",
        "window.__3D_STATE__.windIntensity === 1.0",
        "window.__3D_STATE__.timeScale === 3.0"
      ]
    },
    {
      "id": "S6",
      "name": "Storm_Ended",
      "conditions": [
        "window.__3D_STATE__.stormActive === false"
      ]
    },
    {
      "id": "S7",
      "name": "Blue_Preset_Active",
      "conditions": [
        "window.__3D_STATE__.activePreset === 'blue'",
        "Math.abs(window.__3D_STATE__.colorPhase - 4.71) < 0.01"
      ]
    },
    {
      "id": "S8",
      "name": "Speed_Adjusted",
      "conditions": [
        "window.__3D_STATE__.timeScale === 2.5"
      ]
    },
    {
      "id": "S9",
      "name": "All_Reset",
      "conditions": [
        "window.__3D_STATE__.windIntensity === 0.3",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.colorPhase === 0.0",
        "window.__3D_STATE__.activePreset === 'default'"
      ]
    }
  ],
