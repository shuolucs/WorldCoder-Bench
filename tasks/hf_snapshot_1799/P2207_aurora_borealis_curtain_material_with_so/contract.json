        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.materialBlending === 'AdditiveBlending'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number' && window.__3D_STATE__.elapsedTime > 0 && !isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          }
        ]
      }
    },
