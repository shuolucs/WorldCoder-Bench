{
  "task_id": "P2122_animation_ghosting_onion_skin_overlay",
  "affordances": [
    {
      "id": "A1",
      "name": "SoldierModel",
      "type": "3d_object",
      "semantic": "The loaded soldier.glb animated character at origin",
      "locator_hints": [
        "GLTFLoader result",
        "scene child at origin"
      ]
    },
    {
      "id": "A2",
      "name": "PastGhosts",
      "type": "3d_object",
      "semantic": "Blue-tinted translucent clones showing past animation frames",
      "locator_hints": [
        "material color #4488ff",
        "transparent cloned SkinnedMesh"
      ]
    },
    {
      "id": "A3",
      "name": "FutureGhosts",
      "type": "3d_object",
      "semantic": "Red-tinted translucent clones showing future animation frames",
      "locator_hints": [
        "material color #ff4444",
        "transparent cloned SkinnedMesh"
      ]
    },
    {
      "id": "A4",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left overlay showing animation and onion skin state",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A5",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset animation to time 0 and resume playback",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A6",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry",
        "y=0"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_Playing",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.onionSkinEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "SteppedForward",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.currentTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "SteppedBackward",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S4",
      "name": "OnionSkinDisabled",
      "conditions": [
        "window.__3D_STATE__.onionSkinEnabled === false",
        "window.__3D_STATE__.totalGhostsVisible === 0"
      ]
    },
    {
      "id": "S5",
      "name": "OnionSkinReEnabled",
      "conditions": [
        "window.__3D_STATE__.onionSkinEnabled === true",
        "window.__3D_STATE__.totalGhostsVisible > 0"
      ]
    },
    {
      "id": "S6",
      "name": "PastFramesChanged",
      "conditions": [
        "window.__3D_STATE__.onionSkinEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "FutureFramesChanged",
      "conditions": [
        "window.__3D_STATE__.onionSkinEnabled === true"
      ]
    },
    {
      "id": "S8",
      "name": "FrameSpacingIncreased",
      "conditions": [
        "window.__3D_STATE__.frameSpacing > 0.1"
      ]
    },
    {
      "id": "S9",
      "name": "ResetToStart",
      "conditions": [
        "window.__3D_STATE__.currentTime === 0",
        "window.__3D_STATE__.isPlaying === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.onionSkinEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pastFrames === 3 && window.__3D_STATE__.futureFrames === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentTime === 'number' && !isNaN(window.__3D_STATE__.currentTime)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentTime >= 0 && window.__3D_STATE__.currentTime <= window.__3D_STATE__.animationDuration",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === window.__3D_STATE__.pastFrames + window.__3D_STATE__.futureFrames",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-playstate') !== null && document.getElementById('hud-playstate').textContent.toLowerCase().includes('pause')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_step_time = window.__3D_STATE__.currentTime; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__pre_step_time === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - (window.__pre_step_time + window.__3D_STATE__.frameSpacing)) < 0.005 || window.__3D_STATE__.currentTime === window.__3D_STATE__.animationDuration",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime >= 0 && window.__3D_STATE__.currentTime <= window.__3D_STATE__.animationDuration",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFrameIndex === Math.floor(window.__3D_STATE__.currentTime / window.__3D_STATE__.frameSpacing)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_back_time = window.__3D_STATE__.currentTime; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowLeft', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentTime - (window.__pre_back_time - window.__3D_STATE__.frameSpacing)) < 0.005 || window.__3D_STATE__.currentTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentTime)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ghostOpacities)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.onionSkinEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === 0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-onion-state') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-total-ghosts') !== null && document.getElementById('hud-total-ghosts').textContent.includes('0')",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ghostOpacities) && window.__3D_STATE__.ghostOpacities.length === 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.onionSkinEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === window.__3D_STATE__.pastFrames + window.__3D_STATE__.futureFrames",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === 6",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.ghostOpacities) && window.__3D_STATE__.ghostOpacities.length === 6",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ghostOpacities.every(g => typeof g.opacity === 'number' && g.opacity >= 0.09 && g.opacity <= 0.51)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_past = window.__3D_STATE__.pastFrames; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'p', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pastFrames === (window.__pre_past + 1) % 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === window.__3D_STATE__.pastFrames + window.__3D_STATE__.futureFrames",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.pastGhostColors) && window.__3D_STATE__.pastGhostColors.length === window.__3D_STATE__.pastFrames",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-past-frames') !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.onionSkinEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_future = window.__3D_STATE__.futureFrames; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'f', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.futureFrames === (window.__pre_future + 1) % 6",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === window.__3D_STATE__.pastFrames + window.__3D_STATE__.futureFrames",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.futureGhostColors) && window.__3D_STATE__.futureGhostColors.length === window.__3D_STATE__.futureFrames",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('hud-future-frames') !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.animationDuration === 'number' && window.__3D_STATE__.animationDuration > 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__pre_spacing = window.__3D_STATE__.frameSpacing; document.dispatchEvent(new KeyboardEvent('keydown', {key: '=', bubbles: true})); document.dispatchEvent(new KeyboardEvent('keydown', {key: '=', bubbles: true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.frameSpacing - (window.__pre_spacing + 0.04)) < 0.005",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameSpacing >= 0.02 && window.__3D_STATE__.frameSpacing <= 0.5",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-frame-spacing') !== null",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.frameSpacing)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentFrameIndex === Math.floor(window.__3D_STATE__.currentTime / window.__3D_STATE__.frameSpacing)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentTime === 0 || window.__3D_STATE__.currentTime < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-playstate') !== null && document.getElementById('hud-playstate').textContent.toLowerCase().includes('play')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalGhostsVisible === window.__3D_STATE__.pastFrames + window.__3D_STATE__.futureFrames",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}