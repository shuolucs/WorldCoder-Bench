      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalFloors === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.roomsPerFloor === 4",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.floorOpacities) && window.__3D_STATE__.floorOpacities.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.floorOpacities[0] === 1.0 && window.__3D_STATE__.floorOpacities[1] === 1.0 && window.__3D_STATE__.floorOpacities[2] === 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
