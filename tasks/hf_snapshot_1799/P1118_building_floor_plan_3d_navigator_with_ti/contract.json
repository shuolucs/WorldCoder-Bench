  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 0",
        "window.__3D_STATE__.selectedRoom === null",
        "window.__3D_STATE__.timeOfDay === 12",
        "window.__3D_STATE__.measureMode === false",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Floor2Isolated",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 2",
        "window.__3D_STATE__.floorOpacities[1] === 1.0",
        "window.__3D_STATE__.floorOpacities[0] === 0.15",
        "window.__3D_STATE__.floorOpacities[2] === 0.15"
      ]
    },
    {
      "id": "S2",
      "name": "RoomHighlighted",
      "conditions": [
        "window.__3D_STATE__.selectedRoom !== null",
        "window.__3D_STATE__.highlightedEmissive > 0.3",
        "window.__3D_STATE__.roomInfo !== null"
      ]
    },
    {
      "id": "S3",
      "name": "TimeSetToMorning",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 7",
        "window.__3D_STATE__.sunIntensity > 0",
        "window.__3D_STATE__.sunPosition.y > 0"
      ]
    },
    {
      "id": "S4",
      "name": "TimeSetToNight",
      "conditions": [
        "window.__3D_STATE__.timeOfDay === 2",
        "window.__3D_STATE__.sunIntensity === 0"
      ]
    },
    {
      "id": "S5",
      "name": "MeasureModeActive",
      "conditions": [
        "window.__3D_STATE__.measureMode === true"
      ]
    },
    {
      "id": "S6",
      "name": "MeasurementComplete",
      "conditions": [
        "window.__3D_STATE__.measurePoints.length === 2",
        "window.__3D_STATE__.measureDistance !== null",
        "window.__3D_STATE__.measureDistance > 0"
      ]
    },
    {
      "id": "S7",
      "name": "UndoneFloorSelection",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 0",
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S8",
      "name": "RedoneFloorSelection",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 2",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S9",
      "name": "Floor3Isolated",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 3",
        "window.__3D_STATE__.floorOpacities[2] === 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "AllFloorsRestored",
      "conditions": [
        "window.__3D_STATE__.currentFloor === 0",
        "window.__3D_STATE__.floorOpacities[0] === 1.0",
        "window.__3D_STATE__.floorOpacities[1] === 1.0",
        "window.__3D_STATE__.floorOpacities[2] === 1.0"
      ]
    },
    {
      "id": "S11",
      "name": "MeasureCancelled",
      "conditions": [
        "window.__3D_STATE__.measureMode === false",
        "window.__3D_STATE__.measurePoints.length === 0"
      ]
    }
  ],
  "transitions": [
