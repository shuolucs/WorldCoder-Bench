{
  "task_id": "P430_multiplayer_water_cycle_visualization",
  "affordances": [
    {
      "id": "A1",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation play/pause",
      "locator_hints": [
        "#btn-play"
      ]
    },
    {
      "id": "A2",
      "name": "SpeedButton",
      "type": "dom_element",
      "semantic": "Button to cycle simulation speed (1x/2x/4x)",
      "locator_hints": [
        "#btn-speed"
      ]
    },
    {
      "id": "A3",
      "name": "EvaporationHighlight",
      "type": "dom_element",
      "semantic": "Button to highlight evaporation particles",
      "locator_hints": [
        "#btn-evaporation"
      ]
    },
    {
      "id": "A4",
      "name": "CollectionHighlight",
      "type": "dom_element",
      "semantic": "Button to highlight collection particles",
      "locator_hints": [
        "#btn-collection"
      ]
    },
    {
      "id": "A5",
      "name": "StatsPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing particle counts and settings",
      "locator_hints": [
        "#stats-panel"
      ]
    },
    {
      "id": "A6",
      "name": "ToyCar",
      "type": "3d_object",
      "semantic": "Loaded ToyCar.glb model driving near the river",
      "locator_hints": [
        "ToyCar",
        "car"
      ]
    },
    {
      "id": "A7",
      "name": "WaterParticles",
      "type": "3d_object",
      "semantic": "60 blue sphere particles cycling through water phases",
      "locator_hints": [
        "particle",
        "water"
      ]
    },
    {
      "id": "A8",
      "name": "CloudGroup",
      "type": "3d_object",
      "semantic": "Semi-transparent white cloud at y=12",
      "locator_hints": [
        "cloud"
      ]
    },
    {
      "id": "A9",
      "name": "SkyDome",
      "type": "3d_object",
      "semantic": "Large sphere representing the sky",
      "locator_hints": [
        "sky"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.totalParticles === 60",
        "window.__3D_STATE__.particleCounts.collection === 60",
        "window.__3D_STATE__.speed === 1",
        "window.__3D_STATE__.temperatureMode === 'normal'"
      ]
    },
    {
      "id": "S1",
      "name": "Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.speed === 1"
      ]
    },
    {
      "id": "S2",
      "name": "Particles_Cycling",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.particleCounts.evaporation > 0 || window.__3D_STATE__.particleCounts.condensation > 0"
      ]
    },
    {
      "id": "S3",
      "name": "Speed_Increased",
      "conditions": [
        "window.__3D_STATE__.speed === 2"
      ]
    },
    {
      "id": "S4",
      "name": "Phase_Highlighted",
      "conditions": [
        "window.__3D_STATE__.highlightedPhase !== null"
      ]
    },
    {
      "id": "S5",
      "name": "Warm_Temperature",
      "conditions": [
        "window.__3D_STATE__.temperatureMode === 'warm'"
      ]
    },
    {
      "id": "S6",
      "name": "Car_Honked",
      "conditions": [
        "window.__3D_STATE__.carHonked === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset_To_Collection",
      "conditions": [
        "window.__3D_STATE__.particleCounts.collection === 60",
        "window.__3D_STATE__.particleCounts.evaporation === 0",
        "window.__3D_STATE__.particleCounts.condensation === 0",
        "window.__3D_STATE__.particleCounts.precipitation === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === 60",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.carPositionZ >= 2 && window.__3D_STATE__.carPositionZ <= 14",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCounts.evaporation > 0 || window.__3D_STATE__.particleCounts.condensation > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCounts.collection < 60",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.carPositionZ)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.carPositionZ >= 2 && window.__3D_STATE__.carPositionZ <= 14",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-speed"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speed === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "click_dom",
        "selector": "#btn-evaporation"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highlightedPhase === 'evaporation'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperatureMode === 'warm'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.skyColor !== '#87ceeb' && window.__3D_STATE__.skyColor !== '#87CEEB'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const raycaster = new THREE.Raycaster(); const mouse = new THREE.Vector2(); const car = window.__scene__ ? window.__scene__.getObjectByName('ToyCar') || window.__scene__.children.find(c => c.userData && c.userData.isCar) : null; if(car) { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2, bubbles: true}); document.querySelector('canvas').dispatchEvent(evt); }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.carHonked === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCounts.collection === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCounts.evaporation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCounts.condensation === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCounts.precipitation === 0",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCounts.collection === 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalParticles === 60",
            "tier": "L2"
          },
          {
            "expr": "(window.__3D_STATE__.particleCounts.evaporation + window.__3D_STATE__.particleCounts.condensation + window.__3D_STATE__.particleCounts.precipitation + window.__3D_STATE__.particleCounts.collection) === 60",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}