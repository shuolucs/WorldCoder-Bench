          },
          {
            "expr": "typeof window.__3D_STATE__.nodeCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.connectionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.signalAnimationOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount >= 0",
            "tier": "L2"
