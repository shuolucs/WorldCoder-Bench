{
  "task_id": "P320_procedural_brain_connectivity_map",
  "affordances": [
    {
      "id": "A1",
      "name": "BrainNodes",
      "type": "3d_object",
      "semantic": "20 icosphere brain region nodes arranged in ellipsoidal shape",
      "locator_hints": [
        "icospheres with radius 1.5",
        "colored by group"
      ]
    },
    {
      "id": "A2",
      "name": "Connections",
      "type": "3d_object",
      "semantic": "35 line connections between brain nodes",
      "locator_hints": [
        "THREE.Line objects",
        "gray when inactive, white when active"
      ]
    },
    {
      "id": "A3",
      "name": "SignalParticles",
      "type": "3d_object",
      "semantic": "Animated cyan spheres traveling along active connections",
      "locator_hints": [
        "small spheres radius 0.4",
        "color 0x00ffff"
      ]
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left HUD showing stats",
      "locator_hints": [
        "div#hud"
      ]
    },
    {
      "id": "A5",
      "name": "StrengthFilterButton",
      "type": "dom_element",
      "semantic": "Button to cycle strength threshold",
      "locator_hints": [
        "button#strengthFilterBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ActiveCountDisplay",
      "type": "dom_element",
      "semantic": "Span showing active node count",
      "locator_hints": [
        "span#activeCount"
      ]
    },
    {
      "id": "A7",
      "name": "GroupFilterDisplay",
      "type": "dom_element",
      "semantic": "Span showing current group filter",
      "locator_hints": [
        "span#groupFilter"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.nodeCount === 20",
        "window.__3D_STATE__.connectionCount === 35",
        "window.__3D_STATE__.activeNodes.length === 0",
        "window.__3D_STATE__.groupFilter === 'all'",
        "window.__3D_STATE__.strengthThreshold === 0",
        "window.__3D_STATE__.signalAnimationOn === true",
        "window.__3D_STATE__.transparencyMode === false"
      ]
    },
    {
      "id": "S1",
      "name": "OneNodeActive",
      "conditions": [
        "window.__3D_STATE__.activeNodes.length === 1",
        "window.__3D_STATE__.activeConnectionCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "GroupFiltered",
      "conditions": [
        "window.__3D_STATE__.groupFilter !== 'all'",
        "window.__3D_STATE__.visibleNodeCount === 5"
      ]
    },
    {
      "id": "S3",
      "name": "StrengthFiltered",
      "conditions": [
        "window.__3D_STATE__.strengthThreshold > 0",
        "window.__3D_STATE__.visibleConnectionCount < 35"
      ]
    },
    {
      "id": "S4",
      "name": "ThreeNodesActive",
      "conditions": [
        "window.__3D_STATE__.activeNodes.length === 3"
      ]
    },
    {
      "id": "S5",
      "name": "SignalOff",
      "conditions": [
        "window.__3D_STATE__.signalAnimationOn === false"
      ]
    },
    {
      "id": "S6",
      "name": "TransparencyOn",
      "conditions": [
        "window.__3D_STATE__.transparencyMode === true"
      ]
    },
    {
      "id": "S7",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.activeNodes.length === 0",
        "window.__3D_STATE__.groupFilter === 'all'",
        "window.__3D_STATE__.signalParticleCount === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Camera !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.Lighting !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.nodeCount !== undefined",
            "tier": "L0"
          },
          {
