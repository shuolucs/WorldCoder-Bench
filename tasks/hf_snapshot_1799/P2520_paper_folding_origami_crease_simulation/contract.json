{
  "task_id": "P2520_paper_folding_origami_crease_simulation",
  "affordances": [
    {
      "id": "A1",
      "name": "PaperSheet",
      "type": "3d_object",
      "semantic": "Deformable subdivided plane representing origami paper with soft body physics",
      "locator_hints": [
        "PlaneGeometry 20x20 segments",
        "color 0xe8d5b7",
        "DoubleSide material"
      ]
    },
    {
      "id": "A2",
      "name": "RobotModel",
      "type": "3d_object",
      "semantic": "Decorative robot.glb model placed as desk companion",
      "locator_hints": [
        "GLTFLoader robot.glb",
        "scale 0.4",
        "position (-4, 0, -3)"
      ]
    },
    {
      "id": "A3",
      "name": "FlattenButton",
      "type": "dom_element",
      "semantic": "Button to smoothly flatten all creases back to 0",
      "locator_hints": [
        "#btn-flatten"
      ]
    },
    {
      "id": "A4",
      "name": "PresetCraneButton",
      "type": "dom_element",
      "semantic": "Button to apply preset crane fold pattern",
      "locator_hints": [
        "#btn-crane"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing crease count, cursor, gravity, fold energy",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Flat ground surface beneath the paper",
      "locator_hints": [
        "PlaneGeometry 20x20",
        "color 0x2d2d44"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.creaseCount === 0",
        "window.__3D_STATE__.gravityEnabled === false || window.__3D_STATE__.gravityEnabled === true",
        "window.__3D_STATE__.simRunning === true"
      ]
    },
    {
      "id": "S1",
      "name": "RobotLoaded",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "CreaseAdded",
      "conditions": [
        "window.__3D_STATE__.creaseCount >= 1"
      ]
    },
    {
      "id": "S3",
      "name": "CursorMoved",
      "conditions": [
        "window.__3D_STATE__.cursorPos !== 0.5 || window.__3D_STATE__.cursorAxis !== 'horizontal'"
      ]
    },
    {
      "id": "S4",
      "name": "FoldExecuted",
      "conditions": [
        "window.__3D_STATE__.maxFoldAngle > 0"
      ]
    },
    {
      "id": "S5",
      "name": "FoldUndone",
      "conditions": [
        "window.__3D_STATE__.foldHistory.length >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "GravityToggled",
      "conditions": [
        "window.__3D_STATE__.gravityEnabled === true"
      ]
    },
    {
      "id": "S7",
      "name": "MultipleCreases",
      "conditions": [
        "window.__3D_STATE__.creaseCount >= 2"
      ]
    },
    {
      "id": "S8",
      "name": "CranePresetApplied",
      "conditions": [
        "window.__3D_STATE__.creaseCount >= 3",
        "window.__3D_STATE__.maxFoldAngle >= 135"
      ]
    },
    {
      "id": "S9",
      "name": "Flattened",
      "conditions": [
        "window.__3D_STATE__.maxFoldAngle <= 1"
      ]
    },
    {
      "id": "S10",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.creaseCount === 0",
        "window.__3D_STATE__.totalFoldEnergy === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.robotLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paperVertexCount === (20+1)*(20+1)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.springCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.creaseCount === 1",
            "tier": "L1"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.creases) && window.__3D_STATE__.creases.length === 1",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.creases[0].axis === window.__3D_STATE__.cursorAxis",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.creases[0].normalizedPos - 0.5) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases[0].foldAngle === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.creases[0].isActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "a"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cursorAxis === 'vertical' || window.__3D_STATE__.cursorAxis === 'horizontal'",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cursorPos === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cursorPos >= 0.1 && window.__3D_STATE__.cursorPos <= 0.9",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cursorPos)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.creaseCount === 1",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxFoldAngle >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastFoldedCreaseId !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.foldHistory.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalFoldEnergy)",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.paperCenterY)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxFoldAngle < 90 || window.__3D_STATE__.creases.some(c => c.foldAngle < 90)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy < 0.25 + 0.001",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastFoldedCreaseId !== 'undefined'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.paperCenterY)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.foldHistory.length >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.gravityEnabled === true || window.__3D_STATE__.gravityEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.gravityEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.paperCenterY)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.springCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight'})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c'})), 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.creaseCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases[1] !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.creases[1].foldAngle === 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.creases[0].normalizedPos - window.__3D_STATE__.creases[1].normalizedPos) > 0.01 || window.__3D_STATE__.creases[0].axis !== window.__3D_STATE__.creases[1].axis",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-crane"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.creaseCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases.some(c => c.axis === 'horizontal' && Math.abs(c.normalizedPos - 0.5) < 0.05)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases.some(c => c.axis === 'vertical' && Math.abs(c.normalizedPos - 0.5) < 0.05)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxFoldAngle >= 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy > 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalFoldEnergy)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-flatten"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxFoldAngle <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.flattenProgress >= 0.95",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.paperCenterY)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.creases.every(c => c.foldAngle <= 5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.creaseCount === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.creases.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maxFoldAngle === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.foldHistory.length === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paperVertexCount === (20+1)*(20+1)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S10",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp'})); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp'})), 100); setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', {key: 'c'})), 300);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.creaseCount === 1",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.cursorPos >= 0.55 || window.__3D_STATE__.cursorPos <= 0.45",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.creases[0].foldAngle === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy === 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'f'})); setTimeout(() => { document.dispatchEvent(new KeyboardEvent('keydown', {key: 'f'})); }, 2500);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.maxFoldAngle >= 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.foldHistory.length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalFoldEnergy >= 0.25 - 0.01",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.paperCenterY)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.lastFoldedCreaseId !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.robotLoaded === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}