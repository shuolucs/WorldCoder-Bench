{
  "task_id": "P507_fractal_tree_generator_with_undo_redo",
  "affordances": [
    {
      "id": "A1",
      "name": "FractalTree",
      "type": "3d_object",
      "semantic": "The recursive fractal tree composed of cylinder branch meshes",
      "locator_hints": [
        "group containing CylinderGeometry meshes",
        "children of tree group"
      ]
    },
    {
      "id": "A2",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to grow tree by one depth level",
      "locator_hints": [
        "#btn-grow"
      ]
    },
    {
      "id": "A3",
      "name": "PruneButton",
      "type": "dom_element",
      "semantic": "Button to remove deepest branch level",
      "locator_hints": [
        "#btn-prune"
      ]
    },
    {
      "id": "A4",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last action",
      "locator_hints": [
        "#btn-undo"
      ]
    },
    {
      "id": "A5",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo last undone action",
      "locator_hints": [
        "#btn-redo"
      ]
    },
    {
      "id": "A6",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset tree to trunk only",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A7",
      "name": "AngleSlider",
      "type": "dom_element",
      "semantic": "Slider to control branching angle spread",
      "locator_hints": [
        "#slider-angle"
      ]
    },
    {
      "id": "A8",
      "name": "RatioSlider",
      "type": "dom_element",
      "semantic": "Slider to control branch length ratio",
      "locator_hints": [
        "#slider-ratio"
      ]
    },
    {
      "id": "A9",
      "name": "HUDInfo",
      "type": "dom_element",
      "semantic": "HUD display showing tree statistics",
      "locator_hints": [
        "#hud-info"
      ]
    },
    {
      "id": "A10",
      "name": "BranchMesh",
      "type": "3d_object",
      "semantic": "Individual branch cylinder mesh with userData.branchId",
      "locator_hints": [
        "mesh with CylinderGeometry",
        "userData.branchId defined"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialTrunk",
      "conditions": [
        "window.__3D_STATE__.depth === 1",
        "window.__3D_STATE__.branchCount === 1",
        "window.__3D_STATE__.leafCount === 0",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "Depth2Tree",
      "conditions": [
        "window.__3D_STATE__.depth === 2",
        "window.__3D_STATE__.branchCount === 3",
        "window.__3D_STATE__.leafCount === 0"
      ]
    },
    {
      "id": "S2",
      "name": "Depth3Tree",
      "conditions": [
        "window.__3D_STATE__.depth === 3",
        "window.__3D_STATE__.branchCount === 7",
        "window.__3D_STATE__.leafCount === 0"
      ]
    },
    {
      "id": "S3",
      "name": "Depth4Tree",
      "conditions": [
        "window.__3D_STATE__.depth === 4",
        "window.__3D_STATE__.branchCount === 15",
        "window.__3D_STATE__.leafCount === 8"
      ]
    },
    {
      "id": "S4",
      "name": "Depth5Tree",
      "conditions": [
        "window.__3D_STATE__.depth === 5",
        "window.__3D_STATE__.branchCount === 31",
        "window.__3D_STATE__.leafCount === 24"
      ]
    },
    {
      "id": "S5",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S7",
      "name": "BranchSelected",
      "conditions": [
        "window.__3D_STATE__.selectedBranchId !== null"
      ]
    },
    {
      "id": "S8",
      "name": "AngleChanged",
      "conditions": [
        "window.__3D_STATE__.angleSpread !== 30"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.depth === 1",
        "window.__3D_STATE__.undoStackSize === 0",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    }
  ],
  "transitions": [
