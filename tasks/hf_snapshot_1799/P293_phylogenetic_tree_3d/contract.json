        "code": "const nodes = document.querySelectorAll ? null : null; const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); /* We simulate selecting node n1a by script */ if(window.__selectNode) { window.__selectNode('n1a'); } else { /* fallback: set state directly for testing */ window.__3D_STATE__.selectedNode = 'n1a'; window.__3D_STATE__.selectedDepth = 1; }"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
