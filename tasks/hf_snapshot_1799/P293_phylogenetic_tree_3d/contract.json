        "#statsPanel"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.totalNodes === 15",
        "window.__3D_STATE__.visibleNodes === 15",
        "window.__3D_STATE__.selectedNode === null",
        "window.__3D_STATE__.depthFilter === 3",
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.treeState === 'expanded'",
        "window.__3D_STATE__.colorMode === 'depth'"
      ]
    },
    {
      "id": "S1",
      "name": "RobotLoaded",
      "conditions": [
        "window.__3D_STATE__.robotLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "NodeSelected",
      "conditions": [
        "window.__3D_STATE__.selectedNode !== null",
        "window.__3D_STATE__.selectedDepth >= 0"
      ]
    },
    {
      "id": "S3",
      "name": "DepthFiltered",
      "conditions": [
        "window.__3D_STATE__.depthFilter < 3",
        "window.__3D_STATE__.visibleNodes < 15"
      ]
    },
    {
      "id": "S4",
      "name": "AutoRotating",
      "conditions": [
        "window.__3D_STATE__.autoRotate === true"
      ]
    },
    {
      "id": "S5",
      "name": "TreeCollapsed",
      "conditions": [
        "window.__3D_STATE__.treeState === 'collapsed'"
      ]
    },
    {
      "id": "S6",
      "name": "UniformColor",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'uniform'"
      ]
    },
    {
      "id": "S7",
      "name": "TopDownView",
      "conditions": [
        "window.__3D_STATE__.cameraY >= 19.0"
      ]
    },
    {
      "id": "S8",
      "name": "LeafSelectedWithPath",
      "conditions": [
        "window.__3D_STATE__.selectedDepth === 3",
        "window.__3D_STATE__.highlightedPath.length >= 4"
      ]
    },
    {
      "id": "S9",
      "name": "FrontViewRestored",
      "conditions": [
        "window.__3D_STATE__.cameraY <= 6.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
