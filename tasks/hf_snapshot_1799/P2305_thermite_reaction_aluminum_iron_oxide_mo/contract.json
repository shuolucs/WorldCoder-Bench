  "states": [
    {
      "id": "S0",
      "name": "Idle",
      "conditions": [
        "window.__3D_STATE__.phase === 'idle'",
        "window.__3D_STATE__.temperature === 25",
        "window.__3D_STATE__.ribbonBurned === false"
      ]
    },
    {
      "id": "S1",
      "name": "Igniting",
      "conditions": [
        "window.__3D_STATE__.phase === 'igniting'",
        "window.__3D_STATE__.temperature >= 25"
      ]
    },
    {
      "id": "S2",
      "name": "Reacting",
      "conditions": [
        "window.__3D_STATE__.phase === 'reacting'",
        "window.__3D_STATE__.temperature > 1200"
      ]
    },
    {
      "id": "S3",
      "name": "Cooling",
      "conditions": [
        "window.__3D_STATE__.phase === 'cooling'",
        "window.__3D_STATE__.temperature <= 2500"
      ]
    },
    {
      "id": "S4",
      "name": "Complete",
      "conditions": [
        "window.__3D_STATE__.phase === 'complete'",
        "window.__3D_STATE__.reactantMassAl <= 1",
        "window.__3D_STATE__.reactantMassFe2O3 <= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Pouring",
      "conditions": [
        "window.__3D_STATE__.phase === 'pouring'",
        "window.__3D_STATE__.moltenIronDroplets >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "Solidified",
      "conditions": [
        "window.__3D_STATE__.phase === 'solidified'",
        "window.__3D_STATE__.dropsInMold >= 5"
      ]
    },
    {
      "id": "S7",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S8",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.phase === 'idle'",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.productMassFe === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Ignite"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.phase === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.phase === 'igniting'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 25",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalMassIn - 500) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'reacting'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature > 1200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ribbonBurned === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sparkCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crucibleGlowIntensity > 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalMassIn - (window.__3D_STATE__.reactantMassAl + window.__3D_STATE__.reactantMassFe2O3 + window.__3D_STATE__.productMassFe + window.__3D_STATE__.productMassAl2O3)) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 9000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'cooling' || window.__3D_STATE__.phase === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature <= 2500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.productMassFe > 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.productMassAl2O3 > 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mixtureVolumeRatio < 0.5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.productMassFe) && !isNaN(window.__3D_STATE__.productMassAl2O3)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration": 14000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.phase === 'complete'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactantMassAl <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactantMassFe2O3 <= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.productMassFe - 168) < 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.productMassAl2O3 - 200) < 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.productMassFe + window.__3D_STATE__.productMassAl2O3 + window.__3D_STATE__.reactantMassAl + window.__3D_STATE__.reactantMassFe2O3) - window.__3D_STATE__.totalMassIn) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
