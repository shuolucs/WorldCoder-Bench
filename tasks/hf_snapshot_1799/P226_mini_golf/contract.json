      "action": {
        "type": "script",
        "code": "// Simulate a shot toward the cup on hole 1: set ball velocity directly\nwindow.__3D_STATE__.ballVelocity = {x: 0, y: 0, z: -8};\n// Also set moving state and increment strokes via exposed API or direct manipulation\nif (window.__GOLF_SHOOT__) { window.__GOLF_SHOOT__(0, 0.53); } else { /* fallback: directly set state */ }"
      },
