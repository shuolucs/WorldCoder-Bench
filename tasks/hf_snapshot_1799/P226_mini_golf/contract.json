  "states": [
    {
      "id": "S0",
      "name": "Initial_Hole1_Ready",
      "conditions": [
        "window.__3D_STATE__.currentHole === 1",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.totalStrokes === 0",
        "window.__3D_STATE__.gameComplete === false"
      ]
    },
    {
      "id": "S1",
      "name": "Hole1_BallMoving",
      "conditions": [
        "window.__3D_STATE__.currentHole === 1",
        "window.__3D_STATE__.ballMoving === true",
        "window.__3D_STATE__.holeStrokes >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "Hole1_BallStopped",
      "conditions": [
        "window.__3D_STATE__.currentHole === 1",
        "window.__3D_STATE__.ballMoving === false",
        "window.__3D_STATE__.holeStrokes >= 1",
        "window.__3D_STATE__.holeSunk === false"
      ]
    },
    {
      "id": "S3",
      "name": "Hole1_Sunk",
      "conditions": [
        "window.__3D_STATE__.holeSunk === true",
