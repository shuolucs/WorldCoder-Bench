{
  "task_id": "P512_multiplayer_volumetric_cloud_sculptor",
  "affordances": [
    {
      "id": "A1",
      "name": "CloudParticles",
      "type": "3d_object",
      "semantic": "Collection of semi-transparent spheres forming volumetric clouds",
      "locator_hints": [
        "scene children with opacity < 1",
        "MeshPhongMaterial spheres"
      ]
    },
    {
      "id": "A2",
      "name": "AddToolButton",
      "type": "dom_element",
      "semantic": "Button to select the Add sculpting tool",
      "locator_hints": [
        "#btn-add"
      ]
    },
    {
      "id": "A3",
      "name": "RemoveToolButton",
      "type": "dom_element",
      "semantic": "Button to select the Remove sculpting tool",
      "locator_hints": [
        "#btn-remove"
      ]
    },
    {
      "id": "A4",
      "name": "ShapeToolButton",
      "type": "dom_element",
      "semantic": "Button to select the Shape sculpting tool",
      "locator_hints": [
        "#btn-shape"
      ]
    },
    {
      "id": "A5",
      "name": "DensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling particles placed per click",
      "locator_hints": [
        "#slider-density"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing stats",
      "locator_hints": [
        "#hud-panel"
      ]
    },
    {
      "id": "A7",
      "name": "Player2Cursor",
      "type": "3d_object",
      "semantic": "Red sphere showing simulated Player 2 position",
      "locator_hints": [
        "red colored sphere",
        "radius 0.3"
      ]
    },
    {
      "id": "A8",
      "name": "Player3Cursor",
      "type": "3d_object",
      "semantic": "Green sphere showing simulated Player 3 position",
      "locator_hints": [
        "green colored sphere",
        "radius 0.3"
      ]
    },
    {
      "id": "A9",
      "name": "Canvas",
      "type": "dom_element",
      "semantic": "Three.js rendering canvas for raycasting clicks",
      "locator_hints": [
        "canvas",
        "renderer.domElement"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.particleCount >= 25 && window.__3D_STATE__.particleCount <= 40",
        "window.__3D_STATE__.activeTool === 'add'",
        "window.__3D_STATE__.playerCount === 3",
        "window.__3D_STATE__.density === 5"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.frameCount > 10",
        "!isNaN(window.__3D_STATE__.player2Position.x)",
        "!isNaN(window.__3D_STATE__.player3Position.x)"
      ]
    },
    {
      "id": "S2",
      "name": "RemoveToolSelected",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'remove'"
      ]
    },
    {
      "id": "S3",
      "name": "ShapeToolSelected",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'shape'"
      ]
    },
    {
      "id": "S4",
      "name": "DensityChanged",
      "conditions": [
        "window.__3D_STATE__.density !== 5"
      ]
    },
    {
      "id": "S5",
      "name": "AddToolReselected",
      "conditions": [
        "window.__3D_STATE__.activeTool === 'add'"
      ]
    },
    {
      "id": "S6",
      "name": "CloudsDrifted",
      "conditions": [
        "window.__3D_STATE__.frameCount > 300",
        "window.__3D_STATE__.cloudBounds.maxY > 15"
      ]
    },
    {
      "id": "S7",
      "name": "MultiplayerActive",
      "conditions": [
        "window.__3D_STATE__.frameCount > 150",
        "window.__3D_STATE__.particleCount > 30"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.player2Position.x) && !isNaN(window.__3D_STATE__.player2Position.y) && !isNaN(window.__3D_STATE__.player2Position.z)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.player3Position.x) && !isNaN(window.__3D_STATE__.player3Position.y) && !isNaN(window.__3D_STATE__.player3Position.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0 && !isNaN(window.__3D_STATE__.cameraDistance)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudBounds.minY >= 0 && window.__3D_STATE__.cloudBounds.maxY <= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-remove"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'remove'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-active-tool').textContent.toLowerCase().includes('remove')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-shape"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'shape'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-active-tool').textContent.toLowerCase().includes('shape')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playerCount === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-density').value = 8; document.getElementById('slider-density').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.density === 8",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('slider-density').value == 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeTool === 'shape'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-add"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeTool === 'add'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-active-tool').textContent.toLowerCase().includes('add')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.density === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 6000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frameCount > 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cloudBounds.maxY > 15",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cloudBounds.minY)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cloudBounds.maxY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount > 30",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.player2Position.x) <= 15 && Math.abs(window.__3D_STATE__.player2Position.z) <= 15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.player3Position.x) <= 15 && Math.abs(window.__3D_STATE__.player3Position.z) <= 15",
            "tier": "L2"
          },
          {
            "expr": "parseInt(document.getElementById('hud-particle-count').textContent) === window.__3D_STATE__.particleCount",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-player-count').textContent.includes('3')",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}