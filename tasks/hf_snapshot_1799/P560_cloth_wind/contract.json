{
  "task_id": "P560_cloth_wind",
  "affordances": [
    {"id": "A1", "name": "Cloth", "type": "3d_object", "semantic": "25x25 particle cloth mesh", "locator_hints": ["plane geometry mesh updated each frame"]},
    {"id": "A2", "name": "CollisionSphere", "type": "3d_object", "semantic": "Red transparent sphere for collision", "locator_hints": ["sphere mesh red"]},
    {"id": "A3", "name": "Rod", "type": "3d_object", "semantic": "Horizontal rod cloth hangs from", "locator_hints": ["cylinder mesh at y=8"]},
    {"id": "A4", "name": "WindSlider", "type": "dom_element", "semantic": "Wind strength control", "locator_hints": ["#slider-wind"]},
    {"id": "A5", "name": "StiffnessSlider", "type": "dom_element", "semantic": "Spring stiffness control", "locator_hints": ["#slider-stiffness"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.particleCount === 625", "window.__3D_STATE__.isPaused === false"]},
    {"id": "S1", "name": "Draping", "conditions": ["window.__3D_STATE__.avgY < 7"]},
    {"id": "S2", "name": "WindBlowing", "conditions": ["window.__3D_STATE__.windStrength > 0"]},
    {"id": "S3", "name": "StiffnessChanged", "conditions": ["window.__3D_STATE__.stiffness !== 200"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.avgY > 6"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 625", "tier": "L2"},
        {"expr": "window.__3D_STATE__.clothValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.pinnedCount === 9 || window.__3D_STATE__.pinnedCount > 0", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-wind').value = 15; document.getElementById('slider-wind').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.windStrength >= 12", "tier": "L2"},
        {"expr": "window.__3D_STATE__.clothValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.maxStretchRatio < 2.0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.clothValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-stiffness').value = 400; document.getElementById('slider-stiffness').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.stiffness >= 350", "tier": "L2"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.clothValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.particleCount === 625", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "c"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.sphereVisible !== before.sphereVisible", "tier": "L2"}
      ]}
    }
  ]
}
