{
  "task_id": "P443_planetary_orbit_simulator_with_particle_",
  "affordances": [
    {
      "id": "A1",
      "name": "CentralStar",
      "type": "3d_object",
      "semantic": "Emissive star sphere at origin acting as gravitational center",
      "locator_hints": [
        "position (0,0,0)",
        "radius 5",
        "orange-yellow emissive"
      ]
    },
    {
      "id": "A2",
      "name": "Mercury",
      "type": "3d_object",
      "semantic": "Smallest planet at orbital radius 15",
      "locator_hints": [
        "radius 1",
        "color 0xaaaaaa",
        "orbital radius 15"
      ]
    },
    {
      "id": "A3",
      "name": "Earth",
      "type": "3d_object",
      "semantic": "Blue planet at orbital radius 30",
      "locator_hints": [
        "radius 1.5",
        "color 0x3366ff",
        "orbital radius 30"
      ]
    },
    {
      "id": "A4",
      "name": "Mars",
      "type": "3d_object",
      "semantic": "Red planet at orbital radius 45",
      "locator_hints": [
        "radius 1.2",
        "color 0xff4422",
        "orbital radius 45"
      ]
    },
    {
      "id": "A5",
      "name": "RobotAssistant",
      "type": "3d_object",
      "semantic": "Robot GLB model as educational guide",
      "locator_hints": [
        "position (60,0,0)",
        "scale (3,3,3)",
        "loaded from robot.glb"
      ]
    },
    {
      "id": "A6",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD showing simulation stats",
      "locator_hints": [
        "div#hud-panel"
      ]
    },
    {
      "id": "A7",
      "name": "SpeedDisplay",
      "type": "dom_element",
      "semantic": "Speed multiplier display",
      "locator_hints": [
        "span#speed-display"
      ]
    },
    {
      "id": "A8",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Running/Paused status display",
      "locator_hints": [
        "span#status-display"
      ]
    },
    {
      "id": "A9",
      "name": "PlanetInfoBox",
      "type": "dom_element",
      "semantic": "Bottom info box for selected planet details",
      "locator_hints": [
        "div#planet-info"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Running",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.trailsEnabled === true",
        "window.__3D_STATE__.gravityLinesEnabled === false",
        "window.__3D_STATE__.selectedPlanet === null",
        "window.__3D_STATE__.planetCount === 3"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier > 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S3",
      "name": "PlanetSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPlanet !== null"
      ]
    },
    {
      "id": "S4",
      "name": "TrailsDisabled",
      "conditions": [
        "window.__3D_STATE__.trailsEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "GravityLinesEnabled",
      "conditions": [
        "window.__3D_STATE__.gravityLinesEnabled === true"
      ]
    },
    {
      "id": "S6",
      "name": "Reset",
      "conditions": [
        "window.__3D_STATE__.planetAngles.mercury === 0",
        "window.__3D_STATE__.planetAngles.earth === 0",
        "window.__3D_STATE__.planetAngles.mars === 0",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.selectedPlanet === null"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier < 1.0",
        "window.__3D_STATE__.paused === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('status-display') !== null",
            "tier": "L0"
          },
          {
            "expr": "document.getElementById('status-display').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('status-display').textContent.toLowerCase().includes('running')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S0",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('speed-display').textContent.includes('1.25')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S0",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('trails-display').textContent.toUpperCase().includes('OFF')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S0",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "g"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('gravity-display').textContent.toUpperCase().includes('ON')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S0",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "document.getElementById('speed-display').textContent.includes('0.75')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}