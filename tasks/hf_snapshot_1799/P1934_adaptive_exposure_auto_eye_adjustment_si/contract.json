{
  "task_id": "P1934_adaptive_exposure_auto_eye_adjustment_si",
  "affordances": [
    {
      "id": "A1",
      "name": "Camera",
      "type": "3d_object",
      "semantic": "Movable perspective camera that determines zone and luminance sampling",
      "locator_hints": [
        "camera",
        "PerspectiveCamera"
      ]
    },
    {
      "id": "A2",
      "name": "DarkZone",
      "type": "3d_object",
      "semantic": "Dark indoor room on the left side (x < 0)",
      "locator_hints": [
        "dark boxes",
        "dim point light",
        "x < -3"
      ]
    },
    {
      "id": "A3",
      "name": "BrightZone",
      "type": "3d_object",
      "semantic": "Bright outdoor area on the right side (x >= 0)",
      "locator_hints": [
        "bright objects",
        "directional light",
        "x > 3"
      ]
    },
    {
      "id": "A4",
      "name": "ExposureShader",
      "type": "3d_object",
      "semantic": "Post-processing shader pass applying tone-mapped exposure",
      "locator_hints": [
        "ShaderPass",
        "EffectComposer"
      ]
    },
    {
      "id": "A5",
      "name": "ToggleAutoButton",
      "type": "dom_element",
      "semantic": "Button to toggle auto-exposure on/off",
      "locator_hints": [
        "#toggle-auto"
      ]
    },
    {
      "id": "A6",
      "name": "ExposureSlider",
      "type": "dom_element",
      "semantic": "Range slider for manual exposure override when auto is off",
      "locator_hints": [
        "#exposure-override"
      ]
    },
    {
      "id": "A7",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing exposure and zone info",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.cameraX >= -1 && window.__3D_STATE__.cameraX <= 1",
        "window.__3D_STATE__.autoExposure === true",
        "window.__3D_STATE__.adaptationMode === 'smooth'",
        "window.__3D_STATE__.zoneName === 'Transition'",
        "window.__3D_STATE__.frameCount >= 0"
      ]
    },
    {
      "id": "S1",
      "name": "InDarkZone",
      "conditions": [
        "window.__3D_STATE__.cameraX < -3",
        "window.__3D_STATE__.zoneName === 'Dark Room'",
        "window.__3D_STATE__.sceneLuminance <= 0.2"
      ]
    },
    {
      "id": "S2",
      "name": "DarkAdapted",
      "conditions": [
        "window.__3D_STATE__.cameraX < -3",
        "window.__3D_STATE__.exposureDelta < 0.5",
        "window.__3D_STATE__.currentExposure > 3.0"
      ]
    },
    {
      "id": "S3",
      "name": "InBrightZone",
      "conditions": [
        "window.__3D_STATE__.cameraX > 3",
        "window.__3D_STATE__.zoneName === 'Bright Outdoor'",
        "window.__3D_STATE__.sceneLuminance >= 2.0"
      ]
    },
    {
      "id": "S4",
      "name": "BrightAdapted",
      "conditions": [
        "window.__3D_STATE__.cameraX > 3",
        "window.__3D_STATE__.exposureDelta < 0.1",
        "window.__3D_STATE__.currentExposure < 1.0"
      ]
    },
    {
      "id": "S5",
      "name": "InstantMode",
      "conditions": [
        "window.__3D_STATE__.adaptationMode === 'instant'"
      ]
    },
    {
      "id": "S6",
      "name": "SlowMode",
      "conditions": [
        "window.__3D_STATE__.adaptationMode === 'slow'",
        "window.__3D_STATE__.brighteningSpeed === 0.4",
        "window.__3D_STATE__.darkeningSpeed === 0.2"
      ]
    },
    {
      "id": "S7",
      "name": "AutoExposureOff",
      "conditions": [
        "window.__3D_STATE__.autoExposure === false"
      ]
    },
    {
      "id": "S8",
      "name": "ManualOverride",
      "conditions": [
        "window.__3D_STATE__.autoExposure === false",
        "window.__3D_STATE__.overrideSliderValue !== 1.0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.cameraX >= -1 && window.__3D_STATE__.cameraX <= 1",
        "window.__3D_STATE__.adaptationMode === 'smooth'",
        "window.__3D_STATE__.autoExposure === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const cam = document.querySelector('canvas'); for(let i=0;i<120;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'a',code:'KeyA'}));} await new Promise(r=>setTimeout(r,2500)); window.dispatchEvent(new KeyboardEvent('keyup',{key:'a',code:'KeyA'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.sceneLuminance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraX < -3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneName === 'Dark Room'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneLuminance <= 0.2 && window.__3D_STATE__.sceneLuminance >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentExposure) && isFinite(window.__3D_STATE__.currentExposure)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentExposure > 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetExposure > 5.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposureDelta < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoExposure === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentExposure - window.__3D_STATE__.targetExposure) / window.__3D_STATE__.targetExposure < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const prevExposure = window.__3D_STATE__.currentExposure; window.__prevExposure = prevExposure; for(let i=0;i<180;i++){window.dispatchEvent(new KeyboardEvent('keydown',{key:'d',code:'KeyD'}));} await new Promise(r=>setTimeout(r,3500)); window.dispatchEvent(new KeyboardEvent('keyup',{key:'d',code:'KeyD'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraX > 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.zoneName === 'Bright Outdoor'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneLuminance >= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.targetExposure < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentExposure < window.__prevExposure",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentExposure < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentExposure > 0.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposureDelta < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentExposure - (1.0 / (window.__3D_STATE__.sceneLuminance + 0.001))) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.currentExposure) && isFinite(window.__3D_STATE__.currentExposure)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.adaptationMode === 'instant'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.adaptationMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.exposureDelta < 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentExposure - window.__3D_STATE__.targetExposure) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.adaptationMode === 'slow'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brighteningSpeed === 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.darkeningSpeed === 0.2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.brighteningSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.darkeningSpeed === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#toggle-auto"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoExposure === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.autoExposure === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentExposure > 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.currentExposure)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const slider = document.querySelector('#exposure-override'); const lockedExposure = window.__3D_STATE__.currentExposure; window.__lockedExposure = lockedExposure; const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set; nativeInputValueSetter.call(slider, '5.0'); slider.dispatchEvent(new Event('input', {bubbles:true})); await new Promise(r=>setTimeout(r,500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.autoExposure === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.overrideSliderValue === 5.0 || Math.abs(window.__3D_STATE__.overrideSliderValue - 5.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentExposure - 5.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentExposure !== window.__lockedExposure",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.overrideSliderValue === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cameraX >= -1 && window.__3D_STATE__.cameraX <= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoExposure === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.adaptationMode === 'smooth'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastResetFrame > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentExposure - 1.0) < 0.5 || window.__3D_STATE__.exposureDelta < 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "2"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.adaptationMode === 'smooth'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.brighteningSpeed === 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.darkeningSpeed === 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoExposure === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 10",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}