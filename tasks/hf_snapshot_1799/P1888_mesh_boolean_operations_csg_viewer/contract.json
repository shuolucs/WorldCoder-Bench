{
  "task_id": "P1888_mesh_boolean_operations_csg_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "ResultMesh",
      "type": "3d_object",
      "semantic": "The CSG boolean result mesh displayed in the scene",
      "locator_hints": [
        "result mesh with #44ffaa material",
        "child of scene with StandardMaterial"
      ]
    },
    {
      "id": "A2",
      "name": "OperandAOverlay",
      "type": "3d_object",
      "semantic": "Semi-transparent blue box representing operand A",
      "locator_hints": [
        "transparent blue box at x=-0.3"
      ]
    },
    {
      "id": "A3",
      "name": "OperandBOverlay",
      "type": "3d_object",
      "semantic": "Semi-transparent red shape representing operand B",
      "locator_hints": [
        "transparent red sphere/cylinder/torus at variable x"
      ]
    },
    {
      "id": "A4",
      "name": "UnionButton",
      "type": "dom_element",
      "semantic": "Button to perform union operation",
      "locator_hints": [
        "#btn-union"
      ]
    },
    {
      "id": "A5",
      "name": "SubtractButton",
      "type": "dom_element",
      "semantic": "Button to perform subtract operation",
      "locator_hints": [
        "#btn-subtract"
      ]
    },
    {
      "id": "A6",
      "name": "IntersectButton",
      "type": "dom_element",
      "semantic": "Button to perform intersect operation",
      "locator_hints": [
        "#btn-intersect"
      ]
    },
    {
      "id": "A7",
      "name": "WireframeCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox to toggle wireframe on result mesh",
      "locator_hints": [
        "#chk-wireframe"
      ]
    },
    {
      "id": "A8",
      "name": "ShowOperandsCheckbox",
      "type": "dom_element",
      "semantic": "Checkbox to toggle operand overlay visibility",
      "locator_hints": [
        "#chk-show-operands"
      ]
    },
    {
      "id": "A9",
      "name": "OperandBSelect",
      "type": "dom_element",
      "semantic": "Dropdown to change operand B shape",
      "locator_hints": [
        "#sel-operand-b"
      ]
    },
    {
      "id": "A10",
      "name": "OffsetSlider",
      "type": "dom_element",
      "semantic": "Slider controlling operand B X offset",
      "locator_hints": [
        "#slider-offset"
      ]
    },
    {
      "id": "A11",
      "name": "StatsDisplay",
      "type": "dom_element",
      "semantic": "Text area showing operation name, vertex and face counts",
      "locator_hints": [
        "#stats-display"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialSubtractState",
      "conditions": [
        "window.__3D_STATE__.currentOperation === 'subtract'",
        "window.__3D_STATE__.operandBShape === 'sphere'",
        "window.__3D_STATE__.operandBOffsetX === 0.3",
        "window.__3D_STATE__.wireframeEnabled === false",
        "window.__3D_STATE__.operandsVisible === true",
        "window.__3D_STATE__.resultMeshExists === true",
        "window.__3D_STATE__.computeCount === 1"
      ]
    },
    {
      "id": "S1",
      "name": "UnionApplied",
      "conditions": [
        "window.__3D_STATE__.currentOperation === 'union'",
        "window.__3D_STATE__.resultMeshExists === true",
        "window.__3D_STATE__.computeCount >= 2"
      ]
    },
    {
      "id": "S2",
      "name": "IntersectApplied",
      "conditions": [
        "window.__3D_STATE__.currentOperation === 'intersect'",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S3",
      "name": "WireframeOn",
      "conditions": [
        "window.__3D_STATE__.wireframeEnabled === true"
      ]
    },
    {
      "id": "S4",
      "name": "OperandsHidden",
      "conditions": [
        "window.__3D_STATE__.operandsVisible === false"
      ]
    },
    {
      "id": "S5",
      "name": "OperandBCylinder",
      "conditions": [
        "window.__3D_STATE__.operandBShape === 'cylinder'",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S6",
      "name": "OffsetChanged",
      "conditions": [
        "window.__3D_STATE__.operandBOffsetX !== 0.3",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S7",
      "name": "OperandBTorus",
      "conditions": [
        "window.__3D_STATE__.operandBShape === 'torus'",
        "window.__3D_STATE__.resultMeshExists === true"
      ]
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.currentOperation === 'subtract'",
        "window.__3D_STATE__.operandBShape === 'sphere'",
        "window.__3D_STATE__.operandBOffsetX === 0.3",
        "window.__3D_STATE__.wireframeEnabled === false",
        "window.__3D_STATE__.operandsVisible === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentOperation === 'string' && window.__3D_STATE__.currentOperation === 'subtract'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.resultVertexCount === 'number' && window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.resultFaceCount === 'number' && window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true && window.__3D_STATE__.computeCount === 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.resultBoundingBox.min.x) && !isNaN(window.__3D_STATE__.resultBoundingBox.max.x) && isFinite(window.__3D_STATE__.resultBoundingBox.max.y)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-union"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentOperation === 'union'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0 && window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.computeCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultBoundingBox.min.x <= -0.3 && window.__3D_STATE__.resultBoundingBox.max.x >= 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastComputeTime === 'number' && window.__3D_STATE__.lastComputeTime >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentOperation === 'intersect'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0 && window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultBoundingBox.max.x - window.__3D_STATE__.resultBoundingBox.min.x < 2.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultBoundingBox.max.y - window.__3D_STATE__.resultBoundingBox.min.y <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.computeCount >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentOperation === 'intersect'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "o"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.operandsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentOperation === 'intersect'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sel-operand-b').value='cylinder'; document.getElementById('sel-operand-b').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.operandBShape === 'cylinder'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0 && window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.resultBoundingBox.min.z) && isFinite(window.__3D_STATE__.resultBoundingBox.max.z)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.operandBPosition === 'object' && typeof window.__3D_STATE__.operandBPosition.x === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "let s=document.getElementById('slider-offset'); s.value='-1.0'; s.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBOffsetX - (-1.0)) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operandBPosition.x < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.resultBoundingBox.min.x)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('sel-operand-b').value='torus'; document.getElementById('sel-operand-b').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.operandBShape === 'torus'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0 && window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.resultBoundingBox.max.y) && isFinite(window.__3D_STATE__.resultBoundingBox.min.y)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastComputeTime === 'number' && window.__3D_STATE__.lastComputeTime >= 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentOperation === 'subtract'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operandBShape === 'sphere'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.operandBOffsetX - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wireframeEnabled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operandsVisible === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true && window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentOperation === 'union'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultMeshExists === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultVertexCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultFaceCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.operandBShape === 'sphere'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resultBoundingBox.max.x > 0 && window.__3D_STATE__.resultBoundingBox.min.x < 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}