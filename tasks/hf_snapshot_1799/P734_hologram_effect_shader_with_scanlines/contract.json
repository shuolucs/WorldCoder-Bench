      "conditions": [
        "window.__3D_STATE__.glitchActive === true",
        "window.__3D_STATE__.glitchAmount === 0.15"
      ]
    },
    {
      "id": "S2",
      "name": "HighDensity",
      "conditions": [
        "window.__3D_STATE__.scanlineDensity === 'HIGH'",
        "window.__3D_STATE__.scanlineFrequency === 60.0"
      ]
    },
    {
      "id": "S3",
      "name": "FresnelChanged",
      "conditions": [
        "window.__3D_STATE__.fresnelPower === 4.0"
      ]
    },
    {
      "id": "S4",
      "name": "RotationStopped",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "ColorMagenta",
      "conditions": [
        "window.__3D_STATE__.colorName === 'MAGENTA'",
        "window.__3D_STATE__.colorRGB[0] === 1",
        "window.__3D_STATE__.colorRGB[2] === 0.8"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedAdjusted",
      "conditions": [
        "window.__3D_STATE__.scanlineSpeed !== 2.0",
        "window.__3D_STATE__.scanlineSpeed >= 0.5",
        "window.__3D_STATE__.scanlineSpeed <= 8.0"
      ]
    },
    {
      "id": "S7",
      "name": "ColorGold",
      "conditions": [
        "window.__3D_STATE__.colorName === 'GOLD'",
        "window.__3D_STATE__.colorRGB[0] === 1",
        "window.__3D_STATE__.colorRGB[1] === 0.85"
      ]
    },
    {
      "id": "S8",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.glitchActive === false",
        "window.__3D_STATE__.scanlineDensity === 'MEDIUM'",
        "window.__3D_STATE__.fresnelPower === 2.5",
        "window.__3D_STATE__.rotationEnabled === true",
        "window.__3D_STATE__.colorName === 'CYAN'",
        "window.__3D_STATE__.scanlineSpeed === 2.0"
      ]
    }
