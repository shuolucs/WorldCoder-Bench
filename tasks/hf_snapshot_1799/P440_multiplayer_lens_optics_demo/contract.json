  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.p1_obj_x === -8",
        "window.__3D_STATE__.p2_obj_x === -6",
        "window.__3D_STATE__.focal_length === 3",
        "window.__3D_STATE__.lens_type === 'convex'"
      ]
    },
    {
      "id": "S1",
      "name": "P1MovedRight",
      "conditions": [
        "window.__3D_STATE__.p1_obj_x === -7.5",
        "window.__3D_STATE__.p1_do === 7.5"
      ]
    },
    {
      "id": "S2",
      "name": "P2MovedLeft",
      "conditions": [
        "window.__3D_STATE__.p2_obj_x === -6.5",
        "window.__3D_STATE__.p2_do === 6.5"
      ]
    },
    {
      "id": "S3",
      "name": "FocalChanged",
      "conditions": [
        "Math.abs(window.__3D_STATE__.focal_length - 5) < 0.01"
      ]
    },
    {
      "id": "S4",
      "name": "ConcaveLens",
      "conditions": [
        "window.__3D_STATE__.lens_type === 'concave'",
        "window.__3D_STATE__.focal_length < 0"
      ]
    },
    {
      "id": "S5",
      "name": "ConcaveVirtualImages",
      "conditions": [
        "window.__3D_STATE__.p1_image_real === false",
        "window.__3D_STATE__.p2_image_real === false"
      ]
    },
    {
      "id": "S6",
      "name": "ObjectsSwapped",
      "conditions": [
        "Math.abs(window.__3D_STATE__.p1_obj_x - (-6.5)) < 0.01",
        "Math.abs(window.__3D_STATE__.p2_obj_x - (-7.5)) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "P1InsideFocal",
      "conditions": [
        "window.__3D_STATE__.p1_do < Math.abs(window.__3D_STATE__.focal_length)",
        "window.__3D_STATE__.p1_image_real === false"
      ]
    },
    {
      "id": "S8",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.p1_obj_x === -8",
        "window.__3D_STATE__.p2_obj_x === -6",
        "window.__3D_STATE__.focal_length === 3",
        "window.__3D_STATE__.lens_type === 'convex'"
      ]
    },
    {
      "id": "S9",
      "name": "TightPhysicsVerified",
      "conditions": [
        "Math.abs(1/window.__3D_STATE__.focal_length - 1/window.__3D_STATE__.p1_do - 1/window.__3D_STATE__.p1_di) < 0.001",
        "Math.abs(1/window.__3D_STATE__.focal_length - 1/window.__3D_STATE__.p2_do - 1/window.__3D_STATE__.p2_di) < 0.001"
      ]
    }
  ],
