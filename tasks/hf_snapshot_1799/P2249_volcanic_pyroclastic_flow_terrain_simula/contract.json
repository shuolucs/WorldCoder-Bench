{
  "task_id": "P2249_volcanic_pyroclastic_flow_terrain_simula",
  "affordances": [
    {
      "id": "A1",
      "name": "VolcanicTerrain",
      "type": "3d_object",
      "semantic": "Procedural volcanic cone terrain with displaced vertices",
      "locator_hints": [
        "PlaneGeometry mesh with vertex displacement",
        "terrain mesh at origin"
      ]
    },
    {
      "id": "A2",
      "name": "RobotSurvivor",
      "type": "3d_object",
      "semantic": "GLTF robot model navigating the terrain",
      "locator_hints": [
        "robot.glb loaded model",
        "window.__3D_STATE__.robotPosition"
      ]
    },
    {
      "id": "A3",
      "name": "PyroclasticParticles",
      "type": "3d_object",
      "semantic": "Array of hot sphere particles flowing from summit",
      "locator_hints": [
        "small sphere meshes with emissive material",
        "window.__3D_STATE__.particles"
      ]
    },
    {
      "id": "A4",
      "name": "ShieldSphere",
      "type": "3d_object",
      "semantic": "Translucent blue sphere around robot when shield active",
      "locator_hints": [
        "transparent blue sphere mesh around robot"
      ]
    },
    {
      "id": "A5",
      "name": "EruptButton",
      "type": "dom_element",
      "semantic": "Button to trigger eruption wave",
      "locator_hints": [
        "#erupt-btn"
      ]
    },
    {
      "id": "A6",
      "name": "IntensitySlider",
      "type": "dom_element",
      "semantic": "Slider controlling eruption intensity 1-10",
      "locator_hints": [
        "#intensity-slider"
      ]
    },
    {
      "id": "A7",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation pause",
      "locator_hints": [
        "#pause-btn"
      ]
    },
    {
      "id": "A8",
      "name": "ResetAllButton",
      "type": "dom_element",
      "semantic": "Button to reset entire simulation",
      "locator_hints": [
        "#reset-all-btn"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Overlay showing health, shield, particles, temp, energy",
      "locator_hints": [
        "#robot-health",
        "#shield-status",
        "#particle-count",
        "#avg-temp",
        "#energy-display",
        "#sim-time"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.simulationRunning === true",
        "window.__3D_STATE__.robotModelLoaded === true",
        "window.__3D_STATE__.activeParticleCount === 0",
        "window.__3D_STATE__.robotHealth === 100",
        "window.__3D_STATE__.eruptionCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "FirstEruption",
      "conditions": [
        "window.__3D_STATE__.eruptionCount >= 1",
        "window.__3D_STATE__.activeParticleCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "RobotMoved",
      "conditions": [
        "window.__3D_STATE__.robotPosition.x !== 40 || window.__3D_STATE__.robotPosition.z !== 40"
      ]
    },
    {
      "id": "S3",
      "name": "ShieldActivated",
      "conditions": [
        "window.__3D_STATE__.shieldActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "IntensityChanged",
      "conditions": [
        "window.__3D_STATE__.intensity !== 5"
      ]
    },
    {
      "id": "S6",
      "name": "HighIntensityEruption",
      "conditions": [
        "window.__3D_STATE__.intensity >= 8",
        "window.__3D_STATE__.activeParticleCount > 100"
      ]
    },
    {
      "id": "S7",
      "name": "RobotDamaged",
      "conditions": [
        "window.__3D_STATE__.robotHealth < 100"
      ]
    },
    {
      "id": "S8",
      "name": "RobotUndone",
      "conditions": [
        "window.__3D_STATE__.robotHistory.length >= 1"
      ]
    },
    {
      "id": "S9",
      "name": "RobotReset",
      "conditions": [
        "window.__3D_STATE__.robotPosition.x === 40",
        "window.__3D_STATE__.robotHealth === 100"
      ]
    },
    {
      "id": "S10",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.activeParticleCount === 0",
        "window.__3D_STATE__.robotHealth === 100",
        "window.__3D_STATE__.eruptionCount === 0"
      ]
    },
    {
      "id": "S11",
      "name": "ParticlesCooled",
      "conditions": [
        "window.__3D_STATE__.avgTemperature < 200"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.robotModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.terrainHeightAt === 'function'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.volcanoApexY >= 50 && window.__3D_STATE__.volcanoApexY <= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotHealth === 100 && !isNaN(window.__3D_STATE__.robotHealth)",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particles) && window.__3D_STATE__.activeParticleCount === 0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#erupt-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.eruptionCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particles.length > 0 && window.__3D_STATE__.particles.some(p => p.active === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particles.filter(p => p.active).every(p => p.temp >= 750 && p.temp <= 810)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0 && !isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialEnergy > 0 && !isNaN(window.__3D_STATE__.initialEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.robotPosition.z < 40",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.robotPosition.x) && !isNaN(window.__3D_STATE__.robotPosition.y) && !isNaN(window.__3D_STATE__.robotPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.y - window.__3D_STATE__.terrainHeightAt(window.__3D_STATE__.robotPosition.x, window.__3D_STATE__.robotPosition.z)) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotHistory.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotPosition.x >= -100 && window.__3D_STATE__.robotPosition.x <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.shieldActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldTimer > 0 && window.__3D_STATE__.shieldTimer <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.shieldActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "document.querySelector('#shield-status') !== null && document.querySelector('#shield-status').textContent.toLowerCase().includes('active')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#pause-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var t = window.__3D_STATE__.simTime; return typeof t === 'number' && !isNaN(t); })()",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount >= 0 && !isNaN(window.__3D_STATE__.activeParticleCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#intensity-slider').value = 9; document.querySelector('#intensity-slider').dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.intensity === 9 || window.__3D_STATE__.intensity === '9'",
            "tier": "L2"
          },
          {
            "expr": "Number(window.__3D_STATE__.intensity) >= 8",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.intensity !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#intensity-slider').value == 9",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#pause-btn').click(); setTimeout(function(){ document.querySelector('#erupt-btn').click(); }, 200);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eruptionCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount > 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particles.filter(p => p.active).every(p => !isNaN(p.vx) && !isNaN(p.vy) && !isNaN(p.vz))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxVelocity <= 26",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: 'a'})); setTimeout(function(){ window.dispatchEvent(new KeyboardEvent('keyup', {key: 'a'})); }, 2000);"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.robotHealth <= 100",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.robotHealth)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.robotHealth === 'number'",
            "tier": "L0"
          },
          {
            "expr": "parseFloat(document.querySelector('#robot-health').textContent) <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avgTemperature > 0 && !isNaN(window.__3D_STATE__.avgTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "u"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.robotHistory.length >= 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.robotPosition.x === 'number'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.robotPosition.y)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.y - window.__3D_STATE__.terrainHeightAt(window.__3D_STATE__.robotPosition.x, window.__3D_STATE__.robotPosition.z)) < 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.x - 40) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.z - 40) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotHealth === 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.y - window.__3D_STATE__.terrainHeightAt(40, 40)) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#robot-health').textContent.includes('100')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#reset-all-btn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeParticleCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.robotHealth === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.eruptionCount === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.robotPosition.x - 40) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shieldActive === false && window.__3D_STATE__.shieldCooldown === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0 || window.__3D_STATE__.simTime < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S10",
      "to": "S11",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('#erupt-btn').click(); return new Promise(r => setTimeout(r, 12000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particles.filter(p => p.active).length === 0 || window.__3D_STATE__.avgTemperature < 400",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergy)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeParticleCount >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particles.filter(p => p.active).every(p => Math.sqrt(p.vx*p.vx + p.vy*p.vy + p.vz*p.vz) <= 26)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}