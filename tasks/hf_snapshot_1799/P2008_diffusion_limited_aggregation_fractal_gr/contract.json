{
  "task_id": "P2008_diffusion_limited_aggregation_fractal_gr",
  "affordances": [
    {
      "id": "A1",
      "name": "AggregateCluster",
      "type": "3d_object",
      "semantic": "InstancedMesh representing all aggregated DLA particles colored by distance or order",
      "locator_hints": [
        "scene.children find InstancedMesh",
        "mesh with instanceCount > 0"
      ]
    },
    {
      "id": "A2",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button toggling simulation play/pause",
      "locator_hints": [
        "#btn-play-pause"
      ]
    },
    {
      "id": "A3",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button resetting simulation to initial seed",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A4",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling steps per frame",
      "locator_hints": [
        "#slider-speed"
      ]
    },
    {
      "id": "A5",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation stats",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "ParticleCountDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing current particle count",
      "locator_hints": [
        "#hud-count"
      ]
    },
    {
      "id": "A7",
      "name": "DimensionDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing fractal dimension estimate",
      "locator_hints": [
        "#hud-dimension"
      ]
    },
    {
      "id": "A8",
      "name": "StateDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing running or paused",
      "locator_hints": [
        "#hud-state"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.particleCount === 1",
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.seedCount === 1"
      ]
    },
    {
      "id": "S1",
      "name": "Running",
      "conditions": [
        "window.__3D_STATE__.simRunning === true"
      ]
    },
    {
      "id": "S2",
      "name": "GrowthInProgress",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.particleCount > 1"
      ]
    },
    {
      "id": "S3",
      "name": "PausedAfterGrowth",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.particleCount > 1"
      ]
    },
    {
      "id": "S4",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.stepsPerFrame !== 5"
      ]
    },
    {
      "id": "S5",
      "name": "ColorModeOrder",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'order'"
      ]
    },
    {
      "id": "S6",
      "name": "ColorModeDistance",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'distance'"
      ]
    },
    {
      "id": "S7",
      "name": "MultiSeed",
      "conditions": [
        "window.__3D_STATE__.seedCount > 1"
      ]
    },
    {
      "id": "S8",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.particleCount === 1",
        "window.__3D_STATE__.totalStepsElapsed === 0",
        "window.__3D_STATE__.seedCount === 1"
      ]
    },
    {
      "id": "S9",
      "name": "SignificantGrowth",
      "conditions": [
        "window.__3D_STATE__.particleCount >= 30",
        "window.__3D_STATE__.maxRadius > 2"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.particleCount === 'number' && window.__3D_STATE__.particleCount === 1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simRunning === 'boolean' && window.__3D_STATE__.simRunning === false",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.maxRadius === 'number' && window.__3D_STATE__.maxRadius >= 0 && window.__3D_STATE__.maxRadius < 1",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.colorMode === 'string' && window.__3D_STATE__.colorMode === 'distance'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.gridCellSize === 'number' && window.__3D_STATE__.gridCellSize === 5",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#btn-play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim().toLowerCase() === 'pause'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-state').textContent.toLowerCase().includes('running')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalStepsElapsed === 'number' && window.__3D_STATE__.totalStepsElapsed >= 0",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepsPerFrame === 'number' && window.__3D_STATE__.stepsPerFrame === 5",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStepsElapsed > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === window.__3D_STATE__.particleCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => isFinite(p.x) && isFinite(p.y) && isFinite(p.z))",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastAggregatedPosition === 'object' && isFinite(window.__3D_STATE__.lastAggregatedPosition.x)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('btn-play-pause').textContent.trim().toLowerCase() === 'play'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-state').textContent.toLowerCase().includes('paused')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius >= 0 && isFinite(window.__3D_STATE__.maxRadius)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const before = window.__3D_STATE__.particleCount; window.__T5_before_count__ = before; window.__T5_before_steps__ = window.__3D_STATE__.totalStepsElapsed;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === window.__T5_before_count__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStepsElapsed === window.__T5_before_steps__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeWalkers === 0 || window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('slider-speed').value = 15; document.getElementById('slider-speed').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stepsPerFrame === 15",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('slider-speed').value === '15'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stepsPerFrame === 'number' && window.__3D_STATE__.stepsPerFrame >= 1 && window.__3D_STATE__.stepsPerFrame <= 20",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T7_before_count__ = window.__3D_STATE__.particleCount; window.__T7_before_radius__ = window.__3D_STATE__.maxRadius; document.getElementById('btn-play-pause').click(); await new Promise(r => setTimeout(r, 5000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount > window.__T7_before_count__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius >= window.__T7_before_radius__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spawnRadius === Math.min(window.__3D_STATE__.maxRadius + 15, 75)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fractalDimension > 0 && window.__3D_STATE__.fractalDimension <= 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S9",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'order'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-colormode').textContent.toLowerCase().includes('order')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fractalDimension >= 1.0 && window.__3D_STATE__.fractalDimension <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fractalDimension - Math.log(window.__3D_STATE__.particleCount) / Math.log(window.__3D_STATE__.maxRadius)) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "c"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.colorMode === 'distance'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('hud-colormode').textContent.toLowerCase().includes('distance')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "parseInt(document.getElementById('hud-count').textContent.replace(/[^0-9]/g,'')) === window.__3D_STATE__.particleCount",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T10_before_count__ = window.__3D_STATE__.particleCount; window.__T10_before_radius__ = window.__3D_STATE__.maxRadius; window.__T10_before_steps__ = window.__3D_STATE__.totalStepsElapsed; await new Promise(r => setTimeout(r, 2000));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount >= window.__T10_before_count__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius >= window.__T10_before_radius__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStepsElapsed > window.__T10_before_steps__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === window.__3D_STATE__.particleCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.every(p => Math.sqrt(p.x*p.x + p.y*p.y + p.z*p.z) <= 81)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S6",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.particleCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStepsElapsed === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.seedCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius < 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particlePositions.length === 1 && Math.abs(window.__3D_STATE__.particlePositions[0].x) < 0.01 && Math.abs(window.__3D_STATE__.particlePositions[0].y) < 0.01 && Math.abs(window.__3D_STATE__.particlePositions[0].z) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T12",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.getElementById('btn-play-pause').click(); await new Promise(r => setTimeout(r, 6000)); document.getElementById('btn-play-pause').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maxRadius > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.fractalDimension >= 1.0 && window.__3D_STATE__.fractalDimension <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spawnRadius === Math.min(window.__3D_STATE__.maxRadius + 15, 75)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}