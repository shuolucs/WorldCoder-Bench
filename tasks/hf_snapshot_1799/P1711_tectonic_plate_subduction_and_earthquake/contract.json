{
  "task_id": "P1711_tectonic_plate_subduction_and_earthquake",
  "affordances": [
    {
      "id": "A1",
      "name": "OceanicPlate",
      "type": "3d_object",
      "semantic": "Blue-gray oceanic tectonic plate that subducts beneath the continental plate",
      "locator_hints": [
        "mesh with color ~0x4a6a7a",
        "left plate starting at x=-22"
      ]
    },
    {
      "id": "A2",
      "name": "ContinentalPlate",
      "type": "3d_object",
      "semantic": "Brown-tan continental tectonic plate that overrides the oceanic plate",
      "locator_hints": [
        "mesh with color ~0x8B7355",
        "right plate starting at x=18"
      ]
    },
    {
      "id": "A3",
      "name": "MantleLayer",
      "type": "3d_object",
      "semantic": "Semi-transparent asthenosphere layer beneath plates",
      "locator_hints": [
        "semi-transparent orange-red box at y=-8"
      ]
    },
    {
      "id": "A4",
      "name": "SeismicWaveRing",
      "type": "3d_object",
      "semantic": "Expanding ring geometry representing seismic wave propagation",
      "locator_hints": [
        "RingGeometry at epicenter",
        "expanding ring with fading opacity"
      ]
    },
    {
      "id": "A5",
      "name": "ForceQuakeButton",
      "type": "dom_element",
      "semantic": "Button to force-trigger an earthquake at current stress",
      "locator_hints": [
        "#forceQuakeBtn"
      ]
    },
    {
      "id": "A6",
      "name": "ResetSimButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation to initial state",
      "locator_hints": [
        "#resetSimBtn"
      ]
    },
    {
      "id": "A7",
      "name": "UndoQuakeButton",
      "type": "dom_element",
      "semantic": "Button to undo the last earthquake event",
      "locator_hints": [
        "#undoQuakeBtn"
      ]
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation parameters",
      "locator_hints": [
        "#hud",
        "top-left overlay div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "SceneReady",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.stress === 0",
        "window.__3D_STATE__.quakeCount === 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S1",
      "name": "StressAccumulating",
      "conditions": [
        "window.__3D_STATE__.stress > 0",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S2",
      "name": "SimPaused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "EarthquakeTriggered",
      "conditions": [
        "window.__3D_STATE__.quakeCount >= 1",
        "window.__3D_STATE__.lastMagnitude >= 4.0"
      ]
    },
    {
      "id": "S4",
      "name": "ThresholdAdjusted",
      "conditions": [
        "window.__3D_STATE__.earthquakeThreshold !== 50"
      ]
    },
    {
      "id": "S5",
      "name": "StressRateAdjusted",
      "conditions": [
        "window.__3D_STATE__.stressRate !== 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "WireframeActive",
      "conditions": [
        "window.__3D_STATE__.wireframeOn === true"
      ]
    },
    {
      "id": "S7",
      "name": "HeatmapActive",
      "conditions": [
        "window.__3D_STATE__.heatmapOn === true"
      ]
    },
    {
      "id": "S8",
      "name": "PlateSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPlate !== 'none'"
      ]
    },
    {
      "id": "S9",
      "name": "UndoPerformed",
      "conditions": [
        "window.__3D_STATE__.undoAvailable === false"
      ]
    },
    {
      "id": "S10",
      "name": "SimReset",
      "conditions": [
        "window.__3D_STATE__.stress === 0",
        "window.__3D_STATE__.quakeCount === 0",
        "window.__3D_STATE__.simTime === 0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stress > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stress - window.__3D_STATE__.simTime * window.__3D_STATE__.stressRate) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.oceanicPlateX > -22",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stress > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.oceanicPlateX)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.oceanicPlateY)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "const stressBefore = window.__3D_STATE__.stress; const timeBefore = window.__3D_STATE__.simTime; window.__T3_before__ = {stress: stressBefore, time: timeBefore}; document.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space'})); await new Promise(r => setTimeout(r, 1500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.paused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > window.__T3_before__.time",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stress > window.__T3_before__.stress",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stress)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.plateVelocity > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#forceQuakeBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quakeCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastMagnitude >= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastMagnitude <= 9.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyReleased > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoAvailable === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T5_preStress__ = window.__3D_STATE__.preQuakeStress; window.__T5_mag__ = window.__3D_STATE__.lastMagnitude; const expectedMag = 4.0 + (window.__T5_preStress__ / 100) * 5.0; window.__T5_expectedMag__ = expectedMag; const expectedEnergy = Math.pow(10, 1.5 * window.__T5_mag__ + 4.8); window.__T5_expectedEnergy__ = expectedEnergy;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.lastMagnitude - window.__T5_expectedMag__) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyReleased > 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergyReleased)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastEnergyReleased > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeWaves >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T6_threshBefore__ = window.__3D_STATE__.earthquakeThreshold; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp', code: 'ArrowUp'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp', code: 'ArrowUp'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.earthquakeThreshold > window.__T6_threshBefore__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeThreshold >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.earthquakeThreshold <= 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.earthquakeThreshold - (window.__T6_threshBefore__ + 10)) < 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.earthquakeThreshold === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T7_rateBefore__ = window.__3D_STATE__.stressRate; document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', code: 'ArrowRight'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', code: 'ArrowRight'})); document.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowRight', code: 'ArrowRight'}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.stressRate > window.__T7_rateBefore__",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressRate >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stressRate <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.stressRate - (window.__T7_rateBefore__ + 0.6)) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stressRate === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wireframeOn === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.wireframeOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stress)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.heatmapOn === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.heatmapOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wireframeOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sceneReady === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__T10_quakesBefore__ = window.__3D_STATE__.quakeCount; window.__T10_energyBefore__ = window.__3D_STATE__.totalEnergyReleased; window.__T10_lastEnergy__ = window.__3D_STATE__.lastEnergyReleased; document.getElementById('undoQuakeBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.undoAvailable === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quakeCount === window.__T10_quakesBefore__ - 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergyReleased - (window.__T10_energyBefore__ - window.__T10_lastEnergy__)) < window.__T10_lastEnergy__ * 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stress === window.__3D_STATE__.preQuakeStress",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalEnergyReleased)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T11",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "#resetSimBtn"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stress === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.quakeCount === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyReleased === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeWaves === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastMagnitude === 0",
