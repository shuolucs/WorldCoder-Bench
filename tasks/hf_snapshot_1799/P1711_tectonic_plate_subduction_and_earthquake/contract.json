      "from": "S10",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 3000)); window.__T12_stressBefore__ = window.__3D_STATE__.stress; document.getElementById('forceQuakeBtn').click(); await new Promise(r => setTimeout(r, 500)); window.__T12_quake1Energy__ = window.__3D_STATE__.totalEnergyReleased; window.__T12_quake1Mag__ = window.__3D_STATE__.lastMagnitude; await new Promise(r => setTimeout(r, 2000)); document.getElementById('forceQuakeBtn').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.quakeCount === 2",
            "tier": "L2"
