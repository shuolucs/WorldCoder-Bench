  "states": [
    {
      "id": "S0",
      "name": "Initialized_Idle",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.selectedSource === -1",
        "window.__3D_STATE__.dancePhase === 'IDLE'",
        "window.__3D_STATE__.scoutEnergy === 100",
        "window.__3D_STATE__.danceCycles === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SourceA_Selected_Dancing",
      "conditions": [
        "window.__3D_STATE__.selectedSource === 0",
        "window.__3D_STATE__.dancePhase !== 'IDLE'",
        "window.__3D_STATE__.distanceToSource > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Dance_Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "Dance_Resumed",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.selectedSource >= 0"
      ]
    },
    {
      "id": "S4",
      "name": "SourceB_Selected",
      "conditions": [
        "window.__3D_STATE__.selectedSource === 1"
      ]
    },
    {
      "id": "S5",
      "name": "Undo_To_SourceA",
      "conditions": [
        "window.__3D_STATE__.selectedSource === 0",
        "window.__3D_STATE__.selectionHistory.length >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "Followers_Dispatched",
      "conditions": [
        "window.__3D_STATE__.followersDispatched === true"
      ]
    },
    {
      "id": "S7",
      "name": "Followers_Reached",
      "conditions": [
        "window.__3D_STATE__.followersReachedTarget >= 3"
      ]
    },
    {
      "id": "S8",
      "name": "Energy_Depleted_Boosted",
      "conditions": [
        "window.__3D_STATE__.scoutEnergy > 0"
      ]
    },
    {
      "id": "S9",
      "name": "Speed_Changed",
      "conditions": [
        "window.__3D_STATE__.simSpeed === 2"
      ]
    },
    {
      "id": "S10",
      "name": "SourceD_Selected_HighVigor",
      "conditions": [
        "window.__3D_STATE__.selectedSource === 3",
        "window.__3D_STATE__.nectarQuality === 0.75"
      ]
    },
    {
      "id": "S11",
      "name": "Reset_Complete",
      "conditions": [
        "window.__3D_STATE__.selectedSource === -1",
        "window.__3D_STATE__.scoutEnergy === 100",
        "window.__3D_STATE__.danceCycles === 0"
      ]
    }
  ],
