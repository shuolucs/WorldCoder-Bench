    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ !== 'undefined'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedSource === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scoutEnergy === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dancePhase === 'IDLE'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.foodSourcePositions) && window.__3D_STATE__.foodSourcePositions.length === 4",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
