        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedSource === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.nectarQuality === 0.9",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.distanceToSource - Math.sqrt(8*8 + 6*6)) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waggleDurationMs - window.__3D_STATE__.distanceToSource * 200) < 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dancePhase !== 'IDLE'",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.selectionHistory) && window.__3D_STATE__.selectionHistory[window.__3D_STATE__.selectionHistory.length - 1] === 0",
            "tier": "L0"
          }
        ]
      }
    },
