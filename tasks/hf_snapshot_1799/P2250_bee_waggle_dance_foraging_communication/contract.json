          },
          {
            "expr": "!isNaN(window.__3D_STATE__.scoutPosition.y) && !isNaN(window.__3D_STATE__.scoutPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scoutEnergy <= 100 && window.__3D_STATE__.scoutEnergy >= 0",
            "tier": "L2"
