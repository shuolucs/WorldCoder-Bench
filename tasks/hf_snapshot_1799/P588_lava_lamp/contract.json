{
  "task_id": "P588_lava_lamp",
  "affordances": [
    {"id": "A1", "name": "LampBody", "type": "3d_object", "semantic": "Lamp housing with base, glass cylinder, and cap", "locator_hints": ["cylinder meshes dark + transparent"]},
    {"id": "A2", "name": "MetaBalls", "type": "3d_object", "semantic": "MarchingCubes metaball lava blobs", "locator_hints": ["MarchingCubes mesh"]},
    {"id": "A3", "name": "BackgroundPlane", "type": "3d_object", "semantic": "Lavatile textured background", "locator_hints": ["plane mesh with lavatile texture"]},
    {"id": "A4", "name": "HeatSlider", "type": "dom_element", "semantic": "Buoyancy strength control", "locator_hints": ["#slider-heat"]},
    {"id": "A5", "name": "BlobSlider", "type": "dom_element", "semantic": "Blob count control", "locator_hints": ["#slider-blobs"]},
    {"id": "A6", "name": "ViscositySlider", "type": "dom_element", "semantic": "Viscosity control", "locator_hints": ["#slider-viscosity"]},
    {"id": "A7", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.frameCount > 0", "window.__3D_STATE__.blobCount === 8"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.risingCount > 0 || window.__3D_STATE__.fallingCount > 0"]},
    {"id": "S2", "name": "HeatChanged", "conditions": ["window.__3D_STATE__.heatStrength !== 0.8"]},
    {"id": "S3", "name": "BlobsChanged", "conditions": ["window.__3D_STATE__.blobCount !== 8"]},
    {"id": "S4", "name": "PaletteSwapped", "conditions": ["window.__3D_STATE__.palette === 'Cool'"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 1000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.blobCount >= 3 && window.__3D_STATE__.blobCount <= 15", "tier": "L2"},
        {"expr": "window.__3D_STATE__.avgTemperature >= 0 && window.__3D_STATE__.avgTemperature <= 1", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-heat').value = 1.8; document.getElementById('slider-heat').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.heatStrength >= 1.5", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S2", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 3000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.risingCount > 0 || window.__3D_STATE__.fallingCount > 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-blobs').value = 12; document.getElementById('slider-blobs').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.blobCount >= 10", "tier": "L2"},
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-viscosity').value = 4.0; document.getElementById('slider-viscosity').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.viscosity >= 3.5", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "h"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.palette === 'Cool'", "tier": "L2"}
      ]}
    },
    {
      "id": "T7", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.simValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > before.frameCount", "tier": "L0"}
      ]}
    }
  ]
}
