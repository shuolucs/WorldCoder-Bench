  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.drugPosition.x === 10",
        "window.__3D_STATE__.isDocked === false",
        "window.__3D_STATE__.isAutoDocking === false",
        "window.__3D_STATE__.debugMode === false",
        "window.__3D_STATE__.dockingStatus === 'Undocked'"
      ]
    },
    {
      "id": "S1",
      "name": "DebugEnabled",
      "conditions": [
        "window.__3D_STATE__.debugMode === true",
        "window.__3D_STATE__.debugLineCount > 0"
      ]
    },
    {
      "id": "S2",
      "name": "DrugMovedByKeyboard",
      "conditions": [
        "window.__3D_STATE__.drugPosition.x < 10",
        "window.__3D_STATE__.undoStackSize > 0"
      ]
    },
    {
      "id": "S3",
      "name": "AutoDockingActive",
      "conditions": [
        "window.__3D_STATE__.isAutoDocking === true",
        "window.__3D_STATE__.dockingStatus !== 'Docked'"
      ]
    },
    {
      "id": "S4",
      "name": "Approaching",
      "conditions": [
        "window.__3D_STATE__.distanceToPocket < 8.0",
        "window.__3D_STATE__.dockingStatus === 'Approaching'"
      ]
    },
    {
      "id": "S5",
      "name": "Docked",
      "conditions": [
        "window.__3D_STATE__.isDocked === true",
        "window.__3D_STATE__.distanceToPocket < 1.5",
        "window.__3D_STATE__.dockingStatus === 'Docked'"
      ]
    },
    {
      "id": "S6",
      "name": "ResetAfterDock",
      "conditions": [
        "window.__3D_STATE__.drugPosition.x === 10",
        "window.__3D_STATE__.isDocked === false",
        "window.__3D_STATE__.isAutoDocking === false"
      ]
    },
    {
      "id": "S7",
      "name": "ChargePresetChanged",
      "conditions": [
        "window.__3D_STATE__.chargePreset !== 'Default'"
      ]
    },
    {
      "id": "S8",
      "name": "UndoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize > 0"
      ]
    },
    {
      "id": "S9",
      "name": "RedoneState",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.undoStackSize > 0"
