        "window.__3D_STATE__.strategy === 'top-down'",
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.armedFloor === null"
      ]
    },
    {
      "id": "S2",
      "name": "Floor5Armed",
