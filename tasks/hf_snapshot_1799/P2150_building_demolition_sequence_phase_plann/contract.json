  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.strategy === 'none'",
        "window.__3D_STATE__.currentPhase === 0",
        "window.__3D_STATE__.demolishedCount === 0",
        "window.__3D_STATE__.remainingMass === 500.5",
        "window.__3D_STATE__.chairStatus === 'intact'"
