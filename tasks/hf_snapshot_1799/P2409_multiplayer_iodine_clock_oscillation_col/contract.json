  "states": [
    {
      "id": "S0",
      "name": "Initialized_AllStopped",
      "conditions": [
        "window.__3D_STATE__.initialized === true",
        "window.__3D_STATE__.runningCount === 0",
        "window.__3D_STATE__.beakers.every(b => b.running === false)",
        "window.__3D_STATE__.beakers.every(b => b.phase === 0)",
        "window.__3D_STATE__.beakers.every(b => b.amplitude === 0)"
      ]
    },
    {
      "id": "S1",
      "name": "AllRunning",
      "conditions": [
        "window.__3D_STATE__.runningCount === 4",
        "window.__3D_STATE__.beakers.every(b => b.running === true)"
      ]
    },
    {
      "id": "S2",
      "name": "OscillatingWithPhaseAdvance",
      "conditions": [
        "window.__3D_STATE__.beakers.some(b => b.phase > 0)",
        "window.__3D_STATE__.elapsedTime > 0"
      ]
    },
    {
      "id": "S3",
      "name": "IndividualToggled",
      "conditions": [
        "window.__3D_STATE__.runningCount >= 1 && window.__3D_STATE__.runningCount <= 3"
      ]
    },
    {
      "id": "S4",
      "name": "ConcentrationIncreased",
      "conditions": [
        "window.__3D_STATE__.beakers.some(b => b.concentration > 1.0)"
      ]
    },
    {
      "id": "S5",
      "name": "ConcentrationDecreased",
      "conditions": [
        "window.__3D_STATE__.beakers.some(b => b.concentration < 1.0)"
      ]
    },
    {
      "id": "S6",
      "name": "PhasesSynchronized",
      "conditions": [
        "window.__3D_STATE__.allSynced === true"
      ]
    },
    {
      "id": "S7",
      "name": "AllStopped_MidCycle",
      "conditions": [
        "window.__3D_STATE__.runningCount === 0",
        "window.__3D_STATE__.beakers.some(b => b.phase > 0)"
      ]
    },
    {
      "id": "S8",
      "name": "FullReset",
      "conditions": [
        "window.__3D_STATE__.runningCount === 0",
        "window.__3D_STATE__.beakers.every(b => b.phase === 0 && b.amplitude === 0 && b.concentration === 1.0)"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Start All"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beakers === 'object' && Array.isArray(window.__3D_STATE__.beakers) && window.__3D_STATE__.beakers.length === 4",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].running === true && window.__3D_STATE__.beakers[1].running === true && window.__3D_STATE__.beakers[2].running === true && window.__3D_STATE__.beakers[3].running === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.runningCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'start_all'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => typeof b.phase === 'number' && !isNaN(b.phase) && isFinite(b.phase))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beakers[0].phase > 0.5 && window.__3D_STATE__.beakers[0].phase < 2 * Math.PI",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 2.5 && window.__3D_STATE__.elapsedTime <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => b.amplitude >= 0 && b.amplitude <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers.every(b => typeof b.colorHex === 'string' && b.colorHex.startsWith('#'))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beakers[0].stirRodAngle > 0 && !isNaN(window.__3D_STATE__.beakers[0].stirRodAngle)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
