      "locator_hints": [
        "golden color",
        "position (4, 0.16, 4)"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.gameState === 'playing'",
        "Math.abs(window.__3D_STATE__.marbleX - (-4)) < 0.5",
        "Math.abs(window.__3D_STATE__.marbleZ - (-4)) < 0.5",
        "window.__3D_STATE__.tiltX === 0",
        "window.__3D_STATE__.tiltZ === 0",
        "window.__3D_STATE__.resetCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "HorseLoaded",
      "conditions": [
        "window.__3D_STATE__.horseLoaded === true"
      ]
    },
    {
      "id": "S2",
      "name": "BoardTiltedRight",
      "conditions": [
        "window.__3D_STATE__.tiltZ > 0.01",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S3",
      "name": "MarbleMoving",
      "conditions": [
        "Math.abs(window.__3D_STATE__.marbleVX) > 0.001 || Math.abs(window.__3D_STATE__.marbleVZ) > 0.001",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S4",
      "name": "BoardTiltedForward",
      "conditions": [
        "window.__3D_STATE__.tiltX > 0.01",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S5",
      "name": "MarbleFellInHole",
      "conditions": [
        "window.__3D_STATE__.gameState === 'lost'"
      ]
    },
    {
      "id": "S6",
      "name": "GameReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "window.__3D_STATE__.gameState === 'playing'",
        "Math.abs(window.__3D_STATE__.tiltX) < 0.01",
        "Math.abs(window.__3D_STATE__.tiltZ) < 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "MarbleNearGoal",
      "conditions": [
        "Math.sqrt(Math.pow(window.__3D_STATE__.marbleX - 4, 2) + Math.pow(window.__3D_STATE__.marbleZ - 4, 2)) < 2.0",
        "window.__3D_STATE__.gameState === 'playing'"
      ]
    },
    {
      "id": "S8",
      "name": "GameWon",
      "conditions": [
        "window.__3D_STATE__.gameState === 'won'"
      ]
    },
    {
      "id": "S9",
      "name": "TiltAtMax",
      "conditions": [
        "Math.abs(window.__3D_STATE__.tiltX) >= window.__3D_STATE__.maxTilt - 0.01 || Math.abs(window.__3D_STATE__.tiltZ) >= window.__3D_STATE__.maxTilt - 0.01"
      ]
    }
