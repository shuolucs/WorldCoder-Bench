    {
      "id": "A1",
      "name": "Marble",
      "type": "3d_object",
      "semantic": "The rolling marble sphere the player controls via tilting",
      "locator_hints": [
        "sphereGeometry radius 0.3",
        "color #4488FF",
        "metalness 0.8"
      ]
    },
    {
      "id": "A2",
      "name": "MazeBoard",
      "type": "3d_object",
