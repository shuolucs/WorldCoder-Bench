        "color #8B7355"
      ]
    },
    {
      "id": "A3",
      "name": "HorseTrophy",
      "type": "3d_object",
      "semantic": "The horse.glb model at the goal position",
      "locator_hints": [
        "loaded via GLTFLoader",
        "position near (4, 0.5, 4)"
      ]
    },
    {
      "id": "A4",
      "name": "TrapHoles",
      "type": "3d_object",
