      "conditions": [
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
