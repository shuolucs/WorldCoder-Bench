  "states": [
    {
      "id": "S0",
      "name": "Initial_TwoPlayer_Normal",
      "conditions": [
        "window.__3D_STATE__.playerCount === 2",
        "window.__3D_STATE__.filters[0] === 'normal'",
        "window.__3D_STATE__.filters[1] === 'normal'",
        "window.__3D_STATE__.severity === 1.0",
        "window.__3D_STATE__.compareMode === false",
        "window.__3D_STATE__.undoStackSize === 0"
      ]
    },
    {
      "id": "S1",
      "name": "P1_Protanopia_Applied",
      "conditions": [
        "window.__3D_STATE__.filters[0] === 'protanopia'",
        "window.__3D_STATE__.undoStackSize >= 1"
      ]
    },
    {
      "id": "S2",
      "name": "P2_Deuteranopia_Applied",
      "conditions": [
        "window.__3D_STATE__.filters[0] === 'protanopia'",
        "window.__3D_STATE__.filters[1] === 'deuteranopia'",
        "window.__3D_STATE__.undoStackSize >= 2"
      ]
    },
    {
