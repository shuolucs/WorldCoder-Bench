    {
      "id": "S0",
      "name": "Initial_Morning",
      "conditions": [
        "window.__3D_STATE__.sceneReady === true",
        "window.__3D_STATE__.hour === 9",
        "window.__3D_STATE__.season === 'summer'",
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.isNight === false"
      ]
    },
    {
      "id": "S1",
      "name": "Stepped_Forward",
      "conditions": [
        "window.__3D_STATE__.hour === 10",
        "window.__3D_STATE__.isNight === false"
      ]
    },
    {
      "id": "S2",
      "name": "Stepped_Backward",
      "conditions": [
        "window.__3D_STATE__.hour === 9",
        "window.__3D_STATE__.undoStackSize >= 2"
      ]
    },
    {
      "id": "S3",
      "name": "Night_Time",
      "conditions": [
        "window.__3D_STATE__.isNight === true",
        "window.__3D_STATE__.lightIntensity === 0"
      ]
    },
    {
      "id": "S4",
      "name": "Season_Changed_Winter",
      "conditions": [
        "window.__3D_STATE__.season === 'winter'",
        "window.__3D_STATE__.seasonMultiplier === 0.6"
      ]
    },
    {
      "id": "S5",
      "name": "Undo_Applied",
      "conditions": [
        "window.__3D_STATE__.season === 'summer'",
        "window.__3D_STATE__.redoStackSize >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "Redo_Applied",
      "conditions": [
        "window.__3D_STATE__.season === 'winter'",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Playing",
