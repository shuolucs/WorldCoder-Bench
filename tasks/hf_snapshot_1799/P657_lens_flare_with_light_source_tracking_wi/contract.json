      "conditions": [
        "window.__3D_STATE__.lightPositions[2][1] !== 15"
      ]
    },
    {
      "id": "S9",
      "name": "SceneReset",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'reset'",
        "window.__3D_STATE__.flareEnabled === true",
        "window.__3D_STATE__.flareMultiplier === 1.0"
      ]
    }
