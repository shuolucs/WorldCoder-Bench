      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.lightPositions) && window.__3D_STATE__.lightPositions.length === 3",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.flareVisibilities) && window.__3D_STATE__.flareVisibilities.length === 3",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightPositions[0][0] === -8 && window.__3D_STATE__.lightPositions[0][1] === 10 && window.__3D_STATE__.lightPositions[0][2] === 5",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.flareVisibilities[0]) && window.__3D_STATE__.flareVisibilities[0] >= 0 && window.__3D_STATE__.flareVisibilities[0] <= 1",
            "tier": "L2"
