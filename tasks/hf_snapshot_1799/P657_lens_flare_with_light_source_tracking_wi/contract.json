  "states": [
    {
      "id": "S0",
      "name": "InitialScene",
      "conditions": [
        "window.__3D_STATE__.selectedLightIndex === 0",
        "window.__3D_STATE__.flareEnabled === true",
        "window.__3D_STATE__.flareMultiplier === 1.0",
        "window.__3D_STATE__.savedStateExists === false",
        "window.__3D_STATE__.sphereCount === 5"
      ]
    },
    {
      "id": "S1",
      "name": "LightBSelected",
      "conditions": [
        "window.__3D_STATE__.selectedLightIndex === 1"
      ]
    },
    {
      "id": "S2",
      "name": "LightBMoved",
      "conditions": [
        "window.__3D_STATE__.selectedLightIndex === 1",
        "window.__3D_STATE__.lightPositions[1][0] !== 8"
      ]
    },
    {
      "id": "S3",
      "name": "FlareMultiplierChanged",
      "conditions": [
        "window.__3D_STATE__.flareMultiplier !== 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "FlaresDisabled",
      "conditions": [
        "window.__3D_STATE__.flareEnabled === false"
      ]
    },
    {
      "id": "S5",
      "name": "StateSaved",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true",
        "window.__3D_STATE__.lastAction === 'save'"
      ]
    },
    {
      "id": "S6",
      "name": "SceneModifiedAfterSave",
      "conditions": [
        "window.__3D_STATE__.savedStateExists === true",
        "window.__3D_STATE__.selectedLightIndex === 2"
      ]
    },
    {
      "id": "S7",
      "name": "StateLoaded",
      "conditions": [
        "window.__3D_STATE__.lastAction === 'load'"
      ]
    },
    {
      "id": "S8",
