  "states": [
    {
      "id": "S0",
      "name": "Initial_Playing",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.speed === 1.0",
        "window.__3D_STATE__.stride === 0.6",
        "window.__3D_STATE__.style === 'normal'"
      ]
    },
    {
      "id": "S1",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed !== 1.0",
        "window.__3D_STATE__.isPlaying === true"
      ]
    },
    {
      "id": "S3",
      "name": "StrideChanged",
      "conditions": [
        "window.__3D_STATE__.stride !== 0.6"
      ]
    },
    {
      "id": "S4",
      "name": "MarchStyle",
      "conditions": [
        "window.__3D_STATE__.style === 'march'"
      ]
    },
    {
      "id": "S5",
      "name": "SneakStyle",
      "conditions": [
        "window.__3D_STATE__.style === 'sneak'"
      ]
    },
    {
      "id": "S6",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.characterX === 0",
        "window.__3D_STATE__.cyclePhase === 0"
      ]
    },
    {
      "id": "S7",
      "name": "Resumed",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.frameCount > 0"
      ]
    }
  ],
