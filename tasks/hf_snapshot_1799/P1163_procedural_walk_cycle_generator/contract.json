    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.leftLegAngle === 'number' && !isNaN(window.__3D_STATE__.leftLegAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.rightLegAngle === 'number' && !isNaN(window.__3D_STATE__.rightLegAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 30",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.leftLegAngle + window.__3D_STATE__.rightLegAngle) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
