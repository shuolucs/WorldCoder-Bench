  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.totalScore === 100",
        "window.__3D_STATE__.selectedCategory === null",
        "window.__3D_STATE__.isSorted === false",
        "window.__3D_STATE__.boostCount === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SalesSelected",
      "conditions": [
        "window.__3D_STATE__.selectedCategory === 'Sales'",
        "window.__3D_STATE__.scores.Sales === 25"
      ]
    },
    {
      "id": "S2",
      "name": "SalesBoosted",
      "conditions": [
        "window.__3D_STATE__.selectedCategory === 'Sales'",
        "window.__3D_STATE__.barData.Sales[0] === 5",
        "window.__3D_STATE__.barData.Sales[1] === 7",
        "window.__3D_STATE__.barData.Sales[2] === 6",
        "window.__3D_STATE__.scores.Sales === 37",
        "window.__3D_STATE__.boostCount === 1"
      ]
    },
    {
      "id": "S3",
      "name": "ScoresUpdatedAfterBoost",
      "conditions": [
        "window.__3D_STATE__.totalScore === 112",
        "window.__3D_STATE__.topCategory === 'Sales'"
      ]
    },
    {
      "id": "S4",
      "name": "EngineeringSelectedViaKey",
      "conditions": [
        "window.__3D_STATE__.selectedCategory === 'Engineering'",
        "window.__3D_STATE__.scores.Engineering === 28"
      ]
    },
    {
      "id": "S5",
      "name": "SortedView",
