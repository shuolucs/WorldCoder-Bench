  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.autoRotate === true",
        "window.__3D_STATE__.heatmapMode === false",
        "window.__3D_STATE__.sortingActive === false",
        "window.__3D_STATE__.selectedBar === null",
        "window.__3D_STATE__.globeRadius === 1.0",
        "window.__3D_STATE__.visibleBars === 40"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstDifficultyIncrease",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 2",
        "window.__3D_STATE__.visibleBars === 80",
        "window.__3D_STATE__.rotationSpeed === 0.004"
      ]
    },
    {
      "id": "S2",
      "name": "AfterSecondDifficultyIncrease",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 3",
        "window.__3D_STATE__.visibleBars === 120",
        "window.__3D_STATE__.rotationSpeed === 0.006"
      ]
    },
    {
      "id": "S3",
      "name": "AutoRotateDisabled",
      "conditions": [
        "window.__3D_STATE__.autoRotate === false",
        "window.__3D_STATE__.rotationSpeed === 0"
      ]
    },
    {
      "id": "S4",
      "name": "HeatmapEnabled",
      "conditions": [
        "window.__3D_STATE__.heatmapMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "DifficultyLevel4WithParticles",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 4",
        "window.__3D_STATE__.visibleBars === 160",
        "window.__3D_STATE__.particlesActive === true"
      ]
    },
    {
      "id": "S6",
      "name": "DifficultyLevel5MaxComplexity",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 5",
        "window.__3D_STATE__.visibleBars >= 200",
        "window.__3D_STATE__.particlesActive === true",
        "window.__3D_STATE__.rotationSpeed === 0.01"
      ]
    },
    {
      "id": "S7",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraDistance - 3.5) < 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "DifficultyWrappedToLevel1",
      "conditions": [
        "window.__3D_STATE__.difficultyLevel === 1",
        "window.__3D_STATE__.visibleBars === 40",
        "window.__3D_STATE__.particlesActive === false"
      ]
    },
    {
      "id": "S9",
      "name": "SortingAnimationActive",
      "conditions": [
        "window.__3D_STATE__.sortingActive === true"
      ]
    }
  ],
