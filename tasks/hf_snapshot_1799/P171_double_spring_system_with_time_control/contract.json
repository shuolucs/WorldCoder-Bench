{
  "task_id": "P171_double_spring_system_with_time_control",
  "affordances": [
    {
      "id": "A1",
      "name": "Anchor",
      "type": "3d_object",
      "semantic": "Fixed red sphere anchor point at top of spring chain",
      "locator_hints": [
        "red sphere at (-4, 6, 0)"
      ]
    },
    {
      "id": "A2",
      "name": "MassA",
      "type": "3d_object",
      "semantic": "Blue sphere mass connected to anchor by spring 1",
      "locator_hints": [
        "blue sphere, initially at (-4, 4, 0)"
      ]
    },
    {
      "id": "A3",
      "name": "MassB",
      "type": "3d_object",
      "semantic": "Green sphere mass connected to Mass A by spring 2",
      "locator_hints": [
        "green sphere, initially at (-4, 2, 0)"
      ]
    },
    {
      "id": "A4",
      "name": "PauseButton",
      "type": "dom_element",
      "semantic": "Pause/Resume toggle button",
      "locator_hints": [
        "#btn-pause"
      ]
    },
    {
      "id": "A5",
      "name": "SlowMotionButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 0.25",
      "locator_hints": [
        "#btn-slow"
      ]
    },
    {
      "id": "A6",
      "name": "NormalSpeedButton",
      "type": "dom_element",
      "semantic": "Sets time scale to 1.0",
      "locator_hints": [
        "#btn-normal"
      ]
    },
    {
      "id": "A7",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Resets system to initial state",
      "locator_hints": [
        "#btn-reset"
      ]
    },
    {
      "id": "A8",
      "name": "MichelleModel",
      "type": "3d_object",
      "semantic": "Michelle.glb spectator model",
      "locator_hints": [
        "GLTF model at (0, 0, -3)"
      ]
    },
    {
      "id": "A9",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation data",
      "locator_hints": [
        "#hud"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.timeScale === 1.0",
        "window.__3D_STATE__.resetCount === 0",
        "window.__3D_STATE__.impulseAppliedA === 0"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S3",
      "name": "SlowMotion",
      "conditions": [
        "window.__3D_STATE__.timeScale === 0.25",
        "window.__3D_STATE__.paused === false"
      ]
    },
    {
      "id": "S4",
      "name": "ImpulseAppliedToA",
      "conditions": [
        "window.__3D_STATE__.impulseAppliedA >= 1"
      ]
    },
    {
      "id": "S5",
      "name": "ImpulseAppliedToB",
      "conditions": [
        "window.__3D_STATE__.impulseAppliedB >= 1"
      ]
    },
    {
      "id": "S6",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.resetCount >= 1",
        "Math.abs(window.__3D_STATE__.massA_y - 4.0) < 0.5",
        "Math.abs(window.__3D_STATE__.massB_y - 2.0) < 0.5"
      ]
    },
    {
      "id": "S7",
      "name": "ResumedAfterPause",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simTime > 0"
      ]
    }
  ],
