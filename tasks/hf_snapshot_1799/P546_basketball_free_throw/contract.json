{
  "task_id": "P546_basketball_free_throw",
  "affordances": [
    {"id": "A1", "name": "Basketball", "type": "3d_object", "semantic": "Orange basketball sphere", "locator_hints": ["sphere mesh orange"]},
    {"id": "A2", "name": "Hoop", "type": "3d_object", "semantic": "Rim torus, backboard box, net lines, pole", "locator_hints": ["torus mesh", "box mesh white"]},
    {"id": "A3", "name": "Net", "type": "3d_object", "semantic": "Spring-mass net chains", "locator_hints": ["line segments below rim"]},
    {"id": "A4", "name": "AngleSlider", "type": "dom_element", "semantic": "Launch angle control", "locator_hints": ["#slider-angle"]},
    {"id": "A5", "name": "SpeedSlider", "type": "dom_element", "semantic": "Launch speed control", "locator_hints": ["#slider-speed"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Ready", "conditions": ["window.__3D_STATE__.status === 'Ready'"]},
    {"id": "S1", "name": "Flying", "conditions": ["window.__3D_STATE__.status === 'Flying'"]},
    {"id": "S2", "name": "Landed", "conditions": ["window.__3D_STATE__.status === 'Scored!' || window.__3D_STATE__.status === 'Missed'"]},
    {"id": "S3", "name": "ResetReady", "conditions": ["window.__3D_STATE__.status === 'Ready' && window.__3D_STATE__.attempts > 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 500},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.status === 'Ready'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.score === 0 && window.__3D_STATE__.attempts === 0", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballValid === true", "tier": "L0"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Flying'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.attempts === 1", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballSpeed > 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 4000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Scored!' || window.__3D_STATE__.status === 'Missed'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.ballValid === true", "tier": "L0"},
        {"expr": "window.__3D_STATE__.ballHeight >= 0 || window.__3D_STATE__.ballHeight > -1", "tier": "L1"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.status === 'Ready'", "tier": "L2"},
        {"expr": "window.__3D_STATE__.attempts >= 1", "tier": "L1"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S3", "severity": "P0",
      "action": {"type": "script", "code": "document.getElementById('slider-angle').value = 45; document.getElementById('slider-angle').dispatchEvent(new Event('input')); document.getElementById('slider-speed').value = 10; document.getElementById('slider-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.launchAngle === 45", "tier": "L2"},
        {"expr": "window.__3D_STATE__.launchSpeed === 10", "tier": "L2"}
      ]}
    },
    {
      "id": "T6", "from": "S3", "to": "S3", "severity": "P1",
      "action": {"type": "keyboard", "key": "t"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.attempts >= 2", "tier": "L1"},
        {"expr": "window.__3D_STATE__.ballValid === true", "tier": "L0"}
      ]}
    }
  ]
}
