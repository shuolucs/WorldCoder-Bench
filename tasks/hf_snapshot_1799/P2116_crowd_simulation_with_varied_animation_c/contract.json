  "states": [
    {
      "id": "S0",
      "name": "SceneLoaded",
      "conditions": [
        "window.__3D_STATE__.agentCount === 20",
        "window.__3D_STATE__.speedMultiplier === 1.0",
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.formation === 'grid'",
        "window.__3D_STATE__.selectedAgentIndex === -1"
      ]
    },
    {
      "id": "S1",
      "name": "AnimationRunning",
      "conditions": [
        "window.__3D_STATE__.elapsedTime > 0.5",
        "window.__3D_STATE__.frameCount > 10"
      ]
    },
    {
      "id": "S2",
      "name": "SpeedIncreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1.25"
      ]
    },
    {
      "id": "S3",
      "name": "SpeedDecreased",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 1.0"
      ]
    },
    {
      "id": "S4",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.paused === true"
      ]
    },
    {
      "id": "S5",
      "name": "Unpaused",
      "conditions": [
        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.speedMultiplier === 1.0"
      ]
    },
    {
      "id": "S6",
      "name": "AgentSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAgentIndex >= 0",
        "window.__3D_STATE__.selectedAgentIndex < 20"
      ]
    },
    {
      "id": "S7",
      "name": "PhaseCycled",
      "conditions": [
        "window.__3D_STATE__.selectedAgentIndex >= 0"
      ]
    },
    {
      "id": "S8",
      "name": "CircleFormation",
      "conditions": [
        "window.__3D_STATE__.formation === 'circle'"
      ]
    },
    {
      "id": "S9",
      "name": "GridFormationRestored",
      "conditions": [
        "window.__3D_STATE__.formation === 'grid'"
      ]
    },
    {
      "id": "S10",
      "name": "HighSpeedReached",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier >= 2.0"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
