      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.agentCount === 20",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.agents) && window.__3D_STATE__.agents.length === 20",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.phaseCounts.idle + window.__3D_STATE__.phaseCounts.walk + window.__3D_STATE__.phaseCounts.bounce === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => !isNaN(a.position.x) && !isNaN(a.position.y) && !isNaN(a.position.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0 && window.__3D_STATE__.frameCount > 0",
            "tier": "L2"
