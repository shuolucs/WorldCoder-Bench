{
  "task_id": "P2488_emission_spectrum_hydrogen_balmer_series",
  "affordances": [
    {
      "id": "A1",
      "name": "DischargeTube",
      "type": "3d_object",
      "semantic": "Hydrogen gas discharge tube that glows when powered on",
      "locator_hints": [
        "glass cylinder at y~2.5",
        "tube mesh"
      ]
    },
    {
      "id": "A2",
      "name": "Prism",
      "type": "3d_object",
      "semantic": "Triangular glass prism that disperses light",
      "locator_hints": [
        "triangular mesh at y~1.0",
        "prism"
      ]
    },
    {
      "id": "A3",
      "name": "SpectralScreen",
      "type": "3d_object",
      "semantic": "Detector screen showing spectral lines",
      "locator_hints": [
        "plane at y~-0.5",
        "screen mesh"
      ]
    },
    {
      "id": "A4",
      "name": "SpectralLines",
      "type": "3d_object",
      "semantic": "Five Balmer series emission/absorption lines on the screen",
      "locator_hints": [
        "thin vertical rectangles on screen",
        "line meshes"
      ]
    },
    {
      "id": "A5",
      "name": "PowerButton",
      "type": "dom_element",
      "semantic": "Button to toggle discharge tube on/off",
      "locator_hints": [
        "button containing 'Power'"
      ]
    },
    {
      "id": "A6",
      "name": "TemperatureSlider",
      "type": "dom_element",
      "semantic": "Slider controlling temperature from 2000-20000K",
      "locator_hints": [
        "input[type=range]",
        "slider labeled Temperature"
      ]
    },
    {
      "id": "A7",
      "name": "ModeDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to switch Emission/Absorption mode",
      "locator_hints": [
        "select element",
        "dropdown with Emission/Absorption"
      ]
    },
    {
      "id": "A8",
      "name": "InfoPanel",
      "type": "dom_element",
      "semantic": "HUD panel showing selected line details",
      "locator_hints": [
        "top-right panel",
        "info panel div"
      ]
    },
    {
      "id": "A9",
      "name": "StatusPanel",
      "type": "dom_element",
      "semantic": "Bottom-left panel showing mode, temperature, tube status",
      "locator_hints": [
        "bottom-left panel",
        "status div"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_PowerOff",
      "conditions": [
        "window.__3D_STATE__.tubeOn === false",
        "window.__3D_STATE__.mode === 'emission'",
        "window.__3D_STATE__.temperature === 10000",
        "window.__3D_STATE__.selectedLine === null"
      ]
    },
    {
      "id": "S1",
      "name": "TubePoweredOn",
      "conditions": [
        "window.__3D_STATE__.tubeOn === true",
        "window.__3D_STATE__.tubeGlowIntensity > 0",
        "window.__3D_STATE__.prismActive === true"
      ]
    },
    {
      "id": "S2",
      "name": "LineSelected_HAlpha",
      "conditions": [
        "window.__3D_STATE__.selectedLine === 'H-alpha'",
        "window.__3D_STATE__.infoPanel.name === 'H-alpha'"
      ]
    },
    {
      "id": "S3",
      "name": "TemperatureChanged",
      "conditions": [
        "window.__3D_STATE__.temperature !== 10000"
      ]
    },
    {
      "id": "S4",
      "name": "AbsorptionMode",
      "conditions": [
        "window.__3D_STATE__.mode === 'absorption'"
      ]
    },
    {
      "id": "S5",
      "name": "LineSelected_HGamma",
      "conditions": [
        "window.__3D_STATE__.selectedLine === 'H-gamma'",
        "window.__3D_STATE__.infoPanel.name === 'H-gamma'"
      ]
    },
    {
      "id": "S6",
      "name": "LowTemperature",
      "conditions": [
        "window.__3D_STATE__.temperature === 2000"
      ]
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.tubeOn === false",
        "window.__3D_STATE__.temperature === 10000",
        "window.__3D_STATE__.selectedLine === null",
        "window.__3D_STATE__.mode === 'emission'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "description": "Click Power On button to activate discharge tube"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.tubeOn === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tubeOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tubeGlowIntensity > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.prismActive === true",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.lines) && window.__3D_STATE__.lines.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => l.visible === true)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* verify Rydberg formula accuracy for all lines */"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.lines.find(l => l.name === 'H-alpha').wavelength_nm - 656.3) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lines.find(l => l.name === 'H-beta').wavelength_nm - 486.1) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lines.find(l => l.name === 'H-gamma').wavelength_nm - 434.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lines.find(l => l.name === 'H-delta').wavelength_nm - 410.2) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lines.find(l => l.name === 'H-epsilon').wavelength_nm - 397.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => !isNaN(l.wavelength_nm) && !isNaN(l.frequency_THz) && !isNaN(l.energy_eV))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "1",
        "description": "Press '1' to select H-alpha line"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLine === 'H-alpha'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.infoPanel.name === 'H-alpha'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.infoPanel.wavelength - 656.3) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.infoPanel.transition === 'n=3 → n=2' || window.__3D_STATE__.infoPanel.transition.includes('3')",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.infoPanel.energy === 'number' && window.__3D_STATE__.infoPanel.energy > 1.8 && window.__3D_STATE__.infoPanel.energy < 2.0",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3",
        "description": "Press '3' to select H-gamma line"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedLine === 'H-gamma'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.infoPanel.name === 'H-gamma'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.infoPanel.wavelength - 434.0) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.infoPanel.frequency === 'number' && window.__3D_STATE__.infoPanel.frequency > 690 && window.__3D_STATE__.infoPanel.frequency < 692",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lines.find(l => l.name === 'H-gamma').n_upper === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range]').value = 5000; document.querySelector('input[type=range]').dispatchEvent(new Event('input', {bubbles:true}));",
        "description": "Set temperature slider to 5000K"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 5000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.some(l => l.intensity > 0 && l.intensity <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.filter(l => l.intensity === 1.0).length >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => l.intensity >= 0 && l.intensity <= 1.0 && !isNaN(l.intensity))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.find(l => l.name === 'H-alpha').intensity >= window.__3D_STATE__.lines.find(l => l.name === 'H-epsilon').intensity",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range]').value = 2000; document.querySelector('input[type=range]').dispatchEvent(new Event('input', {bubbles:true}));",
        "description": "Set temperature to minimum 2000K to test intensity falloff"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature === 2000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.find(l => l.name === 'H-alpha').intensity > window.__3D_STATE__.lines.find(l => l.name === 'H-delta').intensity",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => l.intensity >= 0 && l.intensity <= 1.0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.find(l => l.name === 'H-epsilon').intensity < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.filter(l => l.intensity === 1.0).length === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "var sel = document.querySelector('select'); sel.value = 'absorption'; sel.dispatchEvent(new Event('change', {bubbles:true}));",
        "description": "Switch to Absorption mode via dropdown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.mode === 'absorption'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tubeOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => l.visible === true)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.mode === 'string'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S4",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "/* verify line ordering on screen: red (H-alpha) leftmost, violet (H-epsilon) rightmost */"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Array.isArray(window.__3D_STATE__.linePositions) && window.__3D_STATE__.linePositions.length === 5",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.linePositions.find(p => p.name === 'H-alpha').screenX < window.__3D_STATE__.linePositions.find(p => p.name === 'H-beta').screenX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.linePositions.find(p => p.name === 'H-beta').screenX < window.__3D_STATE__.linePositions.find(p => p.name === 'H-gamma').screenX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.linePositions.find(p => p.name === 'H-gamma').screenX < window.__3D_STATE__.linePositions.find(p => p.name === 'H-delta').screenX",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.linePositions.find(p => p.name === 'H-delta').screenX < window.__3D_STATE__.linePositions.find(p => p.name === 'H-epsilon').screenX",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S4",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r",
        "description": "Press R to reset entire scene to initial state"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tubeOn === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 10000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedLine === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'emission'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.resetCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tubeGlowIntensity === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S7",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "description": "Power on again after reset to verify full re-initialization"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tubeOn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => l.visible === true)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature === 10000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mode === 'emission'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lines.every(l => !isNaN(l.energy_eV) && l.energy_eV > 0)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}