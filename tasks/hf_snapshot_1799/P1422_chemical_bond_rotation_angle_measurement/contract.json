  "states": [
    {
      "id": "S0",
      "name": "InitialState",
      "conditions": [
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.attempts === 0",
        "window.__3D_STATE__.measurementVisible === false",
        "window.__3D_STATE__.snapping === true"
      ]
    },
    {
      "id": "S1",
      "name": "AfterRightArrowRotation",
      "conditions": [
        "Math.abs(window.__3D_STATE__.dihedralAngle) > 0",
        "window.__3D_STATE__.snapping === true"
      ]
    },
    {
      "id": "S2",
      "name": "DifficultyMedium",
      "conditions": [
        "window.__3D_STATE__.difficulty === 2",
        "window.__3D_STATE__.tolerance === 5",
        "window.__3D_STATE__.snapping === false"
      ]
    },
    {
      "id": "S3",
      "name": "DifficultyHard",
      "conditions": [
        "window.__3D_STATE__.difficulty === 3",
        "window.__3D_STATE__.tolerance === 2",
        "window.__3D_STATE__.perturbationsActive === true"
      ]
    },
    {
      "id": "S4",
      "name": "NewTargetGenerated",
      "conditions": [
        "window.__3D_STATE__.attempts >= 1",
        "typeof window.__3D_STATE__.targetAngle === 'number'"
      ]
    },
    {
      "id": "S5",
      "name": "MeasurementOverlayVisible",
      "conditions": [
        "window.__3D_STATE__.measurementVisible === true"
      ]
    },
    {
      "id": "S6",
      "name": "MeasurementOverlayHidden",
      "conditions": [
        "window.__3D_STATE__.measurementVisible === false"
      ]
    },
    {
      "id": "S7",
      "name": "AfterReset",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.attempts === 0"
      ]
    },
    {
      "id": "S8",
      "name": "BondLengthPreservedAfterRotation",
      "conditions": [
        "Math.abs(window.__3D_STATE__.bondLengthCD - 2.236) < 0.05"
      ]
    },
    {
      "id": "S9",
      "name": "BackToEasyDifficulty",
      "conditions": [
        "window.__3D_STATE__.difficulty === 1",
        "window.__3D_STATE__.snapping === true",
        "window.__3D_STATE__.perturbationsActive === false"
      ]
    }
  ],
