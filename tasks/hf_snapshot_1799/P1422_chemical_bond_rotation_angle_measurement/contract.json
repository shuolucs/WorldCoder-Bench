            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.difficulty === 1 && window.__3D_STATE__.tolerance === 10 && window.__3D_STATE__.snapping === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.score === 0 && window.__3D_STATE__.attempts === 0 && window.__3D_STATE__.measurementVisible === false",
            "tier": "L2"
