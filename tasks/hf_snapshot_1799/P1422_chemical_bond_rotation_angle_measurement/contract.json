      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.dihedralAngle === 'number' && !isNaN(window.__3D_STATE__.dihedralAngle)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.targetAngle === 'number' && !isNaN(window.__3D_STATE__.targetAngle)",
            "tier": "L0"
          },
          {
