  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.playbackState === 'idle'",
        "window.__3D_STATE__.totalQueries === 0",
        "window.__3D_STATE__.bestMatchId === null",
        "window.__3D_STATE__.activeClipCount === 12"
      ]
    },
    {
      "id": "S1",
      "name": "QueryMarkerMoved",
      "conditions": [
        "window.__3D_STATE__.queryPosition.x !== 0 || window.__3D_STATE__.queryPosition.z !== 0"
      ]
    },
    {
      "id": "S2",
      "name": "QueryPerformed",
      "conditions": [
        "window.__3D_STATE__.totalQueries >= 1",
        "window.__3D_STATE__.bestMatchId !== null",
        "window.__3D_STATE__.rankings.length > 0"
      ]
    },
    {
      "id": "S3",
      "name": "CategoryFiltered",
      "conditions": [
        "window.__3D_STATE__.activeCategories.length < 4",
        "window.__3D_STATE__.activeClipCount < 12"
      ]
    },
    {
      "id": "S4",
      "name": "FilteredQueryPerformed",
      "conditions": [
        "window.__3D_STATE__.totalQueries >= 2",
        "window.__3D_STATE__.rankings.length < 12"
      ]
    },
    {
      "id": "S5",
      "name": "PlaybackActive",
      "conditions": [
        "window.__3D_STATE__.playbackState === 'playing'",
        "window.__3D_STATE__.playbackProgress > 0"
      ]
    },
    {
      "id": "S6",
      "name": "SpeedAdjusted",
      "conditions": [
        "window.__3D_STATE__.playbackSpeed !== 1"
      ]
    },
    {
      "id": "S7",
      "name": "FiltersReset",
      "conditions": [
        "window.__3D_STATE__.activeCategories.length === 4",
        "window.__3D_STATE__.activeClipCount === 12"
      ]
    },
    {
      "id": "S8",
      "name": "SecondPositionQuery",
      "conditions": [
        "window.__3D_STATE__.totalQueries >= 3"
      ]
    },
    {
      "id": "S9",
      "name": "PlaybackComplete",
      "conditions": [
        "window.__3D_STATE__.playbackState === 'idle'",
        "window.__3D_STATE__.playbackProgress >= 99"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.queryPosition === 'object' && typeof window.__3D_STATE__.queryPosition.x === 'number' && typeof window.__3D_STATE__.queryPosition.z === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.clipData) && window.__3D_STATE__.clipData.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.playbackState === 'idle' && window.__3D_STATE__.totalQueries === 0 && window.__3D_STATE__.bestMatchId === null",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.frameCount)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeClipCount === 12 && window.__3D_STATE__.activeCategories.length === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "d",
        "repeat": 30,
        "delay_ms": 50
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.queryPosition.x > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.queryPosition.z) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queryPosition.x <= 8.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.queryPosition.x) && !isNaN(window.__3D_STATE__.queryPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackState === 'idle'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalQueries === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestMatchId !== null && typeof window.__3D_STATE__.bestMatchId === 'number' && window.__3D_STATE__.bestMatchId >= 0 && window.__3D_STATE__.bestMatchId <= 11",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bestMatchScore === 'number' && window.__3D_STATE__.bestMatchScore >= 0 && !isNaN(window.__3D_STATE__.bestMatchScore)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.rankings) && window.__3D_STATE__.rankings.length === 12",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rankings[0].score <= window.__3D_STATE__.rankings[1].score",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings[0].clipId === window.__3D_STATE__.bestMatchId",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_content_match": "Jump"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeCategories.indexOf('jump') === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCategories.length === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterStates.jump === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterStates.walk === true && window.__3D_STATE__.filterStates.run === true && window.__3D_STATE__.filterStates.turn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeClipCount < 12 && window.__3D_STATE__.activeClipCount > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalQueries === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings.length === window.__3D_STATE__.activeClipCount",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings.length < 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings.every(function(r){ return window.__3D_STATE__.clipData[r.clipId].category !== 'jump'; })",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings[0].score <= window.__3D_STATE__.rankings[window.__3D_STATE__.rankings.length - 1].score",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_content_match": "Play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playbackState === 'playing' || window.__3D_STATE__.playbackState === 'scanning'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.playbackProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.playbackProgress >= 0 && window.__3D_STATE__.playbackProgress <= 100",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playbackProgress)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestMatchId !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "document.querySelector('input[type=range]').value = 2.5; document.querySelector('input[type=range]').dispatchEvent(new Event('input', {bubbles:true}));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.playbackSpeed >= 2.0 && window.__3D_STATE__.playbackSpeed <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed !== 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.playbackSpeed)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.playbackSpeed >= 0.25 && window.__3D_STATE__.playbackSpeed <= 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_content_match": "Reset"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeCategories.length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterStates.walk === true && window.__3D_STATE__.filterStates.run === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.filterStates.jump === true && window.__3D_STATE__.filterStates.turn === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeClipCount === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeCategories.indexOf('jump') !== -1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "w",
        "repeat": 40,
        "delay_ms": 50
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.queryPosition.z > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queryPosition.z <= 8.0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.queryPosition.x) && !isNaN(window.__3D_STATE__.queryPosition.z)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.queryPosition.x > 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalQueries === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings.length === 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bestMatchScore >= 0 && !isNaN(window.__3D_STATE__.bestMatchScore)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.rankings[0].score === window.__3D_STATE__.bestMatchScore",
            "tier": "L2"
          },
          {
            "expr": "(function(){ var r = window.__3D_STATE__.rankings; for(var i=0;i<r.length-1;i++){if(r[i].score > r[i+1].score) return false;} return true; })()",
            "tier": "L2"
          }
