{
  "task_id": "P289_molecular_dynamics_viewer",
  "affordances": [
    {
      "id": "A1",
      "name": "BoundingBox",
      "type": "3d_object",
      "semantic": "Wireframe box defining simulation boundaries",
      "locator_hints": [
        "EdgesGeometry wireframe",
        "30x30x30 box at origin"
      ]
    },
    {
      "id": "A2",
      "name": "Atoms",
      "type": "3d_object",
      "semantic": "20 colored spheres representing atoms",
      "locator_hints": [
        "SphereGeometry radius 0.8",
        "mesh children in scene"
      ]
    },
    {
      "id": "A3",
      "name": "Bonds",
      "type": "3d_object",
      "semantic": "LineSegments connecting nearby atoms",
      "locator_hints": [
        "LineSegments with BufferGeometry"
      ]
    },
    {
      "id": "A4",
      "name": "FlamingoModel",
      "type": "3d_object",
      "semantic": "Loaded GLB model as decorative marker",
      "locator_hints": [
        "flamingo.glb",
        "position (0,18,0)",
        "scale 0.02"
      ]
    },
    {
      "id": "A5",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Top-left info display",
      "locator_hints": [
        "#hud"
      ]
    },
    {
      "id": "A6",
      "name": "StatusDisplay",
      "type": "dom_element",
      "semantic": "Running/Paused status indicator",
      "locator_hints": [
        "#status"
      ]
    },
    {
      "id": "A7",
      "name": "SelectionInfo",
      "type": "dom_element",
      "semantic": "Bottom-left selection display",
      "locator_hints": [
        "#selection-info"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.atomCount === 20",
        "window.__3D_STATE__.selectedAtom === -1",
        "window.__3D_STATE__.bondsVisible === true",
        "window.__3D_STATE__.highlightMode === false",
        "window.__3D_STATE__.displayMode === 'kinetic'"
      ]
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime > 0"
      ]
    },
    {
      "id": "S2",
      "name": "SimulationAdvanced",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.simTime > 30"
      ]
    },
    {
      "id": "S3",
      "name": "SimPausedAfterRun",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.simTime > 30"
      ]
    },
    {
      "id": "S4",
      "name": "HighlightOn",
      "conditions": [
        "window.__3D_STATE__.highlightMode === true"
      ]
    },
    {
      "id": "S5",
      "name": "BondsHidden",
      "conditions": [
        "window.__3D_STATE__.bondsVisible === false"
      ]
    },
    {
      "id": "S6",
      "name": "DisplayModeCycled",
      "conditions": [
        "window.__3D_STATE__.displayMode !== 'kinetic'"
      ]
    },
    {
      "id": "S7",
      "name": "AtomSelected",
      "conditions": [
        "window.__3D_STATE__.selectedAtom >= 0",
        "window.__3D_STATE__.selectedAtom < 20"
      ]
    },
    {
      "id": "S8",
      "name": "AtomFrozen",
      "conditions": [
        "window.__3D_STATE__.frozenAtoms.length > 0"
      ]
    },
    {
      "id": "S9",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.simTime === 0",
        "window.__3D_STATE__.atomCount === 20"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.atomCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.every(p => Math.abs(p.x) <= 15.5 && Math.abs(p.y) <= 15.5 && Math.abs(p.z) <= 15.5)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalKE >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 0",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalKE)",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.temperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomsInsideBounds === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.every(p => !isNaN(p.x) && !isNaN(p.y) && !isNaN(p.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomVelocities.every(v => !isNaN(v.x) && !isNaN(v.y) && !isNaN(v.z))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bondCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('status') !== null",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "h"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.highlightMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "b"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bondsVisible === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.highlightMode === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.displayMode !== 'kinetic'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.displayMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "['potential', 'total'].includes(window.__3D_STATE__.displayMode)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "window.__3D_STATE__.selectedAtom = 0;"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedAtom === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom >= 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.selectedAtom < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "f"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.frozenAtoms.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frozenAtoms.includes(window.__3D_STATE__.selectedAtom)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomVelocities[window.__3D_STATE__.selectedAtom].x === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomVelocities[window.__3D_STATE__.selectedAtom].y === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomVelocities[window.__3D_STATE__.selectedAtom].z === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomCount === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.length === 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.atomPositions.every(p => Math.abs(p.x) <= 15 && Math.abs(p.y) <= 15 && Math.abs(p.z) <= 15)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frozenAtoms.length === 0",
            "tier": "L2"
          }
        ]
      }
