      "id": "S8",
      "name": "WrongAnswer",
      "conditions": [
        "window.__3D_STATE__.wrongAnswers >= 1",
        "window.__3D_STATE__.combo === 1"
      ]
    },
    {
      "id": "S9",
      "name": "CameraReset",
      "conditions": [
        "Math.abs(window.__3D_STATE__.cameraPosition.x - 0) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.y - 5) < 1.0",
        "Math.abs(window.__3D_STATE__.cameraPosition.z - 20) < 1.0"
      ]
    },
    {
      "id": "S10",
      "name": "QuizModeDeactivated",
      "conditions": [
        "window.__3D_STATE__.quizMode === false"
      ]
    }
