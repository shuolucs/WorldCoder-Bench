  "states": [
    {
      "id": "S0",
      "name": "InitialDefaults",
      "conditions": [
        "window.__3D_STATE__.thickness === 1.0",
        "window.__3D_STATE__.threshold === 0.1",
        "window.__3D_STATE__.mixStrength === 1.0",
        "window.__3D_STATE__.detectionMode === 'combined'",
        "window.__3D_STATE__.outlineEnabled === true",
        "window.__3D_STATE__.rotationEnabled === true"
      ]
    },
    {
      "id": "S1",
      "name": "ThicknessAdjusted",
      "conditions": [
        "window.__3D_STATE__.thickness === 3.5"
      ]
    },
    {
      "id": "S2",
      "name": "ThresholdAdjusted",
      "conditions": [
        "window.__3D_STATE__.threshold === 0.5"
      ]
    },
    {
      "id": "S3",
      "name": "MixStrengthZero",
      "conditions": [
        "window.__3D_STATE__.mixStrength === 0"
      ]
    },
    {
      "id": "S4",
      "name": "DepthModeActive",
      "conditions": [
        "window.__3D_STATE__.detectionMode === 'depth'"
      ]
    },
    {
      "id": "S5",
      "name": "NormalModeActive",
      "conditions": [
        "window.__3D_STATE__.detectionMode === 'normal'"
      ]
    },
    {
      "id": "S6",
