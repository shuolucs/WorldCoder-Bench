            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.threshold >= 0 && window.__3D_STATE__.threshold <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('thresholdSlider').value === '0.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('displayThreshold') !== null && document.getElementById('displayThreshold').textContent.includes('0.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thickness === 3.5",
            "tier": "L2"
          }
        ]
      }
    },
