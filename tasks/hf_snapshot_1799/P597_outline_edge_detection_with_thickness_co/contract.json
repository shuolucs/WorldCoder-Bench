        "checks": [
          {
            "expr": "window.__3D_STATE__.thickness === 3.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thickness >= 0 && window.__3D_STATE__.thickness <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('thicknessSlider').value === '3.5'",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('displayThickness') !== null && document.getElementById('displayThickness').textContent.includes('3.5')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outlineEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
