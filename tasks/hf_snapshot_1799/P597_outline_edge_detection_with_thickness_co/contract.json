            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectionMode !== 'normal'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.outlineEnabled === true",
            "tier": "L2"
          }
