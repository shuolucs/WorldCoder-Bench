      ]
    },
    {
      "id": "S7",
      "name": "EdgeColorChanged",
      "conditions": [
        "window.__3D_STATE__.edgeColor.r > 0.9",
        "window.__3D_STATE__.edgeColor.g < 0.1",
        "window.__3D_STATE__.edgeColor.b < 0.1"
      ]
    },
    {
      "id": "S8",
      "name": "RotationStopped",
      "conditions": [
        "window.__3D_STATE__.rotationEnabled === false"
      ]
    },
    {
      "id": "S9",
      "name": "AllReset",
      "conditions": [
        "window.__3D_STATE__.thickness === 1.0",
        "window.__3D_STATE__.threshold === 0.1",
        "window.__3D_STATE__.mixStrength === 1.0",
        "window.__3D_STATE__.detectionMode === 'combined'",
        "window.__3D_STATE__.outlineEnabled === true"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 1500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__ === 'object' && window.__3D_STATE__ !== null",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.thickness === 'number' && typeof window.__3D_STATE__.threshold === 'number' && typeof window.__3D_STATE__.mixStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.detectionMode === 'string' && typeof window.__3D_STATE__.outlineEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.objectCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0 && !isNaN(window.__3D_STATE__.fps)",
            "tier": "L2"
          }
        ]
      }
    },
