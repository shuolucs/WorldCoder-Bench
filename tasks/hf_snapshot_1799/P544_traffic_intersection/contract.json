{
  "task_id": "P544_traffic_intersection",
  "affordances": [
    {"id": "A1", "name": "Roads", "type": "3d_object", "semantic": "Perpendicular road surfaces with markings", "locator_hints": ["plane meshes dark gray"]},
    {"id": "A2", "name": "Vehicles", "type": "3d_object", "semantic": "GLB car models moving on roads", "locator_hints": ["GLTF cloned models"]},
    {"id": "A3", "name": "TrafficLights", "type": "3d_object", "semantic": "4 traffic light poles with RGB spheres", "locator_hints": ["cylinder + sphere groups"]},
    {"id": "A4", "name": "SpawnRateSlider", "type": "dom_element", "semantic": "Spawn interval control", "locator_hints": ["#slider-spawn-rate"]},
    {"id": "A5", "name": "SpeedSlider", "type": "dom_element", "semantic": "Vehicle speed control", "locator_hints": ["#slider-speed"]},
    {"id": "A6", "name": "HUD", "type": "dom_element", "semantic": "Info panel", "locator_hints": ["#hud"]}
  ],
  "states": [
    {"id": "S0", "name": "Initial", "conditions": ["window.__3D_STATE__.vehicleCount === 0"]},
    {"id": "S1", "name": "Running", "conditions": ["window.__3D_STATE__.vehicleCount > 0"]},
    {"id": "S2", "name": "LightChanged", "conditions": ["window.__3D_STATE__.nsLight !== 'Green'"]},
    {"id": "S3", "name": "EmergencyStop", "conditions": ["window.__3D_STATE__.emergencyStop === true"]},
    {"id": "S4", "name": "Reset", "conditions": ["window.__3D_STATE__.vehicleCount === 0"]}
  ],
  "transitions": [
    {
      "id": "T1", "from": "S0", "to": "S0", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 2000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__ !== undefined && window.__3D_STATE__ !== null", "tier": "L0"},
        {"expr": "window.__3D_STATE__.frameCount > 0", "tier": "L0"},
        {"expr": "window.__3D_STATE__.modelLoaded === true", "tier": "L1"},
        {"expr": "window.__3D_STATE__.nsLight !== undefined && window.__3D_STATE__.ewLight !== undefined", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return !(s.nsLight === 'Green' && s.ewLight === 'Green'); })()", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); return true; }); })()", "tier": "L0"}
      ]}
    },
    {
      "id": "T2", "from": "S0", "to": "S1", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 5000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.vehicleCount > 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.vehiclesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T3", "from": "S1", "to": "S2", "severity": "P0",
      "action": {"type": "wait", "duration_ms": 10000},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.cycleTime >= 0", "tier": "L1"},
        {"expr": "(function(){ const s = window.__3D_STATE__; return !(s.nsLight === 'Green' && s.ewLight === 'Green'); })()", "tier": "L1"},
        {"expr": "window.__3D_STATE__.vehiclesValid === true", "tier": "L0"}
      ]}
    },
    {
      "id": "T4", "from": "S2", "to": "S3", "severity": "P0",
      "action": {"type": "keyboard", "key": "f"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.emergencyStop === true", "tier": "L2"},
        {"expr": "window.__3D_STATE__.nsLight === 'Red' && window.__3D_STATE__.ewLight === 'Red'", "tier": "L1"}
      ]}
    },
    {
      "id": "T5", "from": "S3", "to": "S4", "severity": "P0",
      "action": {"type": "keyboard", "key": "r"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.vehicleCount === 0", "tier": "L2"},
        {"expr": "window.__3D_STATE__.totalCollisions === 0 || window.__3D_STATE__.totalCollisions >= 0", "tier": "L1"}
      ]}
    },
    {
      "id": "T6", "from": "S4", "to": "S4", "severity": "P1",
      "action": {"type": "script", "code": "document.getElementById('slider-speed').value = 12; document.getElementById('slider-speed').dispatchEvent(new Event('input')); return true;"},
      "verifier": {"type": "scene_probe", "checks": [
        {"expr": "window.__3D_STATE__.baseSpeed >= 10", "tier": "L2"}
      ]}
    }
  ]
}
