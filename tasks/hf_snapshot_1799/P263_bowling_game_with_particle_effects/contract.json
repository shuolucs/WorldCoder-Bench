{
  "task_id": "P263_bowling_game_with_particle_effects",
  "affordances": [
    {
      "id": "A1",
      "name": "BowlingBall",
      "type": "3d_object",
      "semantic": "The dark blue bowling ball the player aims and launches",
      "locator_hints": [
        "sphere radius 0.4",
        "dark blue mesh",
        "starts at z=10"
      ]
    },
    {
      "id": "A2",
      "name": "BowlingPins",
      "type": "3d_object",
      "semantic": "10 lantern models arranged in bowling triangle formation",
      "locator_hints": [
        "Lantern.glb instances",
        "scaled 0.3",
        "positioned near z=-12 to z=-14.4"
      ]
    },
    {
      "id": "A3",
      "name": "BowlingLane",
      "type": "3d_object",
      "semantic": "The wooden-colored lane surface",
      "locator_hints": [
        "box geometry",
        "wood tone color"
      ]
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset the game",
      "locator_hints": [
        "#resetBtn"
      ]
    },
    {
      "id": "A5",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "Shows current pin knockdown score",
      "locator_hints": [
        "#scoreDisplay"
      ]
    },
    {
      "id": "A6",
      "name": "GameStatus",
      "type": "dom_element",
      "semantic": "Shows current game phase text",
      "locator_hints": [
        "#gameStatus"
      ]
    },
    {
      "id": "A7",
      "name": "Particles",
      "type": "3d_object",
      "semantic": "Particle burst effects when pins are knocked down",
      "locator_hints": [
        "small spheres/points",
        "yellow/orange"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "PinsLoaded",
      "conditions": [
        "window.__3D_STATE__.pinsLoaded === true",
        "window.__3D_STATE__.totalPins === 10"
      ]
    },
    {
      "id": "S1",
      "name": "Aiming",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.ballLaunched === false",
        "window.__3D_STATE__.pinsDown === 0"
      ]
    },
    {
      "id": "S2",
      "name": "AimAdjusted",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.ballPosition.x !== 0"
      ]
    },
    {
      "id": "S3",
      "name": "Rolling",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'rolling'",
        "window.__3D_STATE__.ballLaunched === true"
      ]
    },
    {
      "id": "S4",
      "name": "Finished",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'finished'"
      ]
    },
    {
      "id": "S5",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.gamePhase === 'aiming'",
        "window.__3D_STATE__.pinsDown === 0",
        "window.__3D_STATE__.ballLaunched === false"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.ballPosition !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballLaunched !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pinsDown !== undefined",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalPins !== undefined",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.pinsDown === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalPins === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.ballLaunched === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalPins >= 0",
            "tier": "L2"
          }
        ]
      }
    },
