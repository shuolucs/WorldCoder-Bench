{
  "task_id": "P3132",
  "affordances": [
    {
      "id": "A1",
      "name": "Power Toggle Button",
      "type": "dom_element",
      "semantic": "Button to enable/disable apparatus power",
      "locator_hints": [
        "button",
        "power",
        "toggle"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A2",
      "name": "Clamp Pressure Slider",
      "type": "dom_element",
      "semantic": "Slider controlling clamp pressure 0-100 PSI",
      "locator_hints": [
        "input[type='range']",
        "pressure",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A3",
      "name": "Temperature Slider",
      "type": "dom_element",
      "semantic": "Slider controlling temperature 0-200°C",
      "locator_hints": [
        "input[type='range']",
        "temperature",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A4",
      "name": "Spin Speed Slider",
      "type": "dom_element",
      "semantic": "Slider controlling rotation speed 0-5000 RPM",
      "locator_hints": [
        "input[type='range']",
        "spin",
        "rpm",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A5",
      "name": "Solvent Ratio Slider",
      "type": "dom_element",
      "semantic": "Slider controlling solvent mixture ratio 0-100%",
      "locator_hints": [
        "input[type='range']",
        "solvent",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A6",
      "name": "Gears Model",
      "type": "3d_object",
      "semantic": "Rotating mechanical gears forming centrifuge apparatus",
      "locator_hints": [
        "gears.glb",
        "mesh",
        "rotating"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "Mosquito Amber Sample",
      "type": "3d_object",
      "semantic": "Amber specimen containing mosquito at center",
      "locator_hints": [
        "MosquitoInAmber.glb",
        "mesh",
        "center"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Unpowered",
      "description": "Apparatus is off, all controls disabled, gears stationary",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.powerEnabled === false"
    },
    {
      "id": "S1",
      "name": "Powered Uncalibrated",
      "description": "Power enabled, gears rotating at base speed, parameters not yet set",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.powerEnabled === true && !window.__3D_STATE__.optimalParametersAchieved"
    },
    {
      "id": "S2",
      "name": "Partial Calibration",
      "description": "Some parameters set but not all within valid ranges",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.powerEnabled === true && typeof window.__3D_STATE__.clampPressure === 'number' && !window.__3D_STATE__.optimalParametersAchieved"
    },
    {
      "id": "S3",
      "name": "Optimal Parameters",
      "description": "All parameters within valid ranges, extraction can proceed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.optimalParametersAchieved === true && (typeof window.__3D_STATE__.extractionProgress !== 'number' || window.__3D_STATE__.extractionProgress === 0)"
    },
    {
      "id": "S4",
      "name": "Extraction In Progress",
      "description": "DNA extraction actively running with progress increasing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionProgress > 0 && window.__3D_STATE__.extractionProgress < 100"
    },
    {
      "id": "S5",
      "name": "Extraction Complete",
      "description": "Extraction finished successfully at 100% progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionComplete === true && window.__3D_STATE__.totalRuntime <= 15000"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running stably for extended period after completion",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionComplete === true && window.__3D_STATE__.totalRuntime > 15000"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Power is enabled",
        "Gears begin rotating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.powerEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gearRotationAngle > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[0]) { sliders[0].value = 50; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Clamp pressure set to valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.clampPressure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.clampPressure >= 40 && window.__3D_STATE__.clampPressure <= 60",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[1]) { sliders[1].value = 90; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); } if(sliders[2]) { sliders[2].value = 2500; sliders[2].dispatchEvent(new Event('input', {bubbles: true})); } if(sliders[3]) { sliders[3].value = 50; sliders[3].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "All parameters within optimal ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 85 && window.__3D_STATE__.temperature <= 95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed >= 2000 && window.__3D_STATE__.spinSpeed <= 3000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.optimalParametersAchieved === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Extraction progress begins increasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.extractionProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.extractionProgress > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.extractionProgress < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Extraction reaches 100% completion"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionProgress >= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.extractionComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.amberIntegrity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "System continues stable operation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRuntime > 15000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validationErrors === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionComplete === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.gearRotationAngle)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.powerEnabled === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
