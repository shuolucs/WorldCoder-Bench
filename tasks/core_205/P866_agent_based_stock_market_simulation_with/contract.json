{
  "task_id": "P866_agent_based_stock_market_simulation_with",
  "affordances": [
    {
      "id": "A1",
      "name": "TradingFloor",
      "type": "3d_object",
      "semantic": "The 30x30 grid plane serving as the trading floor",
      "locator_hints": [
        "PlaneGeometry or BoxGeometry at y=0",
        "dark gray mesh"
      ]
    },
    {
      "id": "A2",
      "name": "AgentPillars",
      "type": "3d_object",
      "semantic": "8 box pillars representing trading agents arranged in a circle",
      "locator_hints": [
        "BoxGeometry with width 1.5",
        "8 meshes in circular arrangement"
      ]
    },
    {
      "id": "A3",
      "name": "PriceChart",
      "type": "3d_object",
      "semantic": "3D line geometry showing price history",
      "locator_hints": [
        "Line or LineSegments",
        "cyan colored material",
        "y=15 region"
      ]
    },
    {
      "id": "A4",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle simulation running/paused",
      "locator_hints": [
        "button containing 'Play' or 'Pause'"
      ]
    },
    {
      "id": "A5",
      "name": "StepButton",
      "type": "dom_element",
      "semantic": "Button to advance one simulation tick",
      "locator_hints": [
        "button containing 'Step'"
      ]
    },
    {
      "id": "A6",
      "name": "SpeedDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select simulation speed",
      "locator_hints": [
        "select element with Slow/Normal/Fast options"
      ]
    },
    {
      "id": "A7",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo the last simulation tick",
      "locator_hints": [
        "button containing 'Undo'"
      ]
    },
    {
      "id": "A8",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo an undone tick",
      "locator_hints": [
        "button containing 'Redo'"
      ]
    },
    {
      "id": "A9",
      "name": "HUDOverlay",
      "type": "dom_element",
      "semantic": "HUD showing tick count, price, market stats, agent list, status",
      "locator_hints": [
        "div overlay with position absolute/fixed",
        "top-left and top-right panels"
      ]
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialPaused",
      "conditions": [
        "window.__3D_STATE__.tickCount === 0",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.stockPrice === 100"
      ]
    },
    {
      "id": "S1",
      "name": "AfterFirstStep",
      "conditions": [
        "window.__3D_STATE__.tickCount === 1",
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.undoStackSize === 1"
      ]
    },
    {
      "id": "S2",
      "name": "AfterMultipleSteps",
      "conditions": [
        "window.__3D_STATE__.tickCount === 4",
        "window.__3D_STATE__.undoStackSize === 4"
      ]
    },
    {
      "id": "S3",
      "name": "AfterUndo",
      "conditions": [
        "window.__3D_STATE__.tickCount === 3",
        "window.__3D_STATE__.redoStackSize === 1"
      ]
    },
    {
      "id": "S4",
      "name": "AfterRedo",
      "conditions": [
        "window.__3D_STATE__.tickCount === 4",
        "window.__3D_STATE__.redoStackSize === 0"
      ]
    },
    {
      "id": "S5",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isRunning === true"
      ]
    },
    {
      "id": "S6",
      "name": "SimulationPausedAfterRun",
      "conditions": [
        "window.__3D_STATE__.isRunning === false",
        "window.__3D_STATE__.tickCount > 4"
      ]
    },
    {
      "id": "S7",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speed === 'Fast'",
        "window.__3D_STATE__.lastAction === 'speed_change'"
      ]
    },
    {
      "id": "S8",
      "name": "AfterDoubleUndo",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 2"
      ]
    },
    {
      "id": "S9",
      "name": "UndoClearedByNewStep",
      "conditions": [
        "window.__3D_STATE__.redoStackSize === 0",
        "window.__3D_STATE__.lastAction === 'step'"
      ]
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.tickCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tickCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stockPrice >= 10 && window.__3D_STATE__.stockPrice <= 500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.stockPrice)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.priceHistory.length === 1 || window.__3D_STATE__.priceHistory.length === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "for(let i=0;i<3;i++){document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('Step'))b.click()});}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.length === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.cash >= 0 && a.shares >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => Math.abs(a.portfolioValue - (a.cash + a.shares * window.__3D_STATE__.stockPrice)) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Undo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stockPrice >= 10 && window.__3D_STATE__.stockPrice <= 500",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.totalMarketValue)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Redo"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.tickCount === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => !isNaN(a.portfolioValue))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => Math.abs(a.portfolioValue - (a.cash + a.shares * window.__3D_STATE__.stockPrice)) < 0.01)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Play"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'play'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.speed === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.speed === 'Normal'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "await new Promise(r => setTimeout(r, 2200)); document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('Pause'))b.click()});"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tickCount > 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'pause'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.priceHistory.length === window.__3D_STATE__.tickCount || window.__3D_STATE__.priceHistory.length === window.__3D_STATE__.tickCount + 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chartVertexCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMarketValue > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const sel = document.querySelector('select'); if(sel){sel.value='Fast'; sel.dispatchEvent(new Event('change',{bubbles:true}));}"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speed === 'Fast'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'speed_change'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRunning === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalMarketCash === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalMarketShares === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('Undo'))b.click()}); document.querySelectorAll('button').forEach(b=>{if(b.textContent.includes('Undo'))b.click()});"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.cash >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => a.shares >= 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.strategy === 'bull').length === 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.filter(a => a.strategy === 'bear').length === 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text_match": "Step"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastAction === 'step'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stockPrice >= 10 && window.__3D_STATE__.stockPrice <= 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.agents.every(a => Math.abs(a.portfolioValue - (a.cash + a.shares * window.__3D_STATE__.stockPrice)) < 0.01)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.agentTradeCountThisTick === 'number' && window.__3D_STATE__.agentTradeCountThisTick >= 0 && window.__3D_STATE__.agentTradeCountThisTick <= 8",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}