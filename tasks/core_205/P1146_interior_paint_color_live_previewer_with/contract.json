{
  "task_id": "P1146_interior_paint_color_live_previewer_with",
  "affordances": [
    {
      "id": "A1",
      "name": "LeftWall",
      "type": "3d_object",
      "semantic": "Left wall mesh that can be painted",
      "locator_hints": [
        "mesh.name === 'left_wall'",
        "mesh.material.color"
      ],
      "check": "!!(window.scene && window.scene.children.find(c => c.name === 'left_wall'))"
    },
    {
      "id": "A2",
      "name": "RightWall",
      "type": "3d_object",
      "semantic": "Right wall mesh that can be painted",
      "locator_hints": [
        "mesh.name === 'right_wall'",
        "mesh.material.color"
      ],
      "check": "!!(window.scene && window.scene.children.find(c => c.name === 'right_wall'))"
    },
    {
      "id": "A3",
      "name": "BackWall",
      "type": "3d_object",
      "semantic": "Back wall mesh that can be painted",
      "locator_hints": [
        "mesh.name === 'back_wall'",
        "mesh.material.color"
      ],
      "check": "!!(window.scene && window.scene.children.find(c => c.name === 'back_wall'))"
    },
    {
      "id": "A4",
      "name": "ColorPalette",
      "type": "dom_element",
      "semantic": "UI panel with color swatches for painting walls",
      "locator_hints": [
        "div containing color buttons",
        "top-left overlay panel"
      ],
      "check": "document.querySelectorAll('button[style*=\"background\"]').length > 0 || document.querySelectorAll('.color-swatch').length > 0"
    },
    {
      "id": "A5",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo last paint action",
      "locator_hints": [
        "button with undo functionality",
        "history control"
      ],
      "check": "!!document.querySelector('button[onclick*=\"undo\"]') || !!document.getElementById('undoBtn')"
    },
    {
      "id": "A6",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo previously undone paint action",
      "locator_hints": [
        "button with redo functionality",
        "history control"
      ],
      "check": "!!document.querySelector('button[onclick*=\"redo\"]') || !!document.getElementById('redoBtn')"
    },
    {
      "id": "A7",
      "name": "Raycaster",
      "type": "interaction",
      "semantic": "Click interaction to select and paint walls",
      "locator_hints": [
        "mouse click on wall meshes",
        "raycaster for wall selection"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loaded with default white walls, furniture placed, camera and lighting active",
      "condition": "!window.__3D_STATE__ || (!window.__3D_STATE__.paintedWallsCount && !window.__3D_STATE__.firstPaintedWallColor)"
    },
    {
      "id": "S1",
      "name": "first_wall_painted",
      "description": "One wall has been painted with a color from the palette",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.paintedWallsCount === 1 && window.__3D_STATE__.firstPaintedWallColor !== undefined"
    },
    {
      "id": "S2",
      "name": "multiple_walls_painted",
      "description": "Multiple walls painted with different colors, undo stack populated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.paintedWallsCount > 1 && window.__3D_STATE__.undoStackSize > 1 && !window.__3D_STATE__.undoPerformed"
    },
    {
      "id": "S3",
      "name": "undo_performed",
      "description": "Undo action executed, wall color reverted, redo stack populated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoPerformed === true && window.__3D_STATE__.redoStackSize > 0 && !window.__3D_STATE__.redoPerformed"
    },
    {
      "id": "S4",
      "name": "redo_performed",
      "description": "Redo action executed, wall color reapplied from redo stack",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redoPerformed === true && window.__3D_STATE__.undoStackSize > 1"
    },
    {
      "id": "S5",
      "name": "complex_history",
      "description": "Multiple undo/redo operations performed, history stacks actively managed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.paintedWallsCount > 2 && window.__3D_STATE__.totalOperations > 0 && !window.__3D_STATE__.stabilityVerified"
    },
    {
      "id": "S6",
      "name": "stability_verified",
      "description": "All paint operations stable, history management working correctly over extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.stabilityVerified === true && window.__3D_STATE__.finalUndoStackSize !== undefined"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const walls = window.scene.children.filter(c => c.name === 'left_wall' || c.name === 'right_wall' || c.name === 'back_wall'); if (walls.length > 0) { const wall = walls[0]; wall.material.color.setHex(0xff6b6b); window.__3D_STATE__.firstPaintedWallColor = wall.material.color.getHex(); window.__3D_STATE__.paintedWallsCount = 1; window.__3D_STATE__.undoStackSize = 1; }",
        "wait_ms": 1000
      },
      "postconditions": [
        "First wall painted with red color",
        "Undo stack contains one entry",
        "Paint count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.firstPaintedWallColor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.firstPaintedWallColor !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paintedWallsCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.firstPaintedWallColor === 0xff6b6b",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const walls = window.scene.children.filter(c => c.name === 'left_wall' || c.name === 'right_wall' || c.name === 'back_wall'); if (walls.length >= 2) { walls[1].material.color.setHex(0x51cf66); window.__3D_STATE__.secondPaintedWallColor = walls[1].material.color.getHex(); window.__3D_STATE__.paintedWallsCount = 2; window.__3D_STATE__.undoStackSize = 2; window.__3D_STATE__.redoStackSize = 0; }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Second wall painted with green color",
        "Undo stack contains two entries",
        "Redo stack empty"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.secondPaintedWallColor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.paintedWallsCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paintedWallsCount > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.secondPaintedWallColor === 0x51cf66",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "if (window.__3D_STATE__.undoStackSize > 0) { window.__3D_STATE__.undoStackSize -= 1; window.__3D_STATE__.redoStackSize = 1; window.__3D_STATE__.undoPerformed = true; window.__3D_STATE__.undoTimestamp = Date.now(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Undo operation executed",
        "Undo stack decremented",
        "Redo stack populated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.undoPerformed === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoTimestamp !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoPerformed !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.undoTimestamp)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "if (window.__3D_STATE__.redoStackSize > 0) { window.__3D_STATE__.redoStackSize -= 1; window.__3D_STATE__.undoStackSize += 1; window.__3D_STATE__.redoPerformed = true; window.__3D_STATE__.redoTimestamp = Date.now(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Redo operation executed",
        "Redo stack decremented",
        "Undo stack incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redoPerformed === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redoTimestamp !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoPerformed !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize > 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const walls = window.scene.children.filter(c => c.name === 'left_wall' || c.name === 'right_wall' || c.name === 'back_wall'); if (walls.length >= 3) { walls[2].material.color.setHex(0x339af0); window.__3D_STATE__.thirdPaintedWallColor = walls[2].material.color.getHex(); window.__3D_STATE__.paintedWallsCount = 3; window.__3D_STATE__.undoStackSize = 3; window.__3D_STATE__.totalOperations = (window.__3D_STATE__.totalOperations || 0) + 1; }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Third wall painted with blue color",
        "History stacks updated",
        "Total operations tracked"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.thirdPaintedWallColor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalOperations !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.paintedWallsCount > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalOperations > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.thirdPaintedWallColor === 0x339af0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.stabilityCheckStart = Date.now(); window.__3D_STATE__.finalUndoStackSize = window.__3D_STATE__.undoStackSize; window.__3D_STATE__.finalPaintedWallsCount = window.__3D_STATE__.paintedWallsCount; window.__3D_STATE__.stabilityVerified = true;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Stability check initiated",
        "Final state captured",
        "All operations verified"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stabilityCheckStart === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.finalUndoStackSize !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.stabilityVerified !== false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalPaintedWallsCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.finalUndoStackSize)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.stabilityCheckStart)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second stability run completed",
        "All paint operations remain stable",
        "History management consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.finalUndoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stabilityVerified !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.finalPaintedWallsCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.stabilityVerified !== false",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.finalUndoStackSize)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.stabilityCheckStart)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
