{
  "task_id": "P3147",
  "affordances": [
    {
      "id": "A1",
      "name": "IridescenceAbalone",
      "type": "3d_object",
      "semantic": "Shell specimen with 5 virtual ion-containing layers",
      "locator_hints": [
        "IridescenceAbalone.glb",
        "center mounted specimen",
        "rotating platform"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "PrimaryIonDrive",
      "type": "3d_object",
      "semantic": "Ion beam apparatus positioned above-right aimed at shell",
      "locator_hints": [
        "PrimaryIonDrive.glb",
        "beam source",
        "cyan point light"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "BeamEnergySlider",
      "type": "dom_element",
      "semantic": "Slider controlling beam energy from 1 to 10 eV",
      "locator_hints": [
        "input[type='range']",
        "energy slider",
        "1-10 eV"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "FrequencySelector",
      "type": "dom_element",
      "semantic": "Dropdown or radio buttons for UV/Visible/IR frequency selection",
      "locator_hints": [
        "select",
        "frequency",
        "UV/Visible/IR"
      ],
      "check": "document.querySelectorAll('select').length > 0"
    },
    {
      "id": "A5",
      "name": "FocusDial",
      "type": "dom_element",
      "semantic": "Control for beam focus: narrow, medium, or wide",
      "locator_hints": [
        "select",
        "focus",
        "narrow/medium/wide"
      ],
      "check": "document.querySelectorAll('select').length > 0"
    },
    {
      "id": "A6",
      "name": "TargetLayerDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select target shell layer 1-5",
      "locator_hints": [
        "select",
        "layer",
        "1-5"
      ],
      "check": "document.querySelectorAll('select').length > 0"
    },
    {
      "id": "A7",
      "name": "ExtractButton",
      "type": "dom_element",
      "semantic": "Button to initiate ion extraction with current parameters",
      "locator_hints": [
        "button",
        "Extract",
        "extraction trigger"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Extract'))"
    },
    {
      "id": "A8",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to undo the last extraction operation",
      "locator_hints": [
        "button",
        "Undo",
        "revert operation"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Undo'))"
    },
    {
      "id": "A9",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to redo a previously undone extraction",
      "locator_hints": [
        "button",
        "Redo",
        "restore operation"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Redo'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "description": "Lab loaded, all models visible, default parameters set, no extractions performed",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.extractionCount === 0)"
    },
    {
      "id": "S1",
      "name": "ParametersConfigured",
      "description": "User has adjusted beam energy, frequency, focus, and target layer",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.beamEnergy === 'number' && window.__3D_STATE__.extractionCount === 0"
    },
    {
      "id": "S2",
      "name": "ExtractionInProgress",
      "description": "Beam animation active, extraction operation executing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isExtracting === true"
    },
    {
      "id": "S3",
      "name": "ExtractionComplete",
      "description": "Multiple extractions performed, charge and mass ledger updated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.extractionCount > 0 && window.__3D_STATE__.isExtracting === false"
    },
    {
      "id": "S4",
      "name": "UndoPerformed",
      "description": "User has undone at least one extraction, undo stack reduced",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoStackSize >= 0 && window.__3D_STATE__.extractionCount >= 1"
    },
    {
      "id": "S5",
      "name": "StableOperation",
      "description": "System running with consistent state for extended period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 7; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles:true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Beam energy updated to 7 eV in state"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamEnergy === 7",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Extract')) b.click(); });",
        "wait_ms": 2000
      },
      "postconditions": [
        "Extraction initiated, isExtracting flag set to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isExtracting === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isExtracting === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Extraction completed, extraction count incremented, charge and mass updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.extractionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.extractionCount > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalChargeExtracted === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalMassExtracted === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isExtracting === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); slider.value = 4; slider.dispatchEvent(new Event('input', {bubbles:true})); setTimeout(() => { document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Extract')) b.click(); }); }, 500);",
        "wait_ms": 3500
      },
      "postconditions": [
        "Second extraction performed, extraction count increased, ledger updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalChargeExtracted !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMassExtracted > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Undo')) b.click(); });",
        "wait_ms": 1500
      },
      "postconditions": [
        "Undo operation executed, extraction count decremented, undo stack size reduced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.undoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.extractionCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Redo')) b.click(); });",
        "wait_ms": 1500
      },
      "postconditions": [
        "Redo operation executed, extraction count restored"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.extractionCount)",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalChargeExtracted)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds with consistent state values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.extractionCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalMassExtracted)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalChargeExtracted)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.wasteGenerated === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wasteGenerated >= 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
