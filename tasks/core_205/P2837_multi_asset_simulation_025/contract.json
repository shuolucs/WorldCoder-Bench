        "energy display",
        "budget gauge",
        "top bar"
      ],
      "check": "document.querySelectorAll('[class*=\"energy\"], [id*=\"energy\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Target Rings",
      "type": "3d_object",
      "semantic": "Five floating rings on pond surface at varying distances",
      "locator_hints": [
        "circular targets",
        "floating rings",
        "pond targets"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "Wave Rings",
      "type": "3d_object",
      "semantic": "Concentric expanding rings spawned on water impact",
      "locator_hints": [
        "wave effect",
        "expanding circles",
        "impact ripples"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.waveRingCount === 'number')"
    },
    {
      "id": "A7",
      "name": "Arrow Key Controls",
      "type": "interaction",
      "semantic": "Keyboard input for angle and rotation adjustment",
      "locator_hints": [
        "arrow keys",
        "keyboard controls",
        "direction input"
      ],
      "check": "true"
    },
    {
      "id": "A8",
      "name": "Spacebar Toss",
      "type": "interaction",
      "semantic": "Spacebar triggers duck launch with current parameters",
      "locator_hints": [
        "spacebar",
        "launch trigger",
        "throw action"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with Michelle at pond edge, full energy budget, default parameters",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.energyBudget === 100 && window.__3D_STATE__.ducksLaunched === 0)"
    },
    {
      "id": "S1",
      "name": "Parameters Adjusted",
      "description": "User has modified power, angle, or facing direction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.activeProjectiles === 0 && window.__3D_STATE__.energyBudget > 0"
    },
    {
      "id": "S2",
      "name": "Duck In Flight",
      "description": "Projectile active following parabolic trajectory",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeProjectiles > 0"
    },
    {
      "id": "S3",
      "name": "Impact Registered",
      "description": "Duck hit water, energy deducted, waves spawned",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.waveRingCount > 0 && window.__3D_STATE__.energyBudget < 100 && window.__3D_STATE__.activeProjectiles === 0"
    },
    {
      "id": "S4",
      "name": "Target Hit",
      "description": "Duck landed on a target ring, counter incremented",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ducksOnTarget > 0"
    },
    {
      "id": "S5",
      "name": "Energy Depleted",
      "description": "Budget exhausted, no more tosses possible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyBudget <= 0"
    },
    {
      "id": "S6",
      "name": "Stable Simulation",
      "description": "All projectiles settled, wave animations complete",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeProjectiles === 0 && window.__3D_STATE__.ducksLaunched >= 1"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 75; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 500
      },
      "postconditions": [
        "Power slider set to 75%",
        "tossPower state updated to 75"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.tossPower === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tossPower >= 70 && window.__3D_STATE__.tossPower <= 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Duck launched into parabolic trajectory",
        "activeProjectiles incremented",
        "ducksLaunched incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeProjectiles === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeProjectiles > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.ducksLaunched === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ducksLaunched >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "postconditions": [
        "Duck impacted water surface",
        "Energy deducted from budget",
        "Wave rings spawned",
        "lastImpactEnergy calculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 100",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.waveRingCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waveRingCount > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.lastImpactEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastImpactEnergy > 0 && isFinite(window.__3D_STATE__.lastImpactEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
