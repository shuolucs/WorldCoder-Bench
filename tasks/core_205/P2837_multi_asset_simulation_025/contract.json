      },
      "postconditions": [
        "Multiple ducks launched and settled",
        "All projectiles landed",
        "Wave animations complete"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.activeProjectiles === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ducksLaunched >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.ducksLaunched)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0 && window.__3D_STATE__.energyBudget <= 100",
