          },
          {
            "expr": "window.__3D_STATE__.ducksOnTarget > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0",
            "tier": "L1"
          }
        ]
      }
    },
