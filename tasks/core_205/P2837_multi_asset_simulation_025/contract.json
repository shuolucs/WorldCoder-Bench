      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowUp', code: 'ArrowUp', bubbles: true}));",
        "wait_ms": 500
      },
      "postconditions": [
        "Toss angle increased",
