        "Duck.glb",
        "projectile object",
        "yellow duck"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Power Meter Slider",
