      "locator_hints": [
        "input[type='range']",
        "power slider",
        "0-100% control"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "Energy Budget Gauge",
      "type": "dom_element",
      "semantic": "Top bar displaying remaining energy units",
