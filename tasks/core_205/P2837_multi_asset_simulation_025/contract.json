      "locator_hints": [
        "Michelle.glb",
        "character at pond edge",
        "animated humanoid"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Duck Template",
      "type": "3d_object",
      "semantic": "Rubber duck model cloned for each toss",
