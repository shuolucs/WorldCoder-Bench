          },
          {
            "expr": "window.__3D_STATE__.tossAngle >= 20 && window.__3D_STATE__.tossAngle <= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeProjectiles === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S1",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 60; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { window.dispatchEvent(new KeyboardEvent('keydown', {key: ' ', code: 'Space', bubbles: true})); }, 300);",
        "wait_ms": 3000
      },
      "postconditions": [
        "Duck launched and hit target ring",
        "ducksOnTarget incremented",
        "Energy deducted"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.ducksOnTarget === 'number'",
