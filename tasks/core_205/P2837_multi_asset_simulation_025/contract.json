          },
          {
            "expr": "window.__3D_STATE__.michelleFacing >= 0 && window.__3D_STATE__.michelleFacing <= 360",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.simulationActive === 'boolean'",
            "tier": "L0"
          }
        ]
