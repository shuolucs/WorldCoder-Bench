      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both models loaded and visible",
        "Energy budget initialized to 6.0",
        "All 12 energy fields defined"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergyBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
