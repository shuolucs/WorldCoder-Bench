        "input[type='range']",
        "corset bloom",
        "first slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Robot Bloom Slider",
      "type": "dom_element",
      "semantic": "Slider controlling bloom intensity for robot",
