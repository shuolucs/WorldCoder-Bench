        "input[type='range']",
        "robot bloom",
        "second slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A5",
      "name": "Energy Conservation System",
      "type": "interaction",
      "semantic": "System enforcing total energy budget of 6.0 across all sliders",
      "locator_hints": [
        "energy budget",
        "conservation law",
        "sum constraint"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading, models not yet present, energy values at default",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Models Loaded",
      "description": "Both Corset and Robot models loaded, energy budget initialized to 6.0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === true && typeof window.__3D_STATE__.totalEnergyBudget === 'number' && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    },
    {
      "id": "S2",
      "name": "Corset Bloom Adjusted",
      "description": "User increased corset bloom energy, other sliders proportionally reduced",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.corsetBloomEnergy > 0.5 && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    },
    {
      "id": "S3",
      "name": "Robot Chromatic Adjusted",
      "description": "User increased robot chromatic aberration, energy redistributed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.robotChromaticEnergy > 0.4 && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    },
    {
      "id": "S4",
      "name": "Multi-Channel Active",
      "description": "Multiple post-process channels have non-zero energy allocation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.corsetPixelationEnergy > 0.3 && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    },
    {
      "id": "S5",
      "name": "Energy Balanced",
      "description": "Energy budget verified at 6.0 after multiple adjustments",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.robotHueShiftEnergy === 'number' && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running stably with energy conservation maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === true && Math.abs(window.__3D_STATE__.totalEnergyBudget - 6.0) < 0.01"
    }
  ],
