        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 0.8; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
