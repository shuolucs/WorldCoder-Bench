{
  "task_id": "P2773",
  "affordances": [
    {
      "id": "A1",
      "name": "Camera Dolly Position Slider",
      "type": "dom_element",
      "semantic": "Slider control that orbits the AntiqueCamera around the stage on an arc (0-360 degrees)",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "dolly",
        "camera position"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Camera Tilt Slider",
      "type": "dom_element",
      "semantic": "Slider control that adjusts the AntiqueCamera's tilt angle (-45 to 45 degrees)",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "tilt",
        "camera angle"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Stage Light Color Picker",
      "type": "dom_element",
      "semantic": "Color picker that changes the SpotLight color illuminating the stage",
      "locator_hints": [
        "input[type='color']",
        "color picker",
        "stage light",
        "spotlight"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A4",
      "name": "Boombox Pulse Intensity Slider",
      "type": "dom_element",
      "semantic": "Slider control (0-10) that adjusts the pulsing amplitude of the BoomBox",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "boombox",
        "pulse",
        "intensity"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A5",
      "name": "Robot Pose Selector",
      "type": "dom_element",
      "semantic": "Control to cycle through different Xbot animation poses (0-2)",
      "locator_hints": [
        "button",
        "select",
        "robot pose",
        "xbot",
        "animation"
      ],
      "check": "document.querySelectorAll('button').length > 1"
    },
    {
      "id": "A6",
      "name": "Camera Zoom Slider",
      "type": "dom_element",
      "semantic": "Slider control (0.5-2.0) that adjusts the AntiqueCamera's zoom level",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "zoom",
        "camera zoom"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A7",
      "name": "Record Button",
      "type": "dom_element",
      "semantic": "Button to confirm settings and start the music video recording",
      "locator_hints": [
        "button",
        "record",
        "start",
        "confirm"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A8",
      "name": "AntiqueCamera Model",
      "type": "3d_object",
      "semantic": "The camera model that moves on the dolly track arc",
      "locator_hints": [
        "AntiqueCamera.glb",
        "camera mesh",
        "dolly camera"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A9",
      "name": "BoomBox Model",
      "type": "3d_object",
      "semantic": "The boombox model at center stage that pulses with music",
      "locator_hints": [
        "BoomBox.glb",
        "boombox mesh",
        "speaker"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A10",
      "name": "Xbot Robot Model",
      "type": "3d_object",
      "semantic": "The robot performer model that displays different poses",
      "locator_hints": [
        "Xbot.glb",
        "robot mesh",
        "performer"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Scene loaded with all models positioned, controls panel visible, default values set",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || !window.__3D_STATE__.setupComplete"
    },
    {
      "id": "S1",
      "name": "Camera Positioning",
      "description": "User adjusting camera dolly angle and tilt to frame the shot correctly",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.cameraDollyAngle === 'number' && !window.__3D_STATE__.setupComplete"
    },
    {
      "id": "S2",
      "name": "Lighting Configuration",
      "description": "User setting the stage light color to create the desired mood",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.validCameraTilt === true && typeof window.__3D_STATE__.stageLightHue === 'number' && !window.__3D_STATE__.setupComplete"
    },
    {
      "id": "S3",
      "name": "Performance Tuning",
      "description": "User adjusting boombox pulse intensity, robot pose, and camera zoom",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.validStageLightColor === true && typeof window.__3D_STATE__.boomboxPulseIntensity === 'number' && !window.__3D_STATE__.setupComplete"
    },
    {
      "id": "S4",
      "name": "Validation Complete",
      "description": "All required parameters are within valid ranges, ready to record",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.setupComplete === true && window.__3D_STATE__.recordingActive !== true"
    },
    {
      "id": "S5",
      "name": "Recording Active",
      "description": "Music video recording confirmed and running with all settings locked",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.recordingActive === true"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System maintaining stable state with all validations passing for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.recordingActive === true && window.__3D_STATE__.setupComplete === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 45; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Camera dolly angle set to 45 degrees within valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraDollyAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraDollyAngle >= 30 && window.__3D_STATE__.cameraDollyAngle <= 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validCameraDolly === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const tiltSliders = document.querySelectorAll('input[type=\"range\"]'); if(tiltSliders[1]) { tiltSliders[1].value = 0; tiltSliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Camera tilt angle set to 0 degrees within valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraTiltAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraTiltAngle >= -10 && window.__3D_STATE__.cameraTiltAngle <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validCameraTilt === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const colorPicker = document.querySelector('input[type=\"color\"]'); if(colorPicker) { colorPicker.value = '#8800ff'; colorPicker.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Stage light color set to purple hue range (260-300)"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stageLightHue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stageLightHue >= 260 && window.__3D_STATE__.stageLightHue <= 300",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validStageLightColor === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[2]) { sliders[2].value = 5; sliders[2].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Boombox pulse intensity set to mid-range value, all validations passing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.boomboxPulseIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.boomboxPulseIntensity >= 0 && window.__3D_STATE__.boomboxPulseIntensity <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.setupComplete === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const recordBtn = document.querySelector('button'); if(recordBtn) { recordBtn.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Recording activated, all settings locked and validated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.recordingActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validCameraDolly === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validCameraTilt === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.validStageLightColor === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[3]) { sliders[3].value = 1.2; sliders[3].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Camera zoom adjusted while recording remains active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraZoomLevel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraZoomLevel >= 0.5 && window.__3D_STATE__.cameraZoomLevel <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.recordingActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const poseBtn = document.querySelectorAll('button')[1]; if(poseBtn) { poseBtn.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Robot pose changed, system transitioning to stable operation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.robotPoseIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.robotPoseIndex)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.robotPoseIndex >= 0 && window.__3D_STATE__.robotPoseIndex <= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stable state for 60 seconds with all validations passing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.recordingActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.setupComplete === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDollyAngle)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.boomboxPulseIntensity)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
