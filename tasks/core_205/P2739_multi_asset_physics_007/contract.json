{
  "task_id": "P2739",
  "affordances": [
    {
      "id": "A1",
      "name": "Stork Model",
      "type": "3d_object",
      "semantic": "Flying bird with attached steampunk camera via spring tether",
      "locator_hints": [
        "stork.glb",
        "main physics body",
        "hovering at y=8 initially"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Steampunk Camera",
      "type": "3d_object",
      "semantic": "Camera hanging beneath stork as damped pendulum",
      "locator_hints": [
        "steampunk_camera.glb",
        "tethered below stork",
        "swings with acceleration"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Antique Camera Tracker",
      "type": "3d_object",
      "semantic": "Ground-based tracking station that rotates to face stork",
      "locator_hints": [
        "AntiqueCamera.glb",
        "y=0 ground platform",
        "auto-rotates toward stork"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Thrust Control Sliders",
      "type": "dom_element",
      "semantic": "Two sliders for horizontal thrust angle (0-360°) and magnitude (0-20)",
      "locator_hints": [
        "thrust angle slider",
        "thrust magnitude slider",
        "user input controls"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length >= 2"
    },
    {
      "id": "A5",
      "name": "Vertical Lift Slider",
      "type": "dom_element",
      "semantic": "Slider controlling vertical lift force (-10 to 10)",
      "locator_hints": [
        "vertical lift control",
        "y-axis force",
        "range -10 to 10"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A6",
      "name": "Wind Force Sliders",
      "type": "dom_element",
      "semantic": "Sliders for wind direction and strength affecting stork motion",
      "locator_hints": [
        "wind direction slider",
        "wind strength slider",
        "environmental force"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A7",
      "name": "Physics Simulation",
      "type": "interaction",
      "semantic": "2D physics with thrust, wind, gravity, drag, and momentum conservation",
      "locator_hints": [
        "force integration",
        "velocity updates",
        "position updates per frame"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_hover",
      "description": "Stork hovering at starting altitude y=8 with zero velocity, all forces at default",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.storkPositionY >= 7.5 && window.__3D_STATE__.storkPositionY <= 8.5 && Math.abs(window.__3D_STATE__.storkVelocityX) < 0.01 && Math.abs(window.__3D_STATE__.storkVelocityY) < 0.01 && Math.abs(window.__3D_STATE__.storkVelocityZ) < 0.01)"
    },
    {
      "id": "S1",
      "name": "thrust_applied",
      "description": "User has applied horizontal thrust, stork begins accelerating in XZ plane",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.thrustMagnitude > 0 && (Math.abs(window.__3D_STATE__.storkVelocityX) > 0.01 || Math.abs(window.__3D_STATE__.storkVelocityZ) > 0.01)"
    },
    {
      "id": "S2",
      "name": "vertical_motion",
      "description": "Vertical lift force applied, stork gains altitude or descends with Y velocity",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.storkVelocityY) > 0.1 && window.__3D_STATE__.storkPositionY > 8"
    },
    {
      "id": "S3",
      "name": "wind_influence",
      "description": "Wind force active, stork drifts horizontally while maintaining physics momentum",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.storkVelocityX !== 0 || window.__3D_STATE__.storkVelocityZ !== 0) && (Math.abs(window.__3D_STATE__.storkPositionX) > 0.5 || Math.abs(window.__3D_STATE__.storkPositionZ) > 0.5)"
    },
    {
      "id": "S4",
      "name": "multi_axis_flight",
      "description": "Combined thrust, lift, and wind forces create complex 3D trajectory with drag",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.thrustMagnitude > 10 && window.__3D_STATE__.storkVelocityX !== 0 && window.__3D_STATE__.storkVelocityZ !== 0 && window.__3D_STATE__.storkPositionY > 5"
    },
    {
      "id": "S5",
      "name": "gravity_descent",
      "description": "Gravity dominates, stork descending with negative Y velocity toward ground",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.thrustMagnitude === 0 && window.__3D_STATE__.storkVelocityY < 0 && window.__3D_STATE__.storkPositionY < 10"
    },
    {
      "id": "S6",
      "name": "stable_flight",
      "description": "Forces balanced, stork maintains steady velocity vector in 3D space for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.storkPositionY > 3 && Math.abs(window.__3D_STATE__.storkVelocityY) < 5 && isFinite(window.__3D_STATE__.storkVelocityX) && isFinite(window.__3D_STATE__.storkVelocityY) && isFinite(window.__3D_STATE__.storkVelocityZ)"
    }
  ],
  "transitions": [
    {
      "id": "T0_1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 45; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true})); const sliders = document.querySelectorAll('input[type=\"range\"]'); if (sliders[1]) { sliders[1].value = 12; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Thrust angle set to 45 degrees",
        "Thrust magnitude set to 12 units",
        "Stork begins horizontal acceleration"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.thrustAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.thrustMagnitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.thrustMagnitude > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkVelocityX) > 0.01 || Math.abs(window.__3D_STATE__.storkVelocityZ) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkPositionX)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T1_2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); for (let i = 0; i < sliders.length; i++) { if (parseFloat(sliders[i].min) < 0 && parseFloat(sliders[i].max) > 0) { sliders[i].value = 6; sliders[i].dispatchEvent(new Event('input', {bubbles: true})); break; } }",
        "wait_ms": 2500
      },
      "postconditions": [
        "Vertical lift force set to positive value",
        "Stork gains upward Y velocity",
        "Altitude increases above initial y=8"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityY > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY > 8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkPositionY - 8) > 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkVelocityY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2_3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); let windSet = false; for (let i = 0; i < sliders.length; i++) { const label = sliders[i].previousElementSibling?.textContent || sliders[i].parentElement?.textContent || ''; if (label.match(/wind/i) && !windSet) { sliders[i].value = parseFloat(sliders[i].max) * 0.6; sliders[i].dispatchEvent(new Event('input', {bubbles: true})); windSet = true; } }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Wind force applied to stork",
        "Horizontal drift velocity component added",
        "Trajectory curves due to wind influence"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityZ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityX !== 0 || window.__3D_STATE__.storkVelocityZ !== 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkPositionX) > 0.5 || Math.abs(window.__3D_STATE__.storkPositionZ) > 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkPositionZ)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3_4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 135; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); if (sliders[1]) { sliders[1].value = 15; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 3500
      },
      "postconditions": [
        "Thrust angle changed to 135 degrees",
        "Thrust magnitude increased to 15",
        "Stork exhibits complex 3D trajectory with all forces active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.thrustMagnitude > 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityX !== 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityZ !== 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkVelocityX) + Math.abs(window.__3D_STATE__.storkVelocityZ) > 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkVelocityX) && isFinite(window.__3D_STATE__.storkVelocityZ)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY > 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4_5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[1].value = 0; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); for (let i = 0; i < sliders.length; i++) { const label = sliders[i].previousElementSibling?.textContent || sliders[i].parentElement?.textContent || ''; if (label.match(/lift|vertical/i)) { sliders[i].value = -8; sliders[i].dispatchEvent(new Event('input', {bubbles: true})); break; } }",
        "wait_ms": 4000
      },
      "postconditions": [
        "Thrust magnitude set to zero",
        "Negative vertical lift applied",
        "Gravity dominates, stork descends with negative Y velocity"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.thrustMagnitude === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkVelocityY < 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY < 10",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkVelocityY) > 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkPositionY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5_6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 90; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); sliders[1].value = 8; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); for (let i = 0; i < sliders.length; i++) { const label = sliders[i].previousElementSibling?.textContent || sliders[i].parentElement?.textContent || ''; if (label.match(/lift|vertical/i)) { sliders[i].value = 5; sliders[i].dispatchEvent(new Event('input', {bubbles: true})); break; } }",
        "wait_ms": 5000
      },
      "postconditions": [
        "Thrust and lift forces balanced with gravity and drag",
        "Stork maintains relatively steady velocity vector",
        "Position changes smoothly without erratic acceleration"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.storkVelocityZ === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.storkPositionY > 3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.storkVelocityX) && isFinite(window.__3D_STATE__.storkVelocityY) && isFinite(window.__3D_STATE__.storkVelocityZ)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.storkVelocityY) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
