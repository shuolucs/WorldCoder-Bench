{
  "task_id": "P2883",
  "affordances": [
    {
      "id": "A1",
      "name": "Rift Distortion Slider",
      "type": "dom_element",
      "semantic": "Slider controlling sine-wave UV displacement amplitude in rift shader",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Rift Distortion'",
        "slider with min=0 max=2"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Chromatic Shift Slider",
      "type": "dom_element",
      "semantic": "Slider controlling RGB channel separation for chromatic aberration effect",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Chromatic'",
        "slider with max=0.05"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Edge Glow Intensity Slider",
      "type": "dom_element",
      "semantic": "Slider controlling additive glow intensity at rift edges",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Edge Glow'",
        "slider with max=5"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Dissolve Threshold Slider",
      "type": "dom_element",
      "semantic": "Slider controlling cutoff value for dissolve pattern effect",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Dissolve'",
        "slider with min=0 max=1"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A5",
      "name": "Color Grading Strength Slider",
      "type": "dom_element",
      "semantic": "Slider controlling blend factor for color grading between city and hallway worlds",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Color Grading'",
        "slider with min=0 max=1"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 4"
    },
    {
      "id": "A6",
      "name": "Rift Shader Plane",
      "type": "3d_object",
      "semantic": "Vertical plane with custom ShaderMaterial displaying dimensional rift portal",
      "locator_hints": [
        "THREE.Mesh with ShaderMaterial",
        "plane geometry approximately 8x12 units",
        "positioned above city center"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "Hallway Render Target",
      "type": "3d_object",
      "semantic": "WebGLRenderTarget capturing hallway scene for shader texture sampling",
      "locator_hints": [
        "THREE.WebGLRenderTarget",
        "texture uniform in rift shader",
        "updated each frame"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.renderTargetUpdated)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initialized with default shader parameters, both models loaded, render target created",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Distortion Adjusted",
      "description": "Rift distortion slider modified, UV displacement amplitude changed in shader",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.riftDistortion === 'number' && window.__3D_STATE__.riftDistortion >= 0 && window.__3D_STATE__.riftDistortion <= 2.0"
    },
    {
      "id": "S2",
      "name": "Chromatic Aberration Active",
      "description": "Chromatic shift slider adjusted, RGB channels separated in hallway texture sampling",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.chromaticShift === 'number' && window.__3D_STATE__.chromaticShift > 0"
    },
    {
      "id": "S3",
      "name": "Edge Glow Modified",
      "description": "Edge glow intensity changed, additive glow effect updated at rift boundaries",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.edgeGlowIntensity === 'number' && window.__3D_STATE__.edgeGlowIntensity > 0"
    },
    {
      "id": "S4",
      "name": "Dissolve Pattern Applied",
      "description": "Dissolve threshold adjusted, pattern cutoff affecting rift visibility",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.dissolveThreshold === 'number' && window.__3D_STATE__.dissolveThreshold >= 0 && window.__3D_STATE__.dissolveThreshold <= 1.0"
    },
    {
      "id": "S5",
      "name": "Color Grading Blended",
      "description": "Color grading strength modified, blending between warm city and cold hallway tones",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.colorGradingStrength === 'number' && window.__3D_STATE__.colorGradingStrength > 0"
    },
    {
      "id": "S6",
      "name": "Stable Multi-Effect",
      "description": "All shader effects active simultaneously with valid parameters, render loop stable",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.shaderUniformsValid === true && window.__3D_STATE__.totalInteractionCount >= 5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 1.5; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Rift distortion value updated to 1.5",
        "Shader uniform reflects new distortion amplitude",
        "UV displacement visible in rift rendering"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.riftDistortion === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.riftDistortion >= 0 && window.__3D_STATE__.riftDistortion <= 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.riftDistortion - 1.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[1].value = 0.03; sliders[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Chromatic shift value set to 0.03",
        "RGB channel offsets applied in fragment shader",
        "Color separation visible at rift edges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chromaticShift === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticShift >= 0 && window.__3D_STATE__.chromaticShift <= 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chromaticShift - 0.03) < 0.005",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[2].value = 3.5; sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Edge glow intensity increased to 3.5",
        "Additive glow shader component intensified",
        "Rift boundaries more luminous"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.edgeGlowIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.edgeGlowIntensity >= 0 && window.__3D_STATE__.edgeGlowIntensity <= 5.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.edgeGlowIntensity - 3.5) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[3].value = 0.6; sliders[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Dissolve threshold set to 0.6",
        "Pattern cutoff applied in shader",
        "Partial rift visibility based on dissolve pattern"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dissolveThreshold === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dissolveThreshold >= 0 && window.__3D_STATE__.dissolveThreshold <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dissolveThreshold - 0.6) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[4].value = 0.75; sliders[4].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Color grading strength set to 0.75",
        "Blend factor applied between warm and cold color tones",
        "Visual transition between city and hallway color spaces"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.colorGradingStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.colorGradingStrength >= 0 && window.__3D_STATE__.colorGradingStrength <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.colorGradingStrength - 0.75) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.totalInteractionCount = (window.__3D_STATE__.totalInteractionCount || 0) + 5;",
        "wait_ms": 1000
      },
      "postconditions": [
        "All shader parameters within valid ranges",
        "Render target updating each frame",
        "Shader uniforms validated and stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.shaderUniformsValid === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInteractionCount >= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.renderTargetUpdated = true;",
        "wait_ms": 2000
      },
      "postconditions": [
        "Render target continues updating",
        "All effects remain stable",
        "No shader compilation errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.renderTargetUpdated === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.renderTargetUpdated === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.riftDistortion) && isFinite(window.__3D_STATE__.chromaticShift)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All shader effects continue rendering",
        "No memory leaks or performance degradation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.riftDistortion === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.shaderUniformsValid === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.edgeGlowIntensity) && isFinite(window.__3D_STATE__.dissolveThreshold)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
