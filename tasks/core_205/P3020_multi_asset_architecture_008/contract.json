{
  "task_id": "P3020",
  "affordances": [
    {
      "id": "A1",
      "name": "Add Sofa Button",
      "type": "dom_element",
      "semantic": "Button to spawn a new GlamVelvetSofa model on the floor",
      "locator_hints": [
        "button",
        "text contains 'Add Sofa'",
        "UI control"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Add Sofa'))"
    },
    {
      "id": "A2",
      "name": "Add Mug Button",
      "type": "dom_element",
      "semantic": "Button to spawn a coffeeMug model near the last sofa",
      "locator_hints": [
        "button",
        "text contains 'Add Mug'",
        "UI control"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Add Mug'))"
    },
    {
      "id": "A3",
      "name": "Budget Display",
      "type": "dom_element",
      "semantic": "HUD element showing remaining budget points",
      "locator_hints": [
        "top-right",
        "displays number",
        "budget counter"
      ],
      "check": "document.querySelectorAll('[style*=\"top\"][style*=\"right\"]').length > 0 || document.querySelectorAll('.budget').length > 0"
    },
    {
      "id": "A4",
      "name": "Sofa Model",
      "type": "3d_object",
      "semantic": "Placed GlamVelvetSofa.glb instance in the scene",
      "locator_hints": [
        "3D mesh",
        "sofa geometry",
        "selectable object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sofaCount > 0)"
    },
    {
      "id": "A5",
      "name": "Mug Model",
      "type": "3d_object",
      "semantic": "Placed coffeeMug.glb instance on side table",
      "locator_hints": [
        "3D mesh",
        "mug geometry",
        "small object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.mugCount > 0)"
    },
    {
      "id": "A6",
      "name": "Color Picker",
      "type": "dom_element",
      "semantic": "UI control to change selected sofa velvet color",
      "locator_hints": [
        "color input",
        "preset swatches",
        "appears on selection"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A7",
      "name": "Rotate Button",
      "type": "dom_element",
      "semantic": "Button to rotate selected object by 45 degrees",
      "locator_hints": [
        "button",
        "rotation control",
        "text contains 'Rotate'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Rotate'))"
    },
    {
      "id": "A8",
      "name": "Remove Button",
      "type": "dom_element",
      "semantic": "Button to delete selected object and refund budget",
      "locator_hints": [
        "button",
        "text contains 'Remove'",
        "delete control"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Remove'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Empty Scene",
      "description": "Scene loaded with floor plane, lighting, and full 100 budget points; no furniture placed yet",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.sofaCount === 0 && window.__3D_STATE__.budgetPoints === 100)"
    },
    {
      "id": "S1",
      "name": "First Sofa Placed",
      "description": "One sofa spawned on floor, budget reduced to 80 points, sofa count is 1",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaCount === 1 && window.__3D_STATE__.budgetPoints === 80"
    },
    {
      "id": "S2",
      "name": "Multiple Furniture Placed",
      "description": "At least 2 sofas and 1 mug placed, budget partially consumed, layout taking shape",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaCount >= 2 && window.__3D_STATE__.mugCount >= 1"
    },
    {
      "id": "S3",
      "name": "Sofa Selected and Modified",
      "description": "A sofa is selected with outline highlight, color changed at least once, budget deducted for color change",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedSofaIndex >= 0 && window.__3D_STATE__.colorChanges >= 1"
    },
    {
      "id": "S4",
      "name": "Rotation Applied",
      "description": "At least one object rotated, rotation count incremented, budget reduced by 1 point per rotation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalRotations >= 1"
    },
    {
      "id": "S5",
      "name": "Item Removed with Refund",
      "description": "An object removed from scene, budget refunded, refundedPoints increased",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.refundedPoints > 0"
    },
    {
      "id": "S6",
      "name": "Valid Layout Achieved",
      "description": "At least 2 sofas and 2 mugs placed, isLayoutValid true, budget conservation maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isLayoutValid === true && window.__3D_STATE__.sofaCount >= 2 && window.__3D_STATE__.mugCount >= 2"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "First sofa placed on floor",
        "Budget reduced from 100 to 80",
        "Sofa count equals 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sofaCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaCount === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.budgetPoints === 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click(); setTimeout(() => { const buttons = Array.from(document.querySelectorAll('button')); const mugBtn = buttons.find(b => b.textContent.includes('Mug')); if (mugBtn) mugBtn.click(); }, 800);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Second sofa placed",
        "At least one mug placed near sofa",
        "Budget reduced accordingly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sofaCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mugCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.budgetPoints <= 55",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2, bubbles: true}); canvas.dispatchEvent(evt); setTimeout(() => { const colorPicker = document.querySelector('input[type=\"color\"]'); if (colorPicker) { colorPicker.value = '#8B4513'; colorPicker.dispatchEvent(new Event('input', {bubbles: true})); } }, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Sofa selected via click",
        "Color changed using picker",
        "Budget reduced by 3 points for color change"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedSofaIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedSofaIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.colorChanges >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rotateBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Rotate')); if (rotateBtn) { rotateBtn.click(); setTimeout(() => rotateBtn.click(), 400); }",
        "wait_ms": 1200
      },
      "postconditions": [
        "Selected object rotated at least once",
        "Rotation count incremented",
        "Budget reduced by 1 point per rotation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalRotations === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalRotations >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalRotations)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const removeBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Remove')); if (removeBtn) removeBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Selected object removed from scene",
        "Budget refunded with original placement cost",
        "Refunded points tracked"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.refundedPoints === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refundedPoints > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.budgetPoints)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const addSofa = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Add Sofa')); const addMug = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Add Mug')); if (addSofa) addSofa.click(); setTimeout(() => { if (addMug) { addMug.click(); setTimeout(() => addMug.click(), 600); } }, 800);",
        "wait_ms": 2500
      },
      "postconditions": [
        "At least 2 sofas and 2 mugs in scene",
        "Layout validation flag set to true",
        "Budget conservation law maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isLayoutValid === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isLayoutValid === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sofaCount >= 2 && window.__3D_STATE__.mugCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const evt = new MouseEvent('click', {clientX: window.innerWidth * 0.6, clientY: window.innerHeight * 0.5, bubbles: true}); canvas.dispatchEvent(evt); setTimeout(() => { const rotateBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Rotate')); if (rotateBtn) rotateBtn.click(); }, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Additional interaction performed",
        "Placement attempts incremented",
        "Average sofa spacing computed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.placementAttempts === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.placementAttempts >= 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.averageSofaSpacing === 'number' && window.__3D_STATE__.averageSofaSpacing >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state fields maintain valid values",
        "Budget conservation law holds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.budgetPoints === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.budgetPoints >= 0 && window.__3D_STATE__.budgetPoints <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sofaCount + window.__3D_STATE__.mugCount > 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
