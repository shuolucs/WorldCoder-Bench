{
  "task_id": "P12_force_graph_3d",
  "affordances": [
    {
      "id": "A1",
      "name": "GraphNodes",
      "type": "3d_object",
      "semantic": "50 个按组着色的球体节点",
      "count": "50",
      "locator_hints": [
        "sphere",
        "node",
        "mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "GraphEdges",
      "type": "3d_object",
      "semantic": "80 条 Line 边",
      "count": "80",
      "locator_hints": [
        "line",
        "edge"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "HoverInfo",
      "type": "dom_element",
      "semantic": "悬停显示节点名称",
      "locator_hints": [
        "hoverInfo"
      ],
      "check": "!!document.getElementById('hoverInfo')"
    },
    {
      "id": "A4",
      "name": "PauseBtn",
      "type": "dom_element",
      "semantic": "暂停/继续仿真",
      "locator_hints": [
        "pauseBtn"
      ],
      "check": "!!document.getElementById('pauseBtn')"
    },
    {
      "id": "A5",
      "name": "HUD_NodeCount",
      "type": "dom_element",
      "semantic": "节点数 HUD",
      "locator_hints": [
        "nodeCount"
      ],
      "check": "!!document.getElementById('nodeCount')"
    },
    {
      "id": "A6",
      "name": "HUD_EdgeCount",
      "type": "dom_element",
      "semantic": "边数 HUD",
      "locator_hints": [
        "edgeCount"
      ],
      "check": "!!document.getElementById('edgeCount')"
    },
    {
      "id": "A7",
      "name": "HUD_SimEnergy",
      "type": "dom_element",
      "semantic": "仿真能量",
      "locator_hints": [
        "simEnergy"
      ],
      "check": "!!document.getElementById('simEnergy')"
    },
    {
      "id": "A8",
      "name": "HUD_PinnedCount",
      "type": "dom_element",
      "semantic": "固定节点数",
      "locator_hints": [
        "pinnedCount"
      ],
      "check": "!!document.getElementById('pinnedCount')"
    },
    {
      "id": "A9",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "旋转缩放场景",
      "locator_hints": [
        "orbit",
        "drag"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "50 节点 80 边",
      "observable": {
        "nodeCount": 50,
        "edgeCount": 80
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.nodeCount === 50 && window.__3D_STATE__.edgeCount === 80"
    },
    {
      "id": "S1",
      "name": "com_stable",
      "description": "10s 后质心漂移率 <0.5/unit time",
      "observable": {
        "com_drift": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simEnergy < 0.5"
    },
    {
      "id": "S2",
      "name": "group_colored",
      "description": "同组同色",
      "observable": {
        "group_colors_ok": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.nodes && window.__3D_STATE__.nodes.length > 0"
    },
    {
      "id": "S3",
      "name": "pin_applied",
      "description": "至少一节点被固定",
      "observable": {
        "pinnedCount": ">=1"
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pinnedCount >= 1"
    },
    {
      "id": "S4",
      "name": "pin_held",
      "description": "固定节点 5s 内不动",
      "observable": {
        "pin_static": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pinnedCount >= 1 && window.__3D_STATE__.simEnergy < 0.1"
    },
    {
      "id": "S5",
      "name": "paused_frozen",
      "description": "暂停 3s 全节点坐标不变",
      "observable": {
        "isPaused": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S6",
      "name": "resumed_motion",
      "description": "恢复后节点再次运动",
      "observable": {
        "isPaused": false
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === false"
    },
    {
      "id": "S7",
      "name": "long_stable",
      "description": "60s 长期稳定",
      "observable": {
        "finite": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simEnergy < 0.1"
    },
    {
      "id": "S8",
      "name": "hud_ok",
      "description": "HUD 与状态一致",
      "observable": {
        "hud": true
      },
      "condition": "window.__3D_STATE__ && document.getElementById('nodeCount') && document.getElementById('edgeCount')"
    },
    {
      "id": "S9",
      "name": "counts_reassert",
      "description": "计数仍为 50/80",
      "observable": {
        "counts": true
      },
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.nodeCount === 50 && window.__3D_STATE__.edgeCount === 80"
    }
  ],
