{
  "task_id": "P568_coupled_pendulum",
  "affordances": [
    {
      "id": "A1",
      "name": "PendulumA",
      "type": "3d_object",
      "semantic": "Left pendulum rod and bob (red)",
      "locator_hints": [
        "pendulum",
        "rod",
        "bob",
        "red"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.bobAPos)"
    },
    {
      "id": "A2",
      "name": "PendulumB",
      "type": "3d_object",
      "semantic": "Right pendulum rod and bob (blue)",
      "locator_hints": [
        "pendulum",
        "rod",
        "bob",
        "blue"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.bobBPos)"
    },
    {
      "id": "A3",
      "name": "Spring",
      "type": "3d_object",
      "semantic": "Coupling spring connecting the two pendulums",
      "locator_hints": [
        "spring",
        "coil",
        "tube"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.springEnergy === 'number')"
    },
    {
      "id": "A4",
      "name": "EnergyBars",
      "type": "dom_element",
      "semantic": "Energy visualization bars for both pendulums and spring",
      "locator_hints": [
        "bar-ke-a",
        "bar-pe-a",
        "bar-ke-b",
        "bar-pe-b",
        "bar-spring"
      ],
      "check": "!!document.getElementById('bar-ke-a')"
    },
    {
      "id": "A5",
      "name": "SliderStiffness",
      "type": "dom_element",
      "semantic": "Spring stiffness control slider",
      "locator_hints": [
        "slider-stiffness"
      ],
      "check": "!!document.getElementById('slider-stiffness')"
    },
    {
      "id": "A6",
      "name": "SliderLengthA",
      "type": "dom_element",
      "semantic": "Pendulum A length slider",
      "locator_hints": [
        "slider-length-a"
      ],
      "check": "!!document.getElementById('slider-length-a')"
    },
    {
      "id": "A7",
      "name": "SliderLengthB",
      "type": "dom_element",
      "semantic": "Pendulum B length slider",
      "locator_hints": [
        "slider-length-b"
      ],
      "check": "!!document.getElementById('slider-length-b')"
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Head-up display with angles, energies, time",
      "locator_hints": [
        "hud"
      ],
      "check": "!!document.getElementById('hud')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loaded, pendulum A displaced, pendulum B at rest",
      "conditions": [
        "window.__3D_STATE__ !== undefined"
      ],
      "condition": "window.__3D_STATE__ !== undefined && window.__3D_STATE__.frameCount === 0"
    },
    {
      "id": "S1",
      "name": "running",
      "description": "Both pendulums in motion, energy transferring",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.frameCount > 0 && !window.__3D_STATE__.isPaused && window.__3D_STATE__.totalEnergy > 0"
    },
    {
      "id": "S2",
      "name": "energy_checked",
      "description": "Energy conservation verified after sustained run",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simTime > 5 && window.__3D_STATE__.totalEnergy > 0 && (Math.abs(window.__3D_STATE__.thetaB) > 0.01 || Math.abs(window.__3D_STATE__.omegaB) > 0.01)"
    },
    {
      "id": "S3",
      "name": "stiffness_changed",
      "description": "Spring stiffness modified, transfer rate changed",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.springStiffness === 'number' && Math.abs(window.__3D_STATE__.springStiffness - 15) < 1"
    },
    {
      "id": "S4",
      "name": "paused",
      "description": "Simulation paused",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S5",
      "name": "reset",
      "description": "Simulation reset to initial conditions",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.thetaA - Math.PI/6) < 0.05 && Math.abs(window.__3D_STATE__.thetaB) < 0.05 && Math.abs(window.__3D_STATE__.omegaA) < 0.05 && Math.abs(window.__3D_STATE__.omegaB) < 0.05"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.frameCount > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.thetaA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.thetaB === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.bobAPos === 'object' && window.__3D_STATE__.bobAPos !== null",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bobBPos === 'object' && window.__3D_STATE__.bobBPos !== null",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.springEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.thetaA) && isFinite(window.__3D_STATE__.thetaB)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.omegaA) && isFinite(window.__3D_STATE__.omegaB)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaA) > 0.01 || Math.abs(window.__3D_STATE__.omegaA) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 15000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.simTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.thetaA) && isFinite(window.__3D_STATE__.thetaB) && isFinite(window.__3D_STATE__.omegaA) && isFinite(window.__3D_STATE__.omegaB)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simTime > 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaB) > 0.01 || Math.abs(window.__3D_STATE__.omegaB) > 0.01",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const s = document.getElementById('slider-stiffness'); s.value = 15; s.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 3000,
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.springStiffness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.springStiffness - 15) < 1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.thetaA) && isFinite(window.__3D_STATE__.thetaB)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.springEnergy >= 0",
            "tier": "L1"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1500,
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isPaused === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaA - before.thetaA) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaB - before.thetaB) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.simTime - before.simTime) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 1000,
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.thetaA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.thetaB === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaA - Math.PI/6) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.thetaB) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.omegaA) < 0.05 && Math.abs(window.__3D_STATE__.omegaB) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S1",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "const sa = document.getElementById('slider-length-a'); sa.value = 3; sa.dispatchEvent(new Event('input'));"
      },
      "verifier": {
        "type": "scene_probe",
        "pre_wait_ms": 5000,
        "checks": [
          {
            "expr": "window.__3D_STATE__ !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.lengthA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lengthA - 3) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.thetaA) && isFinite(window.__3D_STATE__.thetaB)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.bobAPos.y > window.__3D_STATE__.bobBPos.y || Math.abs(window.__3D_STATE__.bobAPos.y - window.__3D_STATE__.bobBPos.y) > 0.5",
            "tier": "L2"
          },
          {
            "expr": "(function(){ const s = window.__3D_STATE__; return Object.values(s).every(v => { if(typeof v === 'number') return isFinite(v) && !isNaN(v); if(typeof v === 'object' && v !== null) return Object.values(v).every(x => typeof x !== 'number' || (isFinite(x) && !isNaN(x))); return true; }); })()",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
