{
  "task_id": "P3190",
  "affordances": [
    {
      "id": "A1",
      "name": "FrequencySlider",
      "type": "dom_element",
      "semantic": "Controls wave oscillation speed 1-10 Hz",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "frequency"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "AmplitudeSlider",
      "type": "dom_element",
      "semantic": "Controls deformation magnitude 0-1",
      "locator_hints": [
        "input[type='range']",
        "slider",
        "amplitude"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A3",
      "name": "DirectionDial",
      "type": "dom_element",
      "semantic": "8-point compass for wave direction",
      "locator_hints": [
        "select",
        "dial",
        "direction"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A4",
      "name": "PulseButton",
      "type": "dom_element",
      "semantic": "Fires single bass burst",
      "locator_hints": [
        "button",
        "pulse",
        "burst"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/pulse|burst/i))"
    },
    {
      "id": "A5",
      "name": "CouplingToggle",
      "type": "dom_element",
      "semantic": "Links/unlinks parrot-horse deformation",
      "locator_hints": [
        "input[type='checkbox']",
        "toggle",
        "coupling"
      ],
      "check": "!!document.querySelector('input[type=\"checkbox\"]')"
    },
    {
      "id": "A6",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Reverts last state change",
      "locator_hints": [
        "button",
        "undo"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/undo/i))"
    },
    {
      "id": "A7",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Reapplies undone state",
      "locator_hints": [
        "button",
        "redo"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/redo/i))"
    },
    {
      "id": "A8",
      "name": "HorseSoftBody",
      "type": "3d_object",
      "semantic": "Horse mesh with spring-mass deformation",
      "locator_hints": [
        "horse.glb",
        "left platform"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A9",
      "name": "ParrotSoftBody",
      "type": "3d_object",
      "semantic": "Parrot mesh with spring-mass deformation",
      "locator_hints": [
        "Parrot.glb",
        "hovering right"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A10",
      "name": "BoomBoxEmitter",
      "type": "3d_object",
      "semantic": "Sound wave source at scene back",
      "locator_hints": [
        "BoomBox.glb",
        "centered back"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene loaded, default frequency 5Hz, amplitude 0.5, direction 0°, coupling off",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.waveFrequency === 5 && window.__3D_STATE__.waveAmplitude === 0.5 && window.__3D_STATE__.waveDirection === 0 && window.__3D_STATE__.couplingEnabled === false"
    },
    {
      "id": "S1",
      "name": "frequency_adjusted",
      "description": "User changed wave frequency to 8Hz",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.waveFrequency - 8) < 0.5"
    },
    {
      "id": "S2",
      "name": "amplitude_increased",
      "description": "Amplitude raised to 0.9, energy budgets responding",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.waveAmplitude > 0.8 && window.__3D_STATE__.totalEnergyBudget !== undefined"
    },
    {
      "id": "S3",
      "name": "coupling_enabled",
      "description": "Parrot-horse coupling activated, energy redistribution active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.couplingEnabled === true"
    },
    {
      "id": "S4",
      "name": "pulse_fired",
      "description": "Bass burst triggered, transient energy spike",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.horseEnergyUsed > 0 && window.__3D_STATE__.parrotEnergyUsed > 0"
    },
    {
      "id": "S5",
      "name": "direction_changed",
      "description": "Wave direction rotated to 135°",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.waveDirection - 135) < 25"
    },
    {
      "id": "S6",
      "name": "undo_applied",
      "description": "Reverted to previous state, undo stack decremented",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.undoStackSize === 'number' && window.__3D_STATE__.undoStackSize >= 0"
    },
    {
      "id": "S7",
      "name": "stability_run",
      "description": "60-second continuous deformation with all parameters active",
      "condition": "window.__3D_STATE__ && isFinite(window.__3D_STATE__.waveFrequency) && isFinite(window.__3D_STATE__.waveAmplitude) && isFinite(window.__3D_STATE__.waveDirection) && isFinite(window.__3D_STATE__.totalEnergyBudget)"
    }
  ],
  "transitions": [
    {
      "id": "T0_init",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 8; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1200
      },
      "postconditions": [
        "Frequency slider set to 8Hz",
        "waveFrequency updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waveFrequency === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waveFrequency > 7",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waveFrequency - 8) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T1_amplitude",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const ampSlider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.max == '1' || s.step == '0.01'); if(ampSlider) { ampSlider.value = 0.9; ampSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Amplitude set to 0.9",
        "Energy budgets recalculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waveAmplitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waveAmplitude > 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waveAmplitude - 0.9) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.parrotEnergyUsed !== null",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyBudget)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2_coupling",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const toggle = document.querySelector('input[type=\"checkbox\"]'); if(toggle) { toggle.checked = true; toggle.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Coupling enabled",
        "Energy redistribution between parrot and horse active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.couplingEnabled === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.couplingEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.parrotEnergyUsed > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.horseEnergyUsed + window.__3D_STATE__.parrotEnergyUsed)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3_pulse",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pulseBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/pulse|burst/i)); if(pulseBtn) pulseBtn.click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Bass burst fired",
        "Transient energy spike recorded"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.parrotEnergyUsed !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.parrotEnergyUsed > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.undoStackSize)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4_direction",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const dirSelect = document.querySelector('select'); if(dirSelect) { dirSelect.value = '135'; dirSelect.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1200
      },
      "postconditions": [
        "Wave direction set to 135°",
        "Deformation cone reoriented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waveDirection === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waveDirection > 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waveDirection - 135) < 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.couplingEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.waveFrequency)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5_undo",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const undoBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/undo/i)); if(undoBtn) undoBtn.click();",
        "wait_ms": 800
      },
      "postconditions": [
        "Previous state restored",
        "Undo stack size decremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.undoStackSize === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.undoStackSize)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.waveFrequency !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waveAmplitude !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyBudget)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6_stability",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second continuous soft-body deformation",
        "All systems stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waveFrequency === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.waveAmplitude === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.waveDirection === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.horseEnergyUsed >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.parrotEnergyUsed >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyBudget)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
