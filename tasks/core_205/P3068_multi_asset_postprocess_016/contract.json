{
  "task_id": "P3068",
  "affordances": [
    {
      "id": "A1",
      "name": "VirtualCity",
      "type": "3d_object",
      "semantic": "Main city model centered at origin",
      "locator_hints": [
        "VirtualCity.glb",
        "center of scene",
        "6-unit bounding box"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "PotOfCoals",
      "type": "3d_object",
      "semantic": "Glowing coal pot positioned to the right",
      "locator_hints": [
        "PotOfCoals.glb",
        "x+4 position",
        "pulsing orange light"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.coalLightIntensity !== undefined)"
    },
    {
      "id": "A3",
      "name": "IridescentDomes",
      "type": "3d_object",
      "semantic": "Six translucent iridescent dome meshes over city districts",
      "locator_hints": [
        "IridescenceAbalone geometry clones",
        "2x3 grid",
        "hovering above districts"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.domeOpacityAverage !== undefined)"
    },
    {
      "id": "A4",
      "name": "DistrictDome",
      "type": "interaction",
      "semantic": "Clickable dome to select district",
      "locator_hints": [
        "raycaster click",
        "highlight ring on selection"
      ],
      "check": "true"
    },
    {
      "id": "A5",
      "name": "EffectSliders",
      "type": "dom_element",
      "semantic": "Five sliders controlling post-process effects for selected district",
      "locator_hints": [
        "bloom slider",
        "chromaticAberration slider",
        "vignette slider",
        "exposure slider",
        "grain slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length >= 5"
    },
    {
      "id": "A6",
      "name": "EnergyBudgetDisplay",
      "type": "dom_element",
      "semantic": "Display showing remaining global energy budget",
      "locator_hints": [
        "energy counter",
        "0-100 units"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.energyBudget !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with city, coal pot, and 6 domes; full energy budget; no district selected",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.selectedDistrictIndex === undefined && window.__3D_STATE__.energyBudget === 100)"
    },
    {
      "id": "S1",
      "name": "District Selected",
      "description": "User has clicked a dome; district is highlighted and sliders are active",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.selectedDistrictIndex === 'number' && window.__3D_STATE__.selectedDistrictIndex >= 0 && window.__3D_STATE__.selectedDistrictIndex <= 5)"
    },
    {
      "id": "S2",
      "name": "Effects Applied",
      "description": "User has adjusted sliders; energy budget consumed; post-process effects visible",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.bloomContribution > 0 && window.__3D_STATE__.energyBudget < 100)"
    },
    {
      "id": "S3",
      "name": "Budget Depleted",
      "description": "Energy budget exhausted; sliders clamped; no further adjustments possible",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.energyBudget < 5 && window.__3D_STATE__.energyBudget >= 0)"
    },
    {
      "id": "S4",
      "name": "Multi-District Configured",
      "description": "Multiple districts have non-zero effects; blended post-processing active",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.districtEffectCount >= 2)"
    },
    {
      "id": "S5",
      "name": "Stable Configuration",
      "description": "No slider changes for 3+ seconds; scene is stable with current effects",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.isStable === true)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const domes = window.scene.children.filter(c => c.userData.isDome); if(domes[0]) { const evt = new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2}); window.canvas.dispatchEvent(evt); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "A district dome is selected",
        "selectedDistrictIndex is set to valid index (0-5)"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedDistrictIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedDistrictIndex >= 0 && window.__3D_STATE__.selectedDistrictIndex <= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const bloomSlider = document.querySelector('input[data-effect=\"bloom\"]'); if(bloomSlider) { bloomSlider.value = 3; bloomSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Bloom effect applied to selected district",
        "Energy budget decreased",
        "bloomContribution increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bloomContribution === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bloomContribution > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const caSlider = document.querySelector('input[data-effect=\"chromaticAberration\"]'); const vigSlider = document.querySelector('input[data-effect=\"vignette\"]'); if(caSlider) { caSlider.value = 0.03; caSlider.dispatchEvent(new Event('input', {bubbles: true})); } setTimeout(() => { if(vigSlider) { vigSlider.value = 0.8; vigSlider.dispatchEvent(new Event('input', {bubbles: true})); } }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Multiple effects applied",
        "chromaticAberrationContribution and vignetteContribution increased",
        "totalEffectIntensity increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chromaticAberrationContribution === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticAberrationContribution > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.vignetteContribution > 0 && window.__3D_STATE__.totalEffectIntensity > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const domes = window.scene.children.filter(c => c.userData.isDome); for(let i = 1; i < 3; i++) { if(domes[i]) { const rect = window.canvas.getBoundingClientRect(); const x = rect.left + rect.width * (0.3 + i*0.2); const y = rect.top + rect.height * 0.5; const evt = new MouseEvent('click', {clientX: x, clientY: y}); window.canvas.dispatchEvent(evt); setTimeout(() => { const expSlider = document.querySelector('input[data-effect=\"exposure\"]'); if(expSlider) { expSlider.value = 1.5; expSlider.dispatchEvent(new Event('input', {bubbles: true})); } }, 500 * i); } }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Multiple districts configured with effects",
        "districtEffectCount >= 2",
        "exposureContribution increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.districtEffectCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.districtEffectCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.exposureContribution > 0 && Number.isInteger(window.__3D_STATE__.districtEffectCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "let attempts = 0; const maxAttempts = 20; const interval = setInterval(() => { const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders.forEach(s => { s.value = parseFloat(s.max); s.dispatchEvent(new Event('input', {bubbles: true})); }); attempts++; if(attempts >= maxAttempts || window.__3D_STATE__.energyBudget <= 0) clearInterval(interval); }, 200);",
        "wait_ms": 5000
      },
      "postconditions": [
        "Energy budget depleted to zero or near-zero",
        "Sliders clamped",
        "No further adjustments possible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 5 && isFinite(window.__3D_STATE__.energyBudget)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3500
      },
      "postconditions": [
        "No slider changes for 3+ seconds",
        "isStable flag set to true",
        "Scene effects stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isStable === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isStable === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coalLightIntensity !== undefined && isFinite(window.__3D_STATE__.coalLightIntensity)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state fields maintain valid values",
        "Post-process effects continue rendering"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.domeOpacityAverage === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.domeOpacityAverage >= 0 && window.__3D_STATE__.domeOpacityAverage <= 1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEffectIntensity) && window.__3D_STATE__.grainContribution >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
