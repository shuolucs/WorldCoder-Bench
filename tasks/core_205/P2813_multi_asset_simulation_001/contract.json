{
  "task_id": "P2813",
  "affordances": [
    {
      "id": "A1",
      "name": "Gear Speed Slider",
      "type": "dom_element",
      "semantic": "HTML range input controlling energy allocation to gear rotation subsystem",
      "locator_hints": [
        "input[type='range']",
        "slider with 'gear' or 'Gear Speed' label"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Mask Glow Slider",
      "type": "dom_element",
      "semantic": "HTML range input controlling energy allocation to mask emissive and particle effects",
      "locator_hints": [
        "input[type='range']",
        "slider with 'mask' or 'Mask Glow' label"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Puppet Motion Slider",
      "type": "dom_element",
      "semantic": "HTML range input controlling energy allocation to kira puppet animation",
      "locator_hints": [
        "input[type='range']",
        "slider with 'puppet' or 'Puppet Motion' label"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Gears Model",
      "type": "3d_object",
      "semantic": "Rotating mechanical gears on the left side of the scene",
      "locator_hints": [
        "gears.glb",
        "leftmost 3D object",
        "rotating mechanical assembly"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Venetian Mask",
      "type": "3d_object",
      "semantic": "Floating mask with emissive glow and particle aura in center",
      "locator_hints": [
        "venice_mask.glb",
        "center object",
        "glowing mask with particles"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "Kira Puppet",
      "type": "3d_object",
      "semantic": "Animated puppet figure on the right performing procedural sway motion",
      "locator_hints": [
        "kira.glb",
        "rightmost 3D object",
        "animated character"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "Energy HUD Bar",
      "type": "dom_element",
      "semantic": "Visual display showing remaining energy pool and allocations",
      "locator_hints": [
        "div",
        "energy bar",
        "HUD element showing 100 units"
      ],
      "check": "!!document.querySelector('div')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Idle",
      "description": "Scene loaded with all models present, zero energy allocated to all subsystems, everything static",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && window.__3D_STATE__.energyAllocatedGears === 0 && window.__3D_STATE__.energyAllocatedMask === 0 && window.__3D_STATE__.energyAllocatedPuppet === 0"
    },
    {
      "id": "S1",
      "name": "Gears Powered",
      "description": "Energy allocated to gears subsystem, gears rotating at measurable speed, mask and puppet still idle",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyAllocatedGears > 0 && window.__3D_STATE__.gearRotationSpeed > 0 && window.__3D_STATE__.energyAllocatedMask === 0 && window.__3D_STATE__.energyAllocatedPuppet === 0"
    },
    {
      "id": "S2",
      "name": "Mask Energized",
      "description": "Energy allocated to mask subsystem, emissive glow active and particles spawned, gears may be active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyAllocatedMask > 0 && window.__3D_STATE__.maskEmissiveIntensity > 0 && window.__3D_STATE__.maskParticleCount > 0"
    },
    {
      "id": "S3",
      "name": "Puppet Animated",
      "description": "Energy allocated to puppet subsystem, kira performing sway animation with non-zero amplitude",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyAllocatedPuppet > 0 && window.__3D_STATE__.puppetSwayAmplitude > 0 && window.__3D_STATE__.puppetAnimationSpeed > 0"
    },
    {
      "id": "S4",
      "name": "Balanced Distribution",
      "description": "Energy distributed across all three subsystems without violating conservation law, all effects active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyAllocatedGears > 0 && window.__3D_STATE__.energyAllocatedMask > 0 && window.__3D_STATE__.energyAllocatedPuppet > 0 && window.__3D_STATE__.conservationLawViolated === false"
    },
    {
      "id": "S5",
      "name": "Conservation Enforced",
      "description": "User attempted to exceed 100 energy units, system auto-adjusted allocations to maintain conservation law",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyAllocatedGears + window.__3D_STATE__.energyAllocatedMask + window.__3D_STATE__.energyAllocatedPuppet <= 100 && window.__3D_STATE__.conservationLawViolated === false"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "All subsystems running at steady state for extended period, no conservation violations, system stabilized",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.systemStabilized === true && window.__3D_STATE__.conservationLawViolated === false && window.__3D_STATE__.gearRotationSpeed > 0 && window.__3D_STATE__.maskEmissiveIntensity > 0 && window.__3D_STATE__.puppetSwayAmplitude > 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 30; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Gear speed slider set to 30 units",
        "Gears rotation speed is positive and non-zero",
        "Energy allocated to gears is 30"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyAllocatedGears === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedGears === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gearRotationSpeed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[1].value = 40; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Mask glow slider set to 40 units",
        "Mask emissive intensity is positive",
        "Particle count around mask is greater than zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyAllocatedMask === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedMask === 40",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.maskEmissiveIntensity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maskParticleCount > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[2].value = 25; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Puppet motion slider set to 25 units",
        "Puppet sway amplitude is positive",
        "Puppet animation speed is greater than zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyAllocatedPuppet === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedPuppet === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.puppetSwayAmplitude > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.puppetAnimationSpeed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 35; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "All three subsystems have non-zero energy allocation",
        "Total energy allocation does not exceed 100",
        "Conservation law is not violated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.energyAllocatedGears > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedMask > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedPuppet > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.energyAllocatedGears + window.__3D_STATE__.energyAllocatedMask + window.__3D_STATE__.energyAllocatedPuppet <= window.__3D_STATE__.totalEnergyPool",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationLawViolated === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[1].value = 50; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "System detected conservation law would be violated",
        "Other sliders auto-adjusted to maintain total at or below 100",
        "Conservation law remains satisfied after adjustment"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.energyAllocatedGears + window.__3D_STATE__.energyAllocatedMask + window.__3D_STATE__.energyAllocatedPuppet <= 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationLawViolated === false",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.energyAllocatedGears)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.energyAllocatedMask)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.energyAllocatedPuppet)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 33; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[1].value = 34; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[2].value = 33; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 6000
      },
      "postconditions": [
        "Energy evenly distributed across all subsystems",
        "All subsystems operating at steady state",
        "System stabilized flag is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs((window.__3D_STATE__.energyAllocatedGears + window.__3D_STATE__.energyAllocatedMask + window.__3D_STATE__.energyAllocatedPuppet) - 100) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gearRotationSpeed > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maskEmissiveIntensity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.puppetSwayAmplitude > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.systemStabilized === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "No conservation law violations occur",
        "All subsystems continue operating normally"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.conservationLawViolated === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.systemStabilized === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.gearRotationSpeed)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.maskEmissiveIntensity)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.puppetSwayAmplitude)",
            "tier": "L0"
          }
        ]
      }
