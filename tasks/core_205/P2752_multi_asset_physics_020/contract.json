{
  "task_id": "P2752",
  "affordances": [
    {
      "id": "A1",
      "name": "CesiumMilkTruck",
      "type": "3d_object",
      "semantic": "The main delivery truck that moves along the road",
      "locator_hints": [
        "glb model",
        "positioned on left side of road",
        "moves along X-axis"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.truckVelocity !== undefined)"
    },
    {
      "id": "A2",
      "name": "CoffeeMugs",
      "type": "3d_object",
      "semantic": "Five coffee mug instances placed at stations along the road",
      "locator_hints": [
        "glb model instances",
        "evenly spaced",
        "on platform pedestals"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalMugStations === 5)"
    },
    {
      "id": "A3",
      "name": "VelocitySlider",
      "type": "dom_element",
      "semantic": "Slider control for truck speed (0-5 units/sec)",
      "locator_hints": [
        "input type=range",
        "min=0 max=5",
        "controls truck velocity"
      ],
      "check": "!!document.querySelector('input[type=range]')"
    },
    {
      "id": "A4",
      "name": "PourButton",
      "type": "dom_element",
      "semantic": "Button that appears when truck is at station to trigger milk pouring",
      "locator_hints": [
        "button element",
        "appears conditionally",
        "triggers pour animation"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Pour'))"
    },
    {
      "id": "A5",
      "name": "MilkParticleStream",
      "type": "3d_object",
      "semantic": "White cylinder particles representing milk flowing from truck to mug",
      "locator_hints": [
        "white cylinder geometry",
        "animated during pour",
        "connects truck to mug"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.isPouringActive !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Scene loaded with truck at start position, all mugs empty, velocity at 0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.truckVelocity === 0 && window.__3D_STATE__.successfulDeliveries === 0 && window.__3D_STATE__.currentStationIndex === 0"
    },
    {
      "id": "S1",
      "name": "Driving to First Station",
      "description": "Truck moving forward with velocity > 0, approaching first mug station",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.truckVelocity > 0 && !window.__3D_STATE__.isStoppedAtStation"
    },
    {
      "id": "S2",
      "name": "Stopped at Station",
      "description": "Truck stopped within range of a mug station, Pour button visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isStoppedAtStation === true && !window.__3D_STATE__.isPouringActive"
    },
    {
      "id": "S3",
      "name": "Pouring Milk",
      "description": "Truck tilted, milk stream active, mug fill level increasing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPouringActive === true && window.__3D_STATE__.activeMugFillLevel > 0 && window.__3D_STATE__.activeMugFillLevel <= 100"
    },
    {
      "id": "S4",
      "name": "Successful Delivery",
      "description": "Mug filled successfully without tipping, truck ready to continue",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.successfulDeliveries > 0 && !window.__3D_STATE__.isPouringActive && window.__3D_STATE__.activeMugFillLevel >= 50 && window.__3D_STATE__.activeMugFillLevel <= 100"
    },
    {
      "id": "S5",
      "name": "Mug Tipped Over",
      "description": "Overfill caused mug to tip, tipped count incremented",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.tippedMugCount > 0 && (window.__3D_STATE__.activeMugFillLevel > 100 || !window.__3D_STATE__.isPouringActive)"
    },
    {
      "id": "S6",
      "name": "All Deliveries Complete",
      "description": "Truck has visited all 5 stations, game phase is completed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gamePhase === 'completed' && window.__3D_STATE__.currentStationIndex >= 4"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 2; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', { bubbles: true }));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Truck velocity set to 2 units/sec",
        "Truck begins moving along X-axis toward first station"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.truckVelocity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.truckVelocity > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.truckVelocity - 2) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Truck has moved close to first mug station",
        "Distance to station is within stopping range",
        "Velocity reduced to 0 and truck is stopped at station"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isStoppedAtStation === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isStoppedAtStation === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.distanceToNextStation >= 0 && window.__3D_STATE__.distanceToNextStation < 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pourBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Pour')); if (pourBtn) { pourBtn.dispatchEvent(new MouseEvent('mousedown', { bubbles: true })); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Pour button pressed, pouring state activated",
        "Truck tilt animation started",
        "Milk stream particles visible",
        "Mug fill level begins increasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isPouringActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPouringActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeMugFillLevel > 0 && window.__3D_STATE__.activeMugFillLevel < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pourBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Pour')); if (pourBtn) { pourBtn.dispatchEvent(new MouseEvent('mouseup', { bubbles: true })); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Pour button released before overfill",
        "Mug fill level between 50-100%",
        "Successful deliveries count incremented",
        "No mug tipped over"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.successfulDeliveries === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.successfulDeliveries > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activeMugFillLevel >= 50 && window.__3D_STATE__.activeMugFillLevel <= 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 3; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', { bubbles: true }));",
        "wait_ms": 3000
      },
      "postconditions": [
        "Truck resumes driving to next station",
        "Current station index incremented",
        "Truck velocity set to continue journey"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentStationIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentStationIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.currentStationIndex) && window.__3D_STATE__.currentStationIndex < window.__3D_STATE__.totalMugStations",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Pour held too long, mug fill exceeded 100%",
        "Mug tipped over due to overfill",
        "Tipped mug count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.tippedMugCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.tippedMugCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.activeMugFillLevel > 100 || window.__3D_STATE__.tippedMugCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "All 5 mug stations have been visited",
        "Game phase transitioned to completed",
        "Final delivery statistics available"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gamePhase === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentStationIndex >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.gamePhase === 'completed' && window.__3D_STATE__.successfulDeliveries + window.__3D_STATE__.tippedMugCount === window.__3D_STATE__.totalMugStations",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable in completed state for 60 seconds",
        "All state values remain valid and unchanged"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gamePhase === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gamePhase === 'completed'",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.successfulDeliveries) && isFinite(window.__3D_STATE__.tippedMugCount)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
