{
  "task_id": "P3093",
  "affordances": [
    {
      "id": "A1",
      "name": "AnimatedMorphCube",
      "type": "3d_object",
      "semantic": "Floating morphing cube that projects colored light onto the pouf below",
      "locator_hints": [
        "../../../assets/shared/AnimatedMorphCube.glb",
        "cube mesh with morph targets",
        "object with PointLight child"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "SpecularSilkPouf",
      "type": "3d_object",
      "semantic": "Silk pouf at origin receiving specular reflections from cube's light",
      "locator_hints": [
        "../../../assets/shared/SpecularSilkPouf.glb",
        "pouf at scene origin",
        "mesh with adjustable roughness"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "MorphTargetSelector",
      "type": "dom_element",
      "semantic": "Dropdown to select which morph target index to control",
      "locator_hints": [
        "select element",
        "morph index dropdown",
        "options 0-3"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A4",
      "name": "MorphWeightSlider",
      "type": "dom_element",
      "semantic": "Slider controlling the influence weight of selected morph target",
      "locator_hints": [
        "input type=range",
        "morph weight slider",
        "range 0.0-1.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "CubeHeightSlider",
      "type": "dom_element",
      "semantic": "Vertical slider controlling cube Y-position above pouf",
      "locator_hints": [
        "input type=range",
        "height slider",
        "range 0.5-4.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A6",
      "name": "RotationSpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling cube rotation speed around Y-axis",
      "locator_hints": [
        "input type=range",
        "rotation speed slider",
        "range 0-5 rad/s"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A7",
      "name": "LightColorPicker",
      "type": "dom_element",
      "semantic": "Color picker setting the PointLight color attached to cube",
      "locator_hints": [
        "input type=color",
        "color picker",
        "controls PointLight color"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A8",
      "name": "RoughnessSlider",
      "type": "dom_element",
      "semantic": "Slider overriding roughness of all pouf materials",
      "locator_hints": [
        "input type=range",
        "roughness slider",
        "range 0.0-1.0"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A9",
      "name": "CaptureSnapshotButton",
      "type": "dom_element",
      "semantic": "Button that logs current state snapshot to console",
      "locator_hints": [
        "button element",
        "capture snapshot",
        "logs state"
      ],
      "check": "!!document.querySelector('button')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with cube at default height, no rotation, default morph and lighting",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Cube Elevated",
      "description": "Cube positioned at maximum height above pouf",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cubeYPosition >= 3.5"
    },
    {
      "id": "S2",
      "name": "Active Rotation",
      "description": "Cube spinning at moderate speed with morph animation active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cubeRotationSpeed >= 2.5"
    },
    {
      "id": "S3",
      "name": "Colored Lighting",
      "description": "PointLight color changed to non-default, illuminating pouf with colored specular",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pointLightColor && window.__3D_STATE__.pointLightColor.startsWith('#')"
    },
    {
      "id": "S4",
      "name": "Roughness Modified",
      "description": "Pouf material roughness adjusted to alter specular response",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.poufRoughnessOverride === 'number' && window.__3D_STATE__.poufRoughnessOverride >= 0.0"
    },
    {
      "id": "S5",
      "name": "Snapshot Captured",
      "description": "User has captured at least one state snapshot",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.snapshotCount > 0"
    },
    {
      "id": "S6",
      "name": "Stability Check",
      "description": "System running stably for extended period with all interactions functional",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 4.0; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Cube Y-position updated to maximum height of 4.0 units"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cubeYPosition === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cubeYPosition >= 3.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cubeYPosition - 4.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[2].value = 3.0; sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Cube rotation speed set to 3.0 rad/s and cube is actively rotating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cubeRotationSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cubeRotationSpeed >= 2.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cubeRotationSpeed - 3.0) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const colorPicker = document.querySelector('input[type=\"color\"]'); if(colorPicker) { colorPicker.value = '#ff3366'; colorPicker.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "PointLight color changed to a non-default color value"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.pointLightColor === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pointLightColor !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointLightColor.startsWith('#')",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); const roughnessSlider = Array.from(sliders).find(s => parseFloat(s.max) === 1.0 && parseFloat(s.min) === 0.0 && parseFloat(s.step) <= 0.1); if(roughnessSlider) { roughnessSlider.value = 0.7; roughnessSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pouf material roughness override set to 0.7"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.poufRoughnessOverride === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poufRoughnessOverride >= 0.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.poufRoughnessOverride - 0.7) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const btn = document.querySelector('button'); if(btn) { btn.click(); }",
        "wait_ms": 500
      },
      "postconditions": [
        "Snapshot captured and snapshot count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.snapshotCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.snapshotCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.snapshotCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const select = document.querySelector('select'); if(select) { select.selectedIndex = 2; select.dispatchEvent(new Event('change', {bubbles: true})); } const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[1]) { sliders[1].value = 0.8; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Morph target index changed and weight adjusted, morph animation active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeMorphIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeMorphIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.morphTargetWeight >= 0.5 && window.__3D_STATE__.morphTargetWeight <= 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S2",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable with all state values valid and cube continuing to rotate"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cubeCurrentRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cubeCurrentRotationY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cubeRotationSpeed >= 0 && window.__3D_STATE__.cubeRotationSpeed <= 5",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
