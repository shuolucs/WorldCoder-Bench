{
  "task_id": "P3145",
  "affordances": [
    {
      "id": "A1",
      "name": "LittlestTokyo Environment",
      "type": "3d_object",
      "semantic": "Miniature city backdrop serving as lab bench environment",
      "locator_hints": [
        "LittlestTokyo.glb",
        "scaled 0.004",
        "centered at origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Acid Stock Teacup",
      "type": "3d_object",
      "semantic": "Red-tinted teacup containing acid stock solution",
      "locator_hints": [
        "DiffuseTransmissionTeacup.glb",
        "red material",
        "first position on rail"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Base Stock Teacup",
      "type": "3d_object",
      "semantic": "Blue-tinted teacup containing base stock solution",
      "locator_hints": [
        "DiffuseTransmissionTeacup.glb",
        "blue material",
        "second position on rail"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Mixing Vessel Teacup",
      "type": "3d_object",
      "semantic": "Clear teacup where titration mixing occurs",
      "locator_hints": [
        "DiffuseTransmissionTeacup.glb",
        "clear/transparent material",
        "fourth position"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Transfer Button",
      "type": "dom_element",
      "semantic": "Button to initiate reagent transfer between vessels",
      "locator_hints": [
        "button",
        "text 'Transfer'",
        "left panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Transfer'))"
    },
    {
      "id": "A6",
      "name": "Volume Slider",
      "type": "dom_element",
      "semantic": "Slider controlling transfer volume from 1-25 mL",
      "locator_hints": [
        "input type='range'",
        "min 1 max 25",
        "Set Volume"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A7",
      "name": "Add Indicator Button",
      "type": "dom_element",
      "semantic": "Button to add 2 mL indicator to selected cup",
      "locator_hints": [
        "button",
        "text 'Add Indicator'",
        "left panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Add Indicator'))"
    },
    {
      "id": "A8",
      "name": "Heat Button",
      "type": "dom_element",
      "semantic": "Button to double reaction rate and warm color",
      "locator_hints": [
        "button",
        "text 'Heat'",
        "left panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Heat'))"
    },
    {
      "id": "A9",
      "name": "Stir Button",
      "type": "dom_element",
      "semantic": "Button to trigger spin animation on selected cup",
      "locator_hints": [
        "button",
        "text 'Stir'",
        "left panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Stir'))"
    },
    {
      "id": "A10",
      "name": "Measure pH Button",
      "type": "dom_element",
      "semantic": "Button to calculate and display pH of selected vessel",
      "locator_hints": [
        "button",
        "text 'Measure pH'",
        "left panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Measure pH'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Scene loaded with five teacups positioned, acid and base stocks initialized, no transfers performed",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.transferCount === 0 && window.__3D_STATE__.mixingVesselVolume === 0)"
    },
    {
      "id": "S1",
      "name": "First Transfer Complete",
      "description": "User has performed at least one reagent transfer, mixing vessel contains non-zero volume",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.transferCount > 0 && window.__3D_STATE__.mixingVesselVolume > 0"
    },
    {
      "id": "S2",
      "name": "Indicator Added",
      "description": "Indicator has been added to mixing vessel, indicatorAdded flag is true",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.indicatorAdded === true"
    },
    {
      "id": "S3",
      "name": "Thermal Manipulation",
      "description": "Heat or cool applied at least once, reactionRateMultiplier differs from 1.0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heatCycleCount > 0 && window.__3D_STATE__.reactionRateMultiplier !== 1.0"
    },
    {
      "id": "S4",
      "name": "Neutralization Achieved",
      "description": "Mixing vessel pH is within neutral range 6.8-7.2, neutralizationAchieved is true",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.neutralizationAchieved === true && window.__3D_STATE__.mixingVesselPH >= 6.8 && window.__3D_STATE__.mixingVesselPH <= 7.2"
    },
    {
      "id": "S5",
      "name": "Multi-Transfer Active",
      "description": "Multiple transfers completed, transferCount >= 3, conservation of mass maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.transferCount >= 3"
    },
    {
      "id": "S6",
      "name": "Stable Neutral State",
      "description": "Neutralization maintained for extended period with all state values stable",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.neutralizationAchieved === true && window.__3D_STATE__.mixingVesselPH >= 6.5 && window.__3D_STATE__.mixingVesselPH <= 7.5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Transfer')) b.click(); }); setTimeout(() => { const cups = document.querySelectorAll('canvas'); if(cups.length > 0) cups[0].click(); setTimeout(() => { if(cups.length > 3) cups[3].click(); }, 500); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "At least one transfer operation has been executed",
        "Mixing vessel volume is greater than zero",
        "Transfer count has incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.transferCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.transferCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.mixingVesselVolume > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); if(canvas) canvas.click(); setTimeout(() => { document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Add Indicator')) b.click(); }); }, 800);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Indicator has been added to mixing vessel",
        "indicatorAdded flag is true",
        "Mixing vessel volume increased by 2 mL"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.indicatorAdded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.indicatorAdded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.mixingVesselVolume >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Heat')) b.click(); });",
        "wait_ms": 1200
      },
      "postconditions": [
        "Heat cycle count has incremented",
        "Reaction rate multiplier has changed from default 1.0",
        "Thermal manipulation applied"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.heatCycleCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heatCycleCount > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionRateMultiplier === 'number' && window.__3D_STATE__.reactionRateMultiplier !== 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<2; i++) { setTimeout(() => { document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Transfer')) b.click(); }); setTimeout(() => { const canvas = document.querySelector('canvas'); if(canvas) { canvas.click(); setTimeout(() => canvas.click(), 400); } }, 300); }, i * 1500); }",
        "wait_ms": 4000
      },
      "postconditions": [
        "Multiple transfers completed, transferCount >= 3",
        "Conservation of mass maintained across all vessels",
        "Total moles remain constant"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.transferCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalMolesAcid === 'number' && typeof window.__3D_STATE__.totalMolesBase === 'number'",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalMolesAcid) && isFinite(window.__3D_STATE__.totalMolesBase)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 5; slider.dispatchEvent(new Event('input')); } setTimeout(() => { document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Transfer')) b.click(); }); setTimeout(() => { const canvas = document.querySelector('canvas'); if(canvas) { canvas.click(); setTimeout(() => canvas.click(), 500); } }, 400); }, 600);",
        "wait_ms": 2500
      },
      "postconditions": [
        "pH has been calculated and is within neutral range 6.8-7.2",
        "neutralizationAchieved flag is true",
        "Mixing vessel contains balanced acid-base solution"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mixingVesselPH === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mixingVesselPH >= 6.8 && window.__3D_STATE__.mixingVesselPH <= 7.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.neutralizationAchieved === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('button').forEach(b => { if(b.textContent.includes('Stir')) b.click(); });",
        "wait_ms": 1500
      },
      "postconditions": [
        "Stir animation triggered on mixing vessel",
        "Neutralization state maintained",
        "All state values remain stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stirAnimationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.neutralizationAchieved === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.mixingVesselPH - 7.0) < 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Neutralization maintained throughout wait period",
        "No state corruption or drift"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.neutralizationAchieved === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.mixingVesselPH) && window.__3D_STATE__.mixingVesselPH >= 6.5 && window.__3D_STATE__.mixingVesselPH <= 7.5",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.transferCount) && window.__3D_STATE__.transferCount >= 3",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
