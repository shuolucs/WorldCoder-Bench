{
  "task_id": "P2909",
  "affordances": [
    {
      "id": "A1",
      "name": "Godrays Chamber",
      "type": "3d_object",
      "semantic": "UV light source chamber with volumetric godrays",
      "locator_hints": [
        "godrays_demo.glb",
        "center of scene",
        "volumetric light emitter"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Gear Control Panel",
      "type": "3d_object",
      "semantic": "Mechanical gears controlling reaction parameters",
      "locator_hints": [
        "gears.glb",
        "left side",
        "interlocking gears"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.gears && window.__3D_STATE__.gears.length > 0)"
    },
    {
      "id": "A3",
      "name": "Gear 1 - Reagent A Flow",
      "type": "interaction",
      "semantic": "Click to select, scroll to adjust Reagent A flow (0-10 mol/s)",
      "locator_hints": [
        "first gear",
        "controls reagentAFlow"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "Gear 2 - Reagent B Flow",
      "type": "interaction",
      "semantic": "Click to select, scroll to adjust Reagent B flow (0-10 mol/s)",
      "locator_hints": [
        "second gear",
        "controls reagentBFlow"
      ],
      "check": "true"
    },
    {
      "id": "A5",
      "name": "Gear 3 - Catalyst Concentration",
      "type": "interaction",
      "semantic": "Click to select, scroll to adjust catalyst concentration (0-5 mol/L)",
      "locator_hints": [
        "third gear",
        "controls catalystConcentration"
      ],
      "check": "true"
    },
    {
      "id": "A6",
      "name": "Light Intensity Slider",
      "type": "interaction",
      "semantic": "Adjusts UV godrays intensity (0-100%)",
      "locator_hints": [
        "slider control",
        "adjusts lightIntensity"
      ],
      "check": "true"
    },
    {
      "id": "A7",
      "name": "HUD Overlay",
      "type": "dom_element",
      "semantic": "Displays flow rates, catalyst level, yield, and mass balance",
      "locator_hints": [
        "overlay",
        "real-time parameter display"
      ],
      "check": "!!document.getElementById('overlay') || document.querySelectorAll('[class*=\"overlay\"]').length > 0"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_idle",
      "description": "Scene loaded, all parameters at zero, no reaction occurring",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.reagentAFlow === 0 && window.__3D_STATE__.reagentBFlow === 0 && window.__3D_STATE__.catalystConcentration === 0)"
    },
    {
      "id": "S1",
      "name": "reagent_a_flowing",
      "description": "Reagent A flow initiated, system accumulating input moles",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reagentAFlow > 0 && window.__3D_STATE__.reagentBFlow === 0"
    },
    {
      "id": "S2",
      "name": "dual_reagent_flow",
      "description": "Both reagents flowing, reaction beginning with catalyst present",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reagentAFlow > 0 && window.__3D_STATE__.reagentBFlow > 0 && window.__3D_STATE__.catalystConcentration > 0 && window.__3D_STATE__.reactionYield < 30"
    },
    {
      "id": "S3",
      "name": "optimal_reaction",
      "description": "Stoichiometric balance achieved, high yield production",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reactionYield >= 30 && window.__3D_STATE__.reactionYield < 50 && window.__3D_STATE__.catalystConcentration <= 3"
    },
    {
      "id": "S4",
      "name": "catalyst_boosted",
      "description": "Catalyst concentration increased, yield efficiency improved",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.catalystConcentration > 3 && window.__3D_STATE__.reactionYield >= 50 && window.__3D_STATE__.lightIntensity < 50"
    },
    {
      "id": "S5",
      "name": "light_modulated",
      "description": "UV light intensity adjusted, affecting reaction environment",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lightIntensity >= 50 && window.__3D_STATE__.reactionYield < 60"
    },
    {
      "id": "S6",
      "name": "steady_state_production",
      "description": "Continuous production with stable mass balance and yield",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reactionYield >= 60 && window.__3D_STATE__.totalOutputMoles > 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const gear1 = window.__3D_STATE__.gears?.[0]; if (gear1) { gear1.click(); for(let i=0; i<5; i++) { gear1.dispatchEvent(new WheelEvent('wheel', {deltaY: -100})); } }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Reagent A flow rate increased above zero",
        "Total input moles begins accumulating",
        "HUD displays non-zero Reagent A flow"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reagentAFlow === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reagentAFlow > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.reagentAFlow <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalInputMoles > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalInputMoles)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const gear2 = window.__3D_STATE__.gears?.[1]; if (gear2) { gear2.click(); for(let i=0; i<8; i++) { gear2.dispatchEvent(new WheelEvent('wheel', {deltaY: -100})); } } const gear3 = window.__3D_STATE__.gears?.[2]; if (gear3) { gear3.click(); for(let i=0; i<3; i++) { gear3.dispatchEvent(new WheelEvent('wheel', {deltaY: -100})); } }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Reagent B flow initiated",
        "Catalyst concentration set above zero",
        "Reaction yield begins to register",
        "Output moles start accumulating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reagentBFlow > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.catalystConcentration > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionYield === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalOutputMoles !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.reagentBFlow)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.catalystConcentration <= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const gear1 = window.__3D_STATE__.gears?.[0]; const gear2 = window.__3D_STATE__.gears?.[1]; if (gear1 && gear2) { gear1.click(); const targetA = 4; const currentA = window.__3D_STATE__.reagentAFlow || 0; const deltaA = Math.round((targetA - currentA) * 2); for(let i=0; i<Math.abs(deltaA); i++) { gear1.dispatchEvent(new WheelEvent('wheel', {deltaY: deltaA > 0 ? -50 : 50})); } gear2.click(); const targetB = 8; const currentB = window.__3D_STATE__.reagentBFlow || 0; const deltaB = Math.round((targetB - currentB) * 2); for(let i=0; i<Math.abs(deltaB); i++) { gear2.dispatchEvent(new WheelEvent('wheel', {deltaY: deltaB > 0 ? -50 : 50})); } }",
        "wait_ms": 2500
      },
      "postconditions": [
        "Reagent A and B flows approach 1:2 stoichiometric ratio",
        "Reaction yield increases significantly",
        "Mass balance stabilizes with minimal unreacted moles"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reagentAFlow > 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reagentBFlow > 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionYield > 30",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.reagentBFlow / window.__3D_STATE__.reagentAFlow - 2) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalOutputMoles > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const gear3 = window.__3D_STATE__.gears?.[2]; if (gear3) { gear3.click(); for(let i=0; i<6; i++) { gear3.dispatchEvent(new WheelEvent('wheel', {deltaY: -100})); } }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Catalyst concentration increased to near maximum",
        "Reaction yield improves due to catalyst efficiency",
        "Output moles accumulation rate increases"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.catalystConcentration > 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionYield > 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.catalystConcentration - 4.5) < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalOutputMoles > window.__3D_STATE__.totalInputMoles * 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.reactionYield)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.unreactedMoles !== null",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if (slider) { slider.value = 75; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "UV light intensity increased to 75%",
        "Godrays visual intensity reflects new setting",
        "Light intensity state updated in __3D_STATE__"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lightIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity > 50",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lightIntensity - 75) < 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity <= 100",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lightIntensity)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "System reaches steady state production",
        "Mass balance stabilizes with consistent input/output ratio",
        "All parameters remain within valid ranges",
        "Yield percentage stabilizes at high efficiency"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactionYield > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalOutputMoles > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalInputMoles > window.__3D_STATE__.totalOutputMoles",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.totalInputMoles))",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.unreactedMoles >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.unreactedMoles)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second stability run completed",
        "All state fields remain valid and finite",
        "Mass balance maintained throughout extended operation",
        "No numerical instabilities or state corruption"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "isFinite(window.__3D_STATE__.reagentAFlow)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.reagentBFlow)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.catalystConcentration)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.reactionYield)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalInputMoles > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalOutputMoles > 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
