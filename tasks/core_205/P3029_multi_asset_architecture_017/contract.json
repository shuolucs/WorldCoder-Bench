{
  "task_id": "P3029",
  "affordances": [
    {
      "id": "A1",
      "name": "Wall Color Picker",
      "type": "dom_element",
      "semantic": "Color input that changes the back wall plane material color",
      "locator_hints": [
        "input[type='color']",
        "label containing 'Wall Color'"
      ],
      "check": "!!document.querySelector('input[type=\"color\"]')"
    },
    {
      "id": "A2",
      "name": "Ambient Intensity Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling ambient light intensity from 0.0 to 2.0",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Ambient Intensity'"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"range\"]')).some(s => s.previousElementSibling?.textContent.includes('Ambient') || s.nextElementSibling?.textContent.includes('Ambient'))"
    },
    {
      "id": "A3",
      "name": "Accent Spotlight Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling spotlight intensity on shader ball from 0.0 to 3.0",
      "locator_hints": [
        "input[type='range']",
        "label containing 'Accent Spotlight'"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"range\"]')).some(s => s.previousElementSibling?.textContent.includes('Accent') || s.nextElementSibling?.textContent.includes('Accent') || s.previousElementSibling?.textContent.includes('Spotlight') || s.nextElementSibling?.textContent.includes('Spotlight'))"
    },
    {
      "id": "A4",
      "name": "Move Sofa Left Button",
      "type": "dom_element",
      "semantic": "Button that translates sofa -0.5 units along X axis",
      "locator_hints": [
        "button",
        "text containing 'Left'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Left'))"
    },
    {
      "id": "A5",
      "name": "Move Sofa Right Button",
      "type": "dom_element",
      "semantic": "Button that translates sofa +0.5 units along X axis",
      "locator_hints": [
        "button",
        "text containing 'Right'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Right'))"
    },
    {
      "id": "A6",
      "name": "ShaderBall2 Model",
      "type": "3d_object",
      "semantic": "Material preview sphere on cylindrical pedestal at (-2, 1, 0)",
      "locator_hints": [
        "ShaderBall2.glb",
        "pedestal cylinder"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.isShaderBallVisible)"
    },
    {
      "id": "A7",
      "name": "GlamVelvetSofa Model",
      "type": "3d_object",
      "semantic": "Luxury sofa positioned on reflective floor, movable along X axis",
      "locator_hints": [
        "GlamVelvetSofa.glb",
        "sofa mesh"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.sofaPositionX === 'number')"
    },
    {
      "id": "A8",
      "name": "Reflective Floor Plane",
      "type": "3d_object",
      "semantic": "20x20 metallic floor with grid helper beneath",
      "locator_hints": [
        "MeshStandardMaterial",
        "floor plane",
        "metalness 0.8"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loads with default wall color, ambient at 1.0, spotlight at 1.5, sofa at X=1.5",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.wallColor === '#e8e0d4' && window.__3D_STATE__.ambientIntensity === 1.0 && window.__3D_STATE__.accentSpotlightIntensity === 1.5 && window.__3D_STATE__.sofaPositionX === 1.5)"
    },
    {
      "id": "S1",
      "name": "Wall Color Changed",
      "description": "User has modified the wall color from default beige",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.wallColor !== '#e8e0d4'"
    },
    {
      "id": "S2",
      "name": "Ambient Light Adjusted",
      "description": "Ambient intensity has been changed from initial value",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ambientIntensity !== 1.0"
    },
    {
      "id": "S3",
      "name": "Spotlight Focused",
      "description": "Accent spotlight intensity modified to highlight shader ball",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.accentSpotlightIntensity !== 1.5"
    },
    {
      "id": "S4",
      "name": "Sofa Repositioned",
      "description": "Sofa has been moved left or right from initial position",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaPositionX !== 1.5"
    },
    {
      "id": "S5",
      "name": "Multi-Parameter Configuration",
      "description": "Multiple controls adjusted, sofa moved multiple times",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaMoveCount >= 3"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "All interactions complete, scene stable for 60 seconds",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"color\"]').value = '#a8d5ba'; document.querySelector('input[type=\"color\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wall color changed to light green (#a8d5ba)",
        "wallColor state reflects new hex value"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.wallColor === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.wallColor !== '#e8e0d4'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent.includes('Ambient') || s.nextElementSibling?.textContent.includes('Ambient')); if(slider) { slider.value = '1.8'; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Ambient light intensity increased to 1.8",
        "Scene brightness increased noticeably"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.ambientIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ambientIntensity > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.ambientIntensity - 1.8) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent.includes('Accent') || s.nextElementSibling?.textContent.includes('Accent') || s.previousElementSibling?.textContent.includes('Spotlight') || s.nextElementSibling?.textContent.includes('Spotlight')); if(slider) { slider.value = '2.5'; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Spotlight intensity set to 2.5",
        "Shader ball illumination increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.accentSpotlightIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.accentSpotlightIntensity > 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.accentSpotlightIntensity - 2.5) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rightBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Right')); if(rightBtn) { rightBtn.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Sofa moved +0.5 units along X axis",
        "Sofa position X increased from 1.5 to 2.0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sofaPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaPositionX > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sofaPositionX - 2.0) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const leftBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Left')); if(leftBtn) { leftBtn.click(); setTimeout(() => leftBtn.click(), 300); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Sofa moved left twice (-1.0 total)",
        "Move count incremented to at least 3"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sofaMoveCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaMoveCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.sofaMoveCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"color\"]').value = '#f4e4c1'; document.querySelector('input[type=\"color\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wall color changed again to warm beige",
        "All state fields remain valid and finite"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.wallColor !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isShaderBallVisible === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDistance) && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rightBtn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Right')); if(rightBtn) { rightBtn.click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Final sofa adjustment complete",
        "All lighting and material parameters stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.pedestalHeight === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pedestalHeight >= 0.9",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pedestalHeight - 1.0) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values remain valid and unchanged"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.sofaPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaMoveCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.ambientIntensity) && isFinite(window.__3D_STATE__.accentSpotlightIntensity)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
