      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.decorationScale === 0.7"
    },
    {
      "id": "S5",
      "name": "DesignSaved",
      "conditions": [
        "window.__3D_STATE__.designCount >= 1",
        "window.__3D_STATE__.savedState !== null"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.designCount >= 1 && window.__3D_STATE__.savedState !== null"
    },
    {
      "id": "S6",
      "name": "ResetDone",
      "conditions": [
        "window.__3D_STATE__.caseColor === '#3498db'",
        "window.__3D_STATE__.decorationVisible === true",
        "window.__3D_STATE__.decorationScale === 0.3"
