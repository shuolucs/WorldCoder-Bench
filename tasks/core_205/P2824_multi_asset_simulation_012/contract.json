{
  "task_id": "P2824",
  "affordances": [
    {
      "id": "A1",
      "name": "Add Ball Button",
      "type": "dom_element",
      "semantic": "Button to spawn new shader balls up to maximum of 6",
      "locator_hints": [
        "button",
        "text contains '+'",
        "overlay panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('+'))"
    },
    {
      "id": "A2",
      "name": "Shader Ball Objects",
      "type": "3d_object",
      "semantic": "Cloned shader ball instances with temperature properties",
      "locator_hints": [
        "ShaderBall2.glb",
        "draggable",
        "color changes with temperature"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ballCount > 0)"
    },
    {
      "id": "A3",
      "name": "Coffee Mat Surface",
      "type": "3d_object",
      "semantic": "Heat-conducting surface with 3x2 grid snap positions",
      "locator_hints": [
        "coffeemat.glb",
        "centered at origin",
        "ground plane"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Temperature Slider",
      "type": "dom_element",
      "semantic": "Slider control for adjusting selected ball temperature 0-500K",
      "locator_hints": [
        "input type range",
        "appears on ball selection",
        "0-500 range"
      ],
      "check": "!!document.querySelector('input[type=range]')"
    },
    {
      "id": "A5",
      "name": "Simulate Button",
      "type": "dom_element",
      "semantic": "Button to start thermal simulation with heat transfer",
      "locator_hints": [
        "button",
        "text contains 'Simulate'",
        "overlay panel"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Simulate'))"
    },
    {
      "id": "A6",
      "name": "Ball Selection Interaction",
      "type": "interaction",
      "semantic": "Raycasting click to select balls and show temperature controls",
      "locator_hints": [
        "mouse click",
        "raycaster",
        "ball selection"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with coffee mat, no balls spawned, simulation inactive",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.ballCount === 0 && window.__3D_STATE__.simulationActive === false)"
    },
    {
      "id": "S1",
      "name": "Balls Spawned",
      "description": "Multiple shader balls created in staging area, ready for placement",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballCount >= 3 && window.__3D_STATE__.ballsOnMat === 0"
    },
    {
      "id": "S2",
      "name": "Balls Positioned",
      "description": "Balls dragged onto mat grid positions, temperatures configured",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.ballsOnMat > 0 && window.__3D_STATE__.simulationActive === false"
    },
    {
      "id": "S3",
      "name": "Simulation Running",
      "description": "Active heat transfer between adjacent balls, energy conserved",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simulationActive === true && window.__3D_STATE__.totalSystemEnergy > 0"
    },
    {
      "id": "S4",
      "name": "Thermal Equilibrium Approaching",
      "description": "Temperature differences decreasing, heat transfer rate declining",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simulationActive === true && window.__3D_STATE__.simulationTime > 0 && window.__3D_STATE__.maxTemperatureBall >= 0 && window.__3D_STATE__.minTemperatureBall >= 0"
    },
    {
      "id": "S5",
      "name": "Steady State",
      "description": "System reached thermal equilibrium, minimal energy exchange",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simulationActive === true && window.__3D_STATE__.heatTransferRate >= 0 && Math.abs(window.__3D_STATE__.energyConservationError) < 0.01"
    },
    {
      "id": "S6",
      "name": "Long-term Stability",
      "description": "Simulation stable for extended period with energy conservation maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simulationActive === true && window.__3D_STATE__.simulationTime > 15 && Math.abs(window.__3D_STATE__.energyConservationError) < 0.05"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click(); await new Promise(r => setTimeout(r, 500)); document.querySelector('button').click(); await new Promise(r => setTimeout(r, 500)); document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "At least 3 shader balls spawned",
        "Ball count increased from 0",
        "Balls visible in staging area"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.ballCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballCount >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.ballCount <= 6 && Number.isInteger(window.__3D_STATE__.ballCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Balls placed on mat grid positions",
        "Balls on mat count greater than zero",
        "Temperatures configured for balls"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.ballsOnMat === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballsOnMat > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.ballsOnMat <= window.__3D_STATE__.ballCount && window.__3D_STATE__.ballsOnMat <= 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Simulate'))?.click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Simulation activated",
        "Total system energy calculated and tracked",
        "Heat transfer rate computed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalSystemEnergy > 0 && isFinite(window.__3D_STATE__.totalSystemEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Simulation time progressed",
        "Temperature extremes recorded",
        "Average mat temperature computed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.maxTemperatureBall >= 0 && window.__3D_STATE__.minTemperatureBall >= 0 && window.__3D_STATE__.maxTemperatureBall >= window.__3D_STATE__.minTemperatureBall",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Heat transfer rate decreased significantly",
        "Energy conservation maintained",
        "Average mat temperature stabilized"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.heatTransferRate === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heatTransferRate >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyConservationError) < 0.01 && isFinite(window.__3D_STATE__.averageMatTemperature)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 10000
      },
      "postconditions": [
        "Simulation continues running stably",
        "Energy conservation error remains minimal",
        "All state values remain valid and finite"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.simulationActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simulationTime > 15",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyConservationError) < 0.05 && isFinite(window.__3D_STATE__.totalSystemEnergy)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintains stability for 60 seconds",
        "No crashes or errors",
        "Energy conservation holds throughout"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.simulationActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.ballCount >= 0 && window.__3D_STATE__.ballsOnMat >= 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalSystemEnergy) && Math.abs(window.__3D_STATE__.energyConservationError) < 0.1",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
