  "states": [
    {
      "id": "S0",
      "name": "Initial_Gen0",
      "conditions": [
        "window.__3D_STATE__.generation === 0",
        "window.__3D_STATE__.totalSegments === 1",
        "window.__3D_STATE__.colorMode === 'natural'",
        "window.__3D_STATE__.windActive === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.generation === 0 && window.__3D_STATE__.totalSegments === 1 && window.__3D_STATE__.colorMode === 'natural' && window.__3D_STATE__.windActive === false"
    },
    {
      "id": "S1",
      "name": "Gen1_Growing",
      "conditions": [
        "window.__3D_STATE__.isAnimating === true",
        "window.__3D_STATE__.generation === 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isAnimating === true && window.__3D_STATE__.generation === 1"
    },
    {
      "id": "S2",
      "name": "Gen1_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.isAnimating === false",
        "window.__3D_STATE__.totalSegments > 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.generation === 1 && window.__3D_STATE__.isAnimating === false && window.__3D_STATE__.totalSegments > 1"
    },
    {
      "id": "S3",
      "name": "Gen2_Complete",
      "conditions": [
        "window.__3D_STATE__.generation === 2",
        "window.__3D_STATE__.isAnimating === false",
        "window.__3D_STATE__.totalSegments > window.__3D_STATE__.segmentsPerGeneration[1]"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.generation === 2 && window.__3D_STATE__.isAnimating === false && window.__3D_STATE__.segmentsPerGeneration && window.__3D_STATE__.totalSegments > window.__3D_STATE__.segmentsPerGeneration[1]"
    },
    {
      "id": "S4",
      "name": "WindActive",
      "conditions": [
        "window.__3D_STATE__.windActive === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.windActive === true"
    },
    {
      "id": "S5",
      "name": "RainbowMode",
      "conditions": [
        "window.__3D_STATE__.colorMode === 'rainbow'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.colorMode === 'rainbow'"
    },
    {
      "id": "S6",
      "name": "AngleRandomized",
      "conditions": [
        "window.__3D_STATE__.branchAngle >= 15",
        "window.__3D_STATE__.branchAngle <= 35"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.branchAngle >= 15 && window.__3D_STATE__.branchAngle <= 35"
    },
    {
      "id": "S7",
      "name": "PrunedBack_Gen1",
      "conditions": [
        "window.__3D_STATE__.generation === 1",
        "window.__3D_STATE__.isAnimating === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.generation === 1 && window.__3D_STATE__.isAnimating === false"
    },
    {
      "id": "S_stable_60s",
      "name": "stable_60s",
      "description": "60-second stability run — simulation running without errors",
      "condition": "true"
    }
