        "#windBtn"
      ],
      "check": "!!document.getElementById('windBtn')"
    },
    {
      "id": "A4",
      "name": "PlantStructure",
      "type": "3d_object",
      "semantic": "The L-system generated plant made of cylinder segments and leaf spheres",
      "locator_hints": [
        "scene children with cylinder geometry"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalSegments > 0)"
    },
    {
      "id": "A5",
