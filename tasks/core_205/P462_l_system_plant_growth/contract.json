{
  "task_id": "P462_l_system_plant_growth",
  "affordances": [
    {
      "id": "A1",
      "name": "GrowButton",
      "type": "dom_element",
      "semantic": "Button to advance L-system generation",
      "locator_hints": [
        "#growBtn"
      ],
      "check": "!!document.getElementById('growBtn')"
    },
    {
      "id": "A2",
      "name": "PruneButton",
      "type": "dom_element",
      "semantic": "Button to reduce L-system generation",
      "locator_hints": [
        "#pruneBtn"
      ],
      "check": "!!document.getElementById('pruneBtn')"
    },
    {
      "id": "A3",
      "name": "WindButton",
      "type": "dom_element",
      "semantic": "Button to toggle wind sway",
