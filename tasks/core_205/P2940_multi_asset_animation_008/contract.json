      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const x = rect.left + rect.width * 0.3; const y = rect.top + rect.height * 0.5; canvas.dispatchEvent(new MouseEvent('click', {clientX: x, clientY: y, bubbles: true}));",
        "wait_ms": 1200
      },
      "postconditions": [
        "First object selected",
        "selectedObjectIndex set to 0, 1, or 2"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
