  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene loaded with three models in tank, no selection, no waypoints",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.selectedObjectIndex === undefined && window.__3D_STATE__.totalWaypoints === 0)"
    },
    {
      "id": "S1",
      "name": "object_selected",
      "description": "One object selected with emissive outline, ready for waypoint placement",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.selectedObjectIndex === 'number' && window.__3D_STATE__.selectedObjectIndex >= 0 && window.__3D_STATE__.totalWaypoints === 0"
    },
    {
      "id": "S2",
      "name": "waypoints_placed",
      "description": "Multiple waypoints created across objects, timeline markers visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalWaypoints > 0 && window.__3D_STATE__.isPlaying === false"
    },
    {
      "id": "S3",
      "name": "animation_playing",
      "description": "Timeline playing, objects moving along spline paths, energy updating",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.currentTimelinePosition > 0"
    },
    {
      "id": "S4",
      "name": "energy_constrained",
      "description": "Total kinetic energy approaching or at budget limit",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.totalKineticEnergy === 'number' && typeof window.__3D_STATE__.energyBudget === 'number' && window.__3D_STATE__.totalKineticEnergy <= window.__3D_STATE__.energyBudget"
    },
    {
      "id": "S5",
      "name": "timeline_adjusted",
      "description": "User dragged timeline markers, waypoint timing modified",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoStackDepth > 0 && window.__3D_STATE__.totalWaypoints > 0"
    },
    {
      "id": "S6",
      "name": "stability_run",
      "description": "60-second continuous animation with energy conservation maintained",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && isFinite(window.__3D_STATE__.totalKineticEnergy) && window.__3D_STATE__.totalKineticEnergy >= 0 && window.__3D_STATE__.totalKineticEnergy <= window.__3D_STATE__.energyBudget * 1.01"
    }
  ],
