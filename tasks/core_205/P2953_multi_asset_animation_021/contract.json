{
  "task_id": "P2953",
  "affordances": [
    {
      "id": "A1",
      "name": "Speed Slider",
      "type": "dom_element",
      "semantic": "Range input slider controlling gear rotation and animation speed",
      "locator_hints": [
        "input[type='range']",
        "slider with min 0.1 max 3.0"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A2",
      "name": "Direction Toggle Button",
      "type": "dom_element",
      "semantic": "Button that reverses gear rotation and animation playback direction",
      "locator_hints": [
        "button containing 'direction' or 'reverse'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A3",
      "name": "Engagement Checkbox",
      "type": "dom_element",
      "semantic": "Checkbox controlling whether gears engage with drive shaft",
      "locator_hints": [
        "input[type='checkbox']",
        "checkbox for engagement"
      ],
      "check": "!!document.querySelector('input[type=\"checkbox\"]')"
    },
    {
      "id": "A4",
      "name": "Gear Meshes",
      "type": "3d_object",
      "semantic": "3D gear models loaded from gears.glb positioned at left side",
      "locator_hints": [
        "meshes from gears.glb",
        "objects at position (-2, 0, 0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.gearMeshCount > 0)"
    },
    {
      "id": "A5",
      "name": "Animated Box",
      "type": "3d_object",
      "semantic": "Animated box model from BoxAnimated.glb positioned at right side",
      "locator_hints": [
        "mesh from BoxAnimated.glb",
        "object at position (2, 0, 0)"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.boxAnimationTime === 'number')"
    },
    {
      "id": "A6",
      "name": "Drive Shaft",
      "type": "3d_object",
      "semantic": "Cylindrical mesh connecting gears to box as mechanical linkage",
      "locator_hints": [
        "cylinder mesh between gears and box"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.driveShaftRotation === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with gears and box models, default speed and engaged state",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Speed Adjusted",
      "description": "User has adjusted speed slider, gear and animation speeds updated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gearRotationSpeed > 0 && window.__3D_STATE__.isEngaged === true && window.__3D_STATE__.isReversed === false"
    },
    {
      "id": "S2",
      "name": "Direction Reversed",
      "description": "Animation direction toggled, gears and box animating in reverse",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isReversed === true && window.__3D_STATE__.isEngaged === true"
    },
    {
      "id": "S3",
      "name": "Disengaged State",
      "description": "Gears disengaged, drive shaft stopped, box animation paused",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isEngaged === false && window.__3D_STATE__.isAnimationPlaying === false"
    },
    {
      "id": "S4",
      "name": "Re-engaged State",
      "description": "Gears re-engaged, drive shaft rotating, box animation resumed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isEngaged === true && window.__3D_STATE__.isAnimationPlaying === true"
    },
    {
      "id": "S5",
      "name": "Timing Adjusted",
      "description": "Fine-tuning offset applied to animation timing parameters",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.timingOffset === 'number' && window.__3D_STATE__.timingOffset > 0"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running stably with all parameters validated and consistent",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.gearMeshCount > 0 && Number.isFinite(window.__3D_STATE__.driveShaftRotation) && Number.isFinite(window.__3D_STATE__.boxAnimationTime)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 2.5; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Speed slider value set to 2.5",
        "Gear rotation speed increased to match slider value",
        "Box animation timeScale updated to 2.5"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.gearRotationSpeed === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gearRotationSpeed > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.boxAnimationTimeScale - 2.5) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Direction toggle button clicked",
        "isReversed state changed to true",
        "Gear rotation direction reversed",
        "Box animation playing in reverse"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isReversed === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isReversed === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.boxAnimationTimeScale < 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"checkbox\"]').checked = false; document.querySelector('input[type=\"checkbox\"]').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Engagement checkbox unchecked",
        "isEngaged state set to false",
        "Drive shaft rotation stopped",
        "Box animation paused while gears continue"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isEngaged === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isEngaged === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimationPlaying === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"checkbox\"]').checked = true; document.querySelector('input[type=\"checkbox\"]').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Engagement checkbox re-checked",
        "isEngaged state set to true",
        "Drive shaft rotation resumed",
        "Box animation playing again"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isEngaged === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isEngaged === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isAnimationPlaying === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 1.0; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Speed slider adjusted to 1.0",
        "Gear rotation speed normalized",
        "Box animation timeScale set to 1.0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.boxAnimationTimeScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gearRotationSpeed >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(Math.abs(window.__3D_STATE__.boxAnimationTimeScale) - 1.0) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S1",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "if(document.querySelector('input[type=\"number\"]')) { document.querySelector('input[type=\"number\"]').value = 150; document.querySelector('input[type=\"number\"]').dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Timing offset input set to 150ms",
        "timingOffset state updated",
        "Animation timing adjusted with offset"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.timingOffset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.timingOffset >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.timingOffset)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "All state fields remain stable",
        "Drive shaft rotation continuous",
        "Box animation playing smoothly",
        "Gear meshes loaded and rotating"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.driveShaftRotation === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gearMeshCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.driveShaftRotation) && Number.isFinite(window.__3D_STATE__.boxAnimationTime)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All animations continue without errors",
        "State values remain valid and consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isAnimationPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.gearMeshCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.gearRotationSpeed) && Number.isFinite(window.__3D_STATE__.boxAnimationTimeScale)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
