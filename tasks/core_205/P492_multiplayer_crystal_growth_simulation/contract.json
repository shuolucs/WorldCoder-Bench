        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isResonance === false",
        "window.__3D_STATE__.growthMode === 'linear'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sceneReady === true && window.__3D_STATE__.totalCrystals === 0 && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.isResonance === false && window.__3D_STATE__.growthMode === 'linear'"
