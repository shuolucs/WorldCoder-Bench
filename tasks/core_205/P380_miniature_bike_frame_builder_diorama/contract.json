      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedPart !== null"
    },
    {
      "id": "S2",
      "name": "PartMoved",
      "conditions": [
        "window.__3D_STATE__.selectedPart !== null"
      ],
