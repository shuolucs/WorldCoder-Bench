      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Move the down tube close to its assembly zone then snap it\nfunction simulateKey(key, count) { for(let i=0;i<count;i++) { window.dispatchEvent(new KeyboardEvent('keydown', {key})); } }\nsimulatKey = simulateKey; simulateKey('ArrowLeft', 15); simulateKey('ArrowUp', 3); setTimeout(()=>{ window.dispatchEvent(new KeyboardEvent('keydown', {key:' '})); }, 200);",
        "description": "Move down tube to its assembly zone and press Space to snap it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "script",
        "code": "// Click on seat tube to select it, then rotate it\nconst canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const evt = new MouseEvent('click', {clientX: rect.left + rect.width * 0.75, clientY: rect.top + rect.height * 0.5}); canvas.dispatchEvent(evt); setTimeout(()=>{ window.dispatchEvent(new KeyboardEvent('keydown', {key:'r'})); window.dispatchEvent(new KeyboardEvent('keydown', {key:'R'})); }, 300);",
        "description": "Select the seat tube and press R to rotate it"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Programmatically snap seatTube and topTube to their zones via state manipulation test\n// Move seatTube near zone 2 and snap\nfunction simulateKey(key) { window.dispatchEvent(new KeyboardEvent('keydown', {key})); }\nfor(let i=0;i<20;i++) simulateKey('ArrowLeft'); for(let i=0;i<3;i++) simulateKey('ArrowUp'); setTimeout(()=>simulateKey(' '), 200);",
        "description": "Move the selected tube to its assembly zone and snap it, achieving 2+ snapped parts"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "// Force all parts snapped to test completion state\nif(window.__3D_STATE__ && typeof window.__forceSnapAll === 'function') { window.__forceSnapAll(); } else { /* The test expects the completion state to be reachable */ const keys = ['downTube','seatTube','topTube','headTube','chainStay']; keys.forEach(k => { if(window.__3D_STATE__.partSnappedStatus[k] !== true && window.__snapPart) window.__snapPart(k); }); }",
        "description": "Snap all remaining parts to complete the frame assembly"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S7",
      "severity": "P1",
      "action": {
        "type": "wait",
        "duration_ms": 2500,
        "description": "Wait for the celebration spin animation to complete"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.left !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.center !== undefined",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('complete-msg') !== null",
            "tier": "L2"
          },
          {
            "expr": "document.getElementById('complete-msg').textContent.includes('Complete') || document.getElementById('complete-msg').innerText.includes('Complete')",
            "tier": "L2"
          }
        ]
      }
    }
