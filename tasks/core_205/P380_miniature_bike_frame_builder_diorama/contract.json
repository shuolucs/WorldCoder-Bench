  "states": [
    {
      "id": "S0",
      "name": "Initial_AllPartsInTray",
      "conditions": [
        "window.__3D_STATE__.partsSnapped === 0",
        "window.__3D_STATE__.selectedPart === null",
        "window.__3D_STATE__.isComplete === false",
        "window.__3D_STATE__.assemblyPercent === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.partsSnapped === 0 && window.__3D_STATE__.selectedPart === null && window.__3D_STATE__.isComplete === false && window.__3D_STATE__.assemblyPercent === 0"
    },
    {
      "id": "S1",
      "name": "PartSelected",
      "conditions": [
        "window.__3D_STATE__.selectedPart !== null"
