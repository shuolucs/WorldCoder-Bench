            "expr": "window.__3D_STATE__.simulationTime >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.frameCount >= 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.segmentCount > 0",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
