      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.timeSpeed === 1.0 && window.__3D_STATE__.segmentCount === 6"
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S3",
      "name": "SpedUp",
      "conditions": [
        "window.__3D_STATE__.timeSpeed > 1.0",
        "window.__3D_STATE__.isPaused === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.timeSpeed > 1.0 && window.__3D_STATE__.isPaused === false"
    },
    {
      "id": "S4",
      "name": "Reversed",
      "conditions": [
        "window.__3D_STATE__.timeSpeed < 0",
        "window.__3D_STATE__.isReversing === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.timeSpeed < 0 && window.__3D_STATE__.isReversing === true"
    },
    {
      "id": "S5",
      "name": "MoreSegments",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 8"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.segmentCount === 8"
    },
    {
      "id": "S6",
      "name": "FewerSegments",
      "conditions": [
        "window.__3D_STATE__.segmentCount === 4"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.segmentCount === 4"
    },
    {
      "id": "S7",
      "name": "ColorShiftOn",
      "conditions": [
        "window.__3D_STATE__.colorShiftEnabled === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.colorShiftEnabled === true"
    },
    {
      "id": "S8",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.simulationTime === 0",
        "window.__3D_STATE__.timeSpeed === 1.0",
        "window.__3D_STATE__.segmentCount === 6",
        "window.__3D_STATE__.isPaused === false"
