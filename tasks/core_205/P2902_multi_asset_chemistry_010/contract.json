{
  "task_id": "P2902",
  "affordances": [
    {
      "id": "A1",
      "name": "Pressure Slider",
      "type": "dom_element",
      "semantic": "Slider control to adjust applied pressure from 0 to 100 MPa",
      "locator_hints": [
        "input[type='range']",
        "pressure slider",
        "MPa control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Temperature Slider",
      "type": "dom_element",
      "semantic": "Slider control to adjust system temperature from 200 to 800 Kelvin",
      "locator_hints": [
        "input[type='range']",
        "temperature slider",
        "Kelvin control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Solvent Concentration Slider",
      "type": "dom_element",
      "semantic": "Slider control to adjust solvent concentration from 0 to 5 mol/L",
      "locator_hints": [
        "input[type='range']",
        "solvent slider",
        "mol/L control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Catalyst Toggle Button",
      "type": "dom_element",
      "semantic": "Button to toggle catalyst on or off",
      "locator_hints": [
        "button",
        "catalyst toggle",
        "on/off button"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A5",
      "name": "Coffeemat Membrane",
      "type": "3d_object",
      "semantic": "GLB model representing porous molecular sieve membrane at center",
      "locator_hints": [
        "coffeemat.glb",
        "membrane mesh",
        "center object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "Corset Compression Cage",
      "type": "3d_object",
      "semantic": "GLB model representing compression cage that scales with pressure",
      "locator_hints": [
        "Corset.glb",
        "cage mesh",
        "compression frame"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "Energy Budget Display",
      "type": "dom_element",
      "semantic": "Text display showing remaining energy budget in kilojoules",
      "locator_hints": [
        "energy display",
        "kJ remaining",
        "budget text"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.energyBudgetKJ === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Configuration",
      "description": "Lab initialized with default parameters: 0 MPa pressure, 300K temperature, 0 mol/L solvent, catalyst off, 1000 kJ energy budget",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.pressureMPa === 0 && window.__3D_STATE__.temperatureK === 300 && window.__3D_STATE__.solventConcentration === 0 && window.__3D_STATE__.catalystActive === false && window.__3D_STATE__.energyBudgetKJ === 1000)"
    },
    {
      "id": "S1",
      "name": "Pressure Calibration",
      "description": "Pressure increased to moderate level (40-60 MPa) with corresponding energy consumption and cage compression",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pressureMPa >= 40 && window.__3D_STATE__.pressureMPa <= 60 && window.__3D_STATE__.corsetScaleX < 1.0 && window.__3D_STATE__.corsetScaleZ < 1.0 && window.__3D_STATE__.energyBudgetKJ < 1000"
    },
    {
      "id": "S2",
      "name": "Temperature Adjustment",
      "description": "Temperature raised to 500-600K range causing membrane color shift and additional energy cost",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperatureK >= 500 && window.__3D_STATE__.temperatureK <= 600 && window.__3D_STATE__.membraneEmissiveIntensity > 0"
    },
    {
      "id": "S3",
      "name": "Solvent Introduction",
      "description": "Solvent concentration set to 2-3 mol/L to facilitate molecular interaction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.solventConcentration >= 2.0 && window.__3D_STATE__.solventConcentration <= 3.0"
    },
    {
      "id": "S4",
      "name": "Catalyst Activation",
      "description": "Catalyst toggled on to enable crystallization reaction pathway",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.catalystActive === true"
    },
    {
      "id": "S5",
      "name": "High Pressure Crystallization",
      "description": "Pressure increased above 60 MPa with temperature above 500K and catalyst active, triggering crystallization progress",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pressureMPa > 60 && window.__3D_STATE__.temperatureK > 500 && window.__3D_STATE__.catalystActive === true && window.__3D_STATE__.crystallizationProgress > 0"
    },
    {
      "id": "S6",
      "name": "Stable Crystallized State",
      "description": "System maintained at crystallization conditions for extended period with stable parameters and sufficient energy remaining",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.crystallizationProgress >= 30 && window.__3D_STATE__.stabilizationTimer >= 5000 && window.__3D_STATE__.energyBudgetKJ > 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 50; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Pressure slider set to 50 MPa",
        "Corset cage compressed inward on X and Z axes",
        "Energy budget decreased from initial 1000 kJ"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.pressureMPa === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pressureMPa >= 40 && window.__3D_STATE__.pressureMPa <= 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.corsetScaleX < 1.0 && window.__3D_STATE__.corsetScaleZ < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudgetKJ < 1000",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[1].value = 550; sliders[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Temperature set to 550K",
        "Membrane emissive intensity increased showing color shift toward red",
        "Additional energy consumed from budget"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.temperatureK === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperatureK >= 500 && window.__3D_STATE__.temperatureK <= 600",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.membraneEmissiveIntensity > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyConsumed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[2].value = 2.5; sliders[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Solvent concentration set to 2.5 mol/L",
        "System prepared for molecular interaction"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.solventConcentration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.solventConcentration >= 2.0 && window.__3D_STATE__.solventConcentration <= 3.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.solventConcentration - 2.5) < 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Catalyst activated",
        "Crystallization pathway enabled"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.catalystActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.catalystActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 75; sliders[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 3000
      },
      "postconditions": [
        "Pressure increased above 60 MPa threshold",
        "Coupled conditions met: pressure > 60 AND temperature > 500 AND catalyst active",
        "Crystallization progress initiated",
        "Lattice compression ratio calculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.pressureMPa > 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.temperatureK > 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystActive === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.crystallizationProgress === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.crystallizationProgress > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.latticeCompressionRatio === 'number' && isFinite(window.__3D_STATE__.latticeCompressionRatio)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Crystallization progress continues to advance",
        "System parameters remain stable",
        "Energy budget sufficient for continued operation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.crystallizationProgress >= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudgetKJ > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.crystallizationProgress))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 8000
      },
      "postconditions": [
        "Crystallization progress reached significant level",
        "Stabilization timer indicates sustained stable conditions",
        "All coupled parameters maintained within target ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.crystallizationProgress >= 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.stabilizationTimer === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stabilizationTimer >= 5000",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pressureMPa > 60 && window.__3D_STATE__.temperatureK > 500",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System maintained stable crystallized state for 60 seconds",
        "All parameters remain within operational bounds",
        "Energy budget positive throughout stability period"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.crystallizationProgress >= 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudgetKJ > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.stabilizationTimer >= 60000",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalEnergyConsumed) && window.__3D_STATE__.totalEnergyConsumed < 1000",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
