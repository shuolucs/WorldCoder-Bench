{
  "task_id": "P3081",
  "affordances": [
    {
      "id": "A1",
      "name": "DispersionTest Model",
      "type": "3d_object",
      "semantic": "Left-side prism GLB model that refracts light",
      "locator_hints": [
        "DispersionTest.glb",
        "left side of scene",
        "prism mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded >= 1)"
    },
    {
      "id": "A2",
      "name": "DamagedHelmet Model",
      "type": "3d_object",
      "semantic": "Right-side helmet GLB model receiving refracted light",
      "locator_hints": [
        "DamagedHelmet.glb",
        "right side of scene",
        "helmet mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === 2)"
    },
    {
      "id": "A3",
      "name": "Bloom Intensity Slider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling UnrealBloomPass intensity (0-100)",
      "locator_hints": [
        "bloom slider",
        "dat.GUI controller",
        "bloomIntensity"
      ],
      "check": "!!document.querySelector('.dg input[type=\"text\"]')"
    },
    {
      "id": "A4",
      "name": "Chromatic Aberration Slider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling chromatic aberration RGB offset (0-100)",
      "locator_hints": [
        "chromatic slider",
        "chromaticIntensity",
        "RGB offset"
      ],
      "check": "!!document.querySelector('.dg input[type=\"text\"]')"
    },
    {
      "id": "A5",
      "name": "Vignette Slider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling radial vignette darkening (0-100)",
      "locator_hints": [
        "vignette slider",
        "vignetteIntensity",
        "radial darkening"
      ],
      "check": "!!document.querySelector('.dg input[type=\"text\"]')"
    },
    {
      "id": "A6",
      "name": "Film Grain Slider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling animated noise grain (0-100)",
      "locator_hints": [
        "grain slider",
        "grainIntensity",
        "film noise"
      ],
      "check": "!!document.querySelector('.dg input[type=\"text\"]')"
    },
    {
      "id": "A7",
      "name": "Tone Mapping Exposure Slider",
      "type": "dom_element",
      "semantic": "dat.GUI slider controlling ACES filmic tone mapping exposure (0-100)",
      "locator_hints": [
        "exposure slider",
        "toneMappingExposure",
        "ACES"
      ],
      "check": "!!document.querySelector('.dg input[type=\"text\"]')"
    },
    {
      "id": "A8",
      "name": "Undo Button",
      "type": "dom_element",
      "semantic": "Button to restore previous slider state from history stack",
      "locator_hints": [
        "Undo button",
        "dat.GUI button",
        "history restore"
      ],
      "check": "!!Array.from(document.querySelectorAll('.dg button')).find(b => b.textContent.includes('Undo'))"
    },
    {
      "id": "A9",
      "name": "Redo Button",
      "type": "dom_element",
      "semantic": "Button to reapply undone slider state from redo stack",
      "locator_hints": [
        "Redo button",
        "dat.GUI button",
        "redo stack"
      ],
      "check": "!!Array.from(document.querySelectorAll('.dg button')).find(b => b.textContent.includes('Redo'))"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, models loading, composer not yet configured",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelsLoaded !== 2"
    },
    {
      "id": "S1",
      "name": "Models Loaded",
      "description": "Both GLB models loaded and positioned, post-processing passes active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === 2 && window.__3D_STATE__.composerPassCount >= 5 && window.__3D_STATE__.historyStackDepth === 0"
    },
    {
      "id": "S2",
      "name": "First Slider Adjustment",
      "description": "User has adjusted one effect slider, history stack has one entry",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.historyStackDepth === 1 && window.__3D_STATE__.userInteractionCount >= 1"
    },
    {
      "id": "S3",
      "name": "Energy Conservation Triggered",
      "description": "Total intensity exceeded 250, proportional scaling applied to other sliders",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.energyConservationTriggered === true"
    },
    {
      "id": "S4",
      "name": "Multiple Adjustments",
      "description": "User has made multiple slider changes, history stack depth >= 3",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.historyStackDepth >= 3 && window.__3D_STATE__.redoStackDepth === 0"
    },
    {
      "id": "S5",
      "name": "Undo Executed",
      "description": "User clicked Undo, previous state restored, redo stack populated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redoStackDepth >= 1 && window.__3D_STATE__.historyStackDepth >= 2"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "All systems operational, energy conservation enforced, history functional",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === 2 && window.__3D_STATE__.totalIntensity <= 250 && window.__3D_STATE__.composerPassCount >= 5"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both DispersionTest.glb and DamagedHelmet.glb are loaded",
        "EffectComposer has 5+ passes configured",
        "All intensity sliders initialized to valid values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bloomIntensity === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.dg .property-name').parentElement.querySelector('input').value = 50; document.querySelector('.dg .property-name').parentElement.querySelector('input').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "One slider has been adjusted to 50",
        "History stack depth is 1",
        "User interaction count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.historyStackDepth === 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.userInteractionCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.dg input[type=\"text\"]'); for(let i = 0; i < Math.min(3, sliders.length); i++) { sliders[i].value = 90; sliders[i].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Multiple sliders set to high values (90)",
        "Total intensity would exceed 250, triggering energy conservation",
        "Other sliders proportionally scaled down",
        "energyConservationTriggered flag is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.energyConservationTriggered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalIntensity <= 250",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.userInteractionCount >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.dg input[type=\"text\"]'); sliders[0].value = 30; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { sliders[1].value = 40; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Additional slider adjustments made",
        "History stack depth is at least 3",
        "Total intensity remains within 250 limit"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.historyStackDepth >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalIntensity <= 250",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.userInteractionCount >= 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const undoBtn = Array.from(document.querySelectorAll('.dg button')).find(b => b.textContent.includes('Undo')); if(undoBtn) undoBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Undo button clicked",
        "Previous slider state restored from history",
        "Redo stack depth is now 1",
        "History stack depth decreased by 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackDepth >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.historyStackDepth >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.bloomIntensity === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const redoBtn = Array.from(document.querySelectorAll('.dg button')).find(b => b.textContent.includes('Redo')); if(redoBtn) redoBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Redo button clicked",
        "Undone state reapplied",
        "Redo stack depth decreased",
        "All effect intensities are valid numbers"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackDepth >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.bloomIntensity) && Number.isFinite(window.__3D_STATE__.chromaticIntensity) && Number.isFinite(window.__3D_STATE__.vignetteIntensity) && Number.isFinite(window.__3D_STATE__.grainIntensity) && Number.isFinite(window.__3D_STATE__.toneMappingExposure)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalIntensity <= 250",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All models still loaded",
        "Energy conservation still enforced",
        "History and redo stacks maintain integrity"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalIntensity <= 250",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.composerPassCount >= 5",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.historyStackDepth) && window.__3D_STATE__.historyStackDepth >= 0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
