{
  "task_id": "P3129",
  "affordances": [
    {
      "id": "A1",
      "name": "Power On Button",
      "type": "dom_element",
      "semantic": "HTML button that activates the UV analysis lamp",
      "locator_hints": [
        "button",
        "text contains 'Power On'"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A2",
      "name": "Wavelength Slider",
      "type": "dom_element",
      "semantic": "Range input controlling lamp wavelength from 380-780nm",
      "locator_hints": [
        "input[type='range']",
        "label contains 'Wavelength'"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"range\"]')).some(s => s.previousElementSibling?.textContent?.includes('Wavelength'))"
    },
    {
      "id": "A3",
      "name": "Intensity Slider",
      "type": "dom_element",
      "semantic": "Range input controlling lamp intensity from 0-100%",
      "locator_hints": [
        "input[type='range']",
        "label contains 'Intensity'"
      ],
      "check": "Array.from(document.querySelectorAll('input[type=\"range\"]')).some(s => s.previousElementSibling?.textContent?.includes('Intensity'))"
    },
    {
      "id": "A4",
      "name": "Iridescence Lamp",
      "type": "3d_object",
      "semantic": "Draggable UV lamp model that can be repositioned horizontally",
      "locator_hints": [
        "IridescenceLamp.glb",
        "draggable mesh",
        "positioned above plant"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Plant Specimen",
      "type": "3d_object",
      "semantic": "Bioluminescent plant under analysis",
      "locator_hints": [
        "DiffuseTransmissionPlant.glb",
        "at world origin"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Setup",
      "description": "Lab scene loaded with lamp off, default wavelength and intensity settings",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.lampPowered === false"
    },
    {
      "id": "S1",
      "name": "Lamp Activated",
      "description": "UV lamp powered on with spotlight illuminating the plant specimen",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lampPowered === true"
    },
    {
      "id": "S2",
      "name": "Wavelength Calibrated",
      "description": "Lamp wavelength adjusted to mid-visible spectrum range",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lampPowered === true && window.__3D_STATE__.lampWavelength >= 500 && window.__3D_STATE__.lampWavelength <= 600"
    },
    {
      "id": "S3",
      "name": "Intensity Adjusted",
      "description": "Lamp intensity set to optimal analysis level",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lampPowered === true && window.__3D_STATE__.lampIntensity >= 60 && window.__3D_STATE__.lampIntensity <= 90"
    },
    {
      "id": "S4",
      "name": "Lamp Repositioned",
      "description": "Lamp dragged to new horizontal position for better coverage",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lampPowered === true && Math.abs(window.__3D_STATE__.lampPositionX - 0) > 0.1"
    },
    {
      "id": "S5",
      "name": "Analysis Complete",
      "description": "Spectral readings recorded with calibrated lamp configuration",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.calibrationComplete === true && window.__3D_STATE__.spectralReadings > 0"
    },
    {
      "id": "S6",
      "name": "Stability Verified",
      "description": "System maintains stable configuration for extended observation period",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Lamp is powered on",
        "SpotLight is active and visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lampPowered === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lampPowered === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Wavelength')); if(slider) { slider.value = 550; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Wavelength set to mid-spectrum value around 550nm",
        "Light color updated to reflect wavelength"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lampWavelength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lampWavelength >= 380 && window.__3D_STATE__.lampWavelength <= 780",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lampWavelength - 550) < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = Array.from(document.querySelectorAll('input[type=\"range\"]')).find(s => s.previousElementSibling?.textContent?.includes('Intensity')); if(slider) { slider.value = 75; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Lamp intensity set to 75%",
        "Plant receives adequate illumination"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lampIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lampIntensity >= 0 && window.__3D_STATE__.lampIntensity <= 100",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lampIntensity - 75) < 15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const centerX = rect.left + rect.width / 2; const centerY = rect.top + rect.height / 3; canvas.dispatchEvent(new PointerEvent('pointerdown', {clientX: centerX, clientY: centerY, bubbles: true})); setTimeout(() => { canvas.dispatchEvent(new PointerEvent('pointermove', {clientX: centerX + 80, clientY: centerY, bubbles: true})); setTimeout(() => { canvas.dispatchEvent(new PointerEvent('pointerup', {clientX: centerX + 80, clientY: centerY, bubbles: true})); }, 100); }, 100);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Lamp repositioned horizontally along X-axis",
        "Lamp position changed from initial coordinates"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lampPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lampPositionX)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lampPositionX - 0) > 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Spectral readings recorded",
        "Calibration marked complete",
        "Plant illumination confirmed"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.spectralReadings === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.spectralReadings > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.spectralReadings)",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.calibrationComplete === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.calibrationComplete === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All state values maintain validity",
        "No unexpected state changes occur"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lampPowered === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampWavelength >= 380 && window.__3D_STATE__.lampWavelength <= 780",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lampIntensity >= 0 && window.__3D_STATE__.lampIntensity <= 100",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lampPositionX) && isFinite(window.__3D_STATE__.lampPositionY)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.calibrationComplete === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
