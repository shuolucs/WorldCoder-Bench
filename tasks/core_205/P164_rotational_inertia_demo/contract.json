      "condition": "window.__3D_STATE__ && window.__3D_STATE__.angularVelocity > 0.5 && window.__3D_STATE__.isSpinning === true"
    },
    {
      "id": "S2",
      "name": "Decelerating",
      "conditions": [
        "window.__3D_STATE__.appliedTorque === 0",
        "window.__3D_STATE__.angularVelocity > 0.01",
        "window.__3D_STATE__.isSpinning === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.appliedTorque === 0 && window.__3D_STATE__.angularVelocity > 0.01 && window.__3D_STATE__.isSpinning === true"
    },
    {
