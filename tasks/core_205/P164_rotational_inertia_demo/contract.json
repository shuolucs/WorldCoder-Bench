        "window.__3D_STATE__.isSpinning === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.angularVelocity < -0.5 && window.__3D_STATE__.isSpinning === true"
    },
    {
      "id": "S4",
      "name": "Masses_Extended",
      "conditions": [
        "window.__3D_STATE__.massRadius >= 1.0",
        "window.__3D_STATE__.momentOfInertia > 2.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.massRadius >= 1.0 && window.__3D_STATE__.momentOfInertia > 2.5"
    },
    {
      "id": "S5",
      "name": "Braked",
      "conditions": [
        "window.__3D_STATE__.brakeCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.brakeCount >= 1"
    },
    {
      "id": "S6",
      "name": "Conservation_Active",
      "conditions": [
