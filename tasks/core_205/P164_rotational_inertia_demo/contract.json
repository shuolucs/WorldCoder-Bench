{
  "task_id": "P164_rotational_inertia_demo",
  "affordances": [
    {
      "id": "A1",
      "name": "RotationalPlatform",
      "type": "3d_object",
      "semantic": "Cylindrical platform that rotates around Y-axis carrying the shoe and point masses",
      "locator_hints": [
        "cylinder mesh at y=0.075",
        "radius 2"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.platformRotationY === 'number')"
    },
    {
      "id": "A2",
      "name": "ShoeModel",
      "type": "3d_object",
      "semantic": "Loaded GLB shoe model sitting on the platform",
      "locator_hints": [
        "MaterialsVariantsShoe.glb",
        "centered on platform"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.shoeLoaded === 'boolean')"
    },
    {
      "id": "A3",
      "name": "PointMasses",
      "type": "3d_object",
      "semantic": "4 red spheres on the platform at adjustable radial distance",
      "locator_hints": [
        "red spheres",
        "radius 0.15",
        "evenly spaced 90 degrees"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.massCount === 4)"
    },
    {
      "id": "A4",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing physics values",
      "locator_hints": [
        "#hud",
        "top-left overlay"
      ],
      "check": "!!document.getElementById('hud')"
    },
    {
      "id": "A5",
      "name": "ToggleSpinButton",
      "type": "dom_element",
      "semantic": "Button that applies an angular velocity impulse of +3.0 rad/s",
      "locator_hints": [
        "#toggle-spin"
      ],
      "check": "!!document.getElementById('toggle-spin')"
    },
    {
      "id": "A6",
      "name": "FreezeButton",
      "type": "dom_element",
      "semantic": "Button that sets angular velocity to zero",
      "locator_hints": [
        "#freeze-btn"
      ],
      "check": "!!document.getElementById('freeze-btn')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Idle",
      "conditions": [
        "window.__3D_STATE__.angularVelocity === 0",
        "window.__3D_STATE__.shoeLoaded === true",
        "window.__3D_STATE__.isSpinning === false",
        "window.__3D_STATE__.massRadius === 0.5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.angularVelocity === 0 && window.__3D_STATE__.shoeLoaded === true && window.__3D_STATE__.isSpinning === false && window.__3D_STATE__.massRadius === 0.5"
    },
    {
      "id": "S1",
      "name": "Spinning_CW",
      "conditions": [
        "window.__3D_STATE__.angularVelocity > 0.5",
        "window.__3D_STATE__.isSpinning === true"
