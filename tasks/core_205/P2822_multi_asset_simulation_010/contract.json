{
  "task_id": "P2822",
  "affordances": [
    {
      "id": "A1",
      "name": "Start Session Button",
      "type": "dom_element",
      "semantic": "HTML button that initiates the motion capture session",
      "locator_hints": [
        "button",
        "text contains 'Start Session'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Start Session'))"
    },
    {
      "id": "A2",
      "name": "Expression Intensity Slider",
      "type": "dom_element",
      "semantic": "Range slider controlling facial expression morph target intensity",
      "locator_hints": [
        "input[type='range']",
        "label contains 'Expression Intensity'"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A3",
      "name": "Path A Button",
      "type": "dom_element",
      "semantic": "Button to switch CesiumMan to circular path A",
      "locator_hints": [
        "button",
        "text contains 'Path A'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Path A'))"
    },
    {
      "id": "A4",
      "name": "Path B Button",
      "type": "dom_element",
      "semantic": "Button to switch CesiumMan to circular path B",
      "locator_hints": [
        "button",
        "text contains 'Path B'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Path B'))"
    },
    {
      "id": "A5",
      "name": "CesiumMan Model",
      "type": "3d_object",
      "semantic": "Animated character performing walking motion on stage",
      "locator_hints": [
        "GLB model",
        "has AnimationMixer",
        "positioned on stage plane"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cesiumManPositionX !== undefined && window.__3D_STATE__.cesiumManPositionZ !== undefined)"
    },
    {
      "id": "A6",
      "name": "Facecap Head Monitor",
      "type": "3d_object",
      "semantic": "Floating monitor displaying facecap head with morph target expressions",
      "locator_hints": [
        "GLB model",
        "has morph targets",
        "positioned upper-right"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.facecapMorphCount !== undefined && window.__3D_STATE__.monitorFrameVisible !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Idle",
      "description": "Studio loaded with CesiumMan and facecap visible, session not started, all controls at default",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.sessionActive === false"
    },
    {
      "id": "S1",
      "name": "Session Active",
      "description": "Motion capture session running, CesiumMan walking on circular path, facecap animating",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sessionActive === true && window.__3D_STATE__.animationTimeElapsed > 0"
    },
    {
      "id": "S2",
      "name": "Expression Adjusted",
      "description": "Expression intensity slider modified, facecap morph targets scaled to new intensity",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sessionActive === true && typeof window.__3D_STATE__.expressionIntensity === 'number' && window.__3D_STATE__.expressionIntensity !== 1.0"
    },
    {
      "id": "S3",
      "name": "Path A Selected",
      "description": "CesiumMan following circular path A with specific radius",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPathMode === 'circularA'"
    },
    {
      "id": "S4",
      "name": "Path B Selected",
      "description": "CesiumMan following circular path B with different radius",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentPathMode === 'circularB'"
    },
    {
      "id": "S5",
      "name": "Full Performance",
      "description": "Session running with custom expression intensity and selected path, all systems active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sessionActive === true && window.__3D_STATE__.currentPathMode !== undefined && typeof window.__3D_STATE__.expressionIntensity === 'number'"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Session becomes active",
        "CesiumMan begins walking animation on circular path",
        "Animation time starts incrementing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sessionActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTimeElapsed > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cesiumManPositionX) < 10 && Math.abs(window.__3D_STATE__.cesiumManPositionZ) < 10",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); slider.value = 0.75; slider.dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Expression intensity updated to 0.75",
        "Facecap morph targets scaled proportionally",
        "Visual change in facial expression visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.expressionIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.expressionIntensity >= 0.7",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.expressionIntensity - 0.75) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const pathA = buttons.find(b => b.textContent.includes('Path A')); if(pathA) pathA.click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Path mode switched to circularA",
        "CesiumMan follows new circular path with updated radius",
        "Position coordinates reflect path A trajectory"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentPathMode !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pathRadius > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentPathMode === 'circularA'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const pathB = buttons.find(b => b.textContent.includes('Path B')); if(pathB) pathB.click();",
        "wait_ms": 2000
      },
      "postconditions": [
        "Path mode switched to circularB",
        "CesiumMan follows different circular path with new radius",
        "Position coordinates reflect path B trajectory"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentPathMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pathRadius >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentPathMode === 'circularB'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); slider.value = 0.5; slider.dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Expression intensity set to mid-range value",
        "All systems active with custom configuration",
        "Facecap morph targets at 0.5 intensity scale"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.facecapMorphCount !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.facecapMorphCount >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.expressionIntensity - 0.5) < 0.15",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); slider.value = 1.0; slider.dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Expression intensity maximized to 1.0",
        "Facecap shows fully exaggerated expressions",
        "Monitor frame remains visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.monitorFrameVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.expressionIntensity > 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.expressionIntensity - 1.0) < 0.15 && window.__3D_STATE__.monitorFrameVisible === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Animation continues smoothly",
        "All state values remain valid and within expected ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sessionActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTimeElapsed > 60",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.cesiumManPositionX) && Number.isFinite(window.__3D_STATE__.cesiumManPositionZ) && Number.isFinite(window.__3D_STATE__.pathRadius)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
