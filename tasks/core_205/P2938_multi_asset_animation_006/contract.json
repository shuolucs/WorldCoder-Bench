{
  "task_id": "P2938",
  "affordances": [
    {
      "id": "A1",
      "name": "ReadyPlayerMe Avatar Model",
      "type": "3d_object",
      "semantic": "Humanoid character GLB with animation clips",
      "locator_hints": [
        "readyplayer.me.glb",
        "avatar mesh",
        "left position on platform"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.avatarClipCount > 0)"
    },
    {
      "id": "A2",
      "name": "Nemetona Goddess Model",
      "type": "3d_object",
      "semantic": "Goddess figure GLB with animation clips",
      "locator_hints": [
        "nemetona.glb",
        "goddess mesh",
        "right position on platform"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.goddessClipCount > 0)"
    },
    {
      "id": "A3",
      "name": "Clip Palette Panel",
      "type": "dom_element",
      "semantic": "Draggable list of all available animation clips",
      "locator_hints": [
        "clip palette",
        "animation list",
        "draggable clips"
      ],
      "check": "document.querySelectorAll('.clip-palette-item').length > 0"
    },
    {
      "id": "A4",
      "name": "Avatar Timeline Track",
      "type": "dom_element",
      "semantic": "Timeline track for avatar animation sequence",
      "locator_hints": [
        "avatar track",
        "timeline row 1",
        "drop zone"
      ],
      "check": "!!document.querySelector('.avatar-timeline-track')"
    },
    {
      "id": "A5",
      "name": "Goddess Timeline Track",
      "type": "dom_element",
      "semantic": "Timeline track for goddess animation sequence",
      "locator_hints": [
        "goddess track",
        "timeline row 2",
        "drop zone"
      ],
      "check": "!!document.querySelector('.goddess-timeline-track')"
    },
    {
      "id": "A6",
      "name": "Mirror Toggle Button",
      "type": "dom_element",
      "semantic": "Button to mirror selected clip to other character",
      "locator_hints": [
        "mirror button",
        "copy mirrored",
        "X-axis mirror"
      ],
      "check": "!!document.querySelector('.mirror-toggle-button')"
    },
    {
      "id": "A7",
      "name": "Energy Budget Display",
      "type": "dom_element",
      "semantic": "Shows current energy used vs total budget",
      "locator_hints": [
        "energy display",
        "budget counter",
        "100 units"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.currentEnergyUsed === 'number' && typeof window.__3D_STATE__.totalEnergyBudget === 'number')"
    },
    {
      "id": "A8",
      "name": "Arrow Key Offset Controls",
      "type": "interaction",
      "semantic": "Keyboard controls to adjust clip timing in 0.25s steps",
      "locator_hints": [
        "arrow keys",
        "offset adjustment",
        "0.25s increments"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Both GLB models loaded, clips enumerated, timeline empty, energy at 0/100",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.avatarClipCount > 0 && window.__3D_STATE__.goddessClipCount > 0 && window.__3D_STATE__.currentEnergyUsed === 0 && window.__3D_STATE__.avatarTimelineSlots === 0 && window.__3D_STATE__.goddessTimelineSlots === 0)"
    },
    {
      "id": "S1",
      "name": "Clips Placed",
      "description": "User has dragged clips onto both timeline tracks, energy budget partially consumed",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.avatarTimelineSlots >= 1 && window.__3D_STATE__.goddessTimelineSlots >= 1 && window.__3D_STATE__.currentEnergyUsed > 0)"
    },
    {
      "id": "S2",
      "name": "Clip Selected",
      "description": "One timeline clip block is selected for offset adjustment",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.selectedClipIndex === 'number' && window.__3D_STATE__.selectedClipIndex >= 0)"
    },
    {
      "id": "S3",
      "name": "Offset Adjusted",
      "description": "Selected clip timing offset modified via arrow keys",
      "condition": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.lastOffsetAdjustmentTime === 'number' && window.__3D_STATE__.lastOffsetAdjustmentTime > 0)"
    },
    {
      "id": "S4",
      "name": "Mirror Applied",
      "description": "Clip mirrored to opposite character with X-axis motion reversal",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.mirrorModeActive === true)"
    },
    {
      "id": "S5",
      "name": "Energy Budget Exceeded",
      "description": "Total energy used surpasses 100 unit budget, violation flagged",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.currentEnergyUsed > window.__3D_STATE__.totalEnergyBudget && window.__3D_STATE__.energyViolationDetected === true)"
    },
    {
      "id": "S6",
      "name": "Synchronized Playback",
      "description": "Both characters animating in sync, playhead advancing, energy stable",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.isSynchronizedPlaying === true && window.__3D_STATE__.currentEnergyUsed <= window.__3D_STATE__.totalEnergyBudget)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both GLB models fully loaded",
        "Animation clips enumerated and stored in state",
        "Timeline tracks empty with zero energy used"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avatarClipCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.goddessClipCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avatarClipCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.goddessClipCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentEnergyUsed === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('.clip-palette-item')[0]?.dispatchEvent(new MouseEvent('mousedown', {bubbles:true})); document.querySelector('.avatar-timeline-track')?.dispatchEvent(new MouseEvent('mouseup', {bubbles:true})); setTimeout(() => { document.querySelectorAll('.clip-palette-item')[1]?.dispatchEvent(new MouseEvent('mousedown', {bubbles:true})); document.querySelector('.goddess-timeline-track')?.dispatchEvent(new MouseEvent('mouseup', {bubbles:true})); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "At least one clip placed on avatar timeline",
        "At least one clip placed on goddess timeline",
        "Energy used increased from zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.avatarTimelineSlots === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.goddessTimelineSlots === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.avatarTimelineSlots >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.goddessTimelineSlots >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentEnergyUsed > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.timeline-clip-block')?.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "One timeline clip block is selected",
        "Selected clip index is non-negative"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedClipIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedClipIndex >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.selectedClipIndex)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const evt = new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true}); document.dispatchEvent(evt); setTimeout(() => { const evt2 = new KeyboardEvent('keydown', {key: 'ArrowRight', bubbles: true}); document.dispatchEvent(evt2); }, 300);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Selected clip offset adjusted by arrow key input",
        "Last adjustment timestamp updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lastOffsetAdjustmentTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lastOffsetAdjustmentTime > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lastOffsetAdjustmentTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.mirror-toggle-button')?.click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "Mirror mode activated",
        "Selected clip copied to opposite character with mirrored motion",
        "Timeline slot count increased on target character"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.mirrorModeActive === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.mirrorModeActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.avatarTimelineSlots + window.__3D_STATE__.goddessTimelineSlots >= 3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for (let i = 0; i < 8; i++) { const item = document.querySelectorAll('.clip-palette-item')[i % 4]; if (item) { item.dispatchEvent(new MouseEvent('mousedown', {bubbles:true})); const track = i % 2 === 0 ? document.querySelector('.avatar-timeline-track') : document.querySelector('.goddess-timeline-track'); track?.dispatchEvent(new MouseEvent('mouseup', {bubbles:true})); } }",
        "wait_ms": 3000
      },
      "postconditions": [
        "Multiple clips added to exceed 100 energy budget",
        "Energy violation detected and flagged"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyViolationDetected === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentEnergyUsed > window.__3D_STATE__.totalEnergyBudget",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyViolationDetected === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "while (window.__3D_STATE__.currentEnergyUsed > window.__3D_STATE__.totalEnergyBudget) { const blocks = document.querySelectorAll('.timeline-clip-block'); if (blocks.length > 0) { blocks[blocks.length - 1].querySelector('.remove-btn')?.click(); } else break; } setTimeout(() => { document.querySelector('.play-timeline-button')?.click(); }, 500);",
        "wait_ms": 2500
      },
      "postconditions": [
        "Energy budget restored to valid range",
        "Synchronized playback started",
        "Playhead position advancing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isSynchronizedPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isSynchronizedPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentEnergyUsed <= window.__3D_STATE__.totalEnergyBudget",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.timelinePlayheadPosition >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Playhead continues advancing",
        "Energy budget maintained within limits"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isSynchronizedPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.currentEnergyUsed <= 100",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.timelinePlayheadPosition)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
