{
  "task_id": "P3091",
  "affordances": [
    {
      "id": "A1",
      "name": "Pool Model",
      "type": "3d_object",
      "semantic": "The pool.glb model centered at origin",
      "locator_hints": [
        "pool.glb",
        "centered at (0,0,0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Lamp Instance 1",
      "type": "3d_object",
      "semantic": "First IridescenceLamp.glb at position (-2,2,0)",
      "locator_hints": [
        "IridescenceLamp.glb",
        "position (-2,2,0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && typeof window.__3D_STATE__.lamp1BloomContribution === 'number')"
    },
    {
      "id": "A3",
      "name": "Lamp Instance 2",
      "type": "3d_object",
      "semantic": "Second IridescenceLamp.glb at position (0,2,1.5)",
      "locator_hints": [
        "IridescenceLamp.glb",
        "position (0,2,1.5)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && typeof window.__3D_STATE__.lamp2BloomContribution === 'number')"
    },
    {
      "id": "A4",
      "name": "Lamp Instance 3",
      "type": "3d_object",
      "semantic": "Third IridescenceLamp.glb at position (2,2,0)",
      "locator_hints": [
        "IridescenceLamp.glb",
        "position (2,2,0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded && typeof window.__3D_STATE__.lamp3BloomContribution === 'number')"
    },
    {
      "id": "A5",
      "name": "Lamp 1 Bloom Slider",
      "type": "dom_element",
      "semantic": "Slider controlling bloom contribution of first lamp",
      "locator_hints": [
        "input[type='range']",
        "lamp 1",
        "bloom contribution"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A6",
      "name": "Lamp 2 Chromatic Aberration Slider",
      "type": "dom_element",
      "semantic": "Slider controlling chromatic aberration offset of second lamp",
      "locator_hints": [
        "input[type='range']",
        "lamp 2",
        "chromatic aberration"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A7",
      "name": "Global Bloom Radius Slider",
      "type": "dom_element",
      "semantic": "Slider controlling overall bloom radius",
      "locator_hints": [
        "input[type='range']",
        "global",
        "bloom radius"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A8",
      "name": "Tone Mapping Exposure Slider",
      "type": "dom_element",
      "semantic": "Slider controlling tone mapping exposure",
      "locator_hints": [
        "input[type='range']",
        "tone mapping",
        "exposure"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A9",
      "name": "Undo Button",
      "type": "interaction",
      "semantic": "Keyboard shortcut Ctrl+Z to undo changes",
      "locator_hints": [
        "Ctrl+Z",
        "undo"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with default parameters, all lamps at equal bloom contribution (0.5 each), conservation law satisfied",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Lamp 1 Bloom Adjusted",
      "description": "First lamp bloom contribution increased, other lamps decreased proportionally to maintain sum of 1.5",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lamp1BloomContribution > 0.7"
    },
    {
      "id": "S2",
      "name": "Chromatic Aberration Modified",
      "description": "Chromatic aberration offset adjusted for one or more lamps",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lamp2ChromaticOffset > 0.01"
    },
    {
      "id": "S3",
      "name": "Color Tint Applied",
      "description": "RGB color tint values modified for at least one lamp",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lamp1ColorTintR > 1.0"
    },
    {
      "id": "S4",
      "name": "Global Parameters Changed",
      "description": "Global bloom radius or tone mapping exposure adjusted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.globalBloomRadius > 0.5 && window.__3D_STATE__.toneMappingExposure > 1.5"
    },
    {
      "id": "S5",
      "name": "Undo History Active",
      "description": "User has performed undo operation, undo stack contains previous states",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoStackDepth > 0"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "All parameters set, conservation law maintained, scene stable for 60 seconds",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach(s => { if(s.id && s.id.includes('lamp1') && s.id.includes('bloom')) { s.value = 0.8; s.dispatchEvent(new Event('input', {bubbles: true})); } });",
        "wait_ms": 1500
      },
      "postconditions": [
        "First lamp bloom contribution increased to 0.8",
        "Other lamp bloom contributions decreased to maintain sum of 1.5",
        "Conservation law satisfied"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lamp1BloomContribution === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lamp1BloomContribution > 0.7",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.lamp1BloomContribution + window.__3D_STATE__.lamp2BloomContribution + window.__3D_STATE__.lamp3BloomContribution) - 1.5) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach(s => { if(s.id && s.id.includes('lamp2') && s.id.includes('chromatic')) { s.value = 0.015; s.dispatchEvent(new Event('input', {bubbles: true})); } });",
        "wait_ms": 1200
      },
      "postconditions": [
        "Second lamp chromatic aberration offset set to 0.015",
        "Chromatic aberration effect visible in post-processing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lamp2ChromaticOffset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lamp2ChromaticOffset > 0.01",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lamp2ChromaticOffset - 0.015) < 0.003",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach(s => { if(s.id && s.id.includes('lamp1') && s.id.includes('ColorR')) { s.value = 1.3; s.dispatchEvent(new Event('input', {bubbles: true})); } });",
        "wait_ms": 1000
      },
      "postconditions": [
        "First lamp red color tint increased to 1.3",
        "Color grading applied to lamp rendering"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lamp1ColorTintR === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lamp1ColorTintR > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.lamp1ColorTintR - 1.3) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach(s => { if(s.id && s.id.includes('global') && s.id.includes('radius')) { s.value = 0.7; s.dispatchEvent(new Event('input', {bubbles: true})); } if(s.id && s.id.includes('exposure')) { s.value = 1.8; s.dispatchEvent(new Event('input', {bubbles: true})); } });",
        "wait_ms": 1500
      },
      "postconditions": [
        "Global bloom radius set to 0.7",
        "Tone mapping exposure set to 1.8",
        "Post-processing effects updated globally"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.globalBloomRadius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.globalBloomRadius > 0.5 && window.__3D_STATE__.toneMappingExposure > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.globalBloomRadius - 0.7) < 0.15 && Math.abs(window.__3D_STATE__.toneMappingExposure - 1.8) < 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'z', ctrlKey: true, bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "Undo operation executed",
        "Previous state restored",
        "Undo stack depth increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.undoStackDepth === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.undoStackDepth >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.undoStackDepth) && window.__3D_STATE__.undoStackDepth > 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.dispatchEvent(new KeyboardEvent('keydown', {key: 'y', ctrlKey: true, bubbles: true}));",
        "wait_ms": 800
      },
      "postconditions": [
        "Redo operation executed",
        "State restored to before undo",
        "Global parameters match previous S4 state"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.globalBloomRadius === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.globalBloomRadius > 0.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.globalBloomRadius) && isFinite(window.__3D_STATE__.toneMappingExposure)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S4",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]').forEach(s => { if(s.id && s.id.includes('lamp3') && s.id.includes('ColorG')) { s.value = 1.2; s.dispatchEvent(new Event('input', {bubbles: true})); } });",
        "wait_ms": 2000
      },
      "postconditions": [
        "Third lamp green color tint set to 1.2",
        "All parameters finalized",
        "Conservation law maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lamp1ColorTintG === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lamp1BloomContribution >= 0 && window.__3D_STATE__.lamp2BloomContribution >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.lamp1BloomContribution + window.__3D_STATE__.lamp2BloomContribution + window.__3D_STATE__.lamp3BloomContribution) - 1.5) < 0.02",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values unchanged",
        "Conservation law continuously satisfied"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lamp1BloomContribution === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lamp1BloomContribution >= 0 && window.__3D_STATE__.lamp2BloomContribution >= 0 && window.__3D_STATE__.lamp3BloomContribution >= 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs((window.__3D_STATE__.lamp1BloomContribution + window.__3D_STATE__.lamp2BloomContribution + window.__3D_STATE__.lamp3BloomContribution) - 1.5) < 0.01 && isFinite(window.__3D_STATE__.toneMappingExposure)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
