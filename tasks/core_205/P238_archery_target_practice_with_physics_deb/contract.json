{
  "task_id": "P238_archery_target_practice_with_physics_deb",
  "affordances": [
    {
      "id": "A1",
      "name": "ArcheryTarget",
      "type": "3d_object",
      "semantic": "Concentric ring target at z=-15 for scoring arrows",
      "locator_hints": [
        "position.z === -15",
        "position.y === 3"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Arrow",
      "type": "3d_object",
      "semantic": "Projectile arrow that flies toward target with gravity",
      "locator_hints": [
        "CylinderGeometry shaft",
        "ConeGeometry tip"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.arrowsRemaining !== undefined)"
    },
    {
      "id": "A3",
      "name": "SheenChair",
      "type": "3d_object",
      "semantic": "GLB model chair prop at (-4, 0, 5)",
      "locator_hints": [
        "position.x === -4",
        "loaded via GLTFLoader"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.chairLoaded === true)"
    },
    {
      "id": "A4",
      "name": "DebugOverlay",
      "type": "dom_element",
      "semantic": "Physics debug panel toggled with D key",
      "locator_hints": [
        "#debug-overlay"
      ],
      "check": "!!document.getElementById('debug-overlay')"
    },
    {
      "id": "A5",
      "name": "ScoreDisplay",
      "type": "dom_element",
      "semantic": "HUD showing current score",
      "locator_hints": [
        "#score-display"
      ],
      "check": "!!document.getElementById('score-display')"
    },
    {
      "id": "A6",
      "name": "ArrowsRemaining",
      "type": "dom_element",
      "semantic": "HUD showing remaining arrows",
      "locator_hints": [
        "#arrows-remaining"
      ],
      "check": "!!document.getElementById('arrows-remaining')"
    },
    {
      "id": "A7",
      "name": "RoundOverMsg",
      "type": "dom_element",
      "semantic": "Message shown when all arrows are fired",
      "locator_hints": [
        "#round-over-msg"
      ],
      "check": "!!document.getElementById('round-over-msg')"
    },
    {
      "id": "A8",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Green ground plane at y=0",
      "locator_hints": [
        "position.y === 0",
        "color 0x556B2F"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.arrowsRemaining === 5",
        "window.__3D_STATE__.arrowsFired === 0",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.debugOverlayVisible === false",
        "window.__3D_STATE__.roundOver === false"
      ],
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.score === 0 && window.__3D_STATE__.arrowsRemaining === 5 && window.__3D_STATE__.arrowsFired === 0 && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.debugOverlayVisible === false && window.__3D_STATE__.roundOver === false)"
    },
    {
      "id": "S1",
      "name": "ChairLoaded",
      "conditions": [
        "window.__3D_STATE__.chairLoaded === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.chairLoaded === true"
    },
    {
      "id": "S2",
      "name": "ArrowInFlight",
      "conditions": [
        "window.__3D_STATE__.arrowInFlight === true",
        "window.__3D_STATE__.arrowsRemaining < 5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowInFlight === true && window.__3D_STATE__.arrowsRemaining < 5"
    },
    {
      "id": "S3",
      "name": "ArrowHitTarget",
      "conditions": [
        "window.__3D_STATE__.arrowInFlight === false",
        "window.__3D_STATE__.arrowsFired >= 1",
        "window.__3D_STATE__.lastHitDistance !== null"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowInFlight === false && window.__3D_STATE__.arrowsFired >= 1 && window.__3D_STATE__.lastHitDistance !== null"
    },
    {
      "id": "S4",
      "name": "DebugOverlayOn",
      "conditions": [
        "window.__3D_STATE__.debugOverlayVisible === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.debugOverlayVisible === true"
    },
    {
      "id": "S5",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S6",
      "name": "RoundOver",
      "conditions": [
        "window.__3D_STATE__.arrowsRemaining === 0",
        "window.__3D_STATE__.arrowsFired === 5",
        "window.__3D_STATE__.roundOver === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowsRemaining === 0 && window.__3D_STATE__.arrowsFired === 5 && window.__3D_STATE__.roundOver === true"
    },
    {
      "id": "S7",
      "name": "ResetComplete",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.arrowsRemaining === 5",
        "window.__3D_STATE__.arrowsFired === 0",
        "window.__3D_STATE__.roundOver === false"
