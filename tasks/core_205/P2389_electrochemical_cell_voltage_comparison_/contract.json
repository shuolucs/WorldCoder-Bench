{
  "task_id": "P2389_electrochemical_cell_voltage_comparison_",
  "affordances": [
    {
      "id": "A1",
      "name": "AnodeDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select anode electrode material",
      "locator_hints": [
        "select#anode-select",
        "select with anode options"
      ],
      "check": "!!document.getElementById('anode-select')"
    },
    {
      "id": "A2",
      "name": "CathodeDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select cathode electrode material",
      "locator_hints": [
        "select#cathode-select",
        "select with cathode options"
      ],
      "check": "!!document.getElementById('cathode-select')"
    },
    {
      "id": "A3",
      "name": "PlayPauseButton",
      "type": "dom_element",
      "semantic": "Button to toggle time simulation play/pause",
      "locator_hints": [
        "button#play-pause",
        "button containing Play or Pause text"
      ],
      "check": "!!document.getElementById('play-pause')"
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation time and voltage",
      "locator_hints": [
        "button#reset",
        "button containing Reset text"
      ],
      "check": "!!document.getElementById('reset')"
    },
    {
      "id": "A5",
      "name": "SpeedDropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select simulation speed multiplier",
      "locator_hints": [
        "select#speed-select",
        "speed multiplier dropdown"
      ],
      "check": "!!document.getElementById('speed-select')"
    },
    {
      "id": "A6",
      "name": "RecordButton",
      "type": "dom_element",
      "semantic": "Button to record current voltage reading",
      "locator_hints": [
        "button#record",
        "button containing Record text"
      ],
      "check": "!!document.getElementById('record')"
    },
    {
      "id": "A7",
      "name": "Voltmeter",
      "type": "3d_object",
      "semantic": "Central voltmeter displaying current cell voltage",
      "locator_hints": [
        "mesh at (0,4,0)",
        "voltmeter box"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A8",
      "name": "AnodeElectrode",
      "type": "3d_object",
      "semantic": "Left electrode strip (anode)",
      "locator_hints": [
        "electrode at x=-2"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A9",
      "name": "CathodeElectrode",
      "type": "3d_object",
      "semantic": "Right electrode strip (cathode)",
      "locator_hints": [
        "electrode at x=2"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A10",
      "name": "ReadingsPanel",
      "type": "dom_element",
      "semantic": "Panel showing recorded voltage readings log",
      "locator_hints": [
        "div#readings-panel",
        "bottom-right readings list"
      ],
      "check": "!!document.getElementById('readings-panel')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialZnCuCell",
      "conditions": [
        "window.__3D_STATE__.anodeMaterial === 'Zn'",
        "window.__3D_STATE__.cathodeMaterial === 'Cu'",
        "window.__3D_STATE__.theoreticalEcell === 1.10",
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.isPlaying === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.anodeMaterial === 'Zn' && window.__3D_STATE__.cathodeMaterial === 'Cu' && window.__3D_STATE__.theoreticalEcell === 1.10 && window.__3D_STATE__.elapsedTime === 0 && window.__3D_STATE__.isPlaying === false"
    },
    {
      "id": "S1",
      "name": "SimulationRunning",
      "conditions": [
        "window.__3D_STATE__.isPlaying === true",
        "window.__3D_STATE__.elapsedTime > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === true && window.__3D_STATE__.elapsedTime > 0"
    },
    {
      "id": "S2",
      "name": "TimeAdvancedWithDecay",
      "conditions": [
        "window.__3D_STATE__.elapsedTime >= 20",
        "window.__3D_STATE__.cellVoltage < window.__3D_STATE__.theoreticalEcell"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elapsedTime >= 20 && window.__3D_STATE__.cellVoltage < window.__3D_STATE__.theoreticalEcell"
    },
    {
      "id": "S3",
      "name": "SimulationPaused",
      "conditions": [
        "window.__3D_STATE__.isPlaying === false",
        "window.__3D_STATE__.elapsedTime > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPlaying === false && window.__3D_STATE__.elapsedTime > 0"
    },
    {
      "id": "S4",
      "name": "ReadingRecorded",
      "conditions": [
        "window.__3D_STATE__.readingsCount >= 1",
        "window.__3D_STATE__.readings.length >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.readingsCount >= 1 && window.__3D_STATE__.readings && window.__3D_STATE__.readings.length >= 1"
    },
    {
      "id": "S5",
      "name": "ElectrodeSwappedZnAg",
      "conditions": [
        "window.__3D_STATE__.cathodeMaterial === 'Ag'",
        "window.__3D_STATE__.theoreticalEcell === 1.56"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cathodeMaterial === 'Ag' && window.__3D_STATE__.theoreticalEcell === 1.56"
    },
    {
      "id": "S6",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.speedMultiplier === 5"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.speedMultiplier === 5"
    },
    {
      "id": "S7",
      "name": "FastTimeAdvanced",
      "conditions": [
        "window.__3D_STATE__.elapsedTime >= 50",
        "window.__3D_STATE__.isPlaying === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elapsedTime >= 50 && window.__3D_STATE__.isPlaying === true"
    },
    {
      "id": "S8",
      "name": "SimulationReset",
      "conditions": [
        "window.__3D_STATE__.elapsedTime === 0",
        "window.__3D_STATE__.isPlaying === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.elapsedTime === 0 && window.__3D_STATE__.isPlaying === false"
    },
    {
      "id": "S9",
      "name": "InvalidCellDetected",
      "conditions": [
        "window.__3D_STATE__.isValidCell === false",
        "window.__3D_STATE__.cellVoltage === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isValidCell === false && window.__3D_STATE__.cellVoltage === 0"
    },
    {
      "id": "S10",
      "name": "MultipleReadingsRecorded",
      "conditions": [
        "window.__3D_STATE__.readingsCount >= 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.readingsCount >= 2"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button#play-pause"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.isPlaying === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.elapsedTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalEcell === 1.10",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cellVoltage)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2500
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage < 1.10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage >= 1.10 * (1 - 0.0003 * 30) - 0.02",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cellVoltage - (1.10 * (1 - 0.0003 * window.__3D_STATE__.elapsedTime))) < 0.03",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bubbleCount >= 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.elapsedTime)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime > 0",
            "tier": "L1"
          },
          {
            "expr": "typeof window.__3D_STATE__.cellVoltage === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage > 0 && window.__3D_STATE__.cellVoltage <= 1.10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isValidCell === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button#record"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.readingsCount === 1",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.readings)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.readings.length === 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.readings[0].voltage === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.readings[0].time === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.readings[0].pair === 'Zn/Cu'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('select#cathode-select').value='Ag'; document.querySelector('select#cathode-select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cathodeMaterial === 'Ag'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.standardPotentialCathode === 0.80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalEcell === 1.56",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.theoreticalEcell - (0.80 - (-0.76))) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isValidCell === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.electrodeCathodeColor !== undefined",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "3"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.speedMultiplier === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.anodeMaterial === 'Zn'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cathodeMaterial === 'Ag'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalEcell === 1.56",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('button#play-pause').click(); await new Promise(r => setTimeout(r, 1500));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 50",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage < 1.56",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage > 1.56 * (1 - 0.0003 * 100) - 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cellVoltage - (1.56 * (1 - 0.0003 * window.__3D_STATE__.elapsedTime))) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.cellVoltage)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.speedMultiplier === 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S7",
      "to": "S8",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.elapsedTime === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPlaying === false",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cellVoltage - window.__3D_STATE__.theoreticalEcell) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage === 1.56 || Math.abs(window.__3D_STATE__.cellVoltage - 1.56) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isValidCell === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S8",
      "to": "S9",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('select#anode-select').value='Cu'; document.querySelector('select#anode-select').dispatchEvent(new Event('change'));"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.anodeMaterial === 'Cu'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cathodeMaterial === 'Ag'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isValidCell === (0.80 - 0.34 > 0)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.theoreticalEcell === 0.46 || Math.abs(window.__3D_STATE__.theoreticalEcell - 0.46) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cellVoltage >= 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T10",
      "from": "S9",
      "to": "S10",
      "severity": "P0",
      "action": {
        "type": "script",
        "code": "document.querySelector('select#anode-select').value='Mg'; document.querySelector('select#anode-select').dispatchEvent(new Event('change')); document.querySelector('select#cathode-select').value='Cu'; document.querySelector('select#cathode-select').dispatchEvent(new Event('change')); document.querySelector('button#record').click();"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.anodeMaterial === 'Mg'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cathodeMaterial === 'Cu'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.theoreticalEcell - 2.71) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.readingsCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.readings.length >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isValidCell === true",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
