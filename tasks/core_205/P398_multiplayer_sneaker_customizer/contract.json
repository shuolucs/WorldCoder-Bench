{
  "task_id": "P398_multiplayer_sneaker_customizer",
  "affordances": [
    {
      "id": "A1",
      "name": "MichelleModel",
      "type": "3d_object",
      "semantic": "The loaded Michelle.glb model serving as the sneaker/mannequin",
      "locator_hints": [
        "GLTFLoader result",
        "scene child"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "PlayerToggle",
      "type": "dom_element",
      "semantic": "Button to switch between Player 1 and Player 2",
      "locator_hints": [
        "#player-toggle"
      ],
      "check": "!!document.getElementById('player-toggle')"
    },
    {
      "id": "A3",
      "name": "ZoneSole",
      "type": "dom_element",
      "semantic": "Button to select sole zone",
      "locator_hints": [
        "#zone-sole"
      ],
      "check": "!!document.getElementById('zone-sole')"
    },
    {
      "id": "A4",
      "name": "ZoneUpper",
      "type": "dom_element",
      "semantic": "Button to select upper zone",
      "locator_hints": [
        "#zone-upper"
      ],
      "check": "!!document.getElementById('zone-upper')"
    },
    {
      "id": "A5",
      "name": "ColorPalette",
      "type": "dom_element",
      "semantic": "Container with 8 color swatch buttons",
      "locator_hints": [
        "#color-palette",
        ".color-swatch"
      ],
      "check": "!!document.getElementById('color-palette') && document.querySelectorAll('.color-swatch').length > 0"
    },
    {
      "id": "A6",
      "name": "MaterialToggle",
      "type": "dom_element",
      "semantic": "Button to cycle material types",
      "locator_hints": [
        "#material-toggle"
      ],
      "check": "!!document.getElementById('material-toggle')"
    },
    {
      "id": "A7",
      "name": "SnapshotBtn",
      "type": "dom_element",
      "semantic": "Button to save current configuration snapshot",
      "locator_hints": [
        "#snapshot-btn"
      ],
      "check": "!!document.getElementById('snapshot-btn')"
    },
    {
      "id": "A8",
      "name": "UndoBtn",
      "type": "dom_element",
      "semantic": "Button to revert to previous snapshot",
      "locator_hints": [
        "#undo-btn"
      ],
      "check": "!!document.getElementById('undo-btn')"
    },
    {
      "id": "A9",
      "name": "RotateToggle",
      "type": "dom_element",
      "semantic": "Button to toggle auto-rotation",
      "locator_hints": [
        "#rotate-toggle"
      ],
      "check": "!!document.getElementById('rotate-toggle')"
    },
    {
      "id": "A10",
      "name": "PriceDisplay",
      "type": "dom_element",
      "semantic": "Shows calculated price",
      "locator_hints": [
        "#price-display"
      ],
      "check": "!!document.getElementById('price-display')"
    },
    {
      "id": "A11",
      "name": "SyncIndicator",
      "type": "dom_element",
      "semantic": "Shows sync status between players",
      "locator_hints": [
        "#sync-indicator"
      ],
      "check": "!!document.getElementById('sync-indicator')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoadedDefault",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.activePlayer === 1",
        "window.__3D_STATE__.activeZone === 'sole'",
        "window.__3D_STATE__.price === 89.99",
        "window.__3D_STATE__.isSynced === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.activePlayer === 1 && window.__3D_STATE__.activeZone === 'sole' && window.__3D_STATE__.price === 89.99 && window.__3D_STATE__.isSynced === true"
    },
    {
      "id": "S1",
      "name": "ColorAppliedToSole",
      "conditions": [
        "window.__3D_STATE__.zoneColors.sole === '#ff4444'",
        "window.__3D_STATE__.price > 89.99"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.zoneColors && window.__3D_STATE__.zoneColors.sole === '#ff4444' && window.__3D_STATE__.price > 89.99"
    },
    {
      "id": "S2",
      "name": "UpperZoneSelected",
      "conditions": [
        "window.__3D_STATE__.activeZone === 'upper'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeZone === 'upper'"
    },
    {
      "id": "S3",
      "name": "UpperColorApplied",
      "conditions": [
        "window.__3D_STATE__.zoneColors.upper === '#4444ff'",
        "window.__3D_STATE__.isSynced === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.zoneColors && window.__3D_STATE__.zoneColors.upper === '#4444ff' && window.__3D_STATE__.isSynced === false"
    },
    {
      "id": "S4",
      "name": "MaterialChangedToGlossy",
      "conditions": [
        "window.__3D_STATE__.currentMaterial === 'glossy'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.currentMaterial === 'glossy'"
    },
    {
      "id": "S5",
      "name": "Player2Active",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.zoneColors.sole === '#ffffff'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 2 && window.__3D_STATE__.zoneColors && window.__3D_STATE__.zoneColors.sole === '#ffffff'"
    },
    {
      "id": "S6",
      "name": "Player2ColorApplied",
      "conditions": [
        "window.__3D_STATE__.activePlayer === 2",
        "window.__3D_STATE__.zoneColors.sole === '#44ff44'"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activePlayer === 2 && window.__3D_STATE__.zoneColors && window.__3D_STATE__.zoneColors.sole === '#44ff44'"
    },
    {
      "id": "S7",
      "name": "RotationEnabled",
      "conditions": [
        "window.__3D_STATE__.isRotating === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isRotating === true"
    },
    {
      "id": "S8",
      "name": "RotationAccumulated",
      "conditions": [
        "window.__3D_STATE__.rotationAngle > 0.3",
        "window.__3D_STATE__.isRotating === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.rotationAngle > 0.3 && window.__3D_STATE__.isRotating === true"
    },
    {
      "id": "S9",
      "name": "SnapshotTaken",
      "conditions": [
        "window.__3D_STATE__.snapshotCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.snapshotCount >= 1"
    },
    {
      "id": "S10",
      "name": "UndoApplied",
      "conditions": [
        "window.__3D_STATE__.snapshotCount >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.snapshotCount >= 1"
    }
  ],
