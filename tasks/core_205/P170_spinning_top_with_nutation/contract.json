          },
          {
            "expr": "typeof window.__3D_STATE__.Time === 'number' && !isNaN(window.__3D_STATE__.Time)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Energy === 'number' && !isNaN(window.__3D_STATE__.Energy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#btn-start').textContent.trim().toLowerCase().includes('start')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time > 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.theta)",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.phi)",
            "tier": "L0"
          }
        ]
      }
    },
