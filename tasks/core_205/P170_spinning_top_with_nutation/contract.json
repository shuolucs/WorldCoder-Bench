{
  "task_id": "P170_spinning_top_with_nutation",
  "affordances": [
    {
      "id": "A1",
      "name": "SpinningTopModel",
      "type": "3d_object",
      "semantic": "The PrimaryIonDrive.glb model representing the spinning top",
      "locator_hints": [
        "scene.children",
        "gltf model mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "The ground plane at y=0",
      "locator_hints": [
        "PlaneGeometry mesh at y=0"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "StartPauseButton",
      "type": "dom_element",
      "semantic": "Button to start/pause simulation",
      "locator_hints": [
        "#btn-start"
      ],
      "check": "!!document.getElementById('btn-start')"
    },
    {
      "id": "A4",
      "name": "ResetButton",
      "type": "dom_element",
      "semantic": "Button to reset simulation",
      "locator_hints": [
        "#btn-reset"
      ],
      "check": "!!document.getElementById('btn-reset')"
    },
    {
      "id": "A5",
      "name": "SpeedSlider",
      "type": "dom_element",
      "semantic": "Slider controlling simulation speed",
      "locator_hints": [
        "#slider-speed"
      ],
      "check": "!!document.getElementById('slider-speed')"
    },
    {
      "id": "A6",
      "name": "DampingToggle",
      "type": "dom_element",
      "semantic": "Button to toggle damping on/off",
      "locator_hints": [
        "#btn-damping"
      ],
      "check": "!!document.getElementById('btn-damping')"
    },
    {
      "id": "A7",
      "name": "ImpulseButton",
      "type": "dom_element",
      "semantic": "Button to apply lateral impulse",
      "locator_hints": [
        "#btn-impulse"
      ],
      "check": "!!document.getElementById('btn-impulse')"
    },
    {
      "id": "A8",
      "name": "HUD",
      "type": "dom_element",
      "semantic": "Heads-up display showing simulation data",
      "locator_hints": [
        "#hud"
      ],
      "check": "!!document.getElementById('hud')"
    },
    {
      "id": "A9",
      "name": "SymmetryAxisLine",
      "type": "3d_object",
      "semantic": "Red line showing top's axis direction",
      "locator_hints": [
        "Line object in scene"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A10",
      "name": "NutationTrail",
      "type": "3d_object",
      "semantic": "Yellow dot trail of axis tip",
      "locator_hints": [
        "Points or small spheres in scene"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "ModelLoaded_SimStopped",
      "conditions": [
        "window.__3D_STATE__.modelLoaded === true",
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.time === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.simRunning === false && window.__3D_STATE__.time === 0"
    },
    {
      "id": "S1",
      "name": "SimRunning_Initial",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.time > 0",
        "window.__3D_STATE__.omega3 > 40"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simRunning === true && window.__3D_STATE__.time > 0 && window.__3D_STATE__.omega3 > 40"
    },
    {
      "id": "S2",
      "name": "NutationVisible",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.thetaMax - window.__3D_STATE__.thetaMin > 0.01"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simRunning === true && window.__3D_STATE__.thetaMax - window.__3D_STATE__.thetaMin > 0.01"
    },
    {
      "id": "S3",
      "name": "SimPaused",
      "conditions": [
        "window.__3D_STATE__.simRunning === false",
        "window.__3D_STATE__.time > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simRunning === false && window.__3D_STATE__.time > 0"
    },
    {
      "id": "S4",
      "name": "SimResumed",
      "conditions": [
        "window.__3D_STATE__.simRunning === true",
        "window.__3D_STATE__.time > 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.simRunning === true && window.__3D_STATE__.time > 0"
    },
    {
      "id": "S5",
      "name": "SpeedChanged",
      "conditions": [
        "window.__3D_STATE__.timeScale !== 1.0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.timeScale !== 1.0"
    },
    {
      "id": "S6",
      "name": "DampingDisabled",
      "conditions": [
        "window.__3D_STATE__.dampingEnabled === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dampingEnabled === false"
    },
    {
      "id": "S7",
      "name": "ImpulseApplied",
      "conditions": [
        "window.__3D_STATE__.thetaMax > 0.4"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.thetaMax > 0.4"
    },
    {
      "id": "S8",
      "name": "SimReset",
      "conditions": [
        "window.__3D_STATE__.time === 0",
        "window.__3D_STATE__.simRunning === false",
        "Math.abs(window.__3D_STATE__.theta - 0.3) < 0.01"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.time === 0 && window.__3D_STATE__.simRunning === false && Math.abs(window.__3D_STATE__.theta - 0.3) < 0.01"
    },
    {
      "id": "S9",
      "name": "TopFallen",
      "conditions": [
        "window.__3D_STATE__.topFallen === true",
        "window.__3D_STATE__.theta > Math.PI / 2"
      ],
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.topFallen === true || window.__3D_STATE__.theta > Math.PI / 2)"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S0",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Time !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Precession !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Energy !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.Time === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Energy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.time === 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.theta - 0.3) < 0.001",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.omega3 - 50) < 0.001",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "target": "#btn-start"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Time !== before.Time || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Time === 'number' && !isNaN(window.__3D_STATE__.Time)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Energy === 'number' && !isNaN(window.__3D_STATE__.Energy)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.simRunning === true",
            "tier": "L2"
          },
          {
            "expr": "document.querySelector('#btn-start').textContent.trim().toLowerCase().includes('pause')",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.initialEnergy > 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.energy)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energy - window.__3D_STATE__.initialEnergy) < 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Time !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Precession !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Energy !== undefined",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.Time === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.Energy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.time > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thetaMax - window.__3D_STATE__.thetaMin > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.thetaMin >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.thetaMax < Math.PI / 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.phi) > 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "click_dom",
