{
  "task_id": "P2993",
  "affordances": [
    {
      "id": "A1",
      "name": "CommercialRefrigerator",
      "type": "3d_object",
      "semantic": "Left-side GLTF model with adjustable material properties",
      "locator_hints": [
        "CommercialRefrigerator.glb",
        "left position",
        "metallic appliance"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.refrigeratorMetalness !== undefined)"
    },
    {
      "id": "A2",
      "name": "GlamVelvetSofa",
      "type": "3d_object",
      "semantic": "Right-side GLTF model with adjustable material properties",
      "locator_hints": [
        "GlamVelvetSofa.glb",
        "right position",
        "velvet furniture"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.sofaRoughness !== undefined)"
    },
    {
      "id": "A3",
      "name": "ReflectiveFloor",
      "type": "3d_object",
      "semantic": "Ground plane with high metalness and low roughness",
      "locator_hints": [
        "floor plane",
        "MeshStandardMaterial",
        "metalness 0.9"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "MaterialEnergyBudget",
      "type": "interaction",
      "semantic": "Shared energy constraint system governing material property adjustments",
      "locator_hints": [
        "5.0 total units",
        "conservation law",
        "budget display"
      ],
      "check": "true"
    },
    {
      "id": "A5",
      "name": "RefrigeratorSliders",
      "type": "dom_element",
      "semantic": "HTML control panel for refrigerator material channels",
      "locator_hints": [
        "left column",
        "metalness roughness emissive opacity sliders"
      ],
      "check": "document.querySelectorAll('input[data-object=\"refrigerator\"]').length > 0"
    },
    {
      "id": "A6",
      "name": "SofaSliders",
      "type": "dom_element",
      "semantic": "HTML control panel for sofa material channels",
      "locator_hints": [
        "right column",
        "metalness roughness emissive opacity sliders"
      ],
      "check": "document.querySelectorAll('input[data-object=\"sofa\"]').length > 0"
    },
    {
      "id": "A7",
      "name": "BudgetProgressBar",
      "type": "dom_element",
      "semantic": "Visual indicator of remaining energy budget",
      "locator_hints": [
        "progress bar",
        "remaining budget display"
      ],
      "check": "!!document.querySelector('progress') || document.querySelectorAll('[class*=\"budget\"]').length > 0"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loads with both models at default material values, budget initialized",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "refrigerator_adjusted",
      "description": "Refrigerator material properties modified, budget recalculated",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.refrigeratorMetalness === 'number' && typeof window.__3D_STATE__.sofaRoughness === 'number'"
    },
    {
      "id": "S2",
      "name": "sofa_compensated",
      "description": "Sofa material automatically reduced to maintain budget constraint",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.refrigeratorMetalness > 0.7 && typeof window.__3D_STATE__.sofaMetalness === 'number'"
    },
    {
      "id": "S3",
      "name": "cross_object_balance",
      "description": "Multiple adjustments across both objects with active compensation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaRoughness > 0.8 && window.__3D_STATE__.refrigeratorRoughness !== undefined"
    },
    {
      "id": "S4",
      "name": "extreme_values_tested",
      "description": "Edge cases tested: max metalness, min opacity, high emissive",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.refrigeratorEmissive > 0.5 && window.__3D_STATE__.sofaOpacity < 0.5"
    },
    {
      "id": "S5",
      "name": "budget_saturation",
      "description": "Energy budget fully consumed, further adjustments trigger immediate compensation",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.sofaMetalness > 0.95 && window.__3D_STATE__.refrigeratorOpacity < 0.3"
    },
    {
      "id": "S6",
      "name": "stability_verified",
      "description": "System maintains conservation law over extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.refrigeratorRoughness < 0.15 && typeof window.__3D_STATE__.sofaEmissive === 'number'"
    }
  ],
  "transitions": [
    {
      "id": "T0_init",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both models loaded",
        "Initial material values set",
        "Budget tracking active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.refrigeratorMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.sofaRoughness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorOpacity >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sofaOpacity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.refrigeratorEmissive)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T1_adjust_refrigerator",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[data-object=\"refrigerator\"][data-property=\"metalness\"]').value = 0.8; document.querySelector('input[data-object=\"refrigerator\"][data-property=\"metalness\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Refrigerator metalness increased",
        "Budget consumption calculated",
        "Sofa compensation triggered"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.refrigeratorMetalness > 0.7",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sofaMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaRoughness >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.refrigeratorMetalness - 0.8) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.sofaEmissive)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2_verify_compensation",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[data-object=\"sofa\"][data-property=\"roughness\"]').value = 0.9; document.querySelector('input[data-object=\"sofa\"][data-property=\"roughness\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Sofa roughness increased",
        "Cross-object budget balancing active",
        "Conservation law enforced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sofaRoughness > 0.8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorRoughness !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorOpacity > 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sofaRoughness - 0.9) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.sofaOpacity * 100))",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.refrigeratorMetalness)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3_multi_channel_adjust",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[data-object=\"refrigerator\"][data-property=\"emissive\"]').value = 0.7; document.querySelector('input[data-object=\"refrigerator\"][data-property=\"emissive\"]').dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { document.querySelector('input[data-object=\"sofa\"][data-property=\"opacity\"]').value = 0.3; document.querySelector('input[data-object=\"sofa\"][data-property=\"opacity\"]').dispatchEvent(new Event('input', {bubbles: true})); }, 800);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Multiple channels adjusted simultaneously",
        "Budget redistribution across properties",
        "Extreme values tested"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.refrigeratorEmissive > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sofaOpacity < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sofaMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sofaOpacity - 0.3) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.refrigeratorRoughness)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4_edge_case_testing",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[data-object=\"sofa\"][data-property=\"metalness\"]').value = 1.0; document.querySelector('input[data-object=\"sofa\"][data-property=\"metalness\"]').dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { document.querySelector('input[data-object=\"refrigerator\"][data-property=\"opacity\"]').value = 0.2; document.querySelector('input[data-object=\"refrigerator\"][data-property=\"opacity\"]').dispatchEvent(new Event('input', {bubbles: true})); }, 800);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Maximum metalness on sofa",
        "Minimum opacity on refrigerator",
        "Budget fully saturated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.sofaMetalness > 0.95",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorOpacity < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorEmissive !== null",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.sofaMetalness - 1.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.refrigeratorOpacity - 0.2) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.sofaRoughness)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5_budget_conservation",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[data-object=\"refrigerator\"][data-property=\"roughness\"]').value = 0.05; document.querySelector('input[data-object=\"refrigerator\"][data-property=\"roughness\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Final adjustment triggers compensation",
        "Budget constraint maintained",
        "System ready for stability test"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.refrigeratorRoughness < 0.15",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.sofaEmissive === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.sofaOpacity >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.refrigeratorRoughness - 0.05) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.refrigeratorMetalness)",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.sofaRoughness * 100))",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6_stability_run",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "60-second stability period completed",
        "All material values remain valid",
        "Budget conservation verified over time"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.refrigeratorMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.sofaMetalness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.refrigeratorOpacity >= 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sofaOpacity <= 1.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.refrigeratorRoughness)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.sofaEmissive)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
