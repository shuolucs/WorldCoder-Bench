{
  "task_id": "P3109",
  "affordances": [
    {
      "id": "A1",
      "name": "AnimatedMorphCube",
      "type": "3d_object",
      "semantic": "Morphing cube reactor at scene origin with morph target animation",
      "locator_hints": [
        "AnimatedMorphCube.glb",
        "center of scene",
        "morph target mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.morphCubeLoaded)"
    },
    {
      "id": "A2",
      "name": "CarbonFibreShell",
      "type": "3d_object",
      "semantic": "Carbon fibre containment shell scaled 3x surrounding the reactor cube",
      "locator_hints": [
        "CarbonFibre.glb",
        "scaled containment",
        "rotating shell"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.carbonFibreLoaded)"
    },
    {
      "id": "A3",
      "name": "ChannelASlider",
      "type": "dom_element",
      "semantic": "Range slider controlling morph target influence (0-1)",
      "locator_hints": [
        "input[type=range]",
        "Channel A",
        "morph intensity"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 0"
    },
    {
      "id": "A4",
      "name": "ChannelBSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling shell rotation speed (0-2 rad/s)",
      "locator_hints": [
        "input[type=range]",
        "Channel B",
        "rotation speed"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 1"
    },
    {
      "id": "A5",
      "name": "ChannelCSlider",
      "type": "dom_element",
      "semantic": "Range slider controlling point light emission intensity (0-3)",
      "locator_hints": [
        "input[type=range]",
        "Channel C",
        "emission intensity"
      ],
      "check": "document.querySelectorAll('input[type=range]').length > 2"
    },
    {
      "id": "A6",
      "name": "UndoButton",
      "type": "dom_element",
      "semantic": "Button to restore previous energy channel state",
      "locator_hints": [
        "button",
        "Undo",
        "history navigation"
      ],
      "check": "!!document.querySelector('button')"
    },
    {
      "id": "A7",
      "name": "RedoButton",
      "type": "dom_element",
      "semantic": "Button to reapply undone energy channel state",
      "locator_hints": [
        "button",
        "Redo",
        "history navigation"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Redo'))"
    },
    {
      "id": "A8",
      "name": "EnergyReadout",
      "type": "dom_element",
      "semantic": "Digital display showing current A, B, C values and their sum",
      "locator_hints": [
        "div",
        "readout",
        "energy sum display"
      ],
      "check": "!!document.querySelector('div')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, both GLB assets loading, energy channels at default balanced state",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.morphCubeLoaded === false || window.__3D_STATE__.carbonFibreLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "Both AnimatedMorphCube and CarbonFibre models loaded, energy system initialized to balanced state (1,1,1)",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.morphCubeLoaded === true && window.__3D_STATE__.carbonFibreLoaded === true && window.__3D_STATE__.undoStackSize === 0 && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01"
    },
    {
      "id": "S2",
      "name": "Energy Rebalanced",
      "description": "User adjusted one or more channel sliders, conservation law maintained, state pushed to undo stack",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoStackSize >= 1 && window.__3D_STATE__.totalStateChanges >= 1 && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01 && window.__3D_STATE__.lastActionType === 'slider'"
    },
    {
      "id": "S3",
      "name": "Undo Applied",
      "description": "User clicked Undo, previous energy state restored, current state moved to redo stack",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lastActionType === 'undo' && window.__3D_STATE__.redoStackSize >= 1 && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01"
    },
    {
      "id": "S4",
      "name": "Redo Applied",
      "description": "User clicked Redo, forward state restored from redo stack",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lastActionType === 'redo' && window.__3D_STATE__.undoStackSize >= 1 && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01"
    },
    {
      "id": "S5",
      "name": "Multi-Channel Active",
      "description": "Multiple slider adjustments made, undo stack populated, energy conservation maintained across all changes",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.undoStackSize >= 2 && window.__3D_STATE__.totalStateChanges >= 2 && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01 && window.__3D_STATE__.conservationViolations === 0"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "System running with consistent energy distribution, shell rotating, morph active, no user input for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.morphCubeLoaded === true && window.__3D_STATE__.carbonFibreLoaded === true && Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01 && window.__3D_STATE__.conservationViolations === 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both GLB models loaded and added to scene",
        "Energy channels initialized to balanced state",
        "Undo and redo stacks empty"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.morphCubeLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.carbonFibreLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.channelA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=range]')[0].value = 0.6; document.querySelectorAll('input[type=range]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Channel A adjusted to 0.6",
        "Channels B and C rebalanced to maintain sum of 3.0",
        "Undo stack size increased by 1",
        "Total state changes incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.channelA - 0.6) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStateChanges >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationViolations === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=range]')[1].value = 1.5; document.querySelectorAll('input[type=range]')[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Channel B adjusted to 1.5 rad/s",
        "Shell rotation speed updated",
        "Energy conservation maintained",
        "Undo stack contains multiple entries"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.channelB - 1.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shellRotationY !== undefined",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.shellRotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 800
      },
      "postconditions": [
        "Undo button clicked",
        "Previous energy state restored",
        "Undo stack size decreased by 1",
        "Redo stack size increased by 1",
        "Last action type is 'undo'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionType === 'undo'",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.channelA === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.conservationViolations === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Redo')).click();",
        "wait_ms": 800
      },
      "postconditions": [
        "Redo button clicked",
        "Forward state restored from redo stack",
        "Redo stack size decreased by 1",
        "Undo stack size increased by 1",
        "Last action type is 'redo'"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lastActionType === 'redo'",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.undoStackSize >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalStateChanges)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.conservationViolations === 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=range]')[2].value = 2.2; document.querySelectorAll('input[type=range]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Channel C adjusted to 2.2",
        "Point light intensity updated",
        "Energy conservation maintained",
        "Redo stack cleared after new action"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.channelC - 2.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.redoStackSize === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalStateChanges >= 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastActionType === 'slider'",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Shell continues rotating at current speed",
        "Morph target influence stable",
        "Energy sum remains at 3.0",
        "No conservation violations detected"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.channelB >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.channelB <= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationViolations === 0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.shellRotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System stable for 60 seconds",
        "Energy conservation maintained throughout",
        "Shell rotation continuous",
        "All state values remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.energySum - 3.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.morphCubeLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.carbonFibreLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conservationViolations === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalStateChanges === 'number'",
