{
  "task_id": "P3022",
  "affordances": [
    {
      "id": "A1",
      "name": "DirectionalLightColorPicker",
      "type": "dom_element",
      "semantic": "GUI color picker controlling directional light color temperature",
      "locator_hints": [
        "color picker in GUI panel",
        "light color control"
      ],
      "check": "!!document.querySelector('.lil-gui input[type=\"color\"]')"
    },
    {
      "id": "A2",
      "name": "ChessRotationSlider",
      "type": "dom_element",
      "semantic": "Slider controlling Y-axis rotation of chess set (0-360 degrees)",
      "locator_hints": [
        "rotation slider",
        "chess rotation control"
      ],
      "check": "Array.from(document.querySelectorAll('.lil-gui input[type=\"range\"]')).some(s => parseFloat(s.max) === 360)"
    },
    {
      "id": "A3",
      "name": "BottlePositionSlider",
      "type": "dom_element",
      "semantic": "Slider controlling X position of water bottle on table",
      "locator_hints": [
        "bottle position slider",
        "X-axis control"
      ],
      "check": "Array.from(document.querySelectorAll('.lil-gui input[type=\"range\"]')).some(s => parseFloat(s.min) === -1.5 && parseFloat(s.max) === 1.5)"
    },
    {
      "id": "A4",
      "name": "BottleScaleSlider",
      "type": "dom_element",
      "semantic": "Slider controlling uniform scale of water bottle",
      "locator_hints": [
        "scale slider",
        "bottle size control"
      ],
      "check": "Array.from(document.querySelectorAll('.lil-gui input[type=\"range\"]')).some(s => parseFloat(s.min) === 0.5 && parseFloat(s.max) === 2)"
    },
    {
      "id": "A5",
      "name": "ChessSetModel",
      "type": "3d_object",
      "semantic": "ABeautifulGame GLB model placed on table as centerpiece",
      "locator_hints": [
        "chess set on table",
        "ABeautifulGame model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded)"
    },
    {
      "id": "A6",
      "name": "WaterBottleModel",
      "type": "3d_object",
      "semantic": "WaterBottle GLB model positioned on table surface",
      "locator_hints": [
        "water bottle on table",
        "WaterBottle model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading, models not yet loaded, default lighting and camera setup",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Models Loaded",
      "description": "Both GLB models loaded and positioned on table with default settings",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === true"
    },
    {
      "id": "S2",
      "name": "Light Adjusted",
      "description": "User has adjusted directional light color to warm architectural tone",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lightColorR > 0.6"
    },
    {
      "id": "S3",
      "name": "Chess Rotated",
      "description": "Chess set has been rotated on Y-axis to a non-default angle",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.chessRotationY === 'number' && window.__3D_STATE__.chessRotationY > 0"
    },
    {
      "id": "S4",
      "name": "Bottle Repositioned",
      "description": "Water bottle has been moved along X-axis on table surface",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.bottlePositionX === 'number' && Math.abs(window.__3D_STATE__.bottlePositionX) > 0.1"
    },
    {
      "id": "S5",
      "name": "Bottle Scaled",
      "description": "Water bottle has been scaled to a non-default size",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.bottleScale === 'number' && Math.abs(window.__3D_STATE__.bottleScale - 1.0) > 0.1"
    },
    {
      "id": "S6",
      "name": "Stable Configuration",
      "description": "All configurations stable for extended period, scene fully interactive",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelsLoaded === true && window.__3D_STATE__.bottleScale > 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both models loaded and visible",
        "modelsLoaded state is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('.lil-gui input[type=\"color\"]').value = '#ff9966'; document.querySelector('.lil-gui input[type=\"color\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Directional light color changed to warm tone",
        "Light red component greater than 0.6"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lightColorR === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lightColorR > 0.6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.lil-gui input[type=\"range\"]'); const rotSlider = Array.from(sliders).find(s => parseFloat(s.max) === 360); if(rotSlider) { rotSlider.value = 180; rotSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Chess set rotated to 180 degrees on Y-axis",
        "chessRotationY is between 0 and 360"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chessRotationY === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chessRotationY >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chessRotationY - 180) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.lil-gui input[type=\"range\"]'); const posSlider = Array.from(sliders).find(s => parseFloat(s.min) === -1.5 && parseFloat(s.max) === 1.5); if(posSlider) { posSlider.value = 0.8; posSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Water bottle repositioned along X-axis",
        "bottlePositionX is within table bounds"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bottlePositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bottlePositionX >= -1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bottlePositionX - 0.8) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.lil-gui input[type=\"range\"]'); const scaleSlider = Array.from(sliders).find(s => parseFloat(s.min) === 0.5 && parseFloat(s.max) === 2); if(scaleSlider) { scaleSlider.value = 1.5; scaleSlider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Water bottle scaled to 1.5x size",
        "bottleScale is within valid range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bottleScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bottleScale >= 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bottleScale - 1.5) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('.lil-gui input[type=\"range\"]'); if(sliders.length > 0) { sliders[0].value = parseFloat(sliders[0].value) + 0.1; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Interaction count incremented",
        "Scene remains stable after interaction"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.interactionCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.interactionCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "All state values remain stable",
        "Models loaded flag remains true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.bottleScale > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.chessRotationY)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state values valid and unchanged"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.modelsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightColorR >= 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.bottlePositionX) && isFinite(window.__3D_STATE__.bottleScale)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
