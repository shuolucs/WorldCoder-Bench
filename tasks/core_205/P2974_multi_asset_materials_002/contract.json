{
  "task_id": "P2974",
  "affordances": [
    {
      "id": "A1",
      "name": "Lantern Flame",
      "type": "3d_object",
      "semantic": "clickable lantern object that cycles flame color",
      "locator_hints": [
        "lantern mesh",
        "flame emissive material",
        "center of lantern model"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Chair Fabric",
      "type": "3d_object",
      "semantic": "right-clickable chair mesh that toggles material mode",
      "locator_hints": [
        "chair damask mesh",
        "purple-gold fabric material",
        "center chair object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Lantern Glass Panels",
      "type": "3d_object",
      "semantic": "shift-clickable glass panels that toggle transparency",
      "locator_hints": [
        "lantern glass mesh",
        "transparent material panels",
        "lantern exterior"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Material Sliders Panel",
      "type": "dom_element",
      "semantic": "HTML overlay with 4 sliders for material properties",
      "locator_hints": [
        "top-right overlay",
        "slider controls",
        "roughness metalness emissive controls"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A5",
      "name": "Energy Budget HUD",
      "type": "dom_element",
      "semantic": "visual bar showing remaining energy budget",
      "locator_hints": [
        "HUD bar",
        "energy display",
        "budget indicator"
      ],
      "check": "!!(window.__3D_STATE__ && typeof window.__3D_STATE__.energyBudget === 'number')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with both models, full energy budget of 3.0, default materials",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.energyBudget === 3.0 && window.__3D_STATE__.interactionCount === 0)"
    },
    {
      "id": "S1",
      "name": "Flame Color Cycling",
      "description": "User has clicked lantern to cycle flame colors, energy reduced by 0.2 per click",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lanternFlameColorIndex >= 1 && window.__3D_STATE__.energyBudget < 3.0"
    },
    {
      "id": "S2",
      "name": "Material Slider Adjustments",
      "description": "User has adjusted material sliders, energy reduced by 0.1 per 0.1 slider change",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.interactionCount >= 2 && window.__3D_STATE__.energyBudget < 2.8"
    },
    {
      "id": "S3",
      "name": "Chair Material Mode Toggle",
      "description": "User has right-clicked chair to toggle between standard and physical material modes",
      "condition": "window.__3D_STATE__ && (window.__3D_STATE__.chairMaterialMode === 'physical' || window.__3D_STATE__.chairMaterialMode === 'standard') && window.__3D_STATE__.energyBudget < 2.7"
    },
    {
      "id": "S4",
      "name": "Lantern Glass Transparency Toggle",
      "description": "User has shift-clicked lantern glass to toggle transparency and transmission",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.lanternGlassTransparent === 'boolean' && window.__3D_STATE__.energyBudget < 2.4"
    },
    {
      "id": "S5",
      "name": "Multi-Interaction State",
      "description": "User has performed multiple interactions across different affordances, energy budget partially depleted",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.interactionCount >= 6 && window.__3D_STATE__.totalEnergySpent > 0.5"
    },
    {
      "id": "S6",
      "name": "Stable Final State",
      "description": "All interactions complete, system stable with remaining energy budget",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.interactionCount >= 7 && window.__3D_STATE__.energyBudget >= 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2, clientY: window.innerHeight/2}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Lantern flame color has changed to next color in cycle",
        "Energy budget reduced by 0.2 units",
        "Flame color index incremented by 1"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lanternFlameColorIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.lanternFlameColorIndex >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 3.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyBudget - 2.8) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = parseFloat(slider.value) + 0.1; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "One material slider value has increased by 0.1",
        "Energy budget reduced by additional 0.1 units",
        "Material property updated on chair or lantern"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chairRoughness === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 2.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyBudget - 2.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('contextmenu', {bubbles: true, button: 2, clientX: window.innerWidth/2, clientY: window.innerHeight/2}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Chair material mode toggled between standard and physical",
        "Energy budget reduced by 0.3 units",
        "Chair material mode state updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chairMaterialMode === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chairMaterialMode === 'physical' || window.__3D_STATE__.chairMaterialMode === 'standard'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 2.7",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyBudget - 2.4) < 0.05",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, shiftKey: true, clientX: window.innerWidth/2, clientY: window.innerHeight/2}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Lantern glass transparency toggled",
        "Energy budget reduced by 0.2 units",
        "Glass transparency state updated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.lanternGlassTransparent === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 2.4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.energyBudget - 2.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {bubbles: true, clientX: window.innerWidth/2, clientY: window.innerHeight/2})); setTimeout(() => { const slider = document.querySelectorAll('input[type=\"range\"]')[1]; if(slider) { slider.value = parseFloat(slider.value) + 0.2; slider.dispatchEvent(new Event('input', {bubbles: true})); }}, 500);",
        "wait_ms": 1500
      },
      "postconditions": [
        "Multiple interactions performed in sequence",
        "Energy budget further reduced",
        "Total energy spent increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.totalEnergySpent === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergySpent > 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget < 2.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); if(sliders[2]) { sliders[2].value = parseFloat(sliders[2].value) + 0.3; sliders[2].dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Additional slider adjustment performed",
        "Energy budget continues to decrease",
        "Interaction count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 7",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.energyBudget)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergySpent <= 3.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "console.log('Final state check:', window.__3D_STATE__);",
        "wait_ms": 1000
      },
      "postconditions": [
        "All state fields are valid and within expected ranges",
        "Energy budget is non-negative",
        "System is stable"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.totalEnergySpent)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.chairRoughness >= 0 && window.__3D_STATE__.chairRoughness <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "No state corruption or crashes",
        "Energy budget remains valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.energyBudget === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.energyBudget >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.energyBudget)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.interactionCount >= 7",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
