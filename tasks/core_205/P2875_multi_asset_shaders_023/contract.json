{
  "task_id": "P2875",
  "affordances": [
    {
      "id": "A1",
      "name": "PotOfCoals",
      "type": "3d_object",
      "semantic": "Coal pot model with custom emissive shader",
      "locator_hints": [
        "PotOfCoals.glb",
        "center-left position",
        "emissive material"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "DiffuseTransmissionPlant",
      "type": "3d_object",
      "semantic": "Plant model with custom transmission and growth shader",
      "locator_hints": [
        "DiffuseTransmissionPlant.glb",
        "center-right position",
        "subsurface scattering"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "CoalEmissiveShader",
      "type": "interaction",
      "semantic": "Custom shader controlling coal glow via RGB channels",
      "locator_hints": [
        "redChannel",
        "greenChannel",
        "blueChannel",
        "ShaderMaterial"
      ],
      "check": "true"
    },
    {
      "id": "A4",
      "name": "PlantTransmissionShader",
      "type": "interaction",
      "semantic": "Custom shader controlling plant absorption and growth",
      "locator_hints": [
        "absorptionR",
        "absorptionG",
        "absorptionB",
        "growthFactor"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial",
      "description": "Scene loads with default shader parameters, both models visible",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "coal_red_glow",
      "description": "Coal emissive shader emphasizes red channel, minimal green/blue",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redChannel > 0.8 && window.__3D_STATE__.greenChannel < 0.2 && window.__3D_STATE__.blueChannel < 0.2"
    },
    {
      "id": "S2",
      "name": "coal_multi_color",
      "description": "Coal shader blends multiple RGB channels for mixed glow",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.redChannel > 0.6 && window.__3D_STATE__.greenChannel > 0.4 && window.__3D_STATE__.blueChannel > 0.5"
    },
    {
      "id": "S3",
      "name": "plant_growth_start",
      "description": "Plant growth factor increases, vertices displace outward",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.growthFactor > 1.0"
    },
    {
      "id": "S4",
      "name": "plant_absorption_shift",
      "description": "Plant absorption coefficients change, altering subsurface scattering color",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.absorptionG > 0.6 && typeof window.__3D_STATE__.absorptionR === 'number' && typeof window.__3D_STATE__.absorptionB === 'number'"
    },
    {
      "id": "S5",
      "name": "combined_effects",
      "description": "Both shaders active with non-default parameters",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.growthFactor > 1.4 && window.__3D_STATE__.redChannel > 0.7 && window.__3D_STATE__.absorptionB < 0.3"
    },
    {
      "id": "S6",
      "name": "stability_run",
      "description": "60-second stability test with all shader effects active",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T0",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.redChannel = 0.9; window.__3D_STATE__.greenChannel = 0.1; window.__3D_STATE__.blueChannel = 0.1;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Coal emissive shader red channel set to 0.9",
        "Green and blue channels minimized"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redChannel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redChannel > 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.redChannel - 0.9) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.greenChannel < 0.2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blueChannel < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T1",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.redChannel = 0.7; window.__3D_STATE__.greenChannel = 0.5; window.__3D_STATE__.blueChannel = 0.6;",
        "wait_ms": 1000
      },
      "postconditions": [
        "All three RGB channels active in coal shader",
        "Mixed color emissive glow visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redChannel !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.greenChannel > 0.4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.blueChannel > 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.redChannel - 0.7) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.greenChannel - 0.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.blueChannel)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.growthFactor = 1.2;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Plant growth factor set to 1.2",
        "Vertex displacement active in plant shader"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.growthFactor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.growthFactor > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.growthFactor - 1.2) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.growthFactor !== null",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.absorptionR = 0.3; window.__3D_STATE__.absorptionG = 0.7; window.__3D_STATE__.absorptionB = 0.4;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Plant absorption coefficients updated",
        "Subsurface scattering color shifted"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.absorptionR === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.absorptionG > 0.6",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.absorptionR - 0.3) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.absorptionB - 0.4) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.absorptionG)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.redChannel = 0.8; window.__3D_STATE__.greenChannel = 0.3; window.__3D_STATE__.blueChannel = 0.4; window.__3D_STATE__.growthFactor = 1.5; window.__3D_STATE__.absorptionR = 0.5; window.__3D_STATE__.absorptionG = 0.6; window.__3D_STATE__.absorptionB = 0.2;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Both coal and plant shaders active with combined effects",
        "All shader parameters set to non-default values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.redChannel !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.growthFactor > 1.4",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.redChannel - 0.8) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.growthFactor - 1.5) < 0.05",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.absorptionB < 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.absorptionG)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All shader effects maintain consistent state"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.redChannel === 'number'",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.growthFactor === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.redChannel > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.growthFactor > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.absorptionR)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.absorptionG)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
