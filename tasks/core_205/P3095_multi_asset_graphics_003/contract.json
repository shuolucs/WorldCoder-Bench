{
  "task_id": "P3095",
  "affordances": [
    {
      "id": "A1",
      "name": "PotOfCoals",
      "type": "3d_object",
      "semantic": "Central heating element with glowing coals and point light",
      "locator_hints": [
        "GLB model at scene center",
        "orange point light source",
        "stone platform base"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "SpecularSilkPouf",
      "type": "3d_object",
      "semantic": "Draggable silk object that receives dye coating",
      "locator_hints": [
        "GLB model above pot",
        "responds to mouse drag",
        "rotates during immersion"
      ],
      "check": "!!(window.scene && window.scene.children.find(c => c.userData.name === 'pouf'))"
    },
    {
      "id": "A3",
      "name": "HeatSlider",
      "type": "dom_element",
      "semantic": "Temperature control slider (100-900°C)",
      "locator_hints": [
        "input[type='range']",
        "controls forge heat",
        "affects particle speed"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "RotationKnob",
      "type": "dom_element",
      "semantic": "Rotation angle control (0-360°)",
      "locator_hints": [
        "input element for rotation",
        "controls pouf spin",
        "affects coating uniformity"
      ],
      "check": "!!Array.from(document.querySelectorAll('input')).find(i => i.max == '360' || i.placeholder?.includes('rotation'))"
    },
    {
      "id": "A5",
      "name": "PigmentButtons",
      "type": "dom_element",
      "semantic": "Three buttons for selecting dye pigment color",
      "locator_hints": [
        "button elements",
        "Crimson, Sapphire, Gold options",
        "changes particle color"
      ],
      "check": "Array.from(document.querySelectorAll('button')).filter(b => b.textContent.match(/Sapphire|Gold|Crimson/i)).length >= 3"
    },
    {
      "id": "A6",
      "name": "EnergyParticles",
      "type": "3d_object",
      "semantic": "200 rising colored spheres representing dye energy",
      "locator_hints": [
        "particle system",
        "cycles through pigment colors",
        "speed varies with heat"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.particleCount === 200)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Workshop Setup",
      "description": "Scene loaded with pot at center, pouf floating above, default heat 500°C, Crimson pigment selected, particles rising at medium speed",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === false || (window.__3D_STATE__.heatTemperature >= 450 && window.__3D_STATE__.heatTemperature <= 550 && window.__3D_STATE__.poufYPosition >= 3.5 && window.__3D_STATE__.dyeLayerCount === 0))"
    },
    {
      "id": "S1",
      "name": "Heat Adjusted",
      "description": "User has changed heat slider, affecting light intensity and particle speed proportionally",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.heatTemperature >= 100 && window.__3D_STATE__.heatTemperature <= 900 && (window.__3D_STATE__.heatTemperature < 450 || window.__3D_STATE__.heatTemperature > 550)"
    },
    {
      "id": "S2",
      "name": "Pouf Lowered",
      "description": "User dragged pouf downward toward coals, Y position decreased, immersion depth increased",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.poufYPosition >= 0.5 && window.__3D_STATE__.poufYPosition < 3.5 && window.__3D_STATE__.immersionDepth > 0.1"
    },
    {
      "id": "S3",
      "name": "Rotation Configured",
      "description": "User adjusted rotation knob, pouf spinning at specified angle, affecting coating uniformity",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.rotationAngle > 0 && window.__3D_STATE__.rotationAngle <= 360 && window.__3D_STATE__.coatingUniformity > 0"
    },
    {
      "id": "S4",
      "name": "Pigment Changed",
      "description": "User selected different pigment, particle color updated, dye layer count incremented",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedPigment && window.__3D_STATE__.selectedPigment.length > 0 && window.__3D_STATE__.dyeLayerCount > 0"
    },
    {
      "id": "S5",
      "name": "Full Immersion Dyeing",
      "description": "Pouf at minimum Y position with rotation active, maximum dye absorption occurring",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.poufYPosition >= 0.5 && window.__3D_STATE__.poufYPosition < 1.0 && window.__3D_STATE__.immersionDepth > 0.85 && window.__3D_STATE__.rotationAngle > 0"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "All parameters validated and stable, workshop operating continuously for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDragging === false && window.__3D_STATE__.dyeLayerCount >= 0 && window.__3D_STATE__.dyeLayerCount <= 10 && window.__3D_STATE__.particleCount === 200"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 750; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Heat temperature updated to 750°C",
        "Light intensity increased proportionally",
        "Particle speed increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.heatTemperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heatTemperature >= 700 && window.__3D_STATE__.heatTemperature <= 800",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightIntensity > 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleSpeed > 1.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pouf = window.scene.children.find(c => c.userData.name === 'pouf'); if (pouf) { pouf.position.y = 1.2; window.__3D_STATE__.poufYPosition = 1.2; window.__3D_STATE__.immersionDepth = (4.0 - 1.2) / (4.0 - 0.5); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pouf Y position lowered to 1.2 units",
        "Immersion depth calculated and increased",
        "Pouf closer to energy field"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.poufYPosition === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poufYPosition >= 0.5 && window.__3D_STATE__.poufYPosition <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.poufYPosition - 1.2) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.immersionDepth > 0.5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const rotInput = Array.from(document.querySelectorAll('input')).find(i => i.max == '360' || i.placeholder?.includes('rotation')); if (rotInput) { rotInput.value = 180; rotInput.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1200
      },
      "postconditions": [
        "Rotation angle set to 180 degrees",
        "Pouf spinning during immersion",
        "Coating uniformity improved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.rotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.rotationAngle >= 0 && window.__3D_STATE__.rotationAngle <= 360",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.rotationAngle - 180) < 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.coatingUniformity > 0.3",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')).filter(b => b.textContent.match(/Sapphire|Gold|Crimson/i)); if (buttons.length > 1) { buttons[1].click(); }",
        "wait_ms": 1000
      },
      "postconditions": [
        "Pigment changed to Sapphire or Gold",
        "Particle color updated",
        "Dye layer count incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedPigment === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedPigment !== undefined && window.__3D_STATE__.selectedPigment.length > 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dyeLayerCount > 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.dyeLayerCount)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const pouf = window.scene.children.find(c => c.userData.name === 'pouf'); if (pouf) { pouf.position.y = 0.6; window.__3D_STATE__.poufYPosition = 0.6; window.__3D_STATE__.immersionDepth = (4.0 - 0.6) / (4.0 - 0.5); window.__3D_STATE__.isDragging = true; }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Pouf at near-minimum Y position (deep immersion)",
        "Immersion depth near maximum",
        "Dragging state active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.poufYPosition === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.poufYPosition >= 0.5 && window.__3D_STATE__.poufYPosition < 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.immersionDepth > 0.85",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.isDragging === 'boolean'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.isDragging = false; window.__3D_STATE__.dyeLayerCount = Math.min(10, window.__3D_STATE__.dyeLayerCount + 2);",
        "wait_ms": 1000
      },
      "postconditions": [
        "Dragging completed",
        "Dye layers accumulated",
        "All parameters within valid ranges"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDragging === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dyeLayerCount >= 0 && window.__3D_STATE__.dyeLayerCount <= 10",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.particleCount === 200",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.heatTemperature)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable for 60 seconds",
        "All state fields maintain valid values",
        "No crashes or errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.heatTemperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.heatTemperature >= 100 && window.__3D_STATE__.heatTemperature <= 900",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.poufYPosition >= 0.5 && window.__3D_STATE__.poufYPosition <= 4.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.lightIntensity) && isFinite(window.__3D_STATE__.particleSpeed)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
