{
  "task_id": "P172_rotational_inertia_demo_with_physics_deb",
  "affordances": [
    {
      "id": "A1",
      "name": "Turntable Disc",
      "type": "3d_object",
      "semantic": "Blue cylindrical disc that rotates around Y-axis with the coffeemat model",
      "locator_hints": [
        "CylinderGeometry",
        "radius 2",
        "height 0.1",
        "blue color",
        "y=0.05"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Coffeemat Model",
      "type": "3d_object",
      "semantic": "GLB model loaded from coffeemat.glb, sits on turntable, rotates with disc",
      "locator_hints": [
        "GLTFLoader",
        "coffeemat.glb",
        "scaled to ~2 units",
        "origin position"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Ground Plane",
      "type": "3d_object",
      "semantic": "Gray 20x20 plane at y=0 serving as floor",
      "locator_hints": [
        "PlaneGeometry",
        "20x20",
        "gray",
        "y=0"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Physics Debug Overlay",
      "type": "dom_element",
      "semantic": "On-screen display showing angular velocity, angular acceleration, and rotation angle",
      "locator_hints": [
        "DOM overlay",
        "omega",
        "alpha",
        "theta",
        "real-time physics values"
      ],
      "check": "document.querySelectorAll('div').length > 0 && !!(window.__3D_STATE__ && typeof window.__3D_STATE__.omega !== 'undefined')"
    },
    {
      "id": "A5",
      "name": "Rotation Control",
      "type": "interaction",
      "semantic": "User interaction to apply torque or change angular velocity",
      "locator_hints": [
        "keyboard",
        "mouse",
        "torque application",
        "angular velocity change"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_load",
      "description": "Scene initializing, model loading, physics not yet started",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false"
    },
    {
      "id": "S1",
      "name": "model_loaded",
      "description": "Coffeemat model loaded and positioned, turntable visible, physics initialized to zero",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.omega === 0"
    },
    {
      "id": "S2",
      "name": "rotation_started",
      "description": "Angular velocity applied, turntable and model begin rotating, debug overlay shows non-zero omega",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.omega > 1.0 && window.__3D_STATE__.theta < 2.0"
    },
    {
      "id": "S3",
      "name": "steady_rotation",
      "description": "Constant angular velocity maintained, rotation angle increasing linearly",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.omega > 1.0 && window.__3D_STATE__.theta > 2.0 && Math.abs(window.__3D_STATE__.alpha) < 0.1"
    },
    {
      "id": "S4",
      "name": "torque_applied",
      "description": "External torque applied, angular acceleration non-zero, omega changing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.alpha > 0.5 && window.__3D_STATE__.omega > 2.0"
    },
    {
      "id": "S5",
      "name": "deceleration",
      "description": "Negative torque or friction applied, angular velocity decreasing toward zero",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.alpha < 0 && window.__3D_STATE__.omega > 0"
    },
    {
      "id": "S6",
      "name": "stable_demonstration",
      "description": "Physics simulation running smoothly for extended period, all values stable and finite",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.omega - 0.5) < 0.3 && Math.abs(window.__3D_STATE__.alpha) < 0.1 && isFinite(window.__3D_STATE__.theta)"
    }
  ],
  "transitions": [
    {
      "id": "T0_1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "coffeemat.glb model loaded and added to scene",
        "turntable disc created and positioned at y=0.05",
        "physics state initialized with omega=0, alpha=0, theta=0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.modelLoaded === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.omega === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.omega === 0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T1_2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.omega = 1.5; window.__3D_STATE__.alpha = 0;",
        "wait_ms": 1000
      },
      "postconditions": [
        "angular velocity set to non-zero value",
        "turntable and model begin rotating",
        "debug overlay displays omega > 0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.omega !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.omega > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.omega - 1.5) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.alpha === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.omega)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2_3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "rotation angle theta has increased significantly",
        "angular velocity remains constant",
        "angular acceleration is zero"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.theta === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.theta > 2.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.theta)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.alpha !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.alpha) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.omega > 1.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3_4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.alpha = 0.8; window.__3D_STATE__.torqueApplied = true;",
        "wait_ms": 1500
      },
      "postconditions": [
        "angular acceleration set to positive value",
        "angular velocity increasing over time",
        "torque flag set to true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.alpha === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.alpha > 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.alpha - 0.8) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.omega > 2.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.alpha)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4_5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.alpha = -1.2; window.__3D_STATE__.torqueApplied = false;",
        "wait_ms": 2000
      },
      "postconditions": [
        "negative angular acceleration applied",
        "angular velocity decreasing",
        "rotation continues but slowing down"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.alpha === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.alpha < 0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.alpha + 1.2) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.omega !== null",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.omega > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.omega)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5_6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.alpha = 0; window.__3D_STATE__.omega = 0.5;",
        "wait_ms": 1000
      },
      "postconditions": [
        "physics stabilized at low constant angular velocity",
        "all physics values finite and valid",
        "debug overlay showing stable readings"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.omega === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.omega > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.omega - 0.5) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.alpha === 'number'",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.alpha) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.theta)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6_stability",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "simulation runs continuously for 60 seconds",
        "no crashes or infinite values",
        "physics remains stable throughout"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.omega === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.omega)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.theta === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.theta)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.modelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "Number.isFinite(window.__3D_STATE__.alpha)",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
