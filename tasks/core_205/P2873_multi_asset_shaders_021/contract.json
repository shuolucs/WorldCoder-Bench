{
  "task_id": "P2873",
  "affordances": [
    {
      "id": "A1",
      "name": "Caustic Intensity Slider",
      "type": "dom_element",
      "semantic": "Range input controlling water caustic shader intensity 0-100",
      "locator_hints": [
        "input[type='range']",
        "slider for caustic",
        "water caustic control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "City Glow Slider",
      "type": "dom_element",
      "semantic": "Range input controlling city building emission glow 0-100",
      "locator_hints": [
        "input[type='range']",
        "slider for glow",
        "city glow control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Day-Night Cycle Slider",
      "type": "dom_element",
      "semantic": "Range input controlling sun intensity and sky color 0-100",
      "locator_hints": [
        "input[type='range']",
        "slider for day-night",
        "cycle control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Fog Density Slider",
      "type": "dom_element",
      "semantic": "Range input controlling atmospheric fog density 0-100",
      "locator_hints": [
        "input[type='range']",
        "slider for fog",
        "fog density control"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A5",
      "name": "Pool Water Surface",
      "type": "3d_object",
      "semantic": "Pool model with custom caustic shader material applied",
      "locator_hints": [
        "pool.glb mesh",
        "water surface",
        "caustic shader target"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.poolModelLoaded)"
    },
    {
      "id": "A6",
      "name": "Virtual City Buildings",
      "type": "3d_object",
      "semantic": "City model with emissive glow shader applied to buildings",
      "locator_hints": [
        "VirtualCity.glb meshes",
        "building models",
        "glow shader targets"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cityModelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializing, models loading, shaders not yet applied",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.poolModelLoaded === false || window.__3D_STATE__.cityModelLoaded === false"
    },
    {
      "id": "S1",
      "name": "Models Loaded",
      "description": "Both pool and city models loaded and positioned, shaders applied, default energy distribution",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.poolModelLoaded === true && window.__3D_STATE__.cityModelLoaded === true && window.__3D_STATE__.shadersActive === true && window.__3D_STATE__.causticIntensity < 70 && window.__3D_STATE__.cityGlowIntensity < 80"
    },
    {
      "id": "S2",
      "name": "Caustic Boosted",
      "description": "User increased caustic intensity, energy redistributed from other effects",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.causticIntensity >= 70 && window.__3D_STATE__.cityGlowIntensity < 80"
    },
    {
      "id": "S3",
      "name": "City Glow Dominant",
      "description": "City glow intensity increased, other effects reduced to maintain energy balance",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cityGlowIntensity >= 80 && window.__3D_STATE__.dayNightCycle > 20"
    },
    {
      "id": "S4",
      "name": "Night Mode Active",
      "description": "Day-night cycle set to night (low value), sun dim, sky dark, energy redistributed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.dayNightCycle <= 20 && window.__3D_STATE__.sunLightIntensity < 0.5 && window.__3D_STATE__.fogDensity < 90"
    },
    {
      "id": "S5",
      "name": "Heavy Fog",
      "description": "Fog density maximized, other effects minimized to conserve energy budget",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.fogDensity >= 90 && window.__3D_STATE__.cityGlowIntensity < 50"
    },
    {
      "id": "S6",
      "name": "Balanced State",
      "description": "All four effects at moderate levels, total energy budget maintained at 200, stable for 60 seconds",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.causticIntensity - 50) < 5 && Math.abs(window.__3D_STATE__.cityGlowIntensity - 50) < 5 && Math.abs(window.__3D_STATE__.dayNightCycle - 50) < 5 && Math.abs(window.__3D_STATE__.fogDensity - 50) < 5 && window.__3D_STATE__.energyBalanced === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both models loaded and positioned",
        "All four shaders active",
        "Energy budget initialized to 200"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.poolModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cityModelLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.shadersActive === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 80; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Caustic intensity increased to 80",
        "Other effects reduced proportionally",
        "Total energy budget remains 200"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.causticIntensity >= 70",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBalanced === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[1].value = 90; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "City glow intensity increased to 90",
        "Caustic and other effects reduced",
        "Energy conservation maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cityGlowIntensity >= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.causticIntensity < 80",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[2].value = 15; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Day-night cycle set to night mode (low value)",
        "Sun light intensity reduced",
        "Sky color shifted to dark",
        "Energy redistributed to other effects"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dayNightCycle <= 20",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.sunLightIntensity < 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[3].value = 95; document.querySelectorAll('input[type=\"range\"]')[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Fog density maximized to 95",
        "All other effects minimized",
        "Energy budget conserved at 200"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.fogDensity >= 90",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cityGlowIntensity < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 50; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { sliders[1].value = 50; sliders[1].dispatchEvent(new Event('input', {bubbles: true})); }, 200); setTimeout(() => { sliders[2].value = 50; sliders[2].dispatchEvent(new Event('input', {bubbles: true})); }, 400); setTimeout(() => { sliders[3].value = 50; sliders[3].dispatchEvent(new Event('input', {bubbles: true})); }, 600);",
        "wait_ms": 1500
      },
      "postconditions": [
        "All four effects balanced at 50 each",
        "Total energy budget exactly 200",
        "System stable and balanced"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.causticIntensity - 50) < 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cityGlowIntensity - 50) < 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dayNightCycle - 50) < 5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.fogDensity - 50) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.energyBalanced === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Energy budget maintained at 200",
        "All shaders continue rendering correctly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalEnergyBudget === 200",
            "tier": "L2"
          },
          {
