{
  "task_id": "P3144",
  "affordances": [
    {
      "id": "A1",
      "name": "WaterBottle",
      "type": "3d_object",
      "semantic": "Water bottle that can be picked up and tilted to pour water",
      "locator_hints": [
        "WaterBottle.glb",
        "right side of bench",
        "clickable mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "CoffeeMug",
      "type": "3d_object",
      "semantic": "Coffee mug serving as beaker to hold solution",
      "locator_hints": [
        "coffeeMug.glb",
        "center of bench",
        "container"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "PourSlider",
      "type": "dom_element",
      "semantic": "Slider control for adjusting water pour amount",
      "locator_hints": [
        "input[type='range']",
        "Pour Amount (mL)",
        "10-200 range"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A4",
      "name": "DropReagentButton",
      "type": "dom_element",
      "semantic": "Button to add reagent tablet to solution",
      "locator_hints": [
        "button",
        "Drop Reagent",
        "triggers reagent drop"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/reagent/i))"
    },
    {
      "id": "A5",
      "name": "StirButton",
      "type": "dom_element",
      "semantic": "Button to activate stirring animation",
      "locator_hints": [
        "button",
        "Stir",
        "triggers rotation"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.match(/stir/i))"
    },
    {
      "id": "A6",
      "name": "WaterCylinder",
      "type": "3d_object",
      "semantic": "Translucent blue cylinder representing water volume in mug",
      "locator_hints": [
        "CylinderGeometry",
        "inside mug",
        "blue material"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.waterVolumeInMug > 0)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "description": "Lab station loaded with water bottle and empty mug on bench",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.modelLoaded === false || (!window.__3D_STATE__.waterBottleLifted && !window.__3D_STATE__.waterVolumeInMug)"
    },
    {
      "id": "S1",
      "name": "BottleLifted",
      "description": "Water bottle picked up and tilted toward mug, slider visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.waterBottleLifted === true && (!window.__3D_STATE__.waterVolumeInMug || window.__3D_STATE__.waterVolumeInMug === 0)"
    },
    {
      "id": "S2",
      "name": "WaterPoured",
      "description": "Water volume added to mug via slider, blue cylinder visible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.waterVolumeInMug > 0 && !window.__3D_STATE__.reagentDropped"
    },
    {
      "id": "S3",
      "name": "ReagentAdded",
      "description": "Reagent tablet dropped and dissolving, solution color shifting",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reagentDropped === true && (!window.__3D_STATE__.stirRotationAngle || window.__3D_STATE__.stirRotationAngle === 0)"
    },
    {
      "id": "S4",
      "name": "SolutionStirred",
      "description": "Stirring animation completed, concentration calculated",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.stirRotationAngle > 0 && window.__3D_STATE__.concentrationPPM !== undefined && (!window.__3D_STATE__.phIndicatorValue || window.__3D_STATE__.phIndicatorValue === 0)"
    },
    {
      "id": "S5",
      "name": "ConcentrationStable",
      "description": "Final diluted solution stable with pH indicator value set",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.phIndicatorValue >= 1.0 && window.__3D_STATE__.phIndicatorValue <= 14.0 && window.__3D_STATE__.solutionHue >= 100 && window.__3D_STATE__.solutionHue <= 140"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth * 0.65, clientY: window.innerHeight * 0.5, bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Water bottle is lifted and tilted 45 degrees",
        "Pour slider becomes visible"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waterBottleLifted === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waterBottleLifted === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.waterBottleTiltAngle >= 40 && window.__3D_STATE__.waterBottleTiltAngle <= 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 150; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Water volume set to 150 mL",
        "Blue water cylinder visible in mug with appropriate height"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.waterVolumeInMug === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.waterVolumeInMug > 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.waterVolumeInMug - 150) < 5",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/reagent/i)); if(btn) btn.click();",
        "wait_ms": 2500
      },
      "postconditions": [
        "Reagent tablet dropped into mug",
        "Reagent dissolving with progress tracking",
        "Solution color shifting from blue toward green"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.reagentDropped === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.reagentDropped === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reagentDissolveProgress >= 0 && window.__3D_STATE__.reagentDissolveProgress <= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.match(/stir/i)); if(btn) btn.click();",
        "wait_ms": 3000
      },
      "postconditions": [
        "Stirring animation activated",
        "Solution rotates with cumulative angle tracking",
        "Concentration value calculated"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stirRotationAngle === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stirRotationAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.concentrationPPM !== undefined && isFinite(window.__3D_STATE__.concentrationPPM)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Stirring animation completed",
        "pH indicator value set and stable",
        "Solution hue stabilized in green range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.phIndicatorValue === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.phIndicatorValue >= 1.0 && window.__3D_STATE__.phIndicatorValue <= 14.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.solutionHue >= 100 && window.__3D_STATE__.solutionHue <= 140",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "All state values remain stable for 60 seconds",
        "No unexpected changes in concentration or pH",
        "Scene maintains final configuration"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.stabilityTimer === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.stabilityTimer >= 59000",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.stabilityTimer / 1000))",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
