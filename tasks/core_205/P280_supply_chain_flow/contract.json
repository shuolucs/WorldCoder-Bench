        "window.__3D_STATE__.paused === false",
        "window.__3D_STATE__.simulationRunning === true"
      ],
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.paused === false && window.__3D_STATE__.simulationRunning === true)"
    },
    {
      "id": "S5",
