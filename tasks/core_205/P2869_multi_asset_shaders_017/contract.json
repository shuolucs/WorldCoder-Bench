{
  "task_id": "P2869",
  "affordances": [
    {
      "id": "A1",
      "name": "Apply Dissolve Button",
      "type": "dom_element",
      "semantic": "Button that applies dissolve shader to WaterBottle",
      "locator_hints": [
        "button",
        "text contains 'Apply Dissolve'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Apply Dissolve'))"
    },
    {
      "id": "A2",
      "name": "Dissolve Amount Slider",
      "type": "dom_element",
      "semantic": "Slider controlling dissolve threshold from 0.0 to 1.0",
      "locator_hints": [
        "input[type='range']",
        "label contains 'Dissolve Amount'"
      ],
      "check": "!!document.querySelector('input[type=\"range\"]')"
    },
    {
      "id": "A3",
      "name": "Refraction Mode Button",
      "type": "dom_element",
      "semantic": "Button that applies refraction shader to pedestal",
      "locator_hints": [
        "button",
        "text contains 'Refraction Mode'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Refraction'))"
    },
    {
      "id": "A4",
      "name": "WaterBottle Model",
      "type": "3d_object",
      "semantic": "Main bottle object receiving dissolve shader effects",
      "locator_hints": [
        "GLTF model",
        "WaterBottle.glb"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "InterpolationTest Pedestal",
      "type": "3d_object",
      "semantic": "Grid pedestal receiving refraction shader effects",
      "locator_hints": [
        "GLTF model",
        "InterpolationTest.glb"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene loaded with both models, default materials, no shaders applied",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.modelLoaded === true && window.__3D_STATE__.isDissolveApplied !== true && window.__3D_STATE__.isRefractionApplied !== true)"
    },
    {
      "id": "S1",
      "name": "Dissolve Shader Applied",
      "description": "WaterBottle has dissolve shader active with threshold at 0.0",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDissolveApplied === true && Math.abs(window.__3D_STATE__.dissolveThreshold - 0.0) < 0.1 && window.__3D_STATE__.isRefractionApplied !== true"
    },
    {
      "id": "S2",
      "name": "Partial Dissolve",
      "description": "Dissolve threshold adjusted to mid-range showing partial bottle visibility",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDissolveApplied === true && window.__3D_STATE__.dissolveThreshold > 0.3 && window.__3D_STATE__.dissolveThreshold < 0.8 && window.__3D_STATE__.isRefractionApplied !== true"
    },
    {
      "id": "S3",
      "name": "Full Dissolve",
      "description": "Dissolve threshold at 1.0 making bottle nearly invisible",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDissolveApplied === true && window.__3D_STATE__.dissolveThreshold >= 0.8 && window.__3D_STATE__.isRefractionApplied !== true"
    },
    {
      "id": "S4",
      "name": "Refraction Active",
      "description": "Pedestal has refraction shader applied with chromatic aberration",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isRefractionApplied === true && window.__3D_STATE__.dissolveThreshold >= 0.8"
    },
    {
      "id": "S5",
      "name": "Dual Shader System",
      "description": "Both dissolve and refraction shaders active simultaneously",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isDissolveApplied === true && window.__3D_STATE__.isRefractionApplied === true && window.__3D_STATE__.activeShaderCount === 2 && window.__3D_STATE__.dissolveThreshold < 0.8"
    },
    {
      "id": "S6",
      "name": "Stable Operation",
      "description": "All shaders running stably with animation time progressing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.activeShaderCount === 2 && window.__3D_STATE__.animationTime > 3.0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('button').click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Dissolve shader applied to WaterBottle",
        "isDissolveApplied flag set to true",
        "dissolveThreshold initialized to 0.0"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDissolveApplied === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.dissolveThreshold === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dissolveThreshold >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dissolveThreshold - 0.0) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.dissolveThreshold)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeShaderCount === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 0.5; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Dissolve threshold set to approximately 0.5",
        "Bottle partially visible with dissolve effect"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dissolveThreshold === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dissolveThreshold > 0.3",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dissolveThreshold - 0.5) < 0.3",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.animationTime)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.cameraDistance) < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 1.0; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Dissolve threshold at maximum 1.0",
        "Bottle nearly fully dissolved"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.dissolveThreshold === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.dissolveThreshold >= 0.8",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.dissolveThreshold - 1.0) < 0.15",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.dissolveThreshold)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationTime) < 300",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const buttons = Array.from(document.querySelectorAll('button')); const refractionBtn = buttons.find(b => b.textContent.includes('Refraction')); if(refractionBtn) refractionBtn.click();",
        "wait_ms": 1000
      },
      "postconditions": [
        "Refraction shader applied to pedestal",
        "isRefractionApplied flag set to true",
        "Chromatic aberration visible on pedestal"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isRefractionApplied === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.chromaticAberration === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticAberration >= 0",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.chromaticAberration - 0.003) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.chromaticAberration)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeShaderCount === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if(slider) { slider.value = 0.3; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 800
      },
      "postconditions": [
        "Both shaders active simultaneously",
        "activeShaderCount equals 2",
        "Dissolve threshold adjusted back to visible range"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.activeShaderCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.activeShaderCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeShaderCount === 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Animation time progressing",
        "Both shaders animating smoothly",
        "No errors in shader execution"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.animationTime === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.animationTime)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationTime - 3.0) < 2.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.pedestalRotationSpeed) < 10",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "All state values remain valid",
        "Animation continues without errors"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isDissolveApplied === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isRefractionApplied === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.animationTime > 60",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.animationTime - 60.0) < 10.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.dissolveThreshold)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.glowIntensity) < 5.0",
            "tier": "L2"
          }
        ]
      }
    }
  ]
}
