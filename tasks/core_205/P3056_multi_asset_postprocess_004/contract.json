{
  "task_id": "P3056",
  "affordances": [
    {
      "id": "A1",
      "name": "LeftLensDropZone",
      "type": "dom_element",
      "semantic": "Drop zone for adding post-processing effects to left lens chain",
      "locator_hints": [
        "div",
        "data-lens='left'",
        "drop-zone"
      ],
      "check": "!!document.querySelector(\"div[data-lens='left']\")"
    },
    {
      "id": "A2",
      "name": "RightLensDropZone",
      "type": "dom_element",
      "semantic": "Drop zone for adding post-processing effects to right lens chain",
      "locator_hints": [
        "div",
        "data-lens='right'",
        "drop-zone"
      ],
      "check": "!!document.querySelector(\"div[data-lens='right']\")"
    },
    {
      "id": "A3",
      "name": "BloomEffectCard",
      "type": "dom_element",
      "semantic": "Draggable card for Bloom post-processing effect",
      "locator_hints": [
        "div",
        "draggable",
        "data-effect='bloom'"
      ],
      "check": "!!document.querySelector(\"div[draggable][data-effect='bloom']\")"
    },
    {
      "id": "A4",
      "name": "SepiaEffectCard",
      "type": "dom_element",
      "semantic": "Draggable card for Sepia post-processing effect",
      "locator_hints": [
        "div",
        "draggable",
        "data-effect='sepia'"
      ],
      "check": "!!document.querySelector(\"div[draggable][data-effect='sepia']\")"
    },
    {
      "id": "A5",
      "name": "LuminanceMeter",
      "type": "dom_element",
      "semantic": "Visual meter displaying current luminance units (0-16 range, target 8)",
      "locator_hints": [
        "div",
        "meter",
        "luminance"
      ],
      "check": "!!document.querySelector(\"div[class*='meter'][class*='luminance'], div.meter.luminance\")"
    },
    {
      "id": "A6",
      "name": "SunglassesModel",
      "type": "3d_object",
      "semantic": "SunglassesKhronos.glb model with left and right lens meshes",
      "locator_hints": [
        "glb",
        "position (0,1.5,0)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A7",
      "name": "MosquitoSpecimen",
      "type": "3d_object",
      "semantic": "MosquitoInAmber.glb specimen viewed through lenses",
      "locator_hints": [
        "glb",
        "position (0,0,-3)"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "InitialLoad",
      "description": "Scene loaded with both models, no post-processing effects applied, luminance at 0",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.totalLuminanceUnits === 0 && window.__3D_STATE__.leftLensPassCount === 0 && window.__3D_STATE__.rightLensPassCount === 0)"
    },
    {
      "id": "S1",
      "name": "FirstEffectAdded",
      "description": "User has added first effect to one lens, luminance units increased",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalLuminanceUnits > 0 && (window.__3D_STATE__.leftLensPassCount > 0 || window.__3D_STATE__.rightLensPassCount > 0) && (window.__3D_STATE__.leftLensPassCount === 0 || window.__3D_STATE__.rightLensPassCount === 0)"
    },
    {
      "id": "S2",
      "name": "BothLensesActive",
      "description": "Both left and right lenses have at least one post-processing effect",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.leftLensPassCount > 0 && window.__3D_STATE__.rightLensPassCount > 0"
    },
    {
      "id": "S3",
      "name": "LuminanceBalanced",
      "description": "Total luminance equals exactly 8 units across both lens chains",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalLuminanceUnits === 8 && window.__3D_STATE__.luminanceBalanced === true"
    },
    {
      "id": "S4",
      "name": "AutoReductionOccurred",
      "description": "System auto-reduced intensity to maintain luminance conservation law",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.autoReductionTriggered === true"
    },
    {
      "id": "S5",
      "name": "ComplexChainBuilt",
      "description": "Multiple effects active with reordering operations performed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reorderOperationCount >= 1 && (window.__3D_STATE__.leftLensPassCount + window.__3D_STATE__.rightLensPassCount >= 2)"
    },
    {
      "id": "S6",
      "name": "StableBalanced",
      "description": "Luminance balanced at 8 units and stable for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.totalLuminanceUnits === 8 && window.__3D_STATE__.luminanceBalanced === true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Scene fully loaded with both 3D models visible",
        "State tracking initialized with zero values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.leftLensPassCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.luminanceBalanced === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('[data-effect=\"bloom\"]').dispatchEvent(new MouseEvent('dragstart', {bubbles: true})); document.querySelector('[data-lens=\"left\"]').dispatchEvent(new MouseEvent('drop', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Bloom effect added to left lens",
        "Left lens pass count increased",
        "Luminance units increased from baseline"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.leftLensPassCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.bloomIntensityLeft >= 1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('[data-effect=\"sepia\"]').dispatchEvent(new MouseEvent('dragstart', {bubbles: true})); document.querySelector('[data-lens=\"right\"]').dispatchEvent(new MouseEvent('drop', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Sepia effect added to right lens",
        "Both lenses now have active effects",
        "Right lens pass count increased"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.rightLensPassCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.sepiaIntensityLeft >= 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.leftLensPassCount + window.__3D_STATE__.rightLensPassCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const cards = document.querySelectorAll('[draggable]'); for(let i=0; i<6; i++) { cards[i % cards.length].click(); }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Multiple intensity cycling operations performed",
        "Luminance conservation law enforced",
        "Auto-reduction triggered to maintain balance"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits <= 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.autoReductionTriggered !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalLuminanceUnits - 8) <= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "window.__3D_STATE__.reorderOperationCount = (window.__3D_STATE__.reorderOperationCount || 0) + 1;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Reorder operation count incremented",
        "Complex effect chain established"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reorderOperationCount >= 1",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.reorderOperationCount)",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.leftLensPassCount + window.__3D_STATE__.rightLensPassCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "while(window.__3D_STATE__.totalLuminanceUnits !== 8 && window.__3D_STATE__.totalLuminanceUnits < 16) { const cards = document.querySelectorAll('[draggable]'); cards[0].click(); if(window.__3D_STATE__.totalLuminanceUnits === 8) break; }",
        "wait_ms": 2000
      },
      "postconditions": [
        "Luminance precisely balanced at 8 units",
        "Conservation law satisfied"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.luminanceBalanced === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.totalLuminanceUnits)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S3",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "console.log('Luminance stable at target:', window.__3D_STATE__.totalLuminanceUnits);",
        "wait_ms": 2000
      },
      "postconditions": [
        "System confirmed stable with balanced luminance",
        "All state fields valid and consistent"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.luminanceBalanced === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.leftLensPassCount >= 0 && window.__3D_STATE__.rightLensPassCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "System remains stable for 60 seconds",
        "Luminance conservation maintained",
        "No unexpected state changes"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalLuminanceUnits === 8",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.luminanceBalanced === true",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.leftLensPassCount) && isFinite(window.__3D_STATE__.rightLensPassCount)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
