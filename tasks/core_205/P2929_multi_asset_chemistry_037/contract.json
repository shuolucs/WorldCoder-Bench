{
  "task_id": "P2929",
  "affordances": [
    {
      "id": "A1",
      "name": "Beam Energy Slider",
      "type": "dom_element",
      "semantic": "Slider control to adjust ion beam energy from 1 to 10 keV",
      "locator_hints": [
        "input[type='range']",
        "slider with 'Beam Energy' label",
        "min='1' max='10'"
      ],
      "check": "!!document.querySelector('input[type=\"range\"][min=\"1\"][max=\"10\"]')"
    },
    {
      "id": "A2",
      "name": "Focus Aperture Slider",
      "type": "dom_element",
      "semantic": "Slider control to adjust focus aperture diameter from 0.1 to 2.0 mm",
      "locator_hints": [
        "input[type='range']",
        "slider with 'Focus Aperture' label",
        "min='0.1' max='2.0'"
      ],
      "check": "!!document.querySelector('input[type=\"range\"][min=\"0.1\"][max=\"2\"]')"
    },
    {
      "id": "A3",
      "name": "Scan Angle Slider",
      "type": "dom_element",
      "semantic": "Slider control to rotate ion drive from -45 to 45 degrees",
      "locator_hints": [
        "input[type='range']",
        "slider with 'Scan Angle' label",
        "min='-45' max='45'"
      ],
      "check": "!!document.querySelector('input[type=\"range\"][min=\"-45\"][max=\"45\"]')"
    },
    {
      "id": "A4",
      "name": "Wavelength Filter Dropdown",
      "type": "dom_element",
      "semantic": "Dropdown to select spectral filter: UV, Visible, or IR",
      "locator_hints": [
        "select element",
        "dropdown with 'Wavelength Filter' label",
        "options: UV, Visible, IR"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A5",
      "name": "Start Scan Button",
      "type": "dom_element",
      "semantic": "Button to initiate ion beam scan with validation",
      "locator_hints": [
        "button",
        "text contains 'Start Scan'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Start'))"
    },
    {
      "id": "A6",
      "name": "Reset Button",
      "type": "dom_element",
      "semantic": "Button to reset all parameters to default values",
      "locator_hints": [
        "button",
        "text contains 'Reset'"
      ],
      "check": "Array.from(document.querySelectorAll('button')).some(b => b.textContent.includes('Reset'))"
    },
    {
      "id": "A7",
      "name": "Abalone Shell Model",
      "type": "3d_object",
      "semantic": "IridescenceAbalone.glb specimen at center on rotating platform",
      "locator_hints": [
        "GLTF model at origin",
        "iridescent shell mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A8",
      "name": "Ion Drive Model",
      "type": "3d_object",
      "semantic": "PrimaryIonDrive.glb emitter positioned to left, rotates with scan angle",
      "locator_hints": [
        "GLTF model offset left",
        "ion beam emitter"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Idle",
      "description": "Scene loaded with default parameters, no scans performed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.scanCount === 0 && Math.abs(window.__3D_STATE__.beamEnergy - 1) < 0.5"
    },
    {
      "id": "S1",
      "name": "Parameters Adjusted",
      "description": "User has modified beam energy, aperture, or scan angle from defaults",
      "condition": "window.__3D_STATE__ && (Math.abs(window.__3D_STATE__.beamEnergy - 1) >= 0.5 || Math.abs(window.__3D_STATE__.focusAperture - 1.0) >= 0.2 || Math.abs(window.__3D_STATE__.scanAngle) >= 5) && window.__3D_STATE__.scanCount === 0"
    },
    {
      "id": "S2",
      "name": "Invalid Scan Attempted",
      "description": "Start Scan clicked but validation failed (energy ≤3 or aperture ≥1.5)",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lastScanValid === false && window.__3D_STATE__.isScanning === false"
    },
    {
      "id": "S3",
      "name": "Active Scanning",
      "description": "Valid scan in progress with animations and point light active",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isScanning === true"
    },
    {
      "id": "S4",
      "name": "Scan Completed",
      "description": "Scan finished, spectral peaks detected, ready for next scan",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.scanCount === 1 && window.__3D_STATE__.isScanning === false && window.__3D_STATE__.detectedPeaks > 0"
    },
    {
      "id": "S5",
      "name": "Multiple Scans Completed",
      "description": "At least 2 successful scans performed with different parameters",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.scanCount >= 2"
    },
    {
      "id": "S6",
      "name": "Reset to Defaults",
      "description": "All parameters returned to initial values via Reset button",
      "condition": "window.__3D_STATE__ && Math.abs(window.__3D_STATE__.beamEnergy - 1) < 0.5 && Math.abs(window.__3D_STATE__.focusAperture - 1.0) < 0.2 && Math.abs(window.__3D_STATE__.scanAngle) < 5 && window.__3D_STATE__.scanCount >= 2"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[min=\"1\"][max=\"10\"]').value = 5; document.querySelector('input[min=\"1\"][max=\"10\"]').dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Beam energy slider moved to 5 keV",
        "State reflects updated beam energy value"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.beamEnergy >= 4 && window.__3D_STATE__.beamEnergy <= 6",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[min=\"1\"][max=\"10\"]').value = 2; document.querySelector('input[min=\"1\"][max=\"10\"]').dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Start')); if(btn) btn.click(); }, 500);",
        "wait_ms": 2000
      },
      "postconditions": [
        "Beam energy set below 3 keV threshold",
        "Start Scan clicked but validation failed",
        "lastScanValid is false"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.beamEnergy < 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastScanValid === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isScanning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[min=\"1\"][max=\"10\"]').value = 7; document.querySelector('input[min=\"1\"][max=\"10\"]').dispatchEvent(new Event('input', {bubbles: true})); document.querySelector('input[min=\"0.1\"][max=\"2\"]').value = 1.2; document.querySelector('input[min=\"0.1\"][max=\"2\"]').dispatchEvent(new Event('input', {bubbles: true})); setTimeout(() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Start')); if(btn) btn.click(); }, 500);",
        "wait_ms": 3000
      },
      "postconditions": [
        "Valid scan parameters set (energy > 3, aperture < 1.5)",
        "Scan animation started",
        "Point light intensity increased",
        "isScanning is true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isScanning === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.beamEnergy > 3",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.focusAperture < 1.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.pointLightIntensity > 0",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 5000
      },
      "postconditions": [
        "Scan animation completed",
        "Spectral peaks detected and counted",
        "isScanning returned to false",
        "scanCount incremented"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.isScanning === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.scanProgress === 100",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.detectedPeaks > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.scanCount >= 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[min=\"-45\"][max=\"45\"]').value = 30; document.querySelector('input[min=\"-45\"][max=\"45\"]').dispatchEvent(new Event('input', {bubbles: true})); const sel = document.querySelector('select'); if(sel) { sel.value = sel.options[2].value; sel.dispatchEvent(new Event('change', {bubbles: true})); } setTimeout(() => { const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Start')); if(btn) btn.click(); }, 500);",
        "wait_ms": 6000
      },
      "postconditions": [
        "Scan angle changed to 30 degrees",
        "Wavelength filter changed to IR",
        "Second scan completed successfully",
        "scanCount is at least 2"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.scanCount >= 2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanAngle - 30) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.wavelengthFilter === 'IR'",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lastScanValid === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const btn = Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Reset')); if(btn) btn.click();",
        "wait_ms": 1500
      },
      "postconditions": [
        "All parameters reset to defaults",
        "beamEnergy back to 1 keV",
        "focusAperture back to 1.0 mm",
        "scanAngle back to 0 degrees"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "Math.abs(window.__3D_STATE__.beamEnergy - 1) < 0.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.focusAperture - 1.0) < 0.2",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.scanAngle) < 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isScanning === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable in reset state for 60 seconds",
        "No unexpected state changes",
        "All numeric values remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.beamEnergy === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.shellRotation)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.scanProgress >= 0 && window.__3D_STATE__.scanProgress <= 100",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.scanCount)",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
