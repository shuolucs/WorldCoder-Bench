{
  "task_id": "P351_kitchen_cabinet_planner_with_particle_ef",
  "affordances": [
    {
      "id": "A1",
      "name": "AddBaseButton",
      "type": "dom_element",
      "semantic": "Button to select base cabinet type for placement",
      "locator_hints": [
        "text='Add Base Cabinet'",
        "button:contains('Base')"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Base'))"
    },
    {
      "id": "A2",
      "name": "AddWallButton",
      "type": "dom_element",
      "semantic": "Button to select wall cabinet type for placement",
      "locator_hints": [
        "text='Add Wall Cabinet'",
        "button:contains('Wall')"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Wall'))"
    },
    {
      "id": "A3",
      "name": "AddTallButton",
      "type": "dom_element",
      "semantic": "Button to select tall cabinet type for placement",
      "locator_hints": [
        "text='Add Tall Cabinet'",
        "button:contains('Tall')"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Tall'))"
    },
    {
      "id": "A4",
      "name": "RemoveLastButton",
      "type": "dom_element",
      "semantic": "Button to remove the last placed cabinet",
      "locator_hints": [
        "text='Remove Last'",
        "button:contains('Remove')"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Remove'))"
    },
    {
      "id": "A5",
      "name": "ClearAllButton",
      "type": "dom_element",
      "semantic": "Button to clear all cabinets",
      "locator_hints": [
        "text='Clear All'",
        "button:contains('Clear')"
      ],
      "check": "!!Array.from(document.querySelectorAll('button')).find(b => b.textContent.includes('Clear'))"
    },
    {
      "id": "A6",
      "name": "GhostPreview",
      "type": "3d_object",
      "semantic": "Semi-transparent preview of cabinet to be placed",
      "locator_hints": [
        "transparent mesh",
        "ghost cabinet"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.ghostVisible)"
    },
    {
      "id": "A7",
      "name": "PlacedCabinets",
      "type": "3d_object",
      "semantic": "Placed cabinet meshes on the grid",
      "locator_hints": [
        "cabinet groups in scene"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.cabinetCount > 0)"
    },
    {
      "id": "A8",
      "name": "CabinetCountDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing cabinet count",
      "locator_hints": [
        "text contains 'Cabinets:'"
      ],
      "check": "!!Array.from(document.querySelectorAll('*')).find(el => el.textContent.includes('Cabinets:'))"
    },
    {
      "id": "A9",
      "name": "CostDisplay",
      "type": "dom_element",
      "semantic": "HUD text showing total cost",
      "locator_hints": [
        "text contains 'Total Cost:'"
      ],
      "check": "!!Array.from(document.querySelectorAll('*')).find(el => el.textContent.includes('Total Cost:'))"
    },
    {
      "id": "A10",
      "name": "ParticleSystem",
      "type": "3d_object",
      "semantic": "Gold sparkle particles emitted on cabinet placement",
      "locator_hints": [
        "THREE.Points or sprites with gold color"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.particlesEmitted > 0)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial_Empty",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.totalCost === 0",
        "window.__3D_STATE__.selectedType === null",
        "window.__3D_STATE__.ghostVisible === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cabinetCount === 0 && window.__3D_STATE__.totalCost === 0 && window.__3D_STATE__.selectedType === null && window.__3D_STATE__.ghostVisible === false"
    },
    {
      "id": "S1",
      "name": "BaseSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'base'",
        "window.__3D_STATE__.ghostVisible === true",
        "window.__3D_STATE__.cabinetCount === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedType === 'base' && window.__3D_STATE__.ghostVisible === true && window.__3D_STATE__.cabinetCount === 0"
    },
    {
      "id": "S2",
      "name": "OneCabinetPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 1",
        "window.__3D_STATE__.totalCost === 150",
        "window.__3D_STATE__.lastPlacedType === 'base'",
        "window.__3D_STATE__.particlesEmitted >= 30"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cabinetCount === 1 && window.__3D_STATE__.totalCost === 150 && window.__3D_STATE__.lastPlacedType === 'base' && window.__3D_STATE__.particlesEmitted >= 30"
    },
    {
      "id": "S3",
      "name": "WallSelected",
      "conditions": [
        "window.__3D_STATE__.selectedType === 'wall'",
        "window.__3D_STATE__.ghostVisible === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.selectedType === 'wall' && window.__3D_STATE__.ghostVisible === true"
    },
    {
      "id": "S4",
      "name": "TwoCabinetsPlaced",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 2",
        "window.__3D_STATE__.totalCost === 270",
        "window.__3D_STATE__.particlesEmitted >= 60"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cabinetCount === 2 && window.__3D_STATE__.totalCost === 270 && window.__3D_STATE__.particlesEmitted >= 60"
    },
    {
      "id": "S5",
      "name": "DoorOpened",
      "conditions": [
        "window.__3D_STATE__.doorOpen === true",
        "window.__3D_STATE__.cabinetCount === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.doorOpen === true && window.__3D_STATE__.cabinetCount === 2"
    },
    {
      "id": "S6",
      "name": "DoorClosed",
      "conditions": [
        "window.__3D_STATE__.doorOpen === false",
        "window.__3D_STATE__.cabinetCount === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.doorOpen === false && window.__3D_STATE__.cabinetCount === 2"
    },
    {
      "id": "S7",
      "name": "OneRemoved",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 1",
        "window.__3D_STATE__.totalCost === 150"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cabinetCount === 1 && window.__3D_STATE__.totalCost === 150"
    },
    {
      "id": "S8",
      "name": "AllCleared",
      "conditions": [
        "window.__3D_STATE__.cabinetCount === 0",
        "window.__3D_STATE__.totalCost === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.cabinetCount === 0 && window.__3D_STATE__.totalCost === 0"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "click_dom",
        "selector": "button",
        "text": "Add Base Cabinet"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.cabinetCount !== before.cabinetCount || JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.cabinetCount === 'number' && !isNaN(window.__3D_STATE__.cabinetCount)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalCost === 'number' && !isNaN(window.__3D_STATE__.totalCost)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.particlesEmitted)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.cabinetCount >= 0",
            "tier": "L1"
          },
