{
  "task_id": "P2847",
  "affordances": [
    {
      "id": "A1",
      "name": "Dungeon Environment",
      "type": "3d_object",
      "semantic": "The dungeon_warkarma.glb model serving as the chamber environment",
      "locator_hints": [
        "dungeon_warkarma.glb",
        "scene background",
        "environment mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.dungeonsLoaded)"
    },
    {
      "id": "A2",
      "name": "Energy Conduits",
      "type": "3d_object",
      "semantic": "Five ShaderBall.glb instances positioned as energy conduits in the dungeon",
      "locator_hints": [
        "ShaderBall.glb",
        "conduit spheres",
        "energy nodes"
      ],
      "check": "!!(window.__3D_STATE__ && Array.isArray(window.__3D_STATE__.conduitIntensities) && window.__3D_STATE__.conduitIntensities.length === 5)"
    },
    {
      "id": "A3",
      "name": "Conduit Control Panel",
      "type": "dom_element",
      "semantic": "Floating HTML panel with intensity slider, frequency stepper, and polarity toggle",
      "locator_hints": [
        "control panel",
        "intensity slider",
        "frequency stepper",
        "polarity toggle"
      ],
      "check": "!!(document.querySelector('input[type=\"range\"]') && document.querySelector('input[type=\"number\"]') && document.querySelector('input[type=\"checkbox\"]'))"
    },
    {
      "id": "A4",
      "name": "Energy HUD",
      "type": "dom_element",
      "semantic": "Display showing total raw energy, effective energy, resonance and interference counts",
      "locator_hints": [
        "HUD",
        "energy display",
        "statistics panel"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A5",
      "name": "Conduit Point Lights",
      "type": "3d_object",
      "semantic": "Five point lights colored by conduit state, one per conduit",
      "locator_hints": [
        "point lights",
        "conduit lights",
        "colored lighting"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.lightsInitialized)"
    },
    {
      "id": "A6",
      "name": "Raycasting Interaction",
      "type": "interaction",
      "semantic": "Click detection on conduits to open control panel",
      "locator_hints": [
        "mouse click",
        "raycaster",
        "conduit selection"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading, assets not yet ready, no conduits placed",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.dungeonsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Assets Loaded",
      "description": "Dungeon and ShaderBalls loaded, conduits placed with default equal energy distribution (100 each)",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.dungeonsLoaded === true && window.__3D_STATE__.totalRawEnergy === 500 && window.__3D_STATE__.selectedConduitIndex === -1)"
    },
    {
      "id": "S2",
      "name": "Conduit Selected",
      "description": "User has clicked a conduit, control panel is visible, selectedConduitIndex >= 0",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.selectedConduitIndex >= 0 && window.__3D_STATE__.selectedConduitIndex <= 4)"
    },
    {
      "id": "S3",
      "name": "Energy Redistributed",
      "description": "User adjusted intensity, energy conservation applied, totalRawEnergy still equals 500",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.totalRawEnergy === 500 && window.__3D_STATE__.conduitIntensities && window.__3D_STATE__.conduitIntensities.some(v => v !== 100))"
    },
    {
      "id": "S4",
      "name": "Resonance Active",
      "description": "At least one pair of adjacent conduits has matching frequency, resonancePairCount > 0",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.resonancePairCount > 0)"
    },
    {
      "id": "S5",
      "name": "Interference Active",
      "description": "At least one pair of adjacent conduits has mismatched polarity, interferencePairCount > 0",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.interferencePairCount > 0)"
    },
    {
      "id": "S6",
      "name": "Stable Simulation",
      "description": "All systems running, energy conserved, effects calculated, simulation stable for extended period",
      "condition": "!!(window.__3D_STATE__ && window.__3D_STATE__.dungeonsLoaded === true && window.__3D_STATE__.totalRawEnergy === 500 && window.__3D_STATE__.selectedConduitIndex === -1 && typeof window.__3D_STATE__.totalEffectiveEnergy === 'number')"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 4000
      },
      "postconditions": [
        "Both dungeon and ShaderBall assets are loaded",
        "Five conduits are placed in the scene",
        "Total raw energy equals 500",
        "All conduit intensities are initialized"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.dungeonsLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRawEnergy === 500",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.conduitIntensities) && window.__3D_STATE__.conduitIntensities.length === 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lightsInitialized === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); const clickX = rect.left + rect.width * 0.5; const clickY = rect.top + rect.height * 0.4; canvas.dispatchEvent(new MouseEvent('click', {clientX: clickX, clientY: clickY, bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "A conduit is selected via raycasting",
        "Control panel becomes visible",
        "selectedConduitIndex is set to a valid index (0-4)"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.selectedConduitIndex === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.selectedConduitIndex >= 0 && window.__3D_STATE__.selectedConduitIndex <= 4",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const slider = document.querySelector('input[type=\"range\"]'); if (slider) { slider.value = 150; slider.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Selected conduit intensity increased to 150",
        "Other conduit intensities decreased proportionally",
        "Total raw energy still equals 500",
        "Energy conservation law maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalRawEnergy === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conduitIntensities.every(v => typeof v === 'number' && v >= 0 && v <= 100)",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.conduitIntensities.reduce((a,b) => a+b, 0) - 500) < 0.01",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const stepper = document.querySelector('input[type=\"number\"]'); if (stepper && window.__3D_STATE__.selectedConduitIndex >= 0) { const targetFreq = window.__3D_STATE__.conduitFrequencies[(window.__3D_STATE__.selectedConduitIndex + 1) % 5]; stepper.value = targetFreq; stepper.dispatchEvent(new Event('input', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Selected conduit frequency changed to match an adjacent conduit",
        "Resonance detected between matching frequency neighbors",
        "resonancePairCount increased to at least 1",
        "Effective energy reflects resonance doubling effect"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.resonancePairCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.resonancePairCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.totalEffectiveEnergy > window.__3D_STATE__.totalRawEnergy",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.activeResonanceCount === 'number' && window.__3D_STATE__.activeResonanceCount >= 0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const toggle = document.querySelector('input[type=\"checkbox\"]'); if (toggle) { toggle.checked = !toggle.checked; toggle.dispatchEvent(new Event('change', {bubbles: true})); }",
        "wait_ms": 1500
      },
      "postconditions": [
        "Selected conduit polarity flipped",
        "Polarity mismatch created with at least one neighbor",
        "interferencePairCount increased to at least 1",
        "Effective energy reduced due to interference halving effect"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.interferencePairCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.interferencePairCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.conduitPolarities.every(p => p === 1 || p === -1)",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEffectiveEnergy === 'number' && isFinite(window.__3D_STATE__.totalEffectiveEnergy)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const canvas = document.querySelector('canvas'); const rect = canvas.getBoundingClientRect(); canvas.dispatchEvent(new MouseEvent('click', {clientX: rect.left + 10, clientY: rect.top + 10, bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Control panel closed by clicking away from conduits",
        "selectedConduitIndex reset to -1",
        "All energy calculations remain stable",
        "Scene continues to render with all effects active"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.selectedConduitIndex === -1",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalRawEnergy === 500",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number' && window.__3D_STATE__.cameraDistance > 0",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.resonancePairCount) && Number.isInteger(window.__3D_STATE__.interferencePairCount)",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S6",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Simulation remains stable for 60 seconds",
        "Energy conservation maintained throughout",
        "All state values remain valid and within expected ranges",
        "No crashes or errors occur during extended operation"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.totalRawEnergy === 500",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.dungeonsLoaded === true && window.__3D_STATE__.lightsInitialized === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.conduitIntensities.length === 5 && window.__3D_STATE__.conduitFrequencies.length === 5 && window.__3D_STATE__.conduitPolarities.length === 5",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalEffectiveEnergy === 'number' && isFinite(window.__3D_STATE__.totalEffectiveEnergy) && window.__3D_STATE__.totalEffectiveEnergy > 0",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
