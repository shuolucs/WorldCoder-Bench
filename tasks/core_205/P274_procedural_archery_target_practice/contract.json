  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.score === 0",
        "window.__3D_STATE__.arrowsLeft === 10",
        "window.__3D_STATE__.arrowsFired === 0",
        "window.__3D_STATE__.isCharging === false",
        "window.__3D_STATE__.isFlying === false",
        "window.__3D_STATE__.roundOver === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.score === 0 && window.__3D_STATE__.arrowsFired === 0 && window.__3D_STATE__.isCharging === false && window.__3D_STATE__.isFlying === false"
    },
    {
      "id": "S1",
      "name": "Charging",
      "conditions": [
        "window.__3D_STATE__.isCharging === true",
        "window.__3D_STATE__.power > 0",
        "window.__3D_STATE__.isFlying === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isCharging === true && window.__3D_STATE__.isFlying === false"
    },
    {
      "id": "S2",
      "name": "ArrowInFlight",
      "conditions": [
        "window.__3D_STATE__.isFlying === true",
        "window.__3D_STATE__.isCharging === false",
        "window.__3D_STATE__.arrowPosZ !== null"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isFlying === true && window.__3D_STATE__.isCharging === false"
    },
    {
      "id": "S3",
      "name": "ArrowLanded",
      "conditions": [
        "window.__3D_STATE__.isFlying === false",
        "window.__3D_STATE__.arrowsFired >= 1"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isFlying === false && window.__3D_STATE__.arrowsFired >= 1 && window.__3D_STATE__.arrowsFired < 3"
    },
    {
      "id": "S4",
      "name": "MultipleArrowsFired",
      "conditions": [
        "window.__3D_STATE__.arrowsFired >= 3",
        "window.__3D_STATE__.arrowsLeft <= 7"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowsFired >= 3 && window.__3D_STATE__.arrowsLeft > 0"
    },
    {
      "id": "S5",
      "name": "RoundOver",
      "conditions": [
        "window.__3D_STATE__.roundOver === true",
        "window.__3D_STATE__.arrowsLeft === 0",
        "window.__3D_STATE__.isFlying === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowsLeft === 0 && window.__3D_STATE__.isFlying === false"
    },
    {
      "id": "S6",
      "name": "NewRoundStarted",
      "conditions": [
        "window.__3D_STATE__.arrowsLeft === 10",
        "window.__3D_STATE__.arrowsFired === 0",
        "window.__3D_STATE__.score === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.arrowsLeft === 10 && window.__3D_STATE__.arrowsFired === 0 && window.__3D_STATE__.score === 0"
    }
  ],
