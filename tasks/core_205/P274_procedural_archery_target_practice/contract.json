    {
      "id": "A1",
      "name": "ArcheryTarget",
      "type": "3d_object",
      "semantic": "Concentric ring target at z=-15 with 5 scoring zones",
      "locator_hints": [
        "position.z === -15",
        "5 concentric cylinders"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "BoxAnimatedModel",
      "type": "3d_object",
      "semantic": "Animated GLB bonus target at (3, 0, -14)",
      "locator_hints": [
        "BoxAnimated.glb",
        "position.x === 3"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A3",
      "name": "Arrow",
      "type": "3d_object",
      "semantic": "Projectile arrow with parabolic trajectory",
      "locator_hints": [
        "CylinderGeometry brown"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.isFlying)"
    },
    {
      "id": "A4",
      "name": "Crosshair",
      "type": "dom_element",
      "semantic": "Aiming crosshair overlay in screen center",
      "locator_hints": [
        "center of viewport"
      ],
      "check": "true"
    },
    {
      "id": "A5",
      "name": "ScoreHUD",
      "type": "dom_element",
      "semantic": "Score display top-left",
      "locator_hints": [
        "#hud-score"
      ],
      "check": "!!document.getElementById('hud-score')"
    },
    {
      "id": "A6",
      "name": "ArrowsHUD",
      "type": "dom_element",
      "semantic": "Arrows remaining display top-right",
      "locator_hints": [
        "#hud-arrows"
      ],
      "check": "!!document.getElementById('hud-arrows')"
    },
    {
      "id": "A7",
      "name": "PowerBar",
