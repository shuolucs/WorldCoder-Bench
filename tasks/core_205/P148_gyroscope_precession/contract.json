{
  "task_id": "P148_gyroscope_precession",
  "affordances": [
    {
      "id": "A1",
      "name": "Gyroscope",
      "type": "3d_object",
      "semantic": "The spinning gyroscope assembly (rotor, axle, ring)",
      "locator_hints": [
        "gold cylinder rotor",
        "gyroscope group"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Axle !== undefined)"
    },
    {
      "id": "A2",
      "name": "Rotor",
      "type": "3d_object",
      "semantic": "The gold spinning disc of the gyroscope",
      "locator_hints": [
        "gold CylinderGeometry",
        "FFD700 colored mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.spinSpeed !== undefined)"
    },
    {
      "id": "A3",
      "name": "PrecessionTrail",
      "type": "3d_object",
      "semantic": "Dashed circle showing precession path on ground",
      "locator_hints": [
        "dashed line",
        "trail circle"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.trailVisible !== undefined)"
    },
    {
      "id": "A4",
      "name": "HUDPanel",
      "type": "dom_element",
      "semantic": "Top-left HUD displaying simulation parameters",
      "locator_hints": [
        "div with spin speed text",
        "top-left panel"
      ],
      "check": "document.querySelectorAll('div').length > 0"
    },
    {
      "id": "A5",
      "name": "GroundPlane",
      "type": "3d_object",
      "semantic": "Gray ground plane with grid",
      "locator_hints": [
        "gray plane at y=0"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Status !== undefined)"
    },
    {
      "id": "A6",
      "name": "Pedestal",
      "type": "3d_object",
      "semantic": "Small cylinder pedestal at the pivot point",
      "locator_hints": [
        "thin cylinder at y=0.1"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.Status !== undefined)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 30",
        "window.__3D_STATE__.tiltAngle === 25",
        "window.__3D_STATE__.isPaused === false",
        "window.__3D_STATE__.isToppled === false",
        "window.__3D_STATE__.precessionAngle === 0"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 30 && window.__3D_STATE__.tiltAngle === 25 && window.__3D_STATE__.isPaused === false && window.__3D_STATE__.isToppled === false && window.__3D_STATE__.precessionAngle === 0"
    },
    {
      "id": "S1",
      "name": "Precessing",
      "conditions": [
        "window.__3D_STATE__.spinSpeed > 0",
        "window.__3D_STATE__.precessionAngle > 0",
        "window.__3D_STATE__.precessionRate > 0",
        "window.__3D_STATE__.isToppled === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed > 0 && window.__3D_STATE__.precessionAngle > 0 && window.__3D_STATE__.precessionRate > 0 && window.__3D_STATE__.isToppled === false"
    },
    {
      "id": "S2",
      "name": "Paused",
      "conditions": [
        "window.__3D_STATE__.isPaused === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.isPaused === true"
    },
    {
      "id": "S3",
      "name": "SpinIncreased",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 35",
        "window.__3D_STATE__.isPaused === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 35 && window.__3D_STATE__.isPaused === false"
    },
    {
      "id": "S4",
      "name": "SpinDecreased",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 30",
        "window.__3D_STATE__.isPaused === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 30 && window.__3D_STATE__.isPaused === false"
    },
    {
      "id": "S5",
      "name": "TiltChanged",
      "conditions": [
        "window.__3D_STATE__.tiltAngle === 35",
        "window.__3D_STATE__.tiltPresetIndex === 2"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.tiltAngle === 35 && window.__3D_STATE__.tiltPresetIndex === 2"
    },
    {
      "id": "S6",
      "name": "TrailToggled",
      "conditions": [
        "window.__3D_STATE__.trailVisible === true"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.trailVisible === true"
    },
    {
      "id": "S7",
      "name": "ResetState",
      "conditions": [
        "window.__3D_STATE__.spinSpeed === 30",
        "window.__3D_STATE__.tiltAngle === 25",
        "window.__3D_STATE__.precessionAngle === 0",
        "window.__3D_STATE__.isToppled === false"
      ],
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spinSpeed === 30 && window.__3D_STATE__.tiltAngle === 25 && window.__3D_STATE__.precessionAngle === 0 && window.__3D_STATE__.isToppled === false"
    },
    {
      "id": "S_stable_60s",
      "name": "stable_60s",
      "description": "60-second stability run — simulation running without errors",
      "condition": "true"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.Axle !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Nutation !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Spacebar !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.Status !== undefined",
            "tier": "L2"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionAngle > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed < 30 && window.__3D_STATE__.spinSpeed >= 29",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionRate > 0 && !isNaN(window.__3D_STATE__.precessionRate)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.elapsedTime >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.nutationOffset) <= 2.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.spinSpeed === 'number' && !isNaN(window.__3D_STATE__.spinSpeed)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.precessionAngle === 'number' && !isNaN(window.__3D_STATE__.precessionAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": " "
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.isToppled === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S1",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowUp"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed >= 33 && window.__3D_STATE__.spinSpeed <= 36",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionRate < (2 * 9.81 * 0.625) / (1.0 * 29)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isPaused === false",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.precessionRate)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "ArrowDown"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed >= 28 && window.__3D_STATE__.spinSpeed <= 32",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionRate > 0",
            "tier": "L1"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.spinSpeed)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.isToppled === false",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S4",
      "to": "S5",
      "severity": "P1",
      "action": {
        "type": "keyboard",
        "key": "t"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tiltAngle === 35 || window.__3D_STATE__.tiltAngle === 15",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionAngle === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tiltPresetIndex !== 1",
            "tier": "L2"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.tiltAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S6",
      "severity": "P1",
      "action": {
        "type": "click_canvas",
        "target_hint": "Click on the rotor/gyroscope center area"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.trailVisible === true || window.__3D_STATE__.trailVisible === false",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.trailVisible === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "!isNaN(window.__3D_STATE__.precessionAngle)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S6",
      "to": "S7",
      "severity": "P0",
      "action": {
        "type": "keyboard",
        "key": "r"
      },
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "JSON.stringify(window.__3D_STATE__) !== JSON.stringify(before)",
            "tier": "L0"
          },
          {
            "expr": "Array.isArray(window.__3D_STATE__.Status)",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.spinSpeed === 30",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tiltAngle === 25",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.precessionAngle === 0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.isToppled === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.tiltPresetIndex === 1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T9",
      "from": "S7",
      "to": "S_stable_60s",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Simulation runs stably for 60 seconds without errors or NaN values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.spinSpeed === 'number' && !isNaN(window.__3D_STATE__.spinSpeed)",
            "tier": "L0"
          },
          {
            "expr": "typeof window.__3D_STATE__.precessionAngle === 'number' && !isNaN(window.__3D_STATE__.precessionAngle)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
