{
  "task_id": "P3092",
  "affordances": [
    {
      "id": "A1",
      "name": "Bloom Strength Slider",
      "type": "dom_element",
      "semantic": "Slider control for bloom effect strength",
      "locator_hints": [
        "input[type='range']",
        "bloom strength slider",
        "first slider in panel"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Bloom Radius Slider",
      "type": "dom_element",
      "semantic": "Slider control for bloom effect radius",
      "locator_hints": [
        "input[type='range']",
        "bloom radius slider",
        "second slider in panel"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 1"
    },
    {
      "id": "A3",
      "name": "Chromatic Aberration Slider",
      "type": "dom_element",
      "semantic": "Slider control for chromatic aberration offset",
      "locator_hints": [
        "input[type='range']",
        "chromatic aberration slider",
        "third slider in panel"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 2"
    },
    {
      "id": "A4",
      "name": "Vignette Intensity Slider",
      "type": "dom_element",
      "semantic": "Slider control for vignette darkening effect",
      "locator_hints": [
        "input[type='range']",
        "vignette slider",
        "fourth slider in panel"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 3"
    },
    {
      "id": "A5",
      "name": "Tone Mapping Exposure Slider",
      "type": "dom_element",
      "semantic": "Slider control for tone mapping exposure",
      "locator_hints": [
        "input[type='range']",
        "exposure slider",
        "fifth slider in panel"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 4"
    },
    {
      "id": "A6",
      "name": "Corset Model",
      "type": "3d_object",
      "semantic": "Loaded Corset.glb model on pedestal",
      "locator_hints": [
        "center of scene",
        "corset mesh",
        "main fashion object"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.corsetLoaded)"
    },
    {
      "id": "A7",
      "name": "Plant Model",
      "type": "3d_object",
      "semantic": "Loaded DiffuseTransmissionPlant.glb as backdrop",
      "locator_hints": [
        "behind and left of corset",
        "plant mesh",
        "greenhouse element"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.plantLoaded)"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene initializes with models loading and default post-processing settings",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.corsetLoaded === false || window.__3D_STATE__.plantLoaded === false"
    },
    {
      "id": "S1",
      "name": "Models Loaded",
      "description": "Both corset and plant models have loaded successfully into the scene",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.corsetLoaded === true && window.__3D_STATE__.plantLoaded === true && window.__3D_STATE__.renderPassActive === true"
    },
    {
      "id": "S2",
      "name": "Bloom Configured",
      "description": "User has adjusted bloom strength and radius sliders",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.bloomStrength === 'number' && typeof window.__3D_STATE__.bloomRadius === 'number'"
    },
    {
      "id": "S3",
      "name": "Chromatic Aberration Applied",
      "description": "User has configured chromatic aberration offset",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.chromaticAberrationOffset === 'number' && window.__3D_STATE__.chromaticAberrationOffset > 0"
    },
    {
      "id": "S4",
      "name": "Vignette Added",
      "description": "User has adjusted vignette intensity",
      "condition": "window.__3D_STATE__ && typeof window.__3D_STATE__.vignetteIntensity === 'number' && window.__3D_STATE__.vignetteIntensity > 0"
    },
    {
      "id": "S5",
      "name": "Full Pipeline Active",
      "description": "All post-processing effects configured with tone mapping exposure set",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.effectsEnabled === true && window.__3D_STATE__.activeEffectCount >= 4 && typeof window.__3D_STATE__.toneMappingExposure === 'number'"
    },
    {
      "id": "S6",
      "name": "Stable Configuration",
      "description": "Scene runs stably with full effect chain for extended period",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.effectsEnabled === true && window.__3D_STATE__.activeEffectCount >= 4"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3000
      },
      "postconditions": [
        "Both 3D models are loaded and visible in the scene",
        "Post-processing pipeline is initialized"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.corsetLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.plantLoaded === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.renderPassActive === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 1.8; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true})); document.querySelectorAll('input[type=\"range\"]')[1].value = 0.6; document.querySelectorAll('input[type=\"range\"]')[1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bloom strength is set to a high value",
        "Bloom radius is adjusted from default"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.bloomStrength === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.bloomStrength > 1.5",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.bloomRadius - 0.6) < 0.1",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[2].value = 0.012; document.querySelectorAll('input[type=\"range\"]')[2].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Chromatic aberration effect is applied with visible offset"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.chromaticAberrationOffset === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.chromaticAberrationOffset > 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeEffectCount >= 2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[3].value = 1.2; document.querySelectorAll('input[type=\"range\"]')[3].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Vignette effect is active with moderate intensity"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.vignetteIntensity === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.vignetteIntensity > 1.0",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.vignetteIntensity - 1.2) < 0.2",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[4].value = 1.5; document.querySelectorAll('input[type=\"range\"]')[4].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Tone mapping exposure is configured",
        "All post-processing effects are active in the pipeline"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.toneMappingExposure === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.toneMappingExposure > 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeEffectCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.effectsEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelectorAll('input[type=\"range\"]')[0].value = 2.5; document.querySelectorAll('input[type=\"range\"]')[0].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "Bloom strength is increased to maximum range",
        "Scene remains stable with extreme bloom values"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.bloomStrength > 2.0",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.bloomStrength)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.effectsEnabled === true",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T7",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const cameraPos = window.__3D_STATE__.cameraDistance || 3; window.__3D_STATE__.cameraDistance = cameraPos;",
        "wait_ms": 1000
      },
      "postconditions": [
        "Camera distance is tracked and stable",
        "All state fields remain valid"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.cameraDistance === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.cameraDistance > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.cameraDistance)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T8",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene runs stably for 60 seconds with all effects active",
        "No performance degradation or state corruption"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.effectsEnabled === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.activeEffectCount >= 4",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.bloomStrength) && isFinite(window.__3D_STATE__.toneMappingExposure)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
