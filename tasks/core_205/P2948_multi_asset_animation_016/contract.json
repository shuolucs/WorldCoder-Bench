  "states": [
    {
      "id": "S0",
      "name": "Initial Load",
      "description": "Scene is loading assets and initializing",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.assetsLoaded === false"
    },
    {
      "id": "S1",
      "name": "Default Configuration",
      "description": "All assets loaded with default parameters: flightRadius=4, flightSpeed=1.0, danceSpeed=1.0, spotlightAngle=45",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.assetsLoaded === true && Math.abs(window.__3D_STATE__.flightRadius - 4) < 0.5 && Math.abs(window.__3D_STATE__.flightSpeed - 1.0) < 0.5 && Math.abs(window.__3D_STATE__.danceSpeed - 1.0) < 0.5 && Math.abs(window.__3D_STATE__.spotlightAngle - 45) < 5"
    },
    {
      "id": "S2",
      "name": "Wide Orbit Flight",
      "description": "Stork flying in expanded circular path with increased radius",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.flightRadius >= 6.5"
    },
    {
      "id": "S3",
      "name": "Fast Dance Performance",
      "description": "RiggedFigure animation playing at accelerated speed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.danceSpeed >= 2.0 && window.__3D_STATE__.flightRadius >= 6.5"
    },
    {
      "id": "S4",
      "name": "Dynamic Lighting",
      "description": "DirectionalLight rotated to create dramatic shadow angles",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.spotlightAngle >= 70 && window.__3D_STATE__.danceSpeed >= 2.0 && window.__3D_STATE__.flightRadius >= 6.5"
    },
    {
      "id": "S5",
      "name": "Synchronized Choreography",
      "description": "Combined adjustments to flight, dance, and lighting creating coordinated performance",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.flightSpeed >= 1.8 && window.__3D_STATE__.flightRadius >= 6.0 && window.__3D_STATE__.danceSpeed >= 2.0 && window.__3D_STATE__.spotlightAngle >= 70"
    },
    {
      "id": "S6",
      "name": "Stable Performance",
      "description": "Scene running continuously with all animations and shadows functioning correctly",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.animationActive === true && window.__3D_STATE__.figureAnimationTime > 0 && window.__3D_STATE__.assetsLoaded === true"
    }
  ],
  "transitions": [
