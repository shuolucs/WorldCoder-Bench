{
  "task_id": "P3219",
  "affordances": [
    {
      "id": "A1",
      "name": "Chess Piece",
      "type": "3d_object",
      "semantic": "Clickable chess piece from ABeautifulGame.glb set that triggers piece selection",
      "locator_hints": [
        "chess piece mesh",
        "part of ABeautifulGame model",
        "raycast target on board"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A2",
      "name": "Valid Destination Square",
      "type": "3d_object",
      "semantic": "Green translucent plane mesh indicating valid move destination",
      "locator_hints": [
        "green plane mesh",
        "translucent square on board",
        "valid move indicator"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.validSquaresCount > 0)"
    },
    {
      "id": "A3",
      "name": "Fox Model",
      "type": "3d_object",
      "semantic": "Animated fox character from Fox.glb that walks across board",
      "locator_hints": [
        "Fox.glb model",
        "animated character",
        "walks on chessboard"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A4",
      "name": "Lesson Panel",
      "type": "dom_element",
      "semantic": "HTML overlay panel showing current step and piece information",
      "locator_hints": [
        "left side panel",
        "lesson instructions",
        "piece movement rules"
      ],
      "check": "document.querySelectorAll('[class*=\"panel\"], [class*=\"lesson\"]').length > 0 || !!document.querySelector('div')"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "Initial Welcome",
      "description": "Scene loaded with chess set and fox visible, welcome message displayed asking user to click a piece",
      "condition": "!window.__3D_STATE__ || window.__3D_STATE__.currentStep <= 1"
    },
    {
      "id": "S1",
      "name": "Piece Selected",
      "description": "User clicked a chess piece, piece is highlighted with yellow emissive glow, piece name and rules shown in panel",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.pieceHighlighted === true && window.__3D_STATE__.currentStep >= 2"
    },
    {
      "id": "S2",
      "name": "Valid Squares Highlighted",
      "description": "Green translucent planes appear on valid destination squares for selected piece type",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.validSquaresCount > 0 && window.__3D_STATE__.currentStep >= 3"
    },
    {
      "id": "S3",
      "name": "Fox Moving",
      "description": "User clicked destination square, fox is animating walk movement toward target position",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.foxIsMoving === true && window.__3D_STATE__.destinationReached === false"
    },
    {
      "id": "S4",
      "name": "Move Completed",
      "description": "Fox reached destination square, move counter incremented, ready for next interaction",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.foxIsMoving === false && window.__3D_STATE__.destinationReached === true && window.__3D_STATE__.totalMovesCompleted >= 1 && window.__3D_STATE__.currentStep < 7"
    },
    {
      "id": "S5",
      "name": "Lesson Complete",
      "description": "All 7 steps completed successfully, final congratulations message displayed",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.lessonComplete === true && window.__3D_STATE__.currentStep >= 7"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth/2, clientY: window.innerHeight/2, bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "A chess piece is selected and highlighted",
        "currentStep advances to 2",
        "selectedPieceType is set to a valid piece type",
        "pieceHighlighted becomes true"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.currentStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentStep >= 2",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.selectedPieceType === 'string'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.pieceHighlighted === true",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentStep - 2) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionX)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.validSquaresCount) < 100",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 2000
      },
      "postconditions": [
        "Valid destination squares are generated and highlighted",
        "validSquaresCount is greater than zero",
        "currentStep advances to 3 or 4"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.validSquaresCount === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.validSquaresCount > 0",
            "tier": "L1"
          },
          {
            "expr": "window.__3D_STATE__.currentStep >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.validSquaresCount)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentStep - 3) < 0.1",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionZ)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalMovesCompleted) < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth/2 + 100, clientY: window.innerHeight/2 + 50, bubbles: true}));",
        "wait_ms": 1000
      },
      "postconditions": [
        "User clicked a valid destination square",
        "Fox begins moving animation",
        "foxIsMoving becomes true",
        "destinationReached is false initially"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.foxIsMoving === 'boolean'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.foxIsMoving === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.destinationReached === false",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionX)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionZ)",
            "tier": "L0"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.totalMovesCompleted) < 50",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 3500
      },
      "postconditions": [
        "Fox completes movement to destination",
        "foxIsMoving becomes false",
        "destinationReached becomes true",
        "totalMovesCompleted increments",
        "foxPositionX and foxPositionZ updated to new coordinates"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.foxIsMoving === false",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.destinationReached === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.totalMovesCompleted === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.totalMovesCompleted >= 1",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.foxPositionX === 'number'",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionX)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionZ)",
            "tier": "L0"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalMovesCompleted)",
            "tier": "L1"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.currentStep) < 20",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "for(let i=0; i<6; i++) { setTimeout(() => { document.querySelector('canvas').dispatchEvent(new MouseEvent('click', {clientX: window.innerWidth/2 + Math.random()*200, clientY: window.innerHeight/2 + Math.random()*200, bubbles: true})); }, i * 4000); }",
        "wait_ms": 25000
      },
      "postconditions": [
        "Multiple moves completed to reach step 7",
        "currentStep reaches 7",
        "lessonComplete becomes true",
        "totalMovesCompleted reflects multiple successful moves"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.currentStep >= 7",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.lessonComplete === true",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.totalMovesCompleted >= 3",
            "tier": "L2"
          },
          {
            "expr": "Number.isInteger(window.__3D_STATE__.totalMovesCompleted)",
            "tier": "L1"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Scene remains stable in completed state",
        "All state values remain valid and consistent",
        "No errors or crashes occur during extended wait"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.lessonComplete === true",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.currentStep === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.currentStep >= 7",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionX)",
            "tier": "L0"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.foxPositionZ)",
            "tier": "L0"
          }
        ]
      }
    }
  ]
}
