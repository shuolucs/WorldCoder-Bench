{
  "task_id": "P2923",
  "affordances": [
    {
      "id": "A1",
      "name": "Temperature Slider",
      "type": "dom_element",
      "semantic": "Controls reaction temperature from 20C to 200C, affecting pool color",
      "locator_hints": [
        "input[type='range']",
        "temperature",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A2",
      "name": "Catalyst Concentration Dropdown",
      "type": "dom_element",
      "semantic": "Selects catalyst molarity (0.1M, 0.5M, 1.0M, 2.0M) to control polymer swelling",
      "locator_hints": [
        "select",
        "catalyst",
        "dropdown"
      ],
      "check": "!!document.querySelector('select')"
    },
    {
      "id": "A3",
      "name": "pH Slider",
      "type": "dom_element",
      "semantic": "Adjusts solution pH from 1 to 14, modifying polymer opacity and roughness",
      "locator_hints": [
        "input[type='range']",
        "ph",
        "slider"
      ],
      "check": "document.querySelectorAll('input[type=\"range\"]').length > 0"
    },
    {
      "id": "A4",
      "name": "Pool Model",
      "type": "3d_object",
      "semantic": "Chemical reaction vessel at scene center",
      "locator_hints": [
        "pool.glb",
        "mesh",
        "reaction vessel"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A5",
      "name": "Polymer Pouf",
      "type": "3d_object",
      "semantic": "SpecularSilkPouf representing polymer mass inside pool",
      "locator_hints": [
        "SpecularSilkPouf.glb",
        "polymer",
        "mesh"
      ],
      "check": "!!(window.__3D_STATE__ && window.__3D_STATE__.modelLoaded)"
    },
    {
      "id": "A6",
      "name": "OrbitControls",
      "type": "interaction",
      "semantic": "Camera controls for scene inspection",
      "locator_hints": [
        "OrbitControls",
        "camera"
      ],
      "check": "true"
    }
  ],
  "states": [
    {
      "id": "S0",
      "name": "initial_ambient",
      "description": "Scene loaded at ambient conditions: 20C, 0.1M catalyst, pH 7, no UV, no stirring",
      "condition": "!window.__3D_STATE__ || (window.__3D_STATE__.temperature <= 30 && window.__3D_STATE__.catalystConcentration <= 0.1 && window.__3D_STATE__.phLevel >= 6 && window.__3D_STATE__.phLevel <= 8)"
    },
    {
      "id": "S1",
      "name": "moderate_heating",
      "description": "Temperature raised to 80-120C range, catalyst at 0.5M, polymer begins swelling",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature >= 80 && window.__3D_STATE__.temperature <= 120 && window.__3D_STATE__.catalystConcentration >= 0.4 && window.__3D_STATE__.catalystConcentration <= 0.6 && window.__3D_STATE__.polymerScale > 1.0"
    },
    {
      "id": "S2",
      "name": "high_catalyst_acidic",
      "description": "High catalyst concentration (1.0M+) with acidic pH (3-5), increased cross-linking",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.catalystConcentration >= 1.0 && window.__3D_STATE__.phLevel >= 3 && window.__3D_STATE__.phLevel <= 5 && window.__3D_STATE__.crossLinkDensity > 30"
    },
    {
      "id": "S3",
      "name": "extreme_temperature",
      "description": "Temperature exceeds 160C, polymer at maximum scale, high cross-link density",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature >= 160 && window.__3D_STATE__.polymerScale >= 2.5 && window.__3D_STATE__.crossLinkDensity >= 70"
    },
    {
      "id": "S4",
      "name": "alkaline_stabilization",
      "description": "pH raised to 10-12, temperature moderate, reaction stabilizing",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.phLevel >= 10 && window.__3D_STATE__.phLevel <= 12 && window.__3D_STATE__.temperature >= 100 && window.__3D_STATE__.temperature <= 130 && window.__3D_STATE__.reactionStability >= 0"
    },
    {
      "id": "S5",
      "name": "optimal_crosslink",
      "description": "Optimal conditions achieved: 100-140C, 1.0M catalyst, pH 8-9, high cross-link density",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.temperature >= 100 && window.__3D_STATE__.temperature <= 140 && Math.abs(window.__3D_STATE__.catalystConcentration - 1.0) < 0.1 && window.__3D_STATE__.phLevel >= 8 && window.__3D_STATE__.phLevel <= 9 && window.__3D_STATE__.crossLinkDensity >= 80"
    },
    {
      "id": "S6",
      "name": "stability_plateau",
      "description": "Reaction reaches equilibrium with sustained stability over 60 seconds",
      "condition": "window.__3D_STATE__ && window.__3D_STATE__.reactionStability >= 60 && window.__3D_STATE__.crossLinkDensity >= 85"
    }
  ],
  "transitions": [
    {
      "id": "T1",
      "from": "S0",
      "to": "S1",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('input[type=\"range\"]').value = 100; document.querySelector('input[type=\"range\"]').dispatchEvent(new Event('input', {bubbles: true})); document.querySelector('select').value = '0.5'; document.querySelector('select').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 1500
      },
      "postconditions": [
        "Temperature increased to 100C",
        "Catalyst concentration set to 0.5M",
        "Polymer scale begins increasing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperature >= 80 && window.__3D_STATE__.temperature <= 120",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystConcentration === 0.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polymerScale > 1.0",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.crossLinkDensity === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T2",
      "from": "S1",
      "to": "S2",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "document.querySelector('select').value = '1.0'; document.querySelector('select').dispatchEvent(new Event('change', {bubbles: true})); const phSliders = document.querySelectorAll('input[type=\"range\"]'); phSliders[phSliders.length - 1].value = 4; phSliders[phSliders.length - 1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Catalyst concentration increased to 1.0M",
        "pH lowered to acidic range (3-5)",
        "Cross-linking density increases significantly"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.catalystConcentration >= 1.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phLevel >= 3 && window.__3D_STATE__.phLevel <= 5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crossLinkDensity > 30",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.polymerScale === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.polymerScale >= 1.5",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.temperature)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T3",
      "from": "S2",
      "to": "S3",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const tempSlider = document.querySelectorAll('input[type=\"range\"]')[0]; tempSlider.value = 170; tempSlider.dispatchEvent(new Event('input', {bubbles: true})); document.querySelector('select').value = '2.0'; document.querySelector('select').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 2500
      },
      "postconditions": [
        "Temperature raised to extreme level (160C+)",
        "Maximum catalyst concentration (2.0M)",
        "Polymer reaches maximum scale",
        "Cross-link density approaches maximum"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 160",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.catalystConcentration === 2.0",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polymerScale >= 2.5",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crossLinkDensity >= 70",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.reactionStability === 'number'",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T4",
      "from": "S3",
      "to": "S4",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 110; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); sliders[sliders.length - 1].value = 11; sliders[sliders.length - 1].dispatchEvent(new Event('input', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Temperature reduced to moderate level (100-120C)",
        "pH raised to alkaline range (10-12)",
        "Reaction begins stabilizing"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 100 && window.__3D_STATE__.temperature <= 130",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phLevel >= 10 && window.__3D_STATE__.phLevel <= 12",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crossLinkDensity !== undefined",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.reactionStability >= 0",
            "tier": "L1"
          },
          {
            "expr": "Number.isInteger(Math.floor(window.__3D_STATE__.phLevel))",
            "tier": "L2"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.polymerScale)",
            "tier": "L0"
          }
        ]
      }
    },
    {
      "id": "T5",
      "from": "S4",
      "to": "S5",
      "severity": "P0",
      "action": {
        "type": "eval",
        "code": "const sliders = document.querySelectorAll('input[type=\"range\"]'); sliders[0].value = 125; sliders[0].dispatchEvent(new Event('input', {bubbles: true})); sliders[sliders.length - 1].value = 8; sliders[sliders.length - 1].dispatchEvent(new Event('input', {bubbles: true})); document.querySelector('select').value = '1.0'; document.querySelector('select').dispatchEvent(new Event('change', {bubbles: true}));",
        "wait_ms": 2000
      },
      "postconditions": [
        "Optimal temperature range achieved (100-140C)",
        "pH adjusted to near-neutral alkaline (8-9)",
        "Catalyst at optimal 1.0M",
        "High cross-link density maintained"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.temperature >= 100 && window.__3D_STATE__.temperature <= 140",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.phLevel >= 8 && window.__3D_STATE__.phLevel <= 9",
            "tier": "L2"
          },
          {
            "expr": "Math.abs(window.__3D_STATE__.catalystConcentration - 1.0) < 0.01",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crossLinkDensity >= 80",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.polymerScale >= 2.0",
            "tier": "L2"
          }
        ]
      }
    },
    {
      "id": "T6",
      "from": "S5",
      "to": "S6",
      "severity": "P0",
      "action": {
        "type": "wait",
        "duration_ms": 60000
      },
      "postconditions": [
        "Reaction maintains stability for 60 seconds",
        "All parameters remain within optimal ranges",
        "Cross-linking reaches equilibrium"
      ],
      "verifier": {
        "type": "scene_probe",
        "checks": [
          {
            "expr": "window.__3D_STATE__.reactionStability >= 60",
            "tier": "L2"
          },
          {
            "expr": "window.__3D_STATE__.crossLinkDensity >= 85",
            "tier": "L2"
          },
          {
            "expr": "typeof window.__3D_STATE__.temperature === 'number'",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.temperature > 0",
            "tier": "L1"
          },
          {
            "expr": "isFinite(window.__3D_STATE__.catalystConcentration)",
            "tier": "L0"
          },
          {
            "expr": "window.__3D_STATE__.polymerScale !== null",
            "tier": "L1"
          }
        ]
      }
    }
  ]
}
